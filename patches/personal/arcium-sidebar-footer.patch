+int VerticalTabStripBottomContainer::FooterAction() const {
+  const int value = browser_->GetProfile()->GetPrefs()->GetInteger(
+      arcium::kSidebarFooterActionPref);
+  return value >= arcium::kSidebarFooterActionMin &&
+                 value <= arcium::kSidebarFooterActionMax
+             ? value
+             : arcium::kSidebarFooterActionExtensions;
+}
+
+void VerticalTabStripBottomContainer::UpdateFooterAction() {
+  const int action = FooterAction();
+  if (action != current_footer_action_ && GetWidget() &&
+      current_footer_action_ == arcium::kSidebarFooterActionExtensions) {
+    if (auto* view = BrowserView::GetBrowserViewForBrowser(browser_)) {
+      if (view->toolbar() && view->toolbar()->extensions_container()) {
+        view->toolbar()->extensions_container()->CloseExtensionsMenuIfOpen();
+      }
+    }
+  }
+  const auto& descriptor = kFooterActions[action];
+  if (action != current_footer_action_) {
+    current_footer_action_ = action;
+  footer_action_button_->SetVisible(action != arcium::kSidebarFooterActionNone);
+  footer_action_button_->SetIcon(helium::MakePhosphorIcon(descriptor.icon));
+  footer_action_button_->SetTooltipText(descriptor.label);
+  footer_action_button_->GetViewAccessibility().SetName(descriptor.label);
+  footer_action_button_->GetViewAccessibility().SetHasPopup(
+      action == arcium::kSidebarFooterActionExtensions
+          ? ax::mojom::HasPopup::kMenu : ax::mojom::HasPopup::kFalse);
+  }
+  footer_action_button_->SetEnabled(
+      !descriptor.command || chrome::IsCommandEnabled(browser_, descriptor.command));
+}
+
+void VerticalTabStripBottomContainer::RunFooterAction(const ui::Event& event) {
+  const int action = FooterAction();
+  if (action == arcium::kSidebarFooterActionExtensions) {
+    if (auto* view = BrowserView::GetBrowserViewForBrowser(browser_)) {
+      if (view->toolbar() && view->toolbar()->extensions_container()) {
+        view->toolbar()->extensions_container()->ToggleExtensionsMenuFromAnchor(
+            footer_action_button_);
+      }
+    }
+    return;
+  }
+  const int command = kFooterActions[action].command;
+  if (command && chrome::IsCommandEnabled(browser_, command)) {
+    chrome::ExecuteCommandWithDisposition(
+        browser_, command, ui::DispositionFromEventFlags(event.flags()));
+  }
+}
+
+void VerticalTabStripBottomContainer::ShowFooterActionMenu(
+    const gfx::Point& point, ui::mojom::MenuSourceType source_type) {
+  menu_space_.reset();
+  menu_runner_.reset();
+  menu_model_ = std::make_unique<ui::SimpleMenuModel>(this);
+  menu_model_->AddTitle(u"Sidebar button");
+  const bool managed = browser_->GetProfile()->GetPrefs()->IsManagedPreference(
+      arcium::kSidebarFooterActionPref);
+  for (size_t i = 0; i < kFooterActions.size(); ++i) {
+    menu_model_->AddRadioItem(kFooterMenuFirst + i, kFooterActions[i].label, 1);
+    menu_model_->SetEnabledAt(menu_model_->GetItemCount() - 1, !managed);
+  }
+  menu_runner_ = std::make_unique<views::MenuRunner>(
+      menu_model_.get(), views::MenuRunner::CONTEXT_MENU);
+  menu_runner_->RunMenuAt(GetWidget(), nullptr, gfx::Rect(point, gfx::Size()),
+                          views::MenuAnchorPosition::kTopLeft, source_type);
+}
+
+bool VerticalTabStripBottomContainer::IsCommandIdChecked(int command_id) const {
+  return command_id >= kFooterMenuFirst && command_id <= kFooterMenuLast &&
+         FooterAction() == command_id - kFooterMenuFirst;
+}
