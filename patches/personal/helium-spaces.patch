+// Copyright 2026 The Helium Authors
+// You can use, redistribute, and/or modify this source code under
+// the terms of the GPL-3.0 license that can be found in the LICENSE file.
+
+#include "chrome/browser/ui/helium/helium_space_model.h"
+
+#include <utility>
+
+#include "base/json/json_reader.h"
+#include "base/json/json_writer.h"
+#include "testing/gtest/include/gtest/gtest.h"
+
+namespace helium {
+namespace {
+
+HeliumSpaceModel MakeModel() {
+  HeliumSpaceModel model;
+  model.source_profile = "arc-profile";
+  model.favorites.push_back({.source_id = "fav-1",
+                             .title = "Favorite",
+                             .url = GURL("https://favorite.example/")});
+  HeliumSpaceFolder folder{
+      .source_id = "folder-1",
+      .title = "Work",
+      .collapsed = true,
+      .children = {HeliumSpaceNode{
+          .data = HeliumSpaceTab{.source_id = "pin-1",
+                                 .title = "Pin",
+                                 .url = GURL("https://pin.example/")}}}};
+  model.spaces.push_back(
+      {.id = "space-1",
+       .name = "Work",
+       .source_profile = "arc-profile",
+       .pins = {HeliumSpaceNode{.data = std::move(folder)}}});
+  return model;
+}
+
+TEST(HeliumSpaceModelTest, PreservesVersionedOrderedTree) {
+  const HeliumSpaceModel model = MakeModel();
+  std::optional<HeliumSpaceModel> decoded =
+      HeliumSpaceModel::FromValue(model.ToValue());
+  ASSERT_TRUE(decoded);
+  EXPECT_EQ(model, *decoded);
+}
+
+TEST(HeliumSpaceModelTest, PreservesJsonTransport) {
+  std::optional<std::string> json = base::WriteJson(MakeModel().ToValue());
+  ASSERT_TRUE(json);
+  std::optional<base::Value> value =
+      base::JSONReader::Read(*json, base::JSON_PARSE_RFC);
+  ASSERT_TRUE(value);
+  std::optional<HeliumSpaceModel> decoded = HeliumSpaceModel::FromValue(*value);
+  ASSERT_TRUE(decoded);
+  EXPECT_EQ(MakeModel(), *decoded);
+}
+
+TEST(HeliumSpaceModelTest, PreservesSourceIdentityAcrossReimport) {
+  HeliumSpaceModel imported = MakeModel();
+  imported.favorites[0].title = "Renamed favorite";
+
+  std::optional<HeliumSpaceModel> decoded =
+      HeliumSpaceModel::FromValue(imported.ToValue());
+  ASSERT_TRUE(decoded);
+  EXPECT_EQ("fav-1", decoded->favorites[0].source_id);
+  const auto& folder =
+      std::get<HeliumSpaceFolder>(decoded->spaces[0].pins[0].data);
+  EXPECT_EQ("pin-1",
+            std::get<HeliumSpaceTab>(folder.children[0].data).source_id);
+}
+
+TEST(HeliumSpaceModelTest, RejectsDuplicateOrMalformedIdentity) {
+  base::Value malformed = MakeModel().ToValue();
+  malformed.GetDict()
+      .FindList("favorites")
+      ->front()
+      .GetDict()
+      .Remove("url");
+  EXPECT_FALSE(HeliumSpaceModel::FromValue(malformed));
+
+  base::Value duplicate = MakeModel().ToValue();
+  duplicate.GetDict().FindList("spaces")->Append(
+      duplicate.GetDict().FindList("spaces")->front().Clone());
+  EXPECT_FALSE(HeliumSpaceModel::FromValue(duplicate));
+}
+
+TEST(HeliumSpaceModelTest, PreservesDuplicateAndEmptyFolders) {
+  HeliumSpaceNodes nodes;
+  nodes.push_back(HeliumSpaceNode{.data = HeliumSpaceTab{
+      .source_id = "tab-1", .title = "One", .url = GURL("https://one/")}});
+  nodes.push_back(HeliumSpaceNode{.data = HeliumSpaceFolder{
+      .source_id = "folder-1", .title = "Same", .collapsed = true}});
+  nodes.push_back(HeliumSpaceNode{.data = HeliumSpaceFolder{
+      .source_id = "folder-2",
+      .title = "Same",
+      .children = {HeliumSpaceNode{.data = HeliumSpaceTab{
+          .source_id = "tab-2", .title = "Two", .url = GURL("https://two/")}}}}});
+
+  std::optional<HeliumSpaceNodes> decoded =
+      DecodeSpaceNodes(EncodeSpaceNodes(nodes));
+  ASSERT_TRUE(decoded);
+  EXPECT_EQ(nodes, *decoded);
+}
+
+TEST(HeliumSpaceModelTest, AssignsLegacyNodeIdentity) {
+  base::ListValue legacy;
+  base::DictValue empty_folder;
+  empty_folder.Set("title", "Empty");
+  empty_folder.Set("collapsed", false);
+  empty_folder.Set("children", base::ListValue());
+  legacy.Append(std::move(empty_folder));
+  base::DictValue legacy_tab;
+  legacy_tab.Set("url", "https://legacy/");
+  legacy.Append(std::move(legacy_tab));
+
+  std::optional<HeliumSpaceNodes> decoded = DecodeSpaceNodes(legacy);
+  ASSERT_TRUE(decoded);
+  ASSERT_EQ(2u, decoded->size());
+  EXPECT_FALSE(std::get<HeliumSpaceFolder>((*decoded)[0].data).source_id.empty());
+  EXPECT_FALSE(std::get<HeliumSpaceTab>((*decoded)[1].data).source_id.empty());
+}
+
+TEST(HeliumSpaceModelTest, DecodesLegacyNormalizedLinkAndIdSchema) {
+  base::DictValue link;
+  link.Set("type", "link");
+  link.Set("id", "link-1");
+  link.Set("title", "Legacy link");
+  link.Set("url", "https://legacy-link.example/");
+  base::ListValue children;
+  children.Append(std::move(link));
+
+  base::DictValue folder;
+  folder.Set("type", "folder");
+  folder.Set("id", "folder-1");
+  folder.Set("title", "Legacy folder");
+  folder.Set("collapsed", true);
+  folder.Set("children", std::move(children));
+  base::ListValue encoded;
+  encoded.Append(std::move(folder));
+
+  std::optional<HeliumSpaceNodes> decoded = DecodeSpaceNodes(encoded);
+  ASSERT_TRUE(decoded);
+  ASSERT_EQ(1u, decoded->size());
+  const auto& decoded_folder =
+      std::get<HeliumSpaceFolder>((*decoded)[0].data);
+  EXPECT_EQ("folder-1", decoded_folder.source_id);
+  ASSERT_EQ(1u, decoded_folder.children.size());
+  const auto& decoded_link =
+      std::get<HeliumSpaceTab>(decoded_folder.children[0].data);
+  EXPECT_EQ("link-1", decoded_link.source_id);
+  EXPECT_EQ(GURL("https://legacy-link.example/"), decoded_link.url);
+}
+
+TEST(HeliumSpaceModelTest, MergesUniqueIdentityButLeavesAmbiguousMatch) {
+  const HeliumSpaceNode stored{.data = HeliumSpaceTab{
+      .source_id = "old", .title = "Same", .url = GURL("https://same/")}};
+  HeliumSpaceNodes captured = {HeliumSpaceNode{.data = HeliumSpaceTab{
+      .source_id = "new", .title = "Same", .url = GURL("https://same/")}}};
+  HeliumSpaceNodes merged = MergeSpaceNodeIdentity({stored}, std::move(captured));
+  EXPECT_EQ("old", std::get<HeliumSpaceTab>(merged[0].data).source_id);
+
+  const HeliumSpaceNode duplicate{.data = HeliumSpaceTab{
+      .source_id = "other", .title = "Same", .url = GURL("https://same/")}};
+  captured = {HeliumSpaceNode{.data = HeliumSpaceTab{
+      .source_id = "new", .title = "Same", .url = GURL("https://same/")}}};
+  merged = MergeSpaceNodeIdentity({stored, duplicate}, std::move(captured));
+  EXPECT_EQ("new", std::get<HeliumSpaceTab>(merged[0].data).source_id);
+}
