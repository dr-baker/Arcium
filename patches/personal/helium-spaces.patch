+namespace helium {
+
+// A Space-owned sidecar keeps source identity out of public StartupTab APIs.
+// The browser-facing view is always the ordinary StartupTab value.
+struct HeliumSpaceStoredTab {
+  StartupTab tab;
+  std::string source_id;
+};
+using HeliumSpaceStoredTabs = std::vector<HeliumSpaceStoredTab>;
+
+base::ListValue EncodeSpacePins(const HeliumSpaceNodes& nodes);
+HeliumSpaceNodes DecodeSpacePins(const base::ListValue& list);
+
+// A durable Space identity. Pins are Space-scoped; Favorites are profile-
+// scoped and are therefore stored by the owning HeliumSpaceService.
+class HeliumSpace {
+ public:
+  explicit HeliumSpace(Profile* profile);
+  HeliumSpace(Profile* profile,
+              std::string id,
+              std::u16string name,
+              std::string source_profile,
+              HeliumSpaceNodes pins);
+  HeliumSpace(const HeliumSpace&) = delete;
+  HeliumSpace& operator=(const HeliumSpace&) = delete;
+  ~HeliumSpace();
+
+  Profile* profile() const { return profile_; }
+  const std::string& id() const { return id_; }
+  const std::string& source_profile() const { return source_profile_; }
+  std::u16string name() const;
+  void SyncNameFromProfile();
+
+  static HeliumSpaceNodes MakePinNodes(const StartupTabs& tabs);
+  static HeliumSpaceNodes ReadLegacyPins(Profile* profile);
+
+  StartupTabs ReadPins() const;
+  const HeliumSpaceNodes& ReadStoredPins() const;
+  void WritePins(const StartupTabs& tabs);
+  void WriteStoredPins(const HeliumSpaceNodes& nodes);
+  void WritePinsFromBrowsers();
+
+  StartupTabs ReadFavorites() const;
+  HeliumSpaceStoredTabs ReadStoredFavorites() const;
+  void WriteFavorites(const StartupTabs& tabs);
+  void WriteStoredFavorites(const HeliumSpaceStoredTabs& tabs);
+  void WriteFavoritesFromBrowsers();
+
+  BrowserWindowInterface* GetPrimaryBrowser() const;
+  BrowserWindowInterface* ActivateOrCreatePrimaryWindow();
+
+ private:
