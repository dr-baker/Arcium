+// Copyright 2026 The Helium Authors
+// You can use, redistribute, and/or modify this source code under
+// the terms of the GPL-3.0 license that can be found in the LICENSE file.
+
+#include "chrome/browser/ui/helium/helium_space_model.h"
+
+#include <utility>
+
+#include "base/json/json_reader.h"
+#include "base/json/json_writer.h"
+#include "testing/gtest/include/gtest/gtest.h"
+
+namespace helium {
+namespace {
+
+HeliumSpaceModel MakeModel() {
+  HeliumSpaceModel model;
+  model.source_profile = "arc-profile";
+  model.favorites.push_back({.source_id = "fav-1",
+                             .title = "Favorite",
+                             .url = GURL("https://favorite.example/")});
+  HeliumSpaceFolder folder{
+      .source_id = "folder-1",
+      .title = "Work",
+      .collapsed = true,
+      .children = {HeliumSpaceNode{
+          .data = HeliumSpaceTab{.source_id = "pin-1",
+                                 .title = "Pin",
+                                 .url = GURL("https://pin.example/")}}}};
+  model.spaces.push_back(
+      {.id = "space-1",
+       .name = "Work",
+       .source_profile = "arc-profile",
+       .pins = {HeliumSpaceNode{.data = std::move(folder)}}});
+  return model;
+}
+
+TEST(HeliumSpaceModelTest, PreservesVersionedOrderedTree) {
+  const HeliumSpaceModel model = MakeModel();
+  std::optional<HeliumSpaceModel> decoded =
+      HeliumSpaceModel::FromValue(model.ToValue());
+  ASSERT_TRUE(decoded);
+  EXPECT_EQ(model, *decoded);
+}
+
+TEST(HeliumSpaceModelTest, PreservesJsonTransport) {
+  std::optional<std::string> json = base::WriteJson(MakeModel().ToValue());
+  ASSERT_TRUE(json);
+  std::optional<base::Value> value =
+      base::JSONReader::Read(*json, base::JSON_PARSE_RFC);
+  ASSERT_TRUE(value);
+  std::optional<HeliumSpaceModel> decoded = HeliumSpaceModel::FromValue(*value);
+  ASSERT_TRUE(decoded);
+  EXPECT_EQ(MakeModel(), *decoded);
+}
+
+TEST(HeliumSpaceModelTest, RejectsDuplicateOrMalformedIdentity) {
+  base::Value malformed = MakeModel().ToValue();
+  malformed.GetDict()
+      .FindList("favorites")
+      ->front()
+      .GetDict()
+      .Remove("source_id");
+  EXPECT_FALSE(HeliumSpaceModel::FromValue(malformed));
+
+  base::Value duplicate = MakeModel().ToValue();
+  duplicate.GetDict().FindList("spaces")->Append(
+      duplicate.GetDict().FindList("spaces")->front().Clone());
+  EXPECT_FALSE(HeliumSpaceModel::FromValue(duplicate));
+}
+
+}  // namespace
+}  // namespace helium

