+#include "chrome/browser/ui/helium/helium_startup_tab_materializer.h"
+#include "chrome/browser/ui/tabs/pin_tab_codec.h"
+#include "chrome/browser/ui/tabs/pinned_tab_codec.h"
+#include "chrome/common/pref_names.h"
+#include "components/prefs/pref_service.h"
+#include "components/prefs/scoped_user_pref_update.h"
+
+namespace helium {
+namespace {
+
+constexpr char kURL[] = "url";
+constexpr char kSourceId[] = "source_id";
+constexpr char kID[] = "id";
+constexpr char kName[] = "name";
+constexpr char kSourceProfile[] = "source_profile";
+constexpr char kPins[] = "pins";
+constexpr char kHeliumSourceId[] = "helium_source_id";
+constexpr char kHeliumHasHome[] = "helium_has_home";
+constexpr char kHeliumHomeTitle[] = "helium_home_title";
+
+std::string ReadStoredSourceId(const base::DictValue& value) {
+  if (const std::string* source_id = value.FindString(kSourceId);
+      source_id && !source_id->empty()) {
+    return *source_id;
+  }
+  if (const std::string* source_id = value.FindString(kHeliumSourceId);
+      source_id && !source_id->empty()) {
+    return *source_id;
+  }
+  return {};
+}
+
+HeliumSpaceStoredTabs MakeStoredTabs(const StartupTabs& tabs) {
+  HeliumSpaceStoredTabs result;
+  result.reserve(tabs.size());
+  for (const StartupTab& tab : tabs) {
+    result.push_back({.tab = tab});
+  }
+  return result;
+}
+
+HeliumSpaceNodes MakePinNodesInternal(const StartupTabs& tabs) {
+  HeliumSpaceNodes result;
+  for (const StartupTab& tab : tabs) {
+    HeliumSpaceNodes* current = &result;
+    for (const auto& segment : tab.helium_folder_path) {
+      HeliumSpaceFolder* folder = nullptr;
+      for (HeliumSpaceNode& node : *current) {
+        auto* candidate = std::get_if<HeliumSpaceFolder>(&node.data);
+        if (candidate && candidate->title ==
+                             base::UTF16ToUTF8(segment.title)) {
+          folder = candidate;
+          break;
+        }
+      }
+      if (!folder) {
+        current->push_back(HeliumSpaceNode{.data = HeliumSpaceFolder{
+            .source_id = base::Uuid::GenerateRandomV4().AsLowercaseString(),
+            .title = base::UTF16ToUTF8(segment.title),
+            .collapsed = segment.collapsed}});
+        folder = std::get_if<HeliumSpaceFolder>(&current->back().data);
+      }
+      current = &folder->children;
+    }
+    current->push_back(HeliumSpaceNode{.data = HeliumSpaceTab{
+        .source_id = base::Uuid::GenerateRandomV4().AsLowercaseString(),
+        .title = base::UTF16ToUTF8(tab.helium_home_title), .url = tab.url}});
+  }
+  return result;
+}
+
+void FlattenPinNodes(
+    const HeliumSpaceNodes& nodes,
+    const std::vector<StartupTab::FolderPathSegment>& parents,
+    StartupTabs* result) {
+  for (const HeliumSpaceNode& node : nodes) {
+    if (const auto* tab = std::get_if<HeliumSpaceTab>(&node.data)) {
+      StartupTab startup(tab->url, StartupTab::Type::kPin);
+      startup.helium_has_home = true;
+      startup.helium_home_title = base::UTF8ToUTF16(tab->title);
+      startup.helium_folder_path = parents;
+      result->push_back(std::move(startup));
+      continue;
+    }
+    const auto& folder = std::get<HeliumSpaceFolder>(node.data);
+    auto nested = parents;
+    nested.push_back({.title = base::UTF8ToUTF16(folder.title),
+                      .collapsed = folder.collapsed});
+    FlattenPinNodes(folder.children, nested, result);
+  }
+}
+
+HeliumSpaceNodes ReadLegacyPinsInternal(Profile* profile) {
+  PrefService* prefs = profile->GetPrefs();
+  if (prefs->HasPrefPath(prefs::kHeliumPins) &&
+      !prefs->GetList(prefs::kHeliumPins).empty()) {
+    if (auto decoded = DecodeSpaceNodes(prefs->GetList(prefs::kHeliumPins))) {
+      return std::move(*decoded);
+    }
+  }
+  return MakePinNodesInternal(PinTabCodec::ReadPins(profile));
+}
+
+StartupTabs PublicTabs(const HeliumSpaceNodes& stored) {
+  StartupTabs result;
+  FlattenPinNodes(stored, {}, &result);
+  return result;
+}
+
+StartupTabs PublicFavorites(const HeliumSpaceStoredTabs& stored) {
+  StartupTabs result;
+  result.reserve(stored.size());
+  for (const HeliumSpaceStoredTab& item : stored) {
+    result.push_back(item.tab);
+  }
+  return result;
+}
+
+HeliumSpaceStoredTabs MergeFavoriteIdentity(
+    const HeliumSpaceStoredTabs& stored,
+    const StartupTabs& captured) {
+  HeliumSpaceStoredTabs result;
+  result.reserve(captured.size());
+  for (const StartupTab& tab : captured) {
+    size_t match = 0;
+    size_t matches = 0;
+    for (size_t i = 0; i < stored.size(); ++i) {
+      if (stored[i].tab.url == tab.url &&
+          stored[i].tab.helium_home_title == tab.helium_home_title) {
+        match = i;
+        ++matches;
+      }
+    }
+    HeliumSpaceStoredTab item{.tab = tab};
+    if (matches == 1u) {
+      item.source_id = stored[match].source_id;
+    }
+    result.push_back(std::move(item));
+  }
+  return result;
+}
+
+base::DictValue EncodeFavorite(const HeliumSpaceStoredTab& stored) {
+  const StartupTab& tab = stored.tab;
+  base::DictValue value;
+  value.Set(kURL, tab.url.spec());
+  if (!stored.source_id.empty()) {
+    value.Set(kSourceId, stored.source_id);
+  }
+  if (tab.helium_has_home) {
+    value.Set(kHeliumHasHome, true);
+    value.Set(kHeliumHomeTitle, base::UTF16ToUTF8(tab.helium_home_title));
+  }
+  return value;
+}
+
+base::ListValue EncodeFavorites(const HeliumSpaceStoredTabs& tabs) {
+  base::ListValue result;
+  for (const HeliumSpaceStoredTab& stored : tabs) {
+    result.Append(EncodeFavorite(stored));
+  }
+  return result;
+}
+
+HeliumSpaceStoredTabs DecodeFavorites(const base::ListValue& list) {
+  HeliumSpaceStoredTabs result;
+  for (const base::Value& value : list) {
+    const base::DictValue* dict = value.GetIfDict();
+    const std::string* url_string = dict ? dict->FindString(kURL) : nullptr;
+    if (!url_string) {
+      continue;
+    }
+    GURL url(*url_string);
+    if (!url.is_valid() || url.is_empty() || url.spec() == "about:blank") {
+      continue;
+    }
+    StartupTab tab(url, StartupTab::Type::kPinned);
+    tab.helium_has_home = dict->FindBool(kHeliumHasHome).value_or(false);
+    if (const std::string* title = dict->FindString(kHeliumHomeTitle)) {
+      tab.helium_home_title = base::UTF8ToUTF16(*title);
+    }
+    result.push_back({.tab = std::move(tab),
+                      .source_id = ReadStoredSourceId(*dict)});
+  }
+  return result;
+}
+
+base::DictValue* FindRecord(base::ListValue& records, std::string_view id) {
+  for (base::Value& value : records) {
+    base::DictValue* record = value.GetIfDict();
+    if (record && record->FindString(kID) && *record->FindString(kID) == id) {
+      return record;
+    }
+  }
+  return nullptr;
+}
+
+}  // namespace
+
+base::ListValue EncodeSpacePins(const HeliumSpaceNodes& nodes) {
+  return EncodeSpaceNodes(nodes);
+}
+
+HeliumSpaceNodes DecodeSpacePins(const base::ListValue& list) {
+  if (auto nodes = DecodeSpaceNodes(list)) {
+    return std::move(*nodes);
+  }
+  return {};
+}
+
+HeliumSpaceNodes HeliumSpace::MakePinNodes(const StartupTabs& tabs) {
+  return MakePinNodesInternal(tabs);
+}
+
+HeliumSpaceNodes HeliumSpace::ReadLegacyPins(Profile* profile) {
+  return ReadLegacyPinsInternal(profile);
+}
+
+HeliumSpace::HeliumSpace(Profile* profile) : profile_(profile) {
+  id_ = profile_->GetPrefs()->GetString(prefs::kHeliumSpaceId);
+  if (id_.empty()) {
+    id_ = base::Uuid::GenerateRandomV4().AsLowercaseString();
+    profile_->GetPrefs()->SetString(prefs::kHeliumSpaceId, id_);
+  }
+  name_ = base::UTF8ToUTF16(
+      profile_->GetPrefs()->GetString(prefs::kHeliumSpaceName));
+  if (name_.empty()) {
+    name_ = u"Space";
+  }
+}
+
+HeliumSpace::HeliumSpace(Profile* profile,
+                         std::string id,
+                         std::u16string name,
+                         std::string source_profile,
+                         HeliumSpaceNodes pins)
+    : profile_(profile),
+      id_(std::move(id)),
+      name_(name.empty() ? u"Space" : std::move(name)),
+      source_profile_(std::move(source_profile)),
+      pins_(std::move(pins)) {}
+
+HeliumSpace::~HeliumSpace() = default;
+
+std::u16string HeliumSpace::name() const {
+  return name_.empty() ? u"Space" : name_;
+}
+
+void HeliumSpace::SyncNameFromProfile() {
+  if (name_.empty()) {
+    name_ = u"Space";
+  }
+}
+
+StartupTabs HeliumSpace::ReadPins() const {
+  return PublicTabs(pins_);
+}
+
+const HeliumSpaceNodes& HeliumSpace::ReadStoredPins() const {
+  return pins_;
+}
+
+void HeliumSpace::WritePins(const StartupTabs& tabs) {
+  WriteStoredPins(MergeSpaceNodeIdentity(pins_, MakePinNodes(tabs)));
+}
+
+void HeliumSpace::WriteStoredPins(const HeliumSpaceNodes& nodes) {
+  pins_ = nodes;
+  PersistRecord();
+}
+
+void HeliumSpace::WritePinsFromBrowsers() {
+  BrowserWindowInterface* window = GetPrimaryBrowser();
+  if (!window) {
+    return;
+  }
+  base::ListValue encoded = PinTabCodec::CapturePins(window);
+  if (auto nodes = DecodeSpaceNodes(encoded)) {
+    WriteStoredPins(MergeSpaceNodeIdentity(pins_, std::move(*nodes)));
+  }
+}
+
+HeliumSpaceStoredTabs HeliumSpace::ReadStoredFavorites() const {
+  PrefService* prefs = profile_->GetPrefs();
+  if (prefs->HasPrefPath(space_prefs::kHeliumFavorites)) {
+    return DecodeFavorites(prefs->GetList(space_prefs::kHeliumFavorites));
+  }
+  if (prefs->HasPrefPath(prefs::kPinnedTabs) &&
+      !prefs->GetList(prefs::kPinnedTabs).empty()) {
+    return DecodeFavorites(prefs->GetList(prefs::kPinnedTabs));
+  }
+  return MakeStoredTabs(PinnedTabCodec::ReadPinnedTabs(profile_));
+}
+
+StartupTabs HeliumSpace::ReadFavorites() const {
+  return PublicFavorites(ReadStoredFavorites());
+}
+
+void HeliumSpace::WriteStoredFavorites(
+    const HeliumSpaceStoredTabs& tabs) {
+  profile_->GetPrefs()->SetList(space_prefs::kHeliumFavorites,
+                                EncodeFavorites(tabs));
+}
+
+void HeliumSpace::WriteFavorites(const StartupTabs& tabs) {
+  WriteStoredFavorites(MergeFavoriteIdentity(ReadStoredFavorites(), tabs));
+}
+
+void HeliumSpace::WriteFavoritesFromBrowsers() {
+  BrowserWindowInterface* window = GetPrimaryBrowser();
+  if (!window) {
+    return;
+  }
+  WriteFavorites(PinnedTabCodec::CapturePinnedTabs(window));
+}
+
+void HeliumSpace::PersistRecord() const {
+  ScopedListPrefUpdate update(profile_->GetPrefs(), space_prefs::kHeliumSpaces);
+  base::DictValue* record = FindRecord(update.Get(), id_);
+  if (!record) {
+    return;
+  }
+  record->Set(kName, base::UTF16ToUTF8(name()));
+  record->Set(kSourceProfile, source_profile_);
+  record->Set(kPins, EncodeSpacePins(pins_));
+}
+
+BrowserWindowInterface* HeliumSpace::GetPrimaryBrowser() const {
+  HeliumSpaceService* service =
+      HeliumSpaceServiceFactory::GetForProfile(profile_);
+  if (!service) {
+    return nullptr;
+  }
+  BrowserWindowInterface* result = nullptr;
+  ProfileBrowserCollection::GetForProfile(profile_)->ForEach(
+      [service, this, &result](BrowserWindowInterface* window) {
+        Browser* browser = window->GetBrowserForMigrationOnly();
+        if (window->GetType() == BrowserWindowInterface::TYPE_NORMAL &&
+            browser && service->GetSpaceIdForBrowser(browser) == id_) {
+          result = window;
+          return false;
+        }
+        return true;
+      },
+      BrowserCollection::Order::kActivation);
+  return result;
+}
+
+BrowserWindowInterface* HeliumSpace::ActivateOrCreatePrimaryWindow() {
+  HeliumSpaceService* service =
+      HeliumSpaceServiceFactory::GetForProfile(profile_);
+  if (!service) {
+    return nullptr;
+  }
+  if (HeliumSpace* old_active = service->GetActiveSpace()) {
+    if (BrowserWindowInterface* old_window = old_active->GetPrimaryBrowser()) {
+      if (Browser* old_browser = old_window->GetBrowserForMigrationOnly()) {
+        service->SetSpaceForBrowser(old_browser, old_active->id());
+      }
+    }
+  }
+  service->SetActiveSpace(id_);
+  if (BrowserWindowInterface* existing = GetPrimaryBrowser()) {
+    if (Browser* browser = existing->GetBrowserForMigrationOnly()) {
+      browser->window()->Show();
+    }
+    return existing;
+  }
+  if (Browser::GetCreationStatusForProfile(profile_) !=
+          Browser::CreationStatus::kOk ||
+      profile_->ShutdownStarted()) {
+    return nullptr;
+  }
+  Browser::CreateParams params(Browser::TYPE_NORMAL, profile_, true);
+  params.should_trigger_session_restore = false;
+  Browser* browser = Browser::Create(params);
+  service->SetSpaceForBrowser(browser, id_);
+  StartupTabs tabs = ReadFavorites();
+  StartupTabs pins = ReadPins();
+  tabs.insert(tabs.end(), pins.begin(), pins.end());
+  for (const StartupTab& tab : tabs) {
+    MaterializeStartupTab(browser, tab, browser->tab_strip_model()->empty());
+  }
+  if (browser->tab_strip_model()->empty()) {
+    chrome::AddTabAt(browser, GURL(), -1, true);
+  }
+  browser->window()->Show();
+  return browser;
+}
+
