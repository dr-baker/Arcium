+
+class Profile;
+class Browser;
+
+namespace helium {
+
+class HeliumSpace;
+struct HeliumSpaceModel;
+
+// Profile-scoped owner of the durable multi-Space model. A Space owns its
+// ordered Pin tree; Favorites are profile-wide and shared by each Space.
+class HeliumSpaceService : public KeyedService {
+ public:
+  explicit HeliumSpaceService(Profile* profile);
+  HeliumSpaceService(const HeliumSpaceService&) = delete;
+  HeliumSpaceService& operator=(const HeliumSpaceService&) = delete;
+  ~HeliumSpaceService() override;
+
+  HeliumSpace* GetDefaultSpace();
+  const HeliumSpace* GetDefaultSpace() const;
+  HeliumSpace* GetActiveSpace();
+  HeliumSpace* GetSpaceById(std::string_view id);
+  const HeliumSpace* GetSpaceById(std::string_view id) const;
+  std::vector<HeliumSpace*> GetSpaces();
+
+  HeliumSpace* GetOrCreateSpace(std::string id,
+                                std::u16string name,
+                                StartupTabs pins = {},
+                                std::string source_profile = {});
+  void ReconcileImportedSpaces(const HeliumSpaceModel& model);
+  void PrepareForArcImport();
+  void SetActiveSpace(std::string_view id);
+
+  // Browser routing is kept in memory and seeded from the active Space on
+  // startup. Newly created Space windows are explicitly assigned an owner.
+  void SetSpaceForBrowser(Browser* browser, std::string_view id);
+  std::string GetSpaceIdForBrowser(const Browser* browser) const;
+
+ private:
+  void LoadSpaces();
+  void EnsureDefaultSpace();
+  void MigrateLegacySingleSpace();
+  void PersistSpaces() const;
+
+  raw_ptr<Profile> profile_;
+  std::vector<std::unique_ptr<HeliumSpace>> spaces_;
+  std::map<const Browser*, std::string> browser_space_ids_;
+};
+
+}  // namespace helium
+
+#endif  // CHROME_BROWSER_UI_HELIUM_HELIUM_SPACE_SERVICE_H_

