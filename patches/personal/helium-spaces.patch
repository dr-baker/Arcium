+// Copyright 2026 The Helium Authors
+// You can use, redistribute, and/or modify this source code under
+// the terms of the GPL-3.0 license that can be found in the LICENSE file.
+
+#include "chrome/browser/ui/helium/helium_space.h"
+
+#include <algorithm>
+#include <string_view>
+#include <utility>
+
+#include "base/strings/utf_string_conversions.h"
+#include "base/uuid.h"
+#include "base/values.h"
+#include "chrome/browser/profiles/profile.h"
+#include "chrome/browser/ui/browser.h"
+#include "chrome/browser/ui/browser_tabstrip.h"
+#include "chrome/browser/ui/browser_window.h"
+#include "chrome/browser/ui/browser_window/public/browser_window_interface.h"
+#include "chrome/browser/ui/browser_window/public/profile_browser_collection.h"
+#include "chrome/browser/ui/helium/helium_space_service.h"
+#include "chrome/browser/ui/helium/helium_space_service_factory.h"
+#include "chrome/browser/ui/tabs/pin_tab_codec.h"
+#include "chrome/browser/ui/tabs/pinned_tab_codec.h"
+#include "chrome/common/pref_names.h"
+#include "components/prefs/pref_service.h"
+#include "components/prefs/scoped_user_pref_update.h"
+
+namespace helium {
+namespace {
+
+constexpr char kType[] = "type";
+constexpr char kTab[] = "tab";
+constexpr char kFolder[] = "folder";
+constexpr char kURL[] = "url";
+constexpr char kTitle[] = "title";
+constexpr char kSourceId[] = "source_id";
+constexpr char kCollapsed[] = "collapsed";
+constexpr char kChildren[] = "children";
+constexpr char kID[] = "id";
+constexpr char kName[] = "name";
+constexpr char kSourceProfile[] = "source_profile";
+constexpr char kPins[] = "pins";
+constexpr char kHeliumSourceId[] = "helium_source_id";
+constexpr char kHeliumHasHome[] = "helium_has_home";
+constexpr char kHeliumHomeTitle[] = "helium_home_title";
+
+base::DictValue EncodeTab(const StartupTab& tab) {
+  base::DictValue value;
+  value.Set(kType, kTab);
+  value.Set(kURL, tab.url.spec());
+  if (!tab.helium_source_id.empty()) {
+    value.Set(kSourceId, tab.helium_source_id);
+  }
+  if (!tab.helium_home_title.empty()) {
+    value.Set(kTitle, base::UTF16ToUTF8(tab.helium_home_title));
+  }
+  return value;
+}
+
+void AppendPinNode(const StartupTab& tab, base::ListValue* target) {
+  base::ListValue* current = target;
+  for (const auto& segment : tab.helium_folder_path) {
+    base::DictValue* folder = nullptr;
+    for (base::Value& value : *current) {
+      base::DictValue* candidate = value.GetIfDict();
+      if (candidate && candidate->FindString(kType) &&
+          *candidate->FindString(kType) == kFolder &&
+          candidate->FindString(kTitle) &&
+          base::UTF8ToUTF16(*candidate->FindString(kTitle)) == segment.title) {
+        folder = candidate;
+        break;
+      }
+    }
+    if (!folder) {
+      base::DictValue new_folder;
+      new_folder.Set(kType, kFolder);
+      new_folder.Set(kTitle, base::UTF16ToUTF8(segment.title));
+      new_folder.Set(kCollapsed, segment.collapsed);
+      new_folder.Set(kChildren, base::ListValue());
+      current->Append(std::move(new_folder));
+      folder = current->back().GetIfDict();
+    }
+    current = folder->FindList(kChildren);
+  }
+  current->Append(EncodeTab(tab));
+}
+
+base::ListValue EncodePins(const StartupTabs& tabs) {
+  base::ListValue result;
+  for (const StartupTab& tab : tabs) {
+    AppendPinNode(tab, &result);
+  }
+  return result;
+}
+
+void DecodePinList(const base::ListValue& list,
+                   const std::vector<StartupTab::FolderPathSegment>& parents,
+                   StartupTabs* result) {
+  for (const base::Value& value : list) {
+    const base::DictValue* dict = value.GetIfDict();
+    if (!dict) {
+      continue;
+    }
+    const std::string* type = dict->FindString(kType);
+    if (type && *type == kFolder) {
+      const std::string* title = dict->FindString(kTitle);
+      const base::ListValue* children = dict->FindList(kChildren);
+      if (!title || !children) {
+        continue;
+      }
+      std::vector<StartupTab::FolderPathSegment> nested = parents;
+      nested.push_back(
+          {.title = base::UTF8ToUTF16(*title),
+           .collapsed = dict->FindBool(kCollapsed).value_or(false)});
+      DecodePinList(*children, nested, result);
+      continue;
+    }
+    const std::string* url_string = dict->FindString(kURL);
+    if (!url_string) {
+      continue;
+    }
+    GURL url(*url_string);
+    if (!url.is_valid() || url.is_empty() || url.spec() == "about:blank") {
+      continue;
+    }
+    StartupTab tab(url, StartupTab::Type::kPin);
+    if (const std::string* source_id = dict->FindString(kSourceId)) {
+      tab.helium_source_id = *source_id;
+    }
+    if (const std::string* title = dict->FindString(kTitle)) {
+      tab.helium_home_title = base::UTF8ToUTF16(*title);
+      tab.helium_has_home = true;
+    }
+    tab.helium_folder_path = parents;
+    result->push_back(std::move(tab));
+  }
+}
+
+StartupTabs DecodePins(const base::ListValue& list) {
+  StartupTabs result;
+  DecodePinList(list, {}, &result);
+  return result;
+}
+
+base::DictValue EncodeFavorite(const StartupTab& tab) {
+  base::DictValue value;
+  value.Set(kURL, tab.url.spec());
+  if (!tab.helium_source_id.empty()) {
+    value.Set(kHeliumSourceId, tab.helium_source_id);
+  }
+  if (tab.helium_has_home) {
+    value.Set(kHeliumHasHome, true);
+    value.Set(kHeliumHomeTitle, base::UTF16ToUTF8(tab.helium_home_title));
+  }
+  return value;
+}
+
+base::ListValue EncodeFavorites(const StartupTabs& tabs) {
+  base::ListValue result;
+  for (const StartupTab& tab : tabs) {
+    result.Append(EncodeFavorite(tab));
+  }
+  return result;
+}
+
+StartupTabs DecodeFavorites(const base::ListValue& list) {
+  StartupTabs result;
+  for (const base::Value& value : list) {
+    const base::DictValue* dict = value.GetIfDict();
+    const std::string* url_string = dict ? dict->FindString(kURL) : nullptr;
+    if (!url_string) {
+      continue;
+    }
+    GURL url(*url_string);
+    if (!url.is_valid() || url.is_empty() || url.spec() == "about:blank") {
+      continue;
+    }
+    StartupTab tab(url, StartupTab::Type::kPinned);
+    if (const std::string* source_id = dict->FindString(kHeliumSourceId)) {
+      tab.helium_source_id = *source_id;
+    }
+    tab.helium_has_home = dict->FindBool(kHeliumHasHome).value_or(false);
+    if (const std::string* title = dict->FindString(kHeliumHomeTitle)) {
+      tab.helium_home_title = base::UTF8ToUTF16(*title);
+    }
+    result.push_back(std::move(tab));
+  }
+  return result;
+}
+
+base::DictValue* FindRecord(base::ListValue& records, std::string_view id) {
+  for (base::Value& value : records) {
+    base::DictValue* record = value.GetIfDict();
+    if (record && record->FindString(kID) && *record->FindString(kID) == id) {
+      return record;
+    }
+  }
+  return nullptr;
+}
+
+}  // namespace
+
+base::ListValue EncodeSpacePins(const StartupTabs& tabs) {
+  return EncodePins(tabs);
+}
+
+StartupTabs DecodeSpacePins(const base::ListValue& list) {
+  return DecodePins(list);
+}
+
+HeliumSpace::HeliumSpace(Profile* profile) : profile_(profile) {
+  id_ = profile_->GetPrefs()->GetString(prefs::kHeliumSpaceId);
+  if (id_.empty()) {
+    id_ = base::Uuid::GenerateRandomV4().AsLowercaseString();
+    profile_->GetPrefs()->SetString(prefs::kHeliumSpaceId, id_);
+  }
+  name_ = base::UTF8ToUTF16(
+      profile_->GetPrefs()->GetString(prefs::kHeliumSpaceName));
+  if (name_.empty()) {
+    name_ = u"Space";
+  }
+}
+
+HeliumSpace::HeliumSpace(Profile* profile,
+                         std::string id,
+                         std::u16string name,
+                         std::string source_profile,
+                         StartupTabs pins)
+    : profile_(profile),
+      id_(std::move(id)),
+      name_(name.empty() ? u"Space" : std::move(name)),
+      source_profile_(std::move(source_profile)),
+      pins_(std::move(pins)) {}
+
+HeliumSpace::~HeliumSpace() = default;
+
+std::u16string HeliumSpace::name() const {
+  return name_.empty() ? u"Space" : name_;
+}
+
+void HeliumSpace::SyncNameFromProfile() {
+  if (name_.empty()) {
+    name_ = u"Space";
+  }
+}
+
+StartupTabs HeliumSpace::ReadPins() const {
+  return pins_;
+}
+
+void HeliumSpace::WritePins(const StartupTabs& tabs) {
+  pins_ = tabs;
+  PersistRecord();
+}
+
+void HeliumSpace::WritePinsFromBrowsers() {
+  PinTabCodec::WritePins(profile_);
+  pins_ = PinTabCodec::ReadPins(profile_);
+  PersistRecord();
+}
+
+StartupTabs HeliumSpace::ReadFavorites() const {
+  PrefService* prefs = profile_->GetPrefs();
+  const base::ListValue& stored = prefs->GetList(prefs::kHeliumFavorites);
+  if (prefs->HasPrefPath(prefs::kHeliumFavorites)) {
+    return DecodeFavorites(stored);
+  }
+  return PinnedTabCodec::ReadPinnedTabs(profile_);
+}
+
+void HeliumSpace::WriteFavorites(const StartupTabs& tabs) {
+  profile_->GetPrefs()->SetList(prefs::kHeliumFavorites, EncodeFavorites(tabs));
+}
+
+void HeliumSpace::WriteFavoritesFromBrowsers() {
+  PinnedTabCodec::WritePinnedTabs(profile_);
+  StartupTabs favorites = PinnedTabCodec::ReadPinnedTabs(profile_);
+  std::erase_if(favorites, [](const StartupTab& tab) {
+    return tab.type != StartupTab::Type::kPinned;
+  });
+  WriteFavorites(favorites);
+}
+
+void HeliumSpace::PersistRecord() const {
+  ScopedListPrefUpdate update(profile_->GetPrefs(), prefs::kHeliumSpaces);
+  base::DictValue* record = FindRecord(update.Get(), id_);
+  if (!record) {
+    return;
+  }
+  record->Set(kName, base::UTF16ToUTF8(name()));
+  record->Set(kSourceProfile, source_profile_);
+  record->Set(kPins, EncodePins(pins_));
+}
+
+BrowserWindowInterface* HeliumSpace::GetPrimaryBrowser() const {
+  HeliumSpaceService* service =
+      HeliumSpaceServiceFactory::GetForProfile(profile_);
+  if (!service) {
+    return nullptr;
+  }
+  BrowserWindowInterface* result = nullptr;
+  ProfileBrowserCollection::GetForProfile(profile_)->ForEach(
+      [service, this, &result](BrowserWindowInterface* window) {
+        Browser* browser = window->GetBrowserForMigrationOnly();
+        if (window->GetType() == BrowserWindowInterface::TYPE_NORMAL &&
+            browser && service->GetSpaceIdForBrowser(browser) == id_) {
+          result = window;
+          return false;
+        }
+        return true;
+      },
+      BrowserCollection::Order::kActivation);
+  return result;
+}
+
+BrowserWindowInterface* HeliumSpace::ActivateOrCreatePrimaryWindow() {
+  HeliumSpaceService* service =
+      HeliumSpaceServiceFactory::GetForProfile(profile_);
+  if (!service) {
+    return nullptr;
+  }
+  service->SetActiveSpace(id_);
+  if (BrowserWindowInterface* existing = GetPrimaryBrowser()) {
+    if (Browser* browser = existing->GetBrowserForMigrationOnly()) {
+      browser->window()->Show();
+    }
+    return existing;
+  }
+  if (Browser::GetCreationStatusForProfile(profile_) !=
+          Browser::CreationStatus::kOk ||
+      profile_->ShutdownStarted()) {
+    return nullptr;
+  }
+  Browser::CreateParams params(Browser::TYPE_NORMAL, profile_, true);
+  params.should_trigger_session_restore = false;
+  Browser* browser = Browser::Create(params);
+  service->SetSpaceForBrowser(browser, id_);
+  if (browser->tab_strip_model()->empty()) {
+    chrome::AddTabAt(browser, GURL(), -1, true);
+  }
+  browser->window()->Show();
+  return browser;
+}
+
+}  // namespace helium

