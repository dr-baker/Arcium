+// Copyright 2026 The Helium Authors
+// You can use, redistribute, and/or modify this source code under
+// the terms of the GPL-3.0 license that can be found in the LICENSE file.
+
+#include "chrome/browser/ui/helium/helium_space_service.h"
+
+#include <algorithm>
+#include <utility>
+
+#include "base/strings/strcat.h"
+#include "base/strings/utf_string_conversions.h"
+#include "base/uuid.h"
+#include "base/values.h"
+#include "chrome/browser/profiles/profile.h"
+#include "chrome/browser/ui/browser.h"
+#include "chrome/browser/ui/helium/helium_space.h"
+#include "chrome/browser/ui/helium/helium_space_model.h"
+#include "chrome/browser/ui/tabs/pin_tab_codec.h"
+#include "chrome/browser/ui/tabs/pinned_tab_codec.h"
+#include "chrome/common/pref_names.h"
+#include "components/prefs/pref_service.h"
+
+namespace helium {
+namespace {
+
+constexpr char kID[] = "id";
+constexpr char kName[] = "name";
+constexpr char kSourceProfile[] = "source_profile";
+constexpr char kPins[] = "pins";
+
+std::string NewSpaceID() {
+  return base::Uuid::GenerateRandomV4().AsLowercaseString();
+}
+
+std::string ImportedID(std::string_view profile,
+                       std::string_view scope,
+                       std::string_view source_id) {
+  return base::StrCat({"arc:", profile, ":", scope, ":", source_id});
+}
+
+StartupTabs ConvertNodes(const std::vector<HeliumSpaceNode>& nodes,
+                         std::string_view source_profile,
+                         std::string_view space_id) {
+  StartupTabs result;
+
+  auto append_nodes =
+      [&](const auto& self, const std::vector<HeliumSpaceNode>& current,
+          std::vector<StartupTab::FolderPathSegment> parents) -> void {
+    for (const HeliumSpaceNode& node : current) {
+      if (const auto* tab = std::get_if<HeliumSpaceTab>(&node.data)) {
+        StartupTab startup(tab->url, StartupTab::Type::kPin);
+        startup.helium_has_home = true;
+        startup.helium_home_title = base::UTF8ToUTF16(tab->title);
+        startup.helium_source_id =
+            ImportedID(source_profile, space_id.empty() ? "space" : space_id,
+                       tab->source_id);
+        startup.helium_folder_path = parents;
+        result.push_back(std::move(startup));
+        continue;
+      }
+      const auto& folder = std::get<HeliumSpaceFolder>(node.data);
+      std::vector<StartupTab::FolderPathSegment> nested = parents;
+      nested.push_back({.title = base::UTF8ToUTF16(folder.title),
+                        .collapsed = folder.collapsed});
+      self(self, folder.children, std::move(nested));
+    }
+  };
+
+  append_nodes(append_nodes, nodes, {});
+  return result;
+}
+
+StartupTabs ConvertFavorites(const std::vector<HeliumSpaceTab>& tabs,
+                             std::string_view source_profile) {
+  StartupTabs result;
+  result.reserve(tabs.size());
+  for (const HeliumSpaceTab& tab : tabs) {
+    StartupTab favorite(tab.url, StartupTab::Type::kPinned);
+    favorite.helium_has_home = true;
+    favorite.helium_home_title = base::UTF8ToUTF16(tab.title);
+    favorite.helium_source_id =
+        ImportedID(source_profile, "favorite", tab.source_id);
+    result.push_back(std::move(favorite));
+  }
+  return result;
+}
+
+}  // namespace
+
+HeliumSpaceService::HeliumSpaceService(Profile* profile) : profile_(profile) {
+  LoadSpaces();
+  EnsureDefaultSpace();
+}
+
+HeliumSpaceService::~HeliumSpaceService() = default;
+
+void HeliumSpaceService::LoadSpaces() {
+  spaces_.clear();
+  PrefService* prefs = profile_->GetPrefs();
+  for (const base::Value& value : prefs->GetList(prefs::kHeliumSpaces)) {
+    const base::DictValue* record = value.GetIfDict();
+    const std::string* id = record ? record->FindString(kID) : nullptr;
+    const std::string* name = record ? record->FindString(kName) : nullptr;
+    const std::string* source =
+        record ? record->FindString(kSourceProfile) : nullptr;
+    const base::ListValue* encoded_pins =
+        record ? record->FindList(kPins) : nullptr;
+    if (!id || id->empty() || !name || !encoded_pins || GetSpaceById(*id)) {
+      continue;
+    }
+    spaces_.push_back(std::make_unique<HeliumSpace>(
+        profile_, *id, base::UTF8ToUTF16(*name), source ? *source : "",
+        DecodeSpacePins(*encoded_pins)));
+  }
+  if (spaces_.empty()) {
+    MigrateLegacySingleSpace();
+  }
+}
+
+void HeliumSpaceService::MigrateLegacySingleSpace() {
+  PrefService* prefs = profile_->GetPrefs();
+  std::string id = prefs->GetString(prefs::kHeliumSpaceId);
+  if (id.empty()) {
+    id = NewSpaceID();
+    prefs->SetString(prefs::kHeliumSpaceId, id);
+  }
+  std::string name = prefs->GetString(prefs::kHeliumSpaceName);
+  if (name.empty()) {
+    name = "Space";
+  }
+
+  StartupTabs pins = PinTabCodec::ReadPins(profile_);
+  spaces_.push_back(std::make_unique<HeliumSpace>(
+      profile_, std::move(id), base::UTF8ToUTF16(name), std::string(),
+      std::move(pins)));
+
+  if (prefs->GetList(prefs::kHeliumFavorites).empty()) {
+    spaces_.front()->WriteFavorites(PinnedTabCodec::ReadPinnedTabs(profile_));
+  }
+  PersistSpaces();
+}
+
+void HeliumSpaceService::EnsureDefaultSpace() {
+  if (spaces_.empty()) {
+    MigrateLegacySingleSpace();
+  }
+  if (spaces_.empty()) {
+    spaces_.push_back(std::make_unique<HeliumSpace>(
+        profile_, NewSpaceID(), u"Space", std::string(), StartupTabs()));
+    PersistSpaces();
+  }
+  const std::string active =
+      profile_->GetPrefs()->GetString(prefs::kHeliumActiveSpaceId);
+  if (!GetSpaceById(active)) {
+    profile_->GetPrefs()->SetString(prefs::kHeliumActiveSpaceId,
+                                    spaces_.front()->id());
+  }
+}
+
+HeliumSpace* HeliumSpaceService::GetDefaultSpace() {
+  EnsureDefaultSpace();
+  return spaces_.front().get();
+}
+
+const HeliumSpace* HeliumSpaceService::GetDefaultSpace() const {
+  return spaces_.empty() ? nullptr : spaces_.front().get();
+}
+
+HeliumSpace* HeliumSpaceService::GetActiveSpace() {
+  EnsureDefaultSpace();
+  const std::string active =
+      profile_->GetPrefs()->GetString(prefs::kHeliumActiveSpaceId);
+  return GetSpaceById(active) ? GetSpaceById(active) : spaces_.front().get();
+}
+
+HeliumSpace* HeliumSpaceService::GetSpaceById(std::string_view id) {
+  for (const auto& space : spaces_) {
+    if (space->id() == id) {
+      return space.get();
+    }
+  }
+  return nullptr;
+}
+
+const HeliumSpace* HeliumSpaceService::GetSpaceById(std::string_view id) const {
+  for (const auto& space : spaces_) {
+    if (space->id() == id) {
+      return space.get();
+    }
+  }
+  return nullptr;
+}
+
+std::vector<HeliumSpace*> HeliumSpaceService::GetSpaces() {
+  EnsureDefaultSpace();
+  std::vector<HeliumSpace*> result;
+  result.reserve(spaces_.size());
+  for (const auto& space : spaces_) {
+    result.push_back(space.get());
+  }
+  return result;
+}
+
+HeliumSpace* HeliumSpaceService::GetOrCreateSpace(std::string id,
+                                                  std::u16string name,
+                                                  StartupTabs pins,
+                                                  std::string source_profile) {
+  if (id.empty()) {
+    id = NewSpaceID();
+  }
+  if (HeliumSpace* existing = GetSpaceById(id)) {
+    if (!pins.empty()) {
+      existing->WritePins(pins);
+    }
+    return existing;
+  }
+  spaces_.push_back(std::make_unique<HeliumSpace>(
+      profile_, std::move(id), std::move(name), std::move(source_profile),
+      std::move(pins)));
+  PersistSpaces();
+  if (spaces_.size() == 1u) {
+    SetActiveSpace(spaces_.front()->id());
+  }
+  return spaces_.back().get();
+}
+
+void HeliumSpaceService::ReconcileImportedSpaces(
+    const HeliumSpaceModel& model) {
+  PrepareForArcImport();
+  std::vector<std::unique_ptr<HeliumSpace>> preserved;
+  for (auto& space : spaces_) {
+    if (space->source_profile().empty() ||
+        space->source_profile() != model.source_profile) {
+      preserved.push_back(std::move(space));
+    }
+  }
+  spaces_ = std::move(preserved);
+  for (const HeliumSpaceRecord& record : model.spaces) {
+    spaces_.push_back(std::make_unique<HeliumSpace>(
+        profile_, record.id, base::UTF8ToUTF16(record.name),
+        model.source_profile,
+        ConvertNodes(record.pins, model.source_profile, record.id)));
+  }
+  if (spaces_.empty()) {
+    spaces_.push_back(std::make_unique<HeliumSpace>(
+        profile_, NewSpaceID(), u"Space", std::string(), StartupTabs()));
+  }
+
+  HeliumSpace* active = GetActiveSpace();
+  StartupTabs favorites = active->ReadFavorites();
+  const std::string prefix = base::StrCat({"arc:", model.source_profile, ":"});
+  std::erase_if(favorites, [&prefix](const StartupTab& tab) {
+    return tab.helium_source_id.starts_with(prefix);
+  });
+  StartupTabs imported_favorites =
+      ConvertFavorites(model.favorites, model.source_profile);
+  favorites.insert(favorites.end(), imported_favorites.begin(),
+                   imported_favorites.end());
+  active->WriteFavorites(favorites);
+
+  PersistSpaces();
+  if (!GetSpaceById(
+          profile_->GetPrefs()->GetString(prefs::kHeliumActiveSpaceId))) {
+    SetActiveSpace(spaces_.front()->id());
+  }
+  browser_space_ids_.clear();
+}
+
+void HeliumSpaceService::PrepareForArcImport() {
+  if (spaces_.size() == 1u && spaces_.front()->source_profile().empty() &&
+      spaces_.front()->name() == u"Space" &&
+      spaces_.front()->ReadPins().empty()) {
+    spaces_.clear();
+    profile_->GetPrefs()->SetList(prefs::kHeliumSpaces, base::ListValue());
+    profile_->GetPrefs()->SetString(prefs::kHeliumActiveSpaceId, std::string());
+  }
+}
+
+void HeliumSpaceService::SetActiveSpace(std::string_view id) {
+  if (GetSpaceById(id)) {
+    profile_->GetPrefs()->SetString(prefs::kHeliumActiveSpaceId,
+                                    std::string(id));
+  }
+}
+
+void HeliumSpaceService::SetSpaceForBrowser(Browser* browser,
+                                            std::string_view id) {
+  if (!browser || browser->profile() != profile_ || !GetSpaceById(id)) {
+    return;
+  }
+  browser_space_ids_[browser] = std::string(id);
+}
+
+std::string HeliumSpaceService::GetSpaceIdForBrowser(
+    const Browser* browser) const {
+  if (!browser || browser->profile() != profile_) {
+    return {};
+  }
+  if (const auto it = browser_space_ids_.find(browser);
+      it != browser_space_ids_.end() && GetSpaceById(it->second)) {
+    return it->second;
+  }
+  const std::string active =
+      profile_->GetPrefs()->GetString(prefs::kHeliumActiveSpaceId);
+  if (GetSpaceById(active)) {
+    return active;
+  }
+  return spaces_.empty() ? std::string() : spaces_.front()->id();
+}
+
+void HeliumSpaceService::PersistSpaces() const {
+  base::ListValue records;
+  for (const auto& space : spaces_) {
+    base::DictValue record;
+    record.Set(kID, space->id());
+    record.Set(kName, base::UTF16ToUTF8(space->name()));
+    record.Set(kSourceProfile, space->source_profile());
+    record.Set(kPins, EncodeSpacePins(space->ReadPins()));
+    records.Append(std::move(record));
+  }
+  profile_->GetPrefs()->SetList(prefs::kHeliumSpaces, std::move(records));
+}
+
+}  // namespace helium

