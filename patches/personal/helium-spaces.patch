+#ifndef CHROME_BROWSER_UI_HELIUM_HELIUM_SPACE_H_
+#define CHROME_BROWSER_UI_HELIUM_HELIUM_SPACE_H_
+
+#include <string>
+
+#include "base/memory/raw_ptr.h"
+#include "base/values.h"
+#include "chrome/browser/ui/startup/startup_tab.h"
+
+class BrowserWindowInterface;
+class Profile;
+
+namespace helium {
+
+base::ListValue EncodeSpacePins(const StartupTabs& tabs);
+StartupTabs DecodeSpacePins(const base::ListValue& list);
+
+// A durable Space identity. Pins are Space-scoped; Favorites are profile-
+// scoped and are therefore stored by the owning HeliumSpaceService.
+class HeliumSpace {
+ public:
+  explicit HeliumSpace(Profile* profile);
+  HeliumSpace(Profile* profile,
+              std::string id,
+              std::u16string name,
+              std::string source_profile,
+              StartupTabs pins);
+  HeliumSpace(const HeliumSpace&) = delete;
+  HeliumSpace& operator=(const HeliumSpace&) = delete;
+  ~HeliumSpace();
+
+  Profile* profile() const { return profile_; }
+  const std::string& id() const { return id_; }
+  const std::string& source_profile() const { return source_profile_; }
+  std::u16string name() const;
+  void SyncNameFromProfile();
+
+  StartupTabs ReadPins() const;
+  void WritePins(const StartupTabs& tabs);
+  void WritePinsFromBrowsers();
+
+  StartupTabs ReadFavorites() const;
+  void WriteFavorites(const StartupTabs& tabs);
+  void WriteFavoritesFromBrowsers();
+
+  BrowserWindowInterface* GetPrimaryBrowser() const;
+  BrowserWindowInterface* ActivateOrCreatePrimaryWindow();
+
+ private:
+  void PersistRecord() const;
+
+  raw_ptr<Profile> profile_;
+  std::string id_;
+  std::u16string name_;
+  std::string source_profile_;
+  StartupTabs pins_;
+};
+
+}  // namespace helium
+
+#endif  // CHROME_BROWSER_UI_HELIUM_HELIUM_SPACE_H_

