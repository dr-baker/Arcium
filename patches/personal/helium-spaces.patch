+void VerticalTabStripBottomContainer::ToggleSpacesList() {
+  spaces_expanded_ = !spaces_expanded_;
+  if (spaces_expanded_) {
+    RebuildSpacesList();
+  }
+  spaces_list_->SetVisible(spaces_expanded_);
+  spaces_disclosure_button_->SetText(spaces_expanded_ ? u"Hide Spaces"
+                                                      : u"Spaces");
+  InvalidateLayout();
+}
+
+void VerticalTabStripBottomContainer::RebuildSpacesList() {
+  spaces_list_->RemoveAllChildViews();
+  auto* service = helium::HeliumSpaceServiceFactory::GetForProfile(
+      browser_->GetProfile());
+  if (!service) {
+    return;
+  }
+  for (helium::HeliumSpace* space : service->GetSpaces()) {
+    auto row = std::make_unique<views::LabelButton>(
+        base::BindRepeating(&VerticalTabStripBottomContainer::ActivateSpace,
+                            base::Unretained(this), space->id()),
+        space->name());
+    row->SetHorizontalAlignment(gfx::ALIGN_LEFT);
+    row->SetTooltipText(u"Open this Space window");
+    spaces_list_->AddChildView(std::move(row));
+  }
+}
+
+void VerticalTabStripBottomContainer::ActivateSpace(std::string space_id) {
+  auto* service = helium::HeliumSpaceServiceFactory::GetForProfile(
+      browser_->GetProfile());
+  if (!service) {
+    return;
+  }
+  if (helium::HeliumSpace* space = service->GetSpaceById(space_id)) {
+    service->SetActiveSpace(space_id);
+    space->ActivateOrCreatePrimaryWindow();
+  }
+}
