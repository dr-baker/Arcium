+
+void MaterializeStartupTab(Browser* browser,
+                           const StartupTab& startup_tab,
+                           bool foreground) {
+  if (!browser) {
+    return;
+  }
+  int add_types = foreground ? AddTabTypes::ADD_ACTIVE
+                             : AddTabTypes::ADD_NONE;
+  add_types |= AddTabTypes::ADD_FORCE_INDEX;
+  if (startup_tab.type == StartupTab::Type::kPinned) {
+    add_types |= AddTabTypes::ADD_PINNED;
+  }
+  NavigateParams params(browser, startup_tab.url,
+                        ui::PAGE_TRANSITION_AUTO_TOPLEVEL);
+  params.disposition = foreground
+                           ? WindowOpenDisposition::NEW_FOREGROUND_TAB
+                           : WindowOpenDisposition::NEW_BACKGROUND_TAB;
+  params.tabstrip_add_types = add_types;
+  Navigate(&params);
+  if (!params.navigated_or_inserted_contents) {
+    return;
+  }
+  RestoreStartupTabPinState(
+      tabs::TabInterface::MaybeGetFromContents(
+          params.navigated_or_inserted_contents),
+      startup_tab);
+}
