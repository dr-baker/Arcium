+// Copyright 2026 The Helium Authors
+// You can use, redistribute, and/or modify this source code under
+// the terms of the GPL-3.0 license that can be found in the LICENSE file.
+
+#include "chrome/browser/ui/helium/helium_space_model.h"
+
+#include "base/uuid.h"
+
+#include <set>
+#include <string_view>
+#include <utility>
+
+namespace helium {
+namespace {
+
+constexpr char kVersion[] = "version";
+constexpr char kSourceProfile[] = "source_profile";
+constexpr char kFavorites[] = "favorites";
+constexpr char kSpaces[] = "spaces";
+constexpr char kId[] = "id";
+constexpr char kName[] = "name";
+constexpr char kPins[] = "pins";
+constexpr char kType[] = "type";
+constexpr char kTab[] = "tab";
+constexpr char kLink[] = "link";
+constexpr char kFolder[] = "folder";
+constexpr char kSourceId[] = "source_id";
+constexpr char kTitle[] = "title";
+constexpr char kURL[] = "url";
+constexpr char kCollapsed[] = "collapsed";
+constexpr char kChildren[] = "children";
+
+base::DictValue EncodeTab(const HeliumSpaceTab& tab) {
+  base::DictValue value;
+  value.Set(kType, kTab);
+  value.Set(kSourceId, tab.source_id);
+  value.Set(kTitle, tab.title);
+  value.Set(kURL, tab.url.spec());
+  return value;
+}
+
+base::Value EncodeNode(const HeliumSpaceNode& node);
+
+base::DictValue EncodeFolder(const HeliumSpaceFolder& folder) {
+  base::ListValue children;
+  children.reserve(folder.children.size());
+  for (const HeliumSpaceNode& child : folder.children) {
+    children.Append(EncodeNode(child));
+  }
+  base::DictValue value;
+  value.Set(kType, kFolder);
+  value.Set(kSourceId, folder.source_id);
+  value.Set(kTitle, folder.title);
+  value.Set(kCollapsed, folder.collapsed);
+  value.Set(kChildren, std::move(children));
+  return value;
+}
+
+base::Value EncodeNode(const HeliumSpaceNode& node) {
+  if (const auto* tab = std::get_if<HeliumSpaceTab>(&node.data)) {
+    return base::Value(EncodeTab(*tab));
+  }
+  return base::Value(EncodeFolder(std::get<HeliumSpaceFolder>(node.data)));
+}
+
+std::optional<HeliumSpaceTab> DecodeTab(const base::DictValue& value) {
+  const std::string* type = value.FindString(kType);
+  const std::string* source_id = value.FindString(kSourceId);
+  const std::string* legacy_id = value.FindString(kId);
+  const std::string* title = value.FindString(kTitle);
+  const std::string* url_string = value.FindString(kURL);
+  if ((value.Find(kType) && !type) || (value.Find(kSourceId) && !source_id) ||
+      (value.Find(kId) && !legacy_id) || (value.Find(kTitle) && !title) ||
+      (type && *type != kTab && *type != kLink) ||
+      value.FindList(kChildren) || !url_string || url_string->empty()) {
+    return std::nullopt;
+  }
+  GURL url(*url_string);
+  if (!url.is_valid() || url.is_empty() || url.spec() == "about:blank") {
+    return std::nullopt;
+  }
+  return HeliumSpaceTab{
+      .source_id = source_id && !source_id->empty()
+                       ? *source_id
+                       : legacy_id && !legacy_id->empty()
+                             ? *legacy_id
+                             : base::Uuid::GenerateRandomV4()
+                                   .AsLowercaseString(),
+      .title = title ? *title : std::string(),
+      .url = std::move(url)};
+}
+
+std::optional<HeliumSpaceNode> DecodeNode(const base::Value& value) {
+  const base::DictValue* dict = value.GetIfDict();
+  if (!dict) {
+    return std::nullopt;
+  }
+  const std::string* type = dict->FindString(kType);
+  const std::string* legacy_id = dict->FindString(kId);
+  if ((dict->Find(kType) && !type) ||
+      (dict->Find(kSourceId) && !dict->FindString(kSourceId)) ||
+      (dict->Find(kId) && !legacy_id)) {
+    return std::nullopt;
+  }
+  if ((type && (*type == kTab || *type == kLink)) ||
+      (!type && dict->FindString(kURL) && !dict->FindList(kChildren))) {
+    std::optional<HeliumSpaceTab> tab = DecodeTab(*dict);
+    return tab ? std::optional<HeliumSpaceNode>(
+                     HeliumSpaceNode{.data = std::move(*tab)})
+               : std::nullopt;
+  }
+  if ((type && *type != kFolder) || !dict->FindList(kChildren)) {
+    return std::nullopt;
+  }
+  const std::string* source_id = dict->FindString(kSourceId);
+  const std::string* title = dict->FindString(kTitle);
+  std::optional<bool> collapsed = dict->FindBool(kCollapsed);
+  const base::ListValue* encoded_children = dict->FindList(kChildren);
+  if (!title || !collapsed || !encoded_children) {
+    return std::nullopt;
+  }
+  std::vector<HeliumSpaceNode> children;
+  children.reserve(encoded_children->size());
+  for (const base::Value& encoded_child : *encoded_children) {
+    std::optional<HeliumSpaceNode> child = DecodeNode(encoded_child);
+    if (!child) {
+      return std::nullopt;
+    }
+    children.push_back(std::move(*child));
+  }
+  return HeliumSpaceNode{
+      .data = HeliumSpaceFolder{
+          .source_id = source_id && !source_id->empty()
+                           ? *source_id
+                           : legacy_id && !legacy_id->empty()
+                                 ? *legacy_id
+                                 : base::Uuid::GenerateRandomV4()
+                                       .AsLowercaseString(),
+                                .title = *title,
+                                .collapsed = *collapsed,
+                                .children = std::move(children)}};
+}
+
+bool CollectIDs(const std::vector<HeliumSpaceNode>& nodes,
+                std::set<std::string>* ids) {
+  for (const HeliumSpaceNode& node : nodes) {
+    if (const auto* tab = std::get_if<HeliumSpaceTab>(&node.data)) {
+      if (!ids->insert(tab->source_id).second) {
+        return false;
+      }
+      continue;
+    }
+    const auto& folder = std::get<HeliumSpaceFolder>(node.data);
+    if (!ids->insert(folder.source_id).second ||
+        !CollectIDs(folder.children, ids)) {
+      return false;
+    }
+  }
+  return true;
+}
+
+std::optional<HeliumSpaceRecord> DecodeSpace(const base::Value& value) {
+  const base::DictValue* dict = value.GetIfDict();
+  if (!dict || dict->size() != 4u) {
+    return std::nullopt;
+  }
+  const std::string* id = dict->FindString(kId);
+  const std::string* name = dict->FindString(kName);
+  const std::string* source_profile = dict->FindString(kSourceProfile);
+  const base::ListValue* encoded_pins = dict->FindList(kPins);
+  if (!id || id->empty() || !name || !source_profile ||
+      source_profile->empty() || !encoded_pins) {
+    return std::nullopt;
+  }
+  std::vector<HeliumSpaceNode> pins;
+  pins.reserve(encoded_pins->size());
+  for (const base::Value& encoded_pin : *encoded_pins) {
+    std::optional<HeliumSpaceNode> pin = DecodeNode(encoded_pin);
+    if (!pin) {
+      return std::nullopt;
+    }
+    pins.push_back(std::move(*pin));
+  }
+  std::set<std::string> ids;
+  if (!CollectIDs(pins, &ids)) {
+    return std::nullopt;
+  }
+  return HeliumSpaceRecord{.id = *id,
+                           .name = *name,
+                           .source_profile = *source_profile,
+                           .pins = std::move(pins)};
+}
+
+base::DictValue EncodeSpace(const HeliumSpaceRecord& space) {
+  base::ListValue pins;
+  pins.reserve(space.pins.size());
+  for (const HeliumSpaceNode& pin : space.pins) {
+    pins.Append(EncodeNode(pin));
+  }
+  base::DictValue value;
+  value.Set(kId, space.id);
+  value.Set(kName, space.name);
+  value.Set(kSourceProfile, space.source_profile);
+  value.Set(kPins, std::move(pins));
+  return value;
+}
+
+bool SameNodeIdentity(const HeliumSpaceNode& stored,
+                      const HeliumSpaceNode& captured) {
+  const auto* stored_tab = std::get_if<HeliumSpaceTab>(&stored.data);
+  const auto* captured_tab = std::get_if<HeliumSpaceTab>(&captured.data);
+  if (stored_tab || captured_tab) {
+    return stored_tab && captured_tab &&
+           stored_tab->title == captured_tab->title &&
+           stored_tab->url == captured_tab->url;
+  }
+  const auto& stored_folder = std::get<HeliumSpaceFolder>(stored.data);
+  const auto& captured_folder = std::get<HeliumSpaceFolder>(captured.data);
+  return stored_folder.title == captured_folder.title;
+}
+
+void MergeNodeIdentity(const HeliumSpaceNodes& stored,
+                       HeliumSpaceNode* captured) {
+  std::vector<size_t> matches;
+  for (size_t i = 0; i < stored.size(); ++i) {
+    if (SameNodeIdentity(stored[i], *captured)) {
+      matches.push_back(i);
+    }
+  }
+  // A URL/title duplicate in the same folder, or sibling folders with the
+  // same title, has no safe identity match. Leave every source_id alone.
+  if (matches.size() != 1u) {
+    return;
+  }
+
+  const HeliumSpaceNode& stored_node = stored[matches.front()];
+  if (auto* captured_tab = std::get_if<HeliumSpaceTab>(&captured->data)) {
+    const auto& stored_tab = std::get<HeliumSpaceTab>(stored_node.data);
+    captured_tab->source_id = stored_tab.source_id;
+    return;
+  }
+
+  auto& captured_folder = std::get<HeliumSpaceFolder>(captured->data);
+  const auto& stored_folder = std::get<HeliumSpaceFolder>(stored_node.data);
+  captured_folder.source_id = stored_folder.source_id;
+  HeliumSpaceNodes merged_children =
+      MergeSpaceNodeIdentity(stored_folder.children,
+                             std::move(captured_folder.children));
+  captured_folder.children = std::move(merged_children);
+}
+
+size_t CountEmptyFoldersWithTitle(const HeliumSpaceNodes& nodes,
+                                  std::string_view title) {
+  size_t count = 0;
+  for (const HeliumSpaceNode& node : nodes) {
+    const auto* folder = std::get_if<HeliumSpaceFolder>(&node.data);
+    if (folder && folder->title == title && folder->children.empty()) {
+      ++count;
+    }
+  }
+  return count;
+}
+
+void PreserveMissingEmptyFolders(const HeliumSpaceNodes& stored,
+                                 HeliumSpaceNodes* captured) {
+  for (size_t stored_index = 0; stored_index < stored.size();
+       ++stored_index) {
+    const HeliumSpaceNode& node = stored[stored_index];
+    const auto* folder = std::get_if<HeliumSpaceFolder>(&node.data);
+    if (!folder || !folder->children.empty()) {
+      continue;
+    }
+    size_t stored_empty_before = 0;
+    for (size_t i = 0; i < stored_index; ++i) {
+      const auto* prior = std::get_if<HeliumSpaceFolder>(&stored[i].data);
+      if (prior && prior->children.empty() && prior->title == folder->title) {
+        ++stored_empty_before;
+      }
+    }
+    if (CountEmptyFoldersWithTitle(*captured, folder->title) <=
+        stored_empty_before) {
+      size_t insertion = captured->size();
+      for (size_t next = stored_index + 1; next < stored.size(); ++next) {
+        for (size_t captured_index = 0; captured_index < captured->size();
+             ++captured_index) {
+          if (SameNodeIdentity(stored[next], (*captured)[captured_index])) {
+            insertion = captured_index;
+            next = stored.size();
+            break;
+          }
+        }
+      }
+      captured->insert(captured->begin() + insertion, node);
+    }
+  }
+}
+
+}  // namespace
+
+base::ListValue EncodeSpaceNodes(const HeliumSpaceNodes& nodes) {
+  base::ListValue encoded;
+  encoded.reserve(nodes.size());
+  for (const HeliumSpaceNode& node : nodes) {
+    encoded.Append(EncodeNode(node));
+  }
+  return encoded;
+}
+
+std::optional<HeliumSpaceNodes> DecodeSpaceNodes(
+    const base::ListValue& encoded_nodes) {
+  HeliumSpaceNodes nodes;
+  nodes.reserve(encoded_nodes.size());
+  for (const base::Value& encoded_node : encoded_nodes) {
+    std::optional<HeliumSpaceNode> node = DecodeNode(encoded_node);
+    if (!node) {
+      return std::nullopt;
+    }
+    nodes.push_back(std::move(*node));
+  }
+  std::set<std::string> ids;
+  if (!CollectIDs(nodes, &ids)) {
+    return std::nullopt;
+  }
+  return nodes;
+}
+
+HeliumSpaceNodes MergeSpaceNodeIdentity(const HeliumSpaceNodes& stored,
+                                         HeliumSpaceNodes captured) {
+  for (HeliumSpaceNode& node : captured) {
+    MergeNodeIdentity(stored, &node);
+  }
+  PreserveMissingEmptyFolders(stored, &captured);
+  return captured;
+}
+
+base::Value HeliumSpaceModel::ToValue() const {
+  base::ListValue favorites;
+  for (const HeliumSpaceTab& favorite : this->favorites) {
+    favorites.Append(EncodeTab(favorite));
+  }
+  base::ListValue spaces;
+  for (const HeliumSpaceRecord& space : this->spaces) {
+    spaces.Append(EncodeSpace(space));
+  }
+  base::DictValue value;
+  value.Set(kVersion, kCurrentVersion);
+  value.Set(kSourceProfile, source_profile);
+  value.Set(kFavorites, std::move(favorites));
+  value.Set(kSpaces, std::move(spaces));
+  return base::Value(std::move(value));
+}
+
+// static
+std::optional<HeliumSpaceModel> HeliumSpaceModel::FromValue(
+    const base::Value& value) {
+  const base::DictValue* root = value.GetIfDict();
+  if (!root || root->size() != 4u ||
+      root->FindInt(kVersion) != kCurrentVersion) {
+    return std::nullopt;
+  }
+  const std::string* source_profile = root->FindString(kSourceProfile);
+  const base::ListValue* encoded_favorites = root->FindList(kFavorites);
+  const base::ListValue* encoded_spaces = root->FindList(kSpaces);
+  if (!source_profile || source_profile->empty() || !encoded_favorites ||
+      !encoded_spaces || encoded_spaces->empty()) {
+    return std::nullopt;
+  }
+  std::vector<HeliumSpaceTab> favorites;
+  std::set<std::string> favorite_ids;
+  for (const base::Value& encoded_favorite : *encoded_favorites) {
+    const base::DictValue* dict = encoded_favorite.GetIfDict();
+    std::optional<HeliumSpaceTab> favorite =
+        dict ? DecodeTab(*dict) : std::nullopt;
+    if (!favorite || !favorite_ids.insert(favorite->source_id).second) {
+      return std::nullopt;
+    }
+    favorites.push_back(std::move(*favorite));
+  }
+  std::vector<HeliumSpaceRecord> spaces;
+  std::set<std::string> space_ids;
+  for (const base::Value& encoded_space : *encoded_spaces) {
+    std::optional<HeliumSpaceRecord> space = DecodeSpace(encoded_space);
+    if (!space || space->source_profile != *source_profile ||
+        !space_ids.insert(space->id).second) {
+      return std::nullopt;
+    }
+    spaces.push_back(std::move(*space));
+  }
+  return HeliumSpaceModel{.source_profile = *source_profile,
+                          .favorites = std::move(favorites),
+                          .spaces = std::move(spaces)};
+}
+
+}  // namespace helium

