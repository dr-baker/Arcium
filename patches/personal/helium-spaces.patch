+void VerticalTabStripBottomContainer::RebuildSpacesList() {
+  spaces_list_->RemoveAllChildViews();
+  auto* service = helium::HeliumSpaceServiceFactory::GetForProfile(
+      browser_->GetProfile());
+  if (!service) {
+    return;
+  }
+  for (helium::HeliumSpace* space : service->GetSpaces()) {
+    auto row = std::make_unique<views::LabelButton>(
+        base::BindRepeating(&VerticalTabStripBottomContainer::ActivateSpace,
+                            base::Unretained(this), space->id()),
+        space->name());
+    row->SetHorizontalAlignment(gfx::ALIGN_LEFT);
+    row->SetTooltipText(u"Open this Space window");
+    spaces_list_->AddChildView(std::move(row));
+  }
+}
