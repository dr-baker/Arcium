+// Copyright 2026 The Helium Authors
+// You can use, redistribute, and/or modify this source code under
+// the terms of the GPL-3.0 license that can be found in the LICENSE file.
+
+#ifndef CHROME_BROWSER_UI_HELIUM_HELIUM_SPACE_MODEL_H_
+#define CHROME_BROWSER_UI_HELIUM_HELIUM_SPACE_MODEL_H_
+
+#include <optional>
+#include <string>
+#include <variant>
+#include <vector>
+
+#include "base/values.h"
+#include "url/gurl.h"
+
+namespace helium {
+
+// A stable, source-owned sidebar item. The model is deliberately independent
+// of live tabs so imports can be validated and reconciled atomically.
+struct HeliumSpaceTab {
+  std::string source_id;
+  std::string title;
+  GURL url;
+
+  bool operator==(const HeliumSpaceTab&) const = default;
+};
+
+struct HeliumSpaceNode;
+
+struct HeliumSpaceFolder {
+  std::string source_id;
+  std::string title;
+  bool collapsed = false;
+  std::vector<HeliumSpaceNode> children;
+
+  bool operator==(const HeliumSpaceFolder&) const = default;
+};
+
+struct HeliumSpaceNode {
+  std::variant<HeliumSpaceTab, HeliumSpaceFolder> data;
+
+  bool operator==(const HeliumSpaceNode&) const = default;
+};
+
+using HeliumSpaceNodes = std::vector<HeliumSpaceNode>;
+
+// These helpers keep the durable Space representation as the normalized
+// ordered item tree. StartupTabs is only a browser/startup boundary view.
+base::ListValue EncodeSpaceNodes(const HeliumSpaceNodes& nodes);
+std::optional<HeliumSpaceNodes> DecodeSpaceNodes(
+    const base::ListValue& encoded_nodes);
+
+// Reattach durable identities after a browser recaptures ordinary tabs.
+// Matching is intentionally unique-only; ambiguity never reuses a stored ID.
+HeliumSpaceNodes MergeSpaceNodeIdentity(const HeliumSpaceNodes& stored,
+                                         HeliumSpaceNodes captured);
+
+struct HeliumSpaceRecord {
+  std::string id;
+  std::string name;
+  std::string source_profile;
+  std::vector<HeliumSpaceNode> pins;
+
+  bool operator==(const HeliumSpaceRecord&) const = default;
+};
+
+// Versioned transport shape used by the importer and tests. Favorites are
+// profile-wide; Pins remain owned by one Space.
+struct HeliumSpaceModel {
+  static constexpr int kCurrentVersion = 1;
+
+  std::string source_profile;
+  std::vector<HeliumSpaceTab> favorites;
+  std::vector<HeliumSpaceRecord> spaces;
+
+  base::Value ToValue() const;
+  static std::optional<HeliumSpaceModel> FromValue(const base::Value& value);
+
+  bool operator==(const HeliumSpaceModel&) const = default;
+};
+
+}  // namespace helium
+
+#endif  // CHROME_BROWSER_UI_HELIUM_HELIUM_SPACE_MODEL_H_

