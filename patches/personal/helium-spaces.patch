+#include "components/pref_registry/pref_registry_syncable.h"
+
+namespace helium {
+
+// static
+HeliumSpaceService* HeliumSpaceServiceFactory::GetForProfile(Profile* profile) {
+  return static_cast<HeliumSpaceService*>(
+      GetInstance()->GetServiceForBrowserContext(profile, true));
+}
+
+// static
+HeliumSpaceServiceFactory* HeliumSpaceServiceFactory::GetInstance() {
+  static base::NoDestructor<HeliumSpaceServiceFactory> instance;
+  return instance.get();
+}
+
+HeliumSpaceServiceFactory::HeliumSpaceServiceFactory()
+    : ProfileKeyedServiceFactory(
+          "HeliumSpaceService",
+          ProfileSelections::Builder()
+              .WithRegular(ProfileSelection::kOriginalOnly)
+              .WithGuest(ProfileSelection::kOriginalOnly)
+              .WithAshInternals(ProfileSelection::kOriginalOnly)
+              .Build()) {}
+
+HeliumSpaceServiceFactory::~HeliumSpaceServiceFactory() = default;
+
+std::unique_ptr<KeyedService>
+HeliumSpaceServiceFactory::BuildServiceInstanceForBrowserContext(
+    content::BrowserContext* context) const {
+  return std::make_unique<HeliumSpaceService>(static_cast<Profile*>(context));
+}
+
+bool HeliumSpaceServiceFactory::ServiceIsCreatedWithBrowserContext() const {
+  return true;
+}
+
+bool HeliumSpaceServiceFactory::ServiceIsNULLWhileTesting() const {
+  return true;
+}
+
+void HeliumSpaceServiceFactory::RegisterProfilePrefs(
+    user_prefs::PrefRegistrySyncable* registry) {
+  registry->RegisterListPref(prefs::kHeliumSpaces);
+  registry->RegisterListPref(prefs::kHeliumFavorites);
+  registry->RegisterStringPref(prefs::kHeliumActiveSpaceId, std::string());
+  registry->RegisterStringPref(prefs::kHeliumSpaceId, std::string());
+  registry->RegisterStringPref(prefs::kHeliumSpaceName, std::string());
+}
+
+}  // namespace helium

