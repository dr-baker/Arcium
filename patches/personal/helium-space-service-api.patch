+HeliumSpace* HeliumSpaceService::GetActiveSpace() {
+  EnsureDefaultSpace();
+  return default_space_.get();
+}
+
+std::string HeliumSpaceService::GetSpaceIdForBrowser(
+    const Browser* browser) const {
+  if (!browser || browser->profile() != profile_ || !default_space_) {
+    return {};
+  }
+  return default_space_->id();
