+TEST_F(ArciumNativePanelTest, LiveDesignPaintInvalidatesCompositedResults) {
+  Open();
+  auto* results = panel()->scroll_for_testing()->contents();
+  // Bitmap fixtures disable compositor scrolling. Give this subtree its own
+  // layer to exercise the production damage boundary instead of force-painting.
+  results->SetPaintToLayer();
+  ASSERT_TRUE(results->layer());
+  auto* row = results->children()[0].get();
+  const auto epoch = state_->epoch;
+  int geometry_notifications = 0;
+  panel()->SetGeometryChangedCallback(base::BindLambdaForTesting([&] { ++geometry_notifications; }));
+  auto apply = [&](CommandPanelAppearance appearance) {
+    results->layer()->SendDamagedRects();
+    ASSERT_TRUE(results->layer()->damaged_region().IsEmpty());
+    panel()->SetAppearance(appearance);
+    EXPECT_FALSE(results->layer()->damaged_region().IsEmpty());
+    EXPECT_EQ(row, results->children()[0].get());
+    EXPECT_EQ(epoch, state_->epoch);
+    EXPECT_EQ(0, geometry_notifications);
+  };
+  auto appearance = CommandPanelAppearance();
+  appearance.design.selection_color = SK_ColorGREEN; apply(appearance);
+  appearance.design.text_color = SK_ColorRED; apply(appearance);
+  appearance.design.muted_color = SK_ColorBLUE; apply(appearance);
+  appearance.design.accent_color = SK_ColorYELLOW; apply(appearance);
+  appearance.design.row_radius = 12; apply(appearance);
+}
