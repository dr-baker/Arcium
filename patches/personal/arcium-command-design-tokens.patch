+void CommandPanelView::UpdatePanelWidth() {
+  if (!GetWidget() || embedded_) return;
+  auto bounds = GetWidget()->GetWindowBoundsInScreen();
+  const int available = available_width_provider_ ? available_width_provider_.Run() : 10000;
+  const int width = std::max(280, std::min(GetPreferredSize().width(), available));
+  if (width == bounds.width()) return;
+  bounds.set_x(bounds.CenterPoint().x() - width / 2);
+  bounds.set_width(width);
+  GetWidget()->SetBounds(bounds);
+}
