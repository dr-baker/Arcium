+TEST(CommandPanelDesignTest, SparseOverridesValidateAndKeepCompiledDefaults) {
+  const CommandPanelDesign defaults;
+  EXPECT_EQ(defaults, *ParseCommandPanelDesign(base::DictValue()));
+  const auto parsed = ParseCommandPanelDesign(base::DictValue()
+      .Set("row_height", 52).Set("glow_softness", 12.5).Set("text_color", "#AbCdEF"));
+  ASSERT_TRUE(parsed);
+  EXPECT_EQ(52, parsed->row_height);
+  EXPECT_DOUBLE_EQ(12.5, parsed->glow_softness);
+  EXPECT_EQ(SkColorSetRGB(0xAB, 0xCD, 0xEF), parsed->text_color);
+  EXPECT_EQ(defaults.panel_width, parsed->panel_width);
+  for (const auto& invalid : {base::DictValue().Set("row_height", true),
+                       base::DictValue().Set("row_height", 39),
+                       base::DictValue().Set("row_height", 65),
+                       base::DictValue().Set("row_height", 43.5),
+                       base::DictValue().Set("text_color", "#0xFFFF"),
+                       base::DictValue().Set("text_color", "#GGGGGG"),
+                       base::DictValue().Set("text_color", 5),
+                       base::DictValue().Set("unknown", 1)}) {
+    EXPECT_FALSE(ParseCommandPanelDesign(invalid));
+  }
+}
+TEST_F(ArciumNativePanelTest, LiveDesignGeometryRetainsRowsQueryAndProviderEpoch) {
+  Open(); Query(u"reference"); Key(ui::VKEY_DOWN);
+  auto* input = panel()->input_for_testing();
+  input->SetSelectedRange(gfx::Range(1, 4));
+  const auto key = panel()->CaptureSelectionKey();
+  const auto epoch = state_->epoch;
+  const auto before = panel()->GetPreferredSize();
+  auto* row = panel()->scroll_for_testing()->contents()->children()[0].get();
+  auto appearance = CommandPanelAppearance();
+  appearance.design.row_height = 56;
+  appearance.design.panel_width = 880;
+  appearance.design.row_gap = 4;
+  appearance.design.input_font_size = 20;
+  panel()->SetAppearance(appearance);
+  views::test::RunScheduledLayout(widget_.get());
+  EXPECT_EQ(epoch, state_->epoch);
+  EXPECT_EQ(input, panel()->input_for_testing());
+  EXPECT_EQ(u"reference", input->GetText());
+  EXPECT_EQ(gfx::Range(1, 4), input->GetSelectedRange());
+  EXPECT_EQ(key, panel()->CaptureSelectionKey());
+  EXPECT_EQ(row, panel()->scroll_for_testing()->contents()->children()[0].get());
+  EXPECT_EQ(56, row->height());
+  EXPECT_GT(panel()->GetPreferredSize().width(), before.width());
+  EXPECT_EQ(20, input->GetFontList().GetFontSize());
+}
+TEST_F(ArciumNativePanelTest, LiveDesignPaintAndMotionAvoidLayoutAndSearch) {
+  Open(); Query(u"interface");
+  int geometry_notifications = 0;
+  panel()->SetGeometryChangedCallback(base::BindLambdaForTesting([&] { ++geometry_notifications; }));
+  auto* row = panel()->scroll_for_testing()->contents()->children()[0].get();
+  const auto epoch = state_->epoch;
+  const auto bounds = panel()->GetPreferredSize();
+  auto appearance = CommandPanelAppearance();
+  appearance.design.glow_softness = 10;
+  appearance.design.text_color = SK_ColorRED;
+  appearance.design.selection_ms = 35;
+  panel()->SetAppearance(appearance);
+  EXPECT_EQ(0, geometry_notifications);
+  EXPECT_EQ(epoch, state_->epoch);
+  EXPECT_EQ(bounds, panel()->GetPreferredSize());
+  EXPECT_EQ(row, panel()->scroll_for_testing()->contents()->children()[0].get());
+  EXPECT_EQ(base::Milliseconds(35), panel()->selection_animation_for_testing()->GetSlideDuration());
+  const auto painted = PaintPanel();
+  auto reset = CommandPanelAppearance(); panel()->SetAppearance(reset);
+  const auto original = PaintPanel();
+  bool changed = false;
+  for (int y = 0; y < painted.height() && !changed; ++y)
+    for (int x = 0; x < painted.width() && !changed; ++x)
+      changed = painted.getColor(x, y) != original.getColor(x, y);
+  EXPECT_TRUE(changed);
+}
+TEST_F(ArciumNativePanelTest, LiveDesignUpdatesFromProfileAndResetToTheme) {
+  TestingPrefServiceSimple prefs;
+  prefs.registry()->RegisterDictionaryPref(kCommandPanelLayoutPref);
+  prefs.registry()->RegisterIntegerPref(kChromeUIScalePref, kChromeUIScaleDefault);
+  prefs.registry()->RegisterDictionaryPref(helium::kArciumChromeAppearancePref);
+  Open();
+  panel()->BindPreferences(&prefs, base::BindRepeating([] { return 1.f; }),
+                          base::BindRepeating([] { return 1000; }));
+  const auto epoch = state_->epoch;
+  prefs.SetDict(kCommandPanelLayoutPref, base::DictValue().Set("design", base::DictValue()
+      .Set("row_height", 54).Set("inactive_scope_strength", 0.25).Set("selected_scope_boost", 0)));
+  views::test::RunScheduledLayout(widget_.get());
+  EXPECT_EQ(54, panel()->scroll_for_testing()->contents()->children()[0]->height());
+  EXPECT_NEAR(.75f * .25f, panel()->scope_glow_strength_for_testing(0), .0001f);
+  EXPECT_EQ(epoch, state_->epoch);
+  prefs.SetDict(kCommandPanelLayoutPref, base::DictValue());
+  views::test::RunScheduledLayout(widget_.get());
+  EXPECT_EQ(43, panel()->scroll_for_testing()->contents()->children()[0]->height());
+  EXPECT_EQ(epoch, state_->epoch);
+  // Registrars must die before their stack-owned PrefService.
+  Close();
+}
+TEST_F(ArciumPanelHeightTest, LiveDesignControlsHeightDebounceAndShrinkDuration) {
+  Open(); Rows(8);
+  auto appearance = CommandPanelAppearance();
+  appearance.design.height_debounce_ms = 20;
+  appearance.design.height_shrink_ms = 90;
+  panel()->SetAppearance(appearance);
+  Stabilize(); requests_.clear();
+  Rows(1);
