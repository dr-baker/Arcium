+TEST_F(ArciumNativePanelTest, LiveDesignPreferenceUpdateCost) {
+  Open();
+  auto appearance = CommandPanelAppearance();
+  // CPU-only setter cost, including validation elsewhere measured separately.
+  // It intentionally does not claim display latency or a browser speedup.
+  const auto epoch = state_->epoch;
+  base::ElapsedTimer elapsed;
+  for (int i = 0; i < 10000; ++i) {
+    appearance.design.glow_softness = 10 + (i % 2);
+    panel()->SetAppearance(appearance);
+  }
+  RecordProperty("design_setter_ns_per_update", base::NumberToString(elapsed.Elapsed().InNanoseconds() / 10000));
+  EXPECT_EQ(epoch, state_->epoch);
+  base::ElapsedTimer parser_elapsed;
+  const auto values = base::DictValue().Set("row_height", 54).Set("glow_softness", 12.5)
+      .Set("text_color", "#ABCDEF").Set("height_debounce_ms", 30);
+  for (int i = 0; i < 10000; ++i) ASSERT_TRUE(ParseCommandPanelDesign(values));
+  RecordProperty("four_token_parse_ns_per_update", base::NumberToString(parser_elapsed.Elapsed().InNanoseconds() / 10000));
+}
