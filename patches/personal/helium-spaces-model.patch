+#ifndef CHROME_BROWSER_UI_HELIUM_HELIUM_SPACE_H_
+#define CHROME_BROWSER_UI_HELIUM_HELIUM_SPACE_H_
+
+#include <string>
+
+#include "base/memory/raw_ptr.h"
+#include "chrome/browser/ui/startup/startup_tab.h"
+
+class BrowserWindowInterface;
+class Profile;
+
+namespace helium {
+
+// User-facing Space within a private Chromium Profile. A Space owns its Pins;
+// Favorites remain shared by the backing profile.
+class HeliumSpace {
+ public:
+  HeliumSpace(Profile* profile, std::string id, std::u16string name);
+  HeliumSpace(const HeliumSpace&) = delete;
+  HeliumSpace& operator=(const HeliumSpace&) = delete;
+  ~HeliumSpace();
+
+  Profile* profile() const { return profile_; }
+
+  const std::string& id() const { return id_; }
+  const std::u16string& name() const { return name_; }
+
+  void SetName(std::u16string name);
+
+  StartupTabs ReadPins() const;
+  void WritePins(const StartupTabs& tabs);
+  void WritePinsFromBrowser(BrowserWindowInterface* browser);
+
+  StartupTabs ReadFavorites() const;
+  void WriteFavorites(const StartupTabs& tabs);
+  void WriteFavoritesFromBrowsers();
+
+  // Primary TYPE_NORMAL tabbed window for this Space, if any.
+  BrowserWindowInterface* GetPrimaryBrowser() const;
+
+  // Activate the primary window, or create one when missing.
+  BrowserWindowInterface* ActivateOrCreatePrimaryWindow();
+
+ private:
+  raw_ptr<Profile> profile_;
+  std::string id_;
+  std::u16string name_;
+};
+
+}  // namespace helium
