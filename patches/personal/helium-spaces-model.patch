+#include "chrome/browser/ui/browser_window/public/profile_browser_collection.h"
+#include "chrome/browser/ui/helium/helium_space_service.h"
+#include "chrome/browser/ui/helium/helium_space_service_factory.h"
+#include "chrome/browser/ui/startup/startup_browser_creator_impl.h"
+#include "chrome/browser/ui/startup/startup_types.h"
+#include "chrome/browser/ui/tabs/pin_tab_codec.h"
+#include "chrome/browser/ui/tabs/pinned_tab_codec.h"
+#include "chrome/browser/ui/tabs/tab_strip_model.h"
+#include "chrome/common/pref_names.h"
+#include "components/prefs/pref_service.h"
+#include "components/prefs/scoped_user_pref_update.h"
+
+namespace helium {
+
+namespace {
+
+constexpr char kIdKey[] = "id";
+constexpr char kNameKey[] = "name";
+constexpr char kPinsKey[] = "pins";
+
+base::DictValue* FindSpaceRecord(base::ListValue& records,
+                                 const std::string& id) {
+  for (base::Value& value : records) {
+    base::DictValue* record = value.GetIfDict();
+    const std::string* record_id = record ? record->FindString(kIdKey) : nullptr;
+    if (record_id && *record_id == id) {
+      return record;
+    }
+  }
+  return nullptr;
+}
+
+const base::DictValue* FindSpaceRecord(const base::ListValue& records,
+                                       const std::string& id) {
+  for (const base::Value& value : records) {
+    const base::DictValue* record = value.GetIfDict();
+    const std::string* record_id = record ? record->FindString(kIdKey) : nullptr;
+    if (record_id && *record_id == id) {
+      return record;
+    }
+  }
+  return nullptr;
+}
+
+}  // namespace
+
+HeliumSpace::HeliumSpace(Profile* profile,
+                         std::string id,
+                         std::u16string name)
+    : profile_(profile), id_(std::move(id)), name_(std::move(name)) {}
+
+HeliumSpace::~HeliumSpace() = default;
+
+void HeliumSpace::SetName(std::u16string name) {
+  name_ = name.empty() ? u"Space" : std::move(name);
+  ScopedListPrefUpdate update(profile_->GetPrefs(), kHeliumSpacesPref);
+  if (base::DictValue* record = FindSpaceRecord(update.Get(), id_)) {
+    record->Set(kNameKey, base::UTF16ToUTF8(name_));
+  }
+}
+
+StartupTabs HeliumSpace::ReadPins() const {
+  const base::DictValue* record =
+      FindSpaceRecord(profile_->GetPrefs()->GetList(kHeliumSpacesPref), id_);
+  const base::ListValue* pins = record ? record->FindList(kPinsKey) : nullptr;
+  return pins ? PinTabCodec::DecodePins(*pins) : StartupTabs();
+}
+
+void HeliumSpace::WritePins(const StartupTabs& tabs) {
+  ScopedListPrefUpdate update(profile_->GetPrefs(), kHeliumSpacesPref);
+  if (base::DictValue* record = FindSpaceRecord(update.Get(), id_)) {
+    record->Set(kPinsKey, PinTabCodec::EncodePins(tabs));
+  }
+}
+
+void HeliumSpace::WritePinsFromBrowser(BrowserWindowInterface* browser) {
+  ScopedListPrefUpdate update(profile_->GetPrefs(), kHeliumSpacesPref);
+  if (base::DictValue* record = FindSpaceRecord(update.Get(), id_)) {
+    record->Set(kPinsKey, PinTabCodec::CapturePins(browser));
+  }
+}
+
+StartupTabs HeliumSpace::ReadFavorites() const {
+  return PinnedTabCodec::ReadPinnedTabs(profile_);
+}
+
+void HeliumSpace::WriteFavorites(const StartupTabs& tabs) {
+  PinnedTabCodec::WritePinnedTabs(profile_, tabs);
+}
+
+void HeliumSpace::WriteFavoritesFromBrowsers() {
+  BrowserWindowInterface* match = nullptr;
+  auto* space_service = HeliumSpaceServiceFactory::GetForProfile(profile_);
+  if (!space_service) {
+    return;
+  }
+  ProfileBrowserCollection::GetForProfile(profile_)->ForEach(
+      [space_service, &match](BrowserWindowInterface* window) {
+        Browser* browser = window->GetBrowserForMigrationOnly();
+        if (window->GetType() == BrowserWindowInterface::TYPE_NORMAL &&
+            browser &&
+            !space_service->GetSpaceIdForBrowser(browser).empty()) {
+          match = window;
+          return false;
+        }
+        return true;
+      },
+      BrowserCollection::Order::kActivation);
+  if (match) {
+    PinnedTabCodec::WritePinnedTabs(profile_, match);
+  }
+}
+
+BrowserWindowInterface* HeliumSpace::GetPrimaryBrowser() const {
+  BrowserWindowInterface* match = nullptr;
+  auto* space_service = HeliumSpaceServiceFactory::GetForProfile(profile_);
+  if (!space_service) {
+    return nullptr;
+  }
+  ProfileBrowserCollection::GetForProfile(profile_)->ForEach(
+      [this, space_service, &match](BrowserWindowInterface* window) {
+        if (window->GetType() != BrowserWindowInterface::TYPE_NORMAL) {
+          return true;
+        }
+        Browser* browser = window->GetBrowserForMigrationOnly();
+        const std::string_view browser_space_id =
+            space_service->GetSpaceIdForBrowser(browser);
+        if (browser && browser_space_id == id_) {
+          match = window;
+          return false;
+        }
+        return true;
+      },
+      BrowserCollection::Order::kActivation);
+  return match;
+}
+
+BrowserWindowInterface* HeliumSpace::ActivateOrCreatePrimaryWindow() {
+  auto* space_service = HeliumSpaceServiceFactory::GetForProfile(profile_);
+  if (!space_service) {
+    return nullptr;
+  }
+  space_service->SetActiveSpace(id_);
+  if (BrowserWindowInterface* existing = GetPrimaryBrowser()) {
+    if (Browser* browser = existing->GetBrowserForMigrationOnly()) {
+      browser->window()->Show();
+      return existing;
+    }
+  }
+
+  if (Browser::GetCreationStatusForProfile(profile_) !=
+      Browser::CreationStatus::kOk) {
+    return nullptr;
+  }
+  if (profile_->ShutdownStarted()) {
+    return nullptr;
+  }
+
+  Browser::CreateParams params(Browser::TYPE_NORMAL, profile_, true);
+  params.should_trigger_session_restore = false;
+  Browser* browser = Browser::Create(params);
+  space_service->SetSpaceForBrowser(browser, id_);
+
+  StartupTabs startup_tabs = ReadFavorites();
+  StartupTabs pins = ReadPins();
+  startup_tabs.insert(startup_tabs.end(), pins.begin(), pins.end());
+  if (!startup_tabs.empty()) {
+    StartupBrowserCreatorImpl creator(
+        base::FilePath(), *base::CommandLine::ForCurrentProcess(),
+        chrome::startup::IsFirstRun::kNo);
+    creator.OpenTabsInBrowserForSpace(browser, startup_tabs);
+  } else if (browser->tab_strip_model()->empty()) {
+    chrome::AddTabAt(browser, GURL(), -1, true);
+  }
+  browser->window()->Show();
+  return browser;
+}
+
+}  // namespace helium
