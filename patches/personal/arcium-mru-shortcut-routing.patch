# Route explicit recent-tab shortcuts through macOS priority dispatch and use visible, nonempty browser fixtures.
# Requires arcium-mru-tab-switcher and arcium-shortcut-presets.
Index: src/chrome/browser/ui/views/frame/browser_view.cc
===================================================================
--- src.orig/chrome/browser/ui/views/frame/browser_view.cc
+++ src/chrome/browser/ui/views/frame/browser_view.cc
@@ -7269,7 +7269,9 @@ void BrowserView::LoadAccelerators() {
       if (entry.keycode == ui::VKEY_TAB &&
           (entry.modifiers & ui::EF_CONTROL_DOWN) &&
           (entry.command_id == IDC_SELECT_NEXT_TAB ||
-           entry.command_id == IDC_SELECT_PREVIOUS_TAB)) {
+           entry.command_id == IDC_SELECT_PREVIOUS_TAB ||
+           entry.command_id == IDC_ARCIUM_SELECT_RECENT_TAB ||
+           entry.command_id == IDC_ARCIUM_SELECT_PREVIOUS_RECENT_TAB)) {
         priority = ui::AcceleratorManager::kHighPriority;
       }
 #endif
