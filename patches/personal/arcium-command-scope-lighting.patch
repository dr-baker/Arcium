+// A cheap area-light approximation shared by connected and detached scopes.
+// The blurred footprint grows with the emitter. Dividing its emitted power by
+// that footprint keeps total light proportional to source area, so small peeks
+// naturally cast less light without turning into narrow, fixed-depth beams.
+void PaintScopeLight(gfx::Canvas* canvas,
+                     const CommandScopeDescriptor& scope,
+                     const gfx::RectF& source,
+                     float scale,
+                     float strength,
+                     const SkPath& contour) {
+  if (source.IsEmpty() || strength <= 0) return;
+  const float softness = 20 * scale;
+  const float radius_x = source.width() / 2 + softness;
+  const float radius_y = source.height() / 2 + softness;
+  const float power = source.width() * source.height();
+  const float radiance = .24f * strength * power / (radius_x * radius_y);
+  const auto lobe = [&](SkColor tint, float center_x, float share) {
+    if (tint == SK_ColorTRANSPARENT) return;
+    auto matrix = SkMatrix::Scale(radius_x, radius_y);
+    matrix.postTranslate(center_x, source.CenterPoint().y());
+    const auto color = [&](float falloff) {
+      return SkColor4f::FromColor(Alpha(tint, std::clamp(
+          base::ClampRound(255 * radiance * share * falloff), 0, 255)));
+    };
+    // Sampled inverse-square falloff, smoothly reaching zero at the footprint.
+    const SkColor4f stops[] = {color(1), color(.52f), color(.18f),
+                              color(.05f), SkColors::kTransparent};
+    const SkScalar positions[] = {0, .25f, .5f, .75f, 1};
+    cc::PaintFlags flags;
+    flags.setShader(cc::PaintShader::MakeRadialGradient(
+        {0, 0}, 1, stops, positions, 5, SkTileMode::kClamp,
+        SkGradient::Interpolation{}, 0, &matrix));
+    canvas->DrawPath(contour, flags);
+  };
+  const float center = source.CenterPoint().x();
+  if (scope.id == kOmniScope) {
+    // One emitter's energy, shared across its three colors.
+    lobe(SkColorSetRGB(174, 112, 245), center - source.width() * .24f, .4f);
+    lobe(SkColorSetRGB(100, 159, 255), center + source.width() * .24f, .4f);
+    lobe(SkColorSetRGB(89, 206, 157), center, .2f);
+  } else {
+    lobe(scope.tint, center, 1.f);
+  }
+}
+
