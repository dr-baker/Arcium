+
+float BrowserView::GetCaptionChromeRevealRatio() const {
+  if (!IsSidebarNavigationActive()) {
+    return GetTopChromeRevealRatio();
+  }
+  if (!IsToolbarVisible()) {
+    return 0.f;
+  }
+  auto* animation = BrowserAnimationController::From(browser_);
+  const auto motion =
+      animation->GetCurrentMotion(TabStripAnimations::kVerticalTabStrip);
+  if (motion == TabStripAnimations::kCollapse ||
+      motion == TabStripAnimations::kExpand) {
+    return (zen_mode_enabled_ ? GetSideChromeRevealRatio() : 1.f) *
+           *animation->GetCurrentValue(TabStripAnimations::kVerticalTabStrip,
+                                       TabStripAnimations::kTabStripWidth);
+  }
+  if (IsVerticalTabStripCollapsed()) {
+    if (!vertical_tab_strip_region_view_
+             ->IsSidebarNavigationTemporarilyExpanded()) {
+      return 0.f;
+    }
+    return GetSideChromeRevealRatio() *
+           *animation->GetCurrentValue(TabStripAnimations::kVerticalTabStrip,
+                                       TabStripAnimations::kTabStripHoverWidth);
+  }
+  return GetSideChromeRevealRatio();
+}
+
+void BrowserView::UpdateSidebarNavigationPlacement() {
+  if (!toolbar_ || !vertical_tab_strip_region_view_ ||
+      !toolbar_->initialized()) {
+    return;
+  }
+  const bool sidebar = IsSidebarNavigationActive();
+  views::View* destination =
+      sidebar ? static_cast<views::View*>(vertical_tab_strip_region_view_.get())
+              : static_cast<views::View*>(top_container_.get());
+  const bool parent_changed = toolbar_->parent() != destination;
+  if (parent_changed) {
+    views::View* focused =
+        GetFocusManager() ? GetFocusManager()->GetFocusedView() : nullptr;
+    const bool restore_focus = focused && toolbar_->Contains(focused);
+    auto owned = toolbar_->parent()->RemoveChildViewT(toolbar_.get());
+    destination->AddChildViewAt(std::move(owned), 0);
+    toolbar_->SetProperty(
+        views::kFlexBehaviorKey,
+        views::FlexSpecification(views::LayoutOrientation::kVertical,
+                                 views::MinimumFlexSizeRule::kPreferred,
+                                 views::MaximumFlexSizeRule::kPreferred));
+    if (restore_focus) {
+      focused->RequestFocus();
+    }
+  }
+  toolbar_->SetSidebarNavigationMode(sidebar);
+  if (!sidebar) {
+    sidebar_navigation_pointer_reveal_ = false;
+    sidebar_navigation_reveal_lock_.reset();
+  }
+  if (parent_changed) {
+    if (auto* frame_view = GetFrameView()) {
+      frame_view->SetCaptionButtonsOpacity(GetCaptionChromeRevealRatio());
+    }
+    vertical_tab_strip_region_view_->UpdateInteriorMargin();
+    UpdateZenModeEventMonitor();
+    InvalidateLayout();
+  }
+}
+
+std::unique_ptr<ExpandOnHoverLock>
+BrowserView::AcquireSidebarNavigationRevealLock() {
+  if (!IsSidebarNavigationActive() || !vertical_tab_strip_region_view_) {
+    return nullptr;
+  }
+  ++sidebar_navigation_external_reveal_count_;
+  auto lock = vertical_tab_strip_region_view_->GetExpandOnHoverLock(
+      ExpandOnHoverLockType::kKeepExpanded);
+  if (IsVerticalTabStripCollapsed()) {
+    BrowserAnimationController::From(browser_)->Reset(
+        TabStripAnimations::kVerticalTabStrip,
+        TabStripAnimations::kExpandOnHover);
+  }
+  zen_side_chrome_animation_.Reset(1.f);
+  if (auto* frame = GetFrameView()) {
+    frame->SetCaptionButtonsOpacity(GetCaptionChromeRevealRatio());
+  }
+  InvalidateLayout();
+  if (GetWidget()) {
+    GetWidget()->GetRootView()->DeprecatedLayoutImmediately();
+  }
+  return std::make_unique<SidebarNavigationRevealLock>(
+      std::move(lock), base::BindOnce(
+                           [](base::WeakPtr<BrowserView> view) {
+                             if (!view) {
+                               return;
+                             }
+                             --view->sidebar_navigation_external_reveal_count_;
+                             view->UpdateSidebarNavigationReveal();
+                             view->InvalidateLayout();
+                             if (auto* frame = view->GetFrameView()) {
+                               frame->SetCaptionButtonsOpacity(
+                                   view->GetCaptionChromeRevealRatio());
+                             }
+                             if (view->IsChromeRevealModeEnabled()) {
+                               view->UpdateZenModeRevealFromCursor();
+                             }
+                           },
+                           weak_ptr_factory_.GetWeakPtr()));
+}
+
+void BrowserView::UpdateSidebarNavigationReveal() {
+  if (!IsSidebarNavigationActive() || !vertical_tab_strip_region_view_) {
+    sidebar_navigation_reveal_lock_.reset();
+    return;
+  }
+  views::View* focus =
+      GetFocusManager() ? GetFocusManager()->GetFocusedView() : nullptr;
+  const bool interaction_hold = (focus && toolbar_->Contains(focus)) ||
+                                HasOpenBubbleFromTopContainer() ||
+                                toolbar_->IsSidebarNavigationMenuShowing() ||
+                                sidebar_navigation_external_reveal_count_ > 0;
+  if (toolbar_temporarily_revealed_for_location_focus_ && !interaction_hold) {
+    toolbar_temporarily_revealed_for_location_focus_ = false;
+    InvalidateLayout();
+    if (auto* frame = GetFrameView()) {
+      frame->SetCaptionButtonsOpacity(GetCaptionChromeRevealRatio());
+    }
+  }
+  const bool hold = interaction_hold ||
+                    (sidebar_navigation_pointer_reveal_ &&
+                     (zen_mode_enabled_ || IsFullyHiddenSidebarStyleEnabled()));
+  if (hold && !sidebar_navigation_reveal_lock_) {
+    sidebar_navigation_reveal_lock_ =
+        vertical_tab_strip_region_view_->GetExpandOnHoverLock(
+            ExpandOnHoverLockType::kKeepExpanded);
+  } else if (!hold) {
+    sidebar_navigation_reveal_lock_.reset();
+  }
+}
