+  if (enabled && !drawer_enabled && IsExtensionsMenuShowing()) {
+    HideExtensionsMenu();
+  }
+  sidebar_menu_only_ = enabled;
+  sidebar_drawer_enabled_ = drawer_enabled;
+  if (!enabled) {
+    sidebar_extension_ui_requested_ = false;
+    sidebar_extension_reveal_lock_.reset();
+    extensions_button_->SetVisible(true);
+    close_side_panel_button_->SetVisible(side_panel_active_);
+  }
+  for (const auto& [id, view] : icons_) {
+    UpdateIconVisibility(id);
+  }
+  UpdateControlsVisibility();
+  UpdateContainerVisibility();
+  GetAnimatingLayoutManager()->ResetLayout();
+  PreferredSizeChanged();
+}
