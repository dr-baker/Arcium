+void ToolbarView::SetSidebarNavigationExclusion(int width, int height) {
+  if (sidebar_navigation_exclusion_width_ == width &&
+      sidebar_navigation_exclusion_height_ == height) {
+    return;
+  }
+  sidebar_navigation_exclusion_width_ = width;
+  sidebar_navigation_exclusion_height_ = height;
+  PreferredSizeChanged();
+}
+
+gfx::Size ToolbarView::GetSidebarNavigationSize() const {
+  const int padding = arcium::ScaleChromeDip(this, 6);
+  const int gap = arcium::ScaleChromeDip(this, 4);
+  const int navigation_height = std::max(GetBackForwardButtonSize().height(),
+                                         sidebar_navigation_exclusion_height_);
+  return {arcium::ScaleChromeDip(this, 160),
+          padding * 2 + navigation_height + gap +
+              location_bar_->PreferredSize().height()};
+}
+
+void ToolbarView::LayoutSidebarNavigation() {
+  const int padding = arcium::ScaleChromeDip(this, 6);
+  const int gap = arcium::ScaleChromeDip(this, 4);
+  const int row_height = std::max(GetBackForwardButtonSize().height(),
+                                  sidebar_navigation_exclusion_height_);
+  for (views::View* child : children()) {
+    if (child != back_ && child != forward_ && child != reload_ &&
+        child != home_ && child != vertical_tabs_collapse_button_ &&
+        child != app_menu_button_ && child != location_bar_view_ &&
+        child != extensions_container_ &&
+        child != sidebar_navigation_overflow_) {
+      child->SetBoundsRect(gfx::Rect());
+    }
+  }
+  location_bar_view_->SetVisible(true);
+  UpdateVerticalTabsCollapseButton();
+  const int right = std::max(padding, width() - padding);
+  int x = std::min(right, padding + sidebar_navigation_exclusion_width_);
+  struct Control {
+    views::View* view;
+    bool shown;
+    int command;
+    int label;
+  };
+  std::vector<Control> controls = {
+      {back_, show_back_button_.GetValue(), IDC_BACK, IDS_ACCNAME_BACK},
+      {forward_, show_forward_button_.GetValue(), IDC_FORWARD,
+       IDS_ACCNAME_FORWARD},
+      {reload_, show_reload_button_.GetValue(), IDC_RELOAD, IDS_ACCNAME_RELOAD},
+      {home_, show_home_button_.GetValue(), IDC_HOME, IDS_TOOLTIP_HOME},
+      {vertical_tabs_collapse_button_,
+       show_vertical_tabs_collapse_button_.GetValue(),
+       IDC_TOGGLE_VERTICAL_TABS_COLLAPSE,
+       browser_view_->IsVerticalTabStripCollapsed()
+           ? IDS_EXPAND_VERTICAL_TABS
+           : IDS_COLLAPSE_VERTICAL_TABS},
+      {app_menu_button_, show_menu_button_.GetValue(), IDC_SHOW_APP_MENU,
+       IDS_APPMENU_TOOLTIP},
+  };
+  const int overflow_width =
+      sidebar_navigation_overflow_->GetPreferredSize().width();
+  int requested_width = 0;
+  for (const auto& control : controls) {
+    if (control.view && control.shown) {
+      requested_width += control.view->GetPreferredSize().width() + gap;
+    }
+  }
+  const bool overflow =
+      requested_width > right - x || sidebar_navigation_app_menu_open_;
+  const int controls_right =
+      overflow ? std::max(x, right - overflow_width - gap) : right;
+  std::vector<std::pair<int, int>> hidden_commands;
+  for (const auto& control : controls) {
+    if (!control.view) {
+      continue;
+    }
+    const auto preferred = control.view->GetPreferredSize();
+    const bool fits = control.shown && x + preferred.width() <= controls_right;
+    control.view->SetVisible(fits);
+    control.view->SetBoundsRect(
+        fits ? gfx::Rect(x, padding + (row_height - preferred.height()) / 2,
+                         preferred.width(), preferred.height())
+             : gfx::Rect());
+    if (fits) {
+      x += preferred.width() + gap;
+    } else if (control.shown) {
+      hidden_commands.emplace_back(control.command, control.label);
+    }
+  }
+  static_cast<SidebarNavigationOverflowButton*>(
+      sidebar_navigation_overflow_.get())
+      ->SetCommands(hidden_commands);
+  const bool show_overflow =
+      !hidden_commands.empty() || sidebar_navigation_app_menu_open_;
+  sidebar_navigation_overflow_->SetVisible(show_overflow);
+  sidebar_navigation_overflow_->SetBoundsRect(
+      !show_overflow
+          ? gfx::Rect()
+          : gfx::Rect(std::max(padding, right - overflow_width), padding,
+                      std::min(overflow_width, right - padding), row_height));
+  const int address_y = padding + row_height + gap;
+  int address_right = right;
+  if (extensions_container_ && extensions_container_->GetVisible()) {
+    const int extension_width = extensions_container_->GetExtensionsButton()
+                                    ->GetPreferredSize()
+                                    .width();
+    extensions_container_->SetBounds(std::max(padding, right - extension_width),
+                                     address_y, extension_width,
+                                     location_bar_->PreferredSize().height());
+    address_right = std::max(padding, right - extension_width - gap);
+  }
+  location_bar_view_->SetBounds(padding, address_y,
+                                std::max(0, address_right - padding),
+                                location_bar_->PreferredSize().height());
+  for (views::View* child : children()) {
+    if (child->GetVisible()) {
+      child->DeprecatedLayoutImmediately();
+    }
+  }
+}
