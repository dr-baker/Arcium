+// Uses the browser's commands for controls that cannot fit beside captions.
+class SidebarNavigationOverflowButton : public ToolbarButton,
+                                        public ui::SimpleMenuModel::Delegate {
+  METADATA_HEADER(SidebarNavigationOverflowButton, ToolbarButton)
+
+ public:
+  explicit SidebarNavigationOverflowButton(BrowserWindowInterface* browser)
+      : ToolbarButton(base::BindRepeating(
+                          &SidebarNavigationOverflowButton::ShowNavigationMenu,
+                          base::Unretained(this)),
+                      std::make_unique<ui::SimpleMenuModel>(this),
+                      nullptr,
+                      /*trigger_menu_on_long_press=*/false),
+        browser_(browser) {
+    SetButtonController(std::make_unique<views::MenuButtonController>(
+        this,
+        base::BindRepeating(
+            &SidebarNavigationOverflowButton::ShowNavigationMenu,
+            base::Unretained(this)),
+        std::make_unique<views::Button::DefaultButtonControllerDelegate>(
+            this)));
+    SetTooltipText(l10n_util::GetStringUTF16(IDS_TOOLTIP_OVERFLOW_BUTTON));
+    SetVectorIcon(kMoreVertIcon);
+  }
+  void SetCommands(const std::vector<std::pair<int, int>>& commands) {
+    if (IsMenuShowing()) {
+      return;
+    }
+    NavigationModel().Clear();
+    for (const auto& [command, label] : commands) {
+      NavigationModel().AddItem(command, l10n_util::GetStringUTF16(label));
+    }
+  }
+  bool IsCommandIdEnabled(int command_id) const override {
+    return chrome::IsCommandEnabled(browser_, ResolveCommand(command_id));
+  }
+  void ExecuteCommand(int command_id, int event_flags) override {
+    chrome::ExecuteCommand(browser_, ResolveCommand(command_id));
+  }
+
+ private:
+  int ResolveCommand(int command) const {
+    if (command == IDC_RELOAD &&
+        BrowserView::GetBrowserViewForBrowser(browser_)
+                ->toolbar()
+                ->reload_button()
+                ->GetVisibleMode() == ReloadControl::Mode::kStop) {
+      return IDC_STOP;
+    }
+    return command;
+  }
+  void ShowNavigationMenu(const ui::Event& event) {
+    for (size_t index = 0; index < NavigationModel().GetItemCount(); ++index) {
+      if (NavigationModel().GetCommandIdAt(index) == IDC_RELOAD) {
+        NavigationModel().SetLabel(
+            index,
+            l10n_util::GetStringUTF16(ResolveCommand(IDC_RELOAD) == IDC_STOP
+                                          ? IDS_TOOLTIP_STOP
+                                          : IDS_ACCNAME_RELOAD));
+      }
+    }
+    ShowMenuForModel(ui::mojom::MenuSourceType::kMouse, &NavigationModel());
+  }
+  const raw_ptr<BrowserWindowInterface> browser_;
+  ui::SimpleMenuModel& NavigationModel() {
+    return *static_cast<ui::SimpleMenuModel*>(menu_model());
+  }
+};
