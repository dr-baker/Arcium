+void ToolbarView::SetSidebarNavigationMode(bool sidebar) {
+  if (sidebar_navigation_mode_ != sidebar) {
+    sidebar_navigation_mode_ = sidebar;
+    if (sidebar) {
+      sidebar_navigation_owned_layer_ = !layer();
+      if (sidebar_navigation_owned_layer_) {
+        SetPaintToLayer();
+        layer()->SetFillsBoundsOpaquely(false);
+      }
+      sidebar_navigation_previous_clip_ = layer()->GetMasksToBounds();
+      layer()->SetMasksToBounds(true);
+      // A hidden parent suppresses rendering without changing model-owned
+      // visibility. Live media, download and profile state survives a move.
+      sidebar_saved_order_.clear();
+      const auto original_children = children();
+      for (size_t index = 0; index < original_children.size(); ++index) {
+        views::View* child = original_children[index];
+        if (child == sidebar_suppressed_controls_ || child == back_ ||
+            child == forward_ || child == reload_ || child == home_ ||
+            child == vertical_tabs_collapse_button_ ||
+            child == app_menu_button_ || child == location_bar_view_ ||
+            child == extensions_container_ ||
+            child == sidebar_navigation_overflow_) {
+          continue;
+        }
+        sidebar_saved_order_.emplace_back(child, index);
+        sidebar_suppressed_controls_->AddChildView(RemoveChildViewT(child));
+      }
+    } else {
+      if (sidebar_navigation_app_menu_open_ && app_menu_button_) {
+        app_menu_button_->CloseMenu();
+      }
+      sidebar_navigation_app_menu_open_ = false;
+      if (layer()) {
+        layer()->SetMasksToBounds(sidebar_navigation_previous_clip_);
+        if (sidebar_navigation_owned_layer_) {
+          DestroyLayer();
+        }
+      }
+      for (const auto& [child, index] : sidebar_saved_order_) {
+        AddChildViewAt(
+            sidebar_suppressed_controls_->RemoveChildViewT(child.get()),
+            std::min(index, children().size()));
+      }
+      sidebar_saved_order_.clear();
+      sidebar_navigation_overflow_->SetVisible(false);
+      OnShowBackButtonChanged();
+      OnShowForwardButtonChanged();
+      OnShowReloadButtonChanged();
+      OnShowHomeButtonChanged();
+      if (avatar_ && browser_->profile()->IsRegularProfile() &&
+          !base::CommandLine::ForCurrentProcess()->HasSwitch(
+              "show-avatar-button")) {
+        OnShowAvatarButtonChanged();
+      }
+      if (app_menu_button_) {
+        OnShowMenuButtonChanged();
+      }
+      UpdateToolbarLayout();
+    }
+    location_bar_view_->SetSidebarNavigationMode(sidebar);
+    PreferredSizeChanged();
+  }
+  if (extensions_container_) {
+    extensions_container_->SetSidebarMenuOnly(
+        sidebar, browser_->profile()->GetPrefs()->GetBoolean(
+                     arcium::kSidebarExtensionsDrawerEnabledPref));
+  }
+}
+
+bool ToolbarView::IsSidebarNavigationMenuShowing() const {
+  return (back_ && back_->IsMenuShowing()) ||
+         (forward_ && forward_->IsMenuShowing()) ||
+         (app_menu_button_ && app_menu_button_->IsMenuShowing()) ||
+         (sidebar_navigation_overflow_ &&
+          sidebar_navigation_overflow_->IsMenuShowing()) ||
+         (extensions_container_ &&
+          extensions_container_->IsExtensionsMenuShowing());
+}
+
+void ToolbarView::SetSidebarNavigationAppMenuOpen(bool open) {
+  if (sidebar_navigation_app_menu_open_ == open) {
