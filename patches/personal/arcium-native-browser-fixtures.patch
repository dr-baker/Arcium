+IN_PROC_BROWSER_TEST_F(TabViewTest,
+                       ChromeScaleCacheTracksWidgetsAndPreferences) {
+  views::View detached;
+  EXPECT_DOUBLE_EQ(1.0, arcium::GetChromeUIScale(&detached));
+  BrowserView* initial = BrowserView::GetBrowserViewForBrowser(browser());
+  ASSERT_TRUE(initial);
+  EXPECT_DOUBLE_EQ(1.0, arcium::GetChromeUIScale(initial));
+
+  PrefService* prefs = browser()->GetProfile()->GetPrefs();
+  prefs->SetInteger(arcium::kChromeUIScalePref, 115);
+  EXPECT_DOUBLE_EQ(1.15, arcium::GetChromeUIScale(initial));
+  BrowserWindowInterface* second_browser = CreateBrowser(browser()->GetProfile());
+  BrowserView* second =
+      BrowserView::GetBrowserViewForBrowser(second_browser);
+  ASSERT_TRUE(second);
+  EXPECT_DOUBLE_EQ(1.15, arcium::GetChromeUIScale(second));
+
+  auto make_widget = [](views::Widget* parent) {
+    auto widget = std::make_unique<views::Widget>();
+    views::Widget::InitParams params(
+        views::Widget::InitParams::CLIENT_OWNS_WIDGET,
+        views::Widget::InitParams::TYPE_POPUP);
+    if (parent) {
+      params.SetParent(parent);
+    }
+    widget->Init(std::move(params));
+    widget->SetContentsView(std::make_unique<views::View>());
+    return widget;
+  };
+  auto popup = make_widget(second->GetWidget());
+  ASSERT_EQ(second->GetWidget(), popup->parent());
+  auto plain = make_widget(nullptr);
+  auto* moving = popup->GetContentsView()->AddChildView(
+      std::make_unique<views::View>());
+  EXPECT_DOUBLE_EQ(1.15, arcium::GetChromeUIScale(moving));
+  EXPECT_DOUBLE_EQ(1.0,
+                   arcium::GetChromeUIScale(plain->GetContentsView()));
+
+  prefs->SetInteger(arcium::kChromeUIScalePref, 125);
+  EXPECT_DOUBLE_EQ(1.25, arcium::GetChromeUIScale(initial));
+  EXPECT_DOUBLE_EQ(1.25, arcium::GetChromeUIScale(second));
+  EXPECT_DOUBLE_EQ(1.25, arcium::GetChromeUIScale(moving));
+
+  auto ownership = popup->GetContentsView()->RemoveChildViewT(moving);
+  EXPECT_DOUBLE_EQ(1.0, arcium::GetChromeUIScale(moving));
+  plain->GetContentsView()->AddChildView(std::move(ownership));
+  EXPECT_DOUBLE_EQ(1.0, arcium::GetChromeUIScale(moving));
+  ownership = plain->GetContentsView()->RemoveChildViewT(moving);
+  popup->GetContentsView()->AddChildView(std::move(ownership));
+  EXPECT_DOUBLE_EQ(1.25, arcium::GetChromeUIScale(moving));
+
+  prefs->SetInteger(arcium::kChromeUIScalePref, 0);
+  EXPECT_DOUBLE_EQ(0.8, arcium::GetChromeUIScale(moving));
+  prefs->SetInteger(arcium::kChromeUIScalePref, 100);
+  EXPECT_DOUBLE_EQ(1.0, arcium::GetChromeUIScale(initial));
+  EXPECT_DOUBLE_EQ(1.0, arcium::GetChromeUIScale(second));
+  EXPECT_DOUBLE_EQ(1.0, arcium::GetChromeUIScale(moving));
+  popup->CloseNow();
+  plain->CloseNow();
+}
