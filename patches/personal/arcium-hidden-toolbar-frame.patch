+#include "components/split_tabs/split_tab_visual_data.h"
+#include "chrome/browser/ui/toolbar/pinned_toolbar/pinned_toolbar_actions_model.h"
+#include "chrome/browser/ui/toolbar/pinned_toolbar/pinned_toolbar_actions_model_factory.h"
+#include "chrome/browser/ui/views/frame/browser_view.h"
+#include "chrome/browser/ui/views/frame/contents_container_view.h"
+#include "chrome/browser/ui/views/frame/multi_contents_view.h"
+#include "chrome/common/pref_names.h"
+#include "components/prefs/pref_service.h"
+#include "ui/views/widget/widget.h"
+
+class ArciumBrowserChromeTest : public TestWithBrowserView {
+ protected:
+  TestingProfile::TestingFactories GetTestingFactories() override {
+    auto factories = TestWithBrowserView::GetTestingFactories();
+    factories.emplace_back(
+        PinnedToolbarActionsModelFactory::GetInstance(),
+        base::BindRepeating([](content::BrowserContext* context)
+                               -> std::unique_ptr<KeyedService> {
+          return std::make_unique<PinnedToolbarActionsModel>(
+              Profile::FromBrowserContext(context));
+        }));
+    return factories;
+  }
+
+  void SetUp() override {
+    TestWithBrowserView::SetUp();
+    AddTab(browser(), GURL("https://example.com/"));
+    prefs()->SetInteger(arcium::kChromeUIScalePref, 100);
+    prefs()->SetBoolean(prefs::kHeliumRoundedFrame, true);
+    prefs()->SetInteger(arcium::kChromeFrameBorderWidthPref, 12);
+    prefs()->SetBoolean(arcium::kArcSidebarNavigationEnabledPref, false);
+    auto* controller = tabs::VerticalTabStripStateController::From(browser());
+    controller->SetVerticalTabsEnabled(true);
+    controller->SetTabStripRightAligned(false);
+    browser_view()->GetWidget()->Show();
+    browser_view()->SetSize(gfx::Size(1000, 800));
+    Layout();
+  }
+
+  PrefService* prefs() { return browser()->profile()->GetPrefs(); }
+  void Layout() { browser_view()->GetWidget()->LayoutRootViewIfNecessary(); }
+};
+
+TEST_F(ArciumBrowserChromeTest, HiddenToolbarHasEvenUnattachedFrameEdges) {
+  ASSERT_TRUE(browser_view()->ShouldDrawVerticalTabStrip());
+  ASSERT_TRUE(chrome::IsCommandEnabled(browser(), IDC_ARCIUM_TOGGLE_TOOLBAR));
+  chrome::ExecuteCommand(browser(), IDC_ARCIUM_TOGGLE_TOOLBAR);
+  ASSERT_FALSE(browser_view()->IsToolbarVisible());
+  Layout();
+  auto* view = browser_view()->multi_contents_view();
+  const auto bounds = view->GetActiveContentsContainerView()->bounds();
+  EXPECT_EQ(bounds.y(), 12);
+  EXPECT_EQ(view->width() - bounds.right(), 12);
+  EXPECT_EQ(view->height() - bounds.bottom(), 12);
+
+  chrome::ExecuteCommand(browser(), IDC_ARCIUM_TOGGLE_TOOLBAR);
+  Layout();
+  EXPECT_EQ(view->GetActiveContentsContainerView()->bounds().y(), 0);
+}
+
+TEST_F(ArciumBrowserChromeTest, HiddenToolbarHasEvenSplitFrameEdges) {
+  AddTab(browser(), GURL("https://example.org/"));
+  auto* model = browser()->tab_strip_model();
+  ASSERT_EQ(model->count(), 2);
+  model->AddToNewSplit(
+      {1 - model->active_index()}, split_tabs::SplitTabVisualData(),
+      split_tabs::SplitTabCreatedSource::kToolbarButton);
+  prefs()->SetBoolean(arcium::kShowToolbarPref, false);
+  Layout();
+  auto* view = browser_view()->multi_contents_view();
+  const auto insets = view->split_view_insets_for_testing();
+  EXPECT_EQ(insets.top(), 12);
+  EXPECT_EQ(insets.right(), 12);
+  EXPECT_EQ(insets.bottom(), 12);
+  prefs()->SetBoolean(arcium::kShowToolbarPref, true);
+  Layout();
+  EXPECT_EQ(view->split_view_insets_for_testing().top(), 0);
+}
+
+TEST_F(ArciumBrowserChromeTest, HorizontalTabsRetainTopAttachment) {
+  tabs::VerticalTabStripStateController::From(browser())
+      ->SetVerticalTabsEnabled(false);
+  prefs()->SetBoolean(arcium::kShowToolbarPref, false);
+  Layout();
+  ASSERT_FALSE(browser_view()->ShouldDrawVerticalTabStrip());
+  EXPECT_EQ(browser_view()->multi_contents_view()
+                ->GetActiveContentsContainerView()->bounds().y(), 0);
+}
