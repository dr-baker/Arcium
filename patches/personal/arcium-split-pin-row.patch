+                              .second_title = u"Second",
+                              .second_url = GURL("https://second.test/")};
+  state.dematerialize_callback = base::BindRepeating([] { return true; });
+  row->UpdatePresentation(u"First / Second", GURL("https://example.test/"),
+                          state);
+  row->SetBounds(0, 0, 240, row->GetPreferredSize().height());
+  views::test::RunScheduledLayout(row.get());
+  ASSERT_TRUE(row->close_button_for_testing()->GetVisible());
+  ASSERT_TRUE(row->split_segments_visible_for_testing());
+  const gfx::Rect divider = row->split_divider_for_testing();
+  EXPECT_LT(row->second_icon_for_testing()->GetMirroredBounds().right(),
+            divider.x());
+  EXPECT_GT(row->first_title_for_testing()->GetMirroredBounds().x(),
+            divider.right());
+}
