+void PersistentTabView::LoadSecondFavicon() {
+  second_favicon_task_tracker_.TryCancelAll();
+  if (!presentation_state_.split || !presentation_state_.split_pages) {
+    second_favicon_url_ = GURL();
+    second_favicon_model_ = ui::ImageModel();
+    second_favicon_resolved_ = false;
+    return;
+  }
+  const GURL& url = presentation_state_.split_pages->second_url;
+  if (url != second_favicon_url_ || !second_favicon_resolved_) {
+    second_favicon_url_ = url;
+    second_favicon_resolved_ = false;
+    second_favicon_model_ = MakeMonogramFavicon(url, kIconDesignWidth,
+                                                arcium::GetChromeUIScale(this));
+    RefreshIconData();
+  }
+  auto* service = FaviconServiceFactory::GetForProfile(
+      profile_, ServiceAccessType::EXPLICIT_ACCESS);
+  if (!service || !url.is_valid()) {
+    return;
+  }
+  // Reuse the profile's favicon cache, including its host fallback. Never
+  // fetch icons from the network or persist image data on the split record.
+  service->GetRawFaviconForPageURL(
+      url, GetPersistentIconTypes(),
+      GetDesiredFaviconSizeInPixels(this, kIconDesignWidth),
+      /*fallback_to_host=*/true,
+      base::BindOnce(&PersistentTabView::OnSecondFaviconAvailable,
+                     weak_ptr_factory_.GetWeakPtr(), url),
+      &second_favicon_task_tracker_);
+}
+
+void PersistentTabView::OnSecondFaviconAvailable(
+    const GURL& requested_url,
+    const favicon_base::FaviconRawBitmapResult& result) {
+  if (!presentation_state_.split || !presentation_state_.split_pages ||
+      requested_url != presentation_state_.split_pages->second_url ||
+      !result.is_valid() || result.pixel_size.width() <= 0) {
+    return;
+  }
+  const gfx::Image decoded =
+      gfx::Image::CreateFrom1xPNGBytes(result.bitmap_data);
+  if (decoded.IsEmpty()) {
+    return;
+  }
+  const float scale =
+      std::max(1.0f, static_cast<float>(result.pixel_size.width()) /
+                         static_cast<float>(arcium::GetChromeUIScale(this) *
+                                            kIconDesignWidth));
+  gfx::ImageSkia image =
+      gfx::ImageSkia::CreateFromBitmap(decoded.AsBitmap(), scale);
+  image.EnsureRepsForSupportedScales();
+  second_favicon_model_ = ui::ImageModel::FromImageSkia(image);
+  second_favicon_resolved_ = true;
+  RefreshIconData();
 }
 
