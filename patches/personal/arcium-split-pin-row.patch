+TEST_F(PersistentTabViewTest, LateSplitFaviconCannotReplaceAnotherPage) {
+  auto* service = InstallMockFaviconService();
+  EXPECT_CALL(*service,
+              GetRawFaviconForPageURL(testing::_, testing::_, testing::_,
+                                      testing::_, testing::_, testing::_))
+      .WillRepeatedly(testing::Return(base::CancelableTaskTracker::kBadTaskId));
+  std::vector<favicon_base::FaviconRawBitmapCallback> callbacks;
+  const auto capture =
+      [&callbacks](const GURL&, const favicon_base::IconTypeSet&, int, bool,
+                   favicon_base::FaviconRawBitmapCallback callback,
+                   base::CancelableTaskTracker*) {
+        callbacks.push_back(std::move(callback));
+        return base::CancelableTaskTracker::kBadTaskId;
+      };
+  EXPECT_CALL(*service,
+              GetRawFaviconForPageURL(GURL("https://second.test/"), testing::_,
+                                      testing::_, true, testing::_, testing::_))
+      .WillOnce(capture);
+  EXPECT_CALL(*service, GetRawFaviconForPageURL(
+                            GURL("https://replacement.test/"), testing::_,
+                            testing::_, true, testing::_, testing::_))
+      .WillOnce(capture);
+  auto row = MakeView(PersistentTabView::PresentationMode::kFullRow);
+  PersistentTabView::PresentationState state;
+  state.split = true;
+  state.split_pages =
+      helium::SidebarPinSplit{.first_title = u"First",
+                              .second_title = u"Second",
+                              .second_url = GURL("https://second.test/")};
+  row->UpdatePresentation(u"First / Second", GURL("https://example.test/"),
+                          state);
+  state.split_pages->second_url = GURL("https://replacement.test/");
+  state.split_pages->second_title = u"Replacement";
+  row->UpdatePresentation(u"First / Replacement", GURL("https://example.test/"),
+                          state);
+  ASSERT_EQ(2u, callbacks.size());
+  std::move(callbacks[1])
+      .Run(MakeCachedFaviconResult(
+          SK_ColorGREEN, GURL("https://replacement.test/favicon.png"), 32));
+  std::move(callbacks[0])
+      .Run(MakeCachedFaviconResult(
+          SK_ColorRED, GURL("https://second.test/favicon.png"), 32));
+  const auto image = row->second_favicon_for_testing().Rasterize(nullptr);
+  EXPECT_EQ(SK_ColorGREEN,
+            image.GetRepresentation(1.0f).GetBitmap().getColor(0, 0));
+}
