+TEST_F(PersistentTabViewTest, SplitSegmentsKeepBothPagesAndOneAccessibleRow) {
+  auto row = MakeView(PersistentTabView::PresentationMode::kFullRow);
+  PersistentTabView::PresentationState state;
+  state.split = true;
+  state.split_pages = helium::SidebarPinSplit{
+      .first_title = u"Cursor",
+      .second_title = u"Best Way to Build a Very Long Page Title",
+      .second_url = GURL("https://second.test/")};
+  row->UpdatePresentation(u"Cursor / Best Way", GURL("https://example.test/"),
+                          state);
+  for (int width : {96, 160, 240, 400}) {
+    row->SetBounds(0, 0, width, row->GetPreferredSize().height());
+    views::test::RunScheduledLayout(row.get());
+    ASSERT_TRUE(row->split_segments_visible_for_testing());
+    EXPECT_EQ(u"Cursor", row->first_title_for_testing()->GetText());
+    EXPECT_EQ(state.split_pages->second_title,
+              row->second_title_for_testing()->GetText());
+    EXPECT_LE(row->first_title_for_testing()->bounds().right(),
+              row->split_divider_for_testing().x());
+    EXPECT_GT(row->second_icon_for_testing()->x(),
+              row->split_divider_for_testing().right());
+    EXPECT_LE(row->second_title_for_testing()->bounds().right(), width);
+    EXPECT_GE(row->first_title_for_testing()->width(), 0);
+    EXPECT_GE(row->second_title_for_testing()->width(), 0);
+  }
+  ui::AXNodeData node;
+  row->GetViewAccessibility().GetAccessibleNodeData(&node);
+  EXPECT_EQ(u"Cursor / Best Way",
+            node.GetString16Attribute(ax::mojom::StringAttribute::kName));
+  // A narrow icon rail retains the split glyph, rather than overlapping two
+  // full-size icons or exposing labels outside the row.
+  row->SetBounds(0, 0, 48, row->GetPreferredSize().height());
+  views::test::RunScheduledLayout(row.get());
+  EXPECT_FALSE(row->split_segments_visible_for_testing());
+  EXPECT_FALSE(row->second_icon_for_testing()->GetVisible());
+  row->UpdatePresentation(u"Single", GURL("https://example.test/"), {});
+  row->SetBounds(0, 0, 240, row->GetPreferredSize().height());
+  views::test::RunScheduledLayout(row.get());
+  EXPECT_EQ(u"Single", row->first_title_for_testing()->GetText());
+  EXPECT_FALSE(row->second_title_for_testing()->GetVisible());
+}
