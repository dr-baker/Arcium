+TEST_F(PersistentTabViewTest, SplitDividerMirrorsWithLiveCloseButton) {
+  base::i18n::ScopedRTLForTesting scoped_rtl(true);
+  auto row = MakeView(PersistentTabView::PresentationMode::kFullRow);
+  PersistentTabView::PresentationState state;
