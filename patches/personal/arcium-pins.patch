+bool ParseItemKey(std::string_view key,
+                  PersistentRecordKind* kind,
+                  std::string* id) {
+  constexpr std::string_view kFavoritePrefix = "f:";
+  constexpr std::string_view kPinPrefix = "p:";
+  if (key.starts_with(kFavoritePrefix)) {
+    *kind = PersistentRecordKind::kFavorite;
+    *id = std::string(key.substr(kFavoritePrefix.size()));
+    return !id->empty();
+  }
+  if (!key.starts_with(kPinPrefix)) {
+    return false;
+  }
+  const std::string_view rest = key.substr(kPinPrefix.size());
+  const size_t split = rest.find(':');
+  if (split == std::string_view::npos || split + 1 >= rest.size()) {
+    return false;
+  }
+  *kind = PersistentRecordKind::kPin;
+  *id = std::string(rest.substr(split + 1));
+  return true;
+}
