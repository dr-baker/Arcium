+PersistentNodes HeliumSpaceService::GetFavoritesForBrowser(
+    Browser* browser) const {
+  auto* self = const_cast<HeliumSpaceService*>(this);
+  HeliumSpace* space = self->GetSpaceById(GetSpaceIdForBrowser(browser));
+  return space ? GetFavoritesForSpace(*space) : local_favorites_;
