+void CollectLifecycleKeys(std::set<std::string>* keys,
+                          std::string_view prefix,
+                          const PersistentNodes& nodes) {
+  for (const PersistentNode& node : nodes) {
+    if (const auto* link = std::get_if<PersistentLink>(&node.data)) {
+      keys->insert(base::StrCat({prefix, link->id}));
+    } else {
+      CollectLifecycleKeys(keys, prefix,
+                           std::get<PersistentFolder>(node.data).children);
+    }
+  }
