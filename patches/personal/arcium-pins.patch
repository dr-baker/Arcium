+
+bool HeliumSpaceService::IsItemKeyVisibleInBrowser(Browser* browser,
+                                                   std::string_view key) const {
+  if (!IsEligibleBrowser(browser)) {
+    return false;
+  }
+  constexpr std::string_view kFavoritePrefix = "f:";
+  if (key.starts_with(kFavoritePrefix)) {
+    return ResolveItem(browser, PersistentRecordKind::kFavorite,
+                       key.substr(kFavoritePrefix.size()))
+        .has_value();
+  }
+  const std::string pin_prefix =
+      base::StrCat({"p:", GetSpaceIdForBrowser(browser), ":"});
+  return key.starts_with(pin_prefix) &&
+         ResolveItem(browser, PersistentRecordKind::kPin,
+                     key.substr(pin_prefix.size()))
+             .has_value();
+}
