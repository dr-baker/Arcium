+      [](FolderTabContainerView* self, views::View* child) {
+        self->RemoveChildView(child);
+      },
+      base::Unretained(this)));
+
+  node_destroyed_subscription_ = collection_node_->RegisterWillDestroyCallback(
+      base::BindOnce(&FolderTabContainerView::ResetCollectionNode,
+                     base::Unretained(this)));
+  selection_subscription_ =
+      collection_node_->RegisterTabSelectionChangedCallback(base::BindRepeating(
+          &FolderTabContainerView::OnTabSelectionChanged,
+          base::Unretained(this)));
+
+  CHECK(collection_node_->GetController());
+  auto* state_controller =
+      collection_node_->GetController()->GetStateController();
+  CHECK(state_controller);
+  OnCollapseStateChanged(state_controller->GetCollapseState());
+  collapse_state_subscription_ =
+      state_controller->RegisterOnCollapseChanged(base::BindRepeating(
+          &FolderTabContainerView::OnCollapseStateChanged,
+          base::Unretained(this)));
+
+  UpdateChildVisibility();
+}
+
+FolderTabContainerView::~FolderTabContainerView() = default;
+
+void FolderTabContainerView::OnHeaderPressed() {
+  if (!collection_node_) {
+    return;
+  }
+  auto* folder = const_cast<tabs::FolderTabCollection*>(
+      static_cast<const tabs::FolderTabCollection*>(
+          std::get<const tabs::TabCollection*>(
+              collection_node_->GetNodeData())));
+  // Collapse/expand without bouncing activation out of the folder.
+  folder->SetCollapsed(!folder->collapsed());
+  UpdateChildVisibility();
+  InvalidateLayout();
+}
+
+void FolderTabContainerView::OnTabSelectionChanged() {
+  UpdateChildVisibility();
+  InvalidateLayout();
+}
+
+void FolderTabContainerView::OnCollapseStateChanged(
+    tabs::VerticalTabStripCollapseState collapse_state) {
+  compact_ = collapse_state !=
+             tabs::VerticalTabStripCollapseState::kExpanded;
+  UpdateHeaderPresentation();
+  InvalidateLayout();
+  PreferredSizeChanged();
+  SchedulePaint();
+}
+
+void FolderTabContainerView::UpdateHeaderPresentation() {
+  if (!collection_node_ || !header_) {
+    return;
+  }
+  const auto* folder = static_cast<const tabs::FolderTabCollection*>(
+      std::get<const tabs::TabCollection*>(collection_node_->GetNodeData()));
+  header_->SetText(compact_ ? std::u16string() : folder->title());
+  header_->SetTooltipText(folder->title());
+  header_->SetHorizontalAlignment(compact_ ? gfx::ALIGN_CENTER
+                                            : gfx::ALIGN_LEFT);
+  header_->SetImageModel(
+      views::Button::STATE_NORMAL,
+      ui::ImageModel::FromVectorIcon(
+          folder->collapsed() ? vector_icons::kFolderFlippableIcon
+                              : vector_icons::kFolderOpenIcon,
+          ui::kColorIcon, kFolderIconSize));
+  header_->GetViewAccessibility().SetName(folder->title());
+  if (folder->collapsed()) {
+    header_->GetViewAccessibility().SetIsCollapsed();
+  } else {
+    header_->GetViewAccessibility().SetIsExpanded();
+  }
+}
+
+void FolderTabContainerView::UpdateChildVisibility() {
+  if (!collection_node_) {
+    return;
+  }
+  const auto* folder = static_cast<const tabs::FolderTabCollection*>(
+      std::get<const tabs::TabCollection*>(collection_node_->GetNodeData()));
+  const bool collapsed = folder->collapsed();
+  UpdateHeaderPresentation();
+
+  const auto& nodes = collection_node_->children();
+  size_t node_index = 0;
+  for (views::View* child : children()) {
+    if (child == header_) {
+      continue;
+    }
+    if (node_index >= nodes.size()) {
+      child->SetVisible(false);
+      continue;
+    }
+    const TabCollectionNode* node = nodes[node_index++].get();
+    bool visible = !collapsed;
+    if (collapsed) {
+      // Keep the active tab (or the nested folder path to it) exposed while
+      // the folder stays collapsed.
+      visible = NodeContainsActivatedTab(node);
+    }
+    child->SetVisible(visible);
+  }
+}
+
+void FolderTabContainerView::OnPaint(gfx::Canvas* canvas) {
+  views::View::OnPaint(canvas);
+  if (!compact_ || !collection_node_ || !GetColorProvider() || width() < 3) {
+    return;
+  }
+
+  views::View* last_visible_child = nullptr;
+  for (views::View* child : children()) {
+    if (child != header_ && child->GetVisible()) {
+      last_visible_child = child;
+    }
+  }
+  if (!last_visible_child) {
+    return;
+  }
+
+  int depth = 0;
+  for (views::View* ancestor = parent(); ancestor; ancestor = ancestor->parent()) {
+    if (views::AsViewClass<FolderTabContainerView>(ancestor)) {
+      ++depth;
+    }
+  }
+  const int lane = std::clamp(depth, 0, kConnectorMaxLane);
+  const int center_x = header_->bounds().CenterPoint().x();
+  const int line_x = std::clamp(
+      center_x - kConnectorLeadingInset + lane * kConnectorLaneGap, 1,
+      width() - 2);
+  const int start_y = header_->bounds().CenterPoint().y();
+  const int end_y = last_visible_child->bounds().CenterPoint().y();
+  if (end_y <= start_y) {
+    return;
+  }
+
+  cc::PaintFlags flags;
+  flags.setStyle(cc::PaintFlags::kFill_Style);
+  flags.setColor(SkColorSetA(
+      GetColorProvider()->GetColor(ui::kColorSysOnSurfaceSubtle), 128));
+  canvas->DrawRect(gfx::Rect(line_x, start_y, 1, end_y - start_y + 1), flags);
+  for (views::View* child : children()) {
+    if (child == header_ || !child->GetVisible()) {
+      continue;
+    }
+    const int child_y = child->bounds().CenterPoint().y();
+    const int branch_end =
+        std::max(line_x, child->bounds().CenterPoint().x() - kConnectorIconGap);
+    canvas->DrawRect(gfx::Rect(line_x, child_y, branch_end - line_x + 1, 1),
+                     flags);
+  }
+}
+
+void FolderTabContainerView::ResetCollectionNode() {
+  collapse_state_subscription_ = {};
+  collection_node_ = nullptr;
+}
+
+gfx::Size FolderTabContainerView::GetMinimumSize() const {
+  if (!collection_node_) {
+    return gfx::Size();
+  }
+
+  int height = kHeaderHeight;
+  bool has_visible_child = false;
+  for (views::View* child : children()) {
+    if (child == header_ || !child->GetVisible()) {
+      continue;
+    }
+    height += kTabVerticalPadding + child->GetMinimumSize().height();
+    has_visible_child = true;
+  }
+  if (!has_visible_child) {
+    return gfx::Size(0, kHeaderHeight);
+  }
+  return gfx::Size(0, height);
+}
+
+views::ProposedLayout FolderTabContainerView::CalculateProposedLayout(
+    const views::SizeBounds& size_bounds) const {
+  views::ProposedLayout layouts;
+  if (!size_bounds.width().is_bounded()) {
+    return layouts;
+  }
+
+  const int width = size_bounds.width().value();
+  int y = 0;
+
+  gfx::Rect header_bounds(0, y, width, kHeaderHeight);
+  layouts.child_layouts.emplace_back(static_cast<views::View*>(header_),
+                                     header_->GetVisible(), header_bounds);
+  y += kHeaderHeight + kTabVerticalPadding;
+
+  for (views::View* child : children()) {
+    if (child == header_ || !child->GetVisible()) {
+      continue;
+    }
+    const int child_x = compact_ ? 0 : kExpandedChildIndent;
+    views::SizeBounds child_size_bounds(
+        size_bounds.width().is_bounded()
+            ? size_bounds.width() - child_x
+            : size_bounds.width(),
+        {});
+    const int height = child->GetPreferredSize(child_size_bounds).height();
+    layouts.child_layouts.emplace_back(child, true,
+                                       gfx::Rect(child_x, y, width - child_x,
+                                                 height));
+    y += height + kTabVerticalPadding;
+  }
+
+  layouts.host_size = gfx::Size(width, y);
+  return layouts;
+}
+
+BEGIN_METADATA(FolderTabContainerView)
+END_METADATA
