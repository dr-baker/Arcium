+bool HeliumSpaceService::IsEligibleBrowser(Browser* browser) const {
+  return browser && browser->profile() == profile_ &&
+         browser->type() == Browser::TYPE_NORMAL && !profile_->IsOffTheRecord() &&
+         !profile_->IsGuestSession();
+}
+
+std::optional<PersistentLink> HeliumSpaceService::ResolveItem(
+    Browser* browser,
+    PersistentRecordKind kind,
+    std::string_view id) const {
+  if (!IsEligibleBrowser(browser)) {
+    return std::nullopt;
+  }
+  if (kind == PersistentRecordKind::kFavorite) {
+    PersistentNodes favorites = GetFavoritesForBrowser(browser);
+    if (const PersistentLink* link =
+            PersistentItemCodec::FindLink(favorites, id)) {
+      return *link;
+    }
+    return std::nullopt;
+  }
+  auto* self = const_cast<HeliumSpaceService*>(this);
+  HeliumSpace* space = self->GetSpaceById(GetSpaceIdForBrowser(browser));
+  if (!space) {
+    return std::nullopt;
+  }
+  if (const PersistentLink* link =
+          PersistentItemCodec::FindLink(space->pins(), id)) {
+    return *link;
+  }
+  return std::nullopt;
+}
+
+std::optional<PersistentLink> HeliumSpaceService::ResolvePinInSpace(
+    std::string_view space_id,
+    std::string_view id) const {
+  auto* self = const_cast<HeliumSpaceService*>(this);
+  HeliumSpace* space = self->GetSpaceById(space_id);
+  if (!space) {
+    return std::nullopt;
+  }
+  if (const PersistentLink* link =
+          PersistentItemCodec::FindLink(space->pins(), id)) {
+    return *link;
+  }
+  return std::nullopt;
+}
+
+HeliumSpace* HeliumSpaceService::ResolvePinOwner(
+    Browser* browser,
+    std::string_view id) const {
+  if (!IsEligibleBrowser(browser)) {
+    return nullptr;
+  }
+  auto* self = const_cast<HeliumSpaceService*>(this);
+  const std::string current_space_id(GetSpaceIdForBrowser(browser));
+  if (HeliumSpace* current_space = self->GetSpaceById(current_space_id);
+      current_space && ResolvePinInSpace(current_space_id, id)) {
+    return current_space;
+  }
+
+  // Commands are dispatched from the currently visible browser, but the
+  // omnibox also exposes Pins owned by other Spaces. Resolve those commands
+  // by identity when there is exactly one possible owner; duplicate IDs stay
+  // rejected rather than mutating the wrong Space.
+  HeliumSpace* owner = nullptr;
+  for (const auto& space : spaces_) {
+    if (space->id() == current_space_id ||
+        !ResolvePinInSpace(space->id(), id)) {
+      continue;
+    }
+    if (owner) {
+      return nullptr;
+    }
+    owner = space.get();
+  }
+  return owner;
+}
+
+bool HeliumSpaceService::ActivatePersistentItem(Browser* browser,
+                                                PersistentRecordKind kind,
+                                                std::string_view id) {
+  if (!IsEligibleBrowser(browser)) {
+    return false;
+  }
+  std::optional<PersistentLink> item = ResolveItem(browser, kind, id);
+  if (!item) {
+    return false;
+  }
+  const std::string key = ItemKey(browser, kind, id);
+  auto decision = lifecycle_.BeginActivation(key);
+  if (decision.action ==
+      PersistentItemLifecycle::ActivationAction::kActivateExisting) {
+    auto association = live_associations_.find(*decision.live_tab);
+    tabs::TabInterface* live_tab = association == live_associations_.end()
+                                       ? nullptr
+                                       : association->second->tab.get();
+    BrowserWindowInterface* window =
+        live_tab ? live_tab->GetBrowserWindowInterface() : nullptr;
+    Browser* live_browser =
+        window ? window->GetBrowserForMigrationOnly() : nullptr;
+    const int index =
+        live_browser && live_tab
+            ? live_browser->tab_strip_model()->GetIndexOfTab(live_tab)
+            : -1;
+    if (index >= 0) {
+      live_browser->window()->Show();
+      live_browser->tab_strip_model()->ActivateTabAt(index);
+      RecordPersistentItemUsage(key);
+      NotifyItemsChanged();
+      return true;
+    }
+    // Heal a stale association instead of permanently wedging the durable
+    // item in kLive. This path is outside observer teardown callbacks.
+    lifecycle_.BeginClose(*decision.live_tab);
+    live_associations_.erase(*decision.live_tab);
+    lifecycle_.CompleteClose(*decision.live_tab);
+    decision = lifecycle_.BeginActivation(key);
+  }
+  if (decision.action !=
+      PersistentItemLifecycle::ActivationAction::kMaterialize) {
+    return false;
+  }
+
+  content::WebContents* contents =
+      chrome::AddAndReturnTabAt(browser, item->url, -1, true);
+  tabs::TabInterface* tab = tabs::TabInterface::MaybeGetFromContents(contents);
+  if (!tab || !AssociateLiveTab(key, kind, id, tab)) {
+    lifecycle_.CancelMaterialization(key);
+    return false;
+  }
+  RecordPersistentItemUsage(key);
+  NotifyItemsChanged();
+  return true;
+}
