+  PrefService* prefs = profile_->GetPrefs();
+  const base::ListValue& legacy_pins = prefs->GetList(prefs::kHeliumPins);
+  if (legacy_pins.empty()) {
+    return;
+  }
+
+  HeliumSpace* default_space = GetDefaultSpace();
+  ScopedListPrefUpdate update(prefs, kHeliumSpacesPref);
+  for (base::Value& value : update.Get()) {
+    base::DictValue* record = value.GetIfDict();
+    const std::string* id = record ? record->FindString("id") : nullptr;
+    if (!id || *id != default_space->id()) {
