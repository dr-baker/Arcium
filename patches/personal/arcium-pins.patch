+void PinTabContainerView::ResetCollectionNode() {
+  if (TabStripView* tab_strip = GetTabStripView(this)) {
+    tab_strip->CancelPersistentRowReplacement();
+  }
+  pending_replacement_key_.reset();
+  folder_connectors_.clear();
+  collapse_state_subscription_ = {};
+  items_changed_subscription_ = {};
+  collection_node_ = nullptr;
+  space_service_ = nullptr;
