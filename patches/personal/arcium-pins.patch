+
+FolderTabCollection* TabStripCollection::FindOrCreateFolder(
+    TabCollection* parent,
+    const std::u16string& title,
+    bool collapsed) {
+  CHECK(parent);
+  CHECK(parent == pin_collection_ ||
+        parent->type() == TabCollection::Type::FOLDER);
+
+  for (const auto& child : parent->GetChildren()) {
+    if (!std::holds_alternative<std::unique_ptr<TabCollection>>(child)) {
+      continue;
+    }
+    TabCollection* child_collection =
+        std::get<std::unique_ptr<TabCollection>>(child).get();
+    if (child_collection->type() != TabCollection::Type::FOLDER) {
+      continue;
+    }
+    auto* folder = static_cast<FolderTabCollection*>(child_collection);
+    if (folder->title() == title) {
+      folder->SetCollapsed(collapsed);
+      return folder;
+    }
+  }
+
+  auto folder = std::make_unique<FolderTabCollection>(title);
+  folder->SetCollapsed(collapsed);
+  FolderTabCollection* folder_ptr = folder.get();
+  AddTabCollectionImpl(
+      std::move(folder),
+      TabCollection::Position{parent->GetHandle(), parent->ChildCount()});
+  return folder_ptr;
