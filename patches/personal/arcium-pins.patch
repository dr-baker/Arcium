+
+void HeliumSpaceService::RegisterDormantItems() {
+  std::set<std::string> durable_keys;
+  CollectLifecycleKeys(&durable_keys, "f:", local_favorites_);
+  const base::DictValue& imported =
+      profile_->GetPrefs()->GetDict(kHeliumArcFavoritesByProfilePref);
+  for (const auto [profile_name, value] : imported) {
+    static_cast<void>(profile_name);
+    const base::ListValue* values = value.GetIfList();
+    if (values) {
+      if (auto favorites = PersistentItemCodec::Decode(*values, false)) {
+        CollectLifecycleKeys(&durable_keys, "f:", *favorites);
+      }
+    }
+  }
+  for (const auto& space : spaces_) {
+    CollectLifecycleKeys(&durable_keys, base::StrCat({"p:", space->id(), ":"}),
+                         space->pins());
+  }
+  std::erase_if(live_associations_, [&durable_keys](const auto& association) {
+    return !durable_keys.contains(association.second->key);
+  });
+  lifecycle_.RetainOnly(durable_keys);
+  for (const std::string& key : durable_keys) {
+    lifecycle_.AddDormant(key);
+  }
+  PrunePersistentItemUsage(durable_keys);
+}
+
+void HeliumSpaceService::AddPersistentItemToSessionExtraData(
+    const tabs::TabInterface* tab,
+    std::map<std::string, std::string>* extra_data) const {
+  if (!tab || !extra_data) {
+    return;
+  }
+  for (const auto& [token, association] : live_associations_) {
+    if (association->tab == tab) {
+      extra_data->insert_or_assign(kHeliumPersistentItemTabExtraDataKey,
+                                   association->key);
+      return;
+    }
+  }
+}
+
+bool HeliumSpaceService::RestorePersistentItemFromSession(
+    tabs::TabInterface* tab,
+    const std::map<std::string, std::string>& extra_data) {
+  const auto found = extra_data.find(kHeliumPersistentItemTabExtraDataKey);
+  BrowserWindowInterface* window =
+      tab ? tab->GetBrowserWindowInterface() : nullptr;
+  Browser* browser = window ? window->GetBrowserForMigrationOnly() : nullptr;
+  if (!tab || found == extra_data.end() ||
+      !IsItemKeyVisibleInBrowser(browser, found->second) ||
+      !lifecycle_.GetState(found->second)) {
+    return false;
+  }
+  if (lifecycle_.GetState(found->second) !=
+      PersistentItemLifecycle::State::kDormant) {
+    return false;
+  }
+  PersistentRecordKind kind;
+  std::string id;
+  if (!ParseItemKey(found->second, &kind, &id) ||
+      !AssociateLiveTab(found->second, kind, id, tab)) {
+    return false;
+  }
+  NotifyItemsChanged();
+  return true;
+}
+
+bool HeliumSpaceService::RestoreLegacyFavoriteFromSession(
+    tabs::TabInterface* tab) {
+  BrowserWindowInterface* window =
+      tab ? tab->GetBrowserWindowInterface() : nullptr;
+  Browser* browser = window ? window->GetBrowserForMigrationOnly() : nullptr;
+  if (!browser || IsPersistentItemTab(tab)) {
+    return false;
+  }
+  const GURL restored_url = tab->GetContents()->GetLastCommittedURL();
+  std::optional<PersistentLink> match;
+  const PersistentNodes favorites = GetFavoritesForBrowser(browser);
+  for (const PersistentNode& node : favorites) {
+    const auto* link = std::get_if<PersistentLink>(&node.data);
+    if (!link || link->url != restored_url) {
+      continue;
+    }
+    if (match) {
+      return false;
+    }
+    match = *link;
+  }
+  if (!match) {
+    return false;
+  }
+  const std::string key =
+      ItemKey(browser, PersistentRecordKind::kFavorite, match->id);
+  if (lifecycle_.GetState(key) != PersistentItemLifecycle::State::kDormant ||
+      !AssociateLiveTab(key, PersistentRecordKind::kFavorite, match->id, tab)) {
+    return false;
+  }
+  NotifyItemsChanged();
+  return true;
 }
 
