+    return;
+  }
+
+  anchored_pinned_tab_home_url_ = std::move(url);
+  anchored_pinned_tab_home_title_ = std::move(title);
+  tab_ui_change_callbacks_.Notify();
+}
+
+void TabUIHelper::ClearAnchoredPinnedTabHome() {
+  if (!HasAnchoredPinnedTabHome() && anchored_pinned_tab_home_title_.empty()) {
+    return;
+  }
+
+  anchored_pinned_tab_home_url_ = GURL();
+  anchored_pinned_tab_home_title_.clear();
+  tab_ui_change_callbacks_.Notify();
+}
 void TabUIHelper::TitleWasSet(content::NavigationEntry* entry) {
   tab_ui_change_callbacks_.Notify();
 }
