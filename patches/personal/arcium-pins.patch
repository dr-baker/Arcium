+class PinTabContainerViewTargeter : public views::ViewTargeterDelegate {
+ public:
+  explicit PinTabContainerViewTargeter(views::View* view) : view_(view) {}
+  ~PinTabContainerViewTargeter() override = default;
+
+  bool DoesIntersectRect(const views::View* target,
+                         const gfx::Rect& rect) const override {
+    gfx::Rect content_bounds;
+    for (const views::View* child : view_->children()) {
+      if (child->GetVisible()) {
+        content_bounds.Union(child->GetMirroredBounds());
+      }
+    }
+    return content_bounds.Intersects(rect);
+  }
+
+ private:
+  raw_ptr<views::View> view_;
+};
