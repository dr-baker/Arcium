+StartupTabs HeliumSpace::ReadPins() const {
+  const base::ListValue& records =
+      profile_->GetPrefs()->GetList(kHeliumSpacesPref);
+  for (const base::Value& value : records) {
+    const base::DictValue* record = value.GetIfDict();
+    const std::string* record_id = record ? record->FindString(kIdKey) : nullptr;
+    if (record_id && *record_id == id_) {
+      const base::ListValue* pins = record->FindList(kPinsKey);
+      return pins ? PinTabCodec::DecodePins(*pins) : StartupTabs();
+    }
+  }
+  return {};
