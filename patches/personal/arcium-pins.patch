+void HeliumSpaceService::ReconcileImportedPersistentItems(
+    std::string source_profile,
+    PersistentNodes favorites,
+    std::vector<ImportedPersistentSpace> imported_spaces) {
+  if (source_profile.empty()) {
+    return;
+  }
+
+  // Replace the untouched initial placeholder instead of leaving an empty
+  // extra Space beside the imported collection.
+  if (spaces_.size() == 1u && spaces_.front()->name() == u"Space" &&
+      spaces_.front()->pins().empty() &&
+      spaces_.front()->source_profile().empty()) {
+    spaces_.clear();
+    profile_->GetPrefs()->SetList(kHeliumSpacesPref, base::ListValue());
+    profile_->GetPrefs()->SetString(kHeliumActiveSpaceIdPref, std::string());
+  }
+
+  std::set<std::string> imported_ids;
+  for (const ImportedPersistentSpace& space : imported_spaces) {
+    imported_ids.insert(space.id);
+  }
+
+  base::ListValue reconciled;
+  for (const base::Value& value :
+       profile_->GetPrefs()->GetList(kHeliumSpacesPref)) {
+    const base::DictValue* record = value.GetIfDict();
+    const std::string* id = record ? record->FindString("id") : nullptr;
+    const std::string* source =
+        record ? record->FindString("source_profile") : nullptr;
+    if ((source && *source == source_profile) ||
+        (id && imported_ids.contains(*id))) {
+      continue;
+    }
+    reconciled.Append(value.Clone());
+  }
+  for (ImportedPersistentSpace& imported : imported_spaces) {
+    base::DictValue record;
+    record.Set("id", imported.id);
+    record.Set("name", base::UTF16ToUTF8(imported.name));
+    record.Set("source_profile", source_profile);
+    record.Set("pins", PersistentItemCodec::Encode(imported.pins));
+    reconciled.Append(std::move(record));
+  }
+  profile_->GetPrefs()->SetList(kHeliumSpacesPref, std::move(reconciled));
+
+  ScopedDictPrefUpdate favorites_update(profile_->GetPrefs(),
+                                        kHeliumArcFavoritesByProfilePref);
+  favorites_update->Set(source_profile,
+                        PersistentItemCodec::Encode(favorites));
+
+  const std::string previous_active_id =
+      profile_->GetPrefs()->GetString(kHeliumActiveSpaceIdPref);
+  spaces_.clear();
+  LoadSpaces();
+  EnsureDefaultSpace();
+  if (!GetSpaceById(previous_active_id)) {
+    SetActiveSpace(spaces_.front()->id());
+  }
+  const std::string replacement_space = GetActiveSpace()->id();
+  for (auto& [window_id, space_id] : session_space_ids_) {
+    if (GetSpaceById(space_id)) {
+      continue;
+    }
+    space_id = replacement_space;
+    if (SessionService* sessions =
+            SessionServiceFactory::GetForProfile(profile_)) {
+      sessions->AddWindowExtraData(window_id, kHeliumSpaceIdWindowExtraDataKey,
+                                   replacement_space);
+    }
+  }
+  RegisterDormantItems();
+  NotifyItemsChanged();
+}
