+    // not discarded by decoding and re-encoding during migration.
+    if (!record->Find("pins")) {
+      record->Set("pins", legacy_pins.Clone());
+      prefs->SetList(prefs::kHeliumPins, base::ListValue());
+    }
+    return;
+  }
