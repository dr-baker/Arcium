+
+PersistentNodes ConvertLegacyNodes(const base::ListValue& values,
+                                   std::string_view source_profile,
+                                   std::string_view space_id) {
+  PersistentNodes result;
+  for (const base::Value& value : values) {
+    const base::DictValue* dict = value.GetIfDict();
+    const std::string* type = dict ? dict->FindString("type") : nullptr;
+    if (!dict || !type) {
+      continue;
+    }
+    const std::string* source_id = dict->FindString("source_id");
+    std::string id = source_id && !source_id->empty()
+                         ? ImportedId(source_profile, space_id, *source_id)
+                         : NewId();
+    const std::string* title = dict->FindString("title");
+    if (*type == "tab" || *type == "link") {
+      const std::string* url_string = dict->FindString("url");
+      GURL url(url_string ? *url_string : std::string());
+      if (!url.is_valid() || url.is_empty() || url.spec() == "about:blank") {
+        continue;
+      }
+      result.push_back(PersistentNode{
+          .data = PersistentLink{
+              .id = std::move(id),
+              .title = base::UTF8ToUTF16(title ? *title : std::string()),
+              .url = std::move(url)}});
+      continue;
+    }
+    const base::ListValue* children = dict->FindList("children");
+    if (*type == "folder" && children) {
+      result.push_back(PersistentNode{
+          .data = PersistentFolder{
+              .id = std::move(id),
+              .title = base::UTF8ToUTF16(title ? *title : std::string()),
+              .collapsed = dict->FindBool("collapsed").value_or(false),
+              .children =
+                  ConvertLegacyNodes(*children, source_profile, space_id)}});
+    }
+  }
+  return result;
+}
