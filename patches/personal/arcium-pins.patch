+PersistentNodes HeliumSpaceService::GetFavoritesForSpace(
+    const HeliumSpace& space) const {
+  PersistentNodes result = local_favorites_;
+  if (space.source_profile().empty()) {
+    return result;
+  }
+  const base::ListValue* values =
+      profile_->GetPrefs()
+          ->GetDict(kHeliumArcFavoritesByProfilePref)
+          .FindList(space.source_profile());
+  if (values) {
+    if (auto imported = PersistentItemCodec::Decode(*values, false)) {
+      result.insert(result.end(), imported->begin(), imported->end());
+    }
+  }
+  return result;
+}
