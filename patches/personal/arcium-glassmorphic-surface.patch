--- src.orig/chrome/browser/ui/views/helium/glass_surface.cc
+++ src/chrome/browser/ui/views/helium/glass_surface.cc
@@ -1 +1,232 @@
-// placeholder
+// Copyright 2026 The Helium Authors
+// You can use, redistribute, and/or modify this source code under
+// the terms of the GPL-3.0 license found in the LICENSE file.
+
+#include "chrome/browser/ui/views/helium/glass_surface.h"
+
+#include <algorithm>
+#include <cmath>
+#include <cstdint>
+
+#include "base/notreached.h"
+#include "cc/paint/paint_flags.h"
+#include "third_party/skia/include/core/SkCanvas.h"
+#include "third_party/skia/include/core/SkRRect.h"
+#include "ui/base/metadata/metadata_impl_macros.h"
+#include "ui/compositor/layer.h"
+#include "ui/gfx/canvas.h"
+#include "ui/gfx/geometry/skia_conversions.h"
+
+namespace helium {
+
+namespace {
+
+struct MaterialTuning {
+  float blur_sigma;
+  int fill_alpha;
+  int rim_alpha;
+  int highlight_alpha;
+  int grain_alpha;
+  int grain_dots;
+};
+
+constexpr MaterialTuning kBasicTuning = {
+    .blur_sigma = 18.0f,
+    .fill_alpha = 184,
+    .rim_alpha = 48,
+    .highlight_alpha = 22,
+    .grain_alpha = 4,
+    .grain_dots = 36,
+};
+
+constexpr MaterialTuning kGlassmorphicTuning = {
+    .blur_sigma = 30.0f,
+    .fill_alpha = 156,
+    .rim_alpha = 72,
+    .highlight_alpha = 40,
+    .grain_alpha = 7,
+    .grain_dots = 64,
+};
+
+constexpr float kBackdropFilterQuality = 1.0f;
+
+const MaterialTuning& GetMaterialTuning(GlassSurfacePreset preset) {
+  switch (preset) {
+    case GlassSurfacePreset::kBasic:
+      return kBasicTuning;
+    case GlassSurfacePreset::kGlassmorphic:
+      return kGlassmorphicTuning;
+  }
+  NOTREACHED();
+}
+
+float ClampUnit(float value) {
+  return std::clamp(value, 0.0f, 1.0f);
+}
+
+uint8_t MixChannel(uint8_t tint_channel, float strength, int base) {
+  const float channel = static_cast<float>(base) +
+                        (static_cast<float>(tint_channel) - base) * strength;
+  return static_cast<uint8_t>(std::clamp(std::lround(channel), 0l, 255l));
+}
+
+SkColor MixTint(SkColor tint, float strength) {
+  // Keep the panel dark enough for the existing MRU foreground while allowing
+  // a caller-supplied tint to move the material toward its theme color.
+  return SkColorSetRGB(
+      MixChannel(SkColorGetR(tint), strength, 28),
+      MixChannel(SkColorGetG(tint), strength, 31),
+      MixChannel(SkColorGetB(tint), strength, 38));
+}
+
+SkRRect MakeRRect(const gfx::Rect& bounds,
+                  const gfx::RoundedCornersF& corner_radii) {
+  const SkVector radii[4] = {
+      {corner_radii.upper_left(), corner_radii.upper_left()},
+      {corner_radii.upper_right(), corner_radii.upper_right()},
+      {corner_radii.lower_right(), corner_radii.lower_right()},
+      {corner_radii.lower_left(), corner_radii.lower_left()},
+  };
+  return SkRRect::MakeRectRadii(gfx::RectToSkRect(bounds), radii);
+}
+
+void SetPaintStyle(cc::PaintFlags* flags, SkColor color) {
+  flags->setAntiAlias(true);
+  flags->setColor(color);
+}
+
+}  // namespace
+
+GlassSurfaceView::GlassSurfaceView(const GlassSurfaceParams& params)
+    : preset_(params.preset),
+      tint_color_(params.tint_color),
+      tint_strength_(ClampUnit(params.tint_strength)),
+      opacity_(ClampUnit(params.opacity)),
+      corner_radii_(params.corner_radii) {
+  SetCanProcessEventsWithinSubtree(false);
+  SetPaintToLayer();
+  UpdateLayer();
+}
+
+GlassSurfaceView::~GlassSurfaceView() = default;
+
+void GlassSurfaceView::SetPreset(GlassSurfacePreset preset) {
+  if (preset_ == preset) {
+    return;
+  }
+  preset_ = preset;
+  UpdateLayer();
+}
+
+void GlassSurfaceView::SetTintColor(SkColor tint_color) {
+  if (tint_color_ == tint_color) {
+    return;
+  }
+  tint_color_ = tint_color;
+  SchedulePaint();
+}
+
+void GlassSurfaceView::SetTintStrength(float tint_strength) {
+  tint_strength = ClampUnit(tint_strength);
+  if (tint_strength_ == tint_strength) {
+    return;
+  }
+  tint_strength_ = tint_strength;
+  SchedulePaint();
+}
+
+void GlassSurfaceView::SetOpacity(float opacity) {
+  opacity = ClampUnit(opacity);
+  if (opacity_ == opacity) {
+    return;
+  }
+  opacity_ = opacity;
+  UpdateLayer();
+}
+
+void GlassSurfaceView::SetCornerRadii(
+    const gfx::RoundedCornersF& corner_radii) {
+  if (corner_radii_ == corner_radii) {
+    return;
+  }
+  corner_radii_ = corner_radii;
+  UpdateLayer();
+}
+
+void GlassSurfaceView::UpdateLayer() {
+  if (!layer()) {
+    return;
+  }
+
+  const MaterialTuning& tuning = GetMaterialTuning(preset_);
+  layer()->SetFillsBoundsOpaquely(false);
+  // Layer opacity blends the filtered backdrop and the surface treatment as a
+  // unit. At zero, remove the backdrop filter as well so this view is truly a
+  // no-op rather than a transparent layer that still changes the backdrop.
+  layer()->SetOpacity(opacity_);
+  layer()->SetBackgroundBlur(opacity_ > 0.0f ? tuning.blur_sigma : 0.0f);
+  layer()->SetBackdropFilterQuality(kBackdropFilterQuality);
+  layer()->SetRoundedCornerRadius(corner_radii_);
+  layer()->SetIsFastRoundedCorner(!corner_radii_.IsEmpty());
+  SchedulePaint();
+}
+
+void GlassSurfaceView::OnPaint(gfx::Canvas* canvas) {
+  if (opacity_ <= 0.0f || GetLocalBounds().IsEmpty()) {
+    return;
+  }
+
+  const MaterialTuning& tuning = GetMaterialTuning(preset_);
+  const gfx::Rect bounds = GetLocalBounds();
+  const SkRRect rrect = MakeRRect(bounds, corner_radii_);
+  cc::PaintCanvas* paint_canvas = canvas->sk_canvas();
+
+  cc::PaintFlags fill;
+  SetPaintStyle(
+      &fill,
+      SkColorSetA(MixTint(tint_color_, tint_strength_), tuning.fill_alpha));
+  paint_canvas->drawRRect(rrect, fill);
+
+  // A broad, clipped highlight gives the panel the soft milky edge seen in
+  // the OverShifted reference without pretending that it refracts live page
+  // pixels at the Views layer.
+  paint_canvas->save();
+  paint_canvas->clipRRect(rrect, SkClipOp::kIntersect, true);
+  cc::PaintFlags highlight;
+  SetPaintStyle(&highlight,
+                SkColorSetA(SK_ColorWHITE, tuning.highlight_alpha));
+  const SkRect sk_bounds = gfx::RectToSkRect(bounds);
+  paint_canvas->drawOval(
+      SkRect::MakeLTRB(sk_bounds.left() - sk_bounds.width() * 0.35f,
+                       sk_bounds.top() - sk_bounds.height() * 0.55f,
+                       sk_bounds.left() + sk_bounds.width() * 0.82f,
+                       sk_bounds.top() + sk_bounds.height() * 0.80f),
+      highlight);
+  paint_canvas->restore();
+
+  cc::PaintFlags rim;
+  SetPaintStyle(&rim, SkColorSetA(SK_ColorWHITE, tuning.rim_alpha));
+  rim.setStyle(cc::PaintFlags::kStroke_Style);
+  rim.setStrokeWidth(1.0f);
+  paint_canvas->drawRRect(rrect, rim);
+
+  cc::PaintFlags grain;
+  SetPaintStyle(&grain, SkColorSetA(SK_ColorWHITE, tuning.grain_alpha));
+  const float width = sk_bounds.width();
+  const float height = sk_bounds.height();
+  for (int index = 0; index < tuning.grain_dots; ++index) {
+    const float x = std::fmod(0.13f + index * 0.75487766f, 1.0f);
+    const float y = std::fmod(0.37f + index * 0.5698403f, 1.0f);
+    const float center_x = sk_bounds.left() + x * width;
+    const float center_y = sk_bounds.top() + y * height;
+    paint_canvas->drawOval(
+        SkRect::MakeLTRB(center_x - 0.55f, center_y - 0.55f,
+                         center_x + 0.55f, center_y + 0.55f),
+        grain);
+  }
+}
+
+BEGIN_METADATA(GlassSurfaceView)
+END_METADATA
+
+}  // namespace helium
