-// placeholder
+// Copyright 2026 The Helium Authors
+// You can use, redistribute, and/or modify this source code under
+// the terms of the GPL-3.0 license found in the LICENSE file.
+
+#ifndef CHROME_BROWSER_UI_VIEWS_HELIUM_GLASS_SURFACE_H_
+#define CHROME_BROWSER_UI_VIEWS_HELIUM_GLASS_SURFACE_H_
+
+#include "third_party/skia/include/core/SkColor.h"
+#include "ui/gfx/geometry/rounded_corners_f.h"
+#include "ui/views/view.h"
+
+namespace helium {
+
+// Fixed, reviewed materials for browser chrome. The shader lab exposes more
+// knobs, but product code intentionally selects a material rather than
+// tuning its implementation details per component.
+enum class GlassSurfacePreset {
+  kBasic,
+  kGlassmorphic,
+};
+
+struct GlassSurfaceParams {
+  GlassSurfacePreset preset = GlassSurfacePreset::kBasic;
+  SkColor tint_color = SK_ColorWHITE;
+  float tint_strength = 0.0f;
+  float opacity = 1.0f;
+  gfx::RoundedCornersF corner_radii = gfx::RoundedCornersF();
+};
+
+// A reusable Views surface backed by Arcium's live-backdrop refraction shader.
+class GlassSurfaceView : public views::View {
+  METADATA_HEADER(GlassSurfaceView, views::View)
+
+ public:
+  explicit GlassSurfaceView(const GlassSurfaceParams& params);
+  GlassSurfaceView(const GlassSurfaceView&) = delete;
+  GlassSurfaceView& operator=(const GlassSurfaceView&) = delete;
+  ~GlassSurfaceView() override;
+
+  void SetPreset(GlassSurfacePreset preset);
+  void SetTintColor(SkColor tint_color);
+  void SetTintStrength(float tint_strength);
+  void SetOpacity(float opacity);
+  void SetCornerRadii(const gfx::RoundedCornersF& corner_radii);
+
+  GlassSurfacePreset preset() const { return preset_; }
+  SkColor tint_color() const { return tint_color_; }
+  float tint_strength() const { return tint_strength_; }
+  float opacity() const { return opacity_; }
+  const gfx::RoundedCornersF& corner_radii() const { return corner_radii_; }
+
+ private:
+  void UpdateLayer();
+  void OnBoundsChanged(const gfx::Rect& previous_bounds) override;
+
+  GlassSurfacePreset preset_;
+  SkColor tint_color_;
+  float tint_strength_;
+  float opacity_;
+  gfx::RoundedCornersF corner_radii_;
+};
+
+}  // namespace helium
+
+#endif  // CHROME_BROWSER_UI_VIEWS_HELIUM_GLASS_SURFACE_H_
