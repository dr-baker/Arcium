+void PaintOpReader::ReadGlassmorphicPaintFilter(
+    sk_sp<PaintFilter>* filter,
+    const std::optional<PaintFilter::CropRect>& crop_rect) {
+  GlassmorphicFilterParams params;
+  SkScalar max_sample_radius = 0;
+  ReadSimple(&params);
+  ReadSimple(&max_sample_radius);
+  if (!valid_ || !SkIsFinite(max_sample_radius) || max_sample_radius < 0 ||
+      max_sample_radius > 128) {
+    SetInvalid(DeserializationError::kInvalidPaintShader);
+    return;
   }
+  filter->reset(new GlassmorphicPaintFilter(
+      params, max_sample_radius, base::OptionalToPtr(crop_rect)));
 }
 
