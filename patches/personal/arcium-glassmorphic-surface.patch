+// The reviewed parameter block for Arcium's built-in glass material. The SkSL
+// source is fixed in cc/paint; only these bounded numeric values cross IPC.
+struct CC_PAINT_EXPORT GlassmorphicFilterParams {
+  SkSize resolution = {0, 0};
+  SkPoint panel_origin = {0, 0};
+  SkSize panel_size = {0, 0};
+  SkScalar corner_radius = 0;
+  SkScalar shape_power = 0;
+  SkScalar blur_radius = 10;
+  SkScalar opacity = 1;
+  SkScalar edge_width = 30;
+  SkScalar refraction = 7;
+  SkScalar bulge = 0;
+  SkScalar dispersion = 0.15f;
+  SkScalar tint_strength = 0.17f;
+  SkScalar saturation = 1.1f;
+  SkScalar specular = 0.42f;
+  SkScalar grain = 0.012f;
+  SkColor4f tint = {0.5f, 0.69f, 1.f, 1.f};
+  SkPoint light_xy = {-0.65f, -0.75f};
+  SkScalar light_elevation = 0.85f;
+  SkScalar light_intensity = 1.f;
+
+  bool operator==(const GlassmorphicFilterParams&) const = default;
+};
+
+class CC_PAINT_EXPORT GlassmorphicPaintFilter final : public PaintFilter {
+ public:
+  static constexpr Type kType = Type::kGlassmorphic;
+  GlassmorphicPaintFilter(const GlassmorphicFilterParams& params,
+                          SkScalar max_sample_radius,
+                          const CropRect* crop_rect = nullptr);
+  ~GlassmorphicPaintFilter() override;
+
+  const GlassmorphicFilterParams& params() const { return params_; }
+  SkScalar max_sample_radius() const { return max_sample_radius_; }
+  size_t SerializedSize() const override;
+  bool EqualsForTesting(const GlassmorphicPaintFilter& other) const;
+  gfx::ContentColorUsage GetContentColorUsage() const override;
+
+ protected:
+  sk_sp<PaintFilter> SnapshotWithImagesInternal(
+      ImageProvider* image_provider) const override;
+
+ private:
+  GlassmorphicFilterParams params_;
+  SkScalar max_sample_radius_;
+};
