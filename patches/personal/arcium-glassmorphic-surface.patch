 }
 
+GlassmorphicPaintFilter::GlassmorphicPaintFilter(
+    const GlassmorphicFilterParams& params,
+    SkScalar max_sample_radius,
+    const CropRect* crop_rect)
+    : PaintFilter(kType, crop_rect, kHasNoDiscardableImages),
+      params_(params),
+      max_sample_radius_(max_sample_radius) {
+  cached_sk_filter_ = MakeGlassmorphicImageFilter(*this, SkMatrix::I());
+}
+
+sk_sp<SkImageFilter> MakeGlassmorphicImageFilter(
+    const GlassmorphicPaintFilter& paint_filter,
+    const SkMatrix& local_matrix) {
+  if (!local_matrix.isScaleTranslate() || !local_matrix.isFinite() ||
+      local_matrix.getScaleX() == 0 || local_matrix.getScaleY() == 0) {
+    return nullptr;
+  }
+  static const base::NoDestructor<SkRuntimeEffect::Result> result(
+      SkRuntimeEffect::MakeForShader(SkString(kGlassmorphicSkSL)));
+  if (!result->effect) {
+    LOG(ERROR) << "Glassmorphic shader compilation failed: "
+               << result->errorText.c_str();
+    return nullptr;
+  }
+  SkRuntimeShaderBuilder builder(result->effect);
+  const float transform[] = {local_matrix.getScaleX(), local_matrix.getScaleY(),
+                             local_matrix.getTranslateX(),
+                             local_matrix.getTranslateY()};
+  builder.uniform("uLocalTransform").set(transform, 4);
+  const auto& params = paint_filter.params();
+  builder.uniform("uResolution") = params.resolution;
+  builder.uniform("uPanelOrigin") = params.panel_origin;
+  builder.uniform("uPanelSize") = params.panel_size;
+  builder.uniform("uCornerRadius") = params.corner_radius;
+  builder.uniform("uShapePower") = params.shape_power;
+  builder.uniform("uOpacity") = params.opacity;
+  builder.uniform("uEdgeWidth") = params.edge_width;
+  builder.uniform("uRefraction") = params.refraction;
+  builder.uniform("uBulge") = params.bulge;
+  builder.uniform("uDispersion") = params.dispersion;
+  builder.uniform("uTintStrength") = params.tint_strength;
+  builder.uniform("uSaturation") = params.saturation;
+  builder.uniform("uSpecular") = params.specular;
+  builder.uniform("uGrain") = params.grain;
+  builder.uniform("uTint") = params.tint;
+  builder.uniform("uLightXY") = params.light_xy;
+  builder.uniform("uLightElevation") = params.light_elevation;
+  builder.uniform("uLightIntensity") = params.light_intensity;
+  const float sample_scale =
+      std::max(SkScalarAbs(local_matrix.getScaleX()),
+               SkScalarAbs(local_matrix.getScaleY()));
+  // Match the variance of the lab's nine-tap kernel without its separated
+  // copies of sharp edges. Keep the raw backdrop for clear refraction and
+  // dispersion, and let Skia evaluate a continuous Gaussian for the soft part.
+  // Both children belong to this filter, preserving the glass-specific matrix
+  // handling in Viz instead of wrapping it in a generic composed filter.
+  const float sigma = std::max(0.0f, params.blur_radius) * std::sqrt(0.6f);
+  std::string_view child_names[] = {"backdrop", "softenedBackdrop"};
+  const sk_sp<SkImageFilter> inputs[] = {
+      nullptr,
+      SkImageFilters::Blur(sigma * SkScalarAbs(local_matrix.getScaleX()),
+                          sigma * SkScalarAbs(local_matrix.getScaleY()),
+                          SkTileMode::kClamp, nullptr)};
+  auto filter = SkImageFilters::RuntimeShader(
+      builder, paint_filter.max_sample_radius() * sample_scale, child_names,
+      inputs, 2);
+  if (const auto* crop_rect = paint_filter.GetCropRect(); crop_rect && filter) {
+    filter = SkImageFilters::Crop(local_matrix.mapRect(*crop_rect),
+                                  SkTileMode::kDecal, std::move(filter));
+  }
+  return filter;
+}
+
+GlassmorphicPaintFilter::~GlassmorphicPaintFilter() = default;
+
+size_t GlassmorphicPaintFilter::SerializedSize() const {
+  base::CheckedNumeric<size_t> total_size = BaseSerializedSize();
+  total_size += PaintOpWriter::SerializedSize(params_);
+  total_size += PaintOpWriter::SerializedSize(max_sample_radius_);
+  return total_size.ValueOrDefault(0u);
+}
+
+bool GlassmorphicPaintFilter::EqualsForTesting(
+    const GlassmorphicPaintFilter& other) const {
+  return params_ == other.params_ &&
+         max_sample_radius_ == other.max_sample_radius_;
+}
+
+gfx::ContentColorUsage GlassmorphicPaintFilter::GetContentColorUsage() const {
+  return gfx::ContentColorUsage::kSRGB;
+}
+
+sk_sp<PaintFilter> GlassmorphicPaintFilter::SnapshotWithImagesInternal(
+    ImageProvider* image_provider) const {
+  return sk_ref_sp<PaintFilter>(this);
+}
+
