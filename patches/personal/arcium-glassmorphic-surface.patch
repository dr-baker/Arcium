+    auto surface = SkSurfaces::Raster(SkImageInfo::MakeN32Premul(128, 128));
+    ASSERT_TRUE(surface);
+    constexpr SkColor background = SkColorSetRGB(70, 90, 120);
+    auto* canvas = surface->getCanvas();
+    canvas->clear(background);
+    canvas->save();
+    canvas->translate(24, 24);
+    const SkRect bounds = matrix.mapRect(crop);
+    canvas->clipRect(bounds);
+    canvas->saveLayer(SkCanvas::SaveLayerRec(
+        &bounds, nullptr, scaled_filter.get(), 0));
+    canvas->restore();
+    canvas->restore();
+    SkPixmap pixels;
+    ASSERT_TRUE(surface->peekPixels(&pixels));
+    const int center = 24 + static_cast<int>(16 * scale);
+    EXPECT_NE(background, pixels.getColor(center, center)) << scale;
+    EXPECT_EQ(background, pixels.getColor(0, 0)) << scale;
+  }
+  EXPECT_FALSE(MakeGlassmorphicImageFilter(filter, SkMatrix::Scale(0, 2)));
+  EXPECT_FALSE(MakeGlassmorphicImageFilter(filter, SkMatrix::RotateDeg(30)));
+}
+
+TEST(PaintFilterTest, GlassmorphicBlurDoesNotDuplicateSharpLines) {
+  GlassmorphicFilterParams params;
+  params.resolution = params.panel_size = SkSize::Make(96, 96);
+  params.blur_radius = 10;
+  params.refraction = 0;
+  params.bulge = 0;
+  params.tint_strength = 0;
+  params.saturation = 1;
+  params.specular = 0;
+  params.grain = 0;
+  const SkRect crop = SkRect::MakeWH(96, 96);
+  GlassmorphicPaintFilter filter(params, 20, &crop);
+  for (float scale : {1.f, 1.5f, 2.f}) {
+    auto mapped = MakeGlassmorphicImageFilter(
+        filter, SkMatrix::Scale(scale, scale));
+    ASSERT_TRUE(mapped);
+    auto surface = SkSurfaces::Raster(SkImageInfo::MakeN32Premul(256, 256));
+    ASSERT_TRUE(surface);
+    auto* canvas = surface->getCanvas();
+    canvas->clear(SK_ColorBLACK);
+    const int center = 24 + static_cast<int>(48 * scale);
+    SkPaint line;
+    line.setColor(SK_ColorWHITE);
+    canvas->drawRect(SkRect::MakeXYWH(center, 0, 1, 256), line);
+    canvas->save();
+    canvas->translate(24, 24);
+    const SkRect bounds = SkRect::MakeWH(96 * scale, 96 * scale);
+    canvas->clipRect(bounds);
+    canvas->saveLayer(SkCanvas::SaveLayerRec(
+        &bounds, nullptr, mapped.get(), 0));
+    canvas->restore();
+    canvas->restore();
+    SkPixmap pixels;
+    ASSERT_TRUE(surface->peekPixels(&pixels));
+    // A single line must soften continuously, without bright satellite lines
+    // at the old sparse-kernel offsets of +/- blur_radius.
+    for (int direction : {-1, 1}) {
+      int previous = 255;
+      for (int distance = 0; distance <= 24 * scale; ++distance) {
+        const int value = SkColorGetR(
+            pixels.getColor(center + direction * distance, center));
+        EXPECT_LE(value, previous) << scale << ": " << distance;
+        previous = value;
+      }
+    }
+    EXPECT_GT(SkColorGetR(pixels.getColor(center + 2, center)), 0u);
+  }
+}
