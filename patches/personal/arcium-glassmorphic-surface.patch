+TEST_F(BrowserViewTest, MRUTabSwitcherSharesBrowserWidget) {
+  content::WebContents* active =
+      browser()->tab_strip_model()->GetActiveWebContents();
+  ASSERT_TRUE(active);
+  browser_view()->SetSize(gfx::Size(1000, 800));
+  const size_t original_child_count = browser_view()->children().size();
+
+  UpdateMRUTabSwitcherVisualizer(browser_view(), {active}, active);
+  ASSERT_EQ(browser_view()->children().size(), original_child_count + 1);
+  views::View* overlay = browser_view()->children().back();
+  EXPECT_EQ(overlay->GetWidget(), browser_view()->GetWidget());
+  EXPECT_FALSE(overlay->GetCanProcessEventsWithinSubtree());
+  EXPECT_FALSE(overlay->bounds().IsEmpty());
+  EXPECT_EQ(overlay->bounds().CenterPoint(),
+            browser_view()->GetLocalBounds().CenterPoint());
+
+  size_t label_count = 0;
+  std::vector<views::View*> descendants{overlay};
+  while (!descendants.empty()) {
+    views::View* view = descendants.back();
+    descendants.pop_back();
+    if (auto* label = views::AsViewClass<views::Label>(view)) {
+      ++label_count;
+      EXPECT_FALSE(label->GetSubpixelRenderingEnabled());
+      EXPECT_GE(color_utils::GetContrastRatio(label->GetEnabledColor(),
+                                              label->GetBackgroundColor()),
+                4.5f);
+    }
+    descendants.insert(descendants.end(), view->children().begin(),
+                       view->children().end());
+  }
+  EXPECT_EQ(label_count, 2u);
+
+  browser_view()->SetSize(gfx::Size(1200, 900));
+  EXPECT_EQ(overlay->bounds().CenterPoint(),
+            browser_view()->GetLocalBounds().CenterPoint());
+
+  StopMRUTabSwitcherVisualizer(browser_view());
+  EXPECT_EQ(browser_view()->children().size(), original_child_count);
+}
