+TEST_F(HeliumSpaceServiceTest, ContentFrameDefaultsAndBoundaryWrites) {
+  arcium_settings::ArciumSettingsModel model(
+      profile(), base::DoNothing(), base::DoNothing());
+  const auto defaults = arcium::ContentFrameStyle();
+  EXPECT_EQ(defaults.border_width, 0);
+  EXPECT_EQ(model.GetContentFrame(), arcium::SerializeContentFrame(defaults));
+  auto style = defaults;
+  style.border_width = 6;
+  style.x = -24;
+  style.y = 24;
+  style.blur = 48;
+  style.spread = -12;
+  style.opacity = 100;
+  style.color = "#8C7BFF";
+  ASSERT_TRUE(model.SetContentFrame(arcium::SerializeContentFrame(style)));
+  EXPECT_EQ(arcium::ReadContentFrame(profile()->GetPrefs()), style);
+  // Foundation sends numeric dictionary values as doubles.
+  auto bridge_payload = arcium::SerializeContentFrame(style);
+  bridge_payload.Set("borderWidth", 6.0);
+  EXPECT_TRUE(model.SetContentFrame(bridge_payload));
+  style.border_width = 0;
+  style.x = 24;
+  style.y = -24;
+  style.blur = 0;
+  style.spread = 12;
+  style.opacity = 0;
+  EXPECT_TRUE(model.SetContentFrame(arcium::SerializeContentFrame(style)));
+  EXPECT_EQ(arcium::ReadContentFrame(profile()->GetPrefs()), style);
+}
+
+TEST_F(HeliumSpaceServiceTest, ContentFrameRejectsInvalidAndManagedWrites) {
+  arcium_settings::ArciumSettingsModel model(
+      profile(), base::DoNothing(), base::DoNothing());
+  const auto saved = model.GetContentFrame();
+  for (const char* field : {"borderWidth", "x", "y", "blur", "spread", "opacity"}) {
+    SCOPED_TRACE(field);
+    for (double invalid : {-1000.0, 1000.0, 0.5}) {
+      auto payload = saved.Clone();
+      payload.Set(field, invalid);
+      EXPECT_FALSE(model.SetContentFrame(payload));
+    }
+    auto payload = saved.Clone();
+    payload.Set(field, true);
+    EXPECT_FALSE(model.SetContentFrame(payload));
+    payload.Remove(field);
+    EXPECT_FALSE(model.SetContentFrame(payload));
+  }
+  for (const char* color : {"red", "#123", "#FFFFFF00", "#GGGGGG", "#0xFFFF", "#+FFFFF"}) {
+    auto payload = saved.Clone();
+    payload.Set("color", color);
+    EXPECT_FALSE(model.SetContentFrame(payload));
+  }
+  auto oversized_border = saved.Clone();
+  oversized_border.Set("borderWidth", 7);
+  EXPECT_FALSE(model.SetContentFrame(oversized_border));
+  EXPECT_EQ(model.GetContentFrame(), saved);
+  auto* prefs = profile()->GetTestingPrefService();
+  prefs->SetManagedPref(arcium::kContentFramePref, base::Value(saved.Clone()));
+  auto change = saved.Clone();
+  change.Set("borderWidth", 6);
+  EXPECT_FALSE(model.SetContentFrame(change));
+  prefs->RemoveManagedPref(arcium::kContentFramePref);
+  model.Shutdown();
+  EXPECT_FALSE(model.SetContentFrame(change));
+}
+
+TEST_F(HeliumSpaceServiceTest, ContentFrameObservesExternalChanges) {
+  int changes = 0;
+  arcium_settings::ArciumSettingsModel model(
+      profile(), base::BindLambdaForTesting([&] { ++changes; }),
+      base::DoNothing());
+  auto style = arcium::ContentFrameStyle();
+  style.border_width = 6;
+  profile()->GetPrefs()->SetDict(arcium::kContentFramePref,
+                                arcium::SerializeContentFrame(style));
+  EXPECT_GT(changes, 0);
+  EXPECT_EQ(model.GetContentFrame(), arcium::SerializeContentFrame(style));
+  const int before_shutdown = changes;
+  model.Shutdown();
+  profile()->GetPrefs()->ClearPref(arcium::kContentFramePref);
+  EXPECT_EQ(changes, before_shutdown);
+}
+
 }  // namespace helium
