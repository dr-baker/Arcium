===================================================================
--- /dev/null
+++ src/chrome/browser/ui/helium/arcium_content_frame.h
@@ -0,0 +1,88 @@
+// Copyright 2026 The Arcium Authors
+// SPDX-License-Identifier: GPL-3.0-only
+
+#ifndef CHROME_BROWSER_UI_HELIUM_ARCIUM_CONTENT_FRAME_H_
+#define CHROME_BROWSER_UI_HELIUM_ARCIUM_CONTENT_FRAME_H_
+
+#include <cmath>
+#include <cstdint>
+#include <optional>
+#include <string>
+#include <string_view>
+
+#include "base/strings/string_number_conversions.h"
+#include "base/values.h"
+#include "components/prefs/pref_service.h"
+
+namespace arcium {
+
+inline constexpr char kContentFramePref[] = "arcium.appearance.content_frame";
+
+struct ContentFrameStyle {
+  int border_width = 0;
+  int x = 0;
+  int y = 2;
+  int blur = 8;
+  int spread = 0;
+  int opacity = 25;
+  std::string color = "#000000";
+
+  bool operator==(const ContentFrameStyle&) const = default;
+};
+
+inline base::DictValue SerializeContentFrame(const ContentFrameStyle& style) {
+  return base::DictValue()
+      .Set("borderWidth", style.border_width)
+      .Set("x", style.x)
+      .Set("y", style.y)
+      .Set("blur", style.blur)
+      .Set("spread", style.spread)
+      .Set("opacity", style.opacity)
+      .Set("color", style.color);
+}
+
+inline std::optional<int> ContentFrameNumber(const base::DictValue& value,
+                                            std::string_view key,
+                                            int min, int max) {
+  const auto* raw = value.Find(key);
+  if (!raw || (!raw->is_int() && !raw->is_double())) {
+    return std::nullopt;
+  }
+  const double number = raw->is_int() ? raw->GetInt() : raw->GetDouble();
+  if (!std::isfinite(number) || number < min || number > max ||
+      std::trunc(number) != number) {
+    return std::nullopt;
+  }
+  return static_cast<int>(number);
+}
+
+inline std::optional<ContentFrameStyle> ParseContentFrame(
+    const base::DictValue& value) {
+  const auto border = ContentFrameNumber(value, "borderWidth", 0, 6);
+  const auto x = ContentFrameNumber(value, "x", -24, 24);
+  const auto y = ContentFrameNumber(value, "y", -24, 24);
+  const auto blur = ContentFrameNumber(value, "blur", 0, 48);
+  const auto spread = ContentFrameNumber(value, "spread", -12, 12);
+  const auto opacity = ContentFrameNumber(value, "opacity", 0, 100);
+  const auto* color = value.FindString("color");
+  uint32_t rgb = 0;
+  if (value.size() != 7 || !border || !x || !y || !blur || !spread || !opacity ||
+      !color || color->size() != 7 || color->front() != '#' ||
+      color->find_first_not_of("0123456789abcdefABCDEF", 1) != std::string::npos ||
+      !base::HexStringToUInt(color->substr(1), &rgb)) {
+    return std::nullopt;
+  }
+  return ContentFrameStyle{*border, *x, *y, *blur, *spread, *opacity, *color};
+}
+
+inline ContentFrameStyle ReadContentFrame(const PrefService* prefs) {
+  if (!prefs || !prefs->FindPreference(kContentFramePref)) {
+    return {};
+  }
+  return ParseContentFrame(prefs->GetDict(kContentFramePref))
+      .value_or(ContentFrameStyle{});
+}
+
+}  // namespace arcium
+
+#endif  // CHROME_BROWSER_UI_HELIUM_ARCIUM_CONTENT_FRAME_H_
