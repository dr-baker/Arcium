+ContentsFrameShadow::ContentsFrameShadow() {
+  SetPaintToLayer();
+  layer()->SetFillsBoundsOpaquely(false);
+  SetCanProcessEventsWithinSubtree(false);
+  GetViewAccessibility().SetIsInvisible(true);
+}
+
+void ContentsFrameShadow::Update(arcium::ContentFrameStyle style,
+                                std::vector<Frame> frames) {
+  if (style_ == style && frames_ == frames) {
+    return;
+  }
+  style_ = std::move(style);
+  frames_ = std::move(frames);
+  SchedulePaint();
+}
+
+void ContentsFrameShadow::OnPaint(gfx::Canvas* canvas) {
+  if (style_.opacity == 0 || frames_.empty()) {
+    return;
+  }
+  uint32_t rgb = 0;
+  base::HexStringToUInt(style_.color.substr(1), &rgb);
+  const SkColor color = SkColorSetARGB(
+      (style_.opacity * 255 + 50) / 100, (rgb >> 16) & 255,
+      (rgb >> 8) & 255, rgb & 255);
+  canvas->Save();
+  // The effect belongs to chrome, including when a page has transparency.
+  for (const auto& frame : frames_) {
+    canvas->ClipPath(
+        ContentsContainerOutline::GetPath(frame.bounds, frame.radii),
+        true, SkClipOp::kDifference);
+  }
+  for (const auto& frame : frames_) {
+    gfx::RectF bounds = frame.bounds;
+    bounds.Outset(style_.spread);
+    if (bounds.IsEmpty()) {
+      continue;
+    }
+    const auto radius = [this](float value) {
+      return std::max(0.f, value + style_.spread);
+    };
+    const gfx::RoundedCornersF radii(
+        radius(frame.radii.upper_left()), radius(frame.radii.upper_right()),
+        radius(frame.radii.lower_right()), radius(frame.radii.lower_left()));
+    cc::PaintFlags flags;
+    flags.setAntiAlias(true);
+    flags.setColor(SK_ColorTRANSPARENT);
+    flags.setLooper(gfx::CreateShadowDrawLooper({gfx::ShadowValue(
+        gfx::Vector2d(style_.x, style_.y), style_.blur, color)}));
+    // Only the blurred shadow is visible; the source shape is clipped out.
+    canvas->DrawPath(ContentsContainerOutline::GetPath(bounds, radii), flags);
+  }
+  canvas->Restore();
+}
+
+BEGIN_METADATA(ContentsFrameShadow)
+END_METADATA
+
 BEGIN_METADATA(ContentsContainerOutline)
 END_METADATA
