+TEST_F(ArciumNativePanelTest, InactiveScopeGlowIs66PercentAcrossSelectionTransitions) {
+  auto motion = gfx::AnimationTestApi::SetRichAnimationRenderMode(
+      gfx::Animation::RichAnimationRenderMode::FORCE_ENABLED);
+  Open();
+  EXPECT_NEAR(.75f, panel()->scope_glow_strength_for_testing(0), .0001f);
+  EXPECT_NEAR(.75f * .66f, panel()->scope_glow_strength_for_testing(1), .0001f);
+  Key(ui::VKEY_RIGHT);
+  auto* selection = panel()->scope_selection_animation_for_testing();
+  selection->Reset(.5);
+  EXPECT_NEAR(panel()->scope_glow_strength_for_testing(0),
+              panel()->scope_glow_strength_for_testing(1), .0001f);
+  selection->Reset(1);
+  EXPECT_NEAR(.75f * .66f, panel()->scope_glow_strength_for_testing(0), .0001f);
+  EXPECT_NEAR(.75f, panel()->scope_glow_strength_for_testing(1), .0001f);
+  CommandPanelAppearance appearance;
+  appearance.glow_strength = 1.25;
+  panel()->SetAppearance(appearance);
+  EXPECT_NEAR(1.25f * .66f, panel()->scope_glow_strength_for_testing(0), .0001f);
+  EXPECT_NEAR(1.25f, panel()->scope_glow_strength_for_testing(1), .0001f);
+}
