+TEST_F(ArciumBrowserChromeTest, NewTabCommandRepeatsInsidePanelAndSurvivesEscape) {
+  prefs()->SetString(prefs::kNewTabPageLocationOverride, "about:blank");
+  arcium::CommandPanelPresentation::SetSessionFactoryForTesting(
+      browser_view(), base::BindRepeating([]() -> std::unique_ptr<arcium::CommandSession> {
+        return std::make_unique<arcium::CommandExampleSession>(
+            std::vector<arcium::CommandScopeDescriptor>{
+                {.id = arcium::kOmniScope, .label = u"Omni"}});
+      }));
+  auto* model = browser()->tab_strip_model();
+  const int before = model->count();
+  ASSERT_TRUE(chrome::ExecuteCommand(browser(), IDC_NEW_TAB));
+  auto* presentation = arcium::CommandPanelPresentation::Get(browser_view());
+  ASSERT_TRUE(presentation);
+  ASSERT_TRUE(base::test::RunUntil([&] { return presentation->is_open(); }));
+  EXPECT_EQ(before + 1, model->count());
+  auto* first = model->GetActiveWebContents();
+  auto* panel = presentation->panel();
+  ASSERT_TRUE(panel);
+  EXPECT_TRUE(panel->input_for_testing()->GetText().empty());
+  ui::KeyEvent new_tab(ui::EventType::kKeyPressed, ui::VKEY_T,
+#if BUILDFLAG(IS_MAC)
+                      ui::EF_COMMAND_DOWN);
+#else
+                      ui::EF_CONTROL_DOWN);
+#endif
+  EXPECT_TRUE(panel->HandleKeyEvent(panel->input_for_testing(), new_tab));
+  EXPECT_EQ(before + 2, model->count());
+  EXPECT_NE(first, model->GetActiveWebContents());
+  ASSERT_TRUE(base::test::RunUntil([&] { return presentation->is_open(); }));
+  panel = presentation->panel();
+  ASSERT_TRUE(panel);
+  EXPECT_TRUE(panel->input_for_testing()->GetText().empty());
+  ui::KeyEvent escape(ui::EventType::kKeyPressed, ui::VKEY_ESCAPE, ui::EF_NONE);
+  EXPECT_TRUE(panel->HandleKeyEvent(panel->input_for_testing(), escape));
+  ASSERT_TRUE(base::test::RunUntil([&] { return !presentation->widget(); }));
+  EXPECT_EQ(before + 2, model->count());
+}
+
+TEST_F(ArciumBrowserChromeTest, PopupNewTabOpensPanelInDestinationWindow) {
+  prefs()->SetString(prefs::kNewTabPageLocationOverride, "about:blank");
+  arcium::CommandPanelPresentation::SetSessionFactoryForTesting(
+      browser_view(), base::BindRepeating([]() -> std::unique_ptr<arcium::CommandSession> {
+        return std::make_unique<arcium::CommandExampleSession>(
+            std::vector<arcium::CommandScopeDescriptor>{
+                {.id = arcium::kOmniScope, .label = u"Omni"}});
+      }));
+  auto* popup = CreateBrowserWithBrowserView(profile(), Browser::TYPE_POPUP);
+  AddTab(popup, GURL("https://popup.test/"));
+  auto* original = popup->tab_strip_model()->GetActiveWebContents();
+  const int before = browser()->tab_strip_model()->count();
+  ASSERT_TRUE(chrome::ExecuteCommand(popup, IDC_NEW_TAB));
+  EXPECT_EQ(1, popup->tab_strip_model()->count());
+  EXPECT_EQ(original, popup->tab_strip_model()->GetActiveWebContents());
+  EXPECT_EQ(before + 1, browser()->tab_strip_model()->count());
+  auto* presentation = arcium::CommandPanelPresentation::Get(browser_view());
+  ASSERT_TRUE(presentation);
+  ASSERT_TRUE(base::test::RunUntil([&] { return presentation->is_open(); }));
+  EXPECT_TRUE(presentation->panel()->input_for_testing()->GetText().empty());
+  presentation->Close();
+  ASSERT_TRUE(base::test::RunUntil([&] { return !presentation->widget(); }));
+}
