+import assert from 'node:assert/strict';
+import {readFileSync} from 'node:fs';
+import {createRequire} from 'node:module';
+import test from 'node:test';
+import vm from 'node:vm';
+import * as stores from 'svelte/store';
+import {compile} from 'svelte/compiler';
+import * as S from '../src/lib/arc/spaces.ts';
+const require = createRequire(import.meta.url);
+const ts = require('typescript');
+const tick = () => new Promise(resolve => setImmediate(resolve));
+const transpile = source => {
+    const parsed = ts.createSourceFile('x.ts', source, ts.ScriptTarget.Latest, true, ts.ScriptKind.TS);
+    const stripped = ts.createPrinter().printFile(ts.factory.updateSourceFile(parsed,
+        parsed.statements.filter(s => !ts.isImportDeclaration(s))));
+    return ts.transpileModule(stripped, {compilerOptions: {
+        target: ts.ScriptTarget.ES2022, module: ts.ModuleKind.CommonJS,
+    }}).outputText;
+};
+const entry = {token: 'token', identity: 'space', profileToken: 'profile', name: 'Example',
+    profileLabel: 'Example', pins: 1, folders: 0, favorites: 0, favoritesOnly: false};
+const ready = {generation: 1, batchId: 0, phase: 'ready', failure: '', spaces: [entry], jobs: [], canOpen: false};
+const imported = {...ready, batchId: 1, phase: 'finished', canOpen: true,
+    jobs: [{id: 1, tokens: ['token'], profileLabel: 'Example', state: 'succeeded', failure: '',
+        mayHavePartialData: false, historyFinished: false, counts: {spaces: 1, pins: 1, folders: 0, favorites: 0}}]};
+function controller() {
+    let emit;
+    const calls = [];
+    const proxy = {initialize: async () => ready, onStateChanged: fn => {emit = fn; return () => {};},
+        open: async (batch, customize) => {calls.push([batch, customize]); return true;}};
+    const context = vm.createContext({exports: {}, writable: stores.writable, get: stores.get,
+        Spaces: S, setTimeout, clearTimeout});
+    vm.runInContext(transpile(readFileSync('src/lib/arc/controller.ts', 'utf8')), context);
+    const c = context.exports.createArcImportController({proxy: () => proxy, timeoutMs: 8});
+    return {c, calls, proxy, init: async () => {await c.reload(); emit(imported);}};
+}
+function page(name, {canOpen = true, completed = false, model = null} = {}) {
+    if (!model) {
+        model = S.applySnapshot(S.initialModel(), ready);
+        model = S.prepareOneClick(S.requestOneClick(model, 1));
+        model = S.markStarting(model, S.buildStart(model), true);
+        model = S.applySnapshot(model, imported);
+    }
+    const calls = [], record = name => (...args) => calls.push([name, ...args]);
+    const result = {open: async () => true, appearance: async () => true, complete: async () => {}};
+    const context = vm.createContext({exports: {},
+        $state: value => value, $derived: value => value, $effect: () => {}, onDestroy: () => {},
+        $currentPage: name, $preferencesBootstrap: 'ready', retryPreferences: record('retryPrefs'),
+        $preferences: {completed_onboarding: completed}, standaloneImport: false, $arc: model, Spaces: S,
+        oneClickStatus: () => ({text: 'Imported', failed: false}),
+        arcImport: {state: {}, canOpen: () => canOpen,
+            open: mode => {calls.push(['imported', mode]); return result.open();},
+            prefetch: record('prefetch'), importAll: record('importAll'), cancelOneClick: record('cancel')},
+        chooseRoute: record('route'), browserIconUrl: () => '', parseLocalizedString: () => [],
+        completeOnboarding: () => {calls.push(['complete']); return result.complete();},
+        openOnboardingAppearance: () => {calls.push(['ownAppearance']); return result.appearance();},
+        s: {welcome: {terms: ''}}, window: {open: record('navigate')},
+    });
+    const source = readFileSync(`src/pages/${name}.svelte`, 'utf8').match(/<script lang="ts">([\s\S]*?)<\/script>/)[1];
+    vm.runInContext(transpile(source), context);
+    return {calls, result, setCanOpen: value => {canOpen = value;},
+        run: code => vm.runInContext(code, context)};
+}
+
+test('Browse and Appearance opens each cache their own native acknowledgement', async () => {
+    const h = controller(); await h.init();
+    assert.equal(await h.c.open(), true);
+    assert.equal(await h.c.open(), true);
+    assert.equal(await h.c.open(true), true);
+    assert.equal(await h.c.open(true), true);
+    assert.deepEqual(h.calls, [[1, false], [1, true]]);
+});
+
+test('a pending Appearance open deduplicates itself and does not masquerade as Browse', async () => {
+    const h = controller(); await h.init();
+    let resolve;
+    h.proxy.open = (batch, mode) => {h.calls.push([batch, mode]); return new Promise(ok => {resolve = ok;});};
+    const first = h.c.open(true), duplicate = h.c.open(true);
+    await tick();
+    assert.equal(await h.c.open(false), false);
+    assert.deepEqual(h.calls, [[1, true]]);
+    resolve(true);
+    assert.deepEqual(await Promise.all([first, duplicate]), [true, true]);
+    assert.equal(await h.c.open(true), true);
+    assert.equal(h.calls.length, 1);
+});
+
+test('failed and timed-out Appearance opens remain retryable', async () => {
+    for (const failure of [() => false, () => Promise.reject('unavailable'), () => new Promise(() => {})]) {
+        const h = controller(); await h.init();
+        h.proxy.open = failure;
+        assert.equal(await h.c.open(true), false);
+        h.proxy.open = async () => true;
+        assert.equal(await h.c.open(true), true);
+    }
+});
+
+test('Arc appearance completion opens the imported target and never navigates setup again', async () => {
+    for (const name of ['Welcome', 'Finish']) {
+        const h = page(name);
+        await h.run('done(false, true)');
+        assert.deepEqual(h.calls, [['imported', true], ['complete']]);
+        assert.equal(h.run('completed()'), true);
+        await h.run('done()'); await h.run('done(false, true)');
+        assert.equal(h.calls.length, 2);
+    }
+});
+
+test('appearance failure leaves Browse available and does not complete or grant service consent', async () => {
+    for (const name of ['Welcome', 'Finish']) {
+        for (const fail of [async () => false, async () => {throw Error('unavailable');}]) {
+            const h = page(name); h.result.open = fail;
+            await h.run('done(false, true)');
+            assert.equal(h.run('appearanceFailed'), true);
+            assert.equal(h.run('completed()'), false);
+            assert.equal(h.run('finishing'), false);
+            assert.deepEqual(h.calls, [['imported', true]]);
+            h.result.open = async () => true;
+            await h.run('done()');
+            assert.deepEqual(h.calls, [['imported', true], ['imported', false], ['complete']]);
+        }
+    }
+});
+
+test('customization shares the completion guard with Start browsing and Configure', async () => {
+    for (const name of ['Welcome', 'Finish']) {
+        const h = page(name); let resolve;
+        h.result.open = () => new Promise(ok => {resolve = ok;});
+        const first = h.run('done(false, true)');
+        await h.run('done(false, true)'); await h.run('done()');
+        if (name === 'Welcome') h.run('leave("arc")');
+        assert.deepEqual(h.calls, [['imported', true]]);
+        resolve(true); await first;
+        assert.deepEqual(h.calls, [['imported', true], ['complete']]);
+    }
+});
+
+test('fresh Finish opens Appearance for its own profile and completes without setup navigation', async () => {
+    const h = page('Finish', {canOpen: false});
+    await h.run('done(false, true)');
+    assert.deepEqual(h.calls, [['ownAppearance'], ['complete']]);
+    assert.equal(h.run('completed()'), true);
+});
+
+test('fresh Appearance failure permits explicit retry without completion', async () => {
+    const h = page('Finish', {canOpen: false});
+    h.result.appearance = async () => false;
+    await h.run('done(false, true)');
+    assert.deepEqual(h.calls, [['ownAppearance']]);
+    assert.equal(h.run('completed()'), false);
+    h.result.appearance = async () => true;
+    await h.run('done(false, true)');
+    assert.deepEqual(h.calls, [['ownAppearance'], ['ownAppearance'], ['complete']]);
+});
+
+test('critical completion failure stays retryable after Appearance opened', async () => {
+    const h = page('Welcome');
+    h.result.complete = async () => {throw Error('lost reply');};
+    await h.run('done(false, true)');
+    assert.equal(h.run('completed()'), false);
+    assert.equal(h.run('stepFailed'), true);
+    assert.equal(h.run('appearanceFailed'), false, 'completion failure must not claim Appearance failed to open');
+    h.result.complete = async () => {};
+    await h.run('done(false, true)');
+    assert.equal(h.run('completed()'), true);
+});
+
+test('already completed setup never opens Appearance again', async () => {
+    for (const name of ['Welcome', 'Finish']) {
+        const h = page(name, {completed: true});
+        await h.run('done(false, true)');
+        assert.deepEqual(h.calls, []);
+    }
+});
+
+test('appearance bridge forwards strict native success, rejects failure, and times out without preferences writes', async () => {
+    for (const [response, expected] of [[true, true], [false, false], ['true', false], [null, false]]) {
+        const calls = [];
+        const context = vm.createContext({exports: {}, setTimeout, clearTimeout,
+            cr: {sendWithPromise: async (...args) => {calls.push(args); return response;}}});
