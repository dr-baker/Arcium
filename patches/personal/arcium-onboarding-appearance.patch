+void ArcSpacesImport::Open(
+    int batch_id,
+    base::OnceCallback<void(BrowserWindowInterface*)> opened) {
+  if (!CanOpen(batch_id) || !HasValidOpenMapping()) {
+    std::move(opened).Run(nullptr);
+    return;
+  }
+  auto* manager = g_browser_process->profile_manager();
+  // Load only the previously created destination. Never create a replacement
+  // profile if the user has deleted it since import completed.
+  manager->LoadProfileByPath(
+      first_profile_path_, false,
+      base::BindOnce(&ArcSpacesImport::OpenProfileReady,
+                     weak_factory_.GetWeakPtr(), batch_id, first_profile_path_,
+                     first_space_id_, first_source_key_, std::move(opened)));
+}
+void ArcSpacesImport::OpenProfileReady(
+    int batch_id,
+    base::FilePath profile_path,
+    std::string space_id,
+    std::string source_key,
+    base::OnceCallback<void(BrowserWindowInterface*)> opened,
+    Profile* profile) {
+  if (!CanOpen(batch_id) || profile_path != first_profile_path_ ||
+      space_id != first_space_id_ || source_key != first_source_key_ ||
+      !HasValidOpenMapping() || !profile ||
+      !g_browser_process->profile_manager()->IsValidProfile(profile) ||
+      profile->GetPath() != profile_path || !profile->IsRegularProfile() ||
+      profile->IsOffTheRecord() || profile->ShutdownStarted() ||
+      profile->GetPrefs()->GetString(prefs::kArciumArcImportSourceMarker) !=
+          source_key ||
+      Browser::GetCreationStatusForProfile(profile) !=
+          Browser::CreationStatus::kOk) {
+    std::move(opened).Run(nullptr);
+    return;
+  }
+  auto keep_alive = ScopedProfileKeepAlive::TryAcquire(
+      profile, ProfileKeepAliveOrigin::kArciumSettingsWindow);
+  auto* service =
+      keep_alive ? helium::HeliumSpaceServiceFactory::GetForProfile(profile)
+                 : nullptr;
+  auto* space = service ? service->GetSpaceById(space_id) : nullptr;
+  auto weak = weak_factory_.GetWeakPtr();
+  BrowserWindowInterface* window =
+      space ? space->ActivateOrCreatePrimaryWindow() : nullptr;
+  // Activation may run observers that close setup, start another batch or
+  // move this same-profile window to another Space.
+  if (!weak) {
+    return;
+  }
+  const bool valid =
+      weak->CanOpen(batch_id) && profile_path == weak->first_profile_path_ &&
+      space_id == weak->first_space_id_ &&
+      source_key == weak->first_source_key_ && weak->HasValidOpenMapping() &&
+      IsActivatedSpaceWindow(profile, space_id, window);
+  std::move(opened).Run(valid ? window : nullptr);
+}
