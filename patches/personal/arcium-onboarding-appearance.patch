+void ArcSpacesImportHandler::OpenAppearance(const base::ListValue& args) {
+  if (!BeginMessage(args)) {
+    return;
+  }
+  if (args.size() != 1) {
+    Reply(args, "invalid_arguments");
+    return;
+  }
+  content::WebContents* contents = web_ui()->GetWebContents();
+  auto* profile =
+      contents ? Profile::FromBrowserContext(contents->GetBrowserContext())
+               : nullptr;
+  const GURL url = contents ? contents->GetLastCommittedURL() : GURL();
+  if (!profile || !profile->IsRegularProfile() || profile->IsOffTheRecord() ||
+      profile->ShutdownStarted() || !g_browser_process ||
+      g_browser_process->IsShuttingDown() ||
+      browser_shutdown::IsTryingToQuit() || !IsAppearanceOrigin(url) ||
+      Browser::GetCreationStatusForProfile(profile) !=
+          Browser::CreationStatus::kOk) {
+    RejectJavascriptCallback(args[0], base::Value("unavailable"));
+    return;
+  }
+  // Resolve the window by this page, never by activity order or another
+  // profile's active Space. A standalone import page cannot finish onboarding.
+  auto* owner =
+      ProfileBrowserCollection::GetForProfile(profile)->FindBrowserWithTab(
+          contents);
+  auto* service = helium::HeliumSpaceServiceFactory::GetForProfile(profile);
+  Browser* browser = owner ? owner->GetBrowserForMigrationOnly() : nullptr;
+  const std::string space_id =
+      service && browser
+          ? std::string(service->GetExplicitSpaceIdForBrowser(browser))
+          : "";
+  auto* space = service ? service->GetSpaceById(space_id) : nullptr;
+  if (!owner || owner->GetProfile() != profile ||
+      owner->GetType() != BrowserWindowInterface::TYPE_NORMAL || !space) {
+    RejectJavascriptCallback(args[0], base::Value("unavailable"));
+    return;
+  }
+  auto weak = weak_factory_.GetWeakPtr();
+  const base::Value callback_id = args[0].Clone();
+  auto* activated = space->ActivateOrCreatePrimaryWindow();
+  if (weak) {
+    weak->Opened(callback_id.Clone(), true,
+                 arcium::ArcSpacesImport::IsActivatedSpaceWindow(
+                     profile, space_id, activated)
+                     ? activated
+                     : nullptr);
+  }
+}
+void ArcSpacesImportHandler::Opened(base::Value callback_id,
+                                    bool customize,
+                                    BrowserWindowInterface* browser) {
+  if (!IsJavascriptAllowed()) {
+    return;
+  }
+  if (!browser) {
+    CompleteOpen(std::move(callback_id), false);
+    return;
+  }
+  auto weak = weak_factory_.GetWeakPtr();
+  const bool succeeded = !customize || chrome::ShowAppearanceSettings(browser);
+  // Routing can tear down the old page. Its callback must never reach a
+  // destroyed handler or a replacement document.
+  if (weak) {
+    weak->CompleteOpen(std::move(callback_id), succeeded);
+  }
+}
+void ArcSpacesImportHandler::CompleteOpen(base::Value callback_id,
+                                          bool succeeded) {
+  if (!IsJavascriptAllowed()) {
+    return;
+  }
+  if (!succeeded) {
+    RejectJavascriptCallback(callback_id, base::Value("open_failed"));
+    return;
+  }
+  ResolveJavascriptCallback(callback_id, base::Value(true));
