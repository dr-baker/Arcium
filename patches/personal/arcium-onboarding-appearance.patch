+// Copyright 2026 The Helium Authors
+// SPDX-License-Identifier: GPL-3.0-only
+import * as cr from "../cr";
+
+// The native handler opens Appearance for this setup tab's own profile/Space.
+// It must acknowledge the actual window, not merely queue an open request.
+export const openOnboardingAppearance = async (): Promise<boolean> => {
+    let timeout: ReturnType<typeof setTimeout> | undefined;
+    try {
+        return await Promise.race([
+            cr.sendWithPromise<unknown>('openOnboardingAppearance'),
+            new Promise<false>(resolve => {
+                timeout = setTimeout(() => resolve(false), 10_000);
+            }),
+        ]) === true;
+    } catch {
+        return false;
+    } finally {
+        if (timeout !== undefined) clearTimeout(timeout);
+    }
+};
