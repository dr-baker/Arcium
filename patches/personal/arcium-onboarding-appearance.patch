+        assert.deepEqual(calls, [['openOnboardingAppearance']]);
+    }
+    for (const reply of [() => Promise.reject('unavailable'), () => new Promise(() => {})]) {
+        const context = vm.createContext({exports: {}, setTimeout: (fn) => setTimeout(fn, 2), clearTimeout,
+            cr: {sendWithPromise: reply}});
+        vm.runInContext(transpile(readFileSync('src/lib/browser/appearance.ts', 'utf8')), context);
+        assert.equal(await context.exports.openOnboardingAppearance(), false);
+    }
