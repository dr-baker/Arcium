+    for (const name of ['Welcome', 'Finish']) {
+        const source = readFileSync(`src/pages/${name}.svelte`, 'utf8');
+        compile(source, {filename: `${name}.svelte`, generate: 'client'});
+        const markup = source.split('</script>')[1].split('<style>')[0];
