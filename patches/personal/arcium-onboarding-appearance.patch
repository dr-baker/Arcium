+bool ArcSpacesImport::HasValidOpenMapping() const {
+  auto* manager =
+      g_browser_process ? g_browser_process->profile_manager() : nullptr;
+  auto* local_state =
+      g_browser_process ? g_browser_process->local_state() : nullptr;
+  if (!manager || !local_state || g_browser_process->IsShuttingDown() ||
+      browser_shutdown::IsTryingToQuit()) {
+    return false;
+  }
+  const auto* entry =
+      manager->GetProfileAttributesStorage().GetProfileAttributesWithPath(
+          first_profile_path_);
+  const auto& mapping =
+      local_state->GetDict(prefs::kArciumArcImportDestinations);
+  const std::string directory = first_profile_path_.BaseName().AsUTF8Unsafe();
+  const std::string* mapped = mapping.FindString(first_source_key_);
+  return entry && !entry->IsOmitted() && !entry->IsSigninRequired() && mapped &&
+         *mapped == directory &&
+         ValidMapping(mapping, first_source_key_, directory) &&
+         manager->user_data_dir().Append(
+             base::FilePath::FromUTF8Unsafe(directory)) == first_profile_path_;
+}
+bool ArcSpacesImport::IsActivatedSpaceWindow(Profile* profile,
+                                             std::string_view space_id,
+                                             BrowserWindowInterface* window) {
+  auto* manager =
+      g_browser_process ? g_browser_process->profile_manager() : nullptr;
+  if (!manager || g_browser_process->IsShuttingDown() ||
+      browser_shutdown::IsTryingToQuit() || !profile ||
+      !manager->IsValidProfile(profile) || !profile->IsRegularProfile() ||
+      profile->IsOffTheRecord() || profile->ShutdownStarted() ||
+      space_id.empty() || !window) {
+    return false;
+  }
+  // Observers may have closed the returned window. Check membership before
+  // dereferencing it, rather than trusting a formerly valid raw pointer.
+  bool live = false;
+  ProfileBrowserCollection::GetForProfile(profile)->ForEach(
+      [&](BrowserWindowInterface* candidate) {
+        live = candidate == window;
+        return !live;
+      });
+  if (!live || window->IsDeleteScheduled() || window->GetProfile() != profile ||
+      window->GetType() != BrowserWindowInterface::TYPE_NORMAL) {
+    return false;
+  }
+  auto* browser = window->GetBrowserForMigrationOnly();
+  auto* service = helium::HeliumSpaceServiceFactory::GetForProfile(profile);
+  auto* space = service ? service->GetSpaceById(space_id) : nullptr;
+  return browser && space && space->GetPrimaryBrowser() == window &&
+         service->GetExplicitSpaceIdForBrowser(browser) == space_id;
+}
