+TEST_F(ArciumNativePanelTest, EmbeddedPanelNeverResizesItsEditorWindow) {
+  Open();
+  panel()->SetEmbedded(true);
+  const gfx::Rect editor_bounds(20, 30, 1180, 700);
+  widget_->SetBounds(editor_bounds);
+  auto* input = panel()->input_for_testing();
+  Query(u"interface");
+  input->SetSelectedRange(gfx::Range(1, 4));
+  panel()->SetUIScale(1.25f);
+  CommandPanelAppearance appearance;
+  appearance.reveal = CommandPanelAppearance::Reveal::kTabs;
+  panel()->SetAppearance(appearance);
+  Key(ui::VKEY_UP);
+  EXPECT_EQ(editor_bounds, widget_->GetWindowBoundsInScreen());
+  EXPECT_EQ(input, panel()->input_for_testing());
+  EXPECT_EQ(u"interface", input->GetText());
+  EXPECT_EQ(gfx::Range(1, 4), input->GetSelectedRange());
+}
+
+TEST_F(ArciumNativePanelTest, PreviewSearchesButCannotExecuteOrResolveActions) {
+  CommandPreviewSession preview(std::make_unique<FakeSession>(state_));
+  preview.SetInvocation(CommandInvocationMode::kNewTab);
+  EXPECT_FALSE(preview.GetScopes().empty());
+  std::shared_ptr<const CommandPublication> result;
+  preview.Search(kOmniScope, u"interface", base::BindLambdaForTesting(
+      [&](std::shared_ptr<const CommandPublication> publication) {
+        result = std::move(publication);
+      }));
+  ASSERT_TRUE(result);
+  ASSERT_FALSE(result->rows.empty());
+  CommandIntent intent;
+  intent.target = result->rows.front().target;
+  const auto execution = preview.Execute(intent);
+  EXPECT_FALSE(execution.success);
+  EXPECT_FALSE(execution.dismiss);
+  EXPECT_TRUE(state_->executed.empty());
+  EXPECT_TRUE(preview.ResolveActions(intent.target, "", u"").entries.empty());
+  EXPECT_TRUE(state_->menu_requests.empty());
+  const auto cancels = state_->cancels;
+  preview.Cancel();
+  EXPECT_GT(state_->cancels, cancels);
+}
