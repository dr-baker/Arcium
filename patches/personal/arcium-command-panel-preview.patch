+#ifndef CHROME_BROWSER_UI_OMNIBOX_ARCIUM_COMMAND_PREVIEW_SESSION_H_
+#define CHROME_BROWSER_UI_OMNIBOX_ARCIUM_COMMAND_PREVIEW_SESSION_H_
+
+#include <memory>
+#include <utility>
+
+#include "base/functional/bind.h"
+
+#include "chrome/browser/ui/omnibox/arcium_command_session.h"
+
+namespace arcium {
+
+// The actual search and scope providers, with no execution authority. Settings
+// previews can exercise the real presenter without navigating or changing tabs.
+class CommandPreviewSession final : public CommandSession {
+ public:
+  explicit CommandPreviewSession(std::unique_ptr<CommandSession> session)
+      : session_(std::move(session)) {}
+  void SetInvocation(CommandInvocationMode mode) override {
+    session_->SetInvocation(mode);
+  }
+  std::vector<CommandScopeDescriptor> GetScopes() const override {
+    return session_->GetScopes();
+  }
+  void Search(CommandScopeId scope, std::u16string query,
+              CommandPublishCallback publish) override {
+    session_->Search(std::move(scope), std::move(query), base::BindRepeating(
+        [](CommandPublishCallback publish,
+           std::shared_ptr<const CommandPublication> publication) {
+          auto preview = std::make_shared<CommandPublication>(*publication);
+          const auto strip_actions = [](CommandRow& row) {
+            row.has_actions = false;
+            row.primary_submenu_id.clear();
+          };
+          for (auto& row : preview->rows) strip_actions(row);
+          if (preview->current_tab) strip_actions(*preview->current_tab);
+          publish.Run(std::move(preview));
+        }, std::move(publish)));
+  }
+  void Cancel() override { session_->Cancel(); }
+  CommandMenu ResolveActions(const CommandTarget&, std::string_view,
+                            std::u16string_view) override { return {}; }
+  CommandExecutionResult Execute(const CommandIntent&) override { return {}; }
+
+ private:
+  std::unique_ptr<CommandSession> session_;
+};
+
+}  // namespace arcium
+#endif  // CHROME_BROWSER_UI_OMNIBOX_ARCIUM_COMMAND_PREVIEW_SESSION_H_
