@@ -51,14 +51,15 @@ class ProfilePickerTest : public testing
   TestingProfileManager testing_profile_manager_;
 };
 
-TEST_F(ProfilePickerTest, ShouldShowAtLaunch_MultipleProfiles_Default) {
+TEST_F(ProfilePickerTest,
+       OpensBrowserAtLaunch_MultipleProfiles_LegacyPickerEnabled) {
   testing_profile_manager()->CreateTestingProfile("profile1");
   testing_profile_manager()->CreateTestingProfile("profile2");
   ASSERT_TRUE(
       local_state()->GetBoolean(prefs::kBrowserShowProfilePickerOnStartup));
 
   EXPECT_EQ(ProfilePicker::GetStartupMode(),
-            StartupProfileMode::kProfilePicker);
+            StartupProfileMode::kBrowserWindow);
 }
 
 TEST_F(ProfilePickerTest, ShouldShowAtLaunch_MultipleProfiles_DisabledStartup) {
@@ -68,6 +69,30 @@ TEST_F(ProfilePickerTest, ShouldShowAtLa
 
   EXPECT_EQ(ProfilePicker::GetStartupMode(),
             StartupProfileMode::kBrowserWindow);
+}
+
+TEST_F(ProfilePickerTest, OpensBrowserAtLaunch_NoProfiles) {
+  EXPECT_EQ(ProfilePicker::GetStartupMode(),
+            StartupProfileMode::kBrowserWindow);
+}
+
+TEST_F(ProfilePickerTest, ForcedPickerPolicyIsRespected) {
+  testing_profile_manager()->CreateTestingProfile("profile1");
+  testing_profile_manager()->CreateTestingProfile("profile2");
+  local_state()->SetInteger(prefs::kBrowserProfilePickerAvailabilityOnStartup, 2);
+  local_state()->SetBoolean(prefs::kBrowserShowProfilePickerOnStartup, false);
+
+  EXPECT_EQ(ProfilePicker::GetStartupMode(),
+            StartupProfileMode::kProfilePicker);
+}
+
+TEST_F(ProfilePickerTest, DisabledPickerPolicyIsRespected) {
+  testing_profile_manager()->CreateTestingProfile("profile1");
+  testing_profile_manager()->CreateTestingProfile("profile2");
+  local_state()->SetInteger(prefs::kBrowserProfilePickerAvailabilityOnStartup, 1);
+
+  EXPECT_EQ(ProfilePicker::GetStartupMode(),
+            StartupProfileMode::kBrowserWindow);
 }
 
