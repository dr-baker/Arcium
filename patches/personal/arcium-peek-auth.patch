+IN_PROC_BROWSER_TEST_F(PeekAuthBrowserTest,
+                       PreservesFrozenDocumentAndTabStorage) {
+  ASSERT_TRUE(ui_test_utils::NavigateToURL(browser(), URL("/previous")));
+  const auto url = URL("/worksheet?quarter=Q4#draft");
+  ASSERT_TRUE(ui_test_utils::NavigateToURL(browser(), url));
+  auto* source = Source();
+  auto* document = source->GetPrimaryMainFrame();
+  Enable();
+  ASSERT_TRUE(content::ExecJs(source, R"JS(
+    draft.value = 'unsent work'; draft.focus(); scrollTo(0, 650);
+    sessionStorage.setItem('verifier', 'source-verifier');
+  )JS"));
+  const auto identity =
+      content::EvalJs(source, "window.identity").ExtractDouble();
+  const auto scroll = content::EvalJs(source, "scrollY").ExtractInt();
+  ASSERT_TRUE(content::ExecJs(source, "location.href = '/login'"));
+  WaitForPeek();
+  auto* preview = Controller()->web_contents_for_testing();
+  ASSERT_TRUE(preview);
+  EXPECT_EQ(document, source->GetPrimaryMainFrame());
+  EXPECT_EQ(url, source->GetLastCommittedURL());
+  EXPECT_EQ(source->GetBrowserContext(), preview->GetBrowserContext());
+  EXPECT_NE(content::Visibility::VISIBLE, source->GetVisibility());
+  EXPECT_TRUE(IsPeekAuthSourceProtected(source));
+  auto* lifecycle =
+      resource_coordinator::TabLifecycleUnitExternal::FromWebContents(source);
+  ASSERT_TRUE(lifecycle);
+  EXPECT_FALSE(
+      lifecycle->DiscardTab(::mojom::LifecycleUnitDiscardReason::EXTERNAL));
+  EXPECT_FALSE(
+      lifecycle->DiscardTab(::mojom::LifecycleUnitDiscardReason::URGENT));
+  EXPECT_EQ("source-verifier",
+            content::EvalJs(preview, "sessionStorage.getItem('verifier')"));
+  EXPECT_NE(source->GetController().GetDefaultSessionStorageNamespace()->id(),
+            preview->GetController().GetDefaultSessionStorageNamespace()->id());
+  ASSERT_TRUE(content::ExecJs(preview, R"JS(
+    sessionStorage.setItem('verifier', 'callback-verifier');
+    document.cookie = 'authed=yes; path=/'; location.href = '/wrong-dashboard';
+  )JS"));
+  ASSERT_TRUE(content::WaitForLoadStop(preview));
+  content::TestNavigationObserver blocked(source);
+  source->GetController().LoadURL(URL("/ordinary"), content::Referrer(),
+                                  ui::PAGE_TRANSITION_TYPED, std::string());
+  blocked.Wait();
+  EXPECT_FALSE(blocked.last_navigation_succeeded());
+  content::TestNavigationObserver blank(source);
+  source->GetController().LoadURL(GURL("about:blank"), content::Referrer(),
+                                  ui::PAGE_TRANSITION_TYPED, std::string());
+  blank.Wait();
+  EXPECT_FALSE(blank.last_navigation_succeeded());
+  ASSERT_TRUE(source->GetController().CanGoBack());
+  content::TestNavigationObserver back(source);
+  source->GetController().GoBack();
+  back.Wait();
+  EXPECT_FALSE(back.last_navigation_succeeded());
+  EXPECT_EQ(document, source->GetPrimaryMainFrame());
+  ClosePeek();
+  EXPECT_EQ(source, Source());
+  EXPECT_EQ(document, source->GetPrimaryMainFrame());
+  EXPECT_EQ(url, source->GetLastCommittedURL());
+  EXPECT_FALSE(IsPeekAuthSourceProtected(source));
+  EXPECT_EQ(identity, content::EvalJs(source, "window.identity"));
+  EXPECT_EQ(scroll, content::EvalJs(source, "scrollY"));
+  EXPECT_EQ("unsent work", content::EvalJs(source, "draft.value"));
+  EXPECT_EQ("draft", content::EvalJs(source, "document.activeElement.id"));
+  EXPECT_EQ("source-verifier",
+            content::EvalJs(source, "sessionStorage.getItem('verifier')"));
+  EXPECT_EQ(true,
+            content::EvalJs(source, "document.cookie.includes('authed=yes')"));
+  EXPECT_EQ(true, content::EvalJs(source,
+                                  "window.freezes > 0 && window.resumes > 0"));
+  EXPECT_EQ(true, content::EvalJs(
+                      source, "window.frozenTicks === window.resumedTicks"));
+  EXPECT_EQ(true, content::EvalJs(
+                      source, "fetch('/protected').then(r => !r.redirected)"));
+}
