+// The fixture deliberately completes login at the wrong dashboard. It uses
+// shared cookies and tab-scoped state without a real identity provider.
+class PeekAuthBrowserTest : public PeekControllerBrowserTest {
+ protected:
+  void SetUpOnMainThread() override {
+    PeekControllerBrowserTest::SetUpOnMainThread();
+    embedded_test_server()->RegisterRequestHandler(base::BindRepeating(
+        [](const net::test_server::HttpRequest& request)
+            -> std::unique_ptr<net::test_server::HttpResponse> {
+          auto response =
+              std::make_unique<net::test_server::BasicHttpResponse>();
+          response->set_content_type("text/html");
+          if (request.relative_url.starts_with("/protected")) {
+            const auto cookie = request.headers.find("Cookie");
+            if (cookie == request.headers.end() ||
+                cookie->second.find("authed=yes") == std::string::npos) {
+              response->set_code(net::HTTP_FOUND);
+              // The reported bare landing page drops the workspace fragment.
+              // A separate response keeps it to cover a root-based app route.
+              response->AddCustomHeader(
+                  "Location",
+                  request.relative_url.starts_with(
+                      "/protected-root-keep-fragment")
+                      ? "/"
+                  : request.relative_url.starts_with("/protected-root")
+                      ? "/#"
+                      : "/login");
+              return response;
+            }
+          }
+          if (request.relative_url == "/login" || request.relative_url == "/") {
+            response->set_content(
+                "<title>Sign in</title><button>Sign in</button>");
+          } else {
+            response->set_content(R"HTML(<title>Worksheet</title>
+              <textarea id=draft></textarea><div style='height:4000px'></div>
+              <script>
+                window.identity = Math.random(); window.ticks = 0;
+                window.freezes = 0; window.resumes = 0;
+                setInterval(() => ++window.ticks, 50);
+                document.addEventListener('freeze', () => {
+                  ++window.freezes; window.frozenTicks = window.ticks;
+                });
+                document.addEventListener('resume', () => {
+                  ++window.resumes; window.resumedTicks = window.ticks;
+                });
+              </script>)HTML");
+          }
+          return response;
+        }));
+    ASSERT_TRUE(embedded_test_server()->Start());
+  }
+
+  GURL URL(const std::string& path) {
+    return embedded_test_server()->GetURL(path);
+  }
+  content::WebContents* Source() {
