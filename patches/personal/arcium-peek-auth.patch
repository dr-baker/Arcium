+IN_PROC_BROWSER_TEST_F(PeekAuthBrowserTest,
+                       SnowflakeRootExpiryPreservesDocument) {
+  const auto root = embedded_test_server()->GetURL("app.snowflake.com", "/");
+  const auto worksheet = embedded_test_server()->GetURL(
+      "app.snowflake.com", "/worksheet?quarter=Q4#draft");
+  ASSERT_TRUE(ui_test_utils::NavigateToURL(browser(), worksheet));
+  auto* source = Source();
+  auto* document = source->GetPrimaryMainFrame();
+  SetPeekAuthEnabledForSite(browser()->profile(), root, true);
+  ASSERT_TRUE(content::ExecJs(source, "draft.value = 'unsent Snowflake work'",
+                              content::EXECUTE_SCRIPT_NO_USER_GESTURE));
+  const auto identity = content::EvalJs(source, "identity",
+                                        content::EXECUTE_SCRIPT_NO_USER_GESTURE)
+                            .ExtractDouble();
+  ASSERT_TRUE(content::ExecJs(source,
+                              content::JsReplace("location.replace($1)", root),
+                              content::EXECUTE_SCRIPT_NO_USER_GESTURE));
+  WaitForPeek();
+  EXPECT_EQ(root,
+            Controller()->web_contents_for_testing()->GetLastCommittedURL());
+  EXPECT_EQ(worksheet, source->GetLastCommittedURL());
+  EXPECT_TRUE(IsPeekAuthSourceProtected(source));
+  ClosePeek();
+  EXPECT_EQ(document, source->GetPrimaryMainFrame());
+  EXPECT_EQ(identity, content::EvalJs(source, "identity"));
+  EXPECT_EQ("unsent Snowflake work", content::EvalJs(source, "draft.value"));
+  EXPECT_EQ(worksheet, source->GetLastCommittedURL());
+}
