+#include "ui/gfx/image/image_skia.h"
+#include "url/origin.h"
+
+namespace helium {
+namespace {
+const char kAuthStateKey = 0;
+
+struct AuthState : base::SupportsUserData::Data {
+  bool protected_source = false;
+  content::WeakDocumentPtr attempted_document;
+  GURL return_url;
+  GURL bypass_url;
+};
+
+AuthState& State(content::WebContents* contents) {
+  auto* state = static_cast<AuthState*>(contents->GetUserData(&kAuthStateKey));
+  if (!state) {
+    auto owned = std::make_unique<AuthState>();
+    state = owned.get();
+    contents->SetUserData(&kAuthStateKey, std::move(owned));
+  }
+  return *state;
+}
+
+PeekController* ControllerFor(content::WebContents* contents) {
+  auto* tab = tabs::TabInterface::MaybeGetFromContents(contents);
+  auto* window = tab ? tab->GetBrowserWindowInterface() : nullptr;
+  auto* browser = window ? window->GetBrowserForMigrationOnly() : nullptr;
+  auto* view =
+      browser ? BrowserView::GetBrowserViewForBrowser(browser) : nullptr;
+  return view && browser->tab_strip_model()->GetActiveWebContents() == contents
+             ? view->peek_controller()
+             : nullptr;
+}
+
+// Snowflake can send an expired workspace to its bare account landing page
+// before exposing a recognizable login endpoint. Keep this contextual: a
+// deliberate homepage visit or a root-based application route is not sign-in.
+bool IsSnowflakeRootAuthNavigation(content::NavigationHandle& handle,
+                                   const GURL& initial_destination) {
+  const GURL& target = handle.GetURL();
+  if (!target.SchemeIsHTTPOrHTTPS() ||
+      target.host_piece() != "app.snowflake.com" ||
+      target.path_piece() != "/" || !target.query_piece().empty() ||
+      !target.ref_piece().empty()) {
+    return false;
+  }
+  const auto is_deep_page = [&target](const GURL& url) {
+    return url::Origin::Create(url) == url::Origin::Create(target) &&
+           url.path_piece() != "/" && !IsPeekAuthURL(url);
+  };
+  if (handle.WasServerRedirect() && is_deep_page(initial_destination)) {
+    return true;
+  }
+  return handle.IsRendererInitiated() && !handle.HasUserGesture() &&
+         is_deep_page(handle.GetWebContents()->GetLastCommittedURL());
+}
+
+// Activating a cached or prerendered page skips ordinary navigation throttles.
+class PeekAuthCommitGuard : public content::CommitDeferringCondition {
+ public:
+  explicit PeekAuthCommitGuard(content::NavigationHandle& handle)
+      : CommitDeferringCondition(handle) {}
+  Result WillCommitNavigation(base::OnceClosure resume) override {
+    auto* contents = GetNavigationHandle().GetWebContents();
+    if (!IsPeekAuthSourceProtected(contents)) {
+      return Result::kProceed;
+    }
+    // Stop destroys this condition with its navigation. Do not access members
+    // after it; kCancelled tells the runner it was destroyed synchronously.
+    contents->Stop();
+    return Result::kCancelled;
+  }
+  const char* TraceEventName() const override {
+    return "ArciumPeekAuthCommitGuard";
+  }
+};
+
+class PeekAuthThrottle : public content::NavigationThrottle {
+ public:
+  explicit PeekAuthThrottle(content::NavigationThrottleRegistry& registry)
+      : NavigationThrottle(registry),
+        destination_(navigation_handle()->GetURL()) {
+    auto& state = State(navigation_handle()->GetWebContents());
+    bypass_ = state.bypass_url == destination_;
+    state.bypass_url = GURL();
+  }
+
+  ThrottleCheckResult WillStartRequest() override { return MaybeDivert(); }
+  ThrottleCheckResult WillRedirectRequest() override { return MaybeDivert(); }
+  ThrottleCheckResult WillProcessResponse() override {
+    return IsPeekAuthSourceProtected(navigation_handle()->GetWebContents())
+               ? CANCEL_AND_IGNORE
+               : PROCEED;
+  }
+  ThrottleCheckResult WillCommitWithoutUrlLoader() override {
+    return IsPeekAuthSourceProtected(navigation_handle()->GetWebContents())
+               ? CANCEL_AND_IGNORE
+               : PROCEED;
+  }
+  const char* GetNameForLogging() override { return "ArciumPeekAuthThrottle"; }
+
+ private:
+  ThrottleCheckResult MaybeDivert() {
+    auto* handle = navigation_handle();
+    auto* source = handle->GetWebContents();
+    auto& state = State(source);
+    // Frozen renderers can still have an already-issued navigation in flight.
+    // Protect the document at the browser boundary as well as pausing script.
+    if (state.protected_source) {
+      return CANCEL_AND_IGNORE;
+    }
+    if (bypass_ || handle->IsPost() || handle->IsFormSubmission() ||
+        handle->IsSameDocument() ||
+        (!IsPeekAuthURL(handle->GetURL()) &&
+         !IsSnowflakeRootAuthNavigation(*handle, destination_)) ||
+        !ControllerFor(source) || ControllerFor(source)->is_showing()) {
+      return PROCEED;
+    }
+    auto* profile = Profile::FromBrowserContext(source->GetBrowserContext());
+    if (!IsPeekEnabled(profile) ||
+        (!IsPeekAuthEnabledForSite(profile, source->GetLastCommittedURL()) &&
+         !IsPeekAuthEnabledForSite(profile, destination_))) {
+      return PROCEED;
+    }
+    // A cancelled login must not reopen on every timer or resume event.
+    // A new user gesture or a new document permits an explicit retry.
+    const auto document = source->GetPrimaryMainFrame()->GetWeakDocumentPtr();
+    if (state.attempted_document.AsRenderFrameHostIfValid() ==
+            document.AsRenderFrameHostIfValid() &&
+        handle->IsRendererInitiated() && !handle->HasUserGesture()) {
+      return CANCEL_AND_IGNORE;
+    }
+    document_ = document;
+    auto* view = source->GetRenderWidgetHostView();
+    if (view && view->IsSurfaceAvailableForCopy()) {
+      const auto size = view->GetViewBounds().size();
+      view->CopyFromSurface(
+          gfx::Rect(size),
+          gfx::ScaleToFlooredSize(size, view->GetDeviceScaleFactor()),
+          base::Milliseconds(250),
+          base::BindPostTaskToCurrentDefault(base::BindOnce(
+              [](base::WeakPtr<PeekAuthThrottle> self,
+                 const content::CopyFromSurfaceResult& result) {
+                if (self) {
+                  self->Open(
+                      result.has_value() && !result->bitmap.drawsNothing()
+                          ? gfx::ImageSkia::CreateFrom1xBitmap(result->bitmap)
+                          : gfx::ImageSkia());
+                }
+              },
+              weak_factory_.GetWeakPtr())));
+    } else {
+      base::SingleThreadTaskRunner::GetCurrentDefault()->PostTask(
+          FROM_HERE,
+          base::BindOnce(&PeekAuthThrottle::Open, weak_factory_.GetWeakPtr(),
+                         gfx::ImageSkia()));
+    }
+    return DEFER;
+  }
+
+  void Open(gfx::ImageSkia snapshot) {
+    auto* handle = navigation_handle();
+    auto* source = handle->GetWebContents();
+    auto* controller = ControllerFor(source);
+    if (!controller || controller->is_showing() ||
+        document_.AsRenderFrameHostIfValid() != source->GetPrimaryMainFrame()) {
+      Resume();
+      return;
+    }
+    auto params = content::NavigationController::LoadURLParams(
+        content::OpenURLParams::FromNavigationHandle(handle));
+    const GURL return_url =
+        handle->WasServerRedirect() && !IsPeekAuthURL(destination_) &&
+                destination_ != source->GetLastCommittedURL()
+            ? destination_
+            : GURL();
+    const auto self = weak_factory_.GetWeakPtr();
+    const auto source_weak = source->GetWeakPtr();
+    const bool shown =
+        controller->Show(std::move(params), source, true, snapshot);
+    if (!self) {
+      return;
+    }
+    if (!shown) {
+      Resume();
+      return;
+    }
+    if (source_weak) {
+      auto& state = State(source_weak.get());
+      state.attempted_document = document_;
+      state.return_url = return_url;
+    }
+    CancelDeferredNavigation(CANCEL_AND_IGNORE);
+  }
+
+  GURL destination_;
+  bool bypass_ = false;
+  content::WeakDocumentPtr document_;
+  base::WeakPtrFactory<PeekAuthThrottle> weak_factory_{this};
+};
+}  // namespace
+
+bool IsPeekAuthURL(const GURL& url) {
+  if (!url.SchemeIsHTTPOrHTTPS()) {
+    return false;
+  }
+  // Match complete endpoint segments, not arbitrary strings in a destination
+  // or return URL. A generic redirect or an off-site link is not a login.
+  const std::string path = base::ToLowerASCII(url.path());
+  for (const auto segment : base::SplitStringPiece(
+           path, "/", base::TRIM_WHITESPACE, base::SPLIT_WANT_NONEMPTY)) {
+    if (segment == "login" || segment == "signin" || segment == "sign-in" ||
+        segment == "sso" || segment == "saml" || segment == "saml2") {
+      return true;
+    }
+  }
+  std::string value;
+  if (net::GetValueForKeyInQuery(url, "SAMLRequest", &value) &&
+      !value.empty()) {
+    return true;
+  }
+  return base::EndsWith(path, "/authorize") &&
+         net::GetValueForKeyInQuery(url, "client_id", &value) &&
+         !value.empty() &&
+         net::GetValueForKeyInQuery(url, "response_type", &value) &&
+         !value.empty();
+}
+
+bool IsPeekAuthEnabledForSite(Profile* profile, const GURL& url) {
+  return profile && url.SchemeIsHTTPOrHTTPS() &&
+         profile->GetPrefs()
+             ->GetDict(prefs::kArciumPeekAuthSites)
+             .FindBool(url::Origin::Create(url).Serialize())
+             .value_or(false);
+}
+
+void SetPeekAuthEnabledForSite(Profile* profile,
+                               const GURL& url,
+                               bool enabled) {
+  if (!profile || !url.SchemeIsHTTPOrHTTPS()) {
+    return;
+  }
+  ScopedDictPrefUpdate update(profile->GetPrefs(), prefs::kArciumPeekAuthSites);
+  const std::string origin = url::Origin::Create(url).Serialize();
+  if (enabled) {
+    update->Set(origin, true);
+  } else {
+    update->Remove(origin);
+  }
+}
+
+void MaybeAddPeekAuthThrottle(content::NavigationThrottleRegistry& registry) {
+  auto& handle = registry.GetNavigationHandle();
+  auto* contents = handle.GetWebContents();
+  auto* profile = Profile::FromBrowserContext(contents->GetBrowserContext());
+  if (handle.IsInPrimaryMainFrame() &&
+      !tabs::TemporaryTab::IsTemporary(contents) &&
+      (IsPeekAuthSourceProtected(contents) ||
+       IsPeekAuthEnabledForSite(profile, contents->GetLastCommittedURL()) ||
+       IsPeekAuthEnabledForSite(profile, handle.GetURL()))) {
+    registry.AddThrottle(std::make_unique<PeekAuthThrottle>(registry));
+  }
+}
+
+std::unique_ptr<content::CommitDeferringCondition> CreatePeekAuthCommitGuard(
+    content::NavigationHandle& handle) {
+  if (!handle.IsInPrimaryMainFrame() ||
+      tabs::TemporaryTab::IsTemporary(handle.GetWebContents())) {
+    return nullptr;
+  }
+  auto* contents = handle.GetWebContents();
+  auto* profile = Profile::FromBrowserContext(contents->GetBrowserContext());
+  if (!IsPeekAuthSourceProtected(contents) &&
+      !IsPeekAuthEnabledForSite(profile, contents->GetLastCommittedURL()) &&
+      !IsPeekAuthEnabledForSite(profile, handle.GetURL())) {
+    return nullptr;
+  }
+  return std::make_unique<PeekAuthCommitGuard>(handle);
+}
+
+bool IsPeekAuthSourceProtected(content::WebContents* contents) {
+  const auto* state =
+      contents ? static_cast<AuthState*>(contents->GetUserData(&kAuthStateKey))
+               : nullptr;
+  return state && state->protected_source;
+}
+
+void SetPeekAuthSourceProtected(content::WebContents* contents, bool protect) {
+  State(contents).protected_source = protect;
+}
+
+void ClearPeekAuthRecovery(content::WebContents* contents) {
+  State(contents).return_url = GURL();
+}
+
+GURL TakePeekAuthRecovery(content::WebContents* contents) {
+  return std::exchange(State(contents).return_url, GURL());
+}
+
+void RecoverPeekAuthSource(content::WebContents* contents, const GURL& url) {
+  if (url.is_empty()) {
+    return;
+  }
+  State(contents).bypass_url = url;
+  contents->GetController().LoadURL(url, content::Referrer(),
+                                    ui::PAGE_TRANSITION_AUTO_TOPLEVEL,
+                                    std::string());
+}
+}  // namespace helium
