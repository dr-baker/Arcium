+TEST(SpaceContentAppearanceTest, SystemIgnoresWindowSchemeAndKeepsPalette) {
+  using ColorMode = ui::ColorProviderKey::ColorMode;
+  for (const auto system : {ColorMode::kLight, ColorMode::kDark}) {
+    for (const auto chrome : {ColorMode::kLight, ColorMode::kDark}) {
+      ui::ColorProviderKey window_key;
+      window_key.color_mode = chrome;
+      window_key.user_color = SK_ColorMAGENTA;
+      SpaceTheme theme;
+      theme.mode = chrome == ColorMode::kDark ? SpaceTheme::Mode::kDark
+                                              : SpaceTheme::Mode::kLight;
+      const auto resolved =
+          ResolveSpaceContentColorProviderKey(window_key, &theme, system);
+      EXPECT_EQ(system, resolved.color_mode);
+      EXPECT_EQ(window_key.user_color, resolved.user_color);
+      EXPECT_EQ(system,
+                ResolveSpaceContentColorProviderKey(window_key, nullptr, system)
+                    .color_mode);
+      for (const auto explicit_mode :
+           {SpaceTheme::Mode::kLight, SpaceTheme::Mode::kDark}) {
+        theme.web_mode = explicit_mode;
+        EXPECT_EQ(
+            explicit_mode == SpaceTheme::Mode::kDark ? ColorMode::kDark
+                                                     : ColorMode::kLight,
+            ResolveSpaceContentColorProviderKey(window_key, &theme, system)
+                .color_mode);
+      }
+    }
+  }
+}
+
+TEST(SpaceContentAppearanceTest, AccessibilityOverridesRetainWindowProvider) {
+  ui::ColorProviderKey key;
+  key.color_mode = ui::ColorProviderKey::ColorMode::kDark;
+  key.contrast_mode = ui::ColorProviderKey::ContrastMode::kHigh;
+  auto resolved = ResolveSpaceContentColorProviderKey(
+      key, nullptr, ui::ColorProviderKey::ColorMode::kLight);
+  EXPECT_FALSE(key < resolved);
+  EXPECT_FALSE(resolved < key);
+  key.contrast_mode = ui::ColorProviderKey::ContrastMode::kNormal;
+  key.forced_colors = ui::ColorProviderKey::ForcedColors::kSystem;
+  resolved = ResolveSpaceContentColorProviderKey(
+      key, nullptr, ui::ColorProviderKey::ColorMode::kLight);
+  EXPECT_FALSE(key < resolved);
+  EXPECT_FALSE(resolved < key);
+}
+
+namespace {
+class FixedChromeColorSource : public ui::ColorProviderSource {
+ public:
+  const ui::ColorProvider* GetColorProvider() const override {
+    return ui::ColorProviderManager::Get().GetColorProviderFor(
+        GetColorProviderKey());
+  }
+  ui::RendererColorMap GetRendererColorMap(
+      ui::ColorProviderKey::ColorMode mode,
+      ui::ColorProviderKey::ForcedColors forced) const override {
+    auto key = GetColorProviderKey();
+    key.color_mode = mode;
+    key.forced_colors = forced;
+    return ui::CreateRendererColorMap(
+        *ui::ColorProviderManager::Get().GetColorProviderFor(key));
+  }
+
+ protected:
+  ui::ColorProviderKey GetColorProviderKey() const override {
+    ui::ColorProviderKey key;
+    key.color_mode = ui::ColorProviderKey::ColorMode::kLight;
+    return key;
+  }
+};
+}  // namespace
+
+TEST_F(HeliumSpaceServiceTest, SystemContentUpdatesWithoutSpaceOrWindowTheme) {
+  ui::MockOsSettingsProvider os;
+  FixedChromeColorSource fixed_chrome;
+  auto* contents = AddOrdinaryTab("https://example.org/")->GetContents();
+  contents->SetColorProviderSource(&fixed_chrome);
+  os.SetPreferredColorScheme(ui::NativeTheme::PreferredColorScheme::kDark);
+  EXPECT_EQ(ui::ColorProviderKey::ColorMode::kLight, contents->GetColorMode());
+  EXPECT_EQ(ui::ColorProviderKey::ColorMode::kDark,
+            GetSpaceContentColorMode(contents));
+  EXPECT_EQ(ui::ColorProviderKey::ColorMode::kDark,
+            GetSpaceContentColorMode(nullptr));
+  os.SetPreferredColorScheme(ui::NativeTheme::PreferredColorScheme::kLight);
+  EXPECT_EQ(ui::ColorProviderKey::ColorMode::kLight,
+            GetSpaceContentColorMode(contents));
+  // Detach before the fixed source is destroyed; the live tab keeps its own
+  // default native provider and no dangling source observation.
+  contents->SetColorProviderSource(nullptr);
+}
+
 }  // namespace helium
