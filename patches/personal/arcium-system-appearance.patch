+ui::ColorProviderKey ResolveSpaceContentColorProviderKey(
+    ui::ColorProviderKey window_key,
+    const SpaceTheme* theme,
+    ui::ColorProviderKey::ColorMode system_mode) {
+  if (window_key.forced_colors != ui::ColorProviderKey::ForcedColors::kNone ||
+      window_key.contrast_mode == ui::ColorProviderKey::ContrastMode::kHigh) {
+    return window_key;
+  }
+  window_key.color_mode = system_mode;
+#if !BUILDFLAG(IS_ANDROID)
+  if (theme && theme->web_mode != SpaceTheme::Mode::kAuto) {
+    window_key.color_mode = theme->web_mode == SpaceTheme::Mode::kDark
+                                ? ui::ColorProviderKey::ColorMode::kDark
+                                : ui::ColorProviderKey::ColorMode::kLight;
+  }
+#endif
+  return window_key;
+}
