-  return contents->GetColorMode();
+  const auto system_key =
+      ui::NativeTheme::GetInstanceForWeb()->GetColorProviderKey(nullptr);
+#if !BUILDFLAG(IS_ANDROID)
+  if (contents &&
+      (Profile::FromBrowserContext(contents->GetBrowserContext())
+           ->IsOffTheRecord() ||
+       system_key.forced_colors != ui::ColorProviderKey::ForcedColors::kNone ||
+       system_key.contrast_mode == ui::ColorProviderKey::ContrastMode::kHigh)) {
+    return contents->GetColorMode();
+  }
+#endif
+  // A fresh profile or unattached WebContents may not have a Space/widget yet.
+  return system_key.color_mode;
 }
