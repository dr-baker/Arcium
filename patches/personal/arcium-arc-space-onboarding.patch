+// Copyright 2026 The Helium Authors
+// You can use, redistribute, and/or modify this source code under
+// the terms of the GPL-3.0 license that can be found in the LICENSE file.
+
+import { addWebUiListener, removeWebUiListener, sendWithPromise } from './cr';
+
+// chrome://setup side of ArcSpacesImportHandler. Every response and every
+// `arc-spaces-import-state-changed` event carries a complete ArcState, so the
+// page replaces its copy instead of assembling partial progress.
+
+export type ArcPhase =
+    'loading' | 'ready' | 'validating' | 'running' | 'finished' | 'failed';
+
+export type ArcJobState =
+    'pending' | 'creating_profile' | 'running' | 'succeeded' | 'empty' |
+    'failed' | 'cancelled';
+
+export interface ArcSpace {
+    /** Opaque; valid only for the inventory generation that produced it. */
+    token: string;
+    /** Stable opaque Space identity. Selections and results are keyed by it. */
+    identity: string;
+    /** Opaque source-profile key. Favorites count once per profile. */
+    profileToken: string;
+    name: string;
+    /** Explanatory only, never a selection key. */
+    profileLabel: string;
+    pins: number;
+    folders: number;
+    /** Profile-wide; imported once per selected source. */
+    favorites: number;
+    favoritesOnly: boolean;
+}
+
+export interface ArcJobCounts {
+    spaces: number;
+    pins: number;
+    folders: number;
+    favorites: number;
+}
+
+export interface ArcJob {
+    /** Unique within this page, across retries. */
+    id: number;
+    /** The selection tokens this job imports. */
+    tokens: string[];
+    profileLabel: string;
+    state: ArcJobState;
+    /** Stable machine code, empty on success. */
+    failure: string;
+    mayHavePartialData: boolean;
+    historyFinished: boolean;
+    counts: ArcJobCounts;
+}
+
+export interface ArcState {
+    generation: number;
+    batchId: number;
+    phase: ArcPhase;
+    failure: string;
+    spaces: ArcSpace[];
+    /** Session ledger, old attempts first; the latest job wins for a token. */
+    jobs: ArcJob[];
+    canOpen: boolean;
+}
+
+export interface ArcStartRequest {
+    generation: number;
+    tokens: string[];
+    /** Off unless the user turns it on. */
+    history: boolean;
+}
+
+/** Codes the handler rejects with. Runtime failures arrive in snapshots. */
+export type ArcRejection =
+    'invalid_arguments' | 'busy' | 'stale_selection' | 'nothing_selected' |
+    'stale_batch' | 'nothing_to_open';
+
+export interface ArcSpacesImportProxy {
+    initialize(): Promise<unknown>;
+    /** Ordered read-only snapshot; never rediscovers or cancels. */
+    getState(): Promise<unknown>;
+    start(request: ArcStartRequest): Promise<unknown>;
+    cancel(batchId: number): Promise<unknown>;
+    open(batchId: number): Promise<unknown>;
+    onStateChanged(callback: (state: unknown) => void): () => void;
+}
+
+export class ArcSpacesImportProxyImpl implements ArcSpacesImportProxy {
+    initialize() {
+        return sendWithPromise<unknown>('initializeArcSpacesImport');
+    }
+
+    getState() {
+        return sendWithPromise<unknown>('getArcSpacesImportState');
+    }
+
+    start(request: ArcStartRequest) {
+        return sendWithPromise<unknown>('startArcSpacesImport', request);
+    }
+
+    cancel(batchId: number) {
+        return sendWithPromise<unknown>('cancelArcSpacesImport', { batchId });
+    }
+
+    open(batchId: number) {
+        return sendWithPromise<unknown>('openArcImportedSpace', { batchId });
+    }
+
+    onStateChanged(callback: (state: unknown) => void) {
+        const listener = addWebUiListener('arc-spaces-import-state-changed', callback);
+        return () => {
+            removeWebUiListener(listener);
+        };
+    }
+
+    static getInstance(): ArcSpacesImportProxy {
+        return instance || (instance = new ArcSpacesImportProxyImpl());
+    }
+
+    static setInstance(obj: ArcSpacesImportProxy) {
+        instance = obj;
+    }
+}
+
+let instance: ArcSpacesImportProxy | null = null;
