+
+namespace arcium {
+// Lives on the UI sequence. The WebUI only renders Snapshot() and sends intent.
+class ArcSpacesImport {
+ public:
+  struct Entry {
+    std::string token, identity, profile_token, name, profile_label, source_key,
+        space_id;
+    user_data_importer::SourceProfile source;
+    base::FilePath sidebar_path;
+    std::string fingerprint;
+    std::string machine_id;
+    int pins = 0, folders = 0, favorites = 0;
+    bool favorites_only = false;
+  };
+  struct Group {
+    std::string source_key, profile_label;
+    user_data_importer::SourceProfile source;
+    base::FilePath sidebar_path;
+    std::string fingerprint;
+    std::string machine_id;
+    ArcSidebarSelection selection;
+    std::vector<std::string> tokens;
+  };
+  // Pure helpers used by focused unit tests. Nothing from these structures is
+  // sent to Javascript except Snapshot's explicitly allowlisted fields.
+  static std::optional<std::vector<Group>> GroupSelection(
+      const std::vector<Entry>& entries,
+      const std::vector<std::string>& tokens,
+      const std::set<std::string>& successful_tokens);
+  static bool ValidMapping(const base::DictValue& mapping,
+                           std::string_view source_key,
+                           std::string_view directory);
+
+  // Appearance is captured by the UI before asynchronous profile creation.
+  // This internal dictionary never comes from Javascript.
+  explicit ArcSpacesImport(base::RepeatingClosure changed,
+                           base::DictValue new_profile_appearance = {});
+  ~ArcSpacesImport();
+  ArcSpacesImport(const ArcSpacesImport&) = delete;
+  ArcSpacesImport& operator=(const ArcSpacesImport&) = delete;
+  bool busy() const;
+  void Discover();
+  std::string Start(int generation,
+                    std::vector<std::string> tokens,
+                    bool history = false);
+  std::string Cancel(int batch_id);
+  bool Open(int batch_id);
+  int batch_id() const { return batch_id_; }
+  void SetInventoryForTesting(std::vector<Entry> entries);
+  static bool SourcesUnchangedForTesting(std::vector<Group> groups,
+                                         std::string machine_id = {}) {
+    return SourcesUnchanged(std::move(groups), std::move(machine_id));
+  }
+  base::DictValue Snapshot() const;
+
+ private:
+  friend class ArcSpacesImportTestPeer;
+  friend class ArcSpacesImportBrowserTestPeer;
+
+  struct Inventory {
+    std::vector<Entry> entries;
+    std::string failure;
+  };
+  struct Result {
+    int id = 0;
+    std::string label, state = "pending", failure;
+    std::vector<std::string> tokens;
+    bool partial = false, history_finished = false;
+    ArcImportCoordinator::Counts counts;
+  };
+  struct SourceLease;
+  static Inventory ReadInventory(
+      std::vector<user_data_importer::SourceProfile> sources,
+      std::string nonce);
+  static bool SourcesUnchanged(std::vector<Group> groups,
+                               std::optional<std::string> machine_id_override);
+  static void DestinationInitialized(base::WeakPtr<ArcSpacesImport> owner,
+                                     std::shared_ptr<SourceLease> lease,
+                                     std::string source_key,
+                                     bool newly_created,
+                                     base::DictValue appearance,
+                                     Profile* profile);
+  void SourcesDetected(int generation);
+  void InventoryReady(int generation, Inventory inventory);
+  void Validated(int batch_id, bool unchanged);
+  void Next();
+  void DestinationReady(Profile* profile, std::string failure);
+  void CoordinatorChanged();
+  void CompleteCurrent(std::string state, std::string failure);
+  void Finish();
+  void Changed();
+
+  base::RepeatingClosure changed_;
+  const base::DictValue new_profile_appearance_;
+  std::unique_ptr<ImporterList> importer_list_;
+  int generation_ = 0, batch_id_ = 0, next_job_id_ = 0;
+  std::string phase_ = "ready", failure_;
+  std::optional<std::string> machine_id_for_testing_;
+  std::vector<Entry> entries_;
+  std::vector<Group> groups_;
+  std::vector<Result> results_, previous_results_;
+  size_t current_ = 0;
+  bool history_ = false, cancelled_ = false;
+  std::set<std::string> successful_tokens_, successful_favorite_sources_;
+  std::shared_ptr<SourceLease> source_lease_;
+  std::unique_ptr<ScopedProfileKeepAlive> keep_alive_;
+  std::unique_ptr<ArcImportCoordinator> coordinator_;
+  base::FilePath first_profile_path_;
+  std::string first_space_id_;
+  base::WeakPtrFactory<ArcSpacesImport> weak_factory_{this};
+};
+}  // namespace arcium
+#endif
