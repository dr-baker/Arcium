+  EXPECT_EQ("space-a", spaces[2]->id());
+  EXPECT_FALSE(service->GetSpaceById("space-m"));
+}
+
+IN_PROC_BROWSER_TEST_F(ArciumArcImportBrowserTest,
+                       FailedSelectedWriterDoesNotWriteBookmarksOrFavicons) {
+  auto* profile = browser()->profile();
+  ASSERT_TRUE(ImportArcSidebarSnapshot(profile, kSnapshot,
+                                       ArcSidebarDestination::kPins));
+  auto* bookmark_model = BookmarkModelFactory::GetForBrowserContext(profile);
+  bookmarks::test::WaitForBookmarkModelToLoad(bookmark_model);
+  const auto count_before =
+      bookmark_model->GetTotalNumberOfUrlsAndFoldersIncludingManagedNodes();
+  user_data_importer::ImportedBookmarkEntry entry;
+  entry.in_toolbar = true;
+  entry.is_folder = false;
+  entry.title = u"Unrequested bookmark";
+  entry.url = GURL("https://unrequested-bookmark.test/");
+  ArcSidebarSelection selection{.source_profile = "arc-profile",
+                                .space_ids = {"missing"}};
+  auto writer = base::MakeRefCounted<ProfileWriter>(
+      profile, ArcSidebarDestination::kPins, selection);
+  // Ordinary bookmarks arrive before the Arc snapshot in ChromeImporter.
+  writer->AddBookmarks({entry}, u"Imported");
+  const auto favicon = MakeImportedFavicon({GURL("https://root.test/")});
+  writer->AddFavicons({favicon});
+  EXPECT_FALSE(ReadImportedFavicon(profile, GURL("https://root.test/"))
+                   .is_valid());
+  writer->AddArcSidebarSnapshot(kSnapshot);
+  ASSERT_TRUE(writer->arc_sidebar_snapshot_received());
+  ASSERT_FALSE(writer->arc_sidebar_snapshot_import_succeeded());
+  writer->AddFavicons({favicon});
+  writer->AddBookmarks({entry}, u"Imported");
+  EXPECT_EQ(count_before,
+            bookmark_model->GetTotalNumberOfUrlsAndFoldersIncludingManagedNodes());
+  EXPECT_TRUE(bookmark_model->GetNodesByURL(entry.url).empty());
+  EXPECT_FALSE(ReadImportedFavicon(profile, GURL("https://root.test/"))
+                   .is_valid());
+}
+
+IN_PROC_BROWSER_TEST_F(ArciumArcImportBrowserTest,
+                       SelectedFaviconImportExcludesUnselectedSavedUrls) {
+  auto* profile = browser()->profile();
+  ASSERT_TRUE(ImportArcSidebarSnapshot(profile, kSnapshot,
+                                       ArcSidebarDestination::kPins));
+  auto* service = helium::HeliumSpaceServiceFactory::GetForProfile(profile);
+  ASSERT_TRUE(service->GetOrCreateSpaceReplacingPins(
+      "local-space", u"Local",
+      {Link("local-pin", u"Local", "https://local.test/")}));
+  service->ReconcileImportedPersistentItems(
+      "other-profile", {},
+      {{.id = "other-space", .name = u"Other",
+        .pins = {Link("other-pin", u"Other", "https://other.test/")}}});
+  // A previously cached icon belonging to another source must survive.
+  auto existing_icon = MakeImportedFavicon({GURL("https://other.test/")});
+  existing_icon.favicon_url = GURL("https://icon.test/existing.png");
+  auto legacy_writer = base::MakeRefCounted<ProfileWriter>(
+      profile, ArcSidebarDestination::kPins);
+  legacy_writer->AddFavicons({existing_icon});
+  ASSERT_TRUE(ReadImportedFavicon(profile, GURL("https://other.test/"))
+                  .is_valid());
+  ArcSidebarSelection selection{.source_profile = "arc-profile",
+                                .space_ids = {"space-a"},
+                                .include_favorites = false};
+  auto writer = base::MakeRefCounted<ProfileWriter>(
+      profile, ArcSidebarDestination::kPins, selection);
+  writer->AddArcSidebarSnapshot(kSnapshot);
+  ASSERT_TRUE(writer->arc_sidebar_snapshot_import_succeeded());
+  // One shared source bitmap deliberately mixes selected and excluded URLs.
+  // A whole-record filter would incorrectly import every mapping.
+  writer->AddFavicons({MakeImportedFavicon({
+      GURL("https://root.test/"), GURL("https://inner.test/"),
+      GURL("https://space-b.test/"), GURL("https://favorite.test/"),
+      GURL("https://local.test/"), GURL("https://other.test/")})});
+  for (const auto* url : {"https://root.test/", "https://inner.test/"}) {
+    EXPECT_TRUE(ReadImportedFavicon(profile, GURL(url)).is_valid()) << url;
+  }
+  for (const auto* url : {"https://space-b.test/", "https://favorite.test/",
+                          "https://local.test/"}) {
+    EXPECT_FALSE(ReadImportedFavicon(profile, GURL(url)).is_valid()) << url;
+  }
+  const auto preserved_icon =
+      ReadImportedFavicon(profile, GURL("https://other.test/"));
+  ASSERT_TRUE(preserved_icon.is_valid());
+  EXPECT_EQ(existing_icon.favicon_url, preserved_icon.icon_url);
+  // Filtering icons must not remove any existing unselected saved records.
+  ASSERT_TRUE(service->GetSpaceById("space-b"));
+  EXPECT_EQ(1u, service->GetSpaceById("space-b")->pins().size());
+  EXPECT_EQ(1u, service->GetFavoritesForSpace(
+      *service->GetSpaceById("space-b")).size());
+}
