+std::optional<std::vector<ArcSpacesImport::Group>>
+ArcSpacesImport::GroupSelection(
+    const std::vector<Entry>& entries,
+    const std::vector<std::string>& tokens,
+    const std::set<std::string>& successful_tokens) {
+  std::vector<Group> groups;
+  std::set<std::string> seen;
+  for (const auto& token : tokens) {
+    if (!seen.insert(token).second)
+      return std::nullopt;
+    auto entry = std::ranges::find(entries, token, &Entry::token);
+    if (entry == entries.end())
+      return std::nullopt;
+    if (successful_tokens.contains(token))
+      continue;
+    auto group =
+        std::ranges::find(groups, entry->source_key, &Group::source_key);
+    if (group == groups.end()) {
+      Group next;
+      next.source_key = entry->source_key;
+      next.profile_label = entry->profile_label;
+      next.source = entry->source;
+      next.sidebar_path = entry->sidebar_path;
+      next.fingerprint = entry->fingerprint;
+      next.machine_id = entry->machine_id;
+      next.selection.source_profile =
+          entry->source.source_path.BaseName().AsUTF8Unsafe();
+      groups.push_back(std::move(next));
+      group = std::prev(groups.end());
+    }
+    if (group->source.source_path != entry->source.source_path ||
+        group->sidebar_path != entry->sidebar_path ||
+        group->fingerprint != entry->fingerprint ||
+        group->machine_id != entry->machine_id)
+      return std::nullopt;
+    if (!entry->favorites_only)
+      group->selection.space_ids.insert(entry->space_id);
+    group->tokens.push_back(token);
+  }
+  return groups;
+}
+
+bool ArcSpacesImport::ValidMapping(const base::DictValue& mapping,
+                                   std::string_view source_key,
+                                   std::string_view directory) {
+  const base::FilePath component = base::FilePath::FromUTF8Unsafe(directory);
+  if (directory.empty() || component.IsAbsolute() ||
+      component.ReferencesParent() || component.BaseName() != component ||
+      component.value() == FILE_PATH_LITERAL("."))
+    return false;
+  const std::string* mapped = mapping.FindString(source_key);
+  if (!mapped || *mapped != directory)
+    return false;
+  for (const auto [key, value] : mapping) {
+    if (key != source_key && value.is_string() &&
+        value.GetString() == directory)
+      return false;
+  }
+  return true;
+}
