+// Arc does not report Space colors or icons to the page yet. Tiles get a
+// letter on one of a few quiet hues, picked from the name so it stays put
+// across visits. It is a placeholder, not Arc's color.
+
+const HUES = [330, 300, 265, 225, 190, 160, 45, 15] as const;
+
+export const monogram = (name: string): string =>
+    [...name.trim()][0]?.toLocaleUpperCase() ?? '';
+
+export const glyphHue = (name: string): number => {
+    let hash = 0x811c9dc5;
+    for (const unit of name) {
+        hash ^= unit.codePointAt(0)!;
+        hash = Math.imul(hash, 0x01000193) >>> 0;
+    }
+    return HUES[hash % HUES.length];
+};
