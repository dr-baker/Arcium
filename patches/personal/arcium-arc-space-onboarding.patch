+// Local stand-in for ArcSpacesImportHandler, for `vite dev` only.
+// chrome-send-polyfill loads this module inside its import.meta.env.DEV block,
+// so production builds never include it.
+
+import * as cr from '../cr';
+import type { ArcJob, ArcSpace, ArcState } from '../cr/arc_space_import_proxy';
+
+type Source = { label: string; favorites: number; spaces: [string, number, number][] };
+
+const SOURCES: Source[] = [
+    { label: 'Personal', favorites: 8, spaces: [
+        ['Personal', 18, 3], ['Research', 1, 0], ['Reading list', 9, 1],
+    ] },
+    { label: 'Work', favorites: 4, spaces: [
+        ['Work', 31, 6], ['Side project with a long name', 0, 0], ['Travel', 6, 2],
+    ] },
+    { label: 'School', favorites: 5, spaces: [] },
+];
+
+const state: ArcState = {
+    generation: 0, batchId: 0, phase: 'ready', failure: '', spaces: [], jobs: [], canOpen: false,
+};
+const sourceOf = new Map<string, string>();
+const succeeded = new Set<string>();
+let nextJobId = 1;
+let initCalls = 0;
+let failWorkOnce = true;
+let cancelled = false;
+
+const emit = () => cr.webUIListenerCallback('arc-spaces-import-state-changed', structuredClone(state));
+const later = (fn: () => void, ms = 450) => window.setTimeout(fn, ms);
+
+const discover = (mode: string) => {
+    state.generation++;
+    // A refresh clears the ledger but keeps the first imported Space for Open.
+    Object.assign(state, { phase: 'loading', failure: '', spaces: [], jobs: [] });
+    sourceOf.clear();
+    succeeded.clear();
+    emit();
+    later(() => {
+        if (mode === 'loadfail' && initCalls === 1) {
+            Object.assign(state, { phase: 'failed', failure: 'sidebar_unreadable' });
+        } else {
+            const spaces: ArcSpace[] = [];
+            for (const source of mode === 'none' ? [] : SOURCES) {
+                const add = (name: string, pins: number, folders: number, favoritesOnly: boolean) => {
+                    const token = `demo${state.generation}-${spaces.length}`;
+                    sourceOf.set(token, source.label);
+                    spaces.push({ token, identity: `${source.label}/${favoritesOnly ? 'f' : name}`,
+                        profileToken: source.label, name, profileLabel: source.label, pins, folders,
+                        favorites: source.favorites, favoritesOnly });
+                };
+                source.spaces.forEach(([name, pins, folders]) => add(name, pins, folders, false));
+                if (!source.spaces.length) {
+                    add('Favorites', 0, 0, true);
+                }
+            }
+            Object.assign(state, { phase: 'ready', spaces });
+        }
+        emit();
+    }, 600);
+};
+
+const run = (batch: ArcJob[], groups: [string, string[]][], index: number) => {
+    const job = batch[index];
+    if (!job || cancelled) {
+        batch.forEach(j => {
+            if (j.state === 'pending' || j.state === 'running' || j.state === 'creating_profile') {
+                j.state = 'cancelled';
+            }
+        });
+        state.phase = 'finished';
+        emit();
+        return;
+    }
+    job.state = 'creating_profile';
+    emit();
+    later(() => {
+        job.state = 'running';
+        emit();
+        later(() => {
+            const [label, tokens] = groups[index];
+            if (label === 'Work' && failWorkOnce) {
+                failWorkOnce = false;
+                Object.assign(job, { state: 'failed', failure: 'sidebar_not_saved', mayHavePartialData: true });
+            } else {
+                job.state = 'succeeded';
+                job.counts = { spaces: tokens.length, pins: 12, folders: 2, favorites: 4 };
+                tokens.forEach(token => succeeded.add(token));
+                state.canOpen = true;
+            }
+            emit();
+            run(batch, groups, index + 1);
+        }, 900);
+    });
+};
+
+export const handle = (msg: string, params: any[], mode: string) => {
+    const [id, args] = params;
+    const reply = (ok: boolean, value: unknown) => cr.webUIResponse(id, ok, value);
+    const busy = state.phase === 'validating' || state.phase === 'running';
+    if (msg === 'initializeArcSpacesImport') {
+        initCalls++;
+        if (mode === 'unreachable') {
+            return;
+        }
+        if (busy) {
+            reply(false, 'busy');
+            return;
+        }
+        discover(mode);
+        reply(true, structuredClone(state));
+    } else if (msg === 'getArcSpacesImportState') {
+        reply(true, structuredClone(state));
+    } else if (msg === 'startArcSpacesImport') {
+        if (busy || state.phase === 'loading') {
+            reply(false, 'busy');
+            return;
+        }
+        if (args.generation !== state.generation || args.tokens.some((t: string) => !sourceOf.has(t))) {
+            reply(false, 'stale_selection');
+            return;
+        }
+        const groups = new Map<string, string[]>();
+        for (const token of args.tokens as string[]) {
+            if (!succeeded.has(token)) {
+                const label = sourceOf.get(token)!;
+                groups.set(label, [...groups.get(label) ?? [], token]);
+            }
+        }
+        if (!groups.size) {
+            reply(false, 'nothing_selected');
+            return;
+        }
+        const ordered = [...groups];
+        if (mode === 'clean') {
+            failWorkOnce = false;
+        }
+        state.batchId++;
+        cancelled = false;
+        const batch = ordered.map(([label, tokens]): ArcJob => ({
+            id: nextJobId++, tokens, profileLabel: label, state: 'pending', failure: '',
+            mayHavePartialData: false, historyFinished: false,
+            counts: { spaces: 0, pins: 0, folders: 0, favorites: 0 },
+        }));
+        state.jobs.push(...batch);
+        Object.assign(state, { phase: 'validating', failure: '' });
+        emit();
+        reply(true, structuredClone(state));
+        later(() => {
+            state.phase = 'running';
+            run(batch, ordered, 0);
+        }, 300);
+    } else if (msg === 'cancelArcSpacesImport') {
+        if (args.batchId !== state.batchId) {
+            reply(false, 'stale_batch');
+            return;
+        }
+        cancelled = true;
+        reply(true, structuredClone(state));
+    } else if (msg === 'openArcImportedSpace') {
+        if (!state.canOpen || busy) {
+            reply(false, 'nothing_to_open');
+            return;
+        }
+        reply(true, true);
+        console.info('[arc fixture] would open the first imported Space');
+    }
+};
