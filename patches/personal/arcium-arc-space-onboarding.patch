+export const oneClickStatus = (model: Spaces.Model): { text: string; failed: boolean } => {
+    const view = Spaces.oneClickView(model);
+    switch (view.kind) {
+    case 'idle': return { text: s.welcome.arcBody, failed: false };
+    case 'finding': return { text: s.spaces.loading, failed: false };
+    case 'importing': return {
+        text: view.total
+            ? substituteLocalizedString(s.spaces.progress, { done: view.done, total: view.total })
+            : s.spaces.importing,
+        failed: false,
+    };
+    case 'done': return { text: plural(view.imported, s.spaces.doneOne, s.spaces.doneMany), failed: false };
+    case 'partial': return view.stopped
+        ? { text: s.spaces.stopped, failed: false }
+        : { text: plural(view.missed, s.welcome.missedOne, s.welcome.missedMany), failed: true };
+    }
+    switch (view.reason) {
+    case 'none': return { text: s.spaces.empty, failed: false };
+    case 'unreadable': return { text: s.spaces.loadFailed, failed: true };
+    case 'unreachable': return { text: s.spaces.unreachable, failed: true };
+    case 'changed': return { text: s.welcome.changed, failed: true };
+    case 'busy': return { text: s.spaces.noticeBusy, failed: true };
+    default: return { text: s.spaces.noticeError, failed: true };
+    }
+};
