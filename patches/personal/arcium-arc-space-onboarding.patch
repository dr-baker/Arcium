+
+TEST_F(OnboardingMessageHandlerTest, AllowedStringPreferenceRetainsTypeChecks) {
+  web_ui_.HandleReceivedMessage(
+      "setPref", base::ListValue().Append("callback")
+                     .Append("services.origin_override")
+                     .Append("https://example.com/"));
+  ASSERT_EQ(1u, web_ui_.call_data().size());
+  EXPECT_TRUE(web_ui_.call_data().back()->arg2()->GetBool());
+  EXPECT_EQ("https://example.com/",
+            profile_.GetPrefs()->GetString(prefs::kHeliumServicesOrigin));
+  web_ui_.ClearTrackedCalls();
+  web_ui_.HandleReceivedMessage(
+      "setPref", base::ListValue().Append("callback")
