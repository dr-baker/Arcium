+std::string Digest(std::string_view text) {
+  return base::HexEncode(base::SHA1HashString(text));
+}
+base::FilePath SidebarPath(const user_data_importer::SourceProfile& source) {
+  for (const auto& root : {source.source_path.DirName().DirName(),
+                           source.source_path.DirName(), source.source_path}) {
+    const auto path = root.AppendASCII("StorableSidebar.json");
+    if (base::PathExists(path))
+      return path;
+  }
+  return {};
+}
+std::optional<std::string> ReadStable(const base::FilePath& path) {
+  for (int attempt = 0; attempt < 2; ++attempt) {
+    base::File::Info before, after;
+    std::string bytes;
+    if (!path.empty() && base::GetFileInfo(path, &before) &&
+        base::ReadFileToStringWithMaxSize(path, &bytes, 64 * 1024 * 1024) &&
+        base::GetFileInfo(path, &after) && before.size == after.size &&
+        before.last_modified == after.last_modified)
+      return bytes;
+  }
+  return std::nullopt;
+}
+std::string SnapshotFingerprint(const ArcSidebarSnapshot& snapshot) {
+  std::string json;
+  if (!base::JSONWriter::Write(snapshot.ToDict(), &json))
+    return {};
+  return Digest(json);
+}
+void Count(const std::vector<ArcSidebarNode>& nodes, int& links, int& folders) {
+  for (const auto& node : nodes) {
+    if (node.type == ArcSidebarNode::Type::kFolder) {
+      ++folders;
+      Count(node.children, links, folders);
+    } else {
+      ++links;
+    }
+  }
+}
+base::DictValue CountsDict(const ArcImportCoordinator::Counts& counts) {
+  return base::DictValue()
+      .Set("spaces", counts.spaces)
+      .Set("pins", counts.pins)
+      .Set("folders", counts.folders)
+      .Set("favorites", counts.favorites);
+}
