+import assert from 'node:assert/strict';
+import {readFileSync} from 'node:fs';
+import {createRequire} from 'node:module';
+import test from 'node:test';
+import vm from 'node:vm';
+import * as stores from 'svelte/store';
+import {compile} from 'svelte/compiler';
+import * as S from '../src/lib/arc/spaces.ts';
+
+const require = createRequire(import.meta.url);
+const ts = require('typescript');
+const tick = () => new Promise(resolve => setImmediate(resolve));
+// Values created inside a vm context have that realm's prototypes.
+const plain = value => JSON.parse(JSON.stringify(value));
+const transpile = (source, stripImports = false) => {
+    if (stripImports) {
+        const parsed = ts.createSourceFile('x.ts', source, ts.ScriptTarget.Latest, true, ts.ScriptKind.TS);
+        source = ts.createPrinter().printFile(ts.factory.updateSourceFile(parsed,
+            parsed.statements.filter(statement => !ts.isImportDeclaration(statement))));
+    }
+    return ts.transpileModule(source, {
+        compilerOptions: {target: ts.ScriptTarget.ES2022, module: ts.ModuleKind.CommonJS},
+    }).outputText;
+};
+const script = file => readFileSync(file, 'utf8').match(/<script lang="ts">([\s\S]*?)<\/script>/)[1];
+const style = file => readFileSync(file, 'utf8').match(/<style>([\s\S]*?)<\/style>/)[1];
+
+// ---- Fixtures -----------------------------------------------------------------
+
+const space = (token, label, name = token, extra = {}) => ({
+    token, identity: `id:${label}:${name}`, profileToken: `p:${label}`, name, profileLabel: label,
+    pins: 3, folders: 0, favorites: 4, favoritesOnly: false, ...extra,
+});
+const job = (id, label, state = 'pending', extra = {}) => ({
+    id, tokens: [], profileLabel: label, state, failure: '', mayHavePartialData: false, historyFinished: false,
+    counts: {spaces: 0, pins: 0, folders: 0, favorites: 0}, ...extra,
+});
+const spacesFor = (g = 1) => [
+    space(`g${g}-a1`, 'Personal', 'Home'),
+    space(`g${g}-a2`, 'Personal', 'Reading'),
+    space(`g${g}-b1`, 'Work', 'Work'),
+    space(`g${g}-f`, 'School', 'Favorites', {favoritesOnly: true, pins: 0, favorites: 5}),
+];
+const snap = (extra = {}) => ({
+    generation: 1, batchId: 0, phase: 'ready', failure: '', spaces: spacesFor(1), jobs: [], canOpen: false,
+    ...extra,
+});
+const apply = (model, raw) => S.applySnapshot(model, S.parseState(raw));
+const ready = (extra) => apply(S.initialModel(), snap(extra));
+const keyOf = (model, token) => S.entries(model).find(e => e.space.token === token).key;
+const outcomeOf = (model, token) => plain(S.outcomes(model).get(keyOf(model, token)) ?? {status: 'idle'});
+const statusOf = (model, token) => outcomeOf(model, token).status;
+/** One job per source, as the handler groups them. Ids continue the ledger after `base`. */
+const withTokens = (request, base = 0) => [
+    job(base + 1, 'Personal', 'pending', {tokens: request.tokens.filter(t => t.includes('-a'))}),
+    job(base + 2, 'Work', 'pending', {tokens: request.tokens.filter(t => t.includes('-b'))}),
+    job(base + 3, 'School', 'pending', {tokens: request.tokens.filter(t => t.endsWith('-f'))}),
+].filter(j => j.tokens.length);
+/** Starts a batch for the current selection and adopts batch `id`; new jobs append to the ledger. */
+const begin = (model, id = model.snapshot.batchId + 1, jobsFor = null) => {
+    const request = S.buildStart(model);
+    model = S.markStarting(model, request);
+    const ledger = model.snapshot.jobs.map(plain);
+    const base = Math.max(0, ...ledger.map(j => j.id));
+    return {request, model: apply(model, {...plain(model.snapshot), batchId: id, phase: 'validating',
+        jobs: [...ledger, ...(jobsFor ? jobsFor(request, base) : [])]})};
+};
+const finish = (model, edit, extra = {}) => {
+    const jobs = model.snapshot.jobs.map(plain);
+    edit(jobs);
+    return apply(model, {...plain(model.snapshot), phase: 'finished', jobs, ...extra});
+};
+
+// ---- Parsing ------------------------------------------------------------------
+
+test('parseState rejects snapshots that break the contract and never reads an unknown job state as success', () => {
+    const {identity: _i, ...noIdentity} = space('n', 'P');
+    const {profileToken: _p, ...noProfile} = space('n', 'P');
+    const {tokens: _t, ...noTokens} = job(1, 'P');
+    for (const bad of [null, [], {}, snap({phase: 'done'}), snap({generation: -1}), snap({spaces: {}}),
+        snap({jobs: null}), snap({batchId: 1.5}), snap({spaces: [noIdentity]}), snap({spaces: [noProfile]}),
+        snap({spaces: [space('t', 'P', 'A'), space('t', 'P', 'B')]}),
+        snap({spaces: [space('t', 'P', 'A'), space('u', 'P', 'A')]}),
+        snap({spaces: [{name: 'no token'}]}), snap({spaces: [space('x'.repeat(257), 'P')]}),
+        snap({jobs: [noTokens]}), snap({jobs: [job(1, 'P', 'running', {tokens: ['t', 7]})]})]) {
+        assert.equal(S.parseState(bad), null);
+    }
+    const parsed = S.parseState(snap({
+        spaces: [space('t', 'P', '  Name  '), space('u', 'P', 'x'.repeat(200), {pins: -4, favoritesOnly: 'yes'})],
+        jobs: [job(1, 'P', 'teleporting', {failure: 'none'}), job(2, 'P', 'failed', {failure: '<b>'}),
+            job(3, 'P', 'running', {tokens: ['t']})],
+        canOpen: 'true',
+    }));
+    assert.deepEqual(parsed.spaces.map(s => [s.token, s.identity, s.profileToken]),
+        [['t', 'id:P:  Name  ', 'p:P'], ['u', `id:P:${'x'.repeat(200)}`, 'p:P']]);
+    assert.equal(parsed.spaces[0].name, 'Name');
+    assert.equal(parsed.spaces[1].name.length, 120);
+    assert.equal(parsed.spaces[1].pins, 0);
+    assert.equal(parsed.spaces[1].favoritesOnly, false);
+    assert.deepEqual(parsed.jobs.map(j => [j.state, j.failure]),
+        [['failed', 'unknown'], ['failed', ''], ['running', '']]);
+    assert.deepEqual(parsed.jobs[2].tokens, ['t']);
+    assert.equal(parsed.canOpen, false);
+    assert.equal(S.parseRejection('stale_selection'), 'stale_selection');
+    assert.equal(S.parseRejection(new Error('x')), 'unknown');
+});
+
+// ---- Loading and selection ------------------------------------------------------
+
+test('loading, failure, unreachable, and empty states are distinct; only a usable inventory seeds', () => {
+    let model = S.initialModel();
+    assert.equal(S.load(model), 'loading');
+    assert.deepEqual(S.action(model), {kind: 'skip'});
+    model = apply(model, snap({phase: 'loading', spaces: []}));
+    assert.equal(S.load(model), 'loading');
+    assert.equal(apply(S.initialModel(), snap({generation: 0, spaces: []})).seeded, false,
+        'generation 0 is a handler that has not discovered yet');
+    assert.equal(S.load(apply(model, snap({phase: 'failed', failure: 'sidebar_unreadable', spaces: []}))), 'failed');
+    assert.equal(S.load(apply(model, snap({spaces: []}))), 'ready');
+    assert.equal(S.entries(apply(model, snap({spaces: []}))).length, 0);
+    assert.equal(S.load(S.markUnreachable(model)), 'unreachable');
+    assert.deepEqual(S.action(S.markUnreachable(model)), {kind: 'skip'});
+    assert.equal(S.load(apply(S.markUnreachable(model), snap())), 'ready', 'a later snapshot recovers');
+});
+
+test('first inventory selects every entry, including Favorites-only; Select all and Clear cover them', () => {
+    let model = ready();
+    assert.equal(S.selectedCount(model), 4);
+    assert.equal(S.allSelected(model), true);
+    assert.deepEqual(S.entries(model).map(e => e.key), spacesFor(1).map(s => s.identity), 'keys are identities');
+    model = S.setAll(model, false);
+    assert.equal(S.selectedCount(model), 0);
+    assert.deepEqual(S.action(model), {kind: 'skip'});
+    model = S.toggle(model, keyOf(model, 'g1-f'));
+    assert.deepEqual(S.action(model), {kind: 'import', spaces: 0}, 'Favorites-only is not counted as a Space');
+    model = S.setAll(model, true);
+    assert.deepEqual(S.action(model), {kind: 'import', spaces: 3});
+    assert.equal(S.favoritesIncluded(model), true);
+    assert.equal(S.multipleSources(model), true);
+    assert.equal(S.multipleSources(ready({spaces: [space('a', 'Same', 'A'), space('b', 'Same', 'B',
+        {profileToken: 'p:other'})]})), true, 'sources are told apart by profileToken, not label');
+});
+
+test('selection follows identity through renames and reordering; vanished Spaces drop out', () => {
+    let model = S.toggle(ready(), 'id:Personal:Reading');
+    model = apply(model, snap({generation: 2, spaces: [
+        space('g2-f', 'School', 'Favorites', {favoritesOnly: true, pins: 0, favorites: 5}),
+        space('g2-a2', 'Personal', 'Reading later', {identity: 'id:Personal:Reading'}),
+        space('g2-a1', 'Personal', 'Home base', {identity: 'id:Personal:Home'}),
+    ]}));
+    assert.deepEqual(S.buildStart(model), {generation: 2, tokens: ['g2-f', 'g2-a1'], history: false},
+        'tokens come from the new inventory, in its order, for exactly the chosen identities');
+    assert.deepEqual([...model.selected].sort(), ['id:Personal:Home', 'id:School:Favorites']);
+});
+
+test('duplicate names stay exact through reorder; an old success never locks a different Space', () => {
+    const home = (token, n) => space(token, 'Arc', 'Home', {identity: `home-${n}`});
+    let model = ready({spaces: [home('a', 1), home('b', 2), home('c', 3)]});
+    model = S.toggle(S.toggle(model, 'home-1'), 'home-3');
+    assert.deepEqual(S.buildStart(model).tokens, ['b']);
+    let {model: run} = begin(model, 1, (r, base) => [job(base + 1, 'Arc', 'pending', {tokens: r.tokens})]);
+    run = finish(run, jobs => { jobs[0].state = 'succeeded'; });
+    assert.equal(statusOf(run, 'b'), 'succeeded');
+    assert.equal(statusOf(run, 'a'), 'idle');
+
+    // Reordered; home-2 moved last and a new same-named Space appeared.
+    run = apply(run, snap({generation: 2, spaces: [home('x', 3), home('y', 4), home('z', 2)]}));
+    assert.equal(statusOf(run, 'z'), 'succeeded', 'the success stays with its identity, not its position');
+    assert.equal(statusOf(run, 'x'), 'idle');
+    assert.equal(statusOf(run, 'y'), 'idle', 'a new Space with the same name is not locked');
+    assert.equal(S.selectedCount(run), 0);
+    run = S.toggle(run, 'home-4');
+    assert.deepEqual(S.buildStart(run).tokens, ['y']);
+
+    // home-2 vanished; a Space with its name and source takes its place.
+    run = apply(run, snap({generation: 3, spaces: [home('p', 1), home('q', 5)]}));
+    assert.deepEqual(S.selectable(run).map(e => e.key), ['home-1', 'home-5']);
+    assert.equal(S.summarize(run).imported, 0, 'nothing in this inventory was imported');
+});
+
+test('History is opt-in per request: off on visit, selection change, new inventory, and after a start', () => {
+    let model = ready();
+    assert.equal(model.history, false);
+    assert.deepEqual(S.buildStart(model), {generation: 1, tokens: ['g1-a1', 'g1-a2', 'g1-b1', 'g1-f'], history: false});
+    model = S.setHistory(model, true);
+    assert.equal(S.buildStart(model).history, true);
+    assert.deepEqual(Object.keys(S.buildStart(model)).sort(), ['generation', 'history', 'tokens']);
+    assert.equal(S.toggle(model, 'id:Work:Work').history, false, 'changing the selection clears it');
+    assert.equal(S.setAll(model, false).history, false);
+    assert.equal(S.visit(model).history, false, 'every visit starts off');
+    assert.equal(apply(model, snap({generation: 2, spaces: spacesFor(2)})).history, false, 'a new inventory clears it');
+
+    let {model: running, request} = begin(model, 1, withTokens);
+    assert.equal(request.history, true);
+    assert.equal(running.history, false, 'the request spent the opt-in');
+    assert.equal(S.historyShown(running), true, 'the disabled toggle still shows what was sent');
+    assert.equal(S.setHistory(running, true), running);
+    running = finish(running, jobs => {
+        jobs[0].state = 'succeeded';
+        Object.assign(jobs[1], {state: 'failed', failure: 'history_incomplete'});
+        jobs[2].state = 'succeeded';
+    });
+    assert.deepEqual(S.action(running), {kind: 'retry'});
+    assert.equal(S.historyShown(running), false);
+    assert.equal(S.buildStart(running).history, false, 'a retry never repeats History on its own');
