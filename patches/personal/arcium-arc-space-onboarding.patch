+  base::ListValue containers;
+  containers.Append(base::DictValue().Set(
+      "littleBrowser", base::DictValue().Set("_0", "synthetic-window")));
+  containers.Append(std::move(transient));
+  containers.Append(base::DictValue().Set("global", base::DictValue()));
+  containers.Append(base::DictValue()
+                        .Set("items", base::ListValue())
+                        .Set("spaces", base::ListValue())
+                        .Set("topAppsContainerIDs", base::ListValue()));
+  root->FindDict("sidebar")->Set("containers", std::move(containers));
+  std::optional<ArcSidebarSnapshot> snapshot =
+      ParseArcSidebarSnapshot(*root, kProfile);
+  ASSERT_TRUE(snapshot);
+  EXPECT_TRUE(snapshot->favorites.empty());
+  EXPECT_TRUE(snapshot->spaces.empty());
+}
+
+TEST(ArcSidebarSnapshotTest, PreservesFlatCustomProfileAssociation) {
+  std::optional<base::DictValue> root = ParseFixture();
+  ASSERT_TRUE(root);
+  std::optional<ArcSidebarSnapshot> expected =
+      ParseArcSidebarSnapshot(*root, kProfile);
+  ASSERT_TRUE(expected);
+  base::DictValue& data =
+      (*root->FindDict("sidebar")->FindList("containers"))[1].GetDict();
+  auto unwrap = [](base::DictValue* profile) {
+    base::DictValue* custom = profile ? profile->FindDict("custom") : nullptr;
+    const base::DictValue* payload = custom ? custom->FindDict("_0") : nullptr;
+    if (payload) {
+      profile->Set("custom", payload->Clone());
+    }
+  };
+  for (base::Value& value : *data.FindList("spaces")) {
+    if (base::DictValue* space = value.GetIfDict()) {
+      unwrap(space->FindDict("profile"));
+    }
+  }
+  for (base::Value& value : *data.FindList("topAppsContainerIDs")) {
+    unwrap(value.GetIfDict());
+  }
+  std::optional<ArcSidebarSnapshot> snapshot =
+      ParseArcSidebarSnapshot(*root, kProfile);
+  ASSERT_TRUE(snapshot);
+  EXPECT_EQ(expected->ToDict(), snapshot->ToDict());
+}
+
+
+base::DictValue& FixtureSidebarData(base::DictValue& root) {
+  return (*root.FindDict("sidebar")->FindList("containers"))[1].GetDict();
+}
+
+base::DictValue CustomIdentity(std::string_view machine_id) {
+  return base::DictValue().Set(
+      "custom", base::DictValue().Set(
+                    "_0", base::DictValue()
+                              .Set("directoryBasename", std::string(kProfile))
+                              .Set("machineID", std::string(machine_id))));
+}
+
+void SetFixtureMachine(base::DictValue& root, std::string_view machine_id) {
+  auto set = [&](base::DictValue* profile) {
+    auto* custom = profile ? profile->FindDict("custom") : nullptr;
+    if (!custom) {
+      return;
+    }
+    auto* payload = custom->FindDict("_0");
+    if (!payload) {
+      payload = custom;
+    }
+    payload->Set("machineID", std::string(machine_id));
+  };
+  auto& data = FixtureSidebarData(root);
+  for (auto& value : *data.FindList("spaces")) {
+    if (auto* space = value.GetIfDict()) {
+      set(space->FindDict("profile"));
+    }
+  }
+  for (auto& value : *data.FindList("topAppsContainerIDs")) {
+    set(value.GetIfDict());
+  }
+}
+
+TEST(ArcSidebarSnapshotTest, MatchesSpaceAndFavoritesByLocalFullIdentity) {
+  auto root = ParseFixture();
+  ASSERT_TRUE(root);
+  const auto legacy = ParseArcSidebarSnapshot(*root, kProfile);
+  ASSERT_TRUE(legacy);
+  SetFixtureMachine(*root, "local-machine");
+  auto& data = FixtureSidebarData(*root);
+  // Synced data can reuse a basename for an unrelated machine. Neither its
+  // Favorites nor its Space is part of this local profile's saved sidebar.
+  auto* top_apps = data.FindList("topAppsContainerIDs");
+  top_apps->Append(CustomIdentity("foreign-machine"));
+  top_apps->Append("other-favorites");
+  auto* spaces = data.FindList("spaces");
+  spaces->Append("foreign-space");
+  spaces->Append(base::DictValue()
+      .Set("title", "Foreign")
+      .Set("profile", CustomIdentity("foreign-machine"))
+      .Set("containerIDs", base::ListValue()
+                               .Append("pinned")
+                               .Append("other-space-pins")));
+  auto local = ParseArcSidebarSnapshot(*root, kProfile, "local-machine");
+  ASSERT_TRUE(local);
+  EXPECT_EQ(legacy->ToDict(), local->ToDict());
+  EXPECT_EQ(2u, local->favorites.size());
+  EXPECT_EQ(2u, local->spaces.size());
+  // A different explicitly selected machine resolves its own exact collection;
+  // it must never be silently merged with the local machine's records.
+  auto foreign = ParseArcSidebarSnapshot(*root, kProfile, "foreign-machine");
+  ASSERT_TRUE(foreign);
+  ASSERT_EQ(1u, foreign->favorites.size());
+  EXPECT_EQ("other-favorite", foreign->favorites[0].source_id);
+  ASSERT_EQ(1u, foreign->spaces.size());
+  EXPECT_EQ("foreign-space", foreign->spaces[0].id);
+}
+
+TEST(ArcSidebarSnapshotTest, ForeignFavoritesOnlyDoesNotAttachToLocalBasename) {
+  auto root = ParseFixture();
+  ASSERT_TRUE(root);
+  SetFixtureMachine(*root, "foreign-machine");
+  FixtureSidebarData(*root).Set("spaces", base::ListValue());
+  EXPECT_FALSE(ParseArcSidebarSnapshot(*root, kProfile, "local-machine"));
+  EXPECT_FALSE(ParseArcSidebarSnapshot(*root, kProfile));
+  auto snapshot =
+      ParseArcSidebarSnapshot(*root, kProfile, "foreign-machine");
+  ASSERT_TRUE(snapshot);
+  EXPECT_TRUE(snapshot->spaces.empty());
+  EXPECT_EQ(2u, snapshot->favorites.size());
+}
+
+TEST(ArcSidebarSnapshotTest, LocalFavoritesOnlyHasNoSpaceRequirement) {
+  auto root = ParseFixture();
+  ASSERT_TRUE(root);
+  SetFixtureMachine(*root, "local-machine");
+  FixtureSidebarData(*root).Set("spaces", base::ListValue());
+  auto snapshot = ParseArcSidebarSnapshot(*root, kProfile, "local-machine");
+  ASSERT_TRUE(snapshot);
+  EXPECT_TRUE(snapshot->spaces.empty());
+  EXPECT_EQ(2u, snapshot->favorites.size());
+}
+
+TEST(ArcSidebarSnapshotTest, MissingMachineMetadataRejectsExplicitCustomOnly) {
+  auto root = ParseFixture();
+  ASSERT_TRUE(root);
+  SetFixtureMachine(*root, "local-machine");
+  EXPECT_FALSE(ParseArcSidebarSnapshot(*root, kProfile));
+  EXPECT_FALSE(ParseArcSidebarSnapshot(*root, kProfile, "unrelated-machine"));
+  // One affected custom identity must not block explicit Default.
+  auto defaults = ParseArcSidebarSnapshot(*root, "Default");
+  ASSERT_TRUE(defaults);
+  EXPECT_EQ(1u, defaults->spaces.size());
+  EXPECT_EQ(1u, defaults->favorites.size());
+  // Nor should it stop a deliberate empty-source refresh of another profile.
+  auto absent = ParseArcSidebarSnapshot(*root, "Absent Profile");
+  ASSERT_TRUE(absent);
+  EXPECT_TRUE(absent->spaces.empty());
+  EXPECT_TRUE(absent->favorites.empty());
+}
+
+TEST(ArcSidebarSnapshotTest, MissingMachineMetadataDoesNotGuessFavoritesOnly) {
+  auto root = ParseFixture();
+  ASSERT_TRUE(root);
+  SetFixtureMachine(*root, "first-machine");
+  auto& data = FixtureSidebarData(*root);
+  data.Set("spaces", base::ListValue());
+  auto* top_apps = data.FindList("topAppsContainerIDs");
+  top_apps->Append(CustomIdentity("second-machine"));
+  top_apps->Append("other-favorites");
+  EXPECT_FALSE(ParseArcSidebarSnapshot(*root, kProfile));
+}
+
+TEST(ArcSidebarSnapshotTest, LegacyCustomRemainsSupportedWithLocalMetadata) {
+  auto root = ParseFixture();
+  ASSERT_TRUE(root);
+  const auto expected = ParseArcSidebarSnapshot(*root, kProfile);
+  ASSERT_TRUE(expected);
+  const auto snapshot =
+      ParseArcSidebarSnapshot(*root, kProfile, "local-machine");
+  ASSERT_TRUE(snapshot);
+  EXPECT_EQ(expected->ToDict(), snapshot->ToDict());
+}
+
+TEST(ArcSidebarSnapshotTest, RejectsMixedLegacyAndExplicitCustomIdentity) {
+  auto root = ParseFixture();
+  ASSERT_TRUE(root);
+  // Spaces are legacy, while Favorites now assert a specific machine. It is
+  // unsafe to infer whether the legacy Space is attached to that machine.
+  auto& top_apps = *FixtureSidebarData(*root).FindList("topAppsContainerIDs");
+  top_apps[2] = base::Value(CustomIdentity("local-machine"));
+  EXPECT_FALSE(ParseArcSidebarSnapshot(*root, kProfile));
+  EXPECT_FALSE(ParseArcSidebarSnapshot(*root, kProfile, "local-machine"));
+}
+
 }  // namespace
 }  // namespace arcium
