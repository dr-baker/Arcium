+namespace arcium {
+
+// Control only asynchronous delivery, without browser discovery, filesystem
+// profile creation, or opening the saved Finish destination in these tests.
+class ArcSpacesImportTestPeer {
+ public:
+  static void BeginLoading(ArcSpacesImport& importer) {
+    ++importer.generation_;
+    importer.phase_ = "loading";
+    importer.entries_.clear();
+    importer.importer_list_ = std::make_unique<ImporterList>();
+  }
+
+  static base::OnceClosure DiscoveryReply(ArcSpacesImport& importer) {
+    return base::BindOnce(&ArcSpacesImport::SourcesDetected,
+                          importer.weak_factory_.GetWeakPtr(),
+                          importer.generation_);
+  }
+
+  static base::OnceClosure InventoryReply(ArcSpacesImport& importer,
+                                          ArcSpacesImport::Entry entry) {
+    ArcSpacesImport::Inventory inventory;
+    inventory.entries.push_back(std::move(entry));
+    return base::BindOnce(&ArcSpacesImport::InventoryReady,
+                          importer.weak_factory_.GetWeakPtr(),
+                          importer.generation_, std::move(inventory));
+  }
+
+  static bool HasDiscovery(const ArcSpacesImport& importer) {
+    return !!importer.importer_list_;
+  }
+
+  static void SetFinishDestination(ArcSpacesImport& importer) {
+    importer.first_profile_path_ =
+        base::FilePath(FILE_PATH_LITERAL("/fixture/Profile 1"));
+    importer.first_space_id_ = "previously-imported-space";
+  }
+
+  static bool FinishDestinationPreserved(const ArcSpacesImport& importer) {
+    return importer.first_profile_path_ ==
+               base::FilePath(FILE_PATH_LITERAL("/fixture/Profile 1")) &&
+           importer.first_space_id_ == "previously-imported-space";
+  }
+};
+
+namespace {
+ArcSpacesImport::Entry Entry(std::string token,
+                             std::string source,
+                             std::string space) {
+  ArcSpacesImport::Entry entry;
+  entry.token = std::move(token);
+  entry.source_key = source;
+  entry.space_id = std::move(space);
+  // Identical display labels are deliberate. Never group by a display label.
+  entry.profile_label = "Personal";
+  entry.source.importer_type = user_data_importer::TYPE_ARC;
+  entry.source.source_path =
+      base::FilePath(FILE_PATH_LITERAL("/fixture/Arc/User Data"))
+          .AppendASCII(source);
+  entry.sidebar_path =
+      base::FilePath(FILE_PATH_LITERAL("/fixture/Arc/StorableSidebar.json"));
+  entry.fingerprint = "same immutable read";
+  return entry;
+}
+TEST(ArcSpacesImportPlanTest, GroupsByIdentityAndImportsFavoritesOnce) {
+  auto a = Entry("opaque-a", "Default", "space-a");
+  auto b = Entry("opaque-b", "Default", "space-b");
+  auto c = Entry("opaque-c", "Profile 1", "space-c");
+  auto groups = ArcSpacesImport::GroupSelection(
+      {a, b, c}, {a.token, c.token, b.token}, {});
+  ASSERT_TRUE(groups);
+  ASSERT_EQ(groups->size(), 2u);
+  EXPECT_EQ(groups->at(0).selection.space_ids,
+            (std::set<std::string>{"space-a", "space-b"}));
+  EXPECT_EQ(groups->at(0).selection.source_profile, "Default");
+  EXPECT_EQ(groups->at(1).selection.source_profile, "Profile 1");
+  EXPECT_TRUE(groups->at(0).selection.include_favorites);
+  EXPECT_TRUE(groups->at(1).selection.include_favorites);
+}
+TEST(ArcSpacesImportPlanTest, FavoritesOnlyIsSelectableWithoutInventedSpaceId) {
+  auto favorite = Entry("opaque-f", "Profile 2", "");
+  favorite.favorites_only = true;
+  favorite.favorites = 4;
+  auto groups =
+      ArcSpacesImport::GroupSelection({favorite}, {favorite.token}, {});
+  ASSERT_TRUE(groups);
+  ASSERT_EQ(groups->size(), 1u);
+  EXPECT_TRUE(groups->front().selection.space_ids.empty());
+  EXPECT_TRUE(groups->front().selection.include_favorites);
+}
+TEST(ArcSpacesImportPlanTest,
+     RejectsStaleAndDuplicateTokensWithoutPartialPlan) {
+  auto a = Entry("opaque-a", "Default", "space-a");
+  EXPECT_FALSE(
+      ArcSpacesImport::GroupSelection({a}, {a.token, "old-generation"}, {}));
+  EXPECT_FALSE(ArcSpacesImport::GroupSelection({a}, {a.token, a.token}, {}));
+}
+TEST(ArcSpacesImportPlanTest, RetryOmitsAlreadySuccessfulSelections) {
+  auto a = Entry("opaque-a", "Default", "space-a");
+  auto b = Entry("opaque-b", "Default", "space-b");
+  auto groups =
+      ArcSpacesImport::GroupSelection({a, b}, {a.token, b.token}, {a.token});
+  ASSERT_TRUE(groups);
+  ASSERT_EQ(groups->size(), 1u);
+  EXPECT_EQ(groups->front().selection.space_ids,
+            (std::set<std::string>{"space-b"}));
+}
+TEST(ArcSpacesImportPlanTest, MappingCannotAliasTwoSourcesOrEscapeUserDataDir) {
+  base::DictValue mapping;
+  mapping.Set("source-a", "Profile 3");
+  EXPECT_TRUE(ArcSpacesImport::ValidMapping(mapping, "source-a", "Profile 3"));
+  EXPECT_FALSE(ArcSpacesImport::ValidMapping(mapping, "source-b", "Profile 3"));
+  mapping.Set("source-b", "Profile 3");
+  EXPECT_FALSE(ArcSpacesImport::ValidMapping(mapping, "source-a", "Profile 3"));
+  mapping.Set("source-a", "../other");
+  EXPECT_FALSE(ArcSpacesImport::ValidMapping(mapping, "source-a", "../other"));
+  mapping.Set("source-a", "/outside");
+  EXPECT_FALSE(ArcSpacesImport::ValidMapping(mapping, "source-a", "/outside"));
+}
+class ArcSpacesImportLifecycleTest : public testing::Test {
+ protected:
+  void SetUp() override {
+    ASSERT_TRUE(temp_.CreateUniqueTempDir());
+    entry_ = Entry("opaque", "Default", "space-a");
+    entry_.source.source_path = temp_.GetPath().AppendASCII("Default");
+    ASSERT_TRUE(base::CreateDirectory(entry_.source.source_path));
+    entry_.sidebar_path = temp_.GetPath().AppendASCII("StorableSidebar.json");
+    ASSERT_TRUE(base::WriteFile(entry_.sidebar_path, "fixture"));
+    entry_.fingerprint = base::HexEncode(base::SHA1HashString("fixture"));
+  }
+  content::BrowserTaskEnvironment task_environment_;
+  base::ScopedTempDir temp_;
+  ArcSpacesImport::Entry entry_;
+};
+TEST_F(ArcSpacesImportLifecycleTest,
+       CancelLoadingFinishesImmediatelyAndDropsDiscoveryReply) {
+  int changes = 0;
+  ArcSpacesImport importer(
+      base::BindLambdaForTesting([&] { ++changes; }));
+  ArcSpacesImportTestPeer::BeginLoading(importer);
+  auto reply = ArcSpacesImportTestPeer::DiscoveryReply(importer);
+  EXPECT_EQ(importer.Cancel(importer.batch_id() + 1), "stale_batch");
+  EXPECT_EQ(*importer.Snapshot().FindString("phase"), "loading");
+  EXPECT_TRUE(ArcSpacesImportTestPeer::HasDiscovery(importer));
+  EXPECT_TRUE(importer.Cancel(importer.batch_id()).empty());
+  EXPECT_EQ(*importer.Snapshot().FindString("phase"), "finished");
+  EXPECT_FALSE(ArcSpacesImportTestPeer::HasDiscovery(importer));
+  EXPECT_FALSE(importer.busy());
+  EXPECT_EQ(changes, 1);
+  EXPECT_TRUE(reply.IsCancelled());
+  std::move(reply).Run();
+  task_environment_.RunUntilIdle();
+  EXPECT_EQ(*importer.Snapshot().FindString("phase"), "finished");
+  EXPECT_TRUE(importer.Snapshot().FindList("spaces")->empty());
+  EXPECT_EQ(changes, 1);
+}
+
+TEST_F(ArcSpacesImportLifecycleTest,
+       CancelLoadingDropsInventoryReplyAndPreservesFinishDestination) {
+  int changes = 0;
+  ArcSpacesImport importer(
+      base::BindLambdaForTesting([&] { ++changes; }));
+  ArcSpacesImportTestPeer::SetFinishDestination(importer);
+  ArcSpacesImportTestPeer::BeginLoading(importer);
+  auto reply = ArcSpacesImportTestPeer::InventoryReply(importer, entry_);
+  EXPECT_TRUE(importer.Cancel(importer.batch_id()).empty());
+  EXPECT_TRUE(*importer.Snapshot().FindBool("canOpen"));
+  EXPECT_TRUE(ArcSpacesImportTestPeer::FinishDestinationPreserved(importer));
+  EXPECT_TRUE(reply.IsCancelled());
+  std::move(reply).Run();
+  task_environment_.RunUntilIdle();
+  const auto snapshot = importer.Snapshot();
+  EXPECT_EQ(*snapshot.FindString("phase"), "finished");
+  EXPECT_TRUE(snapshot.FindList("spaces")->empty());
+  EXPECT_TRUE(snapshot.FindList("jobs")->empty());
+  EXPECT_TRUE(*snapshot.FindBool("canOpen"));
+  EXPECT_TRUE(ArcSpacesImportTestPeer::FinishDestinationPreserved(importer));
+  EXPECT_EQ(changes, 1);
+}
+
+TEST_F(ArcSpacesImportLifecycleTest,
+       FreshDiscoveryAfterLoadingCancelAcceptsOnlyItsOwnReply) {
+  int changes = 0;
+  ArcSpacesImport importer(
+      base::BindLambdaForTesting([&] { ++changes; }));
+  ArcSpacesImportTestPeer::BeginLoading(importer);
+  auto stale = ArcSpacesImportTestPeer::InventoryReply(importer, entry_);
+  EXPECT_TRUE(importer.Cancel(importer.batch_id()).empty());
+  ArcSpacesImportTestPeer::BeginLoading(importer);
+  auto fresh_entry = entry_;
+  fresh_entry.token = "new-generation";
+  auto fresh =
+      ArcSpacesImportTestPeer::InventoryReply(importer, std::move(fresh_entry));
+  EXPECT_TRUE(stale.IsCancelled());
+  EXPECT_FALSE(fresh.IsCancelled());
+  std::move(stale).Run();
+  EXPECT_EQ(*importer.Snapshot().FindString("phase"), "loading");
+  EXPECT_TRUE(importer.Snapshot().FindList("spaces")->empty());
+  EXPECT_EQ(changes, 1);
+  std::move(fresh).Run();
+  const auto snapshot = importer.Snapshot();
+  EXPECT_EQ(*snapshot.FindString("phase"), "ready");
+  ASSERT_EQ(snapshot.FindList("spaces")->size(), 1u);
+  EXPECT_EQ(*snapshot.FindList("spaces")->front().GetDict().FindString("token"),
+            "new-generation");
+  EXPECT_EQ(changes, 2);
+}
+
+TEST_F(ArcSpacesImportLifecycleTest, CancelValidationBeforeAnyProfileCreation) {
+  ArcSpacesImport importer(base::DoNothing());
+  importer.SetInventoryForTesting({entry_});
+  EXPECT_TRUE(importer.Start(1, {entry_.token}).empty());
+  EXPECT_EQ(*importer.Snapshot().FindString("phase"), "validating");
+  EXPECT_TRUE(importer.Cancel(importer.batch_id()).empty());
+  task_environment_.RunUntilIdle();
+  const auto snapshot = importer.Snapshot();
+  EXPECT_EQ(*snapshot.FindString("phase"), "finished");
+  ASSERT_EQ(snapshot.FindList("jobs")->size(), 1u);
+  EXPECT_EQ(*snapshot.FindList("jobs")->front().GetDict().FindString("state"),
+            "cancelled");
+  // No TestingBrowserProcess/ProfileManager is provided: reaching profile
+  // creation would fail instead of producing this cancellation result.
+}
+TEST_F(ArcSpacesImportLifecycleTest, SourceChangeFailsBeforeProfileCreation) {
+  entry_.fingerprint = "stale inventory";
+  ArcSpacesImport importer(base::DoNothing());
+  importer.SetInventoryForTesting({entry_});
+  EXPECT_TRUE(importer.Start(1, {entry_.token}).empty());
+  task_environment_.RunUntilIdle();
+  EXPECT_EQ(*importer.Snapshot().FindString("failure"), "source_changed");
+  EXPECT_EQ(*importer.Snapshot().FindString("phase"), "failed");
+}
+TEST_F(ArcSpacesImportLifecycleTest, DestroyWhileWorkerReplyPendingIsSafe) {
+  int changes = 0;
+  auto importer = std::make_unique<ArcSpacesImport>(
+      base::BindLambdaForTesting([&] { ++changes; }));
+  importer->SetInventoryForTesting({entry_});
+  EXPECT_TRUE(importer->Start(1, {entry_.token}).empty());
+  importer.reset();
+  const int before = changes;
+  task_environment_.RunUntilIdle();
+  EXPECT_EQ(changes, before);
+}
+TEST_F(ArcSpacesImportLifecycleTest,
+       OldGenerationAndStaleCancelCannotStartWork) {
+  ArcSpacesImport importer(base::DoNothing());
+  importer.SetInventoryForTesting({entry_});
+  importer.SetInventoryForTesting({entry_});
+  EXPECT_EQ(importer.Start(1, {entry_.token}), "stale_selection");
+  EXPECT_EQ(importer.Cancel(900), "stale_batch");
+  EXPECT_FALSE(importer.busy());
+}
+TEST_F(ArcSpacesImportLifecycleTest,
+       SnapshotNeverExposesPathsIdsOrFingerprints) {
+  ArcSpacesImport importer(base::DoNothing());
+  entry_.name = "A Space";
+  importer.SetInventoryForTesting({entry_});
+  std::string json;
+  ASSERT_TRUE(base::JSONWriter::Write(importer.Snapshot(), &json));
+  EXPECT_EQ(json.find(temp_.GetPath().AsUTF8Unsafe()), std::string::npos);
+  EXPECT_EQ(json.find(entry_.source_key), std::string::npos);
+  EXPECT_EQ(json.find(entry_.space_id), std::string::npos);
+  EXPECT_EQ(json.find(entry_.fingerprint), std::string::npos);
+}
+TEST_F(ArcSpacesImportLifecycleTest,
+       FingerprintIgnoresLittleArcButDetectsSavedSpaceChange) {
+  const char* fixture = R"json({"sidebar":{"containers":[
+    {"littleBrowser":{"_0":"window-a"}},
+    {"items":[],"spaces":[],"topAppsContainerIDs":[]},
+    {"global":{}},
+    {"items":["pins",{"childrenIds":[],"data":{"itemContainer":{}}}],
+     "spaces":["space-a",{"title":"Saved Space","profile":{"default":true},
+                  "containerIDs":["pinned","pins"]}],
+     "topAppsContainerIDs":[]}
+  ]}})json";
+  auto root = base::JSONReader::ReadDict(fixture, base::JSON_PARSE_RFC);
+  ASSERT_TRUE(root);
+  auto snapshot = ParseArcSidebarSnapshot(*root, "Default");
+  ASSERT_TRUE(snapshot);
+  ASSERT_EQ(snapshot->spaces.size(), 1u);
+  std::string normalized;
+  ASSERT_TRUE(base::JSONWriter::Write(snapshot->ToDict(), &normalized));
+  entry_.fingerprint = base::HexEncode(base::SHA1HashString(normalized));
+  auto groups = ArcSpacesImport::GroupSelection({entry_}, {entry_.token}, {});
+  ASSERT_TRUE(groups);
+  ASSERT_TRUE(base::WriteFile(entry_.sidebar_path, fixture));
+  EXPECT_TRUE(ArcSpacesImport::SourcesUnchangedForTesting(*groups));
+  EXPECT_FALSE(ArcSpacesImport::SourcesUnchangedForTesting(
+      *groups, "different-machine"));
+  auto* containers = root->FindDict("sidebar")->FindList("containers");
+  (*containers)[0].GetDict().Set("littleBrowser",
+                                 base::DictValue().Set("_0", "window-b"));
+  std::string changed;
+  ASSERT_TRUE(base::JSONWriter::Write(*root, &changed));
+  ASSERT_TRUE(base::WriteFile(entry_.sidebar_path, changed));
+  EXPECT_TRUE(ArcSpacesImport::SourcesUnchangedForTesting(*groups));
+  (*containers)[3].GetDict().FindList("spaces")->back().GetDict().Set(
+      "title", "Changed saved Space");
+  ASSERT_TRUE(base::JSONWriter::Write(*root, &changed));
+  ASSERT_TRUE(base::WriteFile(entry_.sidebar_path, changed));
+  EXPECT_FALSE(ArcSpacesImport::SourcesUnchangedForTesting(*groups));
+}
