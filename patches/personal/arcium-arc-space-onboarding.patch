+
+TEST_F(OnboardingMessageHandlerTest, PrivatePreferenceCannotBeWrittenByWebUi) {
+  web_ui_.HandleReceivedMessage(
+      "setPref", base::ListValue().Append("callback")
+                     .Append("onboarding_test_saved_tree")
+                     .Append(base::ListValue().Append("replacement")));
+  ASSERT_EQ(1u, web_ui_.call_data().size());
+  const auto& response = *web_ui_.call_data().back();
+  EXPECT_FALSE(response.arg2()->GetBool());
+  EXPECT_EQ("unsupported onboarding preference", response.arg3()->GetString());
+  EXPECT_TRUE(profile_.GetPrefs()->GetList(kPrivatePref).empty());
+}
+
+TEST_F(OnboardingMessageHandlerTest, DestroyingHandlerDropsPendingNotification) {
+  GetPreferences();
+  web_ui_.ClearTrackedCalls();
+  auto* pref_service = profile_.GetPrefs();
+  pref_service->SetBoolean(prefs::kHeliumBangsEnabled,
+                    !pref_service->GetBoolean(prefs::kHeliumBangsEnabled));
+  handler_ = nullptr;
+  web_ui_.GetHandlersForTesting()->clear();
+  task_environment_.RunUntilIdle();
+  EXPECT_TRUE(web_ui_.call_data().empty());
