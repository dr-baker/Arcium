+        .data = helium::PersistentLink{.id = std::move(id),
+                                       .title = u"Fixture",
+                                       .url = GURL("https://example.com/")}};
+  };
+  service->ReconcileImportedPersistentItems(
+      "Default", {link("favorite")},
+      {{.id = "selected", .name = u"Selected", .pins = {link("selected-pin")}},
+       {.id = "unselected", .name = u"Unselected", .pins = {link("other-pin")}},
+       {.id = "arc:Default:favorites-space",
+        .name = u"Favorites",
+        .pins = {}}});
+  ArcSidebarSelection selection{.source_profile = "Default",
+                                .space_ids = {"selected"}};
+  std::string first;
+  auto counts = Coordinator::CountImportedRecords(&profile_, "Default", &first,
+                                                  selection);
+  EXPECT_EQ(counts.spaces, 1);
+  EXPECT_EQ(counts.pins, 1);
+  EXPECT_EQ(counts.favorites, 1);
+  EXPECT_EQ(first, "selected");
+  selection.include_favorites = false;
+  EXPECT_EQ(Coordinator::CountImportedRecords(&profile_, "Default", nullptr,
+                                              selection)
+                .favorites,
+            0);
+  selection.space_ids.clear();
+  selection.include_favorites = true;
+  counts = Coordinator::CountImportedRecords(&profile_, "Default", &first,
+                                             selection);
+  EXPECT_EQ(counts.spaces, 1);
+  EXPECT_EQ(counts.pins, 0);
+  EXPECT_EQ(first, "arc:Default:favorites-space");
+}
