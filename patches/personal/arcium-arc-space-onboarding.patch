+// Pure state for the Arc Space picker. No runtime imports, so tests load this
+// file directly with Node's type stripping.
+//
+// The handler owns import state and sends complete snapshots. This module
+// keeps only what the page itself decides: which Spaces are chosen, whether
+// History is on, and which Spaces finished in an earlier batch.
+
+import type {
+    ArcJob,
+    ArcJobState,
+    ArcPhase,
+    ArcRejection,
+    ArcSpace,
+    ArcStartRequest,
+    ArcState,
+} from '../cr/arc_space_import_proxy';
+
+/**
+ * The handler's stable `identity`. Tokens change with every inventory and
+ * names can repeat or change, so selections and results are keyed by this.
+ */
+export type SpaceKey = string;
+export type Entry = { key: SpaceKey; space: ArcSpace };
+
+export type TileStatus = 'idle' | 'queued' | 'running' | 'succeeded' | 'failed' | 'cancelled';
+export type TileOutcome = { status: TileStatus; failure?: string; partial?: boolean };
+
+export type Load = 'loading' | 'ready' | 'failed' | 'unreachable';
+export type Notice = 'busy' | 'changed' | 'refreshed' | 'error' | 'open_failed' | null;
+/**
+ * How the next inventory treats earlier successes. `auto` (rereads after
+ * `source_changed` or `stale_selection`) keeps them locked; `user` (Check
+ * again) makes them selectable so a Space can be refreshed on purpose.
+ */
+export type Refresh = 'auto' | 'user';
+
+type Batch = {
+    id: number;
+    generation: number;
+    keys: SpaceKey[];
+    tokens: string[];
+    /** What this request sent, shown on the disabled toggle while it runs. */
+    history: boolean;
+    /** Ledger job ids that existed before this batch, so they are not read as its jobs. */
+    prior: ReadonlySet<number>;
+};
+type PendingStart = Omit<Batch, 'id'> & { after: number };
+
+/** Why a one-click import ended without sending anything, or was refused. */
+export type OneClickFailure = 'none' | 'unreadable' | 'unreachable' | 'changed' | 'busy' | 'error';
+
+/**
+ * The one-click import on the first screen. `waiting` holds the click until
+ * an inventory from generation `after` or later answers it. `sent` keeps the
+ * Spaces that one request covered; their results come from the batch.
+ */
+export type OneClick =
+    | { stage: 'idle' }
+    | { stage: 'waiting'; after: number }
+    | { stage: 'sent'; keys: SpaceKey[] }
+    | { stage: 'failed'; reason: OneClickFailure };
+
+export type Model = {
+    snapshot: ArcState | null;
+    /** initialize() threw, rejected, or never answered, and no snapshot arrived. */
+    unreachable: boolean;
+    selected: ReadonlySet<SpaceKey>;
+    /** The first usable inventory selects everything once. */
+    seeded: boolean;
+    /** Opt-in for the next request only. */
+    history: boolean;
+    /** Final outcomes from earlier snapshots. A success is never undone. */
+    results: ReadonlyMap<SpaceKey, TileOutcome>;
+    /** Earlier failed/stopped writes survive inventory refresh until success. */
+    partialData: ReadonlySet<SpaceKey>;
+    /** Inventory omissions persist through jobs and unsuccessful rereads. */
+    inventoryIncomplete: boolean;
+    /** Imported earlier in this page, unlocked by an explicit refresh. */
+    again: ReadonlySet<SpaceKey>;
+    refresh: Refresh;
+    batch: Batch | null;
+    pending: PendingStart | null;
+    notice: Notice;
+    oneClick: OneClick;
+};
+
+export type Action =
+    | { kind: 'busy' }
+    | { kind: 'skip' }
+    | { kind: 'continue' }
+    | { kind: 'retry' }
+    | { kind: 'import'; spaces: number };
+
+export const initialModel = (): Model => ({
+    snapshot: null,
+    unreachable: false,
+    selected: new Set(),
+    seeded: false,
+    // History is opt-in on every visit.
+    history: false,
+    results: new Map(),
+    partialData: new Set(),
+    inventoryIncomplete: false,
+    again: new Set(),
+    refresh: 'auto',
+    batch: null,
+    pending: null,
+    notice: null,
+    oneClick: { stage: 'idle' },
+});
+
+// ---- Parsing ----------------------------------------------------------------
+
+const PHASES: ReadonlySet<string> = new Set<ArcPhase>(
+    ['loading', 'ready', 'validating', 'running', 'finished', 'failed']);
+const JOB_STATES: ReadonlySet<string> = new Set<ArcJobState>(
+    ['pending', 'creating_profile', 'running', 'succeeded', 'empty', 'failed', 'cancelled']);
+const REJECTIONS: ReadonlySet<string> = new Set<ArcRejection>(
+    ['invalid_arguments', 'busy', 'stale_selection', 'nothing_selected', 'stale_batch',
+     'nothing_to_open']);
+
+const isRecord = (value: unknown): value is Record<string, unknown> =>
+    typeof value === 'object' && value !== null && !Array.isArray(value);
+const isIndex = (value: unknown): value is number =>
+    typeof value === 'number' && Number.isInteger(value) && value >= 0;
+const count = (value: unknown) => isIndex(value) ? value : 0;
+const text = (value: unknown, max: number) =>
+    typeof value === 'string' ? value.trim().slice(0, max) : '';
+const code = (value: unknown) =>
+    typeof value === 'string' && /^[a-z_]{1,64}$/.test(value) ? value : '';
+const isOpaque = (value: unknown): value is string =>
+    typeof value === 'string' && value.length > 0 && value.length <= 256;
+
+const parseSpace = (value: unknown): ArcSpace | null => {
+    if (!isRecord(value) || !isOpaque(value.token) || !isOpaque(value.identity) ||
+        !isOpaque(value.profileToken)) {
+        return null;
+    }
+    return {
+        token: value.token,
+        identity: value.identity,
+        profileToken: value.profileToken,
+        name: text(value.name, 120),
+        profileLabel: text(value.profileLabel, 80),
+        pins: count(value.pins),
+        folders: count(value.folders),
+        favorites: count(value.favorites),
+        favoritesOnly: value.favoritesOnly === true,
+    };
+};
+
+const parseJob = (value: unknown): ArcJob | null => {
+    if (!isRecord(value) || !isIndex(value.id) || !Array.isArray(value.tokens) ||
+        !value.tokens.every(isOpaque)) {
+        return null;
+    }
+    const known = typeof value.state === 'string' && JOB_STATES.has(value.state);
+    const counts = isRecord(value.counts) ? value.counts : {};
+    return {
+        id: value.id,
+        tokens: [...value.tokens],
+        profileLabel: text(value.profileLabel, 80),
+        // An unknown state is never read as success.
+        state: known ? value.state as ArcJobState : 'failed',
+        failure: known ? code(value.failure) : 'unknown',
+        mayHavePartialData: value.mayHavePartialData === true,
+        historyFinished: value.historyFinished === true,
+        counts: {
+            spaces: count(counts.spaces),
+            pins: count(counts.pins),
+            folders: count(counts.folders),
+            favorites: count(counts.favorites),
+        },
+    };
+};
+
+const unique = (values: string[]) => new Set(values).size === values.length;
+
+/**
+ * Validates a handler snapshot. Returns null when it is unusable, including
+ * any Space without `identity`/`profileToken`, any job without `tokens`, and
+ * repeated tokens or identities. There is no fallback for a partial contract.
+ */
+export const parseState = (raw: unknown): ArcState | null => {
+    if (!isRecord(raw) || !isIndex(raw.generation) || !isIndex(raw.batchId) ||
+        typeof raw.phase !== 'string' || !PHASES.has(raw.phase) ||
+        !Array.isArray(raw.spaces) || !Array.isArray(raw.jobs)) {
+        return null;
+    }
+    const spaces = raw.spaces.map(parseSpace);
+    const jobs = raw.jobs.map(parseJob);
+    if (spaces.some(space => !space) || jobs.some(job => !job)) {
+        return null;
+    }
+    const valid = spaces as ArcSpace[];
+    if (!unique(valid.map(space => space.token)) || !unique(valid.map(space => space.identity))) {
+        return null;
+    }
+    return {
+        generation: raw.generation,
+        batchId: raw.batchId,
+        phase: raw.phase as ArcPhase,
+        failure: code(raw.failure),
+        spaces: valid,
+        jobs: jobs as ArcJob[],
+        canOpen: raw.canOpen === true,
+    };
+};
+
+export const parseRejection = (error: unknown): ArcRejection | 'unknown' =>
+    typeof error === 'string' && REJECTIONS.has(error) ? error as ArcRejection : 'unknown';
+
+// ---- Queries ----------------------------------------------------------------
+
+const BUSY_PHASES: ReadonlySet<ArcPhase> = new Set(['validating', 'running']);
+
+/** Both the Welcome summary and picker show this independently of job results. */
+export const inventoryIncomplete = (model: Model): boolean => model.inventoryIncomplete;
+
+export const entries = (model: Model): Entry[] =>
+    (model.snapshot?.spaces ?? []).map(space => ({ key: space.identity, space }));
+
+export const load = (model: Model): Load => {
+    const snapshot = model.snapshot;
+    if (model.unreachable) {
+        return 'unreachable';
+    }
+    if (!snapshot || snapshot.generation === 0 || snapshot.phase === 'loading') {
+        return 'loading';
+    }
+    return snapshot.phase === 'failed' && !snapshot.spaces.length ? 'failed' : 'ready';
+};
+
+export const busy = (model: Model): boolean =>
+    model.pending !== null ||
+    (model.snapshot !== null && BUSY_PHASES.has(model.snapshot.phase));
+
+const succeeded = (model: Model, key: SpaceKey) =>
+    model.results.get(key)?.status === 'succeeded';
+
+export const selectable = (model: Model): Entry[] =>
+    entries(model).filter(entry => !succeeded(model, entry.key));
+
+const chosen = (model: Model) =>
+    selectable(model).filter(entry => model.selected.has(entry.key));
+
+export const allSelected = (model: Model): boolean => {
+    const open = selectable(model);
+    return open.length > 0 && open.every(entry => model.selected.has(entry.key));
+};
+
+export const selectedCount = (model: Model): number => chosen(model).length;
+
+/** True when the selection reaches a source that has profile-wide Favorites. */
+export const favoritesIncluded = (model: Model): boolean =>
+    chosen(model).some(entry => entry.space.favorites > 0);
+
+/** True when the selection would import a Space again and replace its sidebar. */
+export const replacesImported = (model: Model): boolean =>
+    chosen(model).some(entry => model.again.has(entry.key));
+
+/** More than one Arc profile, so tiles name their source. */
+export const multipleSources = (model: Model): boolean =>
+    new Set(entries(model).map(entry => entry.space.profileToken)).size > 1;
+
+/** The toggle shows what a running request sent, otherwise the next opt-in. */
+export const historyShown = (model: Model): boolean =>
+    model.pending?.history ?? (busy(model) && isCurrent(model) ? model.batch.history : model.history);
+
+const jobOutcome = (job: ArcJob): TileOutcome => {
+    switch (job.state) {
+    case 'pending': return { status: 'queued' };
+    case 'creating_profile':
+    case 'running': return { status: 'running' };
+    case 'succeeded':
+    case 'empty': return { status: 'succeeded' };
+    case 'cancelled': return { status: 'cancelled', partial: job.mayHavePartialData };
+    default: return {
+        status: 'failed', failure: job.failure || 'unknown', partial: job.mayHavePartialData,
+    };
+    }
+};
+
+const TERMINAL: ReadonlySet<TileStatus> = new Set(['succeeded', 'failed', 'cancelled']);
+
+/**
+ * The newest job covering each token in `jobs`. The ledger is ordered old to
+ * new and the latest attempt controls a token.
+ */
+const latestByToken = (jobs: ArcJob[]) => {
+    const latest = new Map<string, ArcJob>();
+    jobs.forEach(job => job.tokens.forEach(token => latest.set(token, job)));
+    return latest;
+};
+
+const batchJobs = (snapshot: ArcState, batch: Batch) =>
+    snapshot.jobs.filter(job => !batch.prior.has(job.id));
+
+/**
+ * Per-Space outcome of the batch, from the job tokens only. While the batch
+ * runs a Space without a job yet is waiting. Once it is terminal, a Space no
+ * job reported, or whose job never ended, failed: nothing else is inferred.
+ */
+export const attribute = (snapshot: ArcState, batch: Batch): Map<SpaceKey, TileOutcome> => {
+    const latest = latestByToken(batchJobs(snapshot, batch));
+    const live = BUSY_PHASES.has(snapshot.phase);
+    const result = new Map<SpaceKey, TileOutcome>();
+    batch.tokens.forEach((token, i) => {
+        const job = latest.get(token);
+        const outcome: TileOutcome = job ? jobOutcome(job) : { status: 'queued' };
+        result.set(batch.keys[i], live || TERMINAL.has(outcome.status) ? outcome : {
+            status: 'failed',
+            failure: (snapshot.phase === 'failed' && snapshot.failure) || 'unknown',
+            partial: !!job && (job.mayHavePartialData || job.state !== 'pending'),
+        });
+    });
+    return result;
+};
+
+const isCurrent = (model: Model): model is Model & { batch: Batch; snapshot: ArcState } =>
+    model.batch !== null && model.snapshot !== null &&
+    model.snapshot.batchId === model.batch.id &&
+    model.snapshot.generation === model.batch.generation;
+
+/** What each tile shows right now. */
+export const outcomes = (model: Model): Map<SpaceKey, TileOutcome> => {
+    const result = new Map(model.results);
+    if (model.pending) {
+        model.pending.keys.forEach(key => !succeeded(model, key) && result.set(key, { status: 'queued' }));
+    } else if (isCurrent(model) && BUSY_PHASES.has(model.snapshot.phase)) {
+        for (const [key, outcome] of attribute(model.snapshot, model.batch)) {
+            if (!succeeded(model, key)) {
+                result.set(key, outcome);
+            }
+        }
+    }
+    return result;
+};
+
+export type Summary = {
+    imported: number;
+    failed: number;
+    stopped: number;
+    partial: boolean;
+    /** Spaces finished in the running batch. */
+    progress: { done: number; total: number } | null;
+};
+
+export const summarize = (model: Model): Summary => {
+    const shown = outcomes(model);
+    const summary: Summary = { imported: 0, failed: 0, stopped: 0, partial: model.partialData.size > 0, progress: null };
+    for (const { key } of entries(model)) {
+        const outcome = shown.get(key);
+        summary.imported += outcome?.status === 'succeeded' ? 1 : 0;
+        summary.failed += outcome?.status === 'failed' ? 1 : 0;
+        summary.stopped += outcome?.status === 'cancelled' ? 1 : 0;
+        summary.partial ||= !!outcome?.partial;
+    }
+    if (isCurrent(model) && BUSY_PHASES.has(model.snapshot.phase)) {
+        const keys = model.batch.keys;
+        summary.progress = {
+            done: keys.filter(key => TERMINAL.has(shown.get(key)?.status ?? 'idle')).length,
+            total: keys.length,
+        };
+    }
+    return summary;
+};
+
+export const action = (model: Model): Action => {
+    if (busy(model)) {
+        return { kind: 'busy' };
+    }
+    if (load(model) !== 'ready') {
+        return { kind: 'skip' };
+    }
+    const todo = chosen(model);
+    if (!todo.length) {
+        return entries(model).some(entry => succeeded(model, entry.key))
+            ? { kind: 'continue' }
+            : { kind: 'skip' };
+    }
+    const status = (key: SpaceKey) => model.results.get(key)?.status;
+    if (todo.some(entry => status(entry.key) === 'failed' || status(entry.key) === 'cancelled')) {
+        return { kind: 'retry' };
+    }
+    return { kind: 'import', spaces: todo.filter(entry => !entry.space.favoritesOnly).length };
+};
+
+export const canOpen = (model: Model): boolean =>
+    !busy(model) && model.snapshot?.canOpen === true;
+
+/**
+ * The current batch ended and Arc changed under it. The page rereads Arc so a
+ * retry carries fresh tokens; successes stay locked.
+ */
+export const sourceChanged = (model: Model): boolean =>
+    isCurrent(model) && !BUSY_PHASES.has(model.snapshot.phase) &&
+    (model.snapshot.failure === 'source_changed' ||
+     batchJobs(model.snapshot, model.batch).some(job => job.failure === 'source_changed'));
+
+// ---- Updates ----------------------------------------------------------------
+
+const PHASE_ORDER: Record<ArcPhase, number> = {
+    loading: 0, ready: 1, validating: 2, running: 3, finished: 4, failed: 4,
+};
+
+// Within one inventory and batch the handler only moves forward, so a
+// snapshot that steps back arrived late.
+const isOlder = (next: ArcState, current: ArcState) =>
+    next.generation < current.generation ||
+    (next.generation === current.generation && (next.batchId < current.batchId ||
+        (next.batchId === current.batchId &&
+         PHASE_ORDER[next.phase] < PHASE_ORDER[current.phase])));
+
+/** Replaces the snapshot. Older generations, batches, and phases are ignored. */
+export const applySnapshot = (model: Model, snapshot: ArcState): Model => {
+    if (model.snapshot && isOlder(snapshot, model.snapshot)) {
+        return model;
+    }
+    let next: Model = { ...model, snapshot, unreachable: false };
+
+    // Only a completed inventory can remove an earlier inventory warning.
+    // Start clears the handler's failure field, so job snapshots cannot prove
+    // that sources omitted during discovery have become available.
+    if (snapshot.generation > 0 && snapshot.phase === 'ready') {
+        next.inventoryIncomplete = !!snapshot.failure;
+    } else if (snapshot.phase === 'failed' && snapshot.failure === 'sidebar_unreadable') {
+        next.inventoryIncomplete = true;
+    }
+
+    // A new inventory. Failures belonged to old tokens and History is opted
+    // into again. An automatic reread keeps successes locked so nothing is
+    // imported twice; Check again unlocks them for an intentional refresh.
+    if (model.snapshot && snapshot.generation !== model.snapshot.generation) {
+        const done = [...model.results].filter(([, r]) => r.status === 'succeeded');
+        if (model.refresh === 'user') {
+            next.again = new Set([...model.again, ...done.map(([key]) => key)]);
+            next.results = new Map();
+            next.notice = done.length ? 'refreshed' : next.notice;
+        } else {
+            next.results = new Map(done);
+        }
+        next.history = false;
+        next.refresh = 'auto';
+        next.batch = null;
+    }
+
+    if (next.pending && snapshot.generation === next.pending.generation &&
+        snapshot.batchId > next.pending.after) {
+        const { after: _after, ...batch } = next.pending;
+        next.batch = { ...batch, id: snapshot.batchId };
+        next.pending = null;
+    }
+
+    if (isCurrent(next) && !BUSY_PHASES.has(snapshot.phase)) {
+        const results = new Map(next.results);
+        const partialData = new Set(next.partialData);
+        for (const [key, outcome] of attribute(snapshot, next.batch)) {
+            if (results.get(key)?.status !== 'succeeded') {
+                results.set(key, outcome);
+                if (outcome.status === 'succeeded') {
+                    partialData.delete(key);
+                } else if (outcome.partial) {
+                    partialData.add(key);
+                }
+            }
+        }
+        next.results = results;
+        next.partialData = partialData;
+    }
+
+    if (load(next) !== 'ready') {
+        return next;
+    }
+    const all = entries(next);
+    if (!next.seeded && all.length) {
+        next.selected = new Set(all.map(entry => entry.key));
+        next.seeded = true;
+    }
+    // Keep only Spaces that still exist and can still be chosen.
+    const open = new Set(selectable(next).map(entry => entry.key));
+    if ([...next.selected].some(key => !open.has(key))) {
+        next.selected = new Set([...next.selected].filter(key => open.has(key)));
+    }
+    return next;
+};
+
+export const markUnreachable = (model: Model): Model => ({ ...model, unreachable: true });
+
+/** The next inventory comes from Check again, not an automatic reread. */
+export const requestRefresh = (model: Model): Model => ({ ...model, refresh: 'user' });
+
+export const endRefresh = (model: Model): Model =>
+    model.refresh === 'auto' ? model : { ...model, refresh: 'auto' };
+
+/** Entering the picker always starts with History off. */
+export const visit = (model: Model): Model =>
+    model.history && !busy(model) ? { ...model, history: false } : model;
+
+// Changing the selection changes which Arc profiles History would come from,
+// so the opt-in is cleared.
+export const toggle = (model: Model, key: SpaceKey): Model => {
+    if (busy(model) || !selectable(model).some(entry => entry.key === key)) {
+        return model;
+    }
+    const selected = new Set(model.selected);
+    if (!selected.delete(key)) {
+        selected.add(key);
+    }
+    return { ...model, selected, history: false, notice: null };
+};
+
+export const setAll = (model: Model, on: boolean): Model =>
+    busy(model) ? model : {
+        ...model,
+        selected: new Set(on ? selectable(model).map(entry => entry.key) : []),
+        history: false,
+        notice: null,
+    };
+
+export const setHistory = (model: Model, on: boolean): Model =>
+    busy(model) ? model : { ...model, history: on };
+
+/** The next request, in inventory order. Successes are never sent again. */
+export const buildStart = (model: Model): ArcStartRequest | null => {
+    const snapshot = model.snapshot;
+    const todo = chosen(model);
+    if (!snapshot || busy(model) || load(model) !== 'ready' || !todo.length) {
+        return null;
+    }
+    return {
+        generation: snapshot.generation,
+        tokens: todo.map(entry => entry.space.token),
+        history: model.history,
+    };
+};
+
+/**
+ * Records the request. History is spent: a retry needs a new opt-in. A
+ * request from the picker hands the import over to it, so the first screen
+ * stops reporting an earlier one-click result.
+ */
+export const markStarting = (model: Model, request: ArcStartRequest, oneClick = false): Model => {
+    const byToken = new Map(entries(model).map(entry => [entry.space.token, entry.key]));
+    return {
+        ...model,
+        notice: null,
+        history: false,
+        oneClick: oneClick ? model.oneClick : { stage: 'idle' },
+        pending: {
+            after: model.snapshot?.batchId ?? 0,
+            generation: request.generation,
+            keys: request.tokens.map(token => byToken.get(token)!),
+            tokens: [...request.tokens],
+            history: request.history,
+            prior: new Set(model.snapshot?.jobs.map(job => job.id) ?? []),
+        },
+    };
+};
+
+/** A start that resolved without a new batch, or was rejected. */
+export const startFailed = (model: Model, rejection: ArcRejection | 'unknown'): Model => {
+    const next = refusedStart(model, rejection);
+    if (model.oneClick.stage !== 'sent' || !model.pending) {
+        return next;
+    }
+    // A refused one-click request shows why. Nothing is sent again by itself.
+    switch (rejection) {
+    case 'nothing_selected':
+        return next.notice ? { ...next, oneClick: { stage: 'failed', reason: 'error' } } : next;
+    case 'stale_selection': return { ...next, oneClick: { stage: 'failed', reason: 'changed' } };
+    case 'busy': return { ...next, oneClick: { stage: 'failed', reason: 'busy' } };
+    default: return { ...next, oneClick: { stage: 'failed', reason: 'error' } };
+    }
+};
+
+const refusedStart = (model: Model, rejection: ArcRejection | 'unknown'): Model => {
+    const pending = model.pending;
+    const next: Model = { ...model, pending: null };
+    switch (rejection) {
+    case 'nothing_selected': {
+        // Only the ledger can say a Space already succeeded in this inventory.
+        const latest = latestByToken(model.snapshot?.jobs ?? []);
+        const results = new Map(model.results);
+        const partialData = new Set(model.partialData);
+        let unconfirmed = false;
+        pending?.tokens.forEach((token, i) => {
+            const job = latest.get(token);
+            if (job && jobOutcome(job).status === 'succeeded') {
+                results.set(pending.keys[i], { status: 'succeeded' });
+                partialData.delete(pending.keys[i]);
+            } else {
+                unconfirmed = true;
+            }
+        });
+        const selected = new Set([...model.selected].filter(key => results.get(key)?.status !== 'succeeded'));
+        return { ...next, results, partialData, selected, notice: unconfirmed ? 'error' : null };
+    }
+    case 'busy': return { ...next, notice: 'busy' };
+    case 'stale_selection': return { ...next, notice: 'changed' };
+    default: return { ...next, notice: 'error' };
+    }
+};
+
+export const withNotice = (model: Model, notice: Notice): Model => ({ ...model, notice });
+
+// ---- One click ----------------------------------------------------------------
+
+/**
+ * What one click imports: every Space not imported yet. Spaces that an
+ * explicit Check again unlocked stay out, because importing them again
+ * replaces their sidebar and only the picker asks about that.
+ */
+export const oneClickEligible = (model: Model): Entry[] =>
+    selectable(model).filter(entry => !model.again.has(entry.key));
+
+/**
+ * The button was pressed. `after` is the first inventory generation allowed
+ * to answer, so an inventory read before a refresh never starts the import.
+ * Ignored while a click is already waiting or a batch runs.
+ */
+export const requestOneClick = (model: Model, after: number): Model =>
+    model.oneClick.stage === 'waiting' || busy(model) ? model
+        : { ...model, notice: null, oneClick: { stage: 'waiting', after } };
+
+/** Cancel, Back, or leaving the page. Only a click still waiting is dropped. */
+export const cancelOneClick = (model: Model): Model =>
+    model.oneClick.stage === 'waiting' ? { ...model, oneClick: { stage: 'idle' } } : model;
+
+export type OneClickStep = 'wait' | 'start' | 'done' | OneClickFailure;
+
+/** What a waiting click does with the model as it is now. */
+export const oneClickStep = (model: Model): OneClickStep => {
+    const intent = model.oneClick;
+    if (intent.stage !== 'waiting' || busy(model)) {
+        return 'wait';
+    }
+    if (model.unreachable) {
+        return 'unreachable';
+    }
+    if ((model.snapshot?.generation ?? 0) < intent.after) {
+        return 'wait';
+    }
+    switch (load(model)) {
+    case 'loading': return 'wait';
+    case 'failed': return 'unreadable';
+    }
+    if (!entries(model).length) {
+        return 'none';
+    }
+    return oneClickEligible(model).length ? 'start' : 'done';
+};
+
+/** Ends a waiting click without a request: nothing left to import, or a failure. */
+export const resolveOneClick = (model: Model, step: 'done' | OneClickFailure): Model =>
+    model.oneClick.stage !== 'waiting' ? model : {
+        ...model,
+        oneClick: step === 'done' ? { stage: 'sent', keys: [] } : { stage: 'failed', reason: step },
+    };
+
+/**
+ * Turns a waiting click into the request: every eligible Space is chosen and
+ * History is off. The caller sends it once with `buildStart`.
+ */
+export const prepareOneClick = (model: Model): Model => {
+    if (oneClickStep(model) !== 'start') {
+        return model;
+    }
+    const keys = oneClickEligible(model).map(entry => entry.key);
+    return {
+        ...model,
+        selected: new Set(keys),
+        history: false,
+        notice: null,
+        oneClick: { stage: 'sent', keys },
+    };
+};
+
+export type OneClickView =
+    | { kind: 'idle' }
+    | { kind: 'finding' }
+    | { kind: 'importing'; done: number; total: number }
+    | { kind: 'done'; imported: number }
+    | { kind: 'partial'; imported: number; missed: number; stopped: boolean }
+    | { kind: 'failed'; reason: OneClickFailure };
+
+/** What the first screen shows for the one-click import. */
+export const oneClickView = (model: Model): OneClickView => {
+    const intent = model.oneClick;
+    switch (intent.stage) {
+    case 'idle': return { kind: 'idle' };
+    case 'waiting': return { kind: 'finding' };
+    case 'failed': return { kind: 'failed', reason: intent.reason };
+    }
+    if (busy(model)) {
+        const progress = summarize(model).progress;
+        return { kind: 'importing', done: progress?.done ?? 0, total: progress?.total ?? intent.keys.length };
+    }
+    const imported = intent.keys.filter(key => succeeded(model, key)).length;
+    if (imported === intent.keys.length) {
+        // Everything in Arc that is now in Arcium, including earlier imports.
+        return {
+            kind: 'done',
+            imported: entries(model).filter(e => succeeded(model, e.key) || model.again.has(e.key)).length,
+        };
+    }
+    return {
+        kind: 'partial',
+        imported,
+        missed: intent.keys.length - imported,
+        stopped: intent.keys.some(key => model.results.get(key)?.status === 'cancelled'),
+    };
+};
