+  if (profile && profile->FindBool("default").value_or(false)) {
+    return ProfileIdentity{.directory = "Default", .is_default = true};
+  }
+  const base::DictValue* payload = CustomProfilePayload(profile);
+  const std::string directory = ProfileDirectory(profile);
+  if (!payload || directory.empty()) {
+    return std::nullopt;
+  }
+  const std::string* machine_id = payload->FindString("machineID");
+  if (payload->contains("machineID") && (!machine_id || machine_id->empty())) {
+    return std::nullopt;
+  }
+  return ProfileIdentity{.directory = directory,
+                         .machine_id = machine_id ? *machine_id : std::string()};
+}
+
+std::optional<ProfileIdentity> ResolveLocalProfileIdentity(
+    const base::DictValue& sidebar_data,
+    std::string_view directory,
+    std::string_view local_machine_id) {
+  if (directory == "Default") {
+    return ProfileIdentity{.directory = "Default", .is_default = true};
+  }
+  std::set<std::string> machines;
+  bool legacy = false;
+  bool malformed = false;
+  auto inspect = [&](const base::DictValue* profile) {
+    if (ProfileDirectory(profile) != directory) {
+      return;
+    }
+    const auto identity = ParseProfileIdentity(profile);
+    if (!identity || identity->is_default) {
+      malformed = true;
+    } else if (identity->machine_id.empty()) {
+      legacy = true;
+    } else {
+      machines.insert(identity->machine_id);
+    }
+  };
+  if (const auto* spaces = sidebar_data.FindList("spaces")) {
+    for (size_t i = 0; i + 1 < spaces->size(); i += 2) {
+      const auto* space = (*spaces)[i + 1].GetIfDict();
+      inspect(space ? space->FindDict("profile") : nullptr);
+    }
+  }
+  if (const auto* top_apps = sidebar_data.FindList("topAppsContainerIDs")) {
+    for (size_t i = 0; i + 1 < top_apps->size(); i += 2) {
+      inspect((*top_apps)[i].GetIfDict());
+    }
+  }
+  if (malformed || (!machines.empty() && legacy)) {
+    return std::nullopt;
+  }
+  if (!machines.empty()) {
+    // A basename is only a local directory hint, not a cross-device identity.
+    // Other machines' descriptors may coexist in the global synced sidebar.
+    if (local_machine_id.empty() ||
+        !machines.contains(std::string(local_machine_id))) {
+      return std::nullopt;
+    }
+    return ProfileIdentity{.directory = std::string(directory),
+                           .machine_id = std::string(local_machine_id)};
+  }
+  // Preserve supported legacy snapshots and deliberate empty-source refreshes.
+  return ProfileIdentity{.directory = std::string(directory)};
+}
+
+bool MatchesProfile(const base::DictValue* profile,
+                    const ProfileIdentity& expected) {
+  const auto identity = ParseProfileIdentity(profile);
+  return identity && *identity == expected;
+}
