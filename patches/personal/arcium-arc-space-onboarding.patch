+function harness() {
+    const requests = [], timers = new Map(), listeners = [];
+    let id = 0;
+    const context = vm.createContext({exports: {}, readonly, writable,
+        setTimeout: (callback, delay) => {timers.set(++id, {callback, delay}); return id;},
+        clearTimeout: key => timers.delete(key),
+        chrome: {send() {throw new Error('unexpected consent write');}},
+        cr: {
+            sendWithPromise: (...args) => {const d = deferred(); requests.push({...d, args}); return d.promise;},
+            addWebUiListener: (name, callback) => listeners.push({name, callback}),
+        }});
+    const source = readFileSync('src/lib/browser/prefs.ts', 'utf8');
+    const parsed = ts.createSourceFile('prefs.ts', source, ts.ScriptTarget.Latest, true, ts.ScriptKind.TS);
+    const clean = ts.createPrinter().printFile(ts.factory.updateSourceFile(parsed,
+        parsed.statements.filter(s => !ts.isImportDeclaration(s))));
+    vm.runInContext(ts.transpileModule(clean, {compilerOptions: {
+        target: ts.ScriptTarget.ES2022, module: ts.ModuleKind.CommonJS,
+    }}).outputText, context);
+    const api = context.exports;
+    return {api, requests, timers, listeners,
+        state: () => get(api.preferencesBootstrap), prefs: () => get(api.preferences),
+        event: prefs => listeners[0].callback(prefs),
+        timeout: () => {const pending = [...timers.values()]; timers.clear(); pending.forEach(t => t.callback());},
+    };
