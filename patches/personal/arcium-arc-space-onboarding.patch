+function controller({initialize, timeoutMs = 50} = {}) {
+    const listeners = new Set();
+    const calls = [];
+    let order = [];
+    const proxy = {
+        initialize: () => {
+            order.push('initialize');
+            calls.push(['initialize']);
+            return initialize ? initialize(calls.filter(c => c[0] === 'initialize').length)
+                : Promise.resolve(snap({phase: 'loading', spaces: []}));
+        },
+        start: request => {
+            calls.push(['start', structuredClone(request)]);
+            return proxy.startReply(request);
+        },
+        startReply: request => Promise.resolve(snap({batchId: 1, phase: 'validating', jobs: withTokens(request)})),
+        cancel: batchId => { calls.push(['cancel', batchId]); return Promise.resolve(snap({batchId, phase: 'running'})); },
+        open: batchId => { calls.push(['open', batchId]); return Promise.resolve(true); },
+        onStateChanged: callback => { order.push('listen'); listeners.add(callback); return () => listeners.delete(callback); },
+    };
+    const exports = {};
+    const context = vm.createContext({exports, setTimeout, clearTimeout, require: name =>
+        name === 'svelte/store' ? stores : name === './spaces' ? S : assert.fail(name)});
+    vm.runInContext(transpile(readFileSync('src/lib/arc/controller.ts', 'utf8')), context);
+    const c = exports.createArcImportController({proxy: () => proxy, timeoutMs});
+    return {
+        c, proxy, calls, order: () => order, listeners,
+        state: () => stores.get(c.state),
+        emit: raw => [...listeners].forEach(l => l(structuredClone(raw))),
+        count: name => calls.filter(call => call[0] === name).length,
+    };
+}
