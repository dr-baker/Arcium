+struct ArcSpacesImport::SourceLease {
+  explicit SourceLease(std::string identity) : key(std::move(identity)) {
+    ActiveSources().insert(key);
+  }
+  ~SourceLease() { ActiveSources().erase(key); }
+  std::string key;
+};
