+std::optional<std::string> GetArcLocalMachineId() {
+  // Read the file rather than querying CFPreferences, which can consult a
+  // daemon/cache outside an explicitly selected test user's Library.
+  const base::FilePath path = base::apple::GetUserLibraryPath()
+      .Append("Preferences")
+      .Append("company.thebrowser.Browser.plist");
+  std::string contents;
+  if (!base::ReadFileToStringWithMaxSize(path, &contents, 1024 * 1024)) {
+    return std::nullopt;
+  }
+  @autoreleasepool {
+    NSData* data = [NSData dataWithBytes:contents.data()
+                                length:contents.size()];
+    NSDictionary* preferences = base::apple::ObjCCast<NSDictionary>(
+        [NSPropertyListSerialization propertyListWithData:data
+                                                 options:NSPropertyListImmutable
+                                                  format:nullptr
+                                                   error:nullptr]);
+    NSString* machine_id = base::apple::ObjCCast<NSString>(
+        preferences[@"machineID"]);
+    if (!machine_id || machine_id.length == 0 || machine_id.length > 1024) {
+      return std::nullopt;
+    }
+    return base::SysNSStringToUTF8(machine_id);
+  }
+}
