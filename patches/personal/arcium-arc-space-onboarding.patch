+    const done = $derived(status === "succeeded");
+    const working = $derived(status === "running" || status === "queued");
+    const failed = $derived(status === "failed");
+    const locked = $derived(done || busy);
+
+    const meta = $derived(
+        status === "failed" ? failureLabel(outcome?.failure)
+        : status === "cancelled" ? s.spaces.stoppedItem
+        : status === "running" ? s.spaces.importingItem
+        : status === "queued" ? s.spaces.queued
+        : done ? s.spaces.imported
+        : again ? s.spaces.importedBefore
+        : space.favoritesOnly ? favoritesLabel(space.favorites)
+        : pinsLabel(space.pins)
+    );
