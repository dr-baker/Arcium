+import assert from 'node:assert/strict';
+import test from 'node:test';
+import * as S from '../src/lib/arc/spaces.ts';
+
+const space = (generation = 1) => ({
+    token: `g${generation}-space`, identity: 'stable-space', profileToken: 'source',
+    name: 'Example', profileLabel: 'Arc', pins: 3, folders: 0, favorites: 2,
+    favoritesOnly: false,
+});
+const snapshot = (extra = {}) => ({
+    generation: 1, batchId: 0, phase: 'ready', failure: '',
+    spaces: [space()], jobs: [], canOpen: false, ...extra,
+});
+const apply = (model, raw) => {
+    const parsed = S.parseState(raw);
+    assert.ok(parsed, 'fixture follows the actual backend snapshot contract');
+    return S.applySnapshot(model, parsed);
+};
+const incomplete = () => apply(S.initialModel(), snapshot({failure: 'sidebar_unreadable'}));
+const warning = model => S.inventoryIncomplete(model);
+
+// Uses the same request/batch attribution as the one-click and picker paths.
+test('partial inventory warning survives a successful import after the backend clears failure', () => {
+    let model = incomplete();
+    assert.equal(warning(model), true);
+    const request = S.buildStart(model);
+    assert.ok(request);
+    model = S.markStarting(model, request);
+    assert.equal(warning(model), true);
+    const job = {
+        id: 1, tokens: request.tokens, profileLabel: 'Arc', state: 'pending',
+        failure: '', mayHavePartialData: false, historyFinished: false,
+        counts: {spaces: 1, pins: 3, folders: 0, favorites: 2},
+    };
+    model = apply(model, snapshot({batchId: 1, phase: 'validating', jobs: [job]}));
+    assert.equal(warning(model), true);
+    model = apply(model, snapshot({batchId: 1, phase: 'running', jobs: [{...job, state: 'running'}]}));
+    assert.equal(warning(model), true);
+    model = apply(model, snapshot({batchId: 1, phase: 'finished', canOpen: true,
+        jobs: [{...job, state: 'succeeded'}]}));
+    assert.equal(S.summarize(model).imported, 1);
+    assert.equal(model.snapshot.failure, '');
+    assert.equal(warning(model), true);
+    assert.equal(S.canOpen(model), true);
+});
+
+for (const refresh of ['auto', 'user']) {
+    test(`${refresh} reread keeps warning while loading, unreachable, or failed`, () => {
+        let model = incomplete();
+        if (refresh === 'user') model = S.requestRefresh(model);
+        model = apply(model, snapshot({generation: 2, phase: 'loading', spaces: []}));
+        assert.equal(warning(model), true);
+        model = S.markUnreachable(model);
+        assert.equal(warning(model), true);
+        model = apply(model, snapshot({generation: 2, phase: 'failed', spaces: [], failure: 'sidebar_unreadable'}));
+        assert.equal(S.load(model), 'failed');
+        assert.equal(warning(model), true);
+    });
+}
+
+test('only a completed clean inventory clears the warning, including a valid empty inventory', () => {
+    for (const spaces of [[space(2)], []]) {
+        let model = incomplete();
+        model = apply(model, snapshot({generation: 2, phase: 'loading', spaces: []}));
+        assert.equal(warning(model), true);
+        model = apply(model, snapshot({generation: 2, spaces}));
+        assert.equal(warning(model), false);
+    }
+});
+
+test('a repeated incomplete inventory and a cancelled batch keep the warning', () => {
+    let model = apply(incomplete(), snapshot({generation: 2, spaces: [space(2)], failure: 'sidebar_unreadable'}));
+    model = apply(model, snapshot({generation: 2, batchId: 1, phase: 'running', spaces: [space(2)]}));
+    model = apply(model, snapshot({generation: 2, batchId: 1, phase: 'finished', spaces: [space(2)],
+        jobs: [{id: 1, tokens: ['g2-space'], profileLabel: 'Arc', state: 'cancelled',
+            failure: '', mayHavePartialData: false, historyFinished: false, counts: {}}]}));
+    assert.equal(warning(model), true);
+});
+
+test('late clean inventories cannot erase the warning from a newer or running inventory', () => {
+    let model = apply(S.initialModel(), snapshot({generation: 2, spaces: [space(2)], failure: 'sidebar_unreadable'}));
+    model = apply(model, snapshot());
+    assert.equal(warning(model), true);
+    model = apply(model, snapshot({generation: 2, batchId: 1, phase: 'running', spaces: [space(2)]}));
+    model = apply(model, snapshot({generation: 2, spaces: [space(2)]}));
+    assert.equal(warning(model), true);
+});
+
+test('empty valid source has no warning; an unreadable initial inventory does', () => {
+    assert.equal(warning(S.initialModel()), false);
+    assert.equal(warning(apply(S.initialModel(), snapshot({spaces: []}))), false);
+    assert.equal(warning(apply(S.initialModel(), snapshot({phase: 'failed', spaces: [], failure: 'sidebar_unreadable'}))), true);
+});
