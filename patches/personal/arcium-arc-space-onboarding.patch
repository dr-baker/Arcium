+        line-height: 1;
+        color: hsl(var(--hue) 45% 34%);
+        background-color: hsl(var(--hue) 62% 52% / 0.16);
+
+        &.favorites {
+            color: var(--helium-blue);
+            background-color: color-mix(in srgb, var(--helium-blue) 14%, transparent);
+        }
+
+        & :global(svg) {
+            width: 16px;
+            height: 16px;
+        }
+    }
+
+    .name {
+        overflow: hidden;
+        font-size: 16px;
+        color: var(--primary);
+        text-overflow: ellipsis;
+        white-space: nowrap;
+    }
+
+    .meta {
+        font-size: 14px;
+        color: var(--tertiary);
+        white-space: nowrap;
+        font-variant-numeric: tabular-nums;
+    }
+
+    .failed .meta {
+        color: var(--red, #c4234f);
+    }
+
+    .mark {
+        display: grid;
+        place-items: center;
+        width: 20px;
+        height: 20px;
+        border-radius: 50%;
+        font-size: 12px;
+        font-weight: 700;
+        color: var(--white);
+        box-shadow: inset 0 0 0 1.5px var(--helium-elevated-20);
+
+        & :global(svg) {
+            width: 12px;
+            height: 12px;
+            stroke-width: 3px;
+        }
+    }
+
+    .working .mark {
+        color: var(--helium-blue);
+        box-shadow: inset 0 0 0 1.5px color-mix(in srgb, var(--helium-blue) 30%, transparent);
