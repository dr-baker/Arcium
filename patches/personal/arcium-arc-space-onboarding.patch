+import assert from 'node:assert/strict';
+import {readFileSync} from 'node:fs';
+import {createRequire} from 'node:module';
+import path from 'node:path';
+import {fileURLToPath, pathToFileURL} from 'node:url';
+import test from 'node:test';
+import vm from 'node:vm';
+
+const project = process.env.ARCIUM_ONBOARDING_TEST_PROJECT ??
+    path.resolve(path.dirname(fileURLToPath(import.meta.url)), '..');
+const require = createRequire(path.join(project, 'package.json'));
+const ts = require('typescript');
+const stores = await import(pathToFileURL(require.resolve('svelte/store')));
+const S = await import(pathToFileURL(path.join(project, 'src/lib/arc/spaces.ts')));
+const source = process.env.ARCIUM_ACK_CONTROLLER ?? path.join(project, 'src/lib/arc/controller.ts');
+const tick = () => new Promise(resolve => setImmediate(resolve));
+const wait = ms => new Promise(resolve => setTimeout(resolve, ms));
+const plain = value => JSON.parse(JSON.stringify(value));
+const spaces = [
+    {token: 'token-a', identity: 'space-a', profileToken: 'profile-a', name: 'A', profileLabel: 'A',
+        pins: 1, folders: 0, favorites: 0, favoritesOnly: false},
+    {token: 'token-b', identity: 'space-b', profileToken: 'profile-b', name: 'B', profileLabel: 'B',
+        pins: 1, folders: 0, favorites: 0, favoritesOnly: false},
+];
+const snap = (extra = {}) => ({generation: 1, batchId: 0, phase: 'ready', failure: '', spaces,
+    jobs: [], canOpen: false, ...extra});
+const job = (id, token, state) => ({id, tokens: [token], profileLabel: token, state, failure: '',
+    mayHavePartialData: state === 'failed', historyFinished: false,
+    counts: {spaces: state === 'succeeded' ? 1 : 0, pins: 0, folders: 0, favorites: 0}});
+const firstJobs = () => [job(1, 'token-a', 'succeeded'), job(2, 'token-b', 'failed')];
+const deferred = () => {
+    let resolve, reject;
+    const promise = new Promise((ok, no) => { resolve = ok; reject = no; });
+    return {promise, resolve, reject};
+};
+function harness(timeoutMs = 40) {
+    const listeners = new Set();
+    const calls = [];
+    const requests = [];
+    const reads = [];
+    let initializes = 0;
+    const proxy = {
+        onStateChanged: callback => { listeners.add(callback); return () => listeners.delete(callback); },
+        initialize: () => { initializes++; return Promise.resolve(snap()); },
+        getState: () => { reads.push(true); return proxy.stateReply(); },
+        stateReply: () => Promise.resolve(snap()),
+        start: request => {
+            calls.push(plain(request));
+            const reply = deferred();
+            requests.push(reply);
+            return reply.promise;
+        },
+        cancel: batchId => Promise.resolve(snap({batchId, phase: 'finished',
+            jobs: [job(1, 'token-a', 'cancelled'), job(2, 'token-b', 'cancelled')]})),
+        open: () => Promise.resolve(true),
+    };
+    const exports = {};
+    const context = vm.createContext({exports, setTimeout, clearTimeout,
+        require: name => name === 'svelte/store' ? stores : name === './spaces' ? S : assert.fail(name)});
+    vm.runInContext(ts.transpileModule(readFileSync(source, 'utf8'), {compilerOptions: {
+        target: ts.ScriptTarget.ES2022, module: ts.ModuleKind.CommonJS,
+    }}).outputText, context);
+    const c = exports.createArcImportController({proxy: () => proxy, timeoutMs});
+    return {c, proxy, calls, requests, reads, initializes: () => initializes, state: () => stores.get(c.state),
+        emit: snapshot => listeners.forEach(fn => fn(structuredClone(snapshot)))};
+}
+
+test('lost Start reply with streamed partial results permits exactly one failed-token retry', async () => {
+    const h = harness();
+    h.c.prefetch();
