+<script lang="ts">
+    import { IconCheck, Spinner } from "@imput/helium-prism";
+    import { s } from "../lib/strings";
+    import { failureLabel, favoritesLabel, pinsLabel } from "../lib/arc";
+    import { glyphHue, monogram } from "../lib/arc/glyph";
+    import type { Entry, TileOutcome } from "../lib/arc/spaces";
+
+    import IconStar from "../icons/tabler/IconStar.svelte";
+
+    type Props = {
+        entry: Entry;
+        outcome?: TileOutcome;
+        /** Imported earlier in this page and not part of this import. */
+        again: boolean;
+    };
+
+    const { entry, outcome, again }: Props = $props();
+
+    const space = $derived(entry.space);
+    const name = $derived(
+        space.favoritesOnly ? s.spaces.favorites : space.name || s.spaces.untitled
+    );
+    const status = $derived(outcome?.status ?? "idle");
+    const done = $derived(status === "succeeded");
+    const count = $derived(
+        space.favoritesOnly ? favoritesLabel(space.favorites) : pinsLabel(space.pins)
+    );
+    // A finished row keeps its Pin count; the check says it arrived.
+    const meta = $derived(
+        status === "failed" ? failureLabel(outcome?.failure)
+        : status === "cancelled" ? s.spaces.stoppedItem
+        : status === "running" ? s.spaces.importingItem
+        : status === "queued" ? s.spaces.queued
+        : again && !done ? s.spaces.importedBefore
+        : count
+    );
+</script>
+
+<!-- Read-only progress row in the one-click import. Nothing here is chosen. -->
+<li
+    class="space-row"
+    class:done
+    class:working={status === "running" || status === "queued"}
+    class:failed={status === "failed"}
+    style:--hue={glyphHue(name)}
+>
+    <span class="glyph" class:favorites={space.favoritesOnly} aria-hidden="true">
+        {#if space.favoritesOnly}
+            <IconStar />
+        {:else}
+            {monogram(name)}
+        {/if}
+    </span>
+    <span class="name">{name}</span>
+    <span class="meta">
+        {meta}
+        {#if done}
+            <span class="visually-hidden">{s.spaces.imported}</span>
+        {/if}
+    </span>
+    <span class="mark" aria-hidden="true">
+        {#if status === "running"}
+            <Spinner size={12} />
+        {:else if status === "failed"}
+            !
+        {:else if done}
+            <IconCheck />
+        {/if}
+    </span>
+</li>
+
+<style>
