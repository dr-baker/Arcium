+void ArcSpacesImport::Discover() {
+  if (busy())
+    return;
+  ++generation_;
+  phase_ = "loading";
+  failure_.clear();
+  entries_.clear();
+  groups_.clear();
+  results_.clear();
+  previous_results_.clear();
+  successful_tokens_.clear();
+  successful_favorite_sources_.clear();
+  importer_list_ = std::make_unique<ImporterList>();
+  importer_list_->DetectSourceProfiles(
+      g_browser_process->GetApplicationLocale(), false,
+      base::BindOnce(&ArcSpacesImport::SourcesDetected,
+                     weak_factory_.GetWeakPtr(), generation_));
+  Changed();
+}
+void ArcSpacesImport::SourcesDetected(int generation) {
+  if (generation != generation_ || !importer_list_ || phase_ != "loading")
+    return;
+  std::vector<user_data_importer::SourceProfile> sources;
+  for (size_t i = 0; i < importer_list_->count(); ++i) {
+    const auto& source = importer_list_->GetSourceProfileAt(i);
+    if (source.importer_type == user_data_importer::TYPE_ARC &&
+        (source.services_supported & user_data_importer::FAVORITES))
+      sources.push_back(source);
+  }
+  base::ThreadPool::PostTaskAndReplyWithResult(
+      FROM_HERE, {base::MayBlock(), base::TaskPriority::USER_VISIBLE},
+      base::BindOnce(&ArcSpacesImport::ReadInventory, std::move(sources),
+                     base::Uuid::GenerateRandomV4().AsLowercaseString()),
+      base::BindOnce(&ArcSpacesImport::InventoryReady,
+                     weak_factory_.GetWeakPtr(), generation));
+}
+ArcSpacesImport::Inventory ArcSpacesImport::ReadInventory(
+    std::vector<user_data_importer::SourceProfile> sources,
+    std::string nonce) {
+  Inventory inventory;
+  const std::string local_machine_id = LocalMachineId();
+  std::map<base::FilePath, std::optional<std::string>> files;
+  std::set<std::string> identities;
+  std::map<std::u16string, int> label_counts, label_ordinals;
+  for (const auto& source : sources)
+    ++label_counts[source.profile.empty() ? u"Arc" : source.profile];
+  for (const auto& source : sources) {
+    const auto path = SidebarPath(source);
+    if (!files.contains(path))
+      files.emplace(path, ReadStable(path));
+    const auto& bytes = files.at(path);
+    auto root = bytes ? base::JSONReader::ReadDict(
+                            *bytes, base::JSON_PARSE_CHROMIUM_EXTENSIONS)
+                      : std::nullopt;
+    const std::string source_id = source.source_path.BaseName().AsUTF8Unsafe();
+    auto snapshot =
+        root ? ParseArcSidebarSnapshot(*root, source_id, local_machine_id)
+             : std::nullopt;
+    if (!snapshot) {
+      // Do not silently report a successful empty inventory on parse failure.
+      inventory.failure = "sidebar_unreadable";
+      continue;
+    }
+    const std::string source_machine_id = local_machine_id;
+    std::string identity_material = path.AsUTF8Unsafe();
+    identity_material.append(1, '\0').append(source_id).append(1, '\0').append(
+        source_machine_id);
+    const std::string identity = Digest(identity_material);
+    if (!identities.insert(identity).second)
+      continue;
+    int favorites = 0, favorite_folders = 0;
+    Count(snapshot->favorites, favorites, favorite_folders);
+    const std::u16string base_label =
+        source.profile.empty() ? u"Arc" : source.profile;
+    std::string profile_label = base::UTF16ToUTF8(base_label);
+    if (label_counts[base_label] > 1)
+      profile_label +=
+          " (" + base::NumberToString(++label_ordinals[base_label]) + ")";
+    auto make_entry = [&] {
+      Entry entry;
+      entry.token =
+          nonce + "-" + base::NumberToString(inventory.entries.size());
+      entry.source_key = identity;
+      entry.profile_token = Digest("profile\n" + identity);
+      entry.source = source;
+      entry.profile_label = profile_label;
+      entry.sidebar_path = path;
+      entry.fingerprint = SnapshotFingerprint(*snapshot);
+      entry.machine_id = source_machine_id;
+      entry.favorites = favorites;
+      return entry;
+    };
+    for (const auto& space : snapshot->spaces) {
+      Entry entry = make_entry();
+      entry.name = space.name;
+      entry.space_id = space.id;
+      entry.identity = Digest(identity + "\nspace\n" + space.id);
+      Count(space.pins, entry.pins, entry.folders);
+      inventory.entries.push_back(std::move(entry));
+    }
+    if (snapshot->spaces.empty() && favorites > 0) {
+      Entry entry = make_entry();
+      entry.name = "Favorites";
+      entry.favorites_only = true;
+      entry.identity = Digest(identity + "\nfavorites");
+      inventory.entries.push_back(std::move(entry));
+    }
+  }
+  return inventory;
+}
+void ArcSpacesImport::InventoryReady(int generation, Inventory inventory) {
+  if (generation != generation_ || phase_ != "loading")
+    return;
+  entries_ = std::move(inventory.entries);
+  failure_ = std::move(inventory.failure);
+  phase_ = entries_.empty() && !failure_.empty() ? "failed" : "ready";
+  Changed();
+}
+bool ArcSpacesImport::SourcesUnchanged(
+    std::vector<Group> groups,
+    std::optional<std::string> machine_id_override) {
+  const std::string local_machine_id =
+      machine_id_override ? *machine_id_override : LocalMachineId();
+  std::map<base::FilePath, std::optional<std::string>> files;
+  for (const auto& group : groups) {
+    if (group.machine_id != local_machine_id ||
+        !base::DirectoryExists(group.source.source_path))
+      return false;
+    if (!files.contains(group.sidebar_path))
+      files.emplace(group.sidebar_path, ReadStable(group.sidebar_path));
+    const auto& bytes = files.at(group.sidebar_path);
+    auto root = bytes ? base::JSONReader::ReadDict(
+                            *bytes, base::JSON_PARSE_CHROMIUM_EXTENSIONS)
+                      : std::nullopt;
+    auto snapshot =
+        root ? ParseArcSidebarSnapshot(*root, group.selection.source_profile,
+                                       local_machine_id)
+             : std::nullopt;
+    if (!snapshot || SnapshotFingerprint(*snapshot) != group.fingerprint)
+      return false;
+  }
+  return true;
+}
+std::string ArcSpacesImport::Start(int generation,
+                                   std::vector<std::string> tokens,
+                                   bool history) {
+  if (busy() || phase_ == "loading")
+    return "busy";
+  if (generation != generation_)
+    return "stale_selection";
+  auto groups = GroupSelection(entries_, tokens, successful_tokens_);
+  if (!groups)
+    return "stale_selection";
+  if (groups->empty())
+    return "nothing_selected";
+  groups_ = std::move(*groups);
+  for (auto& group : groups_)
+    group.selection.include_favorites =
+        !successful_favorite_sources_.contains(group.source_key);
+  previous_results_.insert(previous_results_.end(), results_.begin(),
+                           results_.end());
+  results_.clear();
+  for (size_t i = 0; i < groups_.size(); ++i) {
+    Result result;
+    result.id = ++next_job_id_;
+    result.tokens = groups_[i].tokens;
+    result.label = groups_[i].profile_label;
+    results_.push_back(std::move(result));
+  }
+  ++batch_id_;
+  current_ = 0;
+  history_ = history;
+  cancelled_ = false;
+  phase_ = "validating";
+  failure_.clear();
+  base::ThreadPool::PostTaskAndReplyWithResult(
+      FROM_HERE, {base::MayBlock(), base::TaskPriority::USER_VISIBLE},
+      base::BindOnce(&ArcSpacesImport::SourcesUnchanged, groups_,
+                     machine_id_for_testing_),
+      base::BindOnce(&ArcSpacesImport::Validated, weak_factory_.GetWeakPtr(),
+                     batch_id_));
+  Changed();
+  return {};
+}
+void ArcSpacesImport::Validated(int batch_id, bool unchanged) {
+  if (batch_id != batch_id_ || phase_ != "validating")
+    return;
+  if (cancelled_) {
+    Finish();
+    return;
+  }
+  if (!unchanged) {
+    failure_ = "source_changed";
+    for (auto& result : results_) {
+      result.state = "failed";
+      result.failure = failure_;
+    }
+    phase_ = "failed";
+    Changed();
+    return;
+  }
+  phase_ = "running";
+  Next();
+}
+void ArcSpacesImport::Next() {
+  coordinator_.reset();
+  keep_alive_.reset();
+  source_lease_.reset();
+  if (cancelled_ || current_ >= groups_.size()) {
+    Finish();
+    return;
+  }
+  const Group& group = groups_[current_];
+  if (ActiveSources().contains(group.source_key)) {
+    CompleteCurrent("failed", "busy");
+    return;
+  }
+  source_lease_ = std::make_shared<SourceLease>(group.source_key);
+  auto* manager =
+      g_browser_process ? g_browser_process->profile_manager() : nullptr;
+  auto* local_state =
+      g_browser_process ? g_browser_process->local_state() : nullptr;
+  if (!manager || !local_state) {
+    CompleteCurrent("failed", "destination_closed");
+    return;
+  }
+  const auto& mapping =
+      local_state->GetDict(prefs::kArciumArcImportDestinations);
+  const std::string* directory = mapping.FindString(group.source_key);
+  results_[current_].state = "creating_profile";
+  Changed();
+  if (directory) {
+    if (!ValidMapping(mapping, group.source_key, *directory)) {
+      CompleteCurrent("failed", "invalid_destination_mapping");
+      return;
+    }
+    const auto path = manager->user_data_dir().Append(
+        base::FilePath::FromUTF8Unsafe(*directory));
+    if (!manager->GetProfileAttributesStorage().GetProfileAttributesWithPath(
+            path)) {
+      CompleteCurrent("failed", "invalid_destination_mapping");
+      return;
+    }
+    manager->CreateProfileAsync(
+        path, base::BindOnce(&ArcSpacesImport::DestinationInitialized,
+                             weak_factory_.GetWeakPtr(), source_lease_,
+                             group.source_key, false, base::DictValue()));
+  } else {
+    if (!local_state->GetBoolean(prefs::kBrowserAddPersonEnabled)) {
+      CompleteCurrent("failed", "policy_blocked");
+      return;
+    }
+    ProfileManager::CreateMultiProfileAsync(
+        u"Arc · " + base::UTF8ToUTF16(group.profile_label), 0, false,
+        base::BindOnce(&ArcSpacesImport::DestinationInitialized,
+                       weak_factory_.GetWeakPtr(), source_lease_,
+                       group.source_key, true, new_profile_appearance_.Clone()));
+  }
+}
+void ArcSpacesImport::DestinationInitialized(
+    base::WeakPtr<ArcSpacesImport> owner,
+    std::shared_ptr<SourceLease> lease,
+    std::string source_key,
+    bool newly_created,
+    base::DictValue appearance,
+    Profile* profile) {
+  auto* manager =
+      g_browser_process ? g_browser_process->profile_manager() : nullptr;
+  auto* local_state =
+      g_browser_process ? g_browser_process->local_state() : nullptr;
+  std::string failure;
+  if (!manager || !local_state || !profile ||
+      !manager->IsValidProfile(profile) || profile->IsOffTheRecord() ||
+      !profile->IsRegularProfile()) {
+    failure = "destination_closed";
+  } else if (newly_created &&
+             (profile->GetPrefs()->GetInitializationStatus() !=
+                  PrefService::INITIALIZATION_STATUS_CREATED_NEW_PREF_STORE ||
+              !profile->GetPrefs()
+                   ->GetString(prefs::kArciumArcImportSourceMarker)
+                   .empty())) {
+    // ProfileManager allocates the directory, but stale numbering can point at
+    // an unregistered on-disk profile. Never silently adopt an existing store.
+    failure = "invalid_destination_mapping";
+  } else if (newly_created) {
+    const auto directory = profile->GetPath().BaseName().AsUTF8Unsafe();
+    // This callback deliberately persists an accepted creation even after the
+    // page closes. It never starts import without the live owner. Retry can
+    // reuse this otherwise-empty profile instead of creating an orphan chain.
+    auto proposed =
+        local_state->GetDict(prefs::kArciumArcImportDestinations).Clone();
+    if (proposed.contains(source_key)) {
+      failure = "invalid_destination_mapping";
+    } else {
+      proposed.Set(source_key, directory);
+      if (!ValidMapping(proposed, source_key, directory)) {
+        failure = "invalid_destination_mapping";
+      } else {
+        auto* profile_prefs = profile->GetPrefs();
+        // Only an accepted, newly created destination inherits appearance.
+        // The callback owns the snapshot even if its welcome page has closed.
+        for (const auto [name, value] : appearance) {
+          const auto* preference = profile_prefs->FindPreference(name);
+          if (preference && preference->GetType() == value.type() &&
+              profile_prefs->IsUserModifiablePreference(name)) {
+            profile_prefs->Set(name, value);
+          }
+        }
+        profile_prefs->SetString(prefs::kArciumArcImportSourceMarker,
+                                 source_key);
+        profile_prefs->SetBoolean(prefs::kHeliumServicesEnabled, false);
+        profile_prefs->SetBoolean(prefs::kHeliumServicesConsented, false);
+        profile_prefs->SetBoolean(prefs::kHeliumDidOnboarding, true);
+        ScopedDictPrefUpdate update(local_state,
+                                    prefs::kArciumArcImportDestinations);
+        update->Set(source_key, directory);
+      }
+    }
+  } else if (profile->GetPrefs()->GetString(
+                 prefs::kArciumArcImportSourceMarker) != source_key ||
+             !ValidMapping(
+                 local_state->GetDict(prefs::kArciumArcImportDestinations),
+                 source_key, profile->GetPath().BaseName().AsUTF8Unsafe())) {
+    failure = "invalid_destination_mapping";
+  }
+  if (owner)
+    owner->DestinationReady(failure.empty() ? profile : nullptr,
+                            std::move(failure));
+}
+void ArcSpacesImport::DestinationReady(Profile* profile, std::string failure) {
+  if (cancelled_) {
+    Finish();
+    return;
+  }
+  if (!failure.empty() || !profile) {
+    CompleteCurrent(
+        "failed", failure.empty() ? "destination_closed" : std::move(failure));
+    return;
+  }
+  keep_alive_ = ScopedProfileKeepAlive::TryAcquire(
+      profile, ProfileKeepAliveOrigin::kArciumSettingsWindow);
+  if (!keep_alive_) {
+    CompleteCurrent("failed", "destination_closed");
+    return;
+  }
+  coordinator_ = std::make_unique<ArcImportCoordinator>(
+      profile, base::BindRepeating(&ArcSpacesImport::CoordinatorChanged,
+                                   weak_factory_.GetWeakPtr()));
+  coordinator_->PrepareSource(groups_[current_].source);
+  // Recheck after asynchronous profile creation as Arc may have changed while
+  // it was loading. No imported data has been written before this gate.
+  base::ThreadPool::PostTaskAndReplyWithResult(
+      FROM_HERE, {base::MayBlock(), base::TaskPriority::USER_VISIBLE},
+      base::BindOnce(&ArcSpacesImport::SourcesUnchanged,
+                     std::vector<Group>{groups_[current_]},
+                     machine_id_for_testing_),
+      base::BindOnce(
+          [](base::WeakPtr<ArcSpacesImport> self, int batch_id, size_t current,
+             bool unchanged) {
+            if (!self || self->batch_id_ != batch_id ||
+                self->current_ != current || !self->coordinator_)
+              return;
+            if (self->cancelled_) {
+              self->Finish();
+              return;
+            }
+            if (!unchanged) {
+              self->CompleteCurrent("failed", "source_changed");
+              return;
+            }
+            auto* coordinator = self->coordinator_.get();
+            if (!coordinator->destination() || coordinator->sources().empty()) {
+              self->CompleteCurrent("failed", "destination_closed");
+              return;
+            }
+            // Saved Pins are mandatory for this flow. Never downgrade a blocked
+            // sidebar import into a history-only 'success'.
+            if (self->history_ &&
+                !(self->groups_[current].source.services_supported &
+                  user_data_importer::HISTORY)) {
+              self->CompleteCurrent("failed", "history_unavailable");
+              return;
+            }
+            if (!coordinator->sidebar_allowed() ||
+                (self->history_ && !coordinator->history_allowed())) {
+              self->CompleteCurrent("failed", "policy_blocked");
+              return;
+            }
+            self->results_[current].state = "running";
+            const auto failure = coordinator->Start(
+                coordinator->sources().front().token, true, self->history_,
+                self->groups_[current].selection);
+            if (failure != ArcImportCoordinator::Failure::kNone) {
+              self->CompleteCurrent(
+                  "failed", ArcImportCoordinator::FailureToString(failure));
+              return;
+            }
+            self->Changed();
+          },
+          weak_factory_.GetWeakPtr(), batch_id_, current_));
+}
+void ArcSpacesImport::CoordinatorChanged() {
+  if (!coordinator_ || current_ >= results_.size() ||
+      results_[current_].state != "running")
+    return;
+  const auto& job = coordinator_->job();
+  auto& result = results_[current_];
+  if (job) {
+    result.partial = job->may_have_partial_data;
+    result.history_finished = job->history_finished;
+  }
+  if (coordinator_->phase() != ArcImportCoordinator::Phase::kFinished) {
+    Changed();
+    return;
+  }
+  if (!job)
+    return;
+  result.counts = job->counts;
+  using Outcome = ArcImportCoordinator::Outcome;
+  const bool success =
+      job->outcome == Outcome::kSucceeded || job->outcome == Outcome::kEmpty;
+  if (success) {
+    successful_favorite_sources_.insert(groups_[current_].source_key);
+    successful_tokens_.insert(groups_[current_].tokens.begin(),
+                              groups_[current_].tokens.end());
+    if (first_space_id_.empty() && !job->first_space_id.empty() &&
+        coordinator_->destination()) {
+      first_profile_path_ = coordinator_->destination()->GetPath();
+      first_space_id_ = job->first_space_id;
+    }
+  }
+  CompleteCurrent(
+      success ? (job->outcome == Outcome::kEmpty ? "empty" : "succeeded")
+      : job->outcome == Outcome::kCancelled ? "cancelled"
+                                            : "failed",
+      job->failure == ArcImportCoordinator::Failure::kNone
+          ? ""
+          : ArcImportCoordinator::FailureToString(job->failure));
+}
+void ArcSpacesImport::CompleteCurrent(std::string state, std::string failure) {
+  if (current_ >= results_.size())
+    return;
+  results_[current_].state = std::move(state);
+  results_[current_].failure = std::move(failure);
+  ++current_;
+  // Never destroy a coordinator inside its changed callback stack.
+  base::SequencedTaskRunner::GetCurrentDefault()->PostTask(
+      FROM_HERE,
+      base::BindOnce(&ArcSpacesImport::Next, weak_factory_.GetWeakPtr()));
+  Changed();
+}
+std::string ArcSpacesImport::Cancel(int batch_id) {
+  if (batch_id != batch_id_)
+    return "stale_batch";
+  cancelled_ = true;
+  if (phase_ == "loading") {
+    // Discovery and read workers may finish, but their replies must not revive
+    // this cancelled inventory. No import owns a source lease while loading.
+    weak_factory_.InvalidateWeakPtrs();
+    importer_list_.reset();
+    Finish();
+    return {};
+  }
+  if (coordinator_ &&
+      coordinator_->phase() == ArcImportCoordinator::Phase::kRunning)
+    coordinator_->Cancel();
+  // Pending profile callbacks and validation replies own their cancellation
+  // completion. Do not release their source lease prematurely.
+  if (!busy())
+    Changed();
+  return {};
+}
+void ArcSpacesImport::Finish() {
+  coordinator_.reset();
+  keep_alive_.reset();
+  source_lease_.reset();
+  if (cancelled_) {
+    for (auto& result : results_) {
+      if (result.state == "pending" || result.state == "creating_profile" ||
+          result.state == "running")
+        result.state = "cancelled";
+    }
+  }
+  phase_ = "finished";
+  Changed();
+}
+bool ArcSpacesImport::Open(int batch_id) {
+  if (batch_id != batch_id_ || busy() || first_space_id_.empty())
+    return false;
+  helium::OpenSpaceFromDirectory(first_profile_path_, first_space_id_,
+                                 std::nullopt);
+  return true;
+}
+base::DictValue ArcSpacesImport::Snapshot() const {
+  base::ListValue entries, jobs;
+  for (const auto& entry : entries_) {
+    entries.Append(base::DictValue()
+                       .Set("token", entry.token)
+                       .Set("identity", entry.identity)
+                       .Set("profileToken", entry.profile_token)
+                       .Set("name", entry.name)
+                       .Set("profileLabel", entry.profile_label)
+                       .Set("pins", entry.pins)
+                       .Set("folders", entry.folders)
+                       .Set("favorites", entry.favorites)
+                       .Set("favoritesOnly", entry.favorites_only));
+  }
+  auto append_job = [&jobs](const Result& result) {
+    base::ListValue tokens;
+    for (const auto& token : result.tokens)
+      tokens.Append(token);
+    jobs.Append(base::DictValue()
+                    .Set("id", result.id)
+                    .Set("tokens", std::move(tokens))
+                    .Set("profileLabel", result.label)
+                    .Set("state", result.state)
+                    .Set("failure", result.failure)
+                    .Set("mayHavePartialData", result.partial)
+                    .Set("historyFinished", result.history_finished)
+                    .Set("counts", CountsDict(result.counts)));
+  };
+  for (const auto& result : previous_results_)
+    append_job(result);
+  for (const auto& result : results_)
+    append_job(result);
+  return base::DictValue()
+      .Set("generation", generation_)
+      .Set("batchId", batch_id_)
+      .Set("phase", phase_)
+      .Set("failure", failure_)
+      .Set("spaces", std::move(entries))
+      .Set("jobs", std::move(jobs))
+      .Set("canOpen", !busy() && !first_space_id_.empty());
+}
+}  // namespace arcium
