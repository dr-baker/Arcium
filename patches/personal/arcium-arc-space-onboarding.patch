+base::DictValue ArcSpacesImportHandler::CaptureNewProfileAppearance(
+    const PrefService& source) {
+  // Secondary Chromium profiles do not receive installer initial preferences.
+  // Preserve explicit choices; otherwise start with Arcium's visible sidebar.
+  base::DictValue appearance;
+  appearance.Set(prefs::kHeliumLayout,
+                 static_cast<int>(HeliumLayoutType::kVertical));
+  appearance.Set(prefs::kHeliumCenteredLocationBar, true);
+  appearance.Set(prefs::kHeliumMinimalLocationBar, true);
+  appearance.Set(prefs::kHeliumPeekEnabled, true);
+  appearance.Set(prefs::kTabCyclingMRU, true);
+  appearance.Set(prefs::kHeliumVerticalRightAligned, false);
+  appearance.Set(prefs::kHeliumLittleArcExternalLinks, true);
+  appearance.Set(prefs::kArciumOmniboxPersistentItemsEnabled, true);
+  appearance.Set(prefs::kBrowserColorScheme, 1);
+  appearance.Set(arcium::kArcSidebarNavigationEnabledPref, false);
+  appearance.Set(arcium::kChromeUIScalePref, arcium::kChromeUIScaleDefault);
+  appearance.Set(arcium::kChromeFrameBorderWidthPref, 4);
+  appearance.Set(arcium::kCollapsedSidebarStylePref, 1);
+  appearance.Set(arcium::kShowToolbarPref, false);
+  appearance.Set(arcium_settings::kSharedPalettePref, base::DictValue());
+  appearance.Set(helium::kArciumChromeAppearancePref, base::DictValue());
+  appearance.Set(helium::kArciumSurfaceSetPref, helium::kSurfaceSetGlass);
+  appearance.Set(helium::kArciumSurfaceTuningPref, base::DictValue());
+  for (auto [name, value] : appearance) {
+    const auto* preference = source.FindPreference(name);
+    if (!preference || preference->GetType() != value.type()) {
+      continue;
+    }
+    // Dictionaries include the seeded palette and material configuration.
+    // An older unseeded profile keeps supported registered material defaults.
+    if (source.GetUserPrefValue(name) || preference->IsManaged() ||
+        value.is_dict()) {
+      value = preference->GetValue()->Clone();
+    }
+  }
+  return appearance;
+}
+
+ArcSpacesImportHandler::ArcSpacesImportHandler() = default;
+ArcSpacesImportHandler::~ArcSpacesImportHandler() = default;
+void ArcSpacesImportHandler::RegisterMessages() {
+  web_ui()->RegisterMessageCallback(
+      "initializeArcSpacesImport",
+      base::BindRepeating(&ArcSpacesImportHandler::Initialize,
+                          base::Unretained(this)));
+  web_ui()->RegisterMessageCallback(
+      "getArcSpacesImportState",
+      base::BindRepeating(&ArcSpacesImportHandler::GetState,
+                          base::Unretained(this)));
+  web_ui()->RegisterMessageCallback(
+      "startArcSpacesImport",
+      base::BindRepeating(&ArcSpacesImportHandler::Start,
+                          base::Unretained(this)));
+  web_ui()->RegisterMessageCallback(
+      "cancelArcSpacesImport",
+      base::BindRepeating(&ArcSpacesImportHandler::Cancel,
+                          base::Unretained(this)));
+  web_ui()->RegisterMessageCallback(
+      "openArcImportedSpace", base::BindRepeating(&ArcSpacesImportHandler::Open,
+                                                  base::Unretained(this)));
+}
+void ArcSpacesImportHandler::OnJavascriptDisallowed() {
+  // Destroys the coordinator and cancels its host; weak discovery and worker
+  // replies cannot reach the former page. No promise is resolved afterwards.
+  controller_.reset();
+}
+bool ArcSpacesImportHandler::BeginMessage(const base::ListValue& args) {
+  if (args.empty() || !args[0].is_string())
+    return false;  // No usable callback ID to reject.
+  AllowJavascript();
+  return true;
+}
+void ArcSpacesImportHandler::Reply(const base::ListValue& args,
+                                   std::string error) {
+  if (!error.empty())
+    RejectJavascriptCallback(args[0], base::Value(std::move(error)));
+  else
+    ResolveJavascriptCallback(args[0], controller_->Snapshot());
+}
+void ArcSpacesImportHandler::Initialize(const base::ListValue& args) {
+  if (!BeginMessage(args))
+    return;
+  if (args.size() != 1) {
+    Reply(args, "invalid_arguments");
+    return;
+  }
+  auto* profile = Profile::FromBrowserContext(
+      web_ui()->GetWebContents()->GetBrowserContext());
+  if (profile->IsOffTheRecord() || !profile->IsRegularProfile()) {
+    Reply(args, "unavailable");
+    return;
+  }
+  if (controller_ && controller_->busy()) {
+    Reply(args, "busy");
+    return;
+  }
+  if (!controller_)
+    controller_ = std::make_unique<arcium::ArcSpacesImport>(
+        base::BindRepeating(&ArcSpacesImportHandler::Changed,
+                            base::Unretained(this)),
+        CaptureNewProfileAppearance(*profile->GetPrefs()));
+  controller_->Discover();
+  Reply(args, "");
+}
+void ArcSpacesImportHandler::GetState(const base::ListValue& args) {
+  if (!BeginMessage(args)) {
+    return;
+  }
+  if (args.size() != 1) {
+    Reply(args, "invalid_arguments");
+    return;
+  }
+  if (!controller_) {
+    Reply(args, "unavailable");
+    return;
+  }
+  // A read-only barrier after earlier messages on this same WebUI pipe.
+  // In particular, do not Discover(), reset the ledger, or reject active jobs.
+  Reply(args, "");
+}
+
+void ArcSpacesImportHandler::Start(const base::ListValue& args) {
+  if (!BeginMessage(args))
+    return;
+  const auto* dict = args.size() == 2 ? args[1].GetIfDict() : nullptr;
+  const auto generation = dict ? dict->FindInt("generation") : std::nullopt;
+  const auto* tokens = dict ? dict->FindList("tokens") : nullptr;
+  const base::Value* history = dict ? dict->Find("history") : nullptr;
+  if (!controller_ || !dict || !generation || !tokens ||
+      tokens->size() > 10000 || (history && !history->is_bool())) {
+    Reply(args, "invalid_arguments");
+    return;
+  }
+  std::vector<std::string> selected;
+  for (const auto& token : *tokens) {
+    if (!token.is_string() || token.GetString().size() > 128) {
+      Reply(args, "invalid_arguments");
+      return;
+    }
+    selected.push_back(token.GetString());
+  }
+  Reply(args, controller_->Start(*generation, std::move(selected),
+                                 history && history->GetBool()));
+}
+void ArcSpacesImportHandler::Cancel(const base::ListValue& args) {
+  if (!BeginMessage(args))
+    return;
+  const auto* dict = args.size() == 2 ? args[1].GetIfDict() : nullptr;
+  const auto batch_id = dict ? dict->FindInt("batchId") : std::nullopt;
+  if (!controller_ || !batch_id) {
+    Reply(args, "invalid_arguments");
+    return;
+  }
+  Reply(args, controller_->Cancel(*batch_id));
+}
+void ArcSpacesImportHandler::Open(const base::ListValue& args) {
+  if (!BeginMessage(args))
+    return;
+  const auto* dict = args.size() == 2 ? args[1].GetIfDict() : nullptr;
+  const auto batch_id = dict ? dict->FindInt("batchId") : std::nullopt;
+  if (!controller_ || !batch_id) {
+    Reply(args, "invalid_arguments");
+    return;
+  }
+  if (*batch_id != controller_->batch_id()) {
+    Reply(args, "stale_batch");
+    return;
+  }
+  // Resolve before opening a Space: its browser may replace the welcome page.
+  if (!controller_->Snapshot().FindBool("canOpen").value_or(false)) {
+    Reply(args, "nothing_to_open");
+    return;
+  }
+  ResolveJavascriptCallback(args[0], base::Value(true));
+  controller_->Open(*batch_id);
+}
+void ArcSpacesImportHandler::Changed() {
+  if (controller_ && IsJavascriptAllowed())
+    FireWebUIListener("arc-spaces-import-state-changed",
+                      controller_->Snapshot());
+}
