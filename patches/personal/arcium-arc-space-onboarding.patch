+    await stop.c.reload();
+    stop.c.importAll();
+    await tick();
+    await stop.c.cancel();
+    assert.deepEqual(stop.calls.find(c => c[0] === 'cancel'), ['cancel', 1]);
+    const cancelled = withTokens(starts(stop)[0]);
+    cancelled[0].state = 'succeeded';
+    Object.assign(cancelled[1], {state: 'cancelled', mayHavePartialData: true});
+    cancelled[2].state = 'cancelled';
+    stop.emit(snap({batchId: 1, phase: 'finished', jobs: cancelled, canOpen: true}));
+    assert.deepEqual(view(stop), {kind: 'partial', imported: 2, missed: 2, stopped: true});
+    assert.equal(S.summarize(stop.state()).partial, true);
+});
+
+test('one click leaves Spaces unlocked by Check again alone, and the picker takes over cleanly', async () => {
+    let generation = 1;
+    const h = controller({initialize: () => Promise.resolve(snap({generation, spaces: spacesFor(generation)}))});
+    await h.c.reload();
+    h.c.importAll();
+    await tick();
+    h.emit(snap({batchId: 1, phase: 'finished', canOpen: true,
+        jobs: withTokens(starts(h)[0]).map(j => ({...j, state: 'succeeded'}))}));
+    generation = 2;
+    await h.c.reload();
+    assert.equal(h.state().again.size, 4);
+    h.c.importAll();
+    await tick();
+    assert.equal(h.count('start'), 1, 'replacing an imported sidebar needs the picker');
+    assert.deepEqual(view(h), {kind: 'done', imported: 4});
+
+    let model = S.prepareOneClick(S.requestOneClick(ready(), 1));
+    assert.equal(model.oneClick.stage, 'sent');
+    const request = S.buildStart(model);
+    assert.equal(S.markStarting(model, request, true).oneClick.stage, 'sent');
+    assert.equal(S.markStarting(model, request).oneClick.stage, 'idle', 'a picker request owns the result');
+    assert.equal(S.requestOneClick(S.markStarting(model, request, true), 1).oneClick.stage, 'sent',
+        'no second intent while a request runs');
+});
+
+function welcome({page = 'Welcome', model = ready(), openResult = true} = {}) {
+    const calls = [];
+    const effects = [], destroyers = [];
+    const record = name => (...args) => { calls.push([name, ...args]); };
+    const context = vm.createContext({
+        $state: value => value, $derived: value => value, $effect: fn => effects.push(fn), onDestroy: fn => destroyers.push(fn),
+        $currentPage: page, $arc: model, Spaces: S, $preferences: {completed_onboarding: false}, $preferencesBootstrap: "ready", retryPreferences: () => {}, standaloneImport: false,
+        oneClickStatus: () => ({text: '', failed: false}),
+        arcImport: {state: {}, prefetch: record('prefetch'), importAll: record('importAll'),
+            cancelOneClick: record('cancelOneClick'), cancel: record('cancel'),
+            canOpen: () => true, open: async () => { calls.push(['openImported']); return openResult; }},
+        chooseRoute: record('chooseRoute'), browserIconUrl: () => 'arc.avif',
+        parseLocalizedString: () => [], s: {welcome: {terms: ''}},
+        setPref: async (...args) => calls.push(['setPref', ...args]),
+        acceptLatestSchema: record('acceptLatestSchema'),
+        window: {open: record('open')},
+    });
+    context.completeOnboarding = () => context.setPref('completed_onboarding', true);
+    vm.runInContext(transpile(script('src/pages/Welcome.svelte'), true), context);
+    return {context, calls, run: code => vm.runInContext(code, context),
+        effects: () => effects.forEach(fn => fn()), destroy: () => destroyers.forEach(fn => fn())};
+}
+
+test('the first screen reads Arc on view but imports only from the button; leaving drops a waiting click', async () => {
+    const w = welcome();
+    w.effects();
+    assert.deepEqual(w.calls, [['prefetch']], 'mounting reads the inventory and nothing else');
+    w.run('primary()');
+    assert.deepEqual(w.calls.at(-1), ['importAll']);
+    w.destroy();
+    assert.deepEqual(w.calls.at(-1), ['cancelOneClick'], 'unmount drops the intent');
+
+    const away = welcome({page: 'HeliumServices'});
+    away.effects();
+    assert.deepEqual(away.calls, [['cancelOneClick']], 'a page change drops the intent');
+
+    const finding = welcome({model: S.requestOneClick(S.initialModel(), 1)});
+    finding.run('primary()');
+    assert.equal(finding.calls.length, 0, 'pressing again while finding does nothing');
+    finding.run('leave("arcCustom")');
+    assert.deepEqual(finding.calls, [['cancelOneClick'], ['chooseRoute', 'arcCustom']],
+        'Choose what to import cancels the waiting click before the picker opens');
+
+    let done = S.prepareOneClick(S.requestOneClick(ready(), 1));
+    const request = S.buildStart(done);
+    done = S.markStarting(done, request, true);
+    done = apply(done, {...plain(done.snapshot), batchId: 1, phase: 'validating', jobs: withTokens(request)});
+    const running = welcome({model: done});
+    running.run('leave("fresh")');
+    await running.run('done()');
+    assert.equal(running.calls.length, 0, 'nothing navigates away while the import runs');
+    done = finish(done, jobs => jobs.forEach(j => { j.state = 'succeeded'; }));
+    const result = welcome({model: done});
+    assert.equal(result.run('view.kind'), 'done');
+    await result.run('primary()');
+    assert.deepEqual(result.calls, [['openImported'], ['setPref', 'completed_onboarding', true]],
+        'Start browsing never navigates the original window after opening the import');
+    const failedOpen = welcome({model: done, openResult: false});
+    await failedOpen.run('primary()');
+    assert.deepEqual(failedOpen.calls, [['openImported']], 'failed open leaves setup incomplete');
+    await failedOpen.run('primary()');
+    assert.equal(failedOpen.calls.length, 2, 'explicit retry attempts opening again');
+    await failedOpen.run('done(true)');
+    assert.deepEqual(failedOpen.calls.slice(2), [['setPref', 'completed_onboarding', true],
+        ['open', 'chrome://newtab', '_self']], 'explicit skip can complete without opening');
+
+    const markup = readFileSync('src/pages/Welcome.svelte', 'utf8');
+    const body = markup.slice(markup.indexOf('</script>'), markup.indexOf('<style>'));
+    assert.ok(body.indexOf('s.welcome.arcTitle') < body.indexOf('s.welcome.importAll'));
+    assert.ok(body.indexOf('s.welcome.importAll') < body.indexOf('s.welcome.choose'),
+        'the one-click button leads; the picker is the secondary choice');
+    assert.ok(body.indexOf('s.welcome.choose') < body.indexOf('s.origin.other'));
+    assert.match(body, /s\.welcome\.arcScope/, 'the scope of the import is stated on the screen');
+});
+
+test('one-click copy states its scope without promising passwords, cookies, extensions, or History', () => {
+    const grdp = readFileSync('helium_onboarding_strings.grdp', 'utf8');
+    const message = name => grdp.match(new RegExp(`name="IDS_HELIUM_ONBOARDING_${name}"[^>]*>\\s*([^<]*)`))[1].trim();
+    assert.equal(message('WELCOME_ARC_TITLE'), 'Coming from Arc?');
+    assert.equal(message('WELCOME_ARC_BODY'), 'Migrate in just one click.');
+    const scope = message('WELCOME_ARC_SCOPE');
+    assert.match(scope, /Spaces, Pins, folders, and Favorites come over/);
+    assert.match(scope, /Passwords, extensions, and sign-ins stay in Arc/);
+    for (const name of ['WELCOME_ARC_TITLE', 'WELCOME_ARC_BODY', 'WELCOME_IMPORT_ALL', 'WELCOME_CHOOSE',
+        'WELCOME_DONE_TITLE']) {
+        assert.doesNotMatch(message(name), /password|cookie|extension|history|sign-in/i, name);
+    }
+    assert.doesNotMatch(grdp, /IDS_HELIUM_ONBOARDING_ORIGIN_TITLE|IDS_HELIUM_ONBOARDING_ORIGIN_ARC_DESC/,
+        'the old second-place origin question is gone');
+});
+
+ test('password manager requires explicit service consent', () => {
+    const f = flow({prefs: {'services.user_consented': true}});
+    f.chooseRoute('fresh');
+    assert.equal(walk(f, 2), 'PasswordManager');
+ });
