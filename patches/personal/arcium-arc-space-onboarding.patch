+// Query the real profile database after pending favicon writes. Disable host
+// fallback so a shared icon or another URL on the host cannot mask a bad mapping.
+favicon_base::FaviconRawBitmapResult ReadImportedFavicon(Profile* profile,
+                                                        const GURL& page_url) {
+  base::CancelableTaskTracker tracker;
+  base::test::TestFuture<const favicon_base::FaviconRawBitmapResult&> result;
+  FaviconServiceFactory::GetForProfile(profile,
+                                      ServiceAccessType::EXPLICIT_ACCESS)
+      ->GetRawFaviconForPageURL(page_url, {favicon_base::IconType::kFavicon},
+                               /*desired_size_in_pixel=*/16,
+                               /*fallback_to_host=*/false,
+                               result.GetCallback(), &tracker);
+  return result.Take();
+}
+
+favicon_base::FaviconUsageData MakeImportedFavicon(std::set<GURL> urls) {
+  const std::vector<uint8_t> pixels(16 * 16 * 4, 255);
+  auto png = gfx::PNGCodec::Encode(pixels.data(), gfx::PNGCodec::FORMAT_RGBA,
+                                   gfx::Size(16, 16), 16 * 4,
+                                   /*discard_transparency=*/false, {});
+  EXPECT_TRUE(png.has_value());
+  favicon_base::FaviconUsageData favicon;
+  favicon.favicon_url = GURL("https://icon.test/selection.png");
+  favicon.png_data = png.value_or(std::vector<uint8_t>());
+  favicon.urls = std::move(urls);
+  return favicon;
+}
+
+IN_PROC_BROWSER_TEST_F(ArciumArcImportBrowserTest,
+                       SelectedFavoritesOnlyImportIsIdempotent) {
+  constexpr char kFavoritesOnly[] = R"json({
+    "version":1,"source_profile":"arc-profile","spaces":[],
+    "favorites":[{"type":"tab","source_id":"favorite",
+                  "title":"Favorite","url":"https://favorite.test/"}]
+  })json";
+  auto* profile = browser()->profile();
+  auto* service = helium::HeliumSpaceServiceFactory::GetForProfile(profile);
+  const std::string local_id = service->GetDefaultSpace()->id();
+  const helium::PersistentNodes local_pins = {
+      Link("local-pin", u"Local", "https://local.test/")};
+  ASSERT_TRUE(service->GetOrCreateSpaceReplacingPins(local_id, u"Local",
+                                                     local_pins));
+  ArcSidebarSelection selection{.source_profile = "arc-profile",
+                                .space_ids = {}};
+  for (int pass = 0; pass < 2; ++pass) {
+    auto writer = base::MakeRefCounted<ProfileWriter>(
+        profile, ArcSidebarDestination::kPins, selection);
+    writer->AddArcSidebarSnapshot(kFavoritesOnly);
+    ASSERT_TRUE(writer->arc_sidebar_snapshot_import_succeeded());
+    ASSERT_EQ(2u, service->GetSpaces().size());
+    auto* fallback = service->GetSpaceById("arc:arc-profile:favorites-space");
+    ASSERT_TRUE(fallback);
+    EXPECT_TRUE(fallback->pins().empty());
+    EXPECT_EQ("arc-profile", fallback->source_profile());
+    EXPECT_EQ(1u, service->GetFavoritesForSpace(*fallback).size());
+    ASSERT_TRUE(service->GetSpaceById(local_id));
+    EXPECT_EQ(local_pins, service->GetSpaceById(local_id)->pins());
+    EXPECT_TRUE(service->GetFavoritesForSpace(
+        *service->GetSpaceById(local_id)).empty());
+    writer->AddFavicons({MakeImportedFavicon({GURL("https://favorite.test/"),
+                                             GURL("https://local.test/")})});
+    EXPECT_TRUE(ReadImportedFavicon(profile, GURL("https://favorite.test/"))
+                    .is_valid());
+    EXPECT_FALSE(ReadImportedFavicon(profile, GURL("https://local.test/"))
+                     .is_valid());
+  }
