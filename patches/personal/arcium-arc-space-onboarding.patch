+    n: number,
+    one: string,
+    many: { value: string; substitutions: { count: string } },
+) => n === 1 ? one : substituteLocalizedString(many, { count: n });
+
+export const pinsLabel = (n: number) =>
+    plural(n, s.spaces.pinsOne, s.spaces.pinsMany);
+
+export const favoritesLabel = (n: number) =>
+    plural(n, s.spaces.favoritesOne, s.spaces.favoritesMany);
+
+export const failureLabel = (failure: string | undefined) => {
+    switch (failure) {
+    case 'busy': return s.spaces.failureBusy;
+    case 'source_changed': return s.spaces.failureSourceChanged;
+    case 'sidebar_unreadable': return s.spaces.failureUnreadable;
+    case 'sidebar_not_saved': return s.spaces.failureNotSaved;
+    case 'history_incomplete': return s.spaces.failureHistory;
+    case 'policy_blocked': return s.spaces.failurePolicy;
+    case 'destination_closed':
+    case 'invalid_destination_mapping': return s.spaces.failureUnfinished;
+    default: return s.spaces.failureUnknown;
+    }
+};
+
+export type ArcCta = { label: string; busy: boolean; stop: boolean };
+
+/**
+ * Label and state for the shared primary button on the Space picker. In the
+ * standalone Settings entry, finishing names what happens next.
+ */
+export const arcCta = derived(arcImport.state, (model): ArcCta => {
+    const standalone = standaloneImport;
+    const next = Spaces.action(model);
+    switch (next.kind) {
+    case 'busy':
+        return { label: s.spaces.importing, busy: true, stop: Spaces.busy(model) && !model.pending };
+    case 'skip':
+        return {
+            label: !standalone ? s.spaces.skip
+                : Spaces.canOpen(model) ? s.spaces.openSpace : s.spaces.close,
+            busy: false, stop: false,
+        };
+    case 'continue':
+        return {
+            label: !standalone ? s.button.next
+                : Spaces.canOpen(model) ? s.spaces.openSpace : s.spaces.done,
+            busy: false,
+            stop: false,
+        };
+    case 'retry':
+        return { label: s.spaces.tryAgain, busy: false, stop: false };
+    case 'import':
+        return {
+            label: next.spaces
+                ? plural(next.spaces, s.spaces.importOne, s.spaces.importMany)
+                : s.spaces.import,
+            busy: false,
+            stop: false,
+        };
+    }
+});
+
+/** One status line under the grid. Never names Arc profiles. */
+export const spacesStatus = (model: Spaces.Model): { text: string; failed: boolean } => {
+    const summary = Spaces.summarize(model);
+    if (Spaces.busy(model)) {
+        return {
+            text: summary.progress
+                ? substituteLocalizedString(s.spaces.progress, summary.progress)
+                : s.spaces.importing,
+            failed: false,
+        };
+    }
+    switch (model.notice) {
+    case 'busy': return { text: s.spaces.noticeBusy, failed: true };
+    case 'changed': return { text: s.spaces.noticeChanged, failed: false };
+    case 'refreshed': return { text: s.spaces.noticeRefreshed, failed: false };
+    case 'error': return { text: s.spaces.noticeError, failed: true };
+    case 'open_failed': return { text: s.spaces.openFailed, failed: true };
+    }
+    if (summary.failed) {
+        return { text: plural(summary.failed, s.spaces.failedOne, s.spaces.failedMany), failed: true };
+    }
+    if (summary.stopped) {
+        return { text: s.spaces.stopped, failed: false };
+    }
+    if (summary.imported) {
+        return { text: plural(summary.imported, s.spaces.doneOne, s.spaces.doneMany), failed: false };
+    }
+    return {
+        text: substituteLocalizedString(s.spaces.selected, {
+            count: Spaces.selectedCount(model),
