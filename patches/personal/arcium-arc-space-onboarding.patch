+    const context = vm.createContext({
+        $derived: value => value, $state: value => value, SvelteSet: Set,
+        $currentPage: 'ArcSpaces', $arcCta: {label: 'Import 3 Spaces', busy: false, stop: false},
+        standaloneImport: false,
+        arcImport: {advance: async () => true},
+        finishStandaloneImport: async () => { finished++; },
+        nextPage: () => advances++, previousPage: () => {},
+        ...extra,
+    });
