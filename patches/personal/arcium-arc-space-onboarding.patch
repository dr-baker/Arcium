+     */
+    reload: () => Promise<void>;
+    toggle: (key: Spaces.SpaceKey) => void;
+    setAll: (on: boolean) => void;
+    setHistory: (on: boolean) => void;
+    /**
+     * One click on the first screen. Reads Arc when no current inventory is
+     * ready, then sends every eligible Space once with History off. Repeated
+     * clicks and snapshots never send a second request.
+     */
+    importAll: () => void;
+    /** Cancel, Back, page change, or unmount: a click still waiting is dropped. */
+    cancelOneClick: () => void;
+    /** Runs the primary action. Resolves true when the page may move on. */
+    advance: () => Promise<boolean>;
+    cancel: () => Promise<void>;
+    canOpen: () => boolean;
+    /** Opens the first imported Space. Call only on an explicit finish. */
+    open: () => Promise<boolean>;
+};
+
+export const createArcImportController = (deps: ArcImportDeps): ArcImportController => {
+    const state = writable(Spaces.initialModel());
+    const timeoutMs = deps.timeoutMs ?? 10000;
+    let listening = false;
+    let started = false;
+    let loading: Promise<void> | null = null;
+    /** Inventory generation when the running reload began. */
+    let loadingBase = 0;
+    let starting = false;
+    let nextStartId = 0;
+    let activeStart: {
+        id: number;
+        generation: number;
+        after: number;
+        acknowledge: () => void;
+    } | null = null;
+    let expiredStart: {
+        id: number;
+        pending: NonNullable<Spaces.Model['pending']>;
+        oneClick: Spaces.OneClick;
+    } | null = null;
+    let reconciliation: { id: number; promise: Promise<void> } | null = null;
+    /** Snapshots accepted so far; proves the handler is alive. */
+    let received = 0;
+    let rereadFor = '';
+    let openedBatch = 0;
+    let opening: Promise<boolean> | null = null;
+    let openingBatch = 0;
+
+    const update = (fn: (model: Spaces.Model) => Spaces.Model) => state.update(fn);
+
+    const apply = (raw: unknown) => {
+        const snapshot = Spaces.parseState(raw);
+        if (!snapshot) {
+            return;
+        }
+        // A timed-out request may still have reached native code. Recover its
+        // own late acknowledgement only until a newer Start takes ownership.
+        const expired = expiredStart;
+        if (expired && expired.id === nextStartId &&
+            snapshot.generation === expired.pending.generation &&
+            snapshot.batchId > expired.pending.after &&
+            get(state).snapshot?.generation === snapshot.generation &&
+            !get(state).pending) {
+            update(model => ({ ...model, pending: expired.pending,
+                oneClick: expired.oneClick, history: false, notice: null }));
+            expiredStart = null;
+        }
+        const before = get(state).snapshot;
+        update(model => Spaces.applySnapshot(model, snapshot));
+        const model = get(state);
+        // The complete event stream can acknowledge Start even if its promise
+        // reply never arrives. Only this request's adopted batch can release it.
+        if (activeStart && model.batch && !model.pending &&
+            model.batch.generation === activeStart.generation &&
+            model.batch.id > activeStart.after) {
+            activeStart.acknowledge();
+        }
+        if (model.snapshot !== before) {
+            received++;
+        }
+        // The handler checks that Arc has not changed before writing anything.
+        // When it has, read Arc again once per batch. Successes stay locked.
+        const batch = `${snapshot.generation}:${snapshot.batchId}`;
+        if (Spaces.sourceChanged(model) && rereadFor !== batch) {
+            rereadFor = batch;
+            void reload('auto').then(() => update(next => Spaces.withNotice(next, 'changed')));
+        }
+        settleOneClick();
+    };
+
+    // Acts on a waiting click once the model can answer it. The request is
+    // recorded synchronously before anything is awaited, so a second snapshot
+    // or initialize reply arriving meanwhile finds nothing left to do.
+    const settleOneClick = () => {
+        if (starting || expiredStart) {
+            return;
+        }
+        const step = Spaces.oneClickStep(get(state));
+        if (step === 'start') {
+            update(Spaces.prepareOneClick);
+            void start(true);
+        } else if (step !== 'wait') {
+            update(model => Spaces.resolveOneClick(model, step));
+        }
+    };
+
+    // Registered once, before the first initialize, and kept for the page's
+    // lifetime: the handler cancels discovery and jobs when the page unloads.
+    const listen = () => {
+        if (!listening) {
+            deps.proxy().onStateChanged(apply);
+            listening = true;
+        }
+    };
+
+    const reload = (refresh: Spaces.Refresh): Promise<void> => {
+        // Do not erase the unknown request by rediscovering and clearing its
+        // ledger. A read-only snapshot must resolve it first.
+        if (expiredStart) {
+            return reconcileStart();
+        }
+        if (Spaces.busy(get(state))) {
+            return Promise.resolve();
+        }
+        if (refresh === 'user') {
+            update(Spaces.requestRefresh);
+        }
+        return loading ??= (async () => {
+            listen();
+            loadingBase = get(state).snapshot?.generation ?? 0;
+            const seen = received;
+            update(model => ({ ...model, unreachable: false }));
+            let timer: ReturnType<typeof setTimeout> | undefined;
+            const reply = (async () => deps.proxy().initialize())();
+            // Applied whenever it lands, even after the timeout; the snapshot
+            // ordering drops it if streamed events already got further.
+            reply.then(apply, () => {});
+            try {
+                const value = await Promise.race([
+                    reply,
+                    new Promise((_, reject) => {
+                        timer = setTimeout(() => reject(new Error('timeout')), timeoutMs);
+                    }),
+                ]);
+                if (!Spaces.parseState(value)) {
+                    throw new Error('malformed');
+                }
+            } catch {
+                // A snapshot that arrived by event since this call began
+                // proves the handler answers, whatever happened to the reply.
+                if (received === seen) {
+                    update(Spaces.markUnreachable);
+                }
+            } finally {
+                clearTimeout(timer);
+                update(Spaces.endRefresh);
+                loading = null;
+                settleOneClick();
+            }
+        })();
+    };
+
+    const reconcileStart = (): Promise<void> => {
+        const expired = expiredStart;
+        if (!expired) {
+            return Promise.resolve();
+        }
+        if (reconciliation?.id === expired.id) {
+            return reconciliation.promise;
+        }
+        const ownsUncertainty = () => expiredStart?.id === expired.id &&
+            nextStartId === expired.id;
+        const accept = (raw: unknown) => {
+            if (!ownsUncertainty()) {
+                return;
+            }
+            const snapshot = Spaces.parseState(raw);
+            if (!snapshot || snapshot.generation !== expired.pending.generation ||
+                snapshot.batchId < expired.pending.after) {
+                return;
+            }
+            if (snapshot.batchId > expired.pending.after) {
+                // apply restores only the original frozen selection/History.
+                apply(snapshot);
+            } else if (snapshot.phase === 'ready' || snapshot.phase === 'finished' ||
+                snapshot.phase === 'failed') {
+                // getState is sent after Start on the same ordered WebUI pipe.
+                // An unchanged idle batch proves that Start was not accepted.
+                // This click only reconciles; another explicit click may Start.
+                expiredStart = null;
+                apply(snapshot);
+            }
+        };
+        const promise = (async () => {
+            let timer: ReturnType<typeof setTimeout> | undefined;
+            // Publish ownership before invoking a potentially synchronous mock.
+            await Promise.resolve();
+            try {
+                const reply = Promise.resolve(deps.proxy().getState());
+                // A late read may still resolve uncertainty, only while this
+                // original request owns it. It never starts import itself.
+                reply.then(accept, () => {});
+                await Promise.race([
+                    reply,
+                    new Promise((_, reject) => {
+                        timer = setTimeout(() => reject(new Error('timeout')), timeoutMs);
+                    }),
+                ]);
+            } catch {
+                // Keep the gate closed. No response is proof of neither success
+                // nor failure; Check again/Try again can repeat this safe read.
+            } finally {
+                clearTimeout(timer);
+                if (ownsUncertainty()) {
+                    update(model => Spaces.withNotice(model, 'error'));
+                }
+                if (reconciliation?.id === expired.id) {
+                    reconciliation = null;
+                }
+            }
+        })();
+        reconciliation = { id: expired.id, promise };
+        return promise;
+    };
+
+    const start = async (oneClick = false) => {
+        if (expiredStart) {
+            await reconcileStart();
+            return;
+        }
+        const request = Spaces.buildStart(get(state));
+        if (!request || starting) {
+            return;
+        }
+        starting = true;
+        const id = ++nextStartId;
+        expiredStart = null;
+        const after = get(state).snapshot?.batchId ?? 0;
+        update(model => Spaces.markStarting(model, request, oneClick));
+        let timer: ReturnType<typeof setTimeout> | undefined;
+        const acknowledged = new Promise<{ kind: 'acknowledged' }>(resolve => {
+            activeStart = {
+                id, generation: request.generation, after,
+                acknowledge: () => resolve({ kind: 'acknowledged' }),
+            };
+        });
+        const ownsRequest = () => activeStart?.id === id;
+        const adoptedBatch = () => {
+            const model = get(state);
+            return model.batch?.generation === request.generation &&
+                model.batch.id > after && !model.pending;
+        };
+        try {
+            // Install acknowledgement ownership before invoking even a
+            // synchronous proxy. Race only wrapped outcomes: a late rejection
+            // is consumed, and a late reply cannot mutate a newer retry.
+            const reply = Promise.resolve(deps.proxy().start(request)).then(
+                value => {
+                    if (expiredStart?.id === id && nextStartId === id) {
+                        apply(value);
+                    }
+                    return { kind: 'reply' as const, value };
+                },
+                error => ({ kind: 'rejected' as const, error }),
+            );
+            const result = await Promise.race([
+                acknowledged,
+                reply,
+                new Promise<{ kind: 'timeout' }>(resolve => {
+                    timer = setTimeout(() => resolve({ kind: 'timeout' }), timeoutMs);
+                }),
+            ]);
+            if (!ownsRequest() || result.kind === 'acknowledged' || adoptedBatch()) {
+                return;
+            }
+            if (result.kind === 'reply') {
+                apply(result.value);
+                if (get(state).pending) {
+                    update(model => Spaces.startFailed(model, 'unknown'));
+                }
+            } else if (result.kind === 'rejected') {
+                const rejection = Spaces.parseRejection(result.error);
+                update(model => Spaces.startFailed(model, rejection));
+                if (rejection === 'stale_selection') {
+                    await reload('auto');
+                    if (ownsRequest()) {
+                        update(model => Spaces.withNotice(model, 'changed'));
+                    }
+                }
+            } else {
+                // No acknowledgement proves whether native writes started.
+                // Stop waiting, but never retry automatically or claim rollback.
+                const model = get(state);
+                if (model.pending) {
+                    expiredStart = { id, pending: model.pending, oneClick: model.oneClick };
+                }
+                update(model => ({
+                    ...Spaces.startFailed(model, 'unknown'),
+                    partialData: new Set([...model.partialData,
+                        ...(model.pending?.keys ?? [])]),
+                }));
+            }
+        } catch (error) {
+            if (ownsRequest() && !adoptedBatch()) {
+                const rejection = Spaces.parseRejection(error);
+                update(model => Spaces.startFailed(model, rejection));
+                if (rejection === 'stale_selection') {
+                    await reload('auto');
+                    if (ownsRequest()) {
+                        update(model => Spaces.withNotice(model, 'changed'));
+                    }
+                }
+            }
+        } finally {
+            clearTimeout(timer);
+            if (ownsRequest()) {
+                activeStart = null;
+                starting = false;
+            }
+        }
+    };
+
+    const prefetch = () => {
+        if (!started) {
+            started = true;
+            void reload('auto');
+        }
+    };
+
+    return {
+        state,
+        action: () => Spaces.action(get(state)),
+        prefetch,
+        visit: () => {
+            update(Spaces.visit);
+            prefetch();
+        },
+        reload: () => {
+            started = true;
+            return reload('user');
+        },
+        importAll: () => {
+            if (expiredStart) {
+                void reconcileStart();
+                return;
+            }
+            const model = get(state);
+            if (starting || model.oneClick.stage === 'waiting' || Spaces.busy(model)) {
+                return;
+            }
+            started = true;
+            const generation = model.snapshot?.generation ?? 0;
+            // A ready inventory answers at once. Otherwise only the reload in
+            // flight, or the one this click starts, may answer.
+            const ready = !loading && Spaces.load(model) === 'ready';
+            const after = ready ? generation : (loading ? loadingBase : generation) + 1;
+            update(next => Spaces.requestOneClick(next, after));
+            if (!ready && !loading) {
+                void reload('auto');
+            }
+            settleOneClick();
+        },
+        cancelOneClick: () => update(Spaces.cancelOneClick),
+        toggle: key => update(model => Spaces.toggle(model, key)),
+        setAll: on => update(model => Spaces.setAll(model, on)),
+        setHistory: on => update(model => Spaces.setHistory(model, on)),
+        advance: async () => {
+            if (expiredStart) {
+                await reconcileStart();
+                return false;
+            }
+            const next = Spaces.action(get(state));
+            switch (next.kind) {
+            case 'busy':
+                return false;
+            case 'skip':
+            case 'continue':
+                return true;
+            default:
+                await start();
+                return false;
+            }
+        },
+        cancel: async () => {
+            const batch = get(state).snapshot?.batchId;
+            if (!batch || !Spaces.busy(get(state))) {
+                return;
+            }
+            try {
+                apply(await deps.proxy().cancel(batch));
+            } catch {
+                // A stale batch already finished; its snapshot says so.
+            }
+        },
+        canOpen: () => Spaces.canOpen(get(state)),
+        open: async () => {
+            const model = get(state);
+            const batch = model.snapshot?.batchId ?? 0;
+            const generation = model.snapshot?.generation;
+            const notice = (value: Spaces.Notice) => update(next =>
+                next.snapshot?.batchId === batch && next.snapshot?.generation === generation
+                    ? Spaces.withNotice(next, value) : next);
+            if (!Spaces.canOpen(model)) {
+                return false;
+            }
+            // A confirmed previous request is idempotent. Failed or unanswered
+            // requests can be retried; never record them as already opened.
+            if (openedBatch === batch) {
+                return true;
+            }
+            if (opening) {
+                return openingBatch === batch ? opening : false;
+            }
+            openingBatch = batch;
+            opening = (async () => {
+                // Assign opening before invoking a potentially synchronous mock.
+                await Promise.resolve();
+                let timer: ReturnType<typeof setTimeout> | undefined;
+                try {
+                    const result = await Promise.race([
+                        Promise.resolve().then(() => deps.proxy().open(batch)),
+                        new Promise((_, reject) => {
+                            timer = setTimeout(() => reject(new Error('timeout')), timeoutMs);
+                        }),
+                    ]);
+                    if (result === true) {
+                        openedBatch = batch;
+                        notice(null);
+                        return true;
+                    }
+                } catch {
+                    // Keep the picker/Finish available for an explicit retry.
+                } finally {
+                    clearTimeout(timer);
+                    opening = null;
+                }
+                notice('open_failed');
+                return false;
+            })();
+            return opening;
+        },
+    };
+};
