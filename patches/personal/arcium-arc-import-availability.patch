+TEST_F(ArcSpacesImportLifecycleTest,
+       AvailabilityCountsExcludedRecordsOnceAcrossSources) {
+  const char* fixture = R"json({"sidebar":{"containers":[{"global":{}},{
+    "items":["favorites",{"childrenIds":["f1","f2","f3","f4"],"data":{"itemContainer":{}}},
+      "f1",{"data":{"tab":{"savedURL":"https://same.example/"}}},
+      "f2",{"data":{"tab":{"savedURL":"https://same.example/"}}},
+      "f3",{"data":{"tab":{"savedURL":"https://three.example/"}}},
+      "f4",{"data":{"tab":{"savedURL":"https://four.example/"}}}],
+    "spaces":[],
+    "topAppsContainerIDs":[
+      {"custom":{"directoryBasename":"Profile 1","machineID":"foreign-mac"}},"favorites",
+      {"custom":{"directoryBasename":"Profile 2","machineID":"foreign-mac"}},"favorites"]
+  }]}})json";
+  auto root = base::JSONReader::ReadDict(fixture, base::JSON_PARSE_RFC);
+  ASSERT_TRUE(root);
+  auto& data =
+      (*root->FindDict("sidebar")->FindList("containers"))[1].GetDict();
+  for (int i = 0; i < 7; ++i) {
+    data.FindList("spaces")->Append("s" + base::NumberToString(i));
+    data.FindList("spaces")->Append(
+        base::DictValue()
+            .Set("title", "Saved Space")
+            .Set("profile", base::DictValue().Set("default", true)));
+  }
+  std::string json;
+  ASSERT_TRUE(base::JSONWriter::Write(*root, &json));
+  ASSERT_TRUE(base::WriteFile(entry_.sidebar_path, json));
+  auto first = entry_.source;
+  first.source_path = temp_.GetPath().AppendASCII("Profile 1");
+  auto second = first;
+  second.source_path = temp_.GetPath().AppendASCII("Profile 2");
+  ASSERT_TRUE(base::CreateDirectory(first.source_path));
+  ASSERT_TRUE(base::CreateDirectory(second.source_path));
+  ArcSpacesImport importer(base::DoNothing());
+  ArcSpacesImportTestPeer::ReadFixture(importer,
+                                       {entry_.source, first, first, second});
+  auto result = importer.Snapshot();
+  EXPECT_EQ("ready", *result.FindString("phase"));
+  EXPECT_TRUE(result.FindString("failure")->empty());
+  ASSERT_EQ(7u, result.FindList("spaces")->size());
+  auto* availability = result.FindDict("availability");
+  ASSERT_TRUE(availability);
+  EXPECT_EQ(0, availability->FindInt("foreignSpaces"));
+  EXPECT_EQ(4, availability->FindInt("foreignFavorites"));
+  EXPECT_EQ(0, availability->FindInt("unreadableSources"));
+  // A local profile with the same saved records makes them available, not
+  // excluded. Favorites count by ID, so two links with one URL remain two.
+  data.FindList("topAppsContainerIDs")
+      ->Append(base::DictValue().Set("default", true));
+  data.FindList("topAppsContainerIDs")->Append("favorites");
+  ASSERT_TRUE(base::JSONWriter::Write(*root, &json));
+  ASSERT_TRUE(base::WriteFile(entry_.sidebar_path, json));
+  ArcSpacesImportTestPeer::ReadFixture(importer,
+                                       {first, second, entry_.source});
+  result = importer.Snapshot();
+  EXPECT_EQ(0, result.FindDict("availability")->FindInt("foreignFavorites"));
+}
+
+TEST_F(ArcSpacesImportLifecycleTest,
+       AvailabilityReplacesCountsAndRejectsLateDiscovery) {
+  ArcSpacesImport importer(base::DoNothing());
+  ArcSpacesImportTestPeer::BeginLoading(importer);
+  auto obsolete = ArcSpacesImportTestPeer::AvailabilityReply(importer);
+  ArcSpacesImportTestPeer::BeginLoading(importer);
+  auto accepted = ArcSpacesImportTestPeer::AvailabilityReply(importer);
+  std::move(accepted).Run();
+  EXPECT_EQ(4, importer.Snapshot()
+                   .FindDict("availability")
+                   ->FindInt("foreignFavorites"));
+  // A later completed empty inventory clears the old count. The stale reply
+  // must not put it back.
+  ArcSpacesImportTestPeer::ReadFixture(importer, {});
+  std::move(obsolete).Run();
+  EXPECT_EQ(0, importer.Snapshot()
+                   .FindDict("availability")
+                   ->FindInt("foreignFavorites"));
+}
+
+TEST_F(ArcSpacesImportLifecycleTest,
+       UnreadableSourceCountDeduplicatesDiscoveryRows) {
+  ArcSpacesImport importer(base::DoNothing());
+  // SetUp writes deliberately invalid sidebar JSON.
+  ArcSpacesImportTestPeer::ReadFixture(importer,
+                                       {entry_.source, entry_.source});
+  auto result = importer.Snapshot();
+  EXPECT_EQ("failed", *result.FindString("phase"));
+  EXPECT_EQ("sidebar_unreadable", *result.FindString("failure"));
+  EXPECT_EQ(1, result.FindDict("availability")->FindInt("unreadableSources"));
+  EXPECT_EQ(0, result.FindDict("availability")->FindInt("foreignSpaces"));
+  EXPECT_EQ(0, result.FindDict("availability")->FindInt("foreignFavorites"));
+}
