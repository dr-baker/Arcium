+  data.Set("spaces", base::ListValue());
+  auto* top_apps = data.FindList("topAppsContainerIDs");
+  top_apps->Append(CustomIdentity("foreign-machine"));
+  top_apps->Append("missing-container");
+  ArcSidebarUnavailable unavailable;
+  EXPECT_FALSE(
+      ParseArcSidebarSnapshot(*root, kProfile, "local-machine", &unavailable));
+  EXPECT_TRUE(unavailable.foreign_profile);
+  EXPECT_TRUE(unavailable.incomplete);
+  EXPECT_EQ(2u, unavailable.favorite_ids.size());
+}
+
+TEST(ArcSidebarSnapshotTest, ConflictingSpaceIdsCannotHideForeignExclusions) {
+  auto root = ParseFixture();
+  ASSERT_TRUE(root);
+  SetFixtureMachine(*root, "local-machine");
+  auto* spaces = FixtureSidebarData(*root).FindList("spaces");
+  auto repeated_id = (*spaces)[0].Clone();
+  auto repeated = (*spaces)[1].Clone();
+  // Byte-equivalent repeated records are still one saved Space.
+  spaces->Append(repeated_id.Clone());
+  spaces->Append(repeated.Clone());
+  auto local = ParseArcSidebarSnapshot(*root, kProfile, "local-machine");
+  ASSERT_TRUE(local);
+  EXPECT_EQ(2u, local->spaces.size());
+  // Same ID, different identity cannot be subtracted from excluded totals as
+  // though the local profile made the foreign record available.
+  repeated.GetDict().Set("profile", CustomIdentity("foreign-machine"));
+  spaces->Append(std::move(repeated_id));
+  spaces->Append(std::move(repeated));
+  ArcSidebarUnavailable unavailable;
+  EXPECT_FALSE(
+      ParseArcSidebarSnapshot(*root, kProfile, "local-machine", &unavailable));
+  EXPECT_FALSE(unavailable.foreign_profile);
+}
