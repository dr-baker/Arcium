+TEST(ArcSidebarSnapshotTest, ForeignNoticeDeduplicatesIdsAcrossMachineRecords) {
+  auto root = ParseFixture();
+  ASSERT_TRUE(root);
+  SetFixtureMachine(*root, "first-foreign-machine");
+  auto* top_apps = FixtureSidebarData(*root).FindList("topAppsContainerIDs");
+  top_apps->Append(CustomIdentity("second-foreign-machine"));
+  top_apps->Append("favorites-container");
+  top_apps->Append(CustomIdentity("third-foreign-machine"));
+  top_apps->Append("other-favorites");
+  ArcSidebarUnavailable unavailable;
+  EXPECT_FALSE(
+      ParseArcSidebarSnapshot(*root, kProfile, "local-machine", &unavailable));
+  EXPECT_TRUE(unavailable.foreign_profile);
+  EXPECT_EQ(2, unavailable.space_ids.size());
+  EXPECT_EQ(3, unavailable.favorite_ids.size());
+}
+
+TEST(ArcSidebarSnapshotTest, UnknownIdentityIsNotDescribedAsAnotherMac) {
+  auto root = ParseFixture();
+  ASSERT_TRUE(root);
+  SetFixtureMachine(*root, "foreign-machine");
+  ArcSidebarUnavailable unavailable;
+  EXPECT_FALSE(ParseArcSidebarSnapshot(*root, kProfile, "", &unavailable));
+  EXPECT_FALSE(unavailable.foreign_profile);
+  EXPECT_EQ(0, unavailable.space_ids.size());
+  EXPECT_EQ(0, unavailable.favorite_ids.size());
+  SetFixtureMachine(*root, "");
+  EXPECT_FALSE(
+      ParseArcSidebarSnapshot(*root, kProfile, "local-machine", &unavailable));
+  EXPECT_FALSE(unavailable.foreign_profile);
+}
+
+TEST(ArcSidebarSnapshotTest, LocalReadClearsEarlierForeignDiagnostics) {
+  auto root = ParseFixture();
+  ASSERT_TRUE(root);
+  SetFixtureMachine(*root, "foreign-machine");
+  ArcSidebarUnavailable unavailable;
+  EXPECT_FALSE(
+      ParseArcSidebarSnapshot(*root, kProfile, "local-machine", &unavailable));
+  ASSERT_GT(unavailable.favorite_ids.size(), 0);
+  EXPECT_TRUE(ParseArcSidebarSnapshot(*root, kProfile, "foreign-machine",
