+void ReturnAnchoredPinnedTabHome(tabs::TabInterface* tab) {
+  if (!IsAnchoredTab(tab)) {
+    return;
+  }
+
+  GURL home_url;
+  std::u16string home_title;
+  if (!GetAnchoredPinnedTabHome(tab, &home_url, &home_title)) {
+    return;
+  }
+  content::NavigationController::LoadURLParams params(home_url);
+  params.transition_type = ui::PAGE_TRANSITION_AUTO_BOOKMARK;
+  params.has_user_gesture = true;
+  params.should_replace_current_entry = true;
+  params.should_clear_history_list = true;
+  tab->GetContents()->GetController().LoadURLWithParams(params);
+}
