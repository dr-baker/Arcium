+TEST(SidebarRowLayoutTest, NarrowRowsHaveNonnegativeContainedBounds) {
+  for (double scale : {0.8, 1.0, 1.25, 1.5}) {
+    SCOPED_TRACE(scale);
+    const arcium::SidebarRowMetrics metrics =
+        arcium::SidebarRowMetrics::ForScale(scale);
+    const int icon_width =
+        base::ClampRound(16 * scale) + 2 * base::ClampRound(3 * scale);
+    // Cover ordinary widths and extreme constraints during collapse, nesting,
+    // or split layout. Clipping below the expanded minimum is defensive.
+    for (int width : {0, 1, 8, 12, 20, 26, 38, 64, 80, 148, 188, 288}) {
+      SCOPED_TRACE(width);
+      const gfx::Rect row(0, 0, width, base::ClampRound(28 * scale));
+      for (bool show_close : {false, true}) {
+        for (bool show_alert : {false, true}) {
+          const int close_width = base::ClampRound(26 * scale);
+          const int alert_width = base::ClampRound(16 * scale);
+          const arcium::SidebarRowBounds bounds =
+              arcium::CalculateSidebarRowBounds(
+                  row, metrics, gfx::Size(icon_width, icon_width),
+                  base::ClampRound(16 * scale),
+                  show_close
+                      ? std::make_optional(gfx::Size(close_width, close_width))
+                      : std::nullopt,
+                  show_alert
+                      ? std::make_optional(gfx::Size(alert_width, alert_width))
+                      : std::nullopt);
+          for (const gfx::Rect& child :
+               {bounds.icon, bounds.title, bounds.close_button,
+                bounds.alert_indicator}) {
+            EXPECT_GE(child.x(), 0);
+            EXPECT_GE(child.y(), 0);
+            EXPECT_GE(child.width(), 0);
+            EXPECT_GE(child.height(), 0);
+            if (!child.IsEmpty()) {
+              EXPECT_TRUE(row.Contains(child));
+            }
+          }
+        }
+      }
+    }
+  }
+}
