+const SpaceGlow* ResolveSpaceAccentGlow(const SpaceBackground& background,
+                                       std::string_view id) {
+  if (background.glows.empty()) {
+    return nullptr;
+  }
+  const auto found = std::ranges::find(background.glows, id, &SpaceGlow::id);
+  return found == background.glows.end() ? &background.glows.front() : &*found;
