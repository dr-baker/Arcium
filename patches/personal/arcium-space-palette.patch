--- /dev/null
+++ src/chrome/browser/ui/helium/space_palette.h
@@ -0,0 +1,152 @@
+// Copyright 2026 The Helium Authors
+// SPDX-License-Identifier: GPL-3.0-only
+
+#ifndef CHROME_BROWSER_UI_HELIUM_SPACE_PALETTE_H_
+#define CHROME_BROWSER_UI_HELIUM_SPACE_PALETTE_H_
+
+#include <algorithm>
+
+#include "base/strings/string_number_conversions.h"
+#include "chrome/browser/ui/helium/helium_space.h"
+#include "chrome/browser/ui/color/arcium_space_color_mixer.h"
+#include "chrome/browser/ui/views/helium/glass_surface_configuration.h"
+#include "ui/color/arcium_palette.h"
+
+namespace helium {
+
+// The single migration/resolution path for legacy Space colors and profile
+// glows. The old profile Controls accent is deliberately not a color source.
+inline SpaceBackground ResolveSpacePaletteBackground(
+    const SpaceTheme* theme,
+    const GlassSurfaceConfiguration& legacy) {
+  if (theme && theme->background) {
+    return *theme->background;
+  }
+  SpaceBackground background;
+  background.tint_color = legacy.tint_color;
+  if (theme && theme->color) {
+    background.glows.push_back({.color = *theme->color, .id = "space-color"});
+  } else {
+    for (size_t i = 0; i < legacy.point_count; ++i) {
+      const auto& point = legacy.points[i];
+      background.glows.push_back({.color = point.color.toSkColor(),
+                                  .x = point.x,
+                                  .y = point.y,
+                                  .radius = point.radius,
+                                  .opacity = point.opacity,
+                                  .id = point.id});
+    }
+    background.tint_strength = legacy.tint_strength;
+    background.grain = legacy.grain;
+    const auto serialized = SerializeGlassSurfaceConfiguration(legacy);
+    background.color_harmony = *serialized.FindString("colorHarmony");
+    background.match_color_adjustments = legacy.match_color_adjustments;
+  }
+  return background;
+}
+
+inline ui::ArciumPalette SpacePaletteKey(
+    const SpaceTheme* theme,
+    const GlassSurfaceConfiguration& legacy) {
+  const auto background = ResolveSpacePaletteBackground(theme, legacy);
+  ui::ArciumPalette key;
+  const auto* accent = ResolveSpaceAccentGlow(
+      background, theme ? theme->accent_glow_id : std::string_view());
+  if (accent) {
+    key.seed = accent->color;
+  }
+  if (legacy.color_effect == GlassSurfaceColorEffect::kTint &&
+      background.tint_color) {
+    key.seed = *background.tint_color;
+    key.companion = key.seed;
+    if (theme) {
+      key.controls_chroma = theme->controls_chroma;
+      key.panels_chroma = theme->panels_chroma;
+    }
+    return key;
+  }
+  key.companion = key.seed;
+  for (const auto& glow : background.glows) {
+    if (&glow != accent) {
+      key.companion = glow.color;
+      break;
+    }
+  }
+  if (theme) {
+    key.controls_chroma = theme->controls_chroma;
+    key.panels_chroma = theme->panels_chroma;
+  }
+  return key;
+}
+
+inline GlassSurfaceConfiguration SpacePaletteAppearance(
+    const SpaceTheme* theme,
+    GlassSurfaceConfiguration configuration) {
+  const auto background = ResolveSpacePaletteBackground(theme, configuration);
+  configuration.point_count = std::min(background.glows.size(),
+                                       kMaxGlassColorPoints);
+  for (size_t i = 0; i < configuration.point_count; ++i) {
+    const auto& glow = background.glows[i];
+    configuration.points[i] = {
+        .id = glow.id.empty() ? "space-glow-" + base::NumberToString(i) : glow.id,
+        .color = SkColor4f::FromColor(glow.color),
+        .x = glow.x,
+        .y = glow.y,
+        .radius = glow.radius,
+        .opacity = glow.opacity};
+  }
+  configuration.tint_color = background.tint_color;
+  configuration.tint_strength = background.tint_strength;
+  configuration.grain = background.grain;
+  configuration.match_color_adjustments = background.match_color_adjustments;
+  base::DictValue serialized = SerializeGlassSurfaceConfiguration(configuration);
+  serialized.Set("colorHarmony", background.color_harmony);
+  return ParseGlassSurfaceConfiguration(serialized);
+}
+
+inline SpaceTheme WithSpacePaletteAppearance(
+    SpaceTheme theme,
+    const GlassSurfaceConfiguration& appearance) {
+  SpaceBackground background;
+  for (size_t i = 0; i < appearance.point_count; ++i) {
+    const auto& point = appearance.points[i];
+    background.glows.push_back({.color = point.color.toSkColor(),
+                                .x = point.x,
+                                .y = point.y,
+                                .radius = point.radius,
+                                .opacity = point.opacity,
+                                .id = point.id});
+  }
+  background.tint_color = appearance.tint_color;
+  background.tint_strength = appearance.tint_strength;
+  background.grain = appearance.grain;
+  const base::DictValue serialized = SerializeGlassSurfaceConfiguration(appearance);
+  background.color_harmony = *serialized.FindString("colorHarmony");
+  background.match_color_adjustments = appearance.match_color_adjustments;
+  theme.background = std::move(background);
+  theme.NormalizePaletteSource();
+  return theme;
+}
+
+// The palette derives from the authored glows. Add readability support below
+// them without recoloring or changing their placement, size, or intensity.
+inline void ApplySpacePaletteForRendering(
+    GlassSurfaceConfiguration& configuration,
+    const SpaceTheme* theme,
+    bool dark,
+    std::optional<SkColor> floor = std::nullopt) {
+  auto input = SpacePaletteKey(theme, configuration);
+  configuration.chrome_contrast_floor = floor
+      ? *floor : arcium::GenerateSpacePalette(input, dark).chrome_background;
+  if (!configuration.enabled) {
+    // Color selection also works with decorative effects off. This is a
+    // render-only copy; retain all saved points and grain in the recipe.
+    configuration.point_count = 0;
+    configuration.grain = 0;
+    return;
+  }
+}
+
+}  // namespace helium
+
+#endif  // CHROME_BROWSER_UI_HELIUM_SPACE_PALETTE_H_
