+  auto dark = arcium::GenerateSpacePalette(input, true);
+  const bool rendering_active = IsSpacePaletteRenderingActive();
+  if (!rendering_active) {
+    auto* browser = space->GetPrimaryBrowser();
+    auto* view = browser ? BrowserView::GetBrowserViewForBrowser(browser) : nullptr;
+    const auto* provider = view && view->GetWidget()
+        ? view->GetWidget()->GetColorProvider() : theme_service_->GetColorProvider();
+    if (provider) {
+      light = {.chrome = provider->GetColor(kColorToolbar),
+               .chrome_background = provider->GetColor(kColorToolbar),
+               .field = provider->GetColor(kColorLocationBarBackground),
+               .field_hovered = provider->GetColor(kColorLocationBarBackgroundHovered),
+               .panel = provider->GetColor(kColorOmniboxResultsBackground),
+               .panel_background = provider->GetColor(kColorOmniboxResultsBackground),
+               .text = provider->GetColor(kColorOmniboxText),
+               .muted_text = provider->GetColor(kColorOmniboxTextDimmed),
+               .outline = provider->GetColor(ui::kColorSysOutline),
+               .accent = provider->GetColor(ui::kColorSysPrimary),
+               .on_accent = provider->GetColor(ui::kColorSysOnPrimary),
+               .content_canvas = provider->GetColor(kColorToolbar),
+               .content_panel = provider->GetColor(kColorOmniboxResultsBackground),
+               .content_field = provider->GetColor(kColorLocationBarBackground),
+               .content_hovered = provider->GetColor(kColorLocationBarBackgroundHovered)};
+      dark = light;
+    }
+  }
+  auto roles = [](const arcium::SpacePaletteColors& colors) {
+    return base::DictValue()
+        .Set("canvas", ColorString(colors.content_canvas))
+        .Set("canvasPanel", ColorString(colors.content_panel))
+        .Set("canvasField", ColorString(colors.content_field))
+        .Set("canvasHover", ColorString(colors.content_hovered))
+        .Set("chrome", ColorString(colors.chrome))
+        .Set("field", ColorString(colors.field))
+        .Set("hover", ColorString(colors.field_hovered))
+        .Set("panel", ColorString(colors.panel))
+        .Set("text", ColorString(colors.text))
+        .Set("mutedText", ColorString(colors.muted_text))
+        .Set("outline", ColorString(colors.outline))
+        .Set("accent", ColorString(colors.accent))
+        .Set("onAccent", ColorString(colors.on_accent));
+  };
+  return base::DictValue()
+      .Set("available", !IsAppearanceManaged())
+      .Set("renderingActive", rendering_active)
+      .Set("id", space->id())
+      .Set("name", base::UTF16ToUTF8(space->name()))
+      .Set("accentGlowID", accent ? accent->id : std::string())
+      .Set("controlsChroma", input.controls_chroma / 100.0)
+      .Set("panelsChroma", input.panels_chroma / 100.0)
+      .Set("lightChromeOpacity", SkColorGetA(
+          light.chrome_background) / 255.0)
+      .Set("darkChromeOpacity", SkColorGetA(
+          dark.chrome_background) / 255.0)
+      .Set("lightPanelOpacity", SkColorGetA(
+          light.panel_background) / 255.0)
+      .Set("darkPanelOpacity", SkColorGetA(
+          dark.panel_background) / 255.0)
+      .Set("light", roles(light))
+      .Set("dark", roles(dark));
+}
+
+bool ArciumSettingsModel::SetSpaceAccent(std::string_view glow_id) {
+  auto* space = GetAppearanceSpace();
+  if (!space || IsAppearanceManaged() || !prefs_->IsUserModifiablePreference(
+          helium::kHeliumSpacesPref)) {
+    return false;
+  }
+  auto theme = helium::WithSpacePaletteAppearance(
+      space->theme(), helium::SpacePaletteAppearance(&space->theme(),
+          helium::ReadGlassSurfaceConfiguration(prefs_)));
+  const auto* glow = helium::ResolveSpaceAccentGlow(*theme.background, glow_id);
+  if (!glow || glow->id != glow_id) {
+    return false;
+  }
+  theme.accent_glow_id = glow->id;
+  theme.NormalizePaletteSource();
+  space_service_->SetSpaceTheme(space->id(), std::move(theme));
+  NotifyChanged();
+  return true;
+}
+
+bool ArciumSettingsModel::SetSpacePaletteChroma(const base::DictValue& tuning) {
+  auto* space = GetAppearanceSpace();
+  if (!space || IsAppearanceManaged() || !prefs_->IsUserModifiablePreference(
+          helium::kHeliumSpacesPref) || tuning.size() != 2) {
+    return false;
+  }
+  const auto controls = tuning.FindDouble("controlsChroma");
+  const auto panels = tuning.FindDouble("panelsChroma");
+  if (!controls || !panels || !std::isfinite(*controls) ||
+      !std::isfinite(*panels) || *controls < 0 || *controls > 2 ||
+      *panels < 0 || *panels > 2) {
+    return false;
+  }
+  // Freeze the migration input before the first per-Space edit.
+  auto theme = helium::WithSpacePaletteAppearance(
+      space->theme(), helium::SpacePaletteAppearance(&space->theme(),
+          helium::ReadGlassSurfaceConfiguration(prefs_)));
+  theme.controls_chroma = std::lround(*controls * 100);
+  theme.panels_chroma = std::lround(*panels * 100);
+  space_service_->SetSpaceTheme(space->id(), std::move(theme));
+  NotifyChanged();
+  return true;
+}
