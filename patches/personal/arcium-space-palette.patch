+  }
+  recipe.color_effect = GlassSurfaceColorEffect::kTint;
+  recipe.point_count = 0;
+  const auto empty = WithSpacePaletteAppearance(SpaceTheme(), recipe);
+  const auto empty_stored = empty.ToDict();
+  const auto restored = SpaceTheme::FromDict(&empty_stored);
+  ASSERT_TRUE(restored.background);
+  EXPECT_TRUE(restored.background->glows.empty());
+  EXPECT_EQ(restored.background->tint_color, recipe.tint_color);
+  const auto painting = GlassSurfaceConfigurationForPainting(
+      SpacePaletteAppearance(&restored, recipe));
+  EXPECT_EQ(painting.point_count, 0u);
+  EXPECT_DOUBLE_EQ(painting.grain, 0.0);
+}
+
+TEST_F(HeliumSpaceServiceTest, PaletteRenderingPreservesDisabledEffects) {
+  auto recipe = DefaultGlassSurfaceConfiguration();
+  recipe.enabled = false;
+  auto theme = WithSpacePaletteAppearance(SpaceTheme(), recipe);
+  const auto saved = theme;
+  auto rendering = SpacePaletteAppearance(&theme, recipe);
+  ApplySpacePaletteForRendering(rendering, &theme, false);
+  EXPECT_FALSE(rendering.enabled);
+  EXPECT_EQ(rendering.point_count, 0U);
+  EXPECT_DOUBLE_EQ(rendering.grain, 0);
+  ASSERT_TRUE(rendering.chrome_contrast_floor);
+  EXPECT_GT(SkColorGetA(*rendering.chrome_contrast_floor), 0);
+  EXPECT_EQ(theme, saved);
+  EXPECT_EQ(SpacePaletteKey(&theme, rendering), SpacePaletteKey(&theme, recipe));
+
+  recipe.enabled = true;
+  rendering = SpacePaletteAppearance(&theme, recipe);
+  ApplySpacePaletteForRendering(rendering, &theme, false);
+  EXPECT_TRUE(rendering.enabled);
+  EXPECT_EQ(rendering.point_count, recipe.point_count);
+  EXPECT_DOUBLE_EQ(rendering.grain, recipe.grain);
+  EXPECT_EQ(theme, saved);
+}
+
+TEST_F(HeliumSpaceServiceTest, SelectedAccentPreservesRecipeAndFallsBackOnDeletion) {
+  auto recipe = DefaultGlassSurfaceConfiguration();
+  ASSERT_GE(recipe.point_count, 2U);
+  auto theme = WithSpacePaletteAppearance(SpaceTheme(), recipe);
+  theme.accent_glow_id = recipe.points[1].id;
+  theme.NormalizePaletteSource();
+  const auto saved_background = theme.background;
+  EXPECT_EQ(theme.color, recipe.points[1].color.toSkColor());
+  auto key = SpacePaletteKey(&theme, recipe);
+  EXPECT_EQ(key.seed, recipe.points[1].color.toSkColor());
+  EXPECT_EQ(key.companion, recipe.points[0].color.toSkColor());
+  auto restored = WithSpacePaletteAppearance(theme, recipe);
+  EXPECT_EQ(restored, theme);
+  EXPECT_EQ(restored.background, saved_background);
+  const auto serialized = restored.ToDict();
+  EXPECT_EQ(SpaceTheme::FromDict(&serialized), theme);
+  // Reordering does not change the selected color or any authored geometry.
+  std::swap(recipe.points[0], recipe.points[1]);
+  restored = WithSpacePaletteAppearance(theme, recipe);
+  EXPECT_EQ(restored.accent_glow_id, theme.accent_glow_id);
+  EXPECT_EQ(SpacePaletteKey(&restored, recipe).seed, key.seed);
+  restored.background->glows.erase(restored.background->glows.begin());
+  restored.NormalizePaletteSource();
+  EXPECT_EQ(restored.accent_glow_id, restored.background->glows.front().id);
+  EXPECT_EQ(restored.color, restored.background->glows.front().color);
+  restored.background->glows.clear();
+  restored.NormalizePaletteSource();
+  EXPECT_TRUE(restored.accent_glow_id.empty());
+  EXPECT_FALSE(restored.color);
+}
+
+TEST_F(HeliumSpaceServiceTest, AccentModelKeepsCapturedSpaceAndRejectsInvalidWrites) {
+  const auto recipe = DefaultGlassSurfaceConfiguration();
+  ASSERT_GE(recipe.point_count, 2U);
+  auto* other = service_->GetOrCreateSpace("accent-other", u"Other");
+  service_->SetSpaceTheme(space_->id(), WithSpacePaletteAppearance(SpaceTheme(), recipe));
+  service_->SetSpaceTheme(other->id(), WithSpacePaletteAppearance(SpaceTheme(), recipe));
+  const auto space_id = space_->id();
+  const auto other_id = other->id();
+  const auto original = space_->theme();
+  const auto other_original = other->theme();
+  arcium_settings::ArciumSettingsModel model(profile(), base::DoNothing(), base::DoNothing());
+  ASSERT_TRUE(model.SetAppearanceSpace(space_->id()));
+  service_->SetActiveSpace(other->id());
+  ASSERT_TRUE(model.SetSpaceAccent(recipe.points[1].id));
+  EXPECT_EQ(space_->theme().accent_glow_id, recipe.points[1].id);
+  EXPECT_EQ(space_->theme().background, original.background);
+  EXPECT_EQ(other->theme(), other_original);
+  EXPECT_EQ(*model.GetSpacePalette().FindString("accentGlowID"), recipe.points[1].id);
+  const auto selected = space_->theme();
+  EXPECT_FALSE(model.SetSpaceAccent("deleted-glow"));
+  EXPECT_EQ(space_->theme(), selected);
+  auto* test_prefs = profile()->GetTestingPrefService();
+  test_prefs->SetManagedPref(prefs::kBrowserColorScheme, base::Value(0));
+  EXPECT_FALSE(model.SetSpaceAccent(recipe.points[0].id));
+  test_prefs->RemoveManagedPref(prefs::kBrowserColorScheme);
+  test_prefs->SetManagedPref(kHeliumSpacesPref, base::Value(test_prefs->GetList(kHeliumSpacesPref).Clone()));
+  EXPECT_FALSE(model.SetSpaceAccent(recipe.points[0].id));
+  test_prefs->RemoveManagedPref(kHeliumSpacesPref);
+  EXPECT_EQ(service_->GetSpaceById(space_id)->theme(), selected);
+  ASSERT_TRUE(model.SetAppearanceSpace(other_id));
+  EXPECT_TRUE(model.SetSpaceAccent(recipe.points[1].id));
+  EXPECT_EQ(space_->theme(), selected);
+  ASSERT_TRUE(service_->DeleteSpace(other_id));
+  EXPECT_FALSE(model.SetSpaceAccent(recipe.points[0].id));
+  EXPECT_EQ(service_->GetSpaceById(space_id)->theme(), selected);
+}
+
