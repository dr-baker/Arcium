+
+class SpacePaletteInitializer final
+    : public ui::ColorProviderKey::InitializerSupplier {
+ public:
+  explicit SpacePaletteInitializer(const ui::ArciumPalette& palette)
+      : palette_(palette) {}
+  ~SpacePaletteInitializer() override = default;
+  void AddColorMixers(ui::ColorProvider* provider,
+                      const ui::ColorProviderKey& key) const override {
+    AddSpaceColors(provider, key, &palette_);
+  }
+ private:
+  const ui::ArciumPalette palette_;
+};
+
+struct SpaceInitializers {
+  base::Lock lock;
+  std::map<ui::ArciumPalette, std::unique_ptr<SpacePaletteInitializer>> values;
+  std::set<const ui::ColorProviderKey::InitializerSupplier*> pointers;
+};
+
+SpaceInitializers& Initializers() {
+  // ColorProviderManager retains initializer identities in its keys. Interned
+  // values live for the process, so revisiting a palette reuses that identity.
+  static base::NoDestructor<SpaceInitializers> initializers;
+  return *initializers;
+}
+}  // namespace
+
+void AddArciumSpaceColorMixer(ui::ColorProvider* provider,
+                             const ui::ColorProviderKey& key) {
+  AddSpaceColors(provider, key, nullptr);
+}
+
+namespace arcium {
+ui::ColorProviderKey::InitializerSupplier* GetSpacePaletteInitializer(
+    const ui::ArciumPalette& palette) {
+  auto& initializers = Initializers();
+  base::AutoLock lock(initializers.lock);
+  auto [entry, inserted] = initializers.values.try_emplace(palette);
+  if (inserted) {
+    entry->second = std::make_unique<SpacePaletteInitializer>(palette);
+    initializers.pointers.insert(entry->second.get());
+  }
+  return entry->second.get();
+}
+
+bool IsSpacePaletteInitializer(
+    const ui::ColorProviderKey::InitializerSupplier* initializer) {
+  auto& initializers = Initializers();
+  base::AutoLock lock(initializers.lock);
+  return initializers.pointers.contains(initializer);
+}
+}  // namespace arcium
