@@ -0,0 +1,145 @@
+// Copyright 2026 The Helium Authors
+// SPDX-License-Identifier: GPL-3.0-only
+#include "chrome/browser/ui/color/arcium_space_color_mixer.h"
+
+#include <cmath>
+#include <limits>
+
+#include "testing/gtest/include/gtest/gtest.h"
+
+namespace arcium {
+namespace {
+
+SkColor Composite(SkColor foreground, SkColor background) {
+  const int alpha = SkColorGetA(foreground);
+  auto blend = [alpha](int a, int b) {
+    return (a * alpha + b * (255 - alpha) + 127) / 255;
+  };
+  return SkColorSetRGB(
+      blend(SkColorGetR(foreground), SkColorGetR(background)),
+      blend(SkColorGetG(foreground), SkColorGetG(background)),
+      blend(SkColorGetB(foreground), SkColorGetB(background)));
+}
+
+TEST(ArciumSpacePalette, ContrastAcrossHueChromaModeAndRoleDials) {
+  for (int hue = 0; hue < 360; hue += 15) {
+    for (double chroma : {0., .05, .2, .4}) {
+      for (int controls : {0, 100, 200}) {
+        for (int panels : {0, 35, 200}) {
+          for (bool dark : {false, true}) {
+            SCOPED_TRACE(testing::Message() << hue << ',' << chroma << ','
+                         << controls << ',' << panels << ',' << dark);
+            ui::ArciumPalette input;
+            input.seed = OklchToColor({.65, chroma, double(hue)});
+            input.controls_chroma = controls;
+            input.panels_chroma = panels;
+            const auto colors = GenerateSpacePalette(input, dark);
+            for (SkColor background : {colors.chrome, colors.field,
+                                       colors.field_hovered, colors.panel,
+                                       colors.content_canvas, colors.content_panel,
+                                       colors.content_field, colors.content_hovered}) {
+              EXPECT_GE(ContrastRatio(colors.text, background), 7);
+              EXPECT_GE(ContrastRatio(colors.muted_text, background), 4.5);
+              EXPECT_GE(ContrastRatio(colors.outline, background), 3);
+            }
+            EXPECT_GE(ContrastRatio(colors.on_accent, colors.accent), 4.5);
+            for (SkColor backdrop : {SK_ColorBLACK, SK_ColorWHITE}) {
+              const auto chrome = Composite(colors.chrome_background, backdrop);
+              EXPECT_GE(ContrastRatio(colors.text, chrome), 4.5);
+              EXPECT_GE(ContrastRatio(colors.muted_text, chrome), 4.5);
+              const auto actual = Composite(colors.panel_background, backdrop);
+              EXPECT_GE(ContrastRatio(colors.text, actual), 4.5);
+              EXPECT_GE(ContrastRatio(colors.muted_text, actual), 4.5);
+            }
+          }
+        }
+      }
+    }
+  }
+}
+
+TEST(ArciumSpacePalette, LargeSurfacesKeepOnlyARestainedTint) {
+  for (int hue = 0; hue < 360; hue += 15) {
+    for (bool dark : {false, true}) {
+      ui::ArciumPalette input;
+      input.seed = OklchToColor({.65, .4, double(hue)});
+      input.panels_chroma = 200;
+      const auto colors = GenerateSpacePalette(input, dark);
+      for (SkColor surface : {colors.content_canvas, colors.content_panel,
+                             colors.content_field, colors.content_hovered}) {
+        // Allow for the quantization of the 8-bit display color.
+        EXPECT_LE(ColorToOklch(surface).chroma, .016);
+      }
+      EXPECT_LE(ColorToOklch(colors.content_canvas).chroma,
+                ColorToOklch(colors.chrome).chroma + .004);
+      EXPECT_LE(ColorToOklch(colors.content_panel).chroma,
+                ColorToOklch(colors.panel).chroma + .004);
+      input.panels_chroma = 0;
+      EXPECT_LT(ColorToOklch(GenerateSpacePalette(input, dark).content_canvas)
+                    .chroma, .001);
+    }
+  }
+}
+
+TEST(ArciumSpacePalette, MutedTextOnAuthoredGlowCapture) {
+  ui::ArciumPalette input;
+  input.seed = SkColorSetRGB(255, 48, 224);
+  const auto colors = GenerateSpacePalette(input, true);
+  // Solid adjacent background pixels from the native secondary-glow capture.
+  EXPECT_GE(ContrastRatio(colors.muted_text, SkColorSetRGB(52, 63, 78)), 4.5);
+  EXPECT_LT(ColorToOklch(colors.muted_text).lightness,
+            ColorToOklch(colors.text).lightness);
+}
+
+TEST(ArciumSpacePalette, GamutMappingPreservesLightnessAndRampOrder) {
+  for (int hue = 0; hue < 360; hue += 5) {
+    double previous = -1;
+    for (int step = 0; step <= 100; ++step) {
+      const double lightness = step / 100.;
+      const auto actual = ColorToOklch(OklchToColor({lightness, .4, double(hue)}));
+      EXPECT_GE(actual.lightness, previous - .004);
+      previous = actual.lightness;
+      // At the black end, 8-bit sRGB cannot represent every perceptual stop.
+      if (step >= 10) {
+        EXPECT_NEAR(actual.lightness, lightness, step < 20 ? .015 : .008);
+      }
+    }
+  }
+}
+
+TEST(ArciumSpacePalette, ChromaDialsKeepRoleLightnessAndOtherRolesStable) {
+  ui::ArciumPalette input;
+  input.seed = SkColorSetRGB(178, 97, 225);
+  const auto normal = GenerateSpacePalette(input, true);
+  input.controls_chroma = 0;
+  const auto muted = GenerateSpacePalette(input, true);
+  EXPECT_EQ(normal.panel, muted.panel);
+  EXPECT_NE(normal.accent, muted.accent);
+  EXPECT_NEAR(ColorToOklch(normal.accent).lightness,
+              ColorToOklch(muted.accent).lightness, .005);
+  EXPECT_LT(ColorToOklch(muted.accent).chroma, .001);
+  input.panels_chroma = 200;
+  EXPECT_EQ(muted.accent, GenerateSpacePalette(input, true).accent);
+  EXPECT_NE(muted.panel, GenerateSpacePalette(input, true).panel);
+}
+
+TEST(ArciumSpacePalette, CacheIdentityIncludesBothDialsAndCompanion) {
+  ui::ArciumPalette first;
+  auto second = first;
+  second.controls_chroma++;
+  EXPECT_NE(first, second);
+  second = first;
+  second.panels_chroma++;
+  EXPECT_NE(first, second);
+  second = first;
+  second.companion = SK_ColorRED;
+  EXPECT_NE(first, second);
+}
+
+TEST(ArciumSpacePalette, InvalidSamplesFailClosed) {
+  EXPECT_EQ(SK_ColorBLACK, OklchToColor(
+      {.5, std::numeric_limits<double>::quiet_NaN(), 20}));
+}
+
+}  // namespace
+}  // namespace arcium
