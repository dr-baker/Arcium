+// Copyright 2026 The Helium Authors
+// SPDX-License-Identifier: GPL-3.0-only
+
+#include "chrome/browser/ui/color/arcium_space_color_mixer.h"
+
+#include <algorithm>
+#include <array>
+#include <cmath>
+#include <numbers>
+
+
+namespace arcium {
+namespace {
+
+double Linear(double value) {
+  return value <= 0.04045 ? value / 12.92
+                          : std::pow((value + 0.055) / 1.055, 2.4);
+}
+
+double Encoded(double value) {
+  return value <= 0.0031308 ? 12.92 * value
+                            : 1.055 * std::pow(value, 1.0 / 2.4) - 0.055;
+}
+
+// Bjorn Ottosson's D65 Oklab matrices, also used by the native picker.
+// https://bottosson.github.io/posts/oklab/
+std::array<double, 3> LinearRgb(Oklch color) {
+  const double angle = color.hue * std::numbers::pi / 180.0;
+  const double a = color.chroma * std::cos(angle);
+  const double b = color.chroma * std::sin(angle);
+  const double l = std::pow(color.lightness + 0.3963377774 * a +
+                               0.2158037573 * b, 3);
+  const double m = std::pow(color.lightness - 0.1055613458 * a -
+                               0.0638541728 * b, 3);
+  const double s = std::pow(color.lightness - 0.0894841775 * a -
+                               1.2914855480 * b, 3);
+  return {4.0767416621 * l - 3.3077115913 * m + 0.2309699292 * s,
+          -1.2684380046 * l + 2.6097574011 * m - 0.3413193965 * s,
+          -0.0041960863 * l - 0.7034186147 * m + 1.7076147010 * s};
+}
+
+bool InGamut(const std::array<double, 3>& rgb) {
+  return std::ranges::all_of(rgb, [](double channel) {
+    return channel >= -1e-7 && channel <= 1.0000001;
+  });
+}
+
+SkColor Tone(Oklch seed, double lightness, double chroma_scale) {
+  return OklchToColor({lightness,
+                       seed.chroma * chroma_scale *
+                           std::sin(std::numbers::pi * lightness),
+                       seed.hue});
+}
+
+double Luminance(SkColor color) {
+  return 0.2126 * Linear(SkColorGetR(color) / 255.0) +
+         0.7152 * Linear(SkColorGetG(color) / 255.0) +
+         0.0722 * Linear(SkColorGetB(color) / 255.0);
+}
+
+SkColor Foreground(Oklch seed,
+                   double start,
+                   bool lighter,
+                   double ratio,
+                   const std::array<SkColor, 3>& backgrounds) {
+  // Search the perceptual ramp, then verify the quantized display color.
+  // Saturation cannot be used as a substitute for readable lightness.
+  for (int step = 0; step <= 100; ++step) {
+    const double lightness = std::clamp(
+        start + (lighter ? 1 : -1) * step / 100.0, 0.0, 1.0);
+    const SkColor candidate = Tone(seed, lightness, 0.12);
+    if (std::ranges::all_of(backgrounds, [=](SkColor background) {
+          return ContrastRatio(candidate, background) >= ratio;
+        })) {
+      return candidate;
+    }
+  }
+  return lighter ? SK_ColorWHITE : SK_ColorBLACK;
+}
+
+SkColor Composite(SkColor foreground, SkColor background, int alpha) {
+  auto blend = [alpha](int fg, int bg) {
+    return (fg * alpha + bg * (255 - alpha) + 127) / 255;
+  };
+  return SkColorSetRGB(
+      blend(SkColorGetR(foreground), SkColorGetR(background)),
+      blend(SkColorGetG(foreground), SkColorGetG(background)),
+      blend(SkColorGetB(foreground), SkColorGetB(background)));
+}
+
+SkColor ReadablePanelBackground(SkColor panel,
+                               SkColor text,
+                               SkColor muted_text) {
+  // Glass can sit above any page. A compositor-painted contrast floor above
+  // the native material bounds the worst-case black and white backdrops.
+  for (int alpha = 0; alpha <= 255; ++alpha) {
+    bool readable = true;
+    for (SkColor backdrop : {SK_ColorBLACK, SK_ColorWHITE}) {
+      const SkColor composite = Composite(panel, backdrop, alpha);
+      readable &= ContrastRatio(text, composite) >= 4.5 &&
+                  ContrastRatio(muted_text, composite) >= 4.5;
+    }
+    if (readable) {
+      return SkColorSetA(panel, alpha);
+    }
+  }
+  return panel;
+}
+
+}  // namespace
+
+Oklch ColorToOklch(SkColor color) {
+  const double r = Linear(SkColorGetR(color) / 255.0);
+  const double g = Linear(SkColorGetG(color) / 255.0);
+  const double b = Linear(SkColorGetB(color) / 255.0);
+  const double l = std::cbrt(0.4122214708 * r + 0.5363325363 * g +
+                             0.0514459929 * b);
+  const double m = std::cbrt(0.2119034982 * r + 0.6806995451 * g +
+                             0.1073969566 * b);
+  const double s = std::cbrt(0.0883024619 * r + 0.2817188376 * g +
+                             0.6299787005 * b);
+  const double a = 1.9779984951 * l - 2.4285922050 * m + 0.4505937099 * s;
+  const double lab_b = 0.0259040371 * l + 0.7827717662 * m - 0.8086757660 * s;
+  double hue = std::atan2(lab_b, a) * 180.0 / std::numbers::pi;
+  if (hue < 0) {
+    hue += 360;
+  }
+  const double chroma = std::hypot(a, lab_b);
+  return {0.2104542553 * l + 0.7936177850 * m - 0.0040720468 * s,
+          chroma < 1e-6 ? 0 : chroma, chroma < 1e-6 ? 0 : hue};
+}
+
+SkColor OklchToColor(Oklch color) {
+  if (!std::isfinite(color.lightness) || !std::isfinite(color.chroma) ||
+      !std::isfinite(color.hue)) {
+    return SK_ColorBLACK;
+  }
+  color.lightness = std::clamp(color.lightness, 0.0, 1.0);
+  color.chroma = std::clamp(color.chroma, 0.0, 0.5);
+  auto rgb = LinearRgb(color);
+  if (!InGamut(rgb)) {
+    double low = 0;
+    double high = color.chroma;
+    for (int i = 0; i < 24; ++i) {
+      const double mid = (low + high) / 2;
+      (InGamut(LinearRgb({color.lightness, mid, color.hue})) ? low : high) = mid;
+    }
+    rgb = LinearRgb({color.lightness, low, color.hue});
+  }
+  auto byte = [](double value) {
+    return std::clamp(std::lround(Encoded(std::clamp(value, 0.0, 1.0)) * 255),
+                      0L, 255L);
+  };
+  return SkColorSetRGB(byte(rgb[0]), byte(rgb[1]), byte(rgb[2]));
+}
+
+double ContrastRatio(SkColor a, SkColor b) {
+  const double first = Luminance(a);
+  const double second = Luminance(b);
+  return (std::max(first, second) + 0.05) /
+         (std::min(first, second) + 0.05);
+}
+
+SpacePaletteColors GenerateSpacePalette(
+    const ui::ArciumPalette& input,
+    bool dark) {
+  const Oklch seed = ColorToOklch(input.seed);
+  const double panels = input.panels_chroma / 100.0;
+  SpacePaletteColors colors;
+  // Keep the large page and Settings surfaces near neutral even when the
+  // authored glows and chrome are vivid. Preserve hue and role lightness;
+  // only content chroma is capped, independently of controls and decoration.
+  auto content_tone = [seed, panels](double lightness) {
+    const double chroma = std::min(
+        seed.chroma * panels * 0.15 *
+            std::sin(std::numbers::pi * lightness), 0.012);
+    return OklchToColor({lightness, chroma, seed.hue});
+  };
+  colors.content_canvas = content_tone(dark ? 0.16 : 0.965);
+  colors.content_panel = content_tone(dark ? 0.22 : 0.975);
+  colors.content_field = content_tone(dark ? 0.24 : 0.925);
+  colors.content_hovered = content_tone(dark ? 0.28 : 0.90);
+  colors.chrome = Tone(seed, dark ? 0.16 : 0.965, panels);
+  colors.field = Tone(seed, dark ? 0.24 : 0.925, panels);
+  colors.field_hovered = Tone(seed, dark ? 0.28 : 0.90, panels);
+  colors.panel = Tone(seed, dark ? 0.22 : 0.975, panels);
+  const std::array<SkColor, 3> backgrounds = {
+      colors.chrome, colors.field_hovered, colors.panel};
+  colors.text = Foreground(seed, dark ? 0.94 : 0.19, dark, 7, backgrounds);
+  const SkColor floor_muted_text =
+      Foreground(seed, dark ? 0.73 : 0.40, dark, 4.5, backgrounds);
+  // Add headroom for secondary labels over authored glows without weakening
+  // the existing backdrop floor or changing the decorative colors.
+  colors.muted_text = dark ? Foreground(seed, 0.75, true, 4.5, backgrounds)
+                           : floor_muted_text;
+  colors.outline = Foreground(seed, dark ? 0.61 : 0.50, dark, 3, backgrounds);
+  colors.accent = Tone(seed, dark ? 0.78 : 0.46,
+                        input.controls_chroma / 100.0);
+  colors.on_accent = Foreground(
+      seed, dark ? 0.16 : 0.98, !dark, 4.5,
+      {colors.accent, colors.accent, colors.accent});
+  colors.chrome_background =
+      ReadablePanelBackground(colors.chrome, colors.text, floor_muted_text);
+  colors.panel_background =
+      ReadablePanelBackground(colors.panel, colors.text, floor_muted_text);
+  return colors;
+}
+
+}  // namespace arcium
+
