Index: src/chrome/browser/ui/color/arcium_space_color_mixer_unittest.cc
===================================================================
--- /dev/null
+++ src/chrome/browser/ui/color/arcium_space_color_mixer_unittest.cc
@@ -0,0 +1,72 @@
+// Copyright 2026 The Helium Authors
+// SPDX-License-Identifier: GPL-3.0-only
+#include "chrome/browser/ui/color/arcium_space_color_mixer.h"
+#include "chrome/browser/ui/color/arcium_space_palette_initializer.h"
+#include "chrome/browser/ui/color/chrome_color_id.h"
+#include "testing/gtest/include/gtest/gtest.h"
+#include "ui/color/color_mixer.h"
+#include "ui/color/color_provider.h"
+#include "ui/color/color_recipe.h"
+
+TEST(ArciumSpaceColorMixer, InitializerIdentityIncludesWholeRecipe) {
+  ui::ArciumPalette input;
+  auto* first = arcium::GetSpacePaletteInitializer(input);
+  EXPECT_EQ(first, arcium::GetSpacePaletteInitializer(input));
+  auto other = input;
+  other.controls_chroma += 1;
+  EXPECT_NE(first, arcium::GetSpacePaletteInitializer(other));
+  other = input;
+  other.panels_chroma += 1;
+  EXPECT_NE(first, arcium::GetSpacePaletteInitializer(other));
+  other = input;
+  other.companion ^= 1;
+  EXPECT_NE(first, arcium::GetSpacePaletteInitializer(other));
+  EXPECT_TRUE(arcium::IsSpacePaletteInitializer(first));
+  EXPECT_FALSE(arcium::IsSpacePaletteInitializer(nullptr));
+  EXPECT_EQ(first, arcium::GetSpacePaletteInitializer(input));
+}
+
+TEST(ArciumSpaceColorMixer, PerWindowCallbackAppliesResolvedRoles) {
+  ui::ArciumPalette input;
+  for (bool dark : {false, true}) {
+    ui::ColorProvider provider;
+    ui::ColorProviderKey key;
+    key.color_mode = dark ? ui::ColorProviderKey::ColorMode::kDark
+                          : ui::ColorProviderKey::ColorMode::kLight;
+    key.app_controller = arcium::GetSpacePaletteInitializer(input);
+    AddArciumSpaceColorMixer(&provider, key);
+    key.app_controller->AddColorMixers(&provider, key);
+    provider.GenerateColorMapForTesting();
+    const auto expected = arcium::GenerateSpacePalette(input, dark);
+    EXPECT_EQ(provider.GetColor(kColorNewTabPageBackground), expected.content_canvas);
+    EXPECT_EQ(provider.GetColor(kColorArciumChrome), expected.chrome);
+    EXPECT_EQ(provider.GetColor(kColorToolbar), expected.chrome);
+    EXPECT_EQ(provider.GetColor(kColorArciumPanelBackground), expected.panel_background);
+    EXPECT_EQ(provider.GetColor(kColorOmniboxResultsBackgroundSelected), expected.accent);
+    EXPECT_EQ(provider.GetColor(kColorOmniboxResultsTextSelected), expected.on_accent);
+  }
+}
+
+TEST(ArciumSpaceColorMixer, AccessibilityRetainsStockRoles) {
+  for (bool forced : {false, true}) {
+    ui::ColorProvider provider;
+    auto& stock = provider.AddMixer();
+    stock[kColorToolbar] = {SK_ColorWHITE};
+    stock[kColorOmniboxResultsBackground] = {SK_ColorBLACK};
+    stock[kColorOmniboxText] = {SK_ColorWHITE};
+    stock[kColorOmniboxTextDimmed] = {SK_ColorGRAY};
+    ui::ColorProviderKey key;
+    if (forced) {
+      key.forced_colors = ui::ColorProviderKey::ForcedColors::kWhite;
+    } else {
+      key.contrast_mode = ui::ColorProviderKey::ContrastMode::kHigh;
+    }
+    AddArciumSpaceColorMixer(&provider, key);
+    arcium::GetSpacePaletteInitializer(ui::ArciumPalette())->AddColorMixers(
+        &provider, key);
+    provider.GenerateColorMapForTesting();
+    EXPECT_EQ(provider.GetColor(kColorArciumChrome), SK_ColorWHITE);
+    EXPECT_EQ(provider.GetColor(kColorArciumPanel), SK_ColorBLACK);
+    EXPECT_EQ(provider.GetColor(kColorArciumMutedText), SK_ColorGRAY);
+  }
+}
