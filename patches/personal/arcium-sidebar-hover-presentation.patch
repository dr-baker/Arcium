+void VerticalTabStripStateControllerImpl::SetTemporaryExpandedPresentation(
+    bool expanded) {
+  if (temporary_expanded_presentation_ == expanded) {
+    return;
+  }
+  temporary_expanded_presentation_ = expanded;
+  // Coalesce after collapse dispatch so later observers cannot see stale state.
+  // Call the base notifier directly; the implementation also persists state.
+  temporary_presentation_notification_timer_.Start(
+      FROM_HERE, base::TimeDelta(),
+      base::BindOnce(
+          [](VerticalTabStripStateControllerImpl* controller) {
+            controller->VerticalTabStripStateController::NotifyCollapseChanged(
+                controller->GetCollapseState());
+          },
+          base::Unretained(this)));
+}
