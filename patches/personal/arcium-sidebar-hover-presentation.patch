+namespace {
+class PaletteThemeChangeObserver : public views::WidgetObserver {
+ public:
+  explicit PaletteThemeChangeObserver(views::Widget* widget,
+                                      bool capture_panel = false)
+      : capture_panel_(capture_panel) {
+    observation_.Observe(widget);
+    if (capture_panel_) {
+      panel_color = widget->GetColorProvider()->GetColor(kColorArciumPanel);
+    }
+  }
+  void OnWidgetThemeChanged(views::Widget* widget) override {
+    ++changes;
+    if (capture_panel_) {
+      panel_color = widget->GetColorProvider()->GetColor(kColorArciumPanel);
+    }
+  }
+  void OnWidgetDestroying(views::Widget*) override { observation_.Reset(); }
+
+  int changes = 0;
+  SkColor panel_color = SK_ColorTRANSPARENT;
+
+ private:
+  const bool capture_panel_;
+  base::ScopedObservation<views::Widget, views::WidgetObserver> observation_{this};
+};
+}  // namespace
+
+TEST_F(ArciumBrowserChromeTest, ColorModeRefreshesCachedPaletteAndOwnedWidgets) {
+  auto* spaces = helium::HeliumSpaceServiceFactory::GetForProfile(browser()->profile());
+  ASSERT_TRUE(spaces);
+  auto* space = spaces->GetOrCreateSpace("mode-palette", u"Mode palette");
+  auto recipe = helium::DefaultGlassSurfaceConfiguration();
+  recipe.point_count = 1;
+  recipe.points[0].color = SkColor4f::FromColor(SK_ColorGREEN);
+  recipe.tint_color = SK_ColorRED;
+  recipe.color_effect = helium::GlassSurfaceColorEffect::kGlows;
+  spaces->SetSpaceTheme(space->id(),
+      helium::WithSpacePaletteAppearance(helium::SpaceTheme(), recipe));
+  spaces->SetSpaceForBrowser(browser(), space->id());
+  prefs()->SetDict(helium::kArciumChromeAppearancePref,
+                   helium::SerializeGlassSurfaceConfiguration(recipe));
+  const auto saved_theme = space->theme();
+  auto* widget = browser_view()->browser_widget();
+  auto owned = std::make_unique<views::Widget>();
+  views::Widget::InitParams params(views::Widget::InitParams::CLIENT_OWNS_WIDGET,
+                                  views::Widget::InitParams::TYPE_POPUP);
+  params.parent = widget->GetNativeView();
+  owned->Init(std::move(params));
+  ASSERT_TRUE(views::Widget::GetAllOwnedWidgets(widget->GetNativeView()).contains(owned.get()));
+  PaletteThemeChangeObserver browser_changes(widget, true);
+  PaletteThemeChangeObserver owned_changes(owned.get());
+  const SkColor glow_panel = browser_changes.panel_color;
+  ASSERT_NE(glow_panel, gfx::kPlaceholderColor);
+
+  recipe.color_effect = helium::GlassSurfaceColorEffect::kTint;
+  prefs()->SetDict(helium::kArciumChromeAppearancePref,
+                   helium::SerializeGlassSurfaceConfiguration(recipe));
+  EXPECT_EQ(space->theme(), saved_theme);
+  EXPECT_GT(browser_changes.changes, 0);
+  EXPECT_GT(owned_changes.changes, 0);
+  EXPECT_NE(browser_changes.panel_color, glow_panel);
+  const int browser_notifications = browser_changes.changes;
+  const int owned_notifications = owned_changes.changes;
+
+  recipe.grain = 0.12;
+  recipe.material_opacity = 0.6;
+  prefs()->SetDict(helium::kArciumChromeAppearancePref,
+                   helium::SerializeGlassSurfaceConfiguration(recipe));
+  EXPECT_EQ(browser_changes.changes, browser_notifications);
+  EXPECT_EQ(owned_changes.changes, owned_notifications);
+
+  recipe.color_effect = helium::GlassSurfaceColorEffect::kGlows;
+  prefs()->SetDict(helium::kArciumChromeAppearancePref,
+                   helium::SerializeGlassSurfaceConfiguration(recipe));
+  EXPECT_GT(browser_changes.changes, browser_notifications);
+  EXPECT_GT(owned_changes.changes, owned_notifications);
+  EXPECT_EQ(browser_changes.panel_color, glow_panel);
+  EXPECT_EQ(space->theme(), saved_theme);
+}
