+  if (temporary_expanded_presentation_ == expanded) {
+    return;
+  }
+  temporary_expanded_presentation_ = expanded;
+  // Coalesce after any in-flight collapse dispatch. A callback may itself
+  // start hover reveal; nested notifications would leave later observers
+  // with the stale outer collapsed state. This path never persists state.
