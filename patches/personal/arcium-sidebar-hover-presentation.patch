+void VerticalTabStripRegionView::UpdateTemporaryExpandedPresentation() {
+  const bool expanded =
+      is_attached_to_widget_ && IsSidebarNavigationTemporarilyExpanded();
+  if (auto* background =
+          static_cast<CustomCornersBackground*>(this->background())) {
+    background->SetPaintWithNativeFrameMaterials((floating_style_ != FloatingStyle::kNone) ||
+                                                 expanded);
+  }
+  state_controller_->SetTemporaryExpandedPresentation(expanded);
+  // Native widget removal also runs during Browser teardown, after its
+  // animation controller is gone. Only update live layout while attached.
+  if (!is_attached_to_widget_) {
+    return;
+  }
+  UpdateResizeAreaVisibility();
+  SchedulePaint();
+}
