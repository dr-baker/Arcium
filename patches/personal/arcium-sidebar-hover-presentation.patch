+TEST_F(ArciumBrowserChromeTest, HoverLockPreservesSavedCollapseAndFinalPresentation) {
+  gfx::ScopedAnimationDurationScaleMode no_animation(
+      gfx::ScopedAnimationDurationScaleMode::ZERO_DURATION);
+  prefs()->SetBoolean(arcium::kArcSidebarNavigationEnabledPref, true);
+  auto* controller = tabs::VerticalTabStripStateController::From(browser());
+  auto* region = browser_view()->vertical_tab_strip_region_view_for_testing();
+  const int saved_width =
+      prefs()->GetInteger(prefs::kVerticalTabsUncollapsedWidth);
+  auto last_presentation = tabs::VerticalTabStripCollapseState::kExpanded;
+  auto subscription = controller->RegisterOnCollapseChanged(
+      base::BindRepeating(
+          [](tabs::VerticalTabStripCollapseState* last,
+             tabs::VerticalTabStripCollapseState state) { *last = state; },
+          &last_presentation));
+  // Holding this before collapse exercises presentation changes from inside
+  // the original collapse callback dispatch.
+  auto keep_expanded = region->GetExpandOnHoverLock(
+      ExpandOnHoverLockType::kKeepExpanded);
+  controller->RequestCollapse(true);
+  base::RunLoop().RunUntilIdle();
+  ASSERT_TRUE(controller->IsCollapsed());
+  EXPECT_TRUE(controller->GetState().collapsed);
+  EXPECT_TRUE(prefs()->GetBoolean(prefs::kVerticalTabsCollapsedState));
+  EXPECT_EQ(controller->GetCollapseState(),
+            tabs::VerticalTabStripCollapseState::kExpanded);
+  EXPECT_EQ(last_presentation, tabs::VerticalTabStripCollapseState::kExpanded);
+  EXPECT_EQ(prefs()->GetInteger(prefs::kVerticalTabsUncollapsedWidth),
+            saved_width);
+
+  keep_expanded.reset();
+  auto force_collapsed = region->GetExpandOnHoverLock(
+      ExpandOnHoverLockType::kForceCollapse);
+  ASSERT_TRUE(base::test::RunUntil([&] {
+    return !region->IsSidebarNavigationTemporarilyExpanded() &&
+           controller->GetCollapseState() ==
+               tabs::VerticalTabStripCollapseState::kCollapsed &&
+           last_presentation == tabs::VerticalTabStripCollapseState::kCollapsed;
+  }));
+  EXPECT_TRUE(controller->IsCollapsed());
+  EXPECT_TRUE(prefs()->GetBoolean(prefs::kVerticalTabsCollapsedState));
+  EXPECT_EQ(controller->GetCollapseState(),
+            tabs::VerticalTabStripCollapseState::kCollapsed);
+  EXPECT_EQ(last_presentation, tabs::VerticalTabStripCollapseState::kCollapsed);
+  EXPECT_EQ(prefs()->GetInteger(prefs::kVerticalTabsUncollapsedWidth),
+            saved_width);
+}
