+namespace arcium {
+namespace {
+
+using Coordinator = ArcImportCoordinator;
+using user_data_importer::FAVORITES;
+using user_data_importer::HISTORY;
+
+user_data_importer::SourceProfile MakeSource(
+    user_data_importer::ImporterType type,
+    const std::u16string& name,
+    const char* directory,
+    uint16_t services = FAVORITES | HISTORY) {
+  user_data_importer::SourceProfile source;
+  source.importer_type = type;
+  source.importer_name = type == user_data_importer::TYPE_ARC ? u"Arc" : u"X";
+  source.profile = name;
+  source.source_path =
+      base::FilePath(FILE_PATH_LITERAL("/fixture/User Data")).AppendASCII(directory);
+  source.services_supported = services;
+  return source;
+}
+
+class ArcImportCoordinatorTest : public testing::Test {
+ protected:
+  std::unique_ptr<Coordinator> MakeCoordinator(
+      std::vector<user_data_importer::SourceProfile> detected) {
+    auto coordinator = std::make_unique<Coordinator>(
+        &profile_, base::BindLambdaForTesting([this] { ++changes_; }));
+    coordinator->SetDetectedSourcesForTesting(std::move(detected));
+    coordinator->SetStartForTesting(base::BindLambdaForTesting(
+        [this](const user_data_importer::SourceProfile& source,
+               uint16_t items) {
+          started_items_.push_back(items);
+          started_paths_.push_back(source.source_path);
+        }));
+    coordinator->Discover();
+    return coordinator;
+  }
+
+  content::BrowserTaskEnvironment task_environment_;
+  TestingProfile profile_;
+  int changes_ = 0;
+  std::vector<uint16_t> started_items_;
+  std::vector<base::FilePath> started_paths_;
+};
+
+TEST(ArcImportCoordinatorOutcomeTest, SidebarGateDecidesSuccess) {
+  Coordinator::OutcomeInput input;
+  input.sidebar_requested = true;
+  EXPECT_EQ(Coordinator::ResolveOutcome(input),
+            std::make_pair(Coordinator::Outcome::kFailed,
+                           Coordinator::Failure::kSidebarUnreadable));
+
+  input.sidebar_received = true;
+  EXPECT_EQ(Coordinator::ResolveOutcome(input),
+            std::make_pair(Coordinator::Outcome::kFailed,
+                           Coordinator::Failure::kSidebarNotSaved));
+
+  // A finished History category never proves the sidebar was saved.
+  input.history_requested = true;
+  input.history_finished = true;
+  EXPECT_EQ(Coordinator::ResolveOutcome(input).first,
+            Coordinator::Outcome::kFailed);
+
+  input.sidebar_saved = true;
+  EXPECT_EQ(Coordinator::ResolveOutcome(input).first,
+            Coordinator::Outcome::kEmpty);
+
+  input.counts.spaces = 4;
+  input.counts.pins = 123;
+  EXPECT_EQ(Coordinator::ResolveOutcome(input).first,
+            Coordinator::Outcome::kSucceeded);
+
+  input.cancelled = true;
+  EXPECT_EQ(Coordinator::ResolveOutcome(input).first,
+            Coordinator::Outcome::kCancelled);
+
+  input.destination_alive = false;
+  EXPECT_EQ(Coordinator::ResolveOutcome(input).second,
+            Coordinator::Failure::kDestinationClosed);
+}
+
+TEST(ArcImportCoordinatorOutcomeTest, SidebarCannotHideUnfinishedHistory) {
+  Coordinator::OutcomeInput input;
+  input.sidebar_requested = input.sidebar_received = input.sidebar_saved = true;
+  input.history_requested = true;
+  input.counts.spaces = 1;
+  EXPECT_EQ(Coordinator::ResolveOutcome(input),
+            std::make_pair(Coordinator::Outcome::kFailed,
+                           Coordinator::Failure::kHistoryIncomplete));
+
+  // The same rule applies to an empty successful sidebar snapshot.
+  input.counts = {};
+  EXPECT_EQ(Coordinator::ResolveOutcome(input).second,
+            Coordinator::Failure::kHistoryIncomplete);
+  input.history_finished = true;
+  EXPECT_EQ(Coordinator::ResolveOutcome(input).first,
+            Coordinator::Outcome::kEmpty);
+}
+
+TEST(ArcImportCoordinatorOutcomeTest, HistoryOnlyRequiresItsOwnCompletion) {
+  Coordinator::OutcomeInput input;
+  input.history_requested = true;
+  EXPECT_EQ(Coordinator::ResolveOutcome(input).second,
+            Coordinator::Failure::kHistoryIncomplete);
+  input.history_finished = true;
+  EXPECT_EQ(Coordinator::ResolveOutcome(input).first,
+            Coordinator::Outcome::kSucceeded);
+}
+
+TEST(ArcImportCoordinatorOutcomeTest, FavoritesOnlyIsNotEmpty) {
+  Coordinator::OutcomeInput input;
+  input.sidebar_requested = input.sidebar_received = input.sidebar_saved = true;
+  input.counts.spaces = 1;
+  input.counts.favorites = 4;
+  EXPECT_EQ(Coordinator::ResolveOutcome(input).first,
+            Coordinator::Outcome::kSucceeded);
+}
+
+TEST(ArcImportCoordinatorSourcesTest, KeepsArcAndDisambiguatesDuplicates) {
+  const auto sources = Coordinator::BuildSources(
+      {MakeSource(user_data_importer::TYPE_CHROME, u"Person", "Default"),
+       MakeSource(user_data_importer::TYPE_ARC, u"Work", "Default"),
+       MakeSource(user_data_importer::TYPE_ARC, u"Work", "Profile 2"),
+       MakeSource(user_data_importer::TYPE_ARC, u"Home", "Profile 3",
+                  HISTORY)},
+      7, {"Profile 2"});
+  ASSERT_EQ(sources.size(), 3u);
+  EXPECT_EQ(sources[0].token, "g7-1");
+  EXPECT_EQ(sources[0].detail, u"Default");
+  EXPECT_EQ(sources[1].detail, u"Profile 2");
+  EXPECT_TRUE(sources[1].previously_imported);
+  EXPECT_FALSE(sources[0].previously_imported);
+  EXPECT_TRUE(sources[2].detail.empty());
+  EXPECT_FALSE(sources[2].can_import_sidebar);
+  EXPECT_TRUE(sources[2].can_import_history);
+}
+
+TEST_F(ArcImportCoordinatorTest, HistoryStaysOffUnlessRequested) {
+  auto coordinator = MakeCoordinator(
+      {MakeSource(user_data_importer::TYPE_ARC, u"Work", "Default")});
+  ASSERT_EQ(coordinator->phase(), Coordinator::Phase::kReady);
+  const std::string token = coordinator->sources()[0].token;
+  EXPECT_EQ(coordinator->Start(token, /*include_sidebar=*/true,
+                               /*include_history=*/false),
+            Coordinator::Failure::kNone);
+  ASSERT_EQ(started_items_.size(), 1u);
+  EXPECT_EQ(started_items_[0], FAVORITES);
+  EXPECT_FALSE(coordinator->job()->includes_history);
+}
+
+TEST_F(ArcImportCoordinatorTest, NeverRequestsExtensionsOrCredentials) {
+  auto coordinator = MakeCoordinator({MakeSource(
+      user_data_importer::TYPE_ARC, u"Work", "Default",
+      user_data_importer::ALL)});
+  ASSERT_EQ(coordinator->Start(coordinator->sources()[0].token, true, true),
+            Coordinator::Failure::kNone);
+  ASSERT_EQ(started_items_.size(), 1u);
+  EXPECT_EQ(started_items_[0], FAVORITES | HISTORY);
+  EXPECT_EQ(started_items_[0] & (user_data_importer::EXTENSIONS |
+                                 user_data_importer::PASSWORDS |
+                                 user_data_importer::COOKIES),
+            0);
+}
+
+TEST_F(ArcImportCoordinatorTest, NothingSelectedDoesNotStart) {
+  auto coordinator = MakeCoordinator(
+      {MakeSource(user_data_importer::TYPE_ARC, u"Work", "Default", HISTORY)});
+  EXPECT_EQ(coordinator->Start(coordinator->sources()[0].token, true, false),
+            Coordinator::Failure::kNothingSelected);
+  EXPECT_TRUE(started_items_.empty());
+  EXPECT_EQ(coordinator->phase(), Coordinator::Phase::kReady);
+}
+
+TEST_F(ArcImportCoordinatorTest, StaleTokenIsRejectedAfterRediscovery) {
+  auto coordinator = MakeCoordinator(
+      {MakeSource(user_data_importer::TYPE_ARC, u"Work", "Default")});
+  const std::string stale = coordinator->sources()[0].token;
+  coordinator->Discover();
+  EXPECT_NE(coordinator->sources()[0].token, stale);
+  EXPECT_EQ(coordinator->Start(stale, true, false),
+            Coordinator::Failure::kSourceChanged);
+  EXPECT_TRUE(started_items_.empty());
+}
+
+TEST_F(ArcImportCoordinatorTest, SecondStartIsBlockedEverywhere) {
+  auto first = MakeCoordinator(
+      {MakeSource(user_data_importer::TYPE_ARC, u"Work", "Default"),
+       MakeSource(user_data_importer::TYPE_ARC, u"Home", "Profile 1")});
+  auto second = MakeCoordinator(
+      {MakeSource(user_data_importer::TYPE_ARC, u"Work", "Default")});
+  ASSERT_EQ(first->Start(first->sources()[0].token, true, false),
+            Coordinator::Failure::kNone);
+  EXPECT_EQ(first->Start(first->sources()[1].token, true, false),
+            Coordinator::Failure::kBusy);
+  EXPECT_EQ(second->Start(second->sources()[0].token, true, false),
+            Coordinator::Failure::kBusy);
+  EXPECT_EQ(started_items_.size(), 1u);
+  // Rediscovery cannot swap sources under a running job.
+  first->Discover();
+  EXPECT_EQ(first->phase(), Coordinator::Phase::kRunning);
+}
+
+TEST_F(ArcImportCoordinatorTest, FailureIsRetainedAndRetryGetsNewJob) {
+  auto coordinator = MakeCoordinator(
+      {MakeSource(user_data_importer::TYPE_ARC, u"Work", "Default")});
+  const std::string token = coordinator->sources()[0].token;
+  ASSERT_EQ(coordinator->Start(token, true, true), Coordinator::Failure::kNone);
+  const int first_id = coordinator->job()->id;
+  coordinator->ImportItemStarted(FAVORITES);
+  coordinator->ImportItemEnded(FAVORITES);
+  coordinator->ImportItemStarted(HISTORY);
+  coordinator->ImportItemEnded(HISTORY);
+  coordinator->SetSidebarResultForTesting(/*received=*/false, false);
+  coordinator->ImportEnded();
+
+  ASSERT_EQ(coordinator->phase(), Coordinator::Phase::kFinished);
+  EXPECT_EQ(coordinator->job()->outcome, Coordinator::Outcome::kFailed);
+  EXPECT_EQ(coordinator->job()->failure,
+            Coordinator::Failure::kSidebarUnreadable);
+  EXPECT_FALSE(coordinator->sources()[0].previously_imported);
+  ASSERT_EQ(coordinator->finished_jobs().size(), 1u);
+
+  coordinator->SetSidebarResultForTesting(true, true);
+  ASSERT_EQ(coordinator->Start(token, true, false),
+            Coordinator::Failure::kNone);
+  EXPECT_NE(coordinator->job()->id, first_id);
+  EXPECT_EQ(started_paths_[0], started_paths_[1]);
+  coordinator->ImportEnded();
+  EXPECT_EQ(coordinator->finished_jobs().size(), 2u);
+  EXPECT_EQ(coordinator->finished_jobs()[0].outcome,
+            Coordinator::Outcome::kFailed);
+}
+
+TEST_F(ArcImportCoordinatorTest, CancelReportsPossiblePartialData) {
+  auto coordinator = MakeCoordinator(
+      {MakeSource(user_data_importer::TYPE_ARC, u"Work", "Default")});
+  const std::string token = coordinator->sources()[0].token;
+
+  ASSERT_EQ(coordinator->Start(token, true, false),
+            Coordinator::Failure::kNone);
+  coordinator->Cancel();
+  EXPECT_EQ(coordinator->job()->outcome, Coordinator::Outcome::kCancelled);
+  EXPECT_FALSE(coordinator->job()->may_have_partial_data);
+
+  ASSERT_EQ(coordinator->Start(token, true, false),
+            Coordinator::Failure::kNone);
+  coordinator->ImportItemStarted(FAVORITES);
+  coordinator->Cancel();
+  coordinator->Cancel();  // Repeated cancel is a no-op.
+  EXPECT_EQ(coordinator->job()->outcome, Coordinator::Outcome::kCancelled);
+  EXPECT_TRUE(coordinator->job()->may_have_partial_data);
+  EXPECT_EQ(coordinator->finished_jobs().size(), 2u);
+}
+
+TEST_F(ArcImportCoordinatorTest, DestinationShutdownFailsRunningJob) {
+  auto coordinator = MakeCoordinator(
+      {MakeSource(user_data_importer::TYPE_ARC, u"Work", "Default")});
+  ASSERT_EQ(coordinator->Start(coordinator->sources()[0].token, true, false),
+            Coordinator::Failure::kNone);
+  coordinator->OnProfileWillBeDestroyed(&profile_);
+  EXPECT_EQ(coordinator->job()->failure,
+            Coordinator::Failure::kDestinationClosed);
+  EXPECT_EQ(coordinator->destination(), nullptr);
+  EXPECT_EQ(coordinator->Start("g1-0", true, false),
+            Coordinator::Failure::kDestinationClosed);
+}
+
+TEST_F(ArcImportCoordinatorTest, SavedSidebarRemainsRefreshableIfHistoryStops) {
+  auto coordinator = MakeCoordinator(
+      {MakeSource(user_data_importer::TYPE_ARC, u"Work", "Default")});
+  ASSERT_EQ(coordinator->Start(coordinator->sources()[0].token, true, true),
+            Coordinator::Failure::kNone);
+  coordinator->ImportItemStarted(FAVORITES);
+  coordinator->SetSidebarResultForTesting(true, true);
+  coordinator->ImportEnded();
+  EXPECT_EQ(coordinator->job()->failure,
+            Coordinator::Failure::kHistoryIncomplete);
+  EXPECT_TRUE(coordinator->sources()[0].previously_imported);
+  EXPECT_TRUE(coordinator->job()->may_have_partial_data);
+
+  // Completion released the destination slot, despite the partial failure.
+  auto retry = MakeCoordinator(
+      {MakeSource(user_data_importer::TYPE_ARC, u"Work", "Default")});
+  EXPECT_EQ(retry->Start(retry->sources()[0].token, true, false),
+            Coordinator::Failure::kNone);
+}
+
+TEST_F(ArcImportCoordinatorTest, ProfileDestructionInvalidatesReadySnapshot) {
+  int changed = 0;
+  auto profile = std::make_unique<TestingProfile>();
+  auto coordinator = std::make_unique<Coordinator>(
+      profile.get(), base::BindLambdaForTesting([&] { ++changed; }));
+  coordinator->SetDetectedSourcesForTesting(
+      {MakeSource(user_data_importer::TYPE_ARC, u"Work", "Default")});
+  coordinator->Discover();
+  base::RunLoop().RunUntilIdle();
+  const int before = changed;
+  profile.reset();
+  EXPECT_EQ(coordinator->destination(), nullptr);
+  EXPECT_FALSE(coordinator->Snapshot().FindBool("destinationAvailable").value());
+  base::RunLoop().RunUntilIdle();
+  EXPECT_GT(changed, before);
+}
+
+#if BUILDFLAG(ENABLE_EXTENSIONS)
+class ImportEndObserver : public importer::ImporterProgressObserver {
+ public:
+  void ImportStarted() override { ++started; }
+  void ImportItemStarted(user_data_importer::ImportItem) override {
+    ++items_started;
+  }
+  void ImportItemEnded(user_data_importer::ImportItem) override {
+    ++items_ended;
+  }
+  void ImportEnded() override { ++ended; }
+
+  int started = 0;
+  int items_started = 0;
+  int items_ended = 0;
+  int ended = 0;
+};
+
+class DestructionTrackingWriter : public ProfileWriter {
+ public:
+  DestructionTrackingWriter(Profile* profile, bool* destroyed)
+      : ProfileWriter(profile), destroyed_(destroyed) {}
+  ~DestructionTrackingWriter() override { *destroyed_ = true; }
+
+ private:
+  bool* destroyed_;
+};
+
+TEST_F(ArcImportCoordinatorTest, LegacyHostBlocksEveryEntryUntilActualTeardown) {
+  const auto source = MakeSource(user_data_importer::TYPE_ARC, u"Work",
+                                 "Default", user_data_importer::EXTENSIONS);
+  auto writer = base::MakeRefCounted<ProfileWriter>(&profile_);
+  ImportEndObserver first_observer;
+  auto* first = new BraveExternalProcessImporterHost();
+  first->set_observer(&first_observer);
+  // Preparation posts a fixture-only task and returns without launching the
+  // utility importer. Do not pump the UI loop before cancelling this host.
+  first->StartImportSettings(source, &profile_, user_data_importer::EXTENSIONS,
+                             writer.get());
+  ASSERT_TRUE(ExternalProcessImporterHost::IsImportRunning(&profile_));
+
+  ImportEndObserver rejected_observer;
+  bool rejected_writer_destroyed = false;
+  auto* rejected = new ExternalProcessImporterHost();
+  rejected->set_observer(&rejected_observer);
+  // first_run and bookmark-manager imports transfer a raw refcount-zero writer.
+  // The rejected host must retain/release it even though no import starts.
+  rejected->StartImportSettings(
+      source, &profile_, FAVORITES,
+      new DestructionTrackingWriter(&profile_, &rejected_writer_destroyed));
+  EXPECT_TRUE(rejected_writer_destroyed);
+  // Rejection is synchronous, emits no category success, and self-deletes.
+  EXPECT_EQ(rejected_observer.ended, 1);
+  EXPECT_EQ(rejected_observer.started, 0);
+  EXPECT_EQ(rejected_observer.items_started, 0);
+  EXPECT_EQ(rejected_observer.items_ended, 0);
+  EXPECT_FALSE(writer->arc_sidebar_snapshot_received());
+  EXPECT_TRUE(ExternalProcessImporterHost::IsImportRunning(&profile_));
+
+  auto native = MakeCoordinator(
+      {MakeSource(user_data_importer::TYPE_ARC, u"Work", "Default")});
+  EXPECT_EQ(native->Start(native->sources()[0].token, true, false),
+            Coordinator::Failure::kBusy);
+  EXPECT_TRUE(started_items_.empty());
+
+  // Legacy WebUI unload detaches its observer; it does not cancel the host.
+  first->set_observer(nullptr);
+  EXPECT_TRUE(ExternalProcessImporterHost::IsImportRunning(&profile_));
+  first->Cancel();  // Deletes first. Never access it again.
+  EXPECT_EQ(first_observer.ended, 0);
+  EXPECT_FALSE(ExternalProcessImporterHost::IsImportRunning(&profile_));
+  EXPECT_EQ(native->Start(native->sources()[0].token, true, false),
+            Coordinator::Failure::kNone);
+}
+#endif  // BUILDFLAG(ENABLE_EXTENSIONS)
+
+TEST_F(ArcImportCoordinatorTest, SnapshotHasNoFilesystemPaths) {
+  auto coordinator = MakeCoordinator(
+      {MakeSource(user_data_importer::TYPE_ARC, u"Work", "Default")});
+  std::string json;
+  ASSERT_TRUE(base::JSONWriter::Write(coordinator->Snapshot(), &json));
+  EXPECT_EQ(json.find("/fixture"), std::string::npos);
+  EXPECT_NE(json.find("\"phase\":\"ready\""), std::string::npos);
+}
+
+TEST_F(ArcImportCoordinatorTest, ChangeNotificationsAreAsynchronous) {
+  auto coordinator = MakeCoordinator(
+      {MakeSource(user_data_importer::TYPE_ARC, u"Work", "Default")});
+  const int before = changes_;
+  coordinator->Start(coordinator->sources()[0].token, true, false);
+  EXPECT_EQ(changes_, before);
+  base::RunLoop().RunUntilIdle();
+  EXPECT_GT(changes_, before);
+}
