+// Copyright 2026 The Helium Authors
+// You can use, redistribute, and/or modify this source code under
+// the terms of the GPL-3.0 license that can be found in the LICENSE file.
+
+#ifndef CHROME_BROWSER_IMPORTER_ARCIUM_ARC_IMPORT_COORDINATOR_H_
+#define CHROME_BROWSER_IMPORTER_ARCIUM_ARC_IMPORT_COORDINATOR_H_
+
+#include <stdint.h>
+
+#include <map>
+#include <memory>
+#include <optional>
+#include <set>
+#include <string>
+#include <string_view>
+#include <utility>
+#include <vector>
+
+#include "base/functional/callback.h"
+#include "base/memory/raw_ptr.h"
+#include "base/memory/scoped_refptr.h"
+#include "base/memory/weak_ptr.h"
+#include "base/scoped_observation.h"
+#include "base/values.h"
+#include "chrome/browser/importer/importer_progress_observer.h"
+#include "chrome/browser/profiles/profile.h"
+#include "chrome/browser/profiles/profile_observer.h"
+#include "components/user_data_importer/common/importer_data_types.h"
+#include "ui/gfx/native_ui_types.h"
+
+class ExternalProcessImporterHost;
+class ImporterList;
+class ProfileWriter;
+
+namespace arcium {
+
+// Imports one detected Arc profile into one Arcium profile at a time.
+//
+// The coordinator owns discovery, the frozen job, the importer host while it
+// runs, and the final result. Native UI renders Snapshot() and sends intent
+// through Start() and Cancel(); it never receives filesystem paths or Profile
+// pointers. Saved sidebar data always uses ArcSidebarDestination::kPins, the
+// utility-process parser, ProfileWriter, and HeliumSpaceService reconciliation.
+class ArcImportCoordinator : public importer::ImporterProgressObserver,
+                             public ProfileObserver {
+ public:
+  enum class Phase { kDiscovering, kReady, kRunning, kFinished };
+  enum class Outcome { kNone, kSucceeded, kEmpty, kFailed, kCancelled };
+  enum class Failure {
+    kNone,
+    kBusy,
+    kNothingSelected,
+    kSourceChanged,
+    kSidebarUnreadable,
+    kSidebarNotSaved,
+    kHistoryIncomplete,
+    kDestinationClosed,
+  };
+  enum class Step { kNone, kSidebar, kHistory };
+
+  struct Source {
+    // Opaque, valid only for the discovery generation that produced it.
+    std::string token;
+    // Arc profile directory name. Matches HeliumSpace::source_profile().
+    std::string source_id;
+    std::u16string title;
+    // Set only when another detected Arc profile has the same title.
+    std::u16string detail;
+    bool can_import_sidebar = false;
+    bool can_import_history = false;
+    bool previously_imported = false;
+  };
+
+  struct Counts {
+    int spaces = 0;
+    int pins = 0;
+    int folders = 0;
+    int favorites = 0;
+    bool empty() const { return spaces == 0 && favorites == 0; }
+    bool operator==(const Counts&) const = default;
+  };
+
+  struct Job {
+    int id = 0;
+    std::string token;
+    std::string source_id;
+    std::u16string source_title;
+    std::u16string destination_name;
+    bool includes_sidebar = false;
+    bool includes_history = false;
+    bool refresh = false;
+    Step step = Step::kNone;
+    Outcome outcome = Outcome::kNone;
+    Failure failure = Failure::kNone;
+    // True after the importer started writing any category. Cancel does not
+    // roll back delivered data.
+    bool may_have_partial_data = false;
+    bool history_finished = false;
+    Counts counts;
+    std::string first_space_id;
+  };
+
+  struct OutcomeInput {
+    bool sidebar_requested = false;
+    bool history_requested = false;
+    bool sidebar_received = false;
+    bool sidebar_saved = false;
+    bool history_finished = false;
+    bool cancelled = false;
+    bool destination_alive = true;
+    Counts counts;
+  };
+
+  // Pure helpers, exposed for unit tests.
+  static std::pair<Outcome, Failure> ResolveOutcome(const OutcomeInput& input);
+  static std::vector<Source> BuildSources(
+      const std::vector<user_data_importer::SourceProfile>& detected,
+      int generation,
+      const std::set<std::string>& imported_source_ids);
+  static Counts CountImportedRecords(Profile* profile,
+                                     std::string_view source_id,
+                                     std::string* first_space_id);
+  static std::set<std::string> ImportedSourceIds(Profile* profile);
+
+  // `changed` runs asynchronously on the UI thread after every state change.
+  ArcImportCoordinator(Profile* destination, base::RepeatingClosure changed);
+  ArcImportCoordinator(const ArcImportCoordinator&) = delete;
+  ArcImportCoordinator& operator=(const ArcImportCoordinator&) = delete;
+  ~ArcImportCoordinator() override;
+
+  // Starts a new discovery generation. Ignored while a job runs.
+  void Discover();
+  // Freezes the source, destination, and categories, then starts one job.
+  // Returns kNone when the job started.
+  Failure Start(std::string_view token,
+                bool include_sidebar,
+                bool include_history);
+  // Requests cancellation. Already delivered data stays in the profile.
+  void Cancel();
+  // Returns to source selection after a finished job. Finished jobs remain in
+  // finished_jobs() so callers can show everything imported this session.
+  void Reset();
+
+  void set_parent_window(gfx::NativeWindow window) { parent_window_ = window; }
+
+  Phase phase() const { return phase_; }
+  const std::vector<Source>& sources() const { return sources_; }
+  const std::optional<Job>& job() const { return job_; }
+  const std::vector<Job>& finished_jobs() const { return finished_jobs_; }
+  Profile* destination() const { return destination_; }
+  bool sidebar_allowed() const;
+  bool history_allowed() const;
+  std::u16string DestinationName() const;
+
+  // Property-list-compatible state for native UI. Keys are documented in
+  // DESIGN.md and covered by ArciumArcImportTests.swift.
+  base::DictValue Snapshot() const;
+  static base::DictValue JobToDict(const Job& job);
+  static const char* FailureToString(Failure failure);
+
+  // importer::ImporterProgressObserver:
+  void ImportStarted() override;
+  void ImportItemStarted(user_data_importer::ImportItem item) override;
+  void ImportItemEnded(user_data_importer::ImportItem item) override;
+  void ImportEnded() override;
+
+  // ProfileObserver:
+  void OnProfileWillBeDestroyed(Profile* profile) override;
+
+  // Test seams. With a start callback set, Start() does not create an
+  // importer host; tests drive the observer methods directly.
+  using StartForTesting = base::RepeatingCallback<
+      void(const user_data_importer::SourceProfile& source, uint16_t items)>;
+  void SetDetectedSourcesForTesting(
+      std::vector<user_data_importer::SourceProfile> detected);
+  void SetStartForTesting(StartForTesting start);
+  void SetSidebarResultForTesting(bool received, bool saved);
+
+ private:
+  void OnSourcesDetected(int generation);
+  void ApplyDetectedSources(
+      const std::vector<user_data_importer::SourceProfile>& detected);
+  void Finish();
+  void DetachDestination();
+  void NotifyChanged();
+  void RunChanged();
+
+  raw_ptr<Profile> destination_;
+  base::RepeatingClosure changed_;
+  gfx::NativeWindow parent_window_ = gfx::NativeWindow();
+
+  Phase phase_ = Phase::kDiscovering;
+  int generation_ = 0;
+  std::unique_ptr<ImporterList> importer_list_;
+  std::vector<Source> sources_;
+  std::map<std::string, user_data_importer::SourceProfile> source_profiles_;
+
+  std::optional<Job> job_;
+  std::vector<Job> finished_jobs_;
+  user_data_importer::SourceProfile frozen_source_;
+  scoped_refptr<ProfileWriter> writer_;
+  // Self-deleting. Cleared in ImportEnded() before the host deletes itself and
+  // never dereferenced after Cancel().
+  raw_ptr<ExternalProcessImporterHost> host_ = nullptr;
+  bool cancel_requested_ = false;
+  bool changed_pending_ = false;
+  // Process-wide guard key for the running destination, cleared in Finish().
+  const void* busy_key_ = nullptr;
+
+  std::optional<std::vector<user_data_importer::SourceProfile>>
+      detected_for_testing_;
+  StartForTesting start_for_testing_;
+  std::optional<std::pair<bool, bool>> sidebar_result_for_testing_;
+
+  base::ScopedObservation<Profile, ProfileObserver> profile_observation_{this};
+  base::WeakPtrFactory<ArcImportCoordinator> weak_factory_{this};
+};
+
+}  // namespace arcium
+
+#endif  // CHROME_BROWSER_IMPORTER_ARCIUM_ARC_IMPORT_COORDINATOR_H_
