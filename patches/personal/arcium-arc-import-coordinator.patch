+}  // namespace
+
+// static
+std::pair<ArcImportCoordinator::Outcome, ArcImportCoordinator::Failure>
+ArcImportCoordinator::ResolveOutcome(const OutcomeInput& input) {
+  if (!input.destination_alive) {
+    return {Outcome::kFailed, Failure::kDestinationClosed};
+  }
+  if (input.cancelled) {
+    return {Outcome::kCancelled, Failure::kNone};
+  }
+  if (input.sidebar_requested) {
+    // The sidebar result gate from arcium-arc-import-result.patch. A History
+    // category ending never proves the sidebar was saved.
+    if (!input.sidebar_received) {
+      return {Outcome::kFailed, Failure::kSidebarUnreadable};
+    }
+    if (!input.sidebar_saved) {
+      return {Outcome::kFailed, Failure::kSidebarNotSaved};
+    }
+  }
+  if (input.history_requested && !input.history_finished) {
+    return {Outcome::kFailed, Failure::kHistoryIncomplete};
+  }
+  if (input.sidebar_requested && input.counts.empty()) {
+    return {Outcome::kEmpty, Failure::kNone};
+  }
+  return {Outcome::kSucceeded, Failure::kNone};
+}
+
+// static
+std::vector<ArcImportCoordinator::Source> ArcImportCoordinator::BuildSources(
+    const std::vector<user_data_importer::SourceProfile>& detected,
+    int generation,
+    const std::set<std::string>& imported_source_ids) {
+  auto title_for = [](const user_data_importer::SourceProfile& source) {
+    return source.profile.empty() ? std::u16string(u"Arc") : source.profile;
+  };
+  std::map<std::u16string, int> title_counts;
+  for (const auto& source : detected) {
+    if (source.importer_type == user_data_importer::TYPE_ARC) {
+      ++title_counts[title_for(source)];
+    }
+  }
+  std::vector<Source> sources;
+  for (size_t i = 0; i < detected.size(); ++i) {
+    const auto& source = detected[i];
+    if (source.importer_type != user_data_importer::TYPE_ARC) {
+      continue;
+    }
+    Source entry;
+    entry.token = base::StrCat({"g", base::NumberToString(generation), "-",
+                                base::NumberToString(i)});
+    entry.source_id = source.source_path.BaseName().AsUTF8Unsafe();
+    entry.title = title_for(source);
+    if (title_counts[entry.title] > 1) {
+      entry.detail = source.source_path.BaseName().LossyDisplayName();
+    }
+    entry.can_import_sidebar = (source.services_supported & FAVORITES) != 0;
+    entry.can_import_history = (source.services_supported & HISTORY) != 0;
+    entry.previously_imported =
+        imported_source_ids.contains(entry.source_id);
+    sources.push_back(std::move(entry));
+  }
+  return sources;
+}
+
+// static
+ArcImportCoordinator::Counts ArcImportCoordinator::CountImportedRecords(
+    Profile* profile,
+    std::string_view source_id,
+    std::string* first_space_id) {
+  Counts counts;
+  auto* service =
+      profile ? helium::HeliumSpaceServiceFactory::GetForProfile(profile)
+              : nullptr;
+  if (!service || source_id.empty()) {
+    return counts;
+  }
+  const helium::HeliumSpace* first = nullptr;
+  for (const helium::HeliumSpace* space : service->GetSpaces()) {
+    if (space->source_profile() != source_id) {
+      continue;
+    }
+    first = first ? first : space;
+    ++counts.spaces;
+    CountNodes(space->pins(), &counts.pins, &counts.folders);
+  }
+  if (first) {
+    // Imported Favorites are visible only in Spaces from the same source.
+    counts.favorites =
+        std::max(0, CountLinks(service->GetFavoritesForSpace(*first)) -
+                        CountLinks(service->GetLocalFavorites()));
+    if (first_space_id) {
+      *first_space_id = first->id();
+    }
+  }
+  return counts;
+}
+
+// static
+std::set<std::string> ArcImportCoordinator::ImportedSourceIds(
+    Profile* profile) {
+  std::set<std::string> ids;
+  auto* service =
+      profile ? helium::HeliumSpaceServiceFactory::GetForProfile(profile)
+              : nullptr;
+  if (!service) {
+    return ids;
+  }
+  for (const helium::HeliumSpace* space : service->GetSpaces()) {
+    if (!space->source_profile().empty()) {
+      ids.insert(space->source_profile());
+    }
+  }
+  return ids;
+}
+
+ArcImportCoordinator::ArcImportCoordinator(Profile* destination,
+                                           base::RepeatingClosure changed)
+    : destination_(destination), changed_(std::move(changed)) {
+  if (destination_) {
+    profile_observation_.Observe(destination_);
+  }
+}
+
+ArcImportCoordinator::~ArcImportCoordinator() {
+  if (host_) {
+    // Without an observer, Cancel() deletes the host without calling back.
+    ExternalProcessImporterHost* host = host_;
+    host_ = nullptr;
+    host->set_observer(nullptr);
+    host->Cancel();
+  }
+  if (busy_key_) {
+    BusyDestinations().erase(busy_key_);
+  }
+}
+
+bool ArcImportCoordinator::sidebar_allowed() const {
+  return destination_ &&
+         !ManagedOff(destination_->GetPrefs(), prefs::kImportDialogBookmarks);
+}
+
+bool ArcImportCoordinator::history_allowed() const {
+  const PrefService* prefs = destination_ ? destination_->GetPrefs() : nullptr;
+  return prefs && !prefs->GetBoolean(prefs::kSavingBrowserHistoryDisabled) &&
+         !ManagedOff(prefs, prefs::kImportDialogHistory);
+}
+
+std::u16string ArcImportCoordinator::DestinationName() const {
+  ProfileManager* manager =
+      g_browser_process ? g_browser_process->profile_manager() : nullptr;
+  ProfileAttributesEntry* entry =
+      manager && destination_
+          ? manager->GetProfileAttributesStorage().GetProfileAttributesWithPath(
+                destination_->GetPath())
+          : nullptr;
+  return entry ? entry->GetLocalProfileName() : u"This profile";
+}
+
+void ArcImportCoordinator::Discover() {
+  if (phase_ == Phase::kRunning || !destination_) {
+    return;
+  }
+  phase_ = Phase::kDiscovering;
+  ++generation_;
+  job_.reset();
+  sources_.clear();
+  source_profiles_.clear();
+  NotifyChanged();
+  if (detected_for_testing_) {
+    ApplyDetectedSources(*detected_for_testing_);
+    return;
+  }
+  // Replacing the list drops any callback from the previous generation.
+  importer_list_ = std::make_unique<ImporterList>();
+  importer_list_->DetectSourceProfiles(
+      g_browser_process->GetApplicationLocale(),
+      /*include_interactive_profiles=*/false,
+      base::BindOnce(&ArcImportCoordinator::OnSourcesDetected,
+                     weak_factory_.GetWeakPtr(), generation_));
+}
+
+void ArcImportCoordinator::OnSourcesDetected(int generation) {
+  if (generation != generation_ || !importer_list_ ||
+      phase_ != Phase::kDiscovering) {
+    return;
+  }
+  std::vector<user_data_importer::SourceProfile> detected;
+  for (size_t i = 0; i < importer_list_->count(); ++i) {
+    detected.push_back(importer_list_->GetSourceProfileAt(i));
+  }
+  ApplyDetectedSources(detected);
+}
+
+void ArcImportCoordinator::ApplyDetectedSources(
+    const std::vector<user_data_importer::SourceProfile>& detected) {
+  sources_ =
+      BuildSources(detected, generation_, ImportedSourceIds(destination_));
+  source_profiles_.clear();
+  for (const Source& source : sources_) {
+    const size_t index = source.token.find('-');
+    size_t detected_index = 0;
+    if (index != std::string::npos &&
+        base::StringToSizeT(source.token.substr(index + 1), &detected_index) &&
+        detected_index < detected.size()) {
+      source_profiles_[source.token] = detected[detected_index];
+    }
+  }
+  phase_ = Phase::kReady;
+  NotifyChanged();
+}
+
+ArcImportCoordinator::Failure ArcImportCoordinator::Start(
+    std::string_view token,
+    bool include_sidebar,
+    bool include_history) {
+  if (phase_ == Phase::kRunning || host_) {
+    return Failure::kBusy;
+  }
+  if (!destination_) {
+    return Failure::kDestinationClosed;
+  }
+  const std::string token_string(token);
+  auto profile_it = source_profiles_.find(token_string);
+  auto source_it = std::ranges::find(sources_, token_string, &Source::token);
+  if (profile_it == source_profiles_.end() || source_it == sources_.end()) {
+    return Failure::kSourceChanged;
+  }
+  const void* key = destination_.get();
+  if (BusyDestinations().contains(key) ||
+      ExternalProcessImporterHost::IsImportRunning(destination_)) {
+    return Failure::kBusy;
+  }
+  // Only the saved sidebar and History. EXTENSIONS would make the host wait
+  // for extension preparation, and its lock dialog, before any other category.
+  uint16_t items = static_cast<uint16_t>(
+      (include_sidebar && sidebar_allowed() ? FAVORITES : 0) |
+      (include_history && history_allowed() ? HISTORY : 0));
+  items &= profile_it->second.services_supported;
+  if (!items) {
+    return Failure::kNothingSelected;
+  }
+
+  Job job;
+  job.id = NextJobId();
+  job.token = source_it->token;
+  job.source_id = source_it->source_id;
+  job.source_title = source_it->title;
+  job.destination_name = DestinationName();
+  job.includes_sidebar = (items & FAVORITES) != 0;
+  job.includes_history = (items & HISTORY) != 0;
+  job.refresh = job.includes_sidebar && source_it->previously_imported;
+  job_ = std::move(job);
+
+  frozen_source_ = profile_it->second;
+  writer_ = base::MakeRefCounted<ProfileWriter>(destination_,
+                                                ArcSidebarDestination::kPins);
+  cancel_requested_ = false;
+  busy_key_ = key;
+  BusyDestinations().insert(key);
+  phase_ = Phase::kRunning;
+  NotifyChanged();
+
+  if (start_for_testing_) {
+    start_for_testing_.Run(frozen_source_, items);
+    return Failure::kNone;
+  }
+  host_ = new ExternalProcessImporterHost();
+  host_->set_observer(this);
+  // Arc never needs the Firefox lock prompt. Keep the job free of modal UI.
+  host_->set_headless();
+  if (parent_window_) {
+    host_->set_parent_window(parent_window_);
+  }
+  // May finish synchronously; ImportEnded() clears host_ first.
+  host_->StartImportSettings(frozen_source_, destination_, items,
+                             writer_.get());
+  return Failure::kNone;
+}
+
+void ArcImportCoordinator::Cancel() {
+  if (phase_ != Phase::kRunning || cancel_requested_) {
+    return;
+  }
+  cancel_requested_ = true;
+  if (host_) {
+    // Cancel() synchronously calls ImportEnded() and deletes the host.
+    ExternalProcessImporterHost* host = host_;
+    host->Cancel();
+    return;
+  }
+  if (start_for_testing_) {
+    ImportEnded();
+  }
+}
+
+void ArcImportCoordinator::Reset() {
+  if (phase_ != Phase::kFinished) {
+    return;
+  }
+  job_.reset();
+  phase_ = Phase::kReady;
+  NotifyChanged();
+}
+
+void ArcImportCoordinator::ImportStarted() {}
+
+void ArcImportCoordinator::ImportItemStarted(
+    user_data_importer::ImportItem item) {
+  if (!job_ || phase_ != Phase::kRunning) {
+    return;
+  }
+  job_->may_have_partial_data = true;
+  job_->step = item == HISTORY ? Step::kHistory : Step::kSidebar;
+  NotifyChanged();
+}
+
+void ArcImportCoordinator::ImportItemEnded(
+    user_data_importer::ImportItem item) {
+  if (job_ && phase_ == Phase::kRunning && item == HISTORY) {
+    job_->history_finished = true;
+  }
+}
+
+void ArcImportCoordinator::ImportEnded() {
+  // The host deletes itself after this returns.
+  host_ = nullptr;
+  Finish();
+}
+
+void ArcImportCoordinator::Finish() {
+  if (!job_ || phase_ != Phase::kRunning) {
+    return;
+  }
+  bool received = false;
+  bool saved = false;
+  if (sidebar_result_for_testing_) {
+    std::tie(received, saved) = *sidebar_result_for_testing_;
+  } else if (writer_) {
+    received = writer_->arc_sidebar_snapshot_received();
+    saved = writer_->arc_sidebar_snapshot_import_succeeded();
+  }
+  std::string first_space_id;
+  const Counts counts =
+      destination_ ? CountImportedRecords(destination_, job_->source_id,
+                                          &first_space_id)
+                   : Counts();
+  const auto [outcome, failure] = ResolveOutcome({
+      .sidebar_requested = job_->includes_sidebar,
+      .history_requested = job_->includes_history,
+      .sidebar_received = received,
+      .sidebar_saved = saved,
+      .history_finished = job_->history_finished,
+      .cancelled = cancel_requested_,
+      .destination_alive = destination_ != nullptr,
+      .counts = counts,
+  });
+  job_->outcome = outcome;
+  job_->failure = failure;
+  job_->step = Step::kNone;
+  // A saved sidebar remains committed even if a separately requested History
+  // category did not finish. Preserve its counts and refresh identity without
+  // reporting the whole job as successful.
+  if (job_->includes_sidebar && received && saved && destination_) {
+    job_->counts = counts;
+    job_->first_space_id = first_space_id;
+    for (Source& source : sources_) {
+      if (source.source_id == job_->source_id && job_->includes_sidebar) {
+        source.previously_imported = true;
+      }
+    }
+  }
+  writer_ = nullptr;
+  if (busy_key_) {
+    BusyDestinations().erase(busy_key_);
+    busy_key_ = nullptr;
+  }
+  finished_jobs_.push_back(*job_);
+  phase_ = Phase::kFinished;
+  NotifyChanged();
+}
+
+void ArcImportCoordinator::OnProfileWillBeDestroyed(Profile* profile) {
+  DetachDestination();
+}
+
+void ArcImportCoordinator::DetachDestination() {
+  profile_observation_.Reset();
+  destination_ = nullptr;
+  importer_list_.reset();
+  if (phase_ != Phase::kRunning) {
+    NotifyChanged();
+    return;
+  }
+  cancel_requested_ = true;
+  if (host_) {
+    ExternalProcessImporterHost* host = host_;
+    host->Cancel();
+  } else if (start_for_testing_) {
+    ImportEnded();
+  }
+}
+
+void ArcImportCoordinator::NotifyChanged() {
+  if (changed_pending_ || !changed_) {
+    return;
+  }
+  changed_pending_ = true;
+  base::SequencedTaskRunner::GetCurrentDefault()->PostTask(
+      FROM_HERE, base::BindOnce(&ArcImportCoordinator::RunChanged,
+                                weak_factory_.GetWeakPtr()));
+}
+
+void ArcImportCoordinator::RunChanged() {
+  changed_pending_ = false;
+  // Copy: the callback may destroy this coordinator.
+  base::RepeatingClosure changed = changed_;
+  changed.Run();
+}
+
+base::DictValue ArcImportCoordinator::Snapshot() const {
+  base::ListValue sources;
+  for (const Source& source : sources_) {
+    sources.Append(base::DictValue()
+                       .Set("token", source.token)
+                       .Set("title", source.title)
+                       .Set("detail", source.detail)
+                       .Set("canImportSidebar", source.can_import_sidebar)
+                       .Set("canImportHistory", source.can_import_history)
+                       .Set("previouslyImported", source.previously_imported));
+  }
+  base::ListValue finished;
+  for (const Job& job : finished_jobs_) {
+    finished.Append(JobToDict(job));
+  }
+  base::DictValue snapshot;
+  snapshot.Set("phase", PhaseName(phase_));
+  snapshot.Set("destinationAvailable", destination_ != nullptr);
+  snapshot.Set("destinationName", DestinationName());
+  snapshot.Set("sidebarAllowed", sidebar_allowed());
+  snapshot.Set("historyAllowed", history_allowed());
+  snapshot.Set("sources", std::move(sources));
+  snapshot.Set("finishedJobs", std::move(finished));
+  if (job_) {
+    snapshot.Set("job", JobToDict(*job_));
+  }
+  return snapshot;
+}
+
+// static
+const char* ArcImportCoordinator::FailureToString(Failure failure) {
+  return FailureName(failure);
+}
+
+// static
+base::DictValue ArcImportCoordinator::JobToDict(const Job& job) {
+  return base::DictValue()
+      .Set("id", job.id)
+      .Set("token", job.token)
+      .Set("sourceTitle", job.source_title)
+      .Set("destinationName", job.destination_name)
+      .Set("includesSidebar", job.includes_sidebar)
+      .Set("includesHistory", job.includes_history)
+      .Set("refresh", job.refresh)
+      .Set("step", StepName(job.step))
+      .Set("outcome", OutcomeName(job.outcome))
+      .Set("failure", FailureName(job.failure))
+      .Set("partial", job.may_have_partial_data)
+      .Set("historyFinished", job.history_finished)
+      .Set("spaces", job.counts.spaces)
+      .Set("pins", job.counts.pins)
+      .Set("folders", job.counts.folders)
+      .Set("favorites", job.counts.favorites)
+      .Set("firstSpaceID", job.first_space_id);
+}
+
+void ArcImportCoordinator::SetDetectedSourcesForTesting(
+    std::vector<user_data_importer::SourceProfile> detected) {
+  detected_for_testing_ = std::move(detected);
+}
+
+void ArcImportCoordinator::SetStartForTesting(StartForTesting start) {
+  start_for_testing_ = std::move(start);
+}
+
+void ArcImportCoordinator::SetSidebarResultForTesting(bool received,
+                                                      bool saved) {
+  sidebar_result_for_testing_ = std::make_pair(received, saved);
+}
+
+}  // namespace arcium
