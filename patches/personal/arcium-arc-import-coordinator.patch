+using user_data_importer::FAVORITES;
+using user_data_importer::HISTORY;
+
+// One job per destination across every Settings and setup window.
+std::set<const void*>& BusyDestinations() {
+  static base::NoDestructor<std::set<const void*>> busy;
+  return *busy;
+}
+
+int NextJobId() {
+  static int next = 0;
+  return ++next;
+}
+
+void CountNodes(const helium::PersistentNodes& nodes,
+                int* links,
+                int* folders) {
+  for (const helium::PersistentNode& node : nodes) {
+    if (const auto* folder = std::get_if<helium::PersistentFolder>(&node.data)) {
+      ++*folders;
+      CountNodes(folder->children, links, folders);
+    } else {
+      ++*links;
+    }
+  }
+}
+
+int CountLinks(const helium::PersistentNodes& nodes) {
+  int links = 0;
+  int folders = 0;
+  CountNodes(nodes, &links, &folders);
+  return links;
+}
+
+bool ManagedOff(const PrefService* prefs, const char* name) {
+  const PrefService::Preference* pref = prefs ? prefs->FindPreference(name)
+                                              : nullptr;
+  return pref && pref->IsManaged() && !pref->GetValue()->GetBool();
+}
+
+const char* PhaseName(ArcImportCoordinator::Phase phase) {
+  switch (phase) {
+    case ArcImportCoordinator::Phase::kDiscovering:
+      return "discovering";
+    case ArcImportCoordinator::Phase::kReady:
+      return "ready";
+    case ArcImportCoordinator::Phase::kRunning:
+      return "running";
+    case ArcImportCoordinator::Phase::kFinished:
+      return "finished";
+  }
+  NOTREACHED();
+}
+
+const char* OutcomeName(ArcImportCoordinator::Outcome outcome) {
+  switch (outcome) {
+    case ArcImportCoordinator::Outcome::kNone:
+      return "none";
+    case ArcImportCoordinator::Outcome::kSucceeded:
+      return "succeeded";
+    case ArcImportCoordinator::Outcome::kEmpty:
+      return "empty";
+    case ArcImportCoordinator::Outcome::kFailed:
+      return "failed";
+    case ArcImportCoordinator::Outcome::kCancelled:
+      return "cancelled";
+  }
+  NOTREACHED();
+}
+
+const char* FailureName(ArcImportCoordinator::Failure failure) {
+  switch (failure) {
+    case ArcImportCoordinator::Failure::kNone:
+      return "none";
+    case ArcImportCoordinator::Failure::kBusy:
+      return "busy";
+    case ArcImportCoordinator::Failure::kNothingSelected:
+      return "nothing_selected";
+    case ArcImportCoordinator::Failure::kSourceChanged:
+      return "source_changed";
+    case ArcImportCoordinator::Failure::kSidebarUnreadable:
+      return "sidebar_unreadable";
+    case ArcImportCoordinator::Failure::kSidebarNotSaved:
+      return "sidebar_not_saved";
+    case ArcImportCoordinator::Failure::kHistoryIncomplete:
+      return "history_incomplete";
+    case ArcImportCoordinator::Failure::kDestinationClosed:
+      return "destination_closed";
+  }
+  NOTREACHED();
+}
+
+const char* StepName(ArcImportCoordinator::Step step) {
+  switch (step) {
+    case ArcImportCoordinator::Step::kNone:
+      return "none";
+    case ArcImportCoordinator::Step::kSidebar:
+      return "sidebar";
+    case ArcImportCoordinator::Step::kHistory:
+      return "history";
+  }
+  NOTREACHED();
+}
