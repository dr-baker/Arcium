+  PersistentLink ExpectedSplitLink(const SavedSourceState& state,
+                                   const GURL& companion_home,
+                                   const std::u16string& companion_title,
+                                   bool source_second = false,
+                                   int active_pane = 0) {
+    auto expected = state.link;
+    EXPECT_FALSE(expected.split);
+    if (state.kind == PersistentRecordKind::kFavorite) return expected;
+    expected.split = PersistentSplit{
+        .second_url = source_second ? state.link.url : companion_home,
+        .second_title = source_second ? state.link.title : companion_title,
+        .stacked = false, .ratio = 0.5, .active_pane = active_pane};
+    if (source_second) {
+      expected.url = companion_home;
+      expected.title = companion_title;
+    }
+    return expected;
+  }
+
+  void ExpectSavedCollections(const SavedSourceState& state,
+                              const PersistentLink& expected_link,
+                              const PersistentNodes& pins,
+                              const PersistentNodes& favorites) {
+    auto expected_pins = pins;
+    if (state.kind == PersistentRecordKind::kPin) {
+      auto* link = PersistentItemCodec::FindLink(expected_pins, state.link.id);
+      ASSERT_TRUE(link);
+      *link = expected_link;
+    }
+    EXPECT_EQ(expected_pins, space_->pins());
+    EXPECT_EQ(favorites, service_->GetFavoritesForBrowser(browser()));
+  }
+
+  void ExpectSplitCompanion(const SavedSourceState& state,
+                            tabs::TabInterface* companion,
+                            const GURL& home, const std::u16string& title) {
+    ASSERT_TRUE(companion);
+    auto* helper = TabUIHelper::From(companion);
+    ASSERT_TRUE(helper);
+    if (state.kind == PersistentRecordKind::kFavorite) {
+      EXPECT_FALSE(service_->IsPersistentItemTab(companion));
+      EXPECT_FALSE(helper->HasAnchoredPinnedTabHome());
+      return;
+    }
+    EXPECT_EQ(PersistentRecordKind::kPin, service_->GetPersistentItemKind(companion));
+    EXPECT_EQ(state.link.id, service_->GetPersistentItemId(companion));
+    EXPECT_TRUE(service_->AreTabsInSamePersistentItem(state.handle.Get(), companion));
+    GURL actual_home;
+    std::u16string actual_title;
+    ASSERT_TRUE(service_->GetPersistentItemHome(companion, &actual_home, &actual_title));
+    EXPECT_EQ(home, actual_home);
+    EXPECT_EQ(title, actual_title);
+    EXPECT_TRUE(helper->HasAnchoredPinnedTabHome());
+    EXPECT_EQ(home, helper->anchored_pinned_tab_home_url());
+    EXPECT_EQ(title.empty() ? base::UTF8ToUTF16(home.host()) : title,
+              helper->anchored_pinned_tab_home_title());
+  }
+
