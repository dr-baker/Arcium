+#include "content/public/browser/navigation_controller.h"
+#include "content/public/browser/web_contents.h"
+#include "ui/base/mojom/window_show_state.mojom.h"
+#include "ui/base/page_transition_types.h"
+#include "ui/base/window_open_disposition.h"
+#include "ui/display/display.h"
+#include "ui/display/screen.h"
+#include "ui/gfx/geometry/rect.h"
+#include "url/gurl.h"
+
+namespace helium {
+namespace {
+
+constexpr int kLittleArcDefaultWidth = 960;
+constexpr int kLittleArcDefaultHeight = 700;
+constexpr float kLittleArcMaxWorkAreaFraction = 0.85f;
+
+class LittleArcTracker {
+ public:
+  static LittleArcTracker& GetInstance() {
+    static base::NoDestructor<LittleArcTracker> instance;
+    return *instance;
+  }
+
+  void Mark(Browser* browser) {
+    Prune();
+    browsers_.push_back(browser->AsWeakPtr());
+  }
+
+  bool Contains(const Browser* browser) {
+    Prune();
+    for (const base::WeakPtr<Browser>& weak : browsers_) {
+      if (weak.get() == browser) {
+        return true;
+      }
+    }
+    return false;
+  }
+
+ private:
+  friend class base::NoDestructor<LittleArcTracker>;
+
+  LittleArcTracker() = default;
+
+  void Prune() {
+    std::erase_if(browsers_,
+                  [](const base::WeakPtr<Browser>& weak) { return !weak; });
+  }
+
+  std::vector<base::WeakPtr<Browser>> browsers_;
+};
+
+gfx::Rect CalculateLittleArcBounds() {
+  display::Screen* screen = display::Screen::Get();
+  const display::Display display =
+      screen ? screen->GetPrimaryDisplay() : display::Display();
+  const gfx::Rect work_area = display.work_area();
+
+  const int width = std::min(
+      kLittleArcDefaultWidth,
+      static_cast<int>(work_area.width() * kLittleArcMaxWorkAreaFraction));
+  const int height = std::min(
+      kLittleArcDefaultHeight,
+      static_cast<int>(work_area.height() * kLittleArcMaxWorkAreaFraction));
+
+  return gfx::Rect(work_area.x() + (work_area.width() - width) / 2,
+                   work_area.y() + (work_area.height() - height) / 2, width,
+                   height);
+}
+
+Browser* FindPromotionTarget(Profile* profile, Browser* source) {
+  Browser* target = nullptr;
+  HeliumSpaceService* space_service =
+      HeliumSpaceServiceFactory::GetForProfile(profile);
+  ProfileBrowserCollection::GetForProfile(profile)->ForEach(
+      [&, space_service](BrowserWindowInterface* window) {
+        Browser* candidate = window->GetBrowserForMigrationOnly();
+        if (candidate == source || !candidate->is_type_normal()) {
+          return true;
+        }
+        if (space_service &&
+            space_service->GetSpaceIdForBrowser(candidate).empty()) {
+          return true;
+        }
+        target = candidate;
+        return false;
+      },
+      BrowserCollection::Order::kActivation);
+
+  if (target) {
+    return target;
+  }
+
+  if (space_service) {
+    HeliumSpace* active_space = space_service->GetActiveSpace();
+    BrowserWindowInterface* window =
+        active_space ? active_space->ActivateOrCreatePrimaryWindow() : nullptr;
+    return window ? window->GetBrowserForMigrationOnly() : nullptr;
+  }
+
+  if (BrowserWindowInterface* tabbed =
+          ProfileBrowserCollection::GetForProfile(profile)
+              ->FindTabbedBrowser()) {
+    return tabbed->GetBrowserForMigrationOnly();
+  }
+
+  if (Browser::GetCreationStatusForProfile(profile) !=
+      Browser::CreationStatus::kOk) {
+    return nullptr;
+  }
+
+  Browser::CreateParams params(Browser::TYPE_NORMAL, profile, true);
+  params.should_trigger_session_restore = false;
+  Browser* created = Browser::Create(params);
+  created->window()->Show();
+  return created;
+}
+
+}  // namespace
+
+bool ShouldOpenExternalLinksInLittleArc(Profile* profile) {
+  if (!profile) {
+    return false;
+  }
+  PrefService* prefs = profile->GetPrefs();
+  return prefs && prefs->GetBoolean(prefs::kHeliumLittleArcExternalLinks);
+}
+
+bool IsLittleArcBrowser(const Browser* browser) {
+  return browser && LittleArcTracker::GetInstance().Contains(browser);
+}
+
+Browser* OpenUrlsInLittleArc(Profile* profile, const std::vector<GURL>& urls) {
+  if (!profile || urls.size() != 1u || !urls.front().is_valid() ||
+      !urls.front().SchemeIsHTTPOrHTTPS()) {
+    return nullptr;
+  }
+  if (Browser::GetCreationStatusForProfile(profile) !=
+      Browser::CreationStatus::kOk) {
+    return nullptr;
+  }
+
+  Browser::CreateParams params(Browser::TYPE_POPUP, profile, true);
+  params.omit_from_session_restore = true;
+  params.should_trigger_session_restore = false;
+  params.initial_bounds = CalculateLittleArcBounds();
+  params.initial_origin_specified = Browser::ValueSpecified::kSpecified;
+  params.initial_show_state = ui::mojom::WindowShowState::kNormal;
+  params.can_maximize = true;
+  params.can_fullscreen = true;
+
+  Browser* browser = Browser::Create(params);
+  if (!browser) {
+    return nullptr;
+  }
+  NavigateParams nav(browser, urls.front(), ui::PAGE_TRANSITION_LINK);
+  nav.disposition = WindowOpenDisposition::NEW_FOREGROUND_TAB;
+  nav.window_action = NavigateParams::WindowAction::kNoAction;
+  nav.web_app_navigation_data.emplace();
+  nav.web_app_navigation_data->SetNavigationCapturingForceOff(true);
+  base::WeakPtr<content::NavigationHandle> navigation = Navigate(&nav);
+  content::WebContents* contents = nav.navigated_or_inserted_contents;
+  if (!navigation || !contents || !nav.browser ||
+      nav.browser->GetBrowserForMigrationOnly() != browser ||
+      browser->tab_strip_model()->GetIndexOfWebContents(contents) ==
+          TabStripModel::kNoTab) {
+    browser->window()->Close();
+    return nullptr;
+  }
+
+  LittleArcTracker::GetInstance().Mark(browser);
+  if (BrowserView* browser_view =
+          BrowserView::GetBrowserViewForBrowser(browser)) {
+    if (ToolbarView* toolbar = browser_view->toolbar()) {
+      toolbar->AddLittleArcOpenInTabButton();
+    }
+  }
+  browser->window()->Show();
+  return browser;
+}
+
+bool PromoteLittleArcToTab(Browser* browser) {
+  if (!IsLittleArcBrowser(browser)) {
+    return false;
+  }
+
+  TabStripModel* model = browser->tab_strip_model();
+  if (!model || model->empty()) {
+    browser->window()->Close();
+    return true;
+  }
+
+  Browser* target = FindPromotionTarget(browser->profile(), browser);
+  if (!target) {
+    return false;
+  }
+
+  TabStripModel* target_model = target->tab_strip_model();
+  content::WebContents* disposable_ntp = nullptr;
+  if (target_model && target_model->count() == 1) {
+    content::WebContents* contents = target_model->GetActiveWebContents();
+    if (contents && !contents->GetController().CanGoBack() &&
+        search::IsNTPOrRelatedURL(contents->GetLastCommittedURL(),
+                                  target->profile())) {
+      disposable_ntp = contents;
+    }
+  }
+
+  std::vector<int> indices(static_cast<size_t>(model->count()));
+  for (int i = 0; i < model->count(); ++i) {
+    indices[static_cast<size_t>(i)] = i;
+  }
+  chrome::MoveTabsToExistingWindow(browser, target, indices);
+  if (disposable_ntp) {
+    const int ntp_index = target_model->GetIndexOfWebContents(disposable_ntp);
+    if (ntp_index != TabStripModel::kNoTab) {
+      target_model->CloseWebContentsAt(ntp_index, TabCloseTypes::CLOSE_NONE);
+    }
+  }
+  target->window()->Show();
+  return true;
+}
+
+}  // namespace helium
