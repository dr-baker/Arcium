+class MRUTabSwitcherApplicationObserverMac final
+    : public MRUTabSwitcherApplicationObserver {
+ public:
+  explicit MRUTabSwitcherApplicationObserverMac(
+      base::RepeatingClosure callback) {
+    observer_ = [NSNotificationCenter.defaultCenter
+        addObserverForName:NSApplicationDidResignActiveNotification
+                    object:nil
+                     queue:nil
+                usingBlock:^(NSNotification*) {
+                  callback.Run();
+                }];
+  }
+
+  MRUTabSwitcherApplicationObserverMac(
+      const MRUTabSwitcherApplicationObserverMac&) = delete;
+  MRUTabSwitcherApplicationObserverMac& operator=(
+      const MRUTabSwitcherApplicationObserverMac&) = delete;
+
+  ~MRUTabSwitcherApplicationObserverMac() override {
+    [NSNotificationCenter.defaultCenter removeObserver:observer_];
+  }
+
+ private:
+  id __strong observer_;
+};
+
+}  // namespace
