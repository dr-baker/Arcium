+void UpdateMRUTabSwitcherVisualizer(
+    BrowserView* browser_view,
+    const std::vector<content::WebContents*>& starting_tabs,
+    content::WebContents* selected_tab) {
+  auto& visualizer = GetMRUTabSwitcherVisualizers()[browser_view];
+  if (!visualizer) {
+    visualizer = std::make_unique<MRUTabSwitcherOverlay>(browser_view);
+  }
+  visualizer->Update(starting_tabs, selected_tab);
+}
+
+void StopMRUTabSwitcherVisualizer(BrowserView* browser_view) {
+  GetMRUTabSwitcherVisualizers().erase(browser_view);
+}
+
