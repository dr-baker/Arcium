+void TabStripModel::CommitMRUCycling() {
+  if (mru_cycle_list_.empty()) {
+    return;
+  }
+  auto* tab = mru_cycle_list_[mru_cycle_index_].Get();
+  const int index = tab ? GetIndexOfTab(tab) : kNoTab;
+  const auto gesture = mru_cycle_gesture_;
+  // Clear the session before activation notifies observers or starts loading.
