+void ThumbnailTabHelper::CaptureThumbnailForSize(
+    const gfx::Size& minimum_target_size) {
+  if (!state_->is_ready() || minimum_target_size.IsEmpty()) {
+    return;
+  }
+
+  weak_factory_for_thumbnail_on_tab_hidden_.InvalidateWeakPtrs();
+  content::RenderWidgetHostView* const source_view = state_->GetView();
+  if (!source_view || !source_view->IsSurfaceAvailableForCopy()) {
+    return;
+  }
+  const gfx::Size source_size = source_view->GetViewBounds().size();
+  if (source_size.IsEmpty()) {
+    return;
+  }
+
+  ThumbnailCaptureInfo copy_info = GetInitialCaptureInfo(
+      source_size, source_view->GetDeviceScaleFactor(),
+      /*include_scrollbars_in_capture=*/false);
+  const float width_ratio =
+      static_cast<float>(copy_info.copy_rect.width()) /
+      minimum_target_size.width();
+  const float height_ratio =
+      static_cast<float>(copy_info.copy_rect.height()) /
+      minimum_target_size.height();
+  const float scale_ratio = std::min(width_ratio, height_ratio);
+  copy_info.target_size =
+      scale_ratio <= 1.0f
+          ? copy_info.copy_rect.size()
+          : gfx::ScaleToCeiledSize(copy_info.copy_rect.size(),
+                                   1.0f / scale_ratio);
+
+  const base::TimeTicks time_of_call = base::TimeTicks::Now();
+  source_view->CopyFromSurface(
+      copy_info.copy_rect, copy_info.target_size, base::TimeDelta(),
+      base::BindOnce(&ThumbnailTabHelper::StoreThumbnailForTabSwitch,
+                     weak_factory_for_thumbnail_on_tab_hidden_.GetWeakPtr(),
+                     time_of_call));
+}
