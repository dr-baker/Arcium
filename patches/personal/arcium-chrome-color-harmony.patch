+GlassSurfaceConfiguration GlassSurfaceConfigurationForPainting(
+    const GlassSurfaceConfiguration& configuration) {
+  GlassSurfaceConfiguration result = configuration;
+  if (!result.enabled || result.color_effect != GlassSurfaceColorEffect::kGlows) {
+    result.point_count = 0;
+    result.grain = 0.0;
+  } else if (result.tint_strength <= 0.0) {
+    result.point_count = 0;
+  }
+  if (result.enabled && result.color_effect == GlassSurfaceColorEffect::kNone) {
+    result.glass_tint_opacity = 0.0;
+    result.frosted_tint_strength = 0.0;
+  }
+  return result;
+}
