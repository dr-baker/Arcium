+TEST(GlassSurfaceConfigurationTest, ColorEffectRoundTripsAndPreservesRecipe) {
+  for (const auto effect : {GlassSurfaceColorEffect::kGlows,
+                           GlassSurfaceColorEffect::kTint,
+                           GlassSurfaceColorEffect::kNone}) {
+    auto recipe = DefaultGlassSurfaceConfiguration();
+    recipe.color_effect = effect;
+    const auto serialized = SerializeGlassSurfaceConfiguration(recipe);
+    EXPECT_EQ(ParseGlassSurfaceConfiguration(serialized), recipe);
+    EXPECT_EQ(ParseGlassSurfaceConfigurationStrict(serialized), recipe);
+    const auto paint = GlassSurfaceConfigurationForPainting(recipe);
+    EXPECT_EQ(recipe.point_count, 2u);
+    if (effect != GlassSurfaceColorEffect::kGlows) {
+      EXPECT_EQ(paint.point_count, 0u);
+      EXPECT_DOUBLE_EQ(paint.grain, 0.0);
+    }
+    if (effect == GlassSurfaceColorEffect::kNone) {
+      EXPECT_DOUBLE_EQ(paint.glass_tint_opacity, 0.0);
+      EXPECT_DOUBLE_EQ(paint.frosted_tint_strength, 0.0);
+    }
+  }
+}
