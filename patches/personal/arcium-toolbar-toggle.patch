+  EXPECT_EQ(service.FindCommandForAccelerator(kArcToolbarShortcut),
+            IDC_ARCIUM_TOGGLE_TOOLBAR);
+  EXPECT_TRUE(HasPreviousArcShortcutConfiguration(service));
+
+  EXPECT_EQ(RestorePreviousArcShortcutConfiguration(&service),
+            PresetResult::kApplied);
+  EXPECT_EQ(service.FindCommandForAccelerator(kArcToolbarShortcut),
+            IDC_BOOKMARK_ALL_TABS);
+  EXPECT_FALSE(HasPreviousArcShortcutConfiguration(service));
 }
 
