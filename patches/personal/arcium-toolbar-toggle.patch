+  ASSERT_TRUE(chrome::IsCommandEnabled(browser(), IDC_ARCIUM_TOGGLE_TOOLBAR));
+  chrome::ExecuteCommand(browser(), IDC_ARCIUM_TOGGLE_TOOLBAR);
