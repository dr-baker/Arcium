+  EXPECT_TRUE(service.HasCommand(IDC_ARCIUM_TOGGLE_TOOLBAR));
+  const auto label = GetBrowserShortcutCommandLabel(
+      IDC_ARCIUM_TOGGLE_TOOLBAR, &pref_service);
+  ASSERT_TRUE(label.has_value());
+  EXPECT_EQ(label->message_id, IDS_SHORTCUT_COMMAND_TOGGLE_TOOLBAR);
+  bool editor_command_found = false;
+  for (int command_id :
+       GetBrowserShortcutCommandsWithoutDefault(&pref_service)) {
+    editor_command_found |= command_id == IDC_ARCIUM_TOGGLE_TOOLBAR;
+  }
+  EXPECT_TRUE(editor_command_found);
+
+  const char kArcToolbarShortcut[] = "Meta+Shift+KeyD";
+  EXPECT_EQ(service.FindCommandForAccelerator(kArcToolbarShortcut),
+            IDC_BOOKMARK_ALL_TABS);
+  EXPECT_EQ(ApplyArcShortcutPreset(&service), PresetResult::kApplied);
+  EXPECT_EQ(service.FindCommandForAccelerator(kArcToolbarShortcut),
+            IDC_ARCIUM_TOGGLE_TOOLBAR);
+  EXPECT_TRUE(HasPreviousArcShortcutConfiguration(service));
+
+  EXPECT_EQ(RestorePreviousArcShortcutConfiguration(&service),
+            PresetResult::kApplied);
+  EXPECT_EQ(service.FindCommandForAccelerator(kArcToolbarShortcut),
+            IDC_BOOKMARK_ALL_TABS);
+  EXPECT_FALSE(HasPreviousArcShortcutConfiguration(service));
+}
