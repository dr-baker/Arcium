+  EXPECT_TRUE(chrome::IsCommandEnabled(browser(), IDC_FOCUS_LOCATION));
+
+  chrome::ExecuteCommand(browser(), IDC_FOCUS_LOCATION);
+  EXPECT_TRUE(browser_view()->IsToolbarVisible());
+  EXPECT_FALSE(prefs->GetBoolean(arcium::kShowToolbarPref));
+  browser_view()->GetFocusManager()->ClearFocus();
+  EXPECT_FALSE(browser_view()->IsToolbarVisible());
+
+  chrome::ExecuteCommand(browser(), IDC_ARCIUM_TOGGLE_TOOLBAR);
+  EXPECT_TRUE(prefs->GetBoolean(arcium::kShowToolbarPref));
+  EXPECT_TRUE(browser_view()->IsToolbarVisible());
