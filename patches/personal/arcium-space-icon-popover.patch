+void VerticalTabStripBottomContainer::ChangeSpaceIcon() {
+  if (!menu_space_) {
+    return;
+  }
+  ProfileManager* manager = g_browser_process->profile_manager();
+  if (!manager) {
+    return;
+  }
+  icon_picker_.reset();
+  icon_picker_reveal_lock_.reset();
+  if (auto* view = BrowserView::GetBrowserViewForBrowser(browser_)) {
+    icon_picker_reveal_lock_ = view->tab_strip_view()->GetExpandOnHoverLock(
+        ExpandOnHoverLockType::kKeepExpanded);
+  }
+  const auto identity = *menu_space_;
+  // Leave the context menu's command stack before opening a bubble. A profile
+  // from another window may also need to finish loading first.
+  base::SingleThreadTaskRunner::GetCurrentDefault()->PostTask(
+      FROM_HERE, base::BindOnce(
+          [](base::WeakPtr<VerticalTabStripBottomContainer> container,
+             base::FilePath path, std::string id) {
+            if (!container) {
+              return;
+            }
+            auto* manager = g_browser_process->profile_manager();
+            if (!manager) {
+              container->icon_picker_reveal_lock_.reset();
+              return;
+            }
+            if (Profile* profile = manager->GetProfileByPath(path)) {
+              container->OpenSpaceIconPicker(path, std::move(id), profile);
+            } else {
+              manager->LoadProfileByPath(path, false,
+                  base::BindOnce(&VerticalTabStripBottomContainer::OpenSpaceIconPicker,
+                                 container, path, std::move(id)));
+            }
+          }, weak_factory_.GetWeakPtr(), identity.first, identity.second));
+}
+
+void VerticalTabStripBottomContainer::OpenSpaceIconPicker(
+    base::FilePath profile_path, std::string space_id, Profile* profile) {
+  if (!profile || !GetWidget() || GetWidget()->IsClosed() ||
+      profile->GetPath() != profile_path) {
+    icon_picker_reveal_lock_.reset();
+    return;
+  }
+  auto* service = helium::HeliumSpaceServiceFactory::GetForProfile(profile);
+  auto* space = service ? service->GetSpaceById(space_id) : nullptr;
+  const auto found = std::ranges::find_if(entries_, [&](const auto& entry) {
+    return entry.profile_path == profile_path && entry.space_id == space_id;
+  });
+  if (!space || found == entries_.end()) {
+    icon_picker_reveal_lock_.reset();
+    return;
+  }
+  const size_t index = found - entries_.begin();
+  auto state = std::make_shared<IconEditState>();
+  state->profile_path = profile->GetPath();
+  state->space_id = std::move(space_id);
+  if (profile != browser_->GetProfile()) {
+    state->profile_keep_alive = std::make_unique<ScopedProfileKeepAlive>(
+        profile, ProfileKeepAliveOrigin::kArciumSettingsWindow);
+  }
+  icon_picker_ = std::make_unique<ArciumSpaceIconPicker>(
+      space_buttons_[index], space->icon(),
+      base::BindRepeating([](std::shared_ptr<IconEditState> state,
+                             const std::string& icon) { state->picked = icon; }, state),
+      base::BindOnce(&VerticalTabStripBottomContainer::OnSpaceIconPickerClosed,
+                     weak_factory_.GetWeakPtr(), state));
+}
+
+void VerticalTabStripBottomContainer::OnSpaceIconPickerClosed(
+    std::shared_ptr<IconEditState> state) {
+  icon_picker_.reset();
+  icon_picker_reveal_lock_.reset();
+  if (state->picked) {
+    // SetSpaceIcon synchronously rebuilds the directory and its footer icons.
+    // Commit after both bubble and anchor observers have completed teardown.
+    base::SingleThreadTaskRunner::GetCurrentDefault()->PostTask(
+        FROM_HERE, base::BindOnce(&VerticalTabStripBottomContainer::CommitSpaceIcon,
+                                 weak_factory_.GetWeakPtr(), std::move(state)));
+  }
+}
+
+void VerticalTabStripBottomContainer::CommitSpaceIcon(
+    std::shared_ptr<IconEditState> state) {
+  Profile* profile = state->profile_keep_alive
+      ? state->profile_keep_alive->profile() : browser_->GetProfile();
+  if (!profile || profile->GetPath() != state->profile_path) {
+    return;
+  }
+  auto* service = helium::HeliumSpaceServiceFactory::GetForProfile(profile);
+  if (service && service->GetSpaceById(state->space_id) && state->picked) {
+    service->SetSpaceIcon(state->space_id, std::move(*state->picked));
+  }
+}
