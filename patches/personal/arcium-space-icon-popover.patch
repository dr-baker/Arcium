+
+base::span<const std::string_view> GetSpaceEmojiCategories() {
+  return kSpaceEmojiCategories;
+}
+
+std::vector<const SpaceEmoji*> SearchSpaceEmoji(std::u16string_view query,
+                                               int category) {
+  std::vector<const SpaceEmoji*> result;
+  if (category < -1 || category >= static_cast<int>(std::size(kSpaceEmojiCategories))) {
+    return result;
+  }
+  const std::string normalized = base::ToLowerASCII(base::UTF16ToUTF8(query));
+  const auto words = base::SplitString(normalized, base::kWhitespaceASCII,
+                                       base::TRIM_WHITESPACE,
+                                       base::SPLIT_WANT_NONEMPTY);
+  for (const SpaceEmoji& emoji : kSpaceEmoji) {
+    if (category >= 0 && !(emoji.category_mask & (1 << category))) {
+      continue;
+    }
+    if (std::ranges::all_of(words, [&](const std::string& word) {
+          return emoji.emoji == word ||
+                 emoji.keywords.find(word) != std::string_view::npos;
+        })) {
+      result.push_back(&emoji);
+    }
+  }
+  if (!words.empty()) {
+    const std::string_view exact =
+        base::TrimWhitespaceASCII(normalized, base::TRIM_ALL);
+    // A direct name such as "rocket" should precede related keyword matches.
+    std::ranges::stable_partition(result, [&](const SpaceEmoji* emoji) {
+      return base::EqualsCaseInsensitiveASCII(emoji->name, exact) ||
+             emoji->emoji == exact;
+    });
+  }
+  return result;
+}
+
 base::span<const PhosphorGlyph> GetPhosphorGlyphs() {
   return kGlyphs;
 }
