+// Copyright 2026 The Chromium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+#include "chrome/browser/ui/helium/arcium_space_icon.h"
+#include <algorithm>
+#include <set>
+#include "testing/gtest/include/gtest/gtest.h"
+
+namespace helium {
+namespace {
+bool ContainsEmoji(const std::vector<const SpaceEmoji*>& matches,
+                   std::string_view emoji) {
+  return std::ranges::any_of(matches, [&](const auto* item) {
+    return item->emoji == emoji;
+  });
+}
+TEST(ArciumSpaceIconTest, EmojiCatalogueHasUniqueNamedNormalizedChoices) {
+  ASSERT_EQ(GetSpaceEmojiCategories().size(), 9u);
+  ASSERT_GT(GetSpaceEmoji().size(), 1500u);
+  std::set<std::string_view> seen;
+  for (const auto& entry : GetSpaceEmoji()) {
+    EXPECT_FALSE(entry.name.empty());
+    EXPECT_FALSE(entry.keywords.empty());
+    EXPECT_TRUE(seen.insert(entry.emoji).second);
+    EXPECT_EQ(NormalizeSpaceIcon(entry.emoji), entry.emoji);
+    EXPECT_GT(entry.category_mask, 0);
+    EXPECT_EQ(entry.category_mask & ~((1 << 9) - 1), 0);
+  }
+}
+TEST(ArciumSpaceIconTest, EmojiSearchUsesNamesKeywordsAndAsciiAccents) {
+  EXPECT_TRUE(ContainsEmoji(SearchSpaceEmoji(u"ROCKET"), "🚀"));
+  EXPECT_TRUE(ContainsEmoji(SearchSpaceEmoji(u"Sao Tome"), "🇸🇹"));
+  EXPECT_TRUE(ContainsEmoji(SearchSpaceEmoji(u"🚀"), "🚀"));
+  EXPECT_TRUE(SearchSpaceEmoji(u"not-an-emoji-zzzz").empty());
+}
+TEST(ArciumSpaceIconTest, ExactEmojiNamesLeadRelatedKeywords) {
+  const auto matches = SearchSpaceEmoji(u"  ROCKET  ");
+  ASSERT_GT(matches.size(), 1u);
+  EXPECT_EQ(matches.front()->emoji, "🚀");
+  EXPECT_TRUE(ContainsEmoji(matches, "🧑‍🚀"));
+}
+TEST(ArciumSpaceIconTest, EmojiCategoriesAndInvalidInputsAreBounded) {
+  for (int category = 0; category < 9; ++category) {
+    const auto matches = SearchSpaceEmoji(u"", category);
+    ASSERT_FALSE(matches.empty());
+    for (const auto* entry : matches) {
+      EXPECT_TRUE(entry->category_mask & (1 << category));
+    }
+  }
+  EXPECT_TRUE(ContainsEmoji(SearchSpaceEmoji(u"Sao Tome", 8), "🇸🇹"));
+  EXPECT_FALSE(ContainsEmoji(SearchSpaceEmoji(u"Sao Tome", 0), "🇸🇹"));
+  EXPECT_TRUE(SearchSpaceEmoji(u"", -2).empty());
+  EXPECT_TRUE(SearchSpaceEmoji(u"", 9).empty());
+}
+}  // namespace
+}  // namespace helium
