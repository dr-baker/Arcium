+std::optional<MediaPlayerId>
+MediaWebContentsObserver::GetVideoPlayerForAutomaticPictureInPicture() const {
+  std::optional<MediaPlayerId> candidate;
+  for (const auto& [id, info] : player_info_map_) {
+    if (!info->is_playing() || !info->has_video()) {
+      continue;
+    }
+    auto* frame = RenderFrameHostImpl::FromID(id.frame_routing_id);
+    if (!frame || !frame->IsInPrimaryMainFrame() ||
+        !frame->HasStickyUserActivation()) {
+      continue;
+    }
+    auto host = media_player_observer_hosts_.find(id);
+    if (host == media_player_observer_hosts_.end() ||
+        !host->second->is_picture_in_picture_available() ||
+        !media_player_remotes_.contains(id)) {
+      continue;
+    }
+    if (candidate) {
+      return std::nullopt;
+    }
+    candidate = id;
+  }
+  return candidate;
+}
