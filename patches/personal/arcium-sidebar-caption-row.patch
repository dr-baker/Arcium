 }
+
+TEST_F(ArciumBrowserChromeTest, SidebarCaptionMatchesNavigationRowAtEachScale) {
+  prefs()->SetBoolean(arcium::kArcSidebarNavigationEnabledPref, true);
+  auto* toolbar = browser_view()->toolbar();
+  for (int scale : {100, 110}) {
+    prefs()->SetInteger(arcium::kChromeUIScalePref, scale);
+    Layout();
+    const int caption_height = toolbar->GetSidebarNavigationCaptionHeight();
+    EXPECT_EQ(browser_view()->GetFrameElementInfo().toolbar_minimum_height,
+              caption_height);
+    EXPECT_LT(caption_height, toolbar->GetMinimumSize().height());
+    EXPECT_LE(std::abs(toolbar->forward_button()->bounds().CenterPoint().y() * 2 -
+                       caption_height), 1);
+  }
+}
+
+TEST_F(ArciumBrowserChromeTest, HiddenTopBarRetainsIntrinsicCaptionHeight) {
+  const int visible_height =
+      browser_view()->GetFrameElementInfo().toolbar_minimum_height;
+  ASSERT_GT(visible_height, 0);
+  prefs()->SetBoolean(arcium::kShowToolbarPref, false);
+  Layout();
+  EXPECT_EQ(browser_view()->GetFrameElementInfo().toolbar_minimum_height,
+            visible_height);
+}
