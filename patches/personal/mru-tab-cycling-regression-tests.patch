+TEST_F(TabStripModelTest, SelectRelativeTabCycleUsesLastActiveTimeTicks) {
+  PrepareTabs(tabstrip(), 3);
+  ASSERT_EQ(2, tabstrip()->active_index());
+
+  profile()->GetPrefs()->SetBoolean(prefs::kTabCyclingMRU, true);
+
+  const base::TimeTicks now = base::TimeTicks::Now();
+  auto set_last_active_time = [&](int index, base::TimeTicks time) {
+    content::WebContentsTester::For(tabstrip()->GetWebContentsAt(index))
+        ->SetLastActiveTimeTicks(time);
+  };
+  set_last_active_time(2, now);
+  set_last_active_time(1, now - base::Seconds(1));
+  set_last_active_time(0, now - base::Seconds(2));
+
+  tabstrip()->SelectNextTab();
+  EXPECT_EQ(1, tabstrip()->active_index());
+
+  tabstrip()->SelectPreviousTab();
+  EXPECT_EQ(2, tabstrip()->active_index());
+
+  tabstrip()->StopMRUCycling();
+  set_last_active_time(2, now);
+  set_last_active_time(1, now - base::Seconds(1));
+  set_last_active_time(0, now - base::Seconds(2));
+
+  tabstrip()->SelectPreviousTab();
+  EXPECT_EQ(0, tabstrip()->active_index());
+}
