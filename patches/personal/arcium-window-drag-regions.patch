+namespace {
+int ChromeHitTest(BrowserView* browser_view, views::View* view,
+                  gfx::Point point) {
+  views::View::ConvertPointToTarget(view, browser_view->parent(), &point);
+  return browser_view->NonClientHitTest(point);
