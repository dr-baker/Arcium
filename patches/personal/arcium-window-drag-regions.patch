+TEST_F(ArciumBrowserChromeTest, InfobarPaddingDragsAndControlsRemainClient) {
+  gfx::ScopedAnimationDurationScaleMode animations(
+      gfx::ScopedAnimationDurationScaleMode::ZERO_DURATION);
+  auto infobar = ConfirmInfoBar::Create(std::make_unique<DragTestInfoBarDelegate>());
+  auto* bar = infobar.get();
+  auto* manager = infobars::ContentInfoBarManager::FromWebContents(
+      browser()->GetTabStripModel()->GetActiveWebContents());
+  ASSERT_TRUE(manager);
+  manager->AddInfoBar(std::move(infobar));
+  bar->Show(false);
+  ASSERT_TRUE(base::test::RunUntil([&] {
+    Layout();
+    return bar->IsDrawn();
+  }));
+  ASSERT_GT(bar->width(), 100);
+  EXPECT_EQ(HTCAPTION, ChromeHitTest(browser_view(), bar,
+                                    gfx::Point(2, bar->height() / 2)));
+  auto client = [&](views::View* control) {
+    ASSERT_TRUE(control);
+    EXPECT_EQ(HTCLIENT, ChromeHitTest(browser_view(), control,
+                                     control->GetLocalBounds().CenterPoint()));
+  };
+  client(bar->label_for_testing());
+  client(bar->ok_button_for_testing());
+  client(bar->cancel_button_for_testing());
+  views::View* dismiss = nullptr;
+  for (views::View* child : bar->children()) {
+    for (views::View* nested : child->children()) {
+      if (nested->GetProperty(views::kElementIdentifierKey) ==
+          InfoBarView::kDismissButtonElementId) dismiss = nested;
+    }
+  }
+  client(dismiss);
+  manager->RemoveInfoBar(bar);
+}
