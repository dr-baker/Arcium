+bool MultiContentsView::IsPositionInWindowCaption(const gfx::Point& point) {
+  if (!GetLocalBounds().Contains(point)) return false;
+  int contents_top = height();
+  bool has_contents = false;
+  for (const auto& container : contents_container_views_) {
+    if (container->GetVisible() && !container->bounds().IsEmpty()) {
+      contents_top = std::min(contents_top, container->y());
+      has_contents = true;
+    }
+  }
+  if (!has_contents || point.y() >= contents_top) return false;
+  const auto* target = GetEventHandlerForPoint(point);
+  return target == this || target == background_view_ ||
+         target == contents_separators_.top_separator.get();
+}
