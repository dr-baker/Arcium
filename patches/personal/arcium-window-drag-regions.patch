+class DragTestInfoBarDelegate : public ConfirmInfoBarDelegate {
+ public:
+  InfoBarIdentifier GetIdentifier() const override { return TEST_INFOBAR; }
+  std::u16string GetMessageText() const override { return u"Automation notice"; }
+};
+}
+
+TEST_F(ArciumBrowserChromeTest, HiddenToolbarTopFrameDragsWithoutClaimingPage) {
+  prefs()->SetBoolean(arcium::kShowToolbarPref, false);
+  auto* view = browser_view()->multi_contents_view();
+  for (int scale : {75, 100, 150}) {
+    prefs()->SetInteger(arcium::kChromeUIScalePref, scale);
+    for (int border : {1, 6, 12}) {
+      prefs()->SetInteger(arcium::kChromeFrameBorderWidthPref, border);
+      Layout();
+      const auto bounds = view->GetActiveContentsContainerView()->bounds();
+      ASSERT_GT(bounds.y(), 0);
+      EXPECT_EQ(HTCAPTION, ChromeHitTest(browser_view(), view,
+          gfx::Point(bounds.CenterPoint().x(), bounds.y() - 1)));
+      EXPECT_EQ(HTCLIENT, ChromeHitTest(browser_view(), view,
+          gfx::Point(bounds.CenterPoint().x(), bounds.y() + 2)));
+      EXPECT_EQ(HTCLIENT, ChromeHitTest(browser_view(), view,
+          gfx::Point(view->width() - 1, bounds.CenterPoint().y())));
+    }
+  }
+}
+
+TEST_F(ArciumBrowserChromeTest, StackedSplitTopPageNeverBecomesWindowCaption) {
+  AddTab(browser(), GURL("https://second.test/"));
+  auto* model = browser()->GetTabStripModel();
+  model->AddToNewSplit({1 - model->active_index()},
+      split_tabs::SplitTabVisualData(split_tabs::SplitTabLayout::kStacked),
+      split_tabs::SplitTabCreatedSource::kToolbarButton);
+  prefs()->SetBoolean(arcium::kShowToolbarPref, false);
+  auto* view = browser_view()->multi_contents_view();
+  for (int index : {0, 1}) {
+    model->ActivateTabAt(index);
+    Layout();
+    for (const auto& container : view->contents_container_views()) {
+      ASSERT_TRUE(container->GetVisible());
+      EXPECT_EQ(HTCLIENT, ChromeHitTest(browser_view(), view,
+                                      container->bounds().CenterPoint()));
+    }
+    EXPECT_EQ(HTCAPTION, ChromeHitTest(browser_view(), view,
+                                      gfx::Point(view->width() / 2, 2)));
+  }
+}
