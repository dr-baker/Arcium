+}  // namespace
+
+bool ShowPeekForLink(content::WebContents* source_contents, const GURL& url) {
+  tabs::TabInterface* const tab =
+      source_contents
+          ? tabs::TabInterface::MaybeGetFromContents(source_contents)
+          : nullptr;
+  BrowserWindowInterface* const browser_window =
+      tab ? tab->GetBrowserWindowInterface() : nullptr;
+  Browser* const browser =
+      browser_window ? browser_window->GetBrowserForMigrationOnly() : nullptr;
+  BrowserView* const browser_view =
+      browser ? BrowserView::GetBrowserViewForBrowser(browser) : nullptr;
+  return browser_view && browser_view->peek_controller() &&
+         browser_view->peek_controller()->Show(url, source_contents);
+}
+
+PeekController::PeekController(BrowserView* browser_view)
+    : browser_view_(browser_view) {}
+
+PeekController::~PeekController() {
+  Close();
+}
+
+bool PeekController::Show(const GURL& url,
+                          content::WebContents* source_contents) {
+  if (!url.SchemeIsHTTPOrHTTPS() || !source_contents || !browser_view_ ||
+      source_contents->GetBrowserContext() !=
+          browser_view_->browser()->profile()) {
+    return false;
+  }
+
+  ContentsContainerView* const contents_container =
+      browser_view_->GetContentsContainerViewFor(source_contents);
+  if (!contents_container || !contents_container->peek_overlay_view()) {
+    return false;
+  }
+
+  Close();
+  auto web_contents = content::WebContents::Create(
+      content::WebContents::CreateParams(browser_view_->browser()->profile()));
+  if (!web_contents) {
+    return false;
+  }
+  web_contents->SetDelegate(browser_view_->browser());
+
+  auto overlay = std::make_unique<PeekOverlayView>(
+      browser_view_->browser()->profile(),
+      base::BindRepeating(&PeekController::Close, base::Unretained(this)),
+      base::BindRepeating(&PeekController::OpenInTab,
+                          base::Unretained(this)));
+  PeekOverlayView* const overlay_ptr = overlay.get();
+  views::WebView* const web_view = overlay_ptr->web_view();
+  web_view->SetWebContents(web_contents.get());
+
+  contents_container_ = contents_container;
+  contents_container_->peek_overlay_view()->AddChildView(
+      std::unique_ptr<views::View>(std::move(overlay)));
+  overlay_view_ = overlay_ptr;
+  web_view_ = web_view;
+  web_contents_ = std::move(web_contents);
+  scoped_ignore_input_events_ =
+      source_contents->IgnoreInputEvents(std::nullopt);
+  source_contents_ = source_contents->GetWeakPtr();
+  contents_container_->peek_overlay_view()->SetVisible(true);
+  contents_container_->peek_overlay_view()->InvalidateLayout();
+
+  content::NavigationController::LoadURLParams load_params(url);
+  load_params.transition_type = ui::PAGE_TRANSITION_LINK;
+  web_contents_->GetController().LoadURLWithParams(load_params);
+  web_view_->RequestFocus();
+  return true;
+}
+
+void PeekController::Close() {
+  scoped_ignore_input_events_.reset();
+  if (web_view_) {
+    web_view_->SetWebContents(nullptr);
+  }
+  web_view_ = nullptr;
+  web_contents_.reset();
+  if (contents_container_ && overlay_view_) {
+    contents_container_->peek_overlay_view()->RemoveChildViewT(overlay_view_);
+    contents_container_->peek_overlay_view()->SetVisible(false);
+  }
+  overlay_view_ = nullptr;
+  contents_container_ = nullptr;
+  if (source_contents_) {
+    source_contents_->RestoreFocus();
+  }
+  source_contents_.reset();
+}
+
+void PeekController::OpenInTab() {
+  if (!web_contents_ || !browser_view_) {
+    return;
+  }
+  scoped_ignore_input_events_.reset();
+  if (web_view_) {
+    web_view_->SetWebContents(nullptr);
+  }
+  web_view_ = nullptr;
+  if (contents_container_ && overlay_view_) {
+    contents_container_->peek_overlay_view()->RemoveChildViewT(overlay_view_);
+    contents_container_->peek_overlay_view()->SetVisible(false);
+  }
+  overlay_view_ = nullptr;
+  contents_container_ = nullptr;
+  source_contents_.reset();
+
+  Browser* const browser = browser_view_->browser();
+  browser->tab_strip_model()->AddWebContents(
+      std::move(web_contents_), browser->tab_strip_model()->active_index() + 1,
+      ui::PAGE_TRANSITION_LINK, AddTabTypes::ADD_ACTIVE);
+}
+
+}  // namespace helium
