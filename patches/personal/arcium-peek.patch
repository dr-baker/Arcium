+constexpr int kCardMargin = 32;
+constexpr int kCardMaximumWidth = 1100;
+constexpr int kCardMaximumHeight = 760;
+constexpr int kHeaderHeight = 48;
+constexpr int kCardCornerRadius = 14;
+
+class PeekCardView : public views::View {
+ public:
+  PeekCardView(Profile* profile,
+               base::RepeatingClosure close_callback,
+               base::RepeatingClosure open_in_tab_callback) {
+    SetPaintToLayer();
+    layer()->SetFillsBoundsOpaquely(false);
+    SetBackground(views::CreateRoundedRectBackground(
+        ui::kColorDialogBackground, kCardCornerRadius));
+    SetBorder(views::CreateRoundedRectBorder(
+        1, kCardCornerRadius, ui::kColorSeparator));
+
+    close_button_ = AddChildView(std::make_unique<views::LabelButton>(
+        std::move(close_callback),
+        l10n_util::GetStringUTF16(IDS_HELIUM_PEEK_CLOSE)));
+    open_in_tab_button_ = AddChildView(std::make_unique<views::LabelButton>(
+        std::move(open_in_tab_callback),
+        l10n_util::GetStringUTF16(IDS_HELIUM_PEEK_OPEN_IN_TAB)));
+    web_view_ = AddChildView(std::make_unique<views::WebView>(profile));
+  }
+
+  views::WebView* web_view() const { return web_view_; }
+
+ private:
+  bool OnMousePressed(const ui::MouseEvent&) override { return true; }
+
+  void Layout(PassKey) override {
+    const gfx::Rect bounds = GetContentsBounds();
+    const int button_height = 32;
+    const int close_width = close_button_->GetPreferredSize().width();
+    const int open_width = open_in_tab_button_->GetPreferredSize().width();
+    close_button_->SetBounds(12, (kHeaderHeight - button_height) / 2,
+                             close_width, button_height);
+    open_in_tab_button_->SetBounds(
+        std::max(12, bounds.width() - open_width - 12),
+        (kHeaderHeight - button_height) / 2, open_width, button_height);
+    web_view_->SetBounds(1, kHeaderHeight, std::max(0, bounds.width() - 2),
+                         std::max(0, bounds.height() - kHeaderHeight - 1));
+  }
+
+  raw_ptr<views::LabelButton> close_button_ = nullptr;
+  raw_ptr<views::LabelButton> open_in_tab_button_ = nullptr;
+  raw_ptr<views::WebView> web_view_ = nullptr;
+};
+
+class PeekOverlayView : public views::View {
+ public:
+  PeekOverlayView(Profile* profile,
+                  base::RepeatingClosure close_callback,
+                  base::RepeatingClosure open_in_tab_callback)
+      : close_callback_(close_callback) {
+    SetPaintToLayer();
+    layer()->SetFillsBoundsOpaquely(false);
+    SetBackground(views::CreateSolidBackground(SkColorSetARGB(128, 0, 0, 0)));
+    auto card = std::make_unique<PeekCardView>(
+        profile, std::move(close_callback),
+        std::move(open_in_tab_callback));
+    card_ = card.get();
+    AddChildView(std::unique_ptr<views::View>(std::move(card)));
+  }
+
+  views::WebView* web_view() const { return card_->web_view(); }
+
+ private:
+  void Layout(PassKey) override {
+    gfx::Rect card_bounds = GetContentsBounds();
+    card_bounds.Inset(gfx::Insets(kCardMargin));
+    if (card_bounds.width() > kCardMaximumWidth) {
+      card_bounds.ClampToCenteredSize(
+          gfx::Size(kCardMaximumWidth, card_bounds.height()));
+    }
+    if (card_bounds.height() > kCardMaximumHeight) {
+      card_bounds.ClampToCenteredSize(
+          gfx::Size(card_bounds.width(), kCardMaximumHeight));
+    }
+    card_->SetBoundsRect(card_bounds);
+  }
+
+  bool OnMousePressed(const ui::MouseEvent&) override {
+    close_callback_.Run();
+    return true;
+  }
+
+  raw_ptr<PeekCardView> card_ = nullptr;
+  base::RepeatingClosure close_callback_;
+};
