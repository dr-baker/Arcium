+// Copyright 2026 The Helium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "chrome/browser/ui/views/helium/peek_controller.h"
+
+#include "chrome/browser/ui/browser.h"
+#include "chrome/browser/ui/tabs/tab_strip_model.h"
+#include "chrome/browser/ui/views/frame/browser_view.h"
+#include "chrome/test/base/in_process_browser_test.h"
+#include "chrome/test/base/ui_test_utils.h"
+#include "content/public/browser/web_contents.h"
+#include "content/public/test/browser_test.h"
+#include "content/public/test/browser_test_utils.h"
+
+namespace helium {
+
+class PeekControllerBrowserTest : public InProcessBrowserTest {};
+
+IN_PROC_BROWSER_TEST_F(PeekControllerBrowserTest,
+                       ShowCloseAndPromoteLiveContents) {
+  ASSERT_TRUE(embedded_test_server()->Start());
+  const GURL url = embedded_test_server()->GetURL("/empty.html");
+  BrowserView* const browser_view =
+      BrowserView::GetBrowserViewForBrowser(browser());
+  ASSERT_TRUE(browser_view);
+  PeekController* const controller = browser_view->peek_controller();
+  ASSERT_TRUE(controller);
+  content::WebContents* const source =
+      browser()->tab_strip_model()->GetActiveWebContents();
+  ASSERT_TRUE(source);
+
+  EXPECT_FALSE(controller->Show(GURL("file:///tmp/not-peekable"), source));
+  EXPECT_FALSE(controller->is_showing());
+
+  ASSERT_TRUE(controller->Show(url, source));
+  ASSERT_TRUE(controller->is_showing());
+  ASSERT_TRUE(content::WaitForLoadStop(controller->web_contents_for_testing()));
+  EXPECT_TRUE(source->ShouldIgnoreInputEventsForTesting());
+
+  controller->Close();
+  EXPECT_FALSE(controller->is_showing());
+  EXPECT_FALSE(source->ShouldIgnoreInputEventsForTesting());
+
+  ASSERT_TRUE(controller->Show(url, source));
+  content::WebContents* const preview_contents =
+      controller->web_contents_for_testing();
+  ASSERT_TRUE(content::WaitForLoadStop(preview_contents));
+  const int old_count = browser()->tab_strip_model()->count();
+  controller->OpenInTab();
+
+  EXPECT_FALSE(controller->is_showing());
+  EXPECT_EQ(old_count + 1, browser()->tab_strip_model()->count());
+  EXPECT_EQ(preview_contents,
+            browser()->tab_strip_model()->GetActiveWebContents());
+  EXPECT_FALSE(source->ShouldIgnoreInputEventsForTesting());
+}
+
+}  // namespace helium
