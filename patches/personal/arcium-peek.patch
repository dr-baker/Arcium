+// found in the LICENSE file.
+
+#ifndef CHROME_BROWSER_UI_VIEWS_HELIUM_PEEK_CONTROLLER_H_
+#define CHROME_BROWSER_UI_VIEWS_HELIUM_PEEK_CONTROLLER_H_
+
+#include <memory>
+#include <optional>
+
+#include "base/memory/raw_ptr.h"
+#include "base/memory/weak_ptr.h"
+#include "content/public/browser/web_contents.h"
+#include "url/gurl.h"
+
+class BrowserView;
+class ContentsContainerView;
+
+namespace views {
+class View;
+class WebView;
+}  // namespace views
+
+namespace helium {
+
+// Opens `url` in the Peek controller owned by `source_contents`' browser
+// window. Returns false without changing the source tab when no attached Peek
+// host is available.
+bool ShowPeekForLink(content::WebContents* source_contents, const GURL& url);
+
+// Owns the attached Peek surface for one browser window. Peek deliberately has
+// no dependency on Spaces or Pins; those features may call Show() when present.
+class PeekController {
+ public:
+  explicit PeekController(BrowserView* browser_view);
+  PeekController(const PeekController&) = delete;
+  PeekController& operator=(const PeekController&) = delete;
+  ~PeekController();
+
+  // Shows `url` over `source_contents`. Returns false without changing the
+  // current page when Peek cannot be created, allowing callers to fall back to
+  // an ordinary navigation.
+  bool Show(const GURL& url, content::WebContents* source_contents);
+  void Close();
+  void OpenInTab();
+
+  bool is_showing() const { return web_contents_ != nullptr; }
+  content::WebContents* web_contents_for_testing() const {
+    return web_contents_.get();
+  }
+  views::View* overlay_view_for_testing() const { return overlay_view_; }
+
+ private:
+  raw_ptr<BrowserView> browser_view_;
+  raw_ptr<ContentsContainerView> contents_container_ = nullptr;
+  raw_ptr<views::View> overlay_view_ = nullptr;
+  raw_ptr<views::WebView> web_view_ = nullptr;
+  std::unique_ptr<content::WebContents> web_contents_;
+  base::WeakPtr<content::WebContents> source_contents_;
+  std::optional<content::WebContents::ScopedIgnoreInputEvents>
+      scoped_ignore_input_events_;
+};
+
+}  // namespace helium
+
+#endif  // CHROME_BROWSER_UI_VIEWS_HELIUM_PEEK_CONTROLLER_H_
