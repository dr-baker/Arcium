--- src.orig/chrome/browser/ui/browser_shortcuts/browser_shortcut_platform_mac_unittest.mm
+++ src/chrome/browser/ui/browser_shortcuts/browser_shortcut_platform_mac_unittest.mm
@@ -263,6 +263,49 @@ TEST(BrowserShortcutPlatformMacTest,
 }
 
 TEST(BrowserShortcutPlatformMacTest,
+     ToolbarDefaultPreservesCustomBookmarkMenuShortcut) {
+  ASSERT_NE(NSApp, nil);
+  NSMenu* bookmark_menu = MainMenuWithCommandShortcut(
+      IDC_BOOKMARK_ALL_TABS, @"Bookmark All Tabs", @"", 0,
+      @selector(commandDispatch:));
+  NSMenuItem* bookmark_all = [bookmark_menu itemWithTag:IDC_BOOKMARK_ALL_TABS];
+  ScopedMainMenu menu(bookmark_menu);
+  const ui::Accelerator toolbar(ui::VKEY_D,
+                               ui::EF_COMMAND_DOWN | ui::EF_SHIFT_DOWN);
+  const ui::Accelerator custom_bookmark(ui::VKEY_B,
+                                       ui::EF_COMMAND_DOWN | ui::EF_ALT_DOWN);
+
+  for (int refresh = 0; refresh < 3; ++refresh) {
+    EXPECT_EQ(CountDefaultsForCommand(GetPlatformDefaultAccelerators(),
+                                     IDC_BOOKMARK_ALL_TABS), 0);
+    UpdatePlatformMenuAccelerators({
+        {toolbar, IDC_ARCIUM_TOGGLE_TOOLBAR},
+        {custom_bookmark, IDC_BOOKMARK_ALL_TABS},
+    });
+    EXPECT_TRUE([bookmark_all.keyEquivalent isEqualToString:@"b"]);
+    EXPECT_EQ(bookmark_all.keyEquivalentModifierMask,
+              NSEventModifierFlagCommand | NSEventModifierFlagOption);
+  }
+  UpdatePlatformMenuAccelerators({{toolbar, IDC_ARCIUM_TOGGLE_TOOLBAR}});
+  EXPECT_EQ(bookmark_all.keyEquivalent.length, 0u);
+
+  // A later AppKit override remains reserved instead of being rewritten.
+  bookmark_all.keyEquivalent = @"x";
+  bookmark_all.keyEquivalentModifierMask =
+      NSEventModifierFlagCommand | NSEventModifierFlagOption;
+  bool found_override = false;
+  for (const auto& entry : GetPlatformDefaultAccelerators()) {
+    if (entry.command_id == IDC_BOOKMARK_ALL_TABS) {
+      found_override = true;
+      EXPECT_FALSE(entry.user_modifiable);
+    }
+  }
+  EXPECT_TRUE(found_override);
+  UpdatePlatformMenuAccelerators({{custom_bookmark, IDC_BOOKMARK_ALL_TABS}});
+  EXPECT_TRUE([bookmark_all.keyEquivalent isEqualToString:@"x"]);
+}
+
