+CommandPanelView::CommandPanelView(base::RepeatingClosure dismiss,
+                                   base::RepeatingCallback<void(bool)> reopen)
+    : dismiss_(std::move(dismiss)), reopen_(std::move(reopen)) {
+  GetViewAccessibility().SetRole(ax::mojom::Role::kDialog);
+  GetViewAccessibility().SetName(u"Arcium command bar preview");
+  for (auto scope : kScopes) {
+    scope_buttons_.push_back(
+        AddChildView(std::make_unique<ScopeButton>(this, scope)));
+  }
+  input_ = AddChildView(std::make_unique<views::Textfield>());
+  input_->set_controller(this);
+  input_->SetBorder(views::CreateEmptyBorder(0));
+  input_->SetBackgroundColor(SK_ColorTRANSPARENT);
+  input_->SetColor(kText);
+  input_->SetFontList(Font(18, true));
+  input_->GetViewAccessibility().SetRole(
+      ax::mojom::Role::kTextFieldWithComboBox);
+  input_->GetViewAccessibility().SetName(u"Search everything or enter URL");
+  input_->GetViewAccessibility().SetHasPopup(ax::mojom::HasPopup::kListbox);
+  scroll_ = AddChildView(std::make_unique<views::ScrollView>());
+  scroll_->SetBackgroundColor(std::nullopt);
+  scroll_->SetDrawOverflowIndicator(false);
+  scroll_->SetHorizontalScrollBarMode(
+      views::ScrollView::ScrollBarMode::kDisabled);
+  results_view_ = scroll_->SetContents(std::make_unique<ResultsView>(this));
+  results_view_->GetViewAccessibility().SetRole(ax::mojom::Role::kListBox);
+  results_view_->GetViewAccessibility().SetName(u"Suggestions");
+  footer_button_ = AddChildView(std::make_unique<FooterButton>(this));
+  selection_animation_.SetSlideDuration(base::Milliseconds(155));
+  scope_animation_.SetSlideDuration(base::Milliseconds(140));
+  selection_animation_.SetTweenType(gfx::Tween::FAST_OUT_SLOW_IN);
+  scope_animation_.SetTweenType(gfx::Tween::FAST_OUT_SLOW_IN);
+  SetInvocation(true);
