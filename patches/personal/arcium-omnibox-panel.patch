+void CommandPanelView::SetInvocation(bool new_tab) {
+  updating_ = true;
+  current_context_ = !new_tab;
+  scope_ = SearchScope::kEverything;
+  actions_visible_ = false;
+  actions_.clear();
+  scope_browsing_ = false;
+  scope_hovered_ = false;
+  scope_animation_.Reset(0);
+  selected_ = 0;
+  input_->SetText(
+      new_tab ? u""
+              : FixtureIndex().Get(FixtureIndex().Ref(kCurrentFixture))->url);
+  input_->SelectAll(false);
+  preview_feedback_.clear();
+  updating_ = false;
+  RebuildResults();
+  FocusInput();
+}
+void CommandPanelView::SetAppearance(CommandPanelAppearance appearance) {
+  if (appearance_ == appearance) {
+    return;
+  }
+  appearance_ = appearance;
+  RebuildViews();
+}
+void CommandPanelView::SetUIScale(float scale) {
+  scale = std::clamp(scale, .8f, 1.25f);
+  if (ui_scale_ == scale) {
+    return;
+  }
+  ui_scale_ = scale;
+  input_->SetFontList(Font(S(scale, 18), true));
+  RebuildViews();
+}
+void CommandPanelView::BindPreferences(
+    PrefService* prefs,
+    base::RepeatingCallback<float()> scale_provider) {
+  pref_observer_.Init(prefs);
+  SetAppearance(ReadCommandPanelAppearance(prefs));
+  SetUIScale(scale_provider.Run());
+  pref_observer_.Add(
+      kCommandPanelLayoutPref,
+      base::BindRepeating(
+          [](CommandPanelView* view, PrefService* owner) {
+            view->SetAppearance(ReadCommandPanelAppearance(owner));
+          },
+          base::Unretained(this), prefs));
+  pref_observer_.Add(kChromeUIScalePref,
+                     base::BindRepeating(
+                         [](CommandPanelView* view,
+                            base::RepeatingCallback<float()> provider) {
+                           view->SetUIScale(provider.Run());
+                         },
+                         base::Unretained(this), scale_provider));
+}
