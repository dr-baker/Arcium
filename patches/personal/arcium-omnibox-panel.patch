+    if (panel_->appearance_.connected) {
+      canvas->ClipPath(contour, true);
+    }
+    canvas->Scale(panel_->ui_scale_, panel_->ui_scale_);
+    panel_->PaintScope(canvas, scope_,
+                       base::ClampRound(width() / panel_->ui_scale_),
+                       base::ClampRound(height() / panel_->ui_scale_));
+  }
