+    case CommandActionKind::kChooseSpace:
+      return Glyph::kMove;
+    case CommandActionKind::kCloseLiveTab:
+      return Glyph::kClose;
+    case CommandActionKind::kReturnHome:
+      return Glyph::kHome;
+  }
+}
