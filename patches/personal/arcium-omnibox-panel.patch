+#include "ui/views/widget/widget.h"
+
+#if BUILDFLAG(ENABLE_EXTENSIONS_CORE)
+#include "chrome/browser/extensions/test_extension_system.h"
+#include "extensions/browser/extension_system.h"
+#endif
+
+namespace {
+constexpr int kActionModifier =
+    BUILDFLAG(IS_MAC) ? ui::EF_COMMAND_DOWN : ui::EF_CONTROL_DOWN;
+}
+
+class ArciumNativePanelTest : public TestWithBrowserView {
+ protected:
+  void SetUp() override {
+    TestWithBrowserView::SetUp();
+#if BUILDFLAG(ENABLE_EXTENSIONS_CORE)
+    static_cast<extensions::TestExtensionSystem*>(
+        extensions::ExtensionSystem::Get(browser()->profile()))
+        ->Init();
+#endif
+    AddTab(browser(), GURL("https://origin.test/"));
+    browser_view()->GetWidget()->Show();
+  }
+  void TearDown() override {
+    views::ViewTracker tracker(panel());
+    auto widget = panel() ? panel()->GetWidget()->GetWeakPtr()
+                          : base::WeakPtr<views::Widget>();
+    TestWithBrowserView::TearDown();
+    EXPECT_FALSE(tracker.view());
+    EXPECT_FALSE(widget);
+    base::RunLoop().RunUntilIdle();
+    EXPECT_FALSE(tracker.view());
+    EXPECT_FALSE(widget);
+  }
+  arcium::CommandPanelView* panel() {
+    return browser_view()->command_panel_for_testing();
+  }
+  void Key(ui::KeyboardCode key, int flags = 0) {
+    ui::KeyEvent event(ui::EventType::kKeyPressed, key, flags);
+    panel()->HandleKeyEvent(panel()->input_for_testing(), event);
+    views::test::RunScheduledLayout(panel());
+  }
+  void Query(const std::u16string& text) {
+    panel()->input_for_testing()->SetText(text);
+    panel()->ContentsChanged(panel()->input_for_testing(), text);
+    views::test::RunScheduledLayout(panel());
+  }
+  void Close() {
+    auto* widget = panel()->GetWidget();
+    views::test::WidgetDestroyedWaiter destroyed(widget);
+    browser_view()->CloseArciumCommandBar();
+    destroyed.Wait();
+    // The native window closes before its owner drains the posted cleanup.
+    base::RunLoop().RunUntilIdle();
+  }
+};
+TEST_F(ArciumNativePanelTest,
+       InvocationOwnsOneWindowAndDoesNotCreateOrNavigateTabs) {
+  auto* location = browser_view()->GetLocationBar();
+  const auto count = browser()->tab_strip_model()->count();
+  auto* active = browser()->tab_strip_model()->GetActiveWebContents();
+  chrome::ExecuteCommand(browser(), IDC_NEW_TAB);
+  ASSERT_TRUE(panel());
+  EXPECT_TRUE(browser_view()->IsArciumCommandBarNewTab());
+  EXPECT_EQ(browser_view()->GetLocationBar(), location);
+  EXPECT_EQ(count, browser()->tab_strip_model()->count());
+  EXPECT_EQ(active, browser()->tab_strip_model()->GetActiveWebContents());
+  EXPECT_EQ(panel()->GetWidget(), panel()->input_for_testing()->GetWidget());
+  EXPECT_EQ(7u, panel()->row_count_for_testing());
+  EXPECT_EQ(0u, panel()->action_resolutions_for_testing());
+  Key(ui::VKEY_RETURN);
+  EXPECT_EQ(count, browser()->tab_strip_model()->count());
+  EXPECT_EQ(active, browser()->tab_strip_model()->GetActiveWebContents());
+  Close();
+  EXPECT_EQ(nullptr, panel());
+}
+TEST_F(ArciumNativePanelTest, FixtureCorpusHas211PinsAndBoundedSearch) {
+  ASSERT_TRUE(browser_view()->ShowArciumCommandBar(true));
+  size_t pins = 0;
+  const auto& index = panel()->corpus_for_testing();
+  for (size_t i = 0; i < index.size(); ++i) {
+    if (index.Get(index.Ref(i))->kind == arcium::CommandKind::kPin) {
+      ++pins;
+    }
+  }
+  EXPECT_EQ(211u, pins);
+  Query(u"reference");
+  EXPECT_LE(panel()->row_count_for_testing(), 9u);
+  EXPECT_EQ(0u, panel()->action_resolutions_for_testing());
+  Close();
+}
+TEST_F(ArciumNativePanelTest,
+       ActionsAreLazyAndRestoreCurrentInvocationAfterFiltering) {
+  ASSERT_TRUE(browser_view()->ShowArciumCommandBar(false));
+  const std::u16string query(panel()->input_for_testing()->GetText());
+  const auto count = panel()->row_count_for_testing();
+  Key(ui::VKEY_K, kActionModifier);
+  EXPECT_TRUE(panel()->actions_visible_for_testing());
+  EXPECT_EQ(5u, panel()->row_count_for_testing());
+  EXPECT_EQ(1u, panel()->action_resolutions_for_testing());
+  Query(u"pin");
+  EXPECT_EQ(1u, panel()->action_resolutions_for_testing());
+  Key(ui::VKEY_ESCAPE);
+  EXPECT_FALSE(panel()->actions_visible_for_testing());
+  EXPECT_EQ(query, panel()->input_for_testing()->GetText());
+  EXPECT_EQ(count, panel()->row_count_for_testing());
+  Close();
+}
+TEST_F(ArciumNativePanelTest, ScopeKeyboardModeWrapsAndKeepsInputFocus) {
+  ASSERT_TRUE(browser_view()->ShowArciumCommandBar(true));
+  Key(ui::VKEY_UP);
+  EXPECT_TRUE(panel()->scopes_focused_for_testing());
+  Key(ui::VKEY_LEFT);
+  Key(ui::VKEY_RIGHT);
+  Key(ui::VKEY_DOWN);
+  EXPECT_FALSE(panel()->scopes_focused_for_testing());
+  EXPECT_EQ(7u, panel()->row_count_for_testing());
+  EXPECT_EQ(panel()->input_for_testing(),
+            panel()->GetFocusManager()->GetFocusedView());
+  Close();
+}
+TEST_F(ArciumNativePanelTest,
+       NarrowPanelKeepsInputAndResultsInsideTheSameWidget) {
+  ASSERT_TRUE(browser_view()->ShowArciumCommandBar(true));
+  auto* widget = panel()->GetWidget();
+  for (int width : {400, 824, 540}) {
+    auto bounds = widget->GetWindowBoundsInScreen();
+    bounds.set_width(width);
+    widget->SetBounds(bounds);
+    views::test::RunScheduledLayout(panel());
+    EXPECT_TRUE(panel()->GetLocalBounds().Contains(
+        panel()->input_for_testing()->bounds()));
+    EXPECT_GE(panel()->input_for_testing()->height(),
+              panel()->input_for_testing()->GetFontList().GetHeight());
+    EXPECT_FALSE(panel()->GetContourPath().isEmpty());
+    EXPECT_EQ(7u, panel()->row_count_for_testing());
+  }
+  Close();
+}
+TEST_F(ArciumNativePanelTest, RepeatedOpenCloseAndReuseHaveNoDanglingPanel) {
+  for (int i = 0; i < 12; ++i) {
+    ASSERT_TRUE(browser_view()->ShowArciumCommandBar(true));
+    auto* widget = panel()->GetWidget();
+    ASSERT_TRUE(browser_view()->ShowArciumCommandBar(false));
+    EXPECT_EQ(widget, panel()->GetWidget());
+    EXPECT_FALSE(panel()->input_for_testing()->GetText().empty());
+    ASSERT_TRUE(browser_view()->ShowArciumCommandBar(true));
+    EXPECT_TRUE(panel()->input_for_testing()->GetText().empty());
+    Close();
+    EXPECT_EQ(nullptr, panel());
+  }
+}
+
+TEST_F(ArciumNativePanelTest, QueuedDismissalPreservesTheLatestInvocation) {
+  for (bool new_tab : {false, true}) {
+    ASSERT_TRUE(browser_view()->ShowArciumCommandBar(true));
+    views::ViewTracker old_panel(panel());
+    views::test::WidgetDestroyedWaiter destroyed(panel()->GetWidget());
+    browser_view()->CloseArciumCommandBar();
+    ASSERT_TRUE(browser_view()->ShowArciumCommandBar(!new_tab));
+    ASSERT_TRUE(browser_view()->ShowArciumCommandBar(new_tab));
+    destroyed.Wait();
+    base::RunLoop().RunUntilIdle();
+    EXPECT_FALSE(old_panel.view());
+    ASSERT_TRUE(panel());
+    EXPECT_EQ(new_tab, browser_view()->IsArciumCommandBarNewTab());
+    EXPECT_EQ(new_tab, panel()->input_for_testing()->GetText().empty());
+    Close();
+  }
+}
+
+TEST_F(ArciumNativePanelTest, DismissalCanCancelAPendingInvocation) {
+  ASSERT_TRUE(browser_view()->ShowArciumCommandBar(true));
+  views::test::WidgetDestroyedWaiter destroyed(panel()->GetWidget());
+  browser_view()->CloseArciumCommandBar();
+  ASSERT_TRUE(browser_view()->ShowArciumCommandBar(false));
+  browser_view()->CloseArciumCommandBar();
+  destroyed.Wait();
+  base::RunLoop().RunUntilIdle();
+  EXPECT_EQ(nullptr, panel());
+}
+
+TEST_F(ArciumNativePanelTest, RepeatedQueryAndActionsKeepTheResultListBounded) {
+  ASSERT_TRUE(browser_view()->ShowArciumCommandBar(true));
+  const auto storage = panel()->corpus_for_testing().EstimateOwnedBytes();
+  for (int i = 0; i < 200; ++i) {
+    Query(i % 2 ? u"reference" : u"interface");
+    EXPECT_LE(panel()->row_count_for_testing(), 9u);
+    Query(u"");
+    Key(ui::VKEY_DOWN);
+    Key(ui::VKEY_DOWN);
+    Key(ui::VKEY_K, kActionModifier);
+    ASSERT_TRUE(panel()->actions_visible_for_testing());
+    EXPECT_LE(panel()->row_count_for_testing(), 5u);
+    Key(ui::VKEY_ESCAPE);
+    EXPECT_EQ(storage, panel()->corpus_for_testing().EstimateOwnedBytes());
+  }
+  Close();
+}
+
+TEST_F(ArciumNativePanelTest, ParentTeardownDestroysAnOpenPanel) {
+  ASSERT_TRUE(browser_view()->ShowArciumCommandBar(true));
+  ASSERT_TRUE(panel());
+}
+
+TEST_F(ArciumNativePanelTest, ParentTeardownWithQueuedDismissalLeavesNoPanel) {
+  ASSERT_TRUE(browser_view()->ShowArciumCommandBar(true));
+  browser_view()->CloseArciumCommandBar();
+  ASSERT_TRUE(browser_view()->ShowArciumCommandBar(false));
+  ASSERT_TRUE(panel());
+}
