+void Favicon(gfx::Canvas* canvas, CommandIcon icon, gfx::Rect bounds) {
+  if (icon == CommandIcon::kFigma) {
+    gfx::ScopedCanvas restore(canvas);
+    canvas->Translate(gfx::Vector2d(bounds.x() + 5, bounds.y() + 5));
+    canvas->Scale(17.0f / 24, 17.0f / 24);
+    for (const auto [rect, color] :
+         std::array<std::pair<gfx::Rect, SkColor>, 5>{
+             {{gfx::Rect(5, 2, 7, 7), SkColorSetRGB(243, 108, 83)},
+              {gfx::Rect(12, 2, 7, 7), SkColorSetRGB(255, 147, 130)},
+              {gfx::Rect(5, 9, 7, 7), SkColorSetRGB(183, 124, 246)},
+              {gfx::Rect(12, 9, 7, 7), SkColorSetRGB(55, 188, 245)},
+              {gfx::Rect(5, 16, 7, 7), SkColorSetRGB(42, 200, 151)}}}) {
+      FillRoundRect(canvas, rect, 3.5f, color);
+    }
+    return;
+  }
+  if (icon == CommandIcon::kYouTube) {
+    FillRoundRect(canvas, bounds, 5, SkColorSetRGB(246, 246, 241));
+    GlyphAt(canvas, Glyph::kPlay,
+            gfx::Rect(bounds.x() + 5, bounds.y() + 5, 17, 17),
+            SkColorSetRGB(236, 23, 53));
+    return;
+  }
+  if (icon == CommandIcon::kStudio) {
+    FillRoundRect(canvas, bounds, 5, SkColorSetRGB(80, 93, 193));
+    cc::PaintFlags flags;
+    flags.setAntiAlias(true);
+    flags.setColor(SK_ColorWHITE);
+    flags.setStrokeWidth(1.7f);
+    flags.setStrokeCap(cc::PaintFlags::kRound_Cap);
+    for (int i = 0; i < 5; ++i) {
+      const int heights[] = {6, 13, 18, 11, 6};
+      canvas->DrawLine(gfx::Point(bounds.x() + 6 + i * 4,
+                                  bounds.CenterPoint().y() - heights[i] / 2),
+                       gfx::Point(bounds.x() + 6 + i * 4,
+                                  bounds.CenterPoint().y() + heights[i] / 2),
+                       flags);
+    }
+    return;
+  }
+  const Glyph glyph = icon == CommandIcon::kSearch ? Glyph::kSearch
+                      : icon == CommandIcon::kX    ? Glyph::kX
+                      : icon == CommandIcon::kChat ? Glyph::kChat
+                                                   : Glyph::kGlobe;
+  if (icon != CommandIcon::kSearch) {
+    FillRoundRect(canvas, bounds, 5, Alpha(SkColorSetRGB(184, 203, 220), 16));
+  }
+  GlyphAt(canvas, glyph, gfx::Rect(bounds.x() + 5, bounds.y() + 5, 17, 17),
+          SkColorSetRGB(184, 203, 220));
+}
