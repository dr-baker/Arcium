+void CommandPanelView::ContentsChanged(views::Textfield*,
+                                       const std::u16string&) {
+  if (updating_) {
+    return;
+  }
+  current_context_ = false;
+  scope_browsing_ = false;
+  scope_hovered_ = false;
+  scope_animation_.Hide();
+  selected_ = 0;
+  preview_feedback_.clear();
+  RebuildResults();
+}
+std::u16string CommandPanelView::Verb(const DisplayRow& row) const {
+  if (row.action) {
+    return ActionVerb(*row.action);
+  }
+  const auto& data = row.Data(FixtureIndex());
+  if (data.kind == CommandKind::kSuggestion) {
+    return data.scope == SearchScope::kEverything ? u"Search"
+           : data.scope == SearchScope::kWeb      ? u"Search web"
+           : data.scope == SearchScope::kYouTube  ? u"Search YouTube"
+           : data.scope == SearchScope::kX        ? u"Search X"
+                                                  : u"Ask ChatGPT";
+  }
+  if (data.kind == CommandKind::kPin && !data.live) {
+    return u"Restore pin";
+  }
+  if (data.kind == CommandKind::kCurrentTab) {
+    return u"Return to tab";
+  }
+  if (Existing(data.kind)) {
+    return u"Switch to tab";
+  }
+  if (data.kind == CommandKind::kVideo) {
+    return u"Open video";
+  }
+  if (data.kind == CommandKind::kPost) {
+    return u"Open post";
+  }
+  if (data.kind == CommandKind::kConversation) {
+    return u"Open conversation";
+  }
+  return u"Open website";
+}
+void CommandPanelView::RebuildResults() {
+  rows_.clear();
+  const std::u16string query(current_context_ && !actions_visible_
+                                 ? std::u16string_view{}
+                                 : input_->GetText());
+  if (actions_visible_) {
+    const auto normalized = base::i18n::FoldCase(query);
+    for (const auto& action : actions_) {
+      const std::u16string title = ActionTitle(action.kind);
+      if (!normalized.empty() && base::i18n::FoldCase(title).find(normalized) ==
+                                     std::u16string::npos) {
+        continue;
+      }
+      DisplayRow row;
+      row.action = action.kind;
+      row.synthetic.title = title;
+      row.synthetic.context =
+          u"Fixture action · " + FixtureIndex().Get(action.target)->title;
+      row.synthetic.scope = SearchScope::kSaved;
+      rows_.push_back(std::move(row));
+    }
+  } else {
+    const auto raw_url = base::UTF16ToUTF8(query);
+    const bool bare_host =
+        raw_url.find('.') != std::string::npos &&
+        raw_url.find_first_of(" \t\r\n") == std::string::npos;
+    const GURL url =
+        bare_host ? url_formatter::FixupURL(raw_url, "") : GURL(raw_url);
+    const bool direct =
+        !query.empty() && url.is_valid() && url.SchemeIsHTTPOrHTTPS();
+    if (direct) {
+      DisplayRow row;
+      row.synthetic.title = query;
+      row.synthetic.url = base::UTF8ToUTF16(url.spec());
+      row.synthetic.category = u"Website";
+      row.synthetic.context = u"Direct navigation";
+      row.synthetic.scope = SearchScope::kWeb;
+      rows_.push_back(std::move(row));
+    } else {
+      if (current_context_ && scope_ == SearchScope::kEverything) {
+        DisplayRow current;
+        current.record = FixtureIndex().Ref(kCurrentFixture);
+        rows_.push_back(std::move(current));
+      } else if (scope_ != SearchScope::kSaved &&
+                 (!query.empty() || scope_ != SearchScope::kEverything)) {
+        DisplayRow suggestion;
+        suggestion.synthetic.title =
+            query.empty() ? kScopeDescriptions[static_cast<size_t>(scope_)]
+                          : query;
+        suggestion.synthetic.kind = CommandKind::kSuggestion;
+        suggestion.synthetic.icon =
+            scope_ == SearchScope::kYouTube   ? CommandIcon::kYouTube
+            : scope_ == SearchScope::kX       ? CommandIcon::kX
+            : scope_ == SearchScope::kChatGPT ? CommandIcon::kChat
+                                              : CommandIcon::kSearch;
+        suggestion.synthetic.scope = scope_;
+        suggestion.synthetic.category =
+            scope_ == SearchScope::kWeb       ? u"Web search"
+            : scope_ == SearchScope::kYouTube ? u"YouTube search"
+            : scope_ == SearchScope::kX       ? u"X search"
+            : scope_ == SearchScope::kChatGPT ? u"ChatGPT prompt"
+                                              : u"Search";
+        rows_.push_back(std::move(suggestion));
+      }
+      for (const auto& match : FixtureIndex().Search(query, scope_)) {
+        const auto* record = FixtureIndex().Get(match.record);
+        if (scope_ == SearchScope::kEverything &&
+            (record->kind == CommandKind::kPost ||
+             record->kind == CommandKind::kConversation) &&
+            query.empty()) {
+          continue;
+        }
+        if ((!query.empty() || scope_ != SearchScope::kEverything) &&
+            record->kind == CommandKind::kSuggestion) {
+          continue;
+        }
+        if (current_context_ &&
+            record->title == FixtureIndex()
+                                 .Get(FixtureIndex().Ref(kCurrentFixture))
+                                 ->title) {
+          continue;
+        }
+        if (record->kind == CommandKind::kCurrentTab) {
+          continue;
+        }
+        DisplayRow row;
+        row.record = match.record;
+        rows_.push_back(std::move(row));
+      }
+    }
+  }
+  selected_ = rows_.empty() ? -1
+                            : std::clamp(selected_, 0,
+                                         static_cast<int>(rows_.size()) - 1);
+  RebuildViews();
+}
+void CommandPanelView::RebuildViews() {
+  input_->GetViewAccessibility().ClearActiveDescendant();
+  row_views_.clear();
+  back_button_ = nullptr;
+  results_view_->RemoveAllChildViews();
+  if (actions_visible_) {
+    back_button_ =
+        results_view_->AddChildView(std::make_unique<BackButton>(this));
+  }
+  for (size_t i = 0; i < rows_.size(); ++i) {
+    auto* row = results_view_->AddChildView(std::make_unique<Row>(this, i));
+    const auto& data = rows_[i].Data(FixtureIndex());
+    row->GetViewAccessibility().SetName(data.title + u", " + data.category +
+                                        u", " + data.context + u", " +
+                                        Verb(rows_[i]));
+    row_views_.push_back(row);
+  }
+  selection_initialized_ = false;
+  input_->SetPlaceholderText(
+      actions_visible_                     ? u"Find an action…"
+      : scope_ == SearchScope::kEverything ? u"Search or enter URL…"
+      : scope_ == SearchScope::kSaved
+          ? u"Search pins and favorites or enter URL…"
+      : scope_ == SearchScope::kWeb     ? u"Search the web or enter URL…"
+      : scope_ == SearchScope::kYouTube ? u"Search YouTube or enter URL…"
+      : scope_ == SearchScope::kX       ? u"Search X or enter URL…"
+                                        : u"Ask ChatGPT or enter URL…");
+  input_->GetViewAccessibility().SetName(
+      actions_visible_ ? u"Find an action"
+                       : kScopeDescriptions[static_cast<size_t>(scope_)]);
+  footer_button_->GetViewAccessibility().SetName(
+      actions_visible_ ? u"Back to results " + ActionShortcut()
+                       : u"Actions " + ActionShortcut());
+  PreferredSizeChanged();
+  InvalidateLayout();
+  if (GetWidget()) {
+    UpdateGeometry();
+  }
+  Select(selected_, false);
+  SchedulePaint();
+}
+gfx::Size CommandPanelView::CalculatePreferredSize(
+    const views::SizeBounds&) const {
+  const int gap =
+      appearance_.labels == CommandPanelAppearance::Labels::kJoined ? 5 : 0;
+  const int results = std::min(
+      440, 11 + (actions_visible_ ? kHeadingHeight : 0) +
+               (rows_.empty() ? kEmptyHeight
+                              : static_cast<int>(rows_.size()) * kRowHeight) +
+               std::max(0, static_cast<int>(rows_.size()) - 1) * gap);
+  return gfx::Size(S(ui_scale_, 760 + 2 * kShadowInset),
+                   S(ui_scale_, kRailReserve + kSearchHeight + results +
+                                    kFooterHeight + kShadowInset));
+}
+gfx::Rect CommandPanelView::BodyBounds() const {
+  return gfx::Rect(S(ui_scale_, kShadowInset), S(ui_scale_, kRailReserve),
+                   width() - S(ui_scale_, 2 * kShadowInset),
+                   height() - S(ui_scale_, kRailReserve + kShadowInset));
+}
+void CommandPanelView::UpdateGeometry() {
+  if (!GetWidget()) {
+    return;
+  }
+  auto bounds = GetWidget()->GetWindowBoundsInScreen();
+  bounds.set_height(GetPreferredSize().height());
+  GetWidget()->SetBounds(bounds);
+  GetWidget()->GetRootView()->DeprecatedLayoutImmediately();
+  if (geometry_changed_) {
+    geometry_changed_.Run();
+  }
+}
+float CommandPanelView::ScopeRise() const {
+  if (actions_visible_) {
+    return 0;
+  }
+  const float base =
+      appearance_.reveal == CommandPanelAppearance::Reveal::kTabs    ? 32
+      : appearance_.reveal == CommandPanelAppearance::Reveal::kIcons ? 20
+                                                                     : 12;
+  return base + (32 - base) * scope_animation_.GetCurrentValue();
+}
+void CommandPanelView::Layout(PassKey) {
+  const auto body = BodyBounds();
+  const int input_inset = 50;
+  input_->SetBounds(body.x() + S(ui_scale_, input_inset),
+                    body.y() + S(ui_scale_, 18),
+                    std::max(1, body.width() - S(ui_scale_, input_inset + 20)),
+                    S(ui_scale_, 26));
+  const int heading = actions_visible_ ? kHeadingHeight : 0;
+  const int gap =
+      appearance_.labels == CommandPanelAppearance::Labels::kJoined ? 5 : 0;
+  const int content_height =
+      S(ui_scale_,
+        heading +
+            (rows_.empty() ? kEmptyHeight
+                           : static_cast<int>(rows_.size()) * kRowHeight) +
+            std::max(0, static_cast<int>(rows_.size()) - 1) * gap);
+  scroll_->SetBounds(
+      body.x() + S(ui_scale_, 8), body.y() + S(ui_scale_, kSearchHeight + 7),
+      body.width() - S(ui_scale_, 16),
+      body.height() - S(ui_scale_, kSearchHeight + 11 + kFooterHeight));
+  results_view_->SetBounds(0, 0, scroll_->width(), content_height);
+  for (size_t i = 0; i < row_views_.size(); ++i) {
+    row_views_[i]->SetBounds(0, S(ui_scale_, heading + i * (kRowHeight + gap)),
+                             results_view_->width(), S(ui_scale_, kRowHeight));
+  }
+  if (back_button_) {
+    back_button_->SetBounds(S(ui_scale_, 10), S(ui_scale_, 8), S(ui_scale_, 28),
+                            S(ui_scale_, 28));
+  }
+  const int footer_control = S(ui_scale_, FooterControlWidth(actions_visible_));
+  footer_button_->SetBounds(body.right() - S(ui_scale_, 19) - footer_control,
+                            body.bottom() - S(ui_scale_, 42), footer_control,
+                            S(ui_scale_, 42));
+  const bool reveal_label =
+      scope_browsing_ || scope_hovered_ ||
+      appearance_.reveal == CommandPanelAppearance::Reveal::kTabs;
+  const int selected_extra =
+      reveal_label
+          ? gfx::GetStringWidth(kScopeNames[static_cast<size_t>(scope_)],
+                                Font(11, true)) +
+                7
+          : 0;
+  const float span = body.width() / ui_scale_ - 48 - 5 * 8;
+  const float item = appearance_.full_width ? (span - selected_extra) / 6 : 38;
+  float x = body.x() / ui_scale_ + 24;
+  const int top = body.y() - base::ClampRound(ScopeRise() * ui_scale_);
+  const int idle_height =
+      appearance_.reveal == CommandPanelAppearance::Reveal::kTabs    ? 42
+      : appearance_.reveal == CommandPanelAppearance::Reveal::kIcons ? 32
+                                                                     : 12;
+  const int scope_height = base::ClampRound(
+      idle_height + (42 - idle_height) * scope_animation_.GetCurrentValue());
+  for (size_t i = 0; i < scope_buttons_.size(); ++i) {
+    const int button_width = base::ClampRound(
+        ui_scale_ * (item + (kScopes[i] == scope_ ? selected_extra : 0)));
+    scope_buttons_[i]->SetVisible(!actions_visible_);
+    scope_buttons_[i]->SetBounds(base::ClampRound(x * ui_scale_), top,
+                                 button_width, S(ui_scale_, scope_height));
+    scope_buttons_[i]->GetViewAccessibility().SetIsSelected(kScopes[i] ==
+                                                            scope_);
+    x += button_width / ui_scale_ + 8;
+  }
+  if (!selection_initialized_ && selected_ >= 0 && !row_views_.empty()) {
+    selection_y_ = row_views_[selected_]->y();
+    previous_selection_y_ = selection_y_;
+    selection_animation_.Reset(1);
+    selection_initialized_ = true;
+  }
+}
+SkPath CommandPanelView::GetContourPath() const {
+  const auto b = BodyBounds();
+  const float radius = 13 * ui_scale_, left = b.x() + .5f,
+              right = b.right() - .5f;
+  const float top = b.y() + .5f, bottom = b.bottom() - .5f;
+  SkPathBuilder path;
+  path.moveTo(left + radius, top);
+  if (appearance_.connected && !actions_visible_) {
+    for (const auto& button : scope_buttons_) {
+      const float x = button->x(), y = button->y(),
+                  end = button->bounds().right();
+      if (y >= top - 1) {
+        continue;
+      }
+      const float shoulder = std::min(4 * ui_scale_, (top - y) * .3f);
+      const float cap = std::min(
+          {radius, (button->width() - 4 * ui_scale_) / 2, top - y - shoulder});
+      path.lineTo(x - shoulder, top)
+          .quadTo(x, top, x, top - shoulder)
+          .lineTo(x, y + cap)
+          .quadTo(x, y, x + cap, y)
+          .lineTo(end - cap, y)
+          .quadTo(end, y, end, y + cap)
+          .lineTo(end, top - shoulder)
+          .quadTo(end, top, end + shoulder, top);
+    }
+  }
+  path.lineTo(right - radius, top)
+      .quadTo(right, top, right, top + radius)
+      .lineTo(right, bottom - radius)
+      .quadTo(right, bottom, right - radius, bottom)
+      .lineTo(left + radius, bottom)
+      .quadTo(left, bottom, left, bottom - radius)
+      .lineTo(left, top + radius)
+      .quadTo(left, top, left + radius, top)
+      .close();
+  return path.detach();
+}
+void CommandPanelView::OnPaint(gfx::Canvas* canvas) {
+  const auto body = BodyBounds();
+  cc::PaintFlags fill;
+  fill.setAntiAlias(true);
+  fill.setColor(kPanel);
+  if (!native_material_) {
+    canvas->DrawPath(GetContourPath(), fill);
+  }
+  cc::PaintFlags edge;
+  edge.setAntiAlias(true);
+  edge.setColor(Alpha(SK_ColorWHITE, 54));
+  edge.setStyle(cc::PaintFlags::kStroke_Style);
+  edge.setStrokeWidth(ui_scale_);
+  canvas->DrawPath(GetContourPath(), edge);
+  canvas->FillRect(gfx::Rect(body.x() + S(ui_scale_, 10),
+                             body.y() + S(ui_scale_, kSearchHeight - 1),
+                             body.width() - S(ui_scale_, 20), S(ui_scale_, 1)),
+                   Alpha(SK_ColorWHITE, 21));
+  GlyphAt(canvas, Glyph::kSearch,
+          gfx::Rect(body.x() + S(ui_scale_, 20), body.y() + S(ui_scale_, 20),
+                    S(ui_scale_, 18), S(ui_scale_, 18)),
+          kText);
+  canvas->FillRect(
+      gfx::Rect(body.x() + S(ui_scale_, 10), body.bottom() - S(ui_scale_, 42),
+                body.width() - S(ui_scale_, 20), S(ui_scale_, 1)),
+      Alpha(SK_ColorWHITE, 11));
+  {
+    gfx::ScopedCanvas restore(canvas);
+    canvas->Translate(gfx::Vector2d(body.x() + S(ui_scale_, 19),
+                                    body.bottom() - S(ui_scale_, 42)));
+    canvas->Scale(ui_scale_, ui_scale_);
+    PaintFooter(canvas, base::ClampRound(body.width() / ui_scale_) - 38, 42);
+  }
+  if (actions_visible_) {
+    const int y = scroll_->y();
+    FillRoundRect(
+        canvas,
+        gfx::Rect(scroll_->x() + S(ui_scale_, 10), y + S(ui_scale_, 8),
+                  S(ui_scale_, 28), S(ui_scale_, 28)),
+        S(ui_scale_, 5), Alpha(SK_ColorWHITE, 9));
+    GlyphAt(canvas, Glyph::kBack,
+            gfx::Rect(scroll_->x() + S(ui_scale_, 15), y + S(ui_scale_, 13),
+                      S(ui_scale_, 18), S(ui_scale_, 18)),
+            kText);
+    canvas->DrawStringRect(
+        u"Actions · " + FixtureIndex().Get(action_target_)->title,
+        Font(S(ui_scale_, 12), true), kText,
+        gfx::Rect(scroll_->x() + S(ui_scale_, 50), y + S(ui_scale_, 8),
+                  scroll_->width() - S(ui_scale_, 60), S(ui_scale_, 28)));
+    canvas->FillRect(
+        gfx::Rect(scroll_->x(), y + S(ui_scale_, kHeadingHeight - 7),
+                  scroll_->width(), S(ui_scale_, 1)),
+        Alpha(SK_ColorWHITE, 11));
+  }
+  if (rows_.empty()) {
+    auto empty_bounds = scroll_->bounds();
+    empty_bounds.Inset(
+        gfx::Insets::TLBR(S(ui_scale_, actions_visible_ ? kHeadingHeight : 0),
+                          S(ui_scale_, 15), 0, S(ui_scale_, 15)));
+    canvas->DrawStringRect(actions_visible_ ? u"No matching actions"
+                           : scope_ == SearchScope::kSaved
+                               ? u"No matching pins or favorites"
+                               : u"No matching results",
+                           Font(S(ui_scale_, 14)), kMuted, empty_bounds);
+  }
+}
+void CommandPanelView::PaintRow(gfx::Canvas* canvas,
+                                size_t index,
+                                int width,
+                                int height) {
+  const auto& row = rows_[index];
+  const auto& data = row.Data(FixtureIndex());
+  const bool selected =
+      static_cast<int>(index) == selected_ && !scope_browsing_;
+  const bool joined =
+      appearance_.labels == CommandPanelAppearance::Labels::kJoined;
+  if (joined) {
+    cc::PaintFlags border;
+    border.setAntiAlias(true);
+    border.setStyle(cc::PaintFlags::kStroke_Style);
+    border.setColor(Alpha(SK_ColorWHITE, selected ? 77 : 35));
+    border.setStrokeWidth(1);
+    canvas->DrawRoundRect(gfx::Rect(0, 0, width, height), 7, border);
+  }
+  int x = joined ? 8 : 10;
+  if (!row.action) {
+    if (appearance_.activity_dots) {
+      cc::PaintFlags marker;
+      marker.setAntiAlias(true);
+      marker.setColor(selected ? SkColorSetRGB(228, 243, 233)
+                               : SkColorSetRGB(170, 205, 188));
+      const gfx::PointF center(x + 5, height / 2.0f);
+      if (data.kind == CommandKind::kPin) {
+        marker.setStyle(cc::PaintFlags::kStroke_Style);
+        marker.setStrokeWidth(1);
+        canvas->DrawCircle(center, 4.5f, marker);
+      }
+      if (data.live) {
+        marker.setStyle(cc::PaintFlags::kFill_Style);
+        canvas->DrawCircle(center, data.kind == CommandKind::kPin ? 2 : 3,
+                           marker);
+      }
+      x += 14;
+    }
+    const int favicon_size = joined ? 24 : 27;
+    if (data.icon == CommandIcon::kSearch && data.scope == SearchScope::kWeb) {
+      DrawDuckDuckGo(canvas, gfx::Rect(x + 5, (height - 17) / 2, 17, 17));
+    } else {
+      Favicon(canvas, data.icon,
+              gfx::Rect(x, (height - favicon_size) / 2, favicon_size,
+                        favicon_size));
+    }
+    x += favicon_size + (joined ? 10 : 12);
+  } else {
+    x = 12;
+  }
+  const int cue_width = joined ? 28 : 24;
+  const std::u16string verb = selected && width >= 330 ? Verb(row) : u"";
+  const int verb_width =
+      verb.empty() ? 0 : gfx::GetStringWidth(verb, Font(12, true)) + 9;
+  const int cue_x = width - (joined ? 0 : 10) - cue_width;
+  const int right = cue_x - verb_width;
+  const int category_gap = joined ? 20 : 10;
+  const auto category_font = joined ? Font(11) : Font(10, true);
+  const int category_width =
+      row.action
+          ? 0
+          : std::min(
+                gfx::GetStringWidth(data.category, category_font) +
+                    (appearance_.labels == CommandPanelAppearance::Labels::kPill
+                         ? 12
+                         : 0),
+                std::max(0, (right - x) * 46 / 100));
+  const int available = std::max(
+      1, right - x - category_width - (category_width ? category_gap : 0));
+  const int title_width =
+      std::min(gfx::GetStringWidth(data.title, Font(14, true)), available);
+  canvas->DrawStringRect(data.title, Font(14, true), kText,
+                         gfx::Rect(x, 0, title_width, height));
+  if (category_width) {
+    const int label_x = x + title_width + category_gap;
+    if (appearance_.labels == CommandPanelAppearance::Labels::kPill) {
+      FillRoundRect(canvas,
+                    gfx::Rect(label_x, (height - 18) / 2, category_width, 18),
+                    4, Alpha(SK_ColorWHITE, selected ? 10 : 4));
+    }
+    if (joined) {
+      canvas->FillRect(gfx::Rect(label_x - 10, (height - 13) / 2, 1, 13),
+                       Alpha(SK_ColorWHITE, 46));
+    }
+    canvas->DrawStringRect(
+        data.category, category_font,
+        selected ? SkColorSetRGB(214, 227, 224) : kMuted,
+        gfx::Rect(label_x + (appearance_.labels ==
+                                     CommandPanelAppearance::Labels::kPill
+                                 ? 6
+                                 : 0),
+                  0, category_width, height));
+  }
+  if (!verb.empty()) {
+    canvas->DrawStringRect(
+        verb, Font(12, true), kText,
+        gfx::Rect(cue_x - verb_width, 0, verb_width - 9, height));
+  }
+  const SkColor tint = kScopeTints[static_cast<size_t>(data.scope)];
+  SkColor cue_color =
+      selected ? SkColorSetRGB(225, 232, 229) : SkColorSetRGB(160, 170, 167);
+  if (appearance_.scope_tints) {
+    cue_color = Mix(tint, cue_color);
+  }
+  if (!appearance_.scope_tints && !joined) {
+    FillRoundRect(canvas, gfx::Rect(cue_x, (height - 23) / 2, cue_width, 23), 4,
+                  Alpha(selected ? SkColorSetRGB(237, 243, 239) : SK_ColorWHITE,
+                        selected ? 255 : 10));
+  }
+  if (row.action) {
+    GlyphAt(canvas, ActionGlyph(*row.action),
+            gfx::Rect(cue_x + (cue_width - 17) / 2, (height - 17) / 2, 17, 17),
+            cue_color);
+  } else if (appearance_.icons == CommandPanelAppearance::Icons::kReturn) {
+    if (selected) {
+      canvas->DrawStringRect(u"↵", Font(18), cue_color,
+                             gfx::Rect(cue_x, 0, cue_width, height));
+    }
+  } else if (appearance_.icons == CommandPanelAppearance::Icons::kArrows) {
+    canvas->DrawStringRect(selected ? u"↵" : u"→", Font(18), cue_color,
+                           gfx::Rect(cue_x, 0, cue_width, height));
+  } else {
+    Glyph glyph = Existing(data.kind) ? Glyph::kSwitch : Glyph::kGo;
+    if (appearance_.icons == CommandPanelAppearance::Icons::kActions) {
+      glyph = data.kind == CommandKind::kSuggestion          ? Glyph::kSearch
+              : data.kind == CommandKind::kVideo             ? Glyph::kPlay
+              : data.kind == CommandKind::kPin && !data.live ? Glyph::kRestore
+                                                             : glyph;
+    }
+    GlyphAt(canvas, glyph,
+            gfx::Rect(cue_x + (cue_width - 17) / 2, (height - 17) / 2, 17, 17),
+            cue_color);
+  }
+}
+void CommandPanelView::PaintScope(gfx::Canvas* canvas,
+                                  SearchScope scope,
+                                  int width,
+                                  int height) {
+  const bool selected = scope == scope_;
+  const bool reveal =
+      scope_browsing_ || scope_hovered_ ||
+      appearance_.reveal == CommandPanelAppearance::Reveal::kTabs;
+  if (!appearance_.connected) {
+    FillRoundRect(canvas, gfx::Rect(0, 0, width, height), 13, kPanel);
+  }
+  if (appearance_.scope_tints) {
+    cc::PaintFlags glow;
+    if (scope == SearchScope::kEverything) {
+      constexpr std::array<float, 3> centers = {.5f, .88f, .12f};
+      constexpr std::array<SkColor, 3> colors = {SkColorSetRGB(132, 189, 165),
+                                                 SkColorSetRGB(133, 170, 207),
+                                                 SkColorSetRGB(181, 158, 205)};
+      for (size_t i = 0; i < colors.size(); ++i) {
+        const float fade = i == 0 ? .9f : .85f;
+        auto matrix = SkMatrix::Scale(width * (i == 0 ? .6f : .65f) * fade,
+                                      height * fade);
+        matrix.postTranslate(width * centers[i], 0);
+        const SkColor4f stops[] = {
+            SkColor4f::FromColor(Alpha(colors[i], selected ? 21 : 14)),
+            SkColors::kTransparent};
+        glow.setShader(cc::PaintShader::MakeRadialGradient(
+            {0, 0}, 1, stops, nullptr, 2, SkTileMode::kClamp,
+            SkGradient::Interpolation{}, 0, &matrix));
+        canvas->DrawRect(gfx::Rect(0, 0, width, height), glow);
+      }
+    } else {
+      const auto tint = kScopeTints[static_cast<size_t>(scope)];
+      const SkPoint points[] = {{0, 0}, {0, static_cast<float>(height)}};
+      const SkScalar positions[] = {0, .7f, 1};
+      const SkColor4f colors[] = {
+          SkColor4f::FromColor(Alpha(tint, selected ? 15 : 9)),
+          SkColor4f::FromColor(Alpha(tint, selected ? 8 : 5)),
+          SkColors::kTransparent};
+      glow.setShader(cc::PaintShader::MakeLinearGradient(
+          points, colors, positions, 3, SkTileMode::kClamp));
+      canvas->DrawRect(gfx::Rect(0, 0, width, height), glow);
+    }
+  }
+  const bool edge = appearance_.reveal == CommandPanelAppearance::Reveal::kEdge;
+  const float progress = scope_animation_.GetCurrentValue();
+  const float opacity = edge ? progress : 1;
+  if (opacity <= 0) {
+    return;
+  }
+  const int label =
+      selected && reveal
+          ? gfx::GetStringWidth(kScopeNames[static_cast<size_t>(scope)],
+                                Font(11, true)) +
+                7
+          : 0;
+  const int x = (width - 16 - label) / 2;
+  const Glyph glyph = scope == SearchScope::kEverything ? Glyph::kOmni
+                      : scope == SearchScope::kWeb      ? Glyph::kGlobe
+                      : scope == SearchScope::kSaved    ? Glyph::kPin
+                      : scope == SearchScope::kYouTube  ? Glyph::kVideo
+                      : scope == SearchScope::kX        ? Glyph::kX
+                                                        : Glyph::kChat;
+  const auto color =
+      selected ? SkColorSetRGB(228, 238, 232) : SkColorSetRGB(131, 148, 141);
+  const int idle_padding =
+      appearance_.reveal == CommandPanelAppearance::Reveal::kTabs    ? 8
+      : appearance_.reveal == CommandPanelAppearance::Reveal::kIcons ? 2
+                                                                     : 0;
+  const int icon_y =
+      base::ClampRound(idle_padding + (8 - idle_padding) * progress);
+  canvas->SaveLayerAlpha(base::ClampRound(opacity * 255),
+                         gfx::Rect(0, 0, width, height));
+  if (scope == SearchScope::kWeb) {
+    DrawDuckDuckGo(canvas, gfx::Rect(x, icon_y, 16, 16));
+  } else {
+    GlyphAt(canvas, glyph, gfx::Rect(x, icon_y, 16, 16), color);
+  }
+  if (label) {
+    canvas->DrawStringRect(kScopeNames[static_cast<size_t>(scope)],
+                           Font(11, true), color,
+                           gfx::Rect(x + 23, icon_y, label, 16));
+  }
+  canvas->Restore();
+}
+void CommandPanelView::PaintFooter(gfx::Canvas* canvas, int width, int height) {
+  std::u16string hint;
+  if (!preview_feedback_.empty()) {
+    hint = preview_feedback_;
+  } else if (scope_browsing_) {
+    hint = u"← → scope  ↓ results  ↵ ";
+    hint +=
+        !input_->GetText().empty() && !current_context_ ? u"search" : u"type";
+  } else {
+    if (selected_ == 0 && !actions_visible_) {
+      hint = u"↑ scopes · ";
+    }
+    hint += u"↑ ↓ choose ↵ ";
+    hint += selected_ >= 0     ? base::i18n::ToLower(Verb(rows_[selected_]))
+            : actions_visible_ ? u"choose an action"
+                               : u"no matches";
+  }
+  canvas->DrawStringRect(
+      hint, Font(11), kMuted,
+      gfx::Rect(0, 0,
+                std::max(1, width - FooterControlWidth(actions_visible_) - 15),
+                height));
+}
+void CommandPanelView::Select(int index, bool animate) {
+  if (rows_.empty()) {
+    index = -1;
+  } else {
+    index = std::clamp(index, 0, static_cast<int>(rows_.size()) - 1);
+  }
+
+  previous_selection_y_ =
+      previous_selection_y_ + (selection_y_ - previous_selection_y_) *
+                                  selection_animation_.GetCurrentValue();
+  selected_ = index;
+  if (index >= 0 && index < static_cast<int>(row_views_.size())) {
+    selection_y_ = row_views_[index]->y();
+  }
+  selection_animation_.Reset(
+      animate && gfx::Animation::ShouldRenderRichAnimation() ? 0 : 1);
+  if (animate && gfx::Animation::ShouldRenderRichAnimation()) {
+    selection_animation_.Show();
+  }
+  for (size_t i = 0; i < row_views_.size(); ++i) {
+    row_views_[i]->GetViewAccessibility().SetIsSelected(
+        static_cast<int>(i) == selected_ && !scope_browsing_);
+    row_views_[i]->SchedulePaint();
+  }
+  if (selected_ < 0) {
+    input_->GetViewAccessibility().ClearActiveDescendant();
+  }
+  if (selected_ >= 0 && !scope_browsing_) {
+    input_->GetViewAccessibility().SetActiveDescendant(*row_views_[selected_]);
+    row_views_[selected_]->ScrollRectToVisible(
+        row_views_[selected_]->GetLocalBounds());
+  }
+  results_view_->SchedulePaint();
+  footer_button_->SchedulePaint();
+  SchedulePaint();
+}
+void CommandPanelView::BrowseScopes(bool enabled) {
+  scope_browsing_ = enabled;
+  if (enabled) {
+    input_->GetViewAccessibility().SetActiveDescendant(
+        *scope_buttons_[static_cast<size_t>(scope_)]);
+  }
+  if (enabled || scope_hovered_) {
+    scope_animation_.Show();
+  } else {
+    scope_animation_.Hide();
+  }
+  Select(selected_ < 0 ? 0 : selected_, false);
+  AnimationProgressed(&scope_animation_);
+}
+void CommandPanelView::HoverScopes(bool enabled) {
+  scope_hovered_ = enabled;
+  scope_hide_timer_.Stop();
+  if (enabled || scope_browsing_) {
+    scope_animation_.Show();
+  } else {
+    scope_hide_timer_.Start(
+        FROM_HERE, base::Milliseconds(100),
+        base::BindOnce(
+            [](CommandPanelView* view) {
+              if (!view->scope_hovered_ && !view->scope_browsing_) {
+                view->scope_animation_.Hide();
+              }
+            },
+            base::Unretained(this)));
+  }
+}
+void CommandPanelView::ChooseScope(SearchScope scope) {
+  scope_ = scope;
+  selected_ = 0;
+  current_context_ = false;
+  RebuildResults();
+  FocusInput();
+}
+void CommandPanelView::ShowActions(bool enabled) {
+  if (enabled == actions_visible_) {
+    return;
+  }
+  updating_ = true;
+  if (enabled) {
+    saved_context_ = current_context_;
+    saved_scopes_ = scope_browsing_;
+    saved_query_ = input_->GetText();
+    saved_selection_ = input_->GetSelectedRange();
+    saved_row_ = selected_;
+    action_target_ = FixtureIndex().Ref(kCurrentFixture);
+    if (selected_ >= 0 && rows_[selected_].record &&
+        Existing(rows_[selected_].Data(FixtureIndex()).kind)) {
+      action_target_ = *rows_[selected_].record;
+    }
+    // Fixture capabilities are explicit. The real owner will resolve/revalidate
+    // them later; this phase performs no profile actions or navigation.
+    actions_ = ResolveCommandActions(FixtureIndex(), action_target_,
+                                     {true, true, true, true, true});
+    ++action_resolutions_;
+    actions_visible_ = true;
+    scope_browsing_ = false;
+    input_->SetText(u"");
+    selected_ = 0;
+  } else {
+    actions_visible_ = false;
+    actions_.clear();
+    input_->SetText(saved_query_);
+    current_context_ = saved_context_;
+    scope_browsing_ = saved_scopes_;
+    input_->SetSelectedRange(saved_selection_);
+    selected_ = saved_row_;
+  }
+  updating_ = false;
+  preview_feedback_.clear();
+  RebuildResults();
+  FocusInput();
+}
+void CommandPanelView::Activate(int index) {
+  if (index < 0 || index >= static_cast<int>(rows_.size())) {
+    return;
+  }
+  Select(index, false);
+  preview_feedback_ = u"Preview · " + Verb(rows_[index]);
+  GetViewAccessibility().SetDescription(preview_feedback_);
+  footer_button_->SchedulePaint();
+  FocusInput();
+}
+bool CommandPanelView::HandleKeyEvent(views::Textfield*,
+                                      const ui::KeyEvent& event) {
+  if (event.type() != ui::EventType::kKeyPressed) {
+    return false;
+  }
+  const auto code = event.key_code();
+  if ((event.IsCommandDown() || event.IsControlDown()) && code == ui::VKEY_K) {
+    ShowActions(!actions_visible_);
+    return true;
+  }
+  if ((event.IsCommandDown() || event.IsControlDown()) &&
+      (code == ui::VKEY_T || code == ui::VKEY_L)) {
+    reopen_.Run(code == ui::VKEY_T);
+    return true;
+  }
+  if (code == ui::VKEY_ESCAPE) {
+    if (scope_browsing_) {
+      BrowseScopes(false);
+    } else if (actions_visible_) {
+      ShowActions(false);
+    } else {
+      dismiss_.Run();
+    }
+    return true;
+  }
+  if (scope_browsing_) {
+    if (code == ui::VKEY_LEFT || code == ui::VKEY_RIGHT) {
+      const int current = static_cast<int>(scope_);
+      ChooseScope(kScopes[(current + (code == ui::VKEY_RIGHT ? 1 : 5)) % 6]);
+      return true;
+    }
+    if (code == ui::VKEY_DOWN || code == ui::VKEY_RETURN ||
+        code == ui::VKEY_TAB) {
+      BrowseScopes(false);
+      Select(0, false);
+      return true;
+    }
+    if (code == ui::VKEY_UP) {
+      return true;
+    }
+  }
+  if (code == ui::VKEY_UP && selected_ <= 0 && !actions_visible_) {
+    BrowseScopes(true);
+    return true;
+  }
+  if (code == ui::VKEY_DOWN || code == ui::VKEY_UP) {
+    Select(selected_ + (code == ui::VKEY_DOWN ? 1 : -1), true);
+    return true;
+  }
+  if (code == ui::VKEY_RETURN) {
+    Activate(selected_);
+    return true;
+  }
+  return false;
+}
+bool CommandPanelView::OnMousePressed(const ui::MouseEvent& event) {
+  if (!GetContourPath().contains(event.x(), event.y())) {
+    dismiss_.Run();
+    return true;
+  }
+  return false;
+}
+void CommandPanelView::AnimationProgressed(const gfx::Animation* animation) {
+  if (animation == &scope_animation_) {
+    InvalidateLayout();
+    if (GetWidget()) {
+      GetWidget()->GetRootView()->DeprecatedLayoutImmediately();
+    }
+    if (geometry_changed_) {
+      geometry_changed_.Run();
+    }
+    for (const auto& button : scope_buttons_) {
+      button->SchedulePaint();
+    }
+  }
+  results_view_->SchedulePaint();
+  SchedulePaint();
+}
+void CommandPanelView::AnimationEnded(const gfx::Animation* animation) {
+  AnimationProgressed(animation);
+}
