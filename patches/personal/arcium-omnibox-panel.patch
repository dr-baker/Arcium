+const CommandRecord& CommandPanelView::DisplayRow::Data(
+    const CommandSearchIndex& index) const {
+  if (record) {
+    const auto* value = index.Get(*record);
+    CHECK(value);
+    return *value;
+  }
+  return synthetic;
