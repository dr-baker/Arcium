+void GlyphAt(gfx::Canvas* canvas,
+             Glyph glyph,
+             const gfx::Rect& rect,
+             SkColor color) {
+  gfx::ScopedCanvas restore(canvas);
+  canvas->Translate(gfx::Vector2d(rect.x(), rect.y()));
+  canvas->Scale(rect.width() / 24.0f, rect.height() / 24.0f);
+  cc::PaintFlags flags;
+  flags.setAntiAlias(true);
+  flags.setColor(color);
+  flags.setStyle(cc::PaintFlags::kStroke_Style);
+  flags.setStrokeWidth(1.6f);
+  flags.setStrokeCap(cc::PaintFlags::kRound_Cap);
+  flags.setStrokeJoin(cc::PaintFlags::kRound_Join);
+  SkPathBuilder path;
+  switch (glyph) {
+    case Glyph::kSearch:
+      canvas->DrawCircle(gfx::PointF(10, 10), 6, flags);
+      path.moveTo(15, 15).lineTo(20, 20);
+      break;
+    case Glyph::kGlobe:
+      canvas->DrawCircle(gfx::PointF(12, 12), 9, flags);
+      path.moveTo(3, 12)
+          .lineTo(21, 12)
+          .moveTo(12, 3)
+          .cubicTo(18, 8, 18, 16, 12, 21)
+          .cubicTo(6, 16, 6, 8, 12, 3);
+      break;
+    case Glyph::kOmni:
+      path.moveTo(10, 6)
+          .lineTo(12.3f, 11.7f)
+          .lineTo(18, 14)
+          .lineTo(12.3f, 16.3f)
+          .lineTo(10, 22)
+          .lineTo(7.7f, 16.3f)
+          .lineTo(2, 14)
+          .lineTo(7.7f, 11.7f)
+          .close()
+          .moveTo(20, 2)
+          .lineTo(20.8f, 4.2f)
+          .lineTo(23, 5)
+          .lineTo(20.8f, 5.8f)
+          .lineTo(20, 8)
+          .lineTo(19.2f, 5.8f)
+          .lineTo(17, 5)
+          .lineTo(19.2f, 4.2f)
+          .close();
+      break;
+    case Glyph::kPin:
+      path.moveTo(9, 3)
+          .lineTo(15, 3)
+          .lineTo(14, 9)
+          .lineTo(18, 12)
+          .lineTo(6, 12)
+          .lineTo(10, 9)
+          .close()
+          .moveTo(12, 12)
+          .lineTo(12, 21);
+      break;
+    case Glyph::kStar:
+      path.moveTo(12, 3)
+          .lineTo(14.7f, 8.8f)
+          .lineTo(21, 9.6f)
+          .lineTo(16.4f, 14.1f)
+          .lineTo(17.5f, 20.4f)
+          .lineTo(12, 17.4f)
+          .lineTo(6.5f, 20.4f)
+          .lineTo(7.6f, 14.1f)
+          .lineTo(3, 9.6f)
+          .lineTo(9.3f, 8.8f)
+          .close();
+      break;
+    case Glyph::kVideo:
+      canvas->DrawRoundRect(gfx::Rect(3, 5, 18, 14), 4, flags);
+      path.moveTo(10, 9).lineTo(15, 12).lineTo(10, 15).close();
+      break;
+    case Glyph::kX:
+      path.moveTo(5, 3)
+          .lineTo(9, 3)
+          .lineTo(19, 21)
+          .lineTo(15, 21)
+          .close()
+          .moveTo(19, 3)
+          .lineTo(5, 21);
+      break;
+    case Glyph::kChat:
+      path.moveTo(4, 5)
+          .lineTo(20, 5)
+          .lineTo(20, 17)
+          .lineTo(9, 17)
+          .lineTo(4, 21)
+          .close()
+          .moveTo(12, 7)
+          .lineTo(12.9f, 9.1f)
+          .lineTo(15, 10)
+          .lineTo(12.9f, 10.9f)
+          .lineTo(12, 13)
+          .lineTo(11.1f, 10.9f)
+          .lineTo(9, 10)
+          .lineTo(11.1f, 9.1f)
+          .close();
+      break;
+    case Glyph::kGo:
+      path.moveTo(6, 18).lineTo(18, 6).moveTo(6, 6).lineTo(18, 6).lineTo(18,
+                                                                         18);
+      break;
+    case Glyph::kSwitch:
+      path.moveTo(10, 4)
+          .lineTo(4, 4)
+          .lineTo(4, 20)
+          .lineTo(10, 20)
+          .moveTo(21, 12)
+          .lineTo(9, 12)
+          .moveTo(14, 7)
+          .lineTo(9, 12)
+          .lineTo(14, 17);
+      break;
+    case Glyph::kMove:
+      path.moveTo(4, 6)
+          .lineTo(10, 6)
+          .moveTo(4, 12)
+          .lineTo(13, 12)
+          .moveTo(4, 18)
+          .lineTo(10, 18)
+          .moveTo(15, 7)
+          .lineTo(20, 12)
+          .lineTo(15, 17)
+          .moveTo(13, 12)
+          .lineTo(20, 12);
+      break;
+    case Glyph::kClose:
+      path.moveTo(7, 7).lineTo(17, 17).moveTo(17, 7).lineTo(7, 17);
+      break;
+    case Glyph::kHome:
+      path.moveTo(4, 11)
+          .lineTo(12, 4)
+          .lineTo(20, 11)
+          .moveTo(6, 10)
+          .lineTo(6, 20)
+          .lineTo(18, 20)
+          .lineTo(18, 10)
+          .moveTo(10, 20)
+          .lineTo(10, 14)
+          .lineTo(14, 14)
+          .lineTo(14, 20);
+      break;
+    case Glyph::kBack:
+      path.moveTo(18, 12).lineTo(6, 12).lineTo(12, 6).moveTo(6, 12).lineTo(12,
+                                                                           18);
+      break;
+    case Glyph::kRestore:
+      path.moveTo(3, 10)
+          .cubicTo(4, 0, 21, 0, 21, 12)
+          .cubicTo(21, 21, 8, 25, 5, 18)
+          .moveTo(3, 4)
+          .lineTo(3, 10)
+          .lineTo(9, 10)
+          .moveTo(12, 7)
+          .lineTo(12, 12)
+          .lineTo(15, 14);
+      break;
+    case Glyph::kPlay:
+      path.moveTo(9, 7).lineTo(17, 12).lineTo(9, 17).close();
+      flags.setStyle(cc::PaintFlags::kFill_Style);
+      break;
+  }
+  canvas->DrawPath(path.detach(), flags);
+}
