+#include "chrome/browser/ui/views/frame/browser_view.h"
+#include "chrome/browser/ui/views/helium/arcium_chrome_ui_scale.h"
+#include "chrome/browser/ui/views/omnibox/arcium_command_bar_material.h"
+#include "chrome/browser/ui/views/omnibox/arcium_command_panel.h"
+#include "ui/color/color_provider_key.h"
+#include "ui/views/widget/widget.h"
+#include "ui/views/widget/widget_delegate.h"
+
+bool BrowserView::ShowArciumNativeCommandPanel(bool new_tab) {
+  if (!browser_->is_type_normal() || !toolbar_ || !GetWidget() ||
+      GetWidget()->IsClosed() || !GetActiveWebContents()) {
+    return false;
+  }
+  if (arcium_command_bar_widget_) {
+    if (arcium_command_bar_closing_) {
+      // The current widget is already closing. Keep only the latest invocation
+      // and reopen after the owner has destroyed that widget and its delegate.
+      arcium_pending_command_invocation_ = new_tab;
+    } else if (arcium_native_command_panel_) {
+      arcium_command_bar_new_tab_ = new_tab;
+      arcium_native_command_panel_->SetInvocation(new_tab);
+      arcium_command_bar_widget_->Activate();
+    }
+    return true;
+  }
+  auto panel = std::make_unique<arcium::CommandPanelView>(
+      base::BindRepeating(&BrowserView::CloseArciumCommandBar,
+                          weak_ptr_factory_.GetWeakPtr(), false),
+      base::BindRepeating(
+          [](base::WeakPtr<BrowserView> view, bool invocation) {
+            if (view) {
+              view->ShowArciumCommandBar(invocation);
+            }
+          },
+          weak_ptr_factory_.GetWeakPtr()));
+  arcium_native_command_panel_ = panel.get();
+  auto* profile = browser_->profile()->GetOriginalProfile();
+  panel->BindPreferences(
+      profile->GetPrefs(),
+      base::BindRepeating(
+          [](Profile* owner) {
+            return static_cast<float>(arcium::GetChromeUIScale(owner));
+          },
+          base::Unretained(profile)));
+  panel->SetInvocation(new_tab);
+  const double scale = arcium::GetChromeUIScale(profile);
+  const auto parent = GetBoundsInScreen();
+  const int width = std::max(
+      280, std::min(base::ClampRound(824 * scale), parent.width() - 32));
+  const int height = panel->GetPreferredSize().height();
+  const auto bounds = gfx::Rect(
+      parent.CenterPoint().x() - width / 2,
+      parent.y() +
+          std::max(16, base::ClampRound(parent.height() * .11 - 48 * scale)),
+      width, height);
+  auto delegate = std::make_unique<views::WidgetDelegate>();
+  delegate->SetCanActivate(true);
+  delegate->SetContentsView(std::move(panel));
+  delegate->RegisterWindowClosingCallback(base::BindOnce(
+      [](base::WeakPtr<BrowserView> view) {
+        if (!view) {
+          return;
+        }
+        view->arcium_command_bar_closing_ = true;
+        base::SingleThreadTaskRunner::GetCurrentDefault()->PostTask(
+            FROM_HERE,
+            base::BindOnce(&BrowserView::DestroyArciumCommandBar, view, true));
+      },
+      weak_ptr_factory_.GetWeakPtr()));
+  arcium_native_command_delegate_ = std::move(delegate);
+  arcium_command_bar_new_tab_ = new_tab;
+  arcium_command_bar_accepted_ = false;
+  arcium_command_bar_closing_ = false;
+  auto widget = std::make_unique<views::Widget>();
+  views::Widget::InitParams params(
+      views::Widget::InitParams::CLIENT_OWNS_WIDGET,
+      views::Widget::InitParams::TYPE_WINDOW_FRAMELESS);
+  params.opacity = views::Widget::InitParams::WindowOpacity::kTranslucent;
+  params.parent = GetWidget()->GetNativeView();
+  params.bounds = bounds;
+  params.delegate = arcium_native_command_delegate_.get();
+  widget->Init(std::move(params));
+  widget->SetColorModeOverride(ui::ColorProviderKey::ColorMode::kDark);
+  arcium_command_bar_widget_ = std::move(widget);
+  arcium_command_bar_widget_->AddObserver(this);
+  arcium_command_bar_widget_->GetRootView()->DeprecatedLayoutImmediately();
+  arcium_command_bar_material_ = std::make_unique<arcium::CommandBarMaterial>(
+      arcium_command_bar_widget_.get(), profile->GetPrefs(),
+      base::BindRepeating(
+          [](base::WeakPtr<BrowserView> view) {
+            arcium::CommandBarMaterial::Clip clip;
+            if (view && view->arcium_native_command_panel_) {
+              clip.contour =
+                  view->arcium_native_command_panel_->GetContourPath();
+            }
+            return clip;
+          },
+          weak_ptr_factory_.GetWeakPtr()),
+      base::BindRepeating(
+          [](base::WeakPtr<BrowserView> view, bool enabled) {
+            if (view && view->arcium_native_command_panel_) {
+              view->arcium_native_command_panel_->SetNativeMaterial(enabled);
+            }
+          },
+          weak_ptr_factory_.GetWeakPtr()));
+  arcium_native_command_panel_->SetGeometryChangedCallback(base::BindRepeating(
+      [](base::WeakPtr<BrowserView> view) {
+        if (view && view->arcium_command_bar_material_) {
+          view->arcium_command_bar_material_->Refresh();
+        }
+      },
+      weak_ptr_factory_.GetWeakPtr()));
+  arcium_command_bar_material_->Refresh();
+  arcium_command_bar_widget_->Show();
+  arcium_native_command_panel_->FocusInput();
+  return true;
+}
