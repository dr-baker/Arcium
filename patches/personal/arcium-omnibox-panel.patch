+const std::u16string& ActionShortcut() {
+#if BUILDFLAG(IS_MAC)
+  constexpr int modifier = ui::EF_COMMAND_DOWN;
+#else
+  constexpr int modifier = ui::EF_CONTROL_DOWN;
+#endif
+  static const base::NoDestructor<std::u16string> shortcut(
+      ui::Accelerator(ui::VKEY_K, modifier).GetShortcutText());
+  return *shortcut;
+}
+
+std::u16string FooterLabel(bool actions) {
+  return actions ? u"Back to results" : u"Actions";
+}
+int ShortcutWidth() {
+  return std::max(29, gfx::GetStringWidth(ActionShortcut(), Font(11)) + 10);
+}
+int FooterControlWidth(bool actions) {
+  return gfx::GetStringWidth(FooterLabel(actions), Font(11)) + 8 +
+         ShortcutWidth();
+}
+void PaintFooterControl(gfx::Canvas* canvas,
+                        bool actions,
+                        int width,
+                        int height) {
+  const int chip = ShortcutWidth();
+  canvas->DrawStringRect(FooterLabel(actions), Font(11),
+                         SkColorSetRGB(185, 194, 188),
+                         gfx::Rect(0, 0, width - chip - 8, height));
+  cc::PaintFlags edge;
+  edge.setColor(Alpha(SK_ColorWHITE, 32));
+  edge.setStyle(cc::PaintFlags::kStroke_Style);
+  edge.setStrokeWidth(1);
+  canvas->DrawRoundRect(gfx::Rect(width - chip, (height - 19) / 2, chip, 19), 4,
+                        edge);
+  canvas->DrawStringRect(ActionShortcut(), Font(11), kMuted,
+                         gfx::Rect(width - chip + 5, 0, chip - 10, height));
+}
