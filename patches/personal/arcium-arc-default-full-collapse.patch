+TEST(ArciumShortcutPresetsTest, ArcPresetSelectsFullCollapseAndRestoresOriginal) {
+  TestingPrefServiceSimple pref_service;
+  RegisterPrefs(&pref_service);
+  UseVerticalSidebar(&pref_service);
+  BrowserShortcutService service(&pref_service);
+  EXPECT_EQ(ApplyArcShortcutPreset(&service), PresetResult::kApplied);
+  EXPECT_EQ(pref_service.GetInteger(::arcium::kCollapsedSidebarStylePref),
+            ::arcium::kCollapsedSidebarStyleFullyHidden);
+  EXPECT_EQ(service.FindCommandForAccelerator("Meta+KeyS"),
+            IDC_TOGGLE_VERTICAL_TABS_COLLAPSE);
+  EXPECT_NE(service.FindCommandForAccelerator("Meta+KeyS"), IDC_SAVE_PAGE);
+  EXPECT_EQ(service.FindCommandForAccelerator("Meta+Shift+KeyS"), IDC_SAVE_PAGE);
+  // A later explicit choice remains authoritative; shortcut edits do not reset it.
+  pref_service.SetInteger(::arcium::kCollapsedSidebarStylePref,
+                         ::arcium::kCollapsedSidebarStyleIconRail);
+  service.ResetAcceleratorsForCommand(IDC_NEW_TAB);
+  EXPECT_EQ(pref_service.GetInteger(::arcium::kCollapsedSidebarStylePref),
+            ::arcium::kCollapsedSidebarStyleIconRail);
+  EXPECT_EQ(ApplyArcShortcutPreset(&service), PresetResult::kApplied);
+  EXPECT_EQ(RestorePreviousArcShortcutConfiguration(&service),
+            PresetResult::kApplied);
+  EXPECT_EQ(pref_service.GetInteger(::arcium::kCollapsedSidebarStylePref),
+            ::arcium::kCollapsedSidebarStyleIconRail);
+  EXPECT_EQ(pref_service.GetUserPrefValue(::arcium::kCollapsedSidebarStylePref),
+            nullptr);
+}
+
+TEST(ArciumShortcutPresetsTest, ManagedCollapseRejectsArcPresetWithoutChanges) {
+  TestingPrefServiceSimple pref_service;
+  RegisterPrefs(&pref_service);
+  BrowserShortcutService service(&pref_service);
+  const auto original = service.GetAcceleratorMap();
+  pref_service.SetManagedPref(::arcium::kCollapsedSidebarStylePref,
+                             base::Value(0));
+  EXPECT_EQ(ApplyArcShortcutPreset(&service), PresetResult::kPreferencesLocked);
+  EXPECT_EQ(service.GetAcceleratorMap(), original);
+  EXPECT_FALSE(service.HasPreviousConfiguration());
+  EXPECT_TRUE(pref_service.GetDict(prefs::kCustomAccelerators).empty());
+}
+
+TEST(ArciumShortcutPresetsTest, InvalidShortcutsDoNotChangeProfilePreferences) {
+  TestingPrefServiceSimple pref_service;
+  RegisterPrefs(&pref_service);
+  BrowserShortcutService service(&pref_service);
+  EXPECT_EQ(service.ApplyConfiguration({{IDC_NEW_TAB, {"invalid binding"}}},
+                {{::arcium::kCollapsedSidebarStylePref, 1}}),
+            ConfigurationResult::kInvalidAccelerator);
+  EXPECT_EQ(pref_service.GetInteger(::arcium::kCollapsedSidebarStylePref), 0);
+  EXPECT_FALSE(service.HasPreviousConfiguration());
+}
+
+TEST(ArciumShortcutPresetsTest, ManagedCollapseBlocksRestoreWithoutConsumingBackup) {
+  TestingPrefServiceSimple pref_service;
+  RegisterPrefs(&pref_service);
+  BrowserShortcutService service(&pref_service);
+  ASSERT_EQ(ApplyArcShortcutPreset(&service), PresetResult::kApplied);
+  const auto configured = service.GetAcceleratorMap();
+  pref_service.SetManagedPref(::arcium::kCollapsedSidebarStylePref,
+                             base::Value(1));
+  EXPECT_EQ(RestorePreviousArcShortcutConfiguration(&service),
+            PresetResult::kPreferencesLocked);
+  EXPECT_EQ(service.GetAcceleratorMap(), configured);
+  EXPECT_TRUE(service.HasPreviousConfiguration());
+}
