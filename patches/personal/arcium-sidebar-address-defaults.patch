--- src.orig/chrome/browser/ui/views/frame/arcium_browser_chrome_unittest.cc
+++ src/chrome/browser/ui/views/frame/arcium_browser_chrome_unittest.cc
@@ -20,6 +20,8 @@
 #include "chrome/browser/ui/views/frame/contents_container_view.h"
 #include "chrome/browser/ui/views/frame/multi_contents_view.h"
 #include "chrome/common/pref_names.h"
+#include "chrome/browser/ui/views/toolbar/toolbar_view.h"
+#include "chrome/browser/ui/views/location_bar/location_bar_view.h"
 #include "components/prefs/pref_service.h"
 #include "ui/views/widget/widget.h"
 
@@ -101,3 +103,32 @@ TEST_F(ArciumBrowserChromeTest, Horizont
   EXPECT_EQ(browser_view()->multi_contents_view()
                 ->GetActiveContentsContainerView()->bounds().y(), 0);
 }
+
+TEST_F(ArciumBrowserChromeTest, SidebarDefaultPreservesExplicitTopBarChoice) {
+  prefs()->ClearPref(arcium::kArcSidebarNavigationEnabledPref);
+  EXPECT_TRUE(prefs()->GetBoolean(arcium::kArcSidebarNavigationEnabledPref));
+  EXPECT_TRUE(browser_view()->IsSidebarNavigationActive());
+  prefs()->SetBoolean(arcium::kArcSidebarNavigationEnabledPref, false);
+  EXPECT_FALSE(browser_view()->IsSidebarNavigationActive());
+}
+
+TEST_F(ArciumBrowserChromeTest, SidebarAddressSurvivesSavedHiddenTopBar) {
+  prefs()->SetBoolean(arcium::kShowToolbarPref, false);
+  prefs()->SetBoolean(arcium::kArcSidebarNavigationEnabledPref, true);
+  Layout();
+  ASSERT_TRUE(browser_view()->IsSidebarNavigationActive());
+  EXPECT_TRUE(browser_view()->IsToolbarVisible());
+  EXPECT_TRUE(browser_view()->toolbar()->GetVisible());
+  EXPECT_TRUE(browser_view()->toolbar()->location_bar_view()->GetVisible());
+  EXPECT_FALSE(prefs()->GetBoolean(arcium::kShowToolbarPref));
+  EXPECT_FALSE(chrome::IsCommandEnabled(browser(), IDC_ARCIUM_TOGGLE_TOOLBAR));
+  EXPECT_EQ(browser_view()->multi_contents_view()
+                ->GetActiveContentsContainerView()->bounds().y(), 12);
+
+  prefs()->SetBoolean(arcium::kArcSidebarNavigationEnabledPref, false);
+  Layout();
+  EXPECT_FALSE(browser_view()->IsSidebarNavigationActive());
+  EXPECT_FALSE(browser_view()->IsToolbarVisible());
+  EXPECT_FALSE(prefs()->GetBoolean(arcium::kShowToolbarPref));
+  EXPECT_TRUE(chrome::IsCommandEnabled(browser(), IDC_ARCIUM_TOGGLE_TOOLBAR));
+}
