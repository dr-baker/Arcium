+IN_PROC_BROWSER_TEST_F(ArciumArcImportBrowserTest,
+                       ImportsFavoritesWithoutSpacesAsDormantPins) {
+  constexpr char kFavoritesOnly[] = R"json({
+    "version":1,"source_profile":"arc-profile","spaces":[],
+    "favorites":[{"type":"tab","source_id":"favorite",
+                  "title":"Favorite","url":"https://favorite.test/"}]
+  })json";
+  auto* service = helium::HeliumSpaceServiceFactory::GetForProfile(
+      browser()->profile());
+  ASSERT_TRUE(service);
+  const std::string local_id = service->GetDefaultSpace()->id();
+  const helium::PersistentNodes local_pins = {
+      Link("local-pin", u"Local", "https://local.test/")};
+  ASSERT_TRUE(service->GetOrCreateSpaceReplacingPins(local_id, u"Local",
+                                                     local_pins));
+  const helium::PersistentNodes other_pins = {
+      Link("other-pin", u"Other", "https://other.test/")};
+  service->ReconcileImportedPersistentItems(
+      "other-arc-profile", {},
+      {{.id = "other-space", .name = u"Other Arc", .pins = other_pins}});
+  const int original_tab_count = browser()->tab_strip_model()->count();
+  const helium::PersistentNodes expected_favorites = {
+      Link("arc:arc-profile:favorite:favorite", u"Favorite",
+           "https://favorite.test/")};
+
+  for (int pass = 0; pass < 2; ++pass) {
+    ASSERT_TRUE(ImportArcSidebarSnapshot(browser()->profile(), kFavoritesOnly,
+                                         ArcSidebarDestination::kPins));
+    EXPECT_EQ(original_tab_count, browser()->tab_strip_model()->count());
+    ASSERT_EQ(3u, service->GetSpaces().size());
+    auto* fallback = service->GetSpaceById("arc:arc-profile:favorites-space");
+    ASSERT_TRUE(fallback);
+    EXPECT_EQ("arc-profile", fallback->source_profile());
+    EXPECT_TRUE(fallback->pins().empty());
+    EXPECT_EQ(expected_favorites, service->GetFavoritesForSpace(*fallback));
+    auto* local = service->GetSpaceById(local_id);
+    ASSERT_TRUE(local);
+    EXPECT_EQ(local_pins, local->pins());
+    EXPECT_TRUE(service->GetFavoritesForSpace(*local).empty());
+    auto* other = service->GetSpaceById("other-space");
+    ASSERT_TRUE(other);
+    EXPECT_EQ("other-arc-profile", other->source_profile());
+    EXPECT_EQ(other_pins, other->pins());
+  }
+}
+
+IN_PROC_BROWSER_TEST_F(ArciumArcImportBrowserTest,
+                       EmptySourceRemovesOnlyItsFavoritesFallback) {
+  constexpr char kFavoritesOnly[] = R"json({
+    "version":1,"source_profile":"arc-profile","spaces":[],
+    "favorites":[{"type":"tab","source_id":"favorite",
+                  "title":"Favorite","url":"https://favorite.test/"}]
+  })json";
+  constexpr char kEmpty[] = R"json({
+    "version":1,"source_profile":"arc-profile","spaces":[],"favorites":[]
+  })json";
+  auto* service = helium::HeliumSpaceServiceFactory::GetForProfile(
+      browser()->profile());
+  ASSERT_TRUE(service);
+  const std::string local_id = service->GetDefaultSpace()->id();
+  const helium::PersistentNodes local_pins = {
+      Link("local-pin", u"Local", "https://local.test/")};
+  ASSERT_TRUE(service->GetOrCreateSpaceReplacingPins(local_id, u"Local",
+                                                     local_pins));
+  ASSERT_TRUE(ImportArcSidebarSnapshot(browser()->profile(), kFavoritesOnly,
+                                       ArcSidebarDestination::kPins));
+  ASSERT_TRUE(service->GetSpaceById("arc:arc-profile:favorites-space"));
+  for (int pass = 0; pass < 2; ++pass) {
+    ASSERT_TRUE(ImportArcSidebarSnapshot(browser()->profile(), kEmpty,
+                                         ArcSidebarDestination::kPins));
+    ASSERT_EQ(1u, service->GetSpaces().size());
+    EXPECT_FALSE(service->GetSpaceById("arc:arc-profile:favorites-space"));
+    auto* local = service->GetSpaceById(local_id);
+    ASSERT_TRUE(local);
+    EXPECT_EQ(local_pins, local->pins());
+    EXPECT_TRUE(service->GetFavoritesForSpace(*local).empty());
+    const auto* favorites = browser()->profile()->GetPrefs()->GetDict(
+        helium::kHeliumArcFavoritesByProfilePref).FindList("arc-profile");
+    ASSERT_TRUE(favorites);
+    EXPECT_TRUE(favorites->empty());
+  }
+}
+
+IN_PROC_BROWSER_TEST_F(ArciumArcImportBrowserTest,
+                       EmptySourcePreservesUnusedStarterIdentity) {
+  constexpr char kEmpty[] = R"json({
+    "version":1,"source_profile":"arc-profile","spaces":[],"favorites":[]
+  })json";
+  auto* service = helium::HeliumSpaceServiceFactory::GetForProfile(
+      browser()->profile());
+  ASSERT_TRUE(service);
+  const std::string starter_id = service->GetDefaultSpace()->id();
+  const int original_tab_count = browser()->tab_strip_model()->count();
+  for (int pass = 0; pass < 2; ++pass) {
+    ASSERT_TRUE(ImportArcSidebarSnapshot(browser()->profile(), kEmpty,
+                                         ArcSidebarDestination::kPins));
+    ASSERT_EQ(1u, service->GetSpaces().size());
+    EXPECT_EQ(starter_id, service->GetDefaultSpace()->id());
+    EXPECT_TRUE(service->GetDefaultSpace()->source_profile().empty());
+    EXPECT_TRUE(service->GetDefaultSpace()->pins().empty());
+    EXPECT_EQ(original_tab_count, browser()->tab_strip_model()->count());
+  }
+}
+
 }  // namespace
 }  // namespace arcium
