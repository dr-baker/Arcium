+namespace {
+AutocompleteMatch NavigationMatch(AutocompleteProvider* provider) {
+  AutocompleteMatch match(provider, 1000, false,
+                          AutocompleteMatchType::URL_WHAT_YOU_TYPED);
+  match.destination_url = GURL("https://accepted.test/");
+  match.fill_into_edit = u"https://accepted.test/";
+  match.contents = match.fill_into_edit;
+  match.contents_class = {{0, ACMatchClassification::URL}};
+  match.transition = ui::PAGE_TRANSITION_TYPED;
+  return match;
+}
+
+scoped_refptr<ShortcutsBackend> PrepareShortcuts(Profile* profile) {
+  ShortcutsBackendFactory::GetInstance()->SetTestingFactoryAndUse(
+      profile, base::BindRepeating(
+                   &ShortcutsBackendFactory::BuildProfileNoDatabaseForTesting));
+  return ShortcutsBackendFactory::GetForProfile(profile);
+}
+}  // namespace
+
+TEST_F(ArciumCommandBarTest, HttpCommitAfterBarDestructionRecordsShortcut) {
+  auto backend = PrepareShortcuts(browser()->profile());
+  ASSERT_TRUE(backend);
+  ASSERT_TRUE(backend->initialized());
+  ASSERT_TRUE(backend->shortcuts_map().empty());
+  ASSERT_TRUE(browser_view()->ShowArciumCommandBar(false));
+  auto* model = floating()->GetOmniboxController();
+  ASSERT_FALSE(model->autocomplete_controller()->providers().empty());
+  auto match = NavigationMatch(
+      model->autocomplete_controller()->providers().front().get());
+  views::test::WidgetDestroyedWaiter destroyed(floating()->GetWidget());
+  model->client()->OnAutocompleteAccept(
+      match.destination_url, nullptr, WindowOpenDisposition::CURRENT_TAB,
+      match.transition, match.type, base::TimeTicks::Now(), false, false,
+      match.fill_into_edit, match, AutocompleteMatch());
+  match = AutocompleteMatch();
+  destroyed.Wait();
+  ASSERT_EQ(browser_view()->GetLocationBarView(),
+            browser_view()->GetLocationBar());
+  auto* contents = browser()->tab_strip_model()->GetActiveWebContents();
+  auto navigation = content::NavigationSimulator::CreateFromPending(
+      contents->GetController());
+  navigation->SetResponseHeaders(base::MakeRefCounted<net::HttpResponseHeaders>(
+      "HTTP/1.1 200 OK\r\n"));
+  navigation->Commit();
+  ASSERT_EQ(1u, backend->shortcuts_map().size());
+  EXPECT_EQ(GURL("https://accepted.test/"),
+            backend->shortcuts_map().begin()->second.match_core.destination_url);
+}
+
+TEST_F(ArciumCommandBarTest, AlternateNavigationSurvivesSourceProviderDestruction) {
+  auto backend = PrepareShortcuts(browser()->profile());
+  ASSERT_TRUE(backend && backend->initialized());
+  auto provider = base::MakeRefCounted<FakeAutocompleteProvider>(
+      AutocompleteProvider::TYPE_HISTORY_URL);
+  auto match = NavigationMatch(provider.get());
+  auto* contents = browser()->tab_strip_model()->GetActiveWebContents();
+  AlternateNavInfoBarDelegate::CreateForOmniboxNavigation(
+      contents, u"accepted", match, GURL("https://search.test/"));
+  // The delayed consumer must copy data without retaining a provider whose
+  // prefetch callbacks can still depend on a destroyed controller client.
+  EXPECT_TRUE(provider->HasOneRef());
+  match = AutocompleteMatch();
+  provider.reset();
+  auto* manager = infobars::ContentInfoBarManager::FromWebContents(contents);
+  ASSERT_EQ(1u, manager->infobars().size());
+  EXPECT_TRUE(manager->infobars().back()->delegate()->LinkClicked(
+      WindowOpenDisposition::CURRENT_TAB));
+  ASSERT_EQ(1u, backend->shortcuts_map().size());
+  EXPECT_EQ(GURL("https://accepted.test/"),
+            backend->shortcuts_map().begin()->second.match_core.destination_url);
+  manager->RemoveAllInfoBars(/*animate=*/false);
+}
+
+TEST_F(ArciumCommandBarTest, AlternateZeroSuggestDoesNotRecordShortcut) {
+  auto backend = PrepareShortcuts(browser()->profile());
+  ASSERT_TRUE(backend && backend->initialized());
+  auto* contents = browser()->tab_strip_model()->GetActiveWebContents();
+  for (bool detached : {false, true}) {
+    auto original = NavigationMatch(nullptr);
+    original.destination_url = GURL("https://search.test/");
+    backend->AddOrUpdateShortcut(u"search", original);
+    ASSERT_EQ(1u, backend->shortcuts_map().size());
+    auto provider = base::MakeRefCounted<FakeAutocompleteProvider>(
+        AutocompleteProvider::TYPE_ZERO_SUGGEST);
+    auto match = NavigationMatch(detached ? nullptr : provider.get());
+    AlternateNavInfoBarDelegate::CreateForOmniboxNavigation(
+        contents, u"accepted", match, original.destination_url, detached);
+    EXPECT_TRUE(provider->HasOneRef());
+    match = AutocompleteMatch();
+    provider.reset();
+    auto* manager = infobars::ContentInfoBarManager::FromWebContents(contents);
+    ASSERT_EQ(1u, manager->infobars().size());
+    EXPECT_TRUE(manager->infobars().back()->delegate()->LinkClicked(
+        WindowOpenDisposition::CURRENT_TAB));
+    EXPECT_TRUE(backend->shortcuts_map().empty());
+    manager->RemoveAllInfoBars(/*animate=*/false);
+  }
+}
+
+TEST_F(ArciumCommandBarTest, HttpZeroSuggestSnapshotDoesNotRecordShortcut) {
+  auto backend = PrepareShortcuts(browser()->profile());
+  ASSERT_TRUE(backend && backend->initialized());
+  ASSERT_TRUE(browser_view()->ShowArciumCommandBar(false));
+  auto provider = base::MakeRefCounted<FakeAutocompleteProvider>(
+      AutocompleteProvider::TYPE_ZERO_SUGGEST);
+  auto match = NavigationMatch(provider.get());
+  match.duplicate_matches.push_back(match);
+  match.associated_keyword = u"accepted";
+  views::test::WidgetDestroyedWaiter destroyed(floating()->GetWidget());
+  floating()->GetOmniboxController()->client()->OnAutocompleteAccept(
+      match.destination_url, nullptr, WindowOpenDisposition::CURRENT_TAB,
+      match.transition, match.type, base::TimeTicks::Now(), false, false,
+      match.fill_into_edit, match, AutocompleteMatch());
+  EXPECT_TRUE(provider->HasOneRef());
+  match = AutocompleteMatch();
+  provider.reset();
+  destroyed.Wait();
+  auto* contents = browser()->tab_strip_model()->GetActiveWebContents();
+  auto navigation = content::NavigationSimulator::CreateFromPending(
+      contents->GetController());
+  navigation->SetResponseHeaders(base::MakeRefCounted<net::HttpResponseHeaders>(
+      "HTTP/1.1 200 OK\r\n"));
+  navigation->Commit();
+  EXPECT_TRUE(backend->shortcuts_map().empty());
+}
