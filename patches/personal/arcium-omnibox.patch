 using bookmarks::BookmarkNode;
 using bookmarks::TitledUrlMatch;
 
+namespace {
+
+bool ArciumItemMatches(const ArciumOmniboxItem& item,
+                       const std::u16string& query) {
+  const std::u16string folded_query = base::i18n::ToLower(query);
+  auto contains = [&folded_query](const std::u16string& value) {
+    return base::i18n::ToLower(value).find(folded_query) !=
+           std::u16string::npos;
+  };
+  if (contains(item.title) || contains(base::UTF8ToUTF16(item.url.spec())) ||
+      contains(item.space_name)) {
+    return true;
+  }
+  return std::ranges::any_of(item.folder_path, contains);
+}
+
+std::u16string ArciumItemDescription(const ArciumOmniboxItem& item) {
+  std::u16string description =
+      item.kind == ArciumOmniboxItem::Kind::kFavorite ? u"Favorite" : u"Pin";
+  if (item.is_active) {
+    description += u" · Active";
+  } else if (!item.is_live) {
+    description += u" · Dormant";
+  }
+  if (!item.space_name.empty()) {
+    description += u" · " + item.space_name;
+  }
+  for (const std::u16string& folder : item.folder_path) {
+    description += u" › " + folder;
+  }
+  return description;
+}
+
+int ArciumItemRelevance(const ArciumOmniboxItem& item) {
+  if (item.kind == ArciumOmniboxItem::Kind::kFavorite) {
+    return 1175;
+  }
+  return item.is_active ? 1160 : item.is_live ? 1125 : 1100;
+}
+
