+class ArciumCommandBarTest : public TestWithBrowserView {
+ protected:
+  void SetUp() override {
+    TestWithBrowserView::SetUp();
+#if BUILDFLAG(ENABLE_EXTENSIONS)
+    static_cast<extensions::TestExtensionSystem*>(
+        extensions::ExtensionSystem::Get(browser()->profile()))->Init();
+#endif
+    AddTab(browser(), GURL("https://origin.test/"));
+    browser_view()->GetWidget()->Show();
+  }
+  LocationBarView* floating() {
+    return static_cast<LocationBarView*>(browser_view()->GetLocationBar());
+  }
+};
+
+#if BUILDFLAG(IS_MAC)
+namespace {
+
+class MouseRecordingWidget : public ThemeCopyingWidget {
+ public:
+  explicit MouseRecordingWidget(views::Widget* role_model)
+      : ThemeCopyingWidget(role_model) {}
+
+  void OnMouseEvent(ui::MouseEvent* event) override {
+    ++mouse_event_count;
+    last_type = event->type();
+    last_location = event->location();
+    last_root_location = event->root_location();
+  }
+
+  int mouse_event_count = 0;
+  ui::EventType last_type = ui::EventType::kUnknown;
+  gfx::Point last_location;
+  gfx::Point last_root_location;
+};
+
+}  // namespace
+
+TEST_F(ArciumCommandBarTest, PopupMouseEventsReachStandaloneParent) {
+  // Model the floating command bar's native parent, which has no BrowserView
+  // association, while keeping the real LocationBar for the popup cutout.
+  ASSERT_TRUE(browser_view()->ShowArciumCommandBar(true));
+  ASSERT_FALSE(BrowserView::GetBrowserViewForNativeWindow(
+      floating()->GetWidget()->GetNativeWindow()));
+  MouseRecordingWidget parent(floating()->GetWidget());
+  views::Widget::InitParams parent_params(
+      views::Widget::InitParams::CLIENT_OWNS_WIDGET,
+      views::Widget::InitParams::TYPE_WINDOW_FRAMELESS);
+  parent_params.parent = browser_view()->GetWidget()->GetNativeView();
+  parent.Init(std::move(parent_params));
+  parent.SetBounds(gfx::Rect(100, 100, 400, 200));
+  ASSERT_FALSE(BrowserView::GetBrowserViewForNativeWindow(
+      parent.GetNativeWindow()));
+
+  ThemeCopyingWidget popup(&parent);
+  views::Widget::InitParams popup_params(
+      views::Widget::InitParams::CLIENT_OWNS_WIDGET,
+      views::Widget::InitParams::TYPE_POPUP);
+  popup_params.parent = parent.GetNativeView();
+  popup_params.context = parent.GetNativeWindow();
+  RoundedOmniboxResultsFrame::OnBeforeWidgetInit(&popup_params, &popup);
+  popup.Init(std::move(popup_params));
+  auto* frame = popup.SetContentsView(
+      std::make_unique<RoundedOmniboxResultsFrame>(
+          new views::View, floating(), /*forward_mouse_events=*/true));
+  popup.SetBounds(gfx::Rect(120, 130, 400, 200));
+  views::test::RunScheduledLayout(&popup);
+  ASSERT_EQ(&parent, popup.parent());
+
+  // Enter and move within the shadow, exercising RootView's event dispatch
+  // through the results frame instead of calling its routing helper directly.
+  for (auto type : {ui::EventType::kMouseEntered, ui::EventType::kMouseMoved}) {
+    const gfx::Point location(1, 1);
+    ASSERT_EQ(frame,
+              popup.GetRootView()->GetEventHandlerForPoint(location));
+    gfx::Point expected = location;
+    views::View::ConvertPointToScreen(popup.GetRootView(), &expected);
+    views::View::ConvertPointFromScreen(parent.GetRootView(), &expected);
+    ui::MouseEvent event(type, location, location, base::TimeTicks::Now(), 0,
+                         0);
+    const int previous_count = parent.mouse_event_count;
+    popup.OnMouseEvent(&event);
+    EXPECT_EQ(previous_count + 1, parent.mouse_event_count);
+    EXPECT_EQ(type, parent.last_type);
+    EXPECT_EQ(expected, parent.last_location);
+    EXPECT_EQ(expected, parent.last_root_location);
+    EXPECT_EQ(location, event.location());
+    EXPECT_EQ(location, event.root_location());
+  }
+}
+
+TEST_F(ArciumCommandBarTest, DetachedPopupFrameDropsMouseEvents) {
+  RoundedOmniboxResultsFrame frame(new views::View,
+                                   browser_view()->GetLocationBar(), true);
+  ui::MouseEvent entered(ui::EventType::kMouseEntered, gfx::Point(1, 1),
+                         gfx::Point(1, 1), base::TimeTicks::Now(), 0, 0);
+  frame.OnMouseEvent(&entered);
+  EXPECT_FALSE(entered.handled());
+  ui::MouseEvent moved(ui::EventType::kMouseMoved, gfx::Point(2, 2),
+                       gfx::Point(2, 2), base::TimeTicks::Now(), 0, 0);
+  frame.OnMouseMoved(moved);
+  EXPECT_FALSE(moved.handled());
+}
