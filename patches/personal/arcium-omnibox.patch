 using bookmarks::BookmarkNode;
 using bookmarks::TitledUrlMatch;
 
+namespace {
+
+constexpr int kArciumMatchWeight = 10;
+constexpr int kMaxArciumUsageCount = 10;
+constexpr int kMaxArciumRecencyScore = 10;
+
+int MatchQuality(const std::u16string& query,
+                 const std::u16string& title,
+                 const std::u16string& url) {
+  const std::u16string folded_query = base::i18n::ToLower(query);
+  const std::u16string folded_title = base::i18n::ToLower(title);
+  const std::u16string folded_url = base::i18n::ToLower(url);
+  if (folded_query == folded_title) {
+    return 60;
+  }
+  if (folded_query == folded_url) {
+    return 55;
+  }
+  if (folded_title.starts_with(folded_query)) {
+    return 40;
+  }
+  if (folded_url.starts_with(folded_query)) {
+    return 35;
+  }
+  if (folded_title.find(folded_query) != std::u16string::npos) {
+    return 20;
+  }
+  if (folded_url.find(folded_query) != std::u16string::npos) {
+    return 15;
+  }
+  return 0;
+}
+
+int MetadataMatchQuality(const ArciumOmniboxItem& item,
+                         const std::u16string& query) {
+  const std::u16string folded_query = base::i18n::ToLower(query);
+  auto contains = [&folded_query](const std::u16string& value) {
+    return base::i18n::ToLower(value).find(folded_query) !=
+           std::u16string::npos;
+  };
+  if (contains(item.space_name)) {
+    return 10;
+  }
+  return std::ranges::any_of(item.folder_path, contains) ? 10 : 0;
+}
+
+std::u16string ArciumItemDescription(const ArciumOmniboxItem& item) {
+  std::u16string description =
+      item.kind == ArciumOmniboxItem::Kind::kFavorite ? u"Favorite" : u"Pin";
+  std::u16string action;
+  if (item.tier == ArciumOmniboxItem::Tier::kOtherSpacePin) {
+    action = u"Switch to " + item.space_name;
+  } else if (item.is_active) {
+    action = u"Current " + description;
+  } else if (item.is_live) {
+    action = u"Switch to " + description;
+  } else {
+    action = item.kind == ArciumOmniboxItem::Kind::kPin ? u"Restore Pin"
+                                                        : u"Open Favorite";
+  }
+  description = item.tier == ArciumOmniboxItem::Tier::kOtherSpacePin
+                    ? action + u" · " + description
+                    : action;
+  description += item.is_active ? u" · Active"
+                 : item.is_live ? u" · Live"
+                                : u" · Dormant";
+  if (item.kind == ArciumOmniboxItem::Kind::kFavorite &&
+      item.space_name.empty()) {
+    description += u" · All Spaces";
+  }
+  if (!item.space_name.empty()) {
+    description += u" · " + item.space_name;
+  }
+  for (const std::u16string& folder : item.folder_path) {
+    description += u" › " + folder;
+  }
+  return description;
+}
+
+std::u16string ArciumCommandDescription(const ArciumOmniboxItem& item) {
+  const bool current_tab_command =
+      item.command == ArciumOmniboxItem::Command::kPinCurrentTab ||
+      item.command == ArciumOmniboxItem::Command::kFavoriteCurrentTab;
+  std::u16string description = item.command_target_title;
+  if (base::TrimWhitespace(description, base::TRIM_ALL).empty()) {
+    description = item.url.is_empty()
+                      ? (current_tab_command ? u"Current tab" : u"Saved tab")
+                      : base::UTF8ToUTF16(item.url.spec());
+  }
+  description += current_tab_command ? u" · Tab"
+                 : item.kind == ArciumOmniboxItem::Kind::kFavorite
+                     ? u" · Favorite"
+                     : u" · Pin";
+  std::u16string scope = item.space_name;
+  if (!current_tab_command && item.kind == ArciumOmniboxItem::Kind::kFavorite) {
+    scope = u"All Spaces";
+  } else if (scope.empty()) {
+    scope = current_tab_command ? u"Current Space" : u"Space";
+  }
+  description += u" · " + scope;
+  for (const std::u16string& folder : item.folder_path) {
+    description += u" › " + folder;
+  }
+  if (!item.target_space_name.empty()) {
+    description += u" → " + item.target_space_name;
+  }
+  return description;
+}
+
+std::u16string ArciumItemDisplayTitle(const ArciumOmniboxItem& item) {
+  if (!base::TrimWhitespace(item.title, base::TRIM_ALL).empty()) {
+    return item.title;
+  }
+  return base::UTF8ToUTF16(item.url.spec());
+}
+
+int ArciumRecencyScore(int64_t internal_value) {
+  if (internal_value == 0) {
+    return 0;
+  }
+  base::TimeDelta age =
+      base::Time::Now() - base::Time::FromInternalValue(internal_value);
+  if (age.is_negative()) {
+    age = base::TimeDelta();
+  }
+  return std::max(0, kMaxArciumRecencyScore - static_cast<int>(age.InDays()));
+}
+
+int ArciumItemRelevance(const ArciumOmniboxItem& item, int match_quality) {
+  int relevance = 2000;
+  switch (item.tier) {
+    case ArciumOmniboxItem::Tier::kActiveSpacePin:
+      relevance = 4000;
+      break;
+    case ArciumOmniboxItem::Tier::kFavorite:
+      relevance = 3000;
+      break;
+    case ArciumOmniboxItem::Tier::kOtherSpacePin:
+      break;
+  }
+  relevance += match_quality * kArciumMatchWeight;
+  relevance += std::clamp(item.use_count, 0, kMaxArciumUsageCount) * 2;
+  relevance += ArciumRecencyScore(item.last_used_internal_value);
+  return relevance;
+}
+
