+#include "ui/events/event.h"
+#include "ui/views/test/widget_test.h"
+
+class ArciumCommandBarTest : public TestWithBrowserView {
+ protected:
+  void SetUp() override {
+    TestWithBrowserView::SetUp();
+    AddTab(browser(), GURL("https://origin.test/"));
+    browser_view()->GetWidget()->Show();
+  }
+  LocationBarView* floating() {
+    return static_cast<LocationBarView*>(browser_view()->GetLocationBar());
+  }
+};
+
+TEST_F(ArciumCommandBarTest, NewTabCommandDefersCreationAndEscapeCancels) {
+  const int count = browser()->tab_strip_model()->count();
+  auto* contents = browser()->tab_strip_model()->GetActiveWebContents();
+  auto* toolbar = browser_view()->GetLocationBarView();
+  chrome::ExecuteCommand(browser(), IDC_NEW_TAB);
+  ASSERT_TRUE(browser_view()->IsArciumCommandBarNewTab());
+  ASSERT_NE(toolbar, floating());
+  EXPECT_TRUE(floating()->omnibox_view()->GetText().empty());
+  EXPECT_EQ(count, browser()->tab_strip_model()->count());
+  EXPECT_EQ(contents, browser()->tab_strip_model()->GetActiveWebContents());
+  auto* widget = floating()->GetWidget();
+  views::test::WidgetDestroyedWaiter destroyed(widget);
+  ui::KeyEvent escape(ui::EventType::kKeyPressed, ui::VKEY_ESCAPE, 0);
+  static_cast<views::Textfield*>(floating()->omnibox_view())
+      ->OnKeyEvent(&escape);
+  destroyed.Wait();
+  EXPECT_EQ(toolbar, browser_view()->GetLocationBar());
+  EXPECT_EQ(count, browser()->tab_strip_model()->count());
+  EXPECT_EQ(contents, browser()->tab_strip_model()->GetActiveWebContents());
+}
+
+TEST_F(ArciumCommandBarTest, ReusedBarResetsQueryAndInvocationMode) {
+  ASSERT_TRUE(browser_view()->ShowArciumCommandBar(true));
+  auto* location = floating();
+  auto* widget = location->GetWidget();
+  location->omnibox_view()->SetUserText(u"close live instance", true);
+  ASSERT_TRUE(browser_view()->ShowArciumCommandBar(false));
+  EXPECT_EQ(widget, floating()->GetWidget());
+  EXPECT_FALSE(browser_view()->IsArciumCommandBarNewTab());
+  EXPECT_NE(u"close live instance", location->omnibox_view()->GetText());
+  EXPECT_FALSE(location->omnibox_view()->GetText().empty());
+  ASSERT_TRUE(browser_view()->ShowArciumCommandBar(true));
+  EXPECT_EQ(widget, floating()->GetWidget());
+  EXPECT_TRUE(location->omnibox_view()->GetText().empty());
+  EXPECT_TRUE(location->GetOmniboxController()
+                  ->autocomplete_controller()
+                  ->result()
+                  .empty());
+  views::test::WidgetDestroyedWaiter destroyed(widget);
+  browser_view()->CloseArciumCommandBar();
+  destroyed.Wait();
+}
+
+TEST_F(ArciumCommandBarTest, LostFocusDefersDestructionUntilAcceptanceReturns) {
+  ASSERT_TRUE(browser_view()->ShowArciumCommandBar(true));
+  auto* widget = floating()->GetWidget();
+  auto weak_widget = widget->GetWeakPtr();
+  views::test::WidgetDestroyedWaiter destroyed(widget);
+  const int count = browser()->tab_strip_model()->count();
+  widget->CloseWithReason(views::Widget::ClosedReason::kLostFocus);
+  EXPECT_TRUE(weak_widget);
+  // Reentrant Cmd-T while teardown is pending must not create a real tab.
+  chrome::ExecuteCommand(browser(), IDC_NEW_TAB);
+  EXPECT_EQ(count, browser()->tab_strip_model()->count());
+  destroyed.Wait();
+  EXPECT_FALSE(weak_widget);
+  EXPECT_EQ(browser_view()->GetLocationBarView(),
+            browser_view()->GetLocationBar());
+}
+
+TEST_F(ArciumCommandBarTest, ChangingActiveTabCancelsTransientInput) {
+  AddTab(browser(), GURL("https://other.test/"));
+  browser()->tab_strip_model()->ActivateTabAt(0);
+  auto* toolbar = browser_view()->GetLocationBarView();
+  const int count = browser()->tab_strip_model()->count();
+  ASSERT_TRUE(browser_view()->ShowArciumCommandBar(true));
+  views::test::WidgetDestroyedWaiter destroyed(floating()->GetWidget());
+  browser()->tab_strip_model()->ActivateTabAt(1);
+  destroyed.Wait();
+  EXPECT_EQ(toolbar, browser_view()->GetLocationBar());
+  EXPECT_EQ(count, browser()->tab_strip_model()->count());
+}
