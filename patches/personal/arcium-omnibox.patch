+std::vector<ArciumOmniboxItem>
+ChromeAutocompleteProviderClient::GetArciumOmniboxItems() const {
+  if (!helium::IsHeliumFavoritesAndPinsEnabled() ||
+      profile_->IsOffTheRecord() || profile_->IsGuestSession()) {
+    return {};
+  }
+
+  content::WebContents* contents =
+      web_contents_getter_ ? web_contents_getter_.Run() : nullptr;
+  tabs::TabInterface* current_tab =
+      contents ? tabs::TabInterface::MaybeGetFromContents(contents) : nullptr;
+  BrowserWindowInterface* current_window =
+      current_tab ? current_tab->GetBrowserWindowInterface() : nullptr;
+  Browser* current_browser =
+      current_window ? current_window->GetBrowserForMigrationOnly() : nullptr;
+  helium::HeliumSpaceService* spaces =
+      helium::HeliumSpaceServiceFactory::GetForProfile(profile_);
+  if (!current_browser || current_browser->profile() != profile_ || !spaces) {
+    return {};
+  }
+
+  std::vector<ArciumOmniboxItem> result;
+  for (const helium::PersistentOmniboxItem& source :
+       spaces->GetOmniboxItemsForBrowser(current_browser)) {
+    ArciumOmniboxItem item;
+    item.kind = source.kind == helium::PersistentRecordKind::kFavorite
+                    ? ArciumOmniboxItem::Kind::kFavorite
+                    : ArciumOmniboxItem::Kind::kPin;
+    item.id = source.id;
+    item.title = source.title;
+    item.url = source.url;
+    item.space_id = source.space_id;
+    item.space_name = source.space_name;
+    item.folder_path = source.folder_path;
+    switch (source.tier) {
+      case helium::PersistentOmniboxItem::Tier::kActiveSpacePin:
+        item.tier = ArciumOmniboxItem::Tier::kActiveSpacePin;
+        break;
+      case helium::PersistentOmniboxItem::Tier::kFavorite:
+        item.tier = ArciumOmniboxItem::Tier::kFavorite;
+        break;
+      case helium::PersistentOmniboxItem::Tier::kOtherSpacePin:
+        item.tier = ArciumOmniboxItem::Tier::kOtherSpacePin;
+        break;
+    }
+    item.is_live = source.is_live;
+    item.is_active = source.is_active;
+    item.use_count = source.use_count;
+    item.last_used_internal_value = source.last_used_internal_value;
+    result.push_back(std::move(item));
+  }
+  return result;
+}
+
+std::vector<ArciumOmniboxItem>
+ChromeAutocompleteProviderClient::GetArciumOmniboxCommands() const {
+  if (!helium::IsHeliumFavoritesAndPinsEnabled() ||
+      !profile_->GetPrefs()->GetBoolean(
+          prefs::kArciumOmniboxPersistentItemsEnabled) ||
+      profile_->IsOffTheRecord() || profile_->IsGuestSession()) {
+    return {};
+  }
+  auto* contents = web_contents_getter_ ? web_contents_getter_.Run() : nullptr;
+  auto* current_tab =
+      contents ? tabs::TabInterface::MaybeGetFromContents(contents) : nullptr;
+  auto* window =
+      current_tab ? current_tab->GetBrowserWindowInterface() : nullptr;
+  auto* current_browser =
+      window ? window->GetBrowserForMigrationOnly() : nullptr;
+  auto* spaces = helium::HeliumSpaceServiceFactory::GetForProfile(profile_);
+  if (!current_browser || current_browser->profile() != profile_ || !spaces) {
+    return {};
+  }
+  std::vector<ArciumOmniboxItem> result;
+  const std::string source_space(
+      spaces->GetExplicitSpaceIdForBrowser(current_browser));
+  const auto* source = spaces->GetSpaceById(source_space);
+  auto add_current = [&](ArciumOmniboxItem::Command command,
+                         std::u16string label, std::u16string search_alias) {
+    ArciumOmniboxItem item;
+    item.command = command;
+    item.title = std::move(label);
+    item.url = contents->GetLastCommittedURL();
+    item.command_target_title =
+        base::TrimWhitespace(contents->GetTitle(), base::TRIM_ALL).empty()
+            ? base::UTF8ToUTF16(item.url.spec())
+            : contents->GetTitle();
+    item.space_id = source_space;
+    item.space_name = source ? source->name() : std::u16string();
+    item.command_search_text = search_alias + u" " + item.title + u" " +
+                               item.command_target_title + u" " +
+                               item.space_name;
+    item.source_tab_session_id =
+        sessions::SessionTabHelper::IdForTab(contents).id();
+    result.push_back(std::move(item));
+  };
+  const auto current_kind = spaces->GetPersistentItemKind(current_tab);
+  if (!source_space.empty() && !current_kind &&
+      contents->GetLastCommittedURL().SchemeIsHTTPOrHTTPS()) {
+    add_current(ArciumOmniboxItem::Command::kPinCurrentTab, u"Pin this tab",
+                u"Pin current tab");
+    add_current(ArciumOmniboxItem::Command::kFavoriteCurrentTab,
+                u"Add to Favorites", u"Add current tab to Favorites");
+  }
+  // Enumerate commands from an immutable item snapshot. Do not grow the vector
+  // being iterated; each command retains its qualified durable source identity.
+  const auto saved_items = GetArciumOmniboxItems();
+  for (const auto& saved : saved_items) {
+    if (saved.command != ArciumOmniboxItem::Command::kNone) {
+      continue;
+    }
+    auto add_command = [&](ArciumOmniboxItem::Command command,
+                           std::u16string label,
+                           std::string target_space = std::string(),
+                           std::u16string target_name = std::u16string()) {
+      auto item = saved;
+      item.command = command;
+      item.title = std::move(label);
+      item.command_target_title =
+          base::TrimWhitespace(saved.title, base::TRIM_ALL).empty()
+              ? base::UTF8ToUTF16(saved.url.spec())
+              : saved.title;
+      item.target_space_name = std::move(target_name);
+      item.command_search_text = item.title + u" " + item.command_target_title +
+                                 u" " + saved.space_name + u" " +
+                                 item.target_space_name;
+      if (command == ArciumOmniboxItem::Command::kCloseLiveInstance) {
+        item.command_search_text =
+            u"Close live instance " + item.command_search_text;
+      }
+      for (const auto& folder : saved.folder_path) {
+        item.command_search_text += u" " + folder;
+      }
+      item.target_space_id = std::move(target_space);
+      result.push_back(std::move(item));
+    };
+    if (saved.is_live) {
+      add_command(ArciumOmniboxItem::Command::kCloseLiveInstance,
+                  u"Close live tab");
+      if (saved.kind == ArciumOmniboxItem::Kind::kPin) {
+        add_command(ArciumOmniboxItem::Command::kReturnPinHome,
+                    u"Return pin home");
+      }
+    }
+    if (saved.kind == ArciumOmniboxItem::Kind::kPin) {
+      for (const auto* space : spaces->GetSpaces()) {
+        if (space->id() != saved.space_id) {
+          add_command(ArciumOmniboxItem::Command::kMovePinToSpace,
+                      u"Move pin to " + space->name(), space->id(),
+                      space->name());
+        }
+      }
+    }
+  }
+  return result;
+}
