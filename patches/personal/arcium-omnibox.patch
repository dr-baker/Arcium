+TEST_F(OmniboxResultViewTest, ArciumActionsShowTwoLineContextAndPassiveCue) {
+  AutocompleteMatch match;
+  match.type = AutocompleteMatchType::BOOKMARK_TITLE;
+  match.contents = u"Close live tab";
+  match.contents_class = {{0, ACMatchClassification::MATCH}};
+  match.description = u"Atlas · Pin · Work › Projects";
+  match.description_class = {{0, ACMatchClassification::DIM}};
+  match.arcium_item = ArciumOmniboxItem();
+  match.arcium_item->command = ArciumOmniboxItem::Command::kCloseLiveInstance;
+  result_view()->SetMatch(match);
+  auto* cell = result_view()->suggestion_view_.get();
+  result_view()->SetBoundsRect(
+      gfx::Rect(0, 0, 640, cell->GetPreferredSize().height()));
+  views::test::RunScheduledLayout(result_view());
+
+  EXPECT_EQ(match.contents, cell->content()->GetText());
+  EXPECT_EQ(match.description, cell->description()->GetText());
+  EXPECT_GT(cell->description()->y(), cell->content()->y());
+  EXPECT_GE(cell->description()->y(), cell->content()->bounds().bottom());
+  EXPECT_EQ(0, cell->separator()->width());
+  EXPECT_GT(cell->GetPreferredSize().height(),
+            OmniboxMatchCellView::kRowHeight);
+  EXPECT_EQ(u"Keep pin", cell->command_hint()->GetText());
+  EXPECT_EQ(views::View::FocusBehavior::NEVER,
+            cell->command_hint()->GetFocusBehavior());
+  EXPECT_EQ(views::View::FocusBehavior::NEVER,
+            cell->command_key()->GetFocusBehavior());
+  EXPECT_FALSE(cell->command_key()->GetVisible());
+
+  popup_view()->SetSelectedIndex(kTestResultViewIndex);
+  result_view()->OnSelectionStateChanged();
+  EXPECT_TRUE(cell->command_key()->GetVisible());
+  EXPECT_EQ(u"↵", cell->command_key()->GetText());
+}
+
+TEST_F(OmniboxResultViewTest, ArciumActionReuseClearsCommandAffordances) {
+  AutocompleteMatch command;
+  command.type = AutocompleteMatchType::BOOKMARK_TITLE;
+  command.contents = u"Add to Favorites";
+  command.description = u"Atlas · Tab · Work";
+  command.arcium_item = ArciumOmniboxItem();
+  command.arcium_item->command =
+      ArciumOmniboxItem::Command::kFavoriteCurrentTab;
+  popup_view()->SetSelectedIndex(kTestResultViewIndex);
+  result_view()->SetMatch(command);
+  auto* cell = result_view()->suggestion_view_.get();
+  ASSERT_TRUE(cell->command_key()->GetVisible());
+  ASSERT_TRUE(cell->command_hint()->GetVisible());
+
+  AutocompleteMatch navigation;
+  navigation.type = AutocompleteMatchType::HISTORY_URL;
+  navigation.contents = u"Atlas";
+  navigation.description = u"atlas.test";
+  result_view()->SetMatch(navigation);
+  EXPECT_FALSE(cell->command_key()->GetVisible());
+  EXPECT_FALSE(cell->command_hint()->GetVisible());
+  EXPECT_TRUE(cell->command_hint()->GetText().empty());
+  EXPECT_EQ(OmniboxMatchCellView::kRowHeight,
+            cell->GetPreferredSize().height());
+  EXPECT_EQ(navigation.contents, cell->content()->GetText());
+  EXPECT_EQ(navigation.description, cell->description()->GetText());
+}
+
+TEST_F(OmniboxResultViewTest, ArciumActionResizeDoesNotOverlapReturnCue) {
+  AutocompleteMatch command;
+  command.type = AutocompleteMatchType::BOOKMARK_TITLE;
+  command.contents = u"Move pin to Research";
+  command.description =
+      u"A long document title · Pin · Work › Projects → Research";
+  command.arcium_item = ArciumOmniboxItem();
+  command.arcium_item->command = ArciumOmniboxItem::Command::kMovePinToSpace;
+  popup_view()->SetSelectedIndex(kTestResultViewIndex);
+  result_view()->SetMatch(command);
+  auto* cell = result_view()->suggestion_view_.get();
+  for (const int width : {48, 120, 320, 640}) {
+    SCOPED_TRACE(width);
+    result_view()->SetBoundsRect(
+        gfx::Rect(0, 0, width, cell->GetPreferredSize().height()));
+    views::test::RunScheduledLayout(result_view());
+    EXPECT_GE(cell->content()->width(), 0);
+    EXPECT_GE(cell->description()->width(), 0);
+    EXPECT_LE(cell->content()->bounds().right(), cell->command_key()->x());
+    EXPECT_LE(cell->description()->bounds().right(), cell->command_key()->x());
+    EXPECT_LE(cell->command_key()->bounds().right(), cell->width());
+    EXPECT_GE(cell->command_key()->x(), 0);
+    if (width <= 320) {
+      EXPECT_EQ(0, cell->command_hint()->width());
+    } else {
+      EXPECT_GT(cell->command_hint()->width(), 0);
+    }
+  }
+}
+
+TEST_F(OmniboxResultViewTest, ArciumActionRepeatedLayoutKeepsReturnCueStable) {
+  AutocompleteMatch command;
+  command.type = AutocompleteMatchType::BOOKMARK_TITLE;
+  command.contents = u"Pin this tab";
+  command.description = u"Atlas · Tab · Work";
+  command.arcium_item = ArciumOmniboxItem();
+  command.arcium_item->command = ArciumOmniboxItem::Command::kPinCurrentTab;
+  popup_view()->SetSelectedIndex(kTestResultViewIndex);
+  result_view()->SetMatch(command);
+  // Exercise the popup's row/result/cell hierarchy. Giving the result a height
+  // measured directly from its cell bypasses the FlexLayout sizing contract.
+  result_view()->parent()->AddChildViewRaw(popup_view());
+  std::array<OmniboxRowView*, 3> rows;
+  for (size_t i = 0; i < rows.size(); ++i) {
+    rows[i] = popup_view()->AddChildView(
+        std::make_unique<OmniboxRowView>(i == 0 ? kTestResultViewIndex : i - 1,
+                                       popup_view()));
+  }
+  auto* active_result = rows.front()->result_view();
+  auto* cell = active_result->suggestion_view_.get();
+  AutocompleteMatch navigation;
+  navigation.type = AutocompleteMatchType::HISTORY_URL;
+  navigation.contents = u"Atlas";
+  navigation.description = u"atlas.test";
+  for (const int width : {320, 640}) {
+    SCOPED_TRACE(width);
+    for (const bool mixed_results : {true, false, true}) {
+      SCOPED_TRACE(mixed_results);
+      int popup_height = 0;
+      for (size_t i = 0; i < rows.size(); ++i) {
+        auto* result = rows[i]->result_view();
+        result->SetMatch(mixed_results && i == 1 ? navigation : command);
+        const int cell_height =
+            result->suggestion_view_->GetPreferredSize().height();
+        const int row_height = rows[i]->GetPreferredSize().height();
+        if (result->match_.arcium_item &&
+            result->match_.arcium_item->IsCommand()) {
+          const auto* flex =
+              result->suggestion_view_->GetProperty(views::kFlexBehaviorKey);
+          ASSERT_NE(nullptr, flex);
+          const auto flex_size = flex->rule().Run(
+              result->suggestion_view_, {width, cell_height + 40});
+          EXPECT_EQ(width, flex_size.width());
+          EXPECT_EQ(cell_height, flex_size.height());
+        }
+        EXPECT_EQ(cell_height + rows[i]->GetInsets().height(), row_height);
+        EXPECT_EQ(row_height,
+                  rows[i]->GetPreferredSize({width, {}}).height());
+        popup_height += row_height;
+      }
+      popup_view()->SetBoundsRect(gfx::Rect(0, 0, width, popup_height));
+      views::test::RunScheduledLayout(popup_view());
+      for (size_t i = 0; i < rows.size(); ++i) {
+        auto* result = rows[i]->result_view();
+        auto* row_cell = result->suggestion_view_.get();
+        EXPECT_GE(row_cell->height(), row_cell->GetPreferredSize().height());
+        EXPECT_LE(row_cell->description()->bounds().bottom(),
+                  row_cell->height());
+        EXPECT_LE(result->bounds().bottom(), rows[i]->height());
+        if (i + 1 < rows.size()) {
+          EXPECT_LE(rows[i]->bounds().bottom(), rows[i + 1]->y());
+        }
+      }
+    }
+  }
+  const auto key_bounds = cell->command_key()->bounds();
+  const auto key_contents = cell->command_key()->GetContentsBounds();
+  const auto copy_bounds = cell->content()->bounds();
+  EXPECT_EQ(
+      gfx::ALIGN_CENTER,
+      cell->command_key()->CreateRenderText(u"↵")->horizontal_alignment());
+  for (int pass = 0; pass < 8; ++pass) {
+    SCOPED_TRACE(pass);
+    cell->InvalidateLayout();
+    views::test::RunScheduledLayout(popup_view());
+    EXPECT_EQ(key_bounds, cell->command_key()->bounds());
+    EXPECT_EQ(key_contents, cell->command_key()->GetContentsBounds());
+    EXPECT_EQ(copy_bounds, cell->content()->bounds());
+    EXPECT_TRUE(cell->command_key()->GetVisible());
+    EXPECT_EQ(views::View::FocusBehavior::NEVER,
+              cell->command_key()->GetFocusBehavior());
+  }
+}
