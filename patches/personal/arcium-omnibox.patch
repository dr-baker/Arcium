--- /dev/null
+++ src/components/omnibox/browser/arcium_omnibox_item.h
@@ -0,0 +1,60 @@
+// Copyright 2026 The Arcium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#ifndef COMPONENTS_OMNIBOX_BROWSER_ARCIUM_OMNIBOX_ITEM_H_
+#define COMPONENTS_OMNIBOX_BROWSER_ARCIUM_OMNIBOX_ITEM_H_
+
+#include <cstdint>
+#include <string>
+#include <vector>
+
+#include "url/gurl.h"
+
+// A browser-owned durable tab exposed to the component-level omnibox. The
+// locator is structural because Arcium's full Pin model uses real tabs instead
+// of a parallel persistent-item database.
+struct ArciumOmniboxItem {
+  enum class Kind { kFavorite, kPin };
+  enum class Command {
+    kNone,
+    kPinCurrentTab,
+    kFavoriteCurrentTab,
+    kMovePinToSpace,
+    kCloseLiveInstance,
+    kReturnPinHome
+  };
+
+  Command command = Command::kNone;
+  std::string target_space_id;
+  int source_tab_session_id = 0;
+  std::u16string command_search_text;
+
+  // Length-prefixed fields keep identity stable across enumeration changes,
+  // duplicate URLs, and IDs containing separators.
+  std::string Identity() const {
+    auto field = [](const std::string& value) {
+      return std::to_string(value.size()) + ":" + value;
+    };
+    return std::to_string(static_cast<int>(kind)) + ":" +
+           std::to_string(static_cast<int>(command)) + ":" + field(space_id) +
+           field(id) + field(target_space_id) + ":" +
+           std::to_string(source_tab_session_id);
+  }
+  enum class Tier { kActiveSpacePin, kFavorite, kOtherSpacePin };
+
+  Kind kind = Kind::kPin;
+  std::string id;
+  std::u16string title;
+  GURL url;
+  std::string space_id;
+  std::u16string space_name;
+  std::vector<std::u16string> folder_path;
+  Tier tier = Tier::kOtherSpacePin;
+  bool is_live = false;
+  bool is_active = false;
+  int use_count = 0;
+  int64_t last_used_internal_value = 0;
+};
+
+#endif  // COMPONENTS_OMNIBOX_BROWSER_ARCIUM_OMNIBOX_ITEM_H_
