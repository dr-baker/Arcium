+bool ExecuteArciumOmniboxCommand(Browser* browser,
+                                 const ArciumOmniboxItem& item) {
+  if (!browser) {
+    return false;
+  }
+  Profile* profile = browser->profile();
+  auto* spaces = helium::HeliumSpaceServiceFactory::GetForProfile(profile);
+  if (!spaces || !helium::IsHeliumFavoritesAndPinsEnabled() ||
+      !profile->GetPrefs()->GetBoolean(
+          prefs::kArciumOmniboxPersistentItemsEnabled) ||
+      profile->IsOffTheRecord() || profile->IsGuestSession()) {
+    return false;
+  }
+  const auto kind = item.kind == ArciumOmniboxItem::Kind::kFavorite
+                        ? helium::PersistentRecordKind::kFavorite
+                        : helium::PersistentRecordKind::kPin;
+  auto* contents = browser->tab_strip_model()->GetActiveWebContents();
+  auto* tab =
+      contents ? tabs::TabInterface::MaybeGetFromContents(contents) : nullptr;
+  const bool current_tab_matches =
+      contents &&
+      sessions::SessionTabHelper::IdForTab(contents).id() ==
+          item.source_tab_session_id &&
+      spaces->GetExplicitSpaceIdForBrowser(browser) == item.space_id;
+  switch (item.command) {
+    case ArciumOmniboxItem::Command::kPinCurrentTab:
+      if (current_tab_matches && tab && !spaces->IsPersistentItemTab(tab)) {
+        return spaces->AddPinFromTab(tab);
+      }
+      break;
+    case ArciumOmniboxItem::Command::kFavoriteCurrentTab:
+      if (current_tab_matches && tab && !spaces->IsPersistentItemTab(tab)) {
+        return spaces->AddFavoriteFromTab(tab);
+      }
+      break;
+    case ArciumOmniboxItem::Command::kMovePinToSpace:
+      if (kind == helium::PersistentRecordKind::kPin) {
+        return spaces->MovePinToSpace(browser, item.id, item.space_id,
+                                      item.target_space_id);
+      }
+      break;
+    case ArciumOmniboxItem::Command::kCloseLiveInstance:
+      return spaces->ClosePersistentItemInstance(browser, kind, item.id,
+                                                 item.space_id);
+      break;
+    case ArciumOmniboxItem::Command::kReturnPinHome:
+      if (kind == helium::PersistentRecordKind::kPin) {
+        return spaces->ReturnPersistentItemHome(browser, kind, item.id,
+                                                item.space_id);
+      }
+      break;
+    case ArciumOmniboxItem::Command::kNone:
+      NOTREACHED();
+  }
+  return false;
+}
