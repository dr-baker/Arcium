+
+TEST_F(ArciumOmniboxServiceTest,
+       OmniboxCurrentTabCommandsRejectChangedTabAndSpace) {
+  auto* first = AddOrdinaryTab("https://first.test/");
+  ASSERT_TRUE(first);
+  browser()->tab_strip_model()->ActivateTabAt(
+      browser()->tab_strip_model()->GetIndexOfTab(first));
+  ArciumOmniboxItem command;
+  command.command = ArciumOmniboxItem::Command::kPinCurrentTab;
+  command.space_id = space_->id();
+  command.source_tab_session_id =
+      sessions::SessionTabHelper::IdForTab(first->GetContents()).id();
+  auto* second = AddOrdinaryTab("https://second.test/");
+  ASSERT_NE(first, second);
+  browser()->tab_strip_model()->ActivateTabAt(
+      browser()->tab_strip_model()->GetIndexOfTab(second));
+  EXPECT_FALSE(ExecuteArciumOmniboxCommand(browser(), command));
+  EXPECT_FALSE(service_->IsPersistentItemTab(first));
+  browser()->tab_strip_model()->ActivateTabAt(
+      browser()->tab_strip_model()->GetIndexOfTab(first));
+  auto* other = service_->GetOrCreateSpace("other", u"Other");
+  service_->SetSpaceForBrowser(browser(), other->id());
+  EXPECT_FALSE(ExecuteArciumOmniboxCommand(browser(), command));
+  service_->SetSpaceForBrowser(browser(), space_->id());
+  EXPECT_TRUE(ExecuteArciumOmniboxCommand(browser(), command));
+  EXPECT_EQ(PersistentRecordKind::kPin, service_->GetPersistentItemKind(first));
+  EXPECT_FALSE(ExecuteArciumOmniboxCommand(browser(), command));
+}
+
+TEST_F(ArciumOmniboxServiceTest,
+       OmniboxFavoriteCommandPreservesTabAndHonorsSetting) {
+  auto* tab = AddOrdinaryTab("https://favorite.test/");
+  browser()->tab_strip_model()->ActivateTabAt(
+      browser()->tab_strip_model()->GetIndexOfTab(tab));
+  ArciumOmniboxItem command;
+  command.command = ArciumOmniboxItem::Command::kFavoriteCurrentTab;
+  command.space_id = space_->id();
+  command.source_tab_session_id =
+      sessions::SessionTabHelper::IdForTab(tab->GetContents()).id();
+  const int count = browser()->tab_strip_model()->count();
+  auto* contents = tab->GetContents();
+  profile()->GetPrefs()->SetBoolean(prefs::kArciumOmniboxPersistentItemsEnabled,
+                                    false);
+  EXPECT_FALSE(ExecuteArciumOmniboxCommand(browser(), command));
+  EXPECT_FALSE(service_->IsPersistentItemTab(tab));
+  profile()->GetPrefs()->SetBoolean(prefs::kArciumOmniboxPersistentItemsEnabled,
+                                    true);
+  ASSERT_TRUE(ExecuteArciumOmniboxCommand(browser(), command));
+  EXPECT_EQ(count, browser()->tab_strip_model()->count());
+  EXPECT_EQ(contents, tab->GetContents());
+  EXPECT_EQ(PersistentRecordKind::kFavorite,
+            service_->GetPersistentItemKind(tab));
+}
+
+TEST_F(ArciumOmniboxServiceTest,
+       OmniboxPinCommandsKeepQualifiedIdentityAndLifecycle) {
+  auto [id, pin] = AddLivePin();
+  ASSERT_TRUE(pin);
+  auto* contents = pin->GetContents();
+  AddOrdinaryTab("https://ordinary.test/");
+  auto* other = service_->GetOrCreateSpaceReplacingPins(
+      "other", u"Other", {LinkNode(id, u"Same ID", "https://unrelated.test/")});
+  ArciumOmniboxItem command;
+  command.id = id;
+  command.space_id = space_->id();
+  command.command = ArciumOmniboxItem::Command::kReturnPinHome;
+  content::NavigationSimulator::NavigateAndCommitFromBrowser(
+      contents, GURL("https://pin.test/deep"));
+  const int count = browser()->tab_strip_model()->count();
+  ASSERT_TRUE(ExecuteArciumOmniboxCommand(browser(), command));
+  EXPECT_EQ(contents, pin->GetContents());
+  EXPECT_EQ(count, browser()->tab_strip_model()->count());
+  EXPECT_EQ(GURL("https://pin.test/"), contents->GetVisibleURL());
+  command.space_id = "missing-space";
+  EXPECT_FALSE(ExecuteArciumOmniboxCommand(browser(), command));
+  command.space_id = space_->id();
+  command.command = ArciumOmniboxItem::Command::kCloseLiveInstance;
+  ASSERT_TRUE(ExecuteArciumOmniboxCommand(browser(), command));
+  base::RunLoop().RunUntilIdle();
+  EXPECT_TRUE(PersistentItemCodec::FindLink(space_->pins(), id));
+  EXPECT_FALSE(service_->GetLiveTabForPersistentItem(
+      browser(), PersistentRecordKind::kPin, id));
+  command.command = ArciumOmniboxItem::Command::kReturnPinHome;
+  EXPECT_FALSE(ExecuteArciumOmniboxCommand(browser(), command));
+  command.command = ArciumOmniboxItem::Command::kMovePinToSpace;
+  command.target_space_id = other->id();
+  EXPECT_FALSE(ExecuteArciumOmniboxCommand(browser(), command));
+  auto* destination = service_->GetOrCreateSpace("destination", u"Destination");
+  command.target_space_id = destination->id();
+  command.kind = ArciumOmniboxItem::Kind::kFavorite;
+  EXPECT_FALSE(ExecuteArciumOmniboxCommand(browser(), command));
+  EXPECT_TRUE(PersistentItemCodec::FindLink(space_->pins(), id));
+  EXPECT_FALSE(PersistentItemCodec::FindLink(destination->pins(), id));
+  command.kind = ArciumOmniboxItem::Kind::kPin;
+  ASSERT_TRUE(ExecuteArciumOmniboxCommand(browser(), command));
+  EXPECT_FALSE(PersistentItemCodec::FindLink(space_->pins(), id));
+  ASSERT_TRUE(PersistentItemCodec::FindLink(destination->pins(), id));
+  EXPECT_EQ(GURL("https://pin.test/"),
+            PersistentItemCodec::FindLink(destination->pins(), id)->url);
+  EXPECT_EQ(GURL("https://unrelated.test/"),
+            PersistentItemCodec::FindLink(other->pins(), id)->url);
+  EXPECT_FALSE(ExecuteArciumOmniboxCommand(browser(), command));
+}
+
+TEST_F(ArciumOmniboxServiceTest,
+       OmniboxActivationRestoresOnceAndRejectsStaleIdentity) {
+  auto [id, pin] = AddLivePin();
+  AddOrdinaryTab("https://origin.test/");
+  PersistentOmniboxItem target;
+  target.id = id;
+  target.space_id = space_->id();
+  auto* original = pin->GetContents();
+  const int count = browser()->tab_strip_model()->count();
+  ASSERT_TRUE(service_->ActivateOmniboxItem(browser(), target));
+  EXPECT_EQ(original, browser()->tab_strip_model()->GetActiveWebContents());
+  EXPECT_EQ(count, browser()->tab_strip_model()->count());
+  ASSERT_TRUE(service_->ClosePersistentItemInstance(
+      browser(), PersistentRecordKind::kPin, id, space_->id()));
+  base::RunLoop().RunUntilIdle();
+  ASSERT_TRUE(service_->ActivateOmniboxItem(browser(), target));
+  const int restored_count = browser()->tab_strip_model()->count();
+  auto* restored = browser()->tab_strip_model()->GetActiveWebContents();
+  ASSERT_TRUE(service_->ActivateOmniboxItem(browser(), target));
+  EXPECT_EQ(restored, browser()->tab_strip_model()->GetActiveWebContents());
+  EXPECT_EQ(restored_count, browser()->tab_strip_model()->count());
+  target.id = "removed";
+  EXPECT_FALSE(service_->ActivateOmniboxItem(browser(), target));
+  EXPECT_EQ(restored_count, browser()->tab_strip_model()->count());
+}
+
