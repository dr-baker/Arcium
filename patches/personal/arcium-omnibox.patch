+std::vector<ArciumOmniboxItem>
+ChromeAutocompleteProviderClient::GetArciumOmniboxItems() const {
+  if (!helium::IsHeliumFavoritesAndPinsEnabled() ||
+      profile_->IsOffTheRecord() || profile_->IsGuestSession()) {
+    return {};
+  }
+
+  content::WebContents* contents =
+      web_contents_getter_ ? web_contents_getter_.Run() : nullptr;
+  tabs::TabInterface* current_tab =
+      contents ? tabs::TabInterface::MaybeGetFromContents(contents) : nullptr;
+  BrowserWindowInterface* current_window =
+      current_tab ? current_tab->GetBrowserWindowInterface() : nullptr;
+  Browser* current_browser =
+      current_window ? current_window->GetBrowserForMigrationOnly() : nullptr;
+  helium::HeliumSpaceService* spaces =
+      helium::HeliumSpaceServiceFactory::GetForProfile(profile_);
+  if (!current_browser || current_browser->profile() != profile_ || !spaces) {
+    return {};
+  }
+
+  auto read_tab = [](tabs::TabInterface* tab, ArciumOmniboxItem* item) {
+    GURL home_url;
+    std::u16string home_title;
+    if (helium::GetAnchoredPinnedTabHome(tab, &home_url, &home_title)) {
+      item->url = std::move(home_url);
+      item->title = std::move(home_title);
+    } else {
+      item->url = tab->GetContents()->GetVisibleURL();
+      item->title = tab->GetTitle();
+    }
+    if (item->title.empty()) {
+      item->title = base::UTF8ToUTF16(item->url.spec());
+    }
+  };
+
+  std::vector<ArciumOmniboxItem> result;
+  TabStripModel* current_model = current_browser->tab_strip_model();
+  size_t favorite_ordinal = 0;
+  for (int index = 0; index < current_model->count(); ++index) {
+    tabs::TabInterface* tab = current_model->GetTabAtIndex(index);
+    if (!tab->IsPinned()) {
+      continue;
+    }
+    ArciumOmniboxItem item;
+    item.kind = ArciumOmniboxItem::Kind::kFavorite;
+    item.ordinal = favorite_ordinal++;
+    item.is_live = true;
+    item.is_active = current_model->GetActiveTab() == tab;
+    read_tab(tab, &item);
+    result.push_back(std::move(item));
+  }
+
+  for (helium::HeliumSpace* space : spaces->GetSpaces()) {
+    if (!space) {
+      continue;
+    }
+    BrowserWindowInterface* window = space->GetPrimaryBrowser();
+    TabStripModel* model = window ? window->GetTabStripModel() : nullptr;
+    const auto* root = model ? static_cast<const tabs::TabStripCollection*>(
+                                   model->Root())
+                             : nullptr;
+    const tabs::PinTabCollection* pins = root ? root->pin_collection() : nullptr;
+    if (pins) {
+      size_t ordinal = 0;
+      for (tabs::TabInterface* tab : pins->GetTabsRecursive()) {
+        ArciumOmniboxItem item;
+        item.kind = ArciumOmniboxItem::Kind::kPin;
+        item.space_id = space->id();
+        item.space_name = space->name();
+        item.ordinal = ordinal++;
+        item.is_live = true;
+        item.is_active = model->GetActiveTab() == tab;
+        read_tab(tab, &item);
+        for (const tabs::TabCollection* parent = tab->GetParentCollection();
+             parent && parent->type() != tabs::TabCollection::Type::PIN;
+             parent = parent->GetParentCollection()) {
+          if (parent->type() == tabs::TabCollection::Type::FOLDER) {
+            item.folder_path.push_back(
+                static_cast<const tabs::FolderTabCollection*>(parent)->title());
+          }
+        }
+        std::ranges::reverse(item.folder_path);
+        result.push_back(std::move(item));
+      }
+      continue;
+    }
+
+    size_t ordinal = 0;
+    for (const StartupTab& tab : space->ReadPins()) {
+      if (tab.type != StartupTab::Type::kPin) {
+        continue;
+      }
+      ArciumOmniboxItem item;
+      item.kind = ArciumOmniboxItem::Kind::kPin;
+      item.title = tab.helium_home_title.empty()
+                       ? base::UTF8ToUTF16(tab.url.spec())
+                       : tab.helium_home_title;
+      item.url = tab.url;
+      item.space_id = space->id();
+      item.space_name = space->name();
+      item.ordinal = ordinal++;
+      for (const auto& segment : tab.helium_folder_path) {
+        item.folder_path.push_back(segment.title);
+      }
+      result.push_back(std::move(item));
+    }
+  }
+  return result;
+}
