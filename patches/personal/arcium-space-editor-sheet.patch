+void ArciumSpaceThemeEditor::SetTheme(const helium::SpaceTheme& theme) {
+  std::string selected_id;
+  if (selected_glow_ && *selected_glow_ < shown_background().glows.size()) {
+    selected_id = shown_background().glows[*selected_glow_].id;
+  }
+  theme_ = theme;
+  if (!selected_id.empty()) {
+    selected_glow_.reset();
+    const auto& glows = shown_background().glows;
+    for (size_t i = 0; i < glows.size(); ++i) {
+      if (glows[i].id == selected_id) {
+        selected_glow_ = i;
+        break;
+      }
+    }
+  }
+  UpdateControls();
+}
