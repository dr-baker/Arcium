+// Native palette editors consume the same resolved roles for saved Spaces and
+// creation drafts. Color generation remains in GenerateSpacePalette().
+inline base::DictValue SpacePaletteRoles(const arcium::SpacePaletteColors& colors) {
+  auto ColorString = [](SkColor color) {
+    return base::StringPrintf("#%02X%02X%02X", SkColorGetR(color),
