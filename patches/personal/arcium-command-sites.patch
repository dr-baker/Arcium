+#ifndef CHROME_BROWSER_UI_OMNIBOX_ARCIUM_COMMAND_SITES_H_
+#define CHROME_BROWSER_UI_OMNIBOX_ARCIUM_COMMAND_SITES_H_
+
+#include <cstddef>
+#include <optional>
+#include <string>
+#include <string_view>
+#include <vector>
+
+#include "base/memory/ref_counted.h"
+#include "base/values.h"
+#include "chrome/browser/ui/helium/arcium_appearance_prefs.h"
+#include "chrome/browser/ui/omnibox/arcium_command_session.h"
+#include "third_party/skia/include/core/SkColor.h"
+#include "url/gurl.h"
+
+namespace arcium {
+
+// kCommandSitesPref stores sparse overrides of the built-in website scopes
+// plus user-added sites. An unset preference means the built-in catalog.
+//
+// {
+//   "order": ["chatgpt", "youtube", "docs"],
+//   "hidden": ["x"],
+//   "sites": {
+//     "youtube": {"label": "...", "tint": "#rrggbb", "shortcuts": [...]},
+//     "docs": {"label": "Docs", "domains": ["docs.rs"],
+//              "search": "https://docs.rs/releases/search?query=%s",
+//              "verb": "search", "tint": "#6b8fd6",
+//              "shortcuts": [{"title": "Releases",
+//                             "url": "https://docs.rs/releases"}]}
+//   }
+// }
+//
+// Built-in overrides may set only label, tint and shortcuts; their domains and
+// search page stay code-owned. A shortcut list replaces the site's list.
+
+enum class CommandSiteArtwork { kFavicon, kYouTube, kX, kChatGPT };
+enum class CommandSiteVerb { kSearch, kAsk };
+
+struct CommandSiteShortcut {
+  std::u16string title;
+  GURL url;
+  friend bool operator==(const CommandSiteShortcut&,
+                         const CommandSiteShortcut&) = default;
+};
+
+struct CommandSite {
+  CommandSite();
+  CommandSite(const CommandSite&);
+  CommandSite& operator=(const CommandSite&);
+  CommandSite(CommandSite&&);
+  CommandSite& operator=(CommandSite&&);
+  ~CommandSite();
+
+  // Exact or dot-separated subdomain match against any domain.
+  bool MatchesUrl(const GURL& url) const;
+  // Trims, length-checks and percent-encodes the query into the template's
+  // single query-value placeholder. The result keeps the template's origin.
+  std::optional<GURL> BuildSearchUrl(std::u16string_view query) const;
+  // The page whose favicon represents a site without built-in artwork.
+  GURL HomeUrl() const;
+  std::u16string VerbLabel() const;
+  // The preference representation of this site's editable fields.
+  base::DictValue ToValue() const;
+
+  CommandScopeId id;
+  std::u16string label;
+  std::vector<std::string> domains;
+  // Empty when the site offers no typed search.
+  std::string search_template;
+  CommandSiteVerb verb = CommandSiteVerb::kSearch;
+  SkColor tint = SK_ColorTRANSPARENT;
+  CommandSiteArtwork artwork = CommandSiteArtwork::kFavicon;
+  std::u16string accessibility_description;
+  std::vector<CommandSiteShortcut> shortcuts;
+  bool builtin = false;
+};
+
+// Immutable, ordered snapshot of the visible sites. Parsing happens once per
+// preference change; queries, paint and input read this snapshot directly.
+class CommandSiteCatalog final
+    : public base::RefCountedThreadSafe<CommandSiteCatalog> {
+ public:
+  static constexpr size_t kMaxSites = 8;
+  static constexpr size_t kMaxCustomSites = 8;
+  static constexpr size_t kMaxShortcuts = 8;
+  static constexpr size_t kMaxDomains = 4;
+  static constexpr size_t kMaxLabelLength = 40;
+  static constexpr size_t kMaxUrlLength = 2048;
+
+  // Built-in sites in their default order, ignoring every preference.
+  static scoped_refptr<const CommandSiteCatalog> Builtin();
+  // Lenient read: an invalid site, field or shortcut is dropped on its own.
+  static scoped_refptr<const CommandSiteCatalog> FromPref(
+      const base::DictValue& pref);
+  // Strict write validation: every key and value must be valid.
+  static bool IsValidPref(const base::DictValue& pref);
+  // Built-in definitions for an editor, including hidden sites.
+  static std::vector<CommandSite> BuiltinSites();
+  static bool IsBuiltinId(std::string_view id);
+  static bool IsValidCustomId(std::string_view id);
+
+  CommandSiteCatalog(const CommandSiteCatalog&) = delete;
+  CommandSiteCatalog& operator=(const CommandSiteCatalog&) = delete;
+
+  const std::vector<CommandSite>& sites() const { return sites_; }
+  const CommandSite* Find(std::string_view id) const;
+  // Every matching site, independent of rail order.
+  std::vector<CommandScopeId> ScopesForUrl(const GURL& url) const;
+  // The most specific matching domain decides a row's tint; ties prefer the
+  // smaller ID so reordering never recolors rows.
+  std::optional<SkColor> TintForUrl(const GURL& url) const;
+  std::optional<GURL> BuildSearchUrl(std::string_view scope_id,
+                                     std::u16string_view query) const;
+
+ private:
+  friend class base::RefCountedThreadSafe<CommandSiteCatalog>;
+  explicit CommandSiteCatalog(std::vector<CommandSite> sites);
+  ~CommandSiteCatalog();
+
+  const std::vector<CommandSite> sites_;
+};
+
+}  // namespace arcium
+
+#endif  // CHROME_BROWSER_UI_OMNIBOX_ARCIUM_COMMAND_SITES_H_
