+// The session keeps the callback until the next search, so later
+// republications must not write into this function's stack.
+std::shared_ptr<const CommandPublication> SearchAndSettle(
+    CommandSession& session,
+    std::string_view scope,
+    std::u16string query) {
+  auto latest = std::make_shared<std::shared_ptr<const CommandPublication>>();
+  session.Search(
+      std::string(scope), std::move(query),
+      base::BindRepeating(
+          [](std::shared_ptr<std::shared_ptr<const CommandPublication>> latest,
+             std::shared_ptr<const CommandPublication> update) {
+            *latest = std::move(update);
+          },
+          latest));
+  base::RunLoop().RunUntilIdle();
+  return *latest;
+}
+
+std::vector<GURL> ShortcutUrls(const CommandPublication& publication) {
+  std::vector<GURL> urls;
+  for (const auto& row : publication.rows) {
+    if (row.category == u"Shortcut") {
+      urls.push_back(std::get<CommandUrlTarget>(row.target).url);
+    }
+  }
+  return urls;
+}
+
+bool HasScope(const CommandPublication& publication, std::string_view id) {
+  return std::ranges::any_of(publication.scopes,
+                             [id](const CommandScopeDescriptor& scope) {
+                               return scope.id == id;
+                             });
+}
