+namespace arcium {
+namespace {
+
+constexpr char kOrderKey[] = "order";
+constexpr char kHiddenKey[] = "hidden";
+constexpr char kSitesKey[] = "sites";
+constexpr char kLabelKey[] = "label";
+constexpr char kDomainsKey[] = "domains";
+constexpr char kSearchKey[] = "search";
+constexpr char kVerbKey[] = "verb";
+constexpr char kTintKey[] = "tint";
+constexpr char kShortcutsKey[] = "shortcuts";
+constexpr char kTitleKey[] = "title";
+constexpr char kUrlKey[] = "url";
+constexpr char kPlaceholder[] = "%s";
+// Stands in for the query while a template is parsed. Letters only, so URL
+// canonicalization leaves it intact wherever it appears.
+constexpr char kProbe[] = "arciumcommandsitequery";
+constexpr size_t kMaxIdLength = 32;
+constexpr size_t kMaxDomainLength = 253;
+
+constexpr std::array<SkColor, 6> kCustomTints = {
+    SkColorSetRGB(0x8a, 0x7f, 0xd1), SkColorSetRGB(0xd1, 0x87, 0x4e),
+    SkColorSetRGB(0x4f, 0xa3, 0xb8), SkColorSetRGB(0xc4, 0x6a, 0x9b),
+    SkColorSetRGB(0x7d, 0x9a, 0x4f), SkColorSetRGB(0xb8, 0x8f, 0x3e)};
+
+CommandSite MakeBuiltin(std::string_view id,
+                        std::u16string_view label,
+                        std::vector<std::string> domains,
+                        std::string_view search,
+                        CommandSiteVerb verb,
+                        SkColor tint,
+                        CommandSiteArtwork artwork,
+                        std::u16string_view accessibility_description,
+                        std::vector<CommandSiteShortcut> shortcuts) {
+  CommandSite site;
+  site.id = std::string(id);
+  site.label = std::u16string(label);
+  site.domains = std::move(domains);
+  site.search_template = std::string(search);
+  site.verb = verb;
+  site.tint = tint;
+  site.artwork = artwork;
+  site.accessibility_description = std::u16string(accessibility_description);
+  site.shortcuts = std::move(shortcuts);
+  site.builtin = true;
+  return site;
+}
+
+const std::vector<CommandSite>& Builtins() {
+  static const base::NoDestructor<std::vector<CommandSite>> builtins([] {
+    std::vector<CommandSite> sites;
+    sites.push_back(MakeBuiltin(
+        kYouTubeScope, u"YouTube", {"youtube.com", "youtu.be"},
+        "https://www.youtube.com/results?search_query=%s",
+        CommandSiteVerb::kSearch, SkColorSetRGB(0xe3, 0x4b, 0x49),
+        CommandSiteArtwork::kYouTube, u"Search YouTube",
+        {{u"Subscriptions", GURL("https://www.youtube.com/feed/subscriptions")},
+         {u"Watch later", GURL("https://www.youtube.com/playlist?list=WL")},
+         {u"History", GURL("https://www.youtube.com/feed/history")}}));
+    sites.push_back(MakeBuiltin(
+        kXScope, u"X", {"x.com", "twitter.com"},
+        "https://x.com/search?q=%s&src=typed_query", CommandSiteVerb::kSearch,
+        SkColorSetRGB(0x74, 0x8c, 0xa6), CommandSiteArtwork::kX,
+        u"Search X posts and accounts",
+        {{u"Home", GURL("https://x.com/home")},
+         {u"Notifications", GURL("https://x.com/notifications")},
+         {u"Bookmarks", GURL("https://x.com/i/bookmarks")},
+         {u"Messages", GURL("https://x.com/messages")}}));
+    // The web integration opens ChatGPT with a populated query. Sending the
+    // query remains a decision on that site's page.
+    sites.push_back(MakeBuiltin(
+        kChatGPTScope, u"ChatGPT", {"chatgpt.com", "chat.openai.com"},
+        "https://chatgpt.com/?q=%s", CommandSiteVerb::kAsk,
+        SkColorSetRGB(0x53, 0xa9, 0x8c), CommandSiteArtwork::kChatGPT,
+        u"Open a prompt in ChatGPT",
+        {{u"New chat", GURL("https://chatgpt.com/")},
+         {u"Temporary chat", GURL("https://chatgpt.com/?temporary-chat=true")}}));
+    return sites;
+  }());
+  return *builtins;
+}
+
+const CommandSite* FindBuiltin(std::string_view id) {
+  for (const auto& site : Builtins()) {
+    if (site.id == id) {
+      return &site;
+    }
+  }
+  return nullptr;
+}
+
+bool IsReservedId(std::string_view id) {
+  return id == kOmniScope || id == kWebScope || id == kSavedScope;
+}
+
+std::optional<std::u16string> ParseLabel(const base::Value* value) {
+  if (!value || !value->is_string()) {
+    return std::nullopt;
+  }
+  std::u16string label;
+  base::TrimWhitespace(base::UTF8ToUTF16(value->GetString()), base::TRIM_ALL,
+                       &label);
+  if (label.empty() || label.size() > CommandSiteCatalog::kMaxLabelLength) {
+    return std::nullopt;
+  }
+  return label;
+}
+
+std::optional<SkColor> ParseTint(const base::Value* value) {
+  if (!value || !value->is_string()) {
+    return std::nullopt;
+  }
+  const std::string& text = value->GetString();
+  uint32_t rgb = 0;
+  if (text.size() != 7 || text[0] != '#' ||
+      !std::all_of(text.begin() + 1, text.end(), base::IsHexDigit<char>) ||
+      !base::HexStringToUInt(std::string_view(text).substr(1), &rgb)) {
+    return std::nullopt;
+  }
+  return SkColorSetRGB((rgb >> 16) & 0xff, (rgb >> 8) & 0xff, rgb & 0xff);
+}
+
+bool IsWebUrl(const GURL& url) {
+  return url.is_valid() && url.SchemeIsHTTPOrHTTPS() && url.has_host() &&
+         !url.has_username() && !url.has_password();
+}
+
+// Stored templates and shortcuts are bounded; generated searches follow the
+// session's query-length contract instead, since encoding expands queries.
+bool IsValidDestination(const GURL& url) {
+  return IsWebUrl(url) &&
+         url.spec().size() <= CommandSiteCatalog::kMaxUrlLength;
+}
+
+std::optional<std::string> ParseDomain(const base::Value& value) {
+  if (!value.is_string()) {
+    return std::nullopt;
+  }
+  const std::string& domain = value.GetString();
+  if (domain.empty() || domain.size() > kMaxDomainLength ||
+      domain.find('.') == std::string::npos || domain.front() == '.' ||
+      domain.back() == '.') {
+    return std::nullopt;
+  }
+  // Only canonical hostnames: no scheme, port, path, credentials or case.
+  const GURL url("https://" + domain + "/");
+  if (!url.is_valid() || url.host() != domain || url.HostIsIPAddress() ||
+      url.has_port()) {
+    return std::nullopt;
+  }
+  return domain;
+}
+
+GURL ProbeTemplate(std::string_view search_template) {
+  std::string probe(search_template);
+  const size_t position = probe.find(kPlaceholder);
+  if (position == std::string::npos) {
+    return GURL();
+  }
+  probe.replace(position, 2, kProbe);
+  return GURL(probe);
+}
+
+// One literal %s, inside a query value, on an HTTP(S) URL without credentials.
+bool IsValidTemplate(std::string_view search_template) {
+  if (search_template.empty() ||
+      search_template.size() > CommandSiteCatalog::kMaxUrlLength ||
+      search_template.find(kProbe) != std::string_view::npos) {
+    return false;
+  }
+  const size_t first = search_template.find(kPlaceholder);
+  if (first == std::string_view::npos ||
+      search_template.find(kPlaceholder, first + 2) != std::string_view::npos) {
+    return false;
+  }
+  const GURL url = ProbeTemplate(search_template);
+  if (!IsValidDestination(url) || url.HostIsIPAddress()) {
+    return false;
+  }
+  const std::string_view query = url.query();
+  const size_t position = query.find(kProbe);
+  return url.host().find(kProbe) == std::string_view::npos &&
+         url.path().find(kProbe) == std::string_view::npos &&
+         url.ref().find(kProbe) == std::string_view::npos &&
+         position != std::string_view::npos && position > 0 &&
+         query[position - 1] == '=';
+}
+
+// Lenient parsing drops an invalid shortcut; strict parsing rejects the list.
+std::optional<std::vector<CommandSiteShortcut>> ParseShortcuts(
+    const base::Value& value,
+    bool strict) {
+  if (!value.is_list()) {
+    return std::nullopt;
+  }
+  std::vector<CommandSiteShortcut> shortcuts;
+  std::set<std::string> urls;
+  for (const auto& entry : value.GetList()) {
+    const auto* dict = entry.GetIfDict();
+    std::optional<std::u16string> title;
+    GURL url;
+    bool valid = dict && (!strict || dict->size() == 2);
+    if (valid) {
+      title = ParseLabel(dict->Find(kTitleKey));
+      const auto* spec = dict->FindString(kUrlKey);
+      url = spec ? GURL(*spec) : GURL();
+      valid = title && IsValidDestination(url) && !urls.contains(url.spec());
+    }
+    if (!valid || shortcuts.size() == CommandSiteCatalog::kMaxShortcuts) {
+      if (strict) {
+        return std::nullopt;
+      }
+      continue;
+    }
+    urls.insert(url.spec());
+    shortcuts.push_back({std::move(*title), std::move(url)});
+  }
+  return shortcuts;
+}
+
+bool HasOnlyKeys(const base::DictValue& dict,
+                 std::initializer_list<std::string_view> keys) {
+  return std::ranges::all_of(dict, [keys](const auto& entry) {
+    return std::ranges::contains(keys, std::string_view(entry.first));
+  });
+}
+
+// Applies a built-in override. Strict parsing requires every field to be valid.
+bool ApplyOverride(const base::DictValue& dict, bool strict, CommandSite& site) {
+  if (strict && !HasOnlyKeys(dict, {kLabelKey, kTintKey, kShortcutsKey})) {
+    return false;
+  }
+  if (const auto* value = dict.Find(kLabelKey)) {
+    if (auto label = ParseLabel(value)) {
+      if (*label != site.label) {
+        site.label = std::move(*label);
+        site.accessibility_description = site.VerbLabel() + u" " + site.label;
+      }
+    } else if (strict) {
+      return false;
+    }
+  }
+  if (const auto* value = dict.Find(kTintKey)) {
+    if (auto tint = ParseTint(value)) {
+      site.tint = *tint;
+    } else if (strict) {
+      return false;
+    }
+  }
+  if (const auto* value = dict.Find(kShortcutsKey)) {
+    if (auto shortcuts = ParseShortcuts(*value, strict)) {
+      site.shortcuts = std::move(*shortcuts);
+    } else if (strict) {
+      return false;
+    }
+  }
+  return true;
+}
+
+std::optional<CommandSite> ParseCustom(std::string_view id,
+                                       const base::DictValue& dict,
+                                       bool strict) {
+  if (strict && !HasOnlyKeys(dict, {kLabelKey, kDomainsKey, kSearchKey,
+                                    kVerbKey, kTintKey, kShortcutsKey})) {
+    return std::nullopt;
+  }
+  CommandSite site;
+  site.id = std::string(id);
+  auto label = ParseLabel(dict.Find(kLabelKey));
+  if (!label) {
+    return std::nullopt;
+  }
+  site.label = std::move(*label);
+  if (const auto* value = dict.Find(kDomainsKey)) {
+    if (!value->is_list()) {
+      if (strict) {
+        return std::nullopt;
+      }
+    } else {
+      for (const auto& entry : value->GetList()) {
+        auto domain = ParseDomain(entry);
+        const bool duplicate =
+            domain && std::ranges::contains(site.domains, *domain);
+        if (!domain || duplicate ||
+            site.domains.size() == CommandSiteCatalog::kMaxDomains) {
+          if (strict) {
+            return std::nullopt;
+          }
+          continue;
+        }
+        site.domains.push_back(std::move(*domain));
+      }
+    }
+  }
+  if (const auto* value = dict.Find(kSearchKey)) {
+    if (value->is_string() && IsValidTemplate(value->GetString())) {
+      site.search_template = value->GetString();
+    } else if (strict) {
+      return std::nullopt;
+    }
+  }
+  if (const auto* value = dict.Find(kVerbKey)) {
+    if (value->is_string() && value->GetString() == "ask") {
+      site.verb = CommandSiteVerb::kAsk;
+    } else if (!value->is_string() || value->GetString() != "search") {
+      if (strict) {
+        return std::nullopt;
+      }
+    }
+  }
+  site.tint = kCustomTints[base::PersistentHash(id) % kCustomTints.size()];
+  if (const auto* value = dict.Find(kTintKey)) {
+    if (auto tint = ParseTint(value)) {
+      site.tint = *tint;
+    } else if (strict) {
+      return std::nullopt;
+    }
+  }
+  if (const auto* value = dict.Find(kShortcutsKey)) {
+    if (auto shortcuts = ParseShortcuts(*value, strict)) {
+      site.shortcuts = std::move(*shortcuts);
+    } else if (strict) {
+      return std::nullopt;
+    }
+  }
+  if (site.domains.empty() && site.search_template.empty()) {
+    return std::nullopt;
+  }
+  site.accessibility_description = site.VerbLabel() + u" " + site.label;
+  return site;
+}
+
+// Returns IDs from a list; strict parsing rejects non-strings and duplicates.
+std::optional<std::vector<std::string>> ParseIds(const base::DictValue& pref,
+                                                 std::string_view key,
+                                                 bool strict) {
+  const auto* value = pref.Find(key);
+  if (!value) {
+    return std::vector<std::string>();
+  }
+  if (!value->is_list()) {
+    if (strict) {
+      return std::nullopt;
+    }
+    return std::vector<std::string>();
+  }
+  std::vector<std::string> ids;
+  for (const auto& entry : value->GetList()) {
+    if (!entry.is_string() || std::ranges::contains(ids, entry.GetString())) {
+      if (strict) {
+        return std::nullopt;
+      }
+      continue;
+    }
+    ids.push_back(entry.GetString());
+  }
+  return ids;
+}
+
+// Produces the visible, ordered sites. Returns false only for strict failures.
+bool ParseCatalog(const base::DictValue& pref,
+                  bool strict,
+                  std::vector<CommandSite>* visible) {
+  if (strict && !HasOnlyKeys(pref, {kOrderKey, kHiddenKey, kSitesKey})) {
+    return false;
+  }
+  std::vector<CommandSite> builtins = Builtins();
+  std::map<std::string, CommandSite> customs;
+  const auto* sites_value = pref.Find(kSitesKey);
+  if (sites_value && !sites_value->is_dict() && strict) {
+    return false;
+  }
+  if (sites_value && sites_value->is_dict()) {
+    for (const auto [id, value] : sites_value->GetDict()) {
+      const auto* dict = value.GetIfDict();
+      auto builtin = std::ranges::find(builtins, id, &CommandSite::id);
+      if (builtin != builtins.end()) {
+        if (!dict || !ApplyOverride(*dict, strict, *builtin)) {
+          if (strict) {
+            return false;
+          }
+        }
+        continue;
+      }
+      std::optional<CommandSite> custom;
+      if (dict && CommandSiteCatalog::IsValidCustomId(id)) {
+        custom = ParseCustom(id, *dict, strict);
+      }
+      if (!custom) {
+        if (strict) {
+          return false;
+        }
+        continue;
+      }
+      customs.emplace(id, std::move(*custom));
+    }
+  }
+  if (customs.size() > CommandSiteCatalog::kMaxCustomSites) {
+    if (strict) {
+      return false;
+    }
+    customs.erase(std::next(customs.begin(),
+                            CommandSiteCatalog::kMaxCustomSites),
+                  customs.end());
+  }
+  auto known = [&](const std::string& id) {
+    return CommandSiteCatalog::IsBuiltinId(id) || customs.contains(id);
+  };
+  const auto order = ParseIds(pref, kOrderKey, strict);
+  const auto hidden = ParseIds(pref, kHiddenKey, strict);
+  if (!order || !hidden) {
+    return false;
+  }
+  if (strict && (!std::ranges::all_of(*order, known) ||
+                 !std::ranges::all_of(*hidden, known))) {
+    return false;
+  }
+  // Explicit order first; unlisted built-ins keep their default order, so new
+  // built-ins appear for existing profiles, then unlisted custom sites by ID.
+  std::vector<std::string> ids;
+  for (const auto& id : *order) {
+    if (known(id)) {
+      ids.push_back(id);
+    }
+  }
+  for (const auto& site : builtins) {
+    if (!std::ranges::contains(ids, site.id)) {
+      ids.push_back(site.id);
+    }
+  }
+  for (const auto& [id, site] : customs) {
+    if (!std::ranges::contains(ids, id)) {
+      ids.push_back(id);
+    }
+  }
+  visible->clear();
+  for (const auto& id : ids) {
+    if (std::ranges::contains(*hidden, id)) {
+      continue;
+    }
+    if (visible->size() == CommandSiteCatalog::kMaxSites) {
+      if (strict) {
+        return false;
+      }
+      break;
+    }
+    auto builtin = std::ranges::find(builtins, id, &CommandSite::id);
+    visible->push_back(builtin != builtins.end() ? std::move(*builtin)
+                                                 : std::move(customs.at(id)));
+  }
+  return true;
+}
+
+}  // namespace
+
+CommandSite::CommandSite() = default;
+CommandSite::CommandSite(const CommandSite&) = default;
+CommandSite& CommandSite::operator=(const CommandSite&) = default;
+CommandSite::CommandSite(CommandSite&&) = default;
+CommandSite& CommandSite::operator=(CommandSite&&) = default;
+CommandSite::~CommandSite() = default;
+
+bool CommandSite::MatchesUrl(const GURL& url) const {
+  if (!url.is_valid() || !url.SchemeIsHTTPOrHTTPS()) {
+    return false;
+  }
+  // DomainIs requires an exact host or a subdomain separated by a dot.
+  return std::ranges::any_of(
+      domains, [&url](const std::string& domain) { return url.DomainIs(domain); });
+}
+
+std::optional<GURL> CommandSite::BuildSearchUrl(
+    std::u16string_view query) const {
+  if (search_template.empty() || query.size() > CommandSession::kMaxQueryLength) {
+    return std::nullopt;
+  }
+  const std::u16string trimmed(base::TrimWhitespace(query, base::TRIM_ALL));
+  if (trimmed.empty()) {
+    return std::nullopt;
+  }
+  std::string spec = search_template;
+  const size_t position = spec.find(kPlaceholder);
+  if (position == std::string::npos) {
+    return std::nullopt;
+  }
+  // Substitution is literal; the template is never a format string.
+  spec.replace(position, 2,
+               base::EscapeQueryParamValue(base::UTF16ToUTF8(trimmed), false));
+  GURL url(spec);
+  if (!IsWebUrl(url) ||
+      !url::Origin::Create(url).IsSameOriginWith(
+          url::Origin::Create(ProbeTemplate(search_template)))) {
+    return std::nullopt;
+  }
+  return url;
+}
+
+GURL CommandSite::HomeUrl() const {
+  if (!domains.empty()) {
+    return GURL("https://" + domains.front() + "/");
+  }
+  const GURL probe = ProbeTemplate(search_template);
+  return probe.is_valid() ? probe.GetWithEmptyPath() : GURL();
+}
+
+std::u16string CommandSite::VerbLabel() const {
+  return verb == CommandSiteVerb::kAsk ? u"Ask" : u"Search";
+}
+
+base::DictValue CommandSite::ToValue() const {
+  base::ListValue domain_values;
+  for (const auto& domain : domains) {
+    domain_values.Append(domain);
+  }
+  base::ListValue shortcut_values;
+  for (const auto& shortcut : shortcuts) {
+    shortcut_values.Append(base::DictValue()
+                               .Set(kTitleKey, shortcut.title)
+                               .Set(kUrlKey, shortcut.url.spec()));
+  }
+  return base::DictValue()
+      .Set(kLabelKey, label)
+      .Set(kDomainsKey, std::move(domain_values))
+      .Set(kSearchKey, search_template)
+      .Set(kVerbKey, verb == CommandSiteVerb::kAsk ? "ask" : "search")
+      .Set(kTintKey, base::StringPrintf("#%02x%02x%02x", SkColorGetR(tint),
+                                        SkColorGetG(tint), SkColorGetB(tint)))
+      .Set(kShortcutsKey, std::move(shortcut_values));
+}
+
+CommandSiteCatalog::CommandSiteCatalog(std::vector<CommandSite> sites)
+    : sites_(std::move(sites)) {}
+CommandSiteCatalog::~CommandSiteCatalog() = default;
+
+// static
+scoped_refptr<const CommandSiteCatalog> CommandSiteCatalog::Builtin() {
+  return base::WrapRefCounted(new CommandSiteCatalog(Builtins()));
+}
+
+// static
+scoped_refptr<const CommandSiteCatalog> CommandSiteCatalog::FromPref(
+    const base::DictValue& pref) {
+  if (pref.empty()) {
+    return Builtin();
+  }
+  std::vector<CommandSite> sites;
+  ParseCatalog(pref, /*strict=*/false, &sites);
+  return base::WrapRefCounted(new CommandSiteCatalog(std::move(sites)));
+}
+
+// static
+bool CommandSiteCatalog::IsValidPref(const base::DictValue& pref) {
+  std::vector<CommandSite> sites;
+  return ParseCatalog(pref, /*strict=*/true, &sites);
+}
+
+// static
+std::vector<CommandSite> CommandSiteCatalog::BuiltinSites() {
+  return Builtins();
+}
+
+// static
+bool CommandSiteCatalog::IsBuiltinId(std::string_view id) {
+  return FindBuiltin(id) != nullptr;
+}
+
+// static
+bool CommandSiteCatalog::IsValidCustomId(std::string_view id) {
+  return !id.empty() && id.size() <= kMaxIdLength && !IsBuiltinId(id) &&
+         !IsReservedId(id) &&
+         std::ranges::all_of(id, [](char c) {
+           return base::IsAsciiLower(c) || base::IsAsciiDigit(c) || c == '-';
+         });
+}
+
+const CommandSite* CommandSiteCatalog::Find(std::string_view id) const {
+  const auto site = std::ranges::find(sites_, id, &CommandSite::id);
+  return site == sites_.end() ? nullptr : &*site;
+}
+
+std::vector<CommandScopeId> CommandSiteCatalog::ScopesForUrl(
+    const GURL& url) const {
+  std::vector<CommandScopeId> scopes;
+  for (const auto& site : sites_) {
+    if (site.MatchesUrl(url)) {
+      scopes.push_back(site.id);
+    }
+  }
+  return scopes;
+}
+
+std::optional<SkColor> CommandSiteCatalog::TintForUrl(const GURL& url) const {
+  if (!url.is_valid() || !url.SchemeIsHTTPOrHTTPS()) {
+    return std::nullopt;
+  }
+  const CommandSite* best = nullptr;
+  size_t best_length = 0;
+  for (const auto& site : sites_) {
+    for (const auto& domain : site.domains) {
+      if (url.DomainIs(domain) &&
+          (!best || domain.size() > best_length ||
+           (domain.size() == best_length && site.id < best->id))) {
+        best = &site;
+        best_length = domain.size();
+      }
+    }
+  }
+  return best ? std::make_optional(best->tint) : std::nullopt;
+}
+
+std::optional<GURL> CommandSiteCatalog::BuildSearchUrl(
+    std::string_view scope_id,
+    std::u16string_view query) const {
+  const auto* site = Find(scope_id);
+  return site ? site->BuildSearchUrl(query) : std::nullopt;
+}
+
+}  // namespace arcium
