+
+#include "chrome/browser/ui/omnibox/arcium_command_sites.h"
+
+#include <string>
+#include <vector>
+
+#include "base/check.h"
+#include "base/json/json_reader.h"
+#include "base/strings/string_number_conversions.h"
+#include "base/values.h"
+#include "testing/gtest/include/gtest/gtest.h"
+
+namespace arcium {
+namespace {
+
+base::DictValue Json(std::string_view json) {
+  auto value = base::JSONReader::ReadDict(json, base::JSON_PARSE_RFC);
+  CHECK(value) << json;
+  return std::move(*value);
+}
+
+std::vector<std::string> Ids(const CommandSiteCatalog& catalog) {
+  std::vector<std::string> ids;
+  for (const auto& site : catalog.sites()) {
+    ids.push_back(site.id);
+  }
+  return ids;
+}
+
+base::DictValue Custom(std::string_view id, std::string_view site_json) {
+  return Json(std::string("{\"sites\": {\"") + std::string(id) + "\": " +
+              std::string(site_json) + "}}");
+}
+
+TEST(CommandSiteCatalogTest, BuiltinsKeepTheirOrderSearchAndShortcuts) {
+  const auto catalog = CommandSiteCatalog::FromPref(base::DictValue());
+  EXPECT_EQ((std::vector<std::string>{kYouTubeScope, kXScope, kChatGPTScope}),
+            Ids(*catalog));
+  const auto* chatgpt = catalog->Find(kChatGPTScope);
+  ASSERT_TRUE(chatgpt);
+  EXPECT_EQ(u"Ask", chatgpt->VerbLabel());
+  EXPECT_EQ(u"Open a prompt in ChatGPT", chatgpt->accessibility_description);
+  ASSERT_EQ(2u, chatgpt->shortcuts.size());
+  EXPECT_EQ(u"New chat", chatgpt->shortcuts[0].title);
+  EXPECT_EQ(GURL("https://chatgpt.com/"), chatgpt->shortcuts[0].url);
+  for (const auto& site : catalog->sites()) {
+    EXPECT_TRUE(site.builtin);
+    EXPECT_FALSE(site.shortcuts.empty()) << site.id;
+    EXPECT_NE(CommandSiteArtwork::kFavicon, site.artwork) << site.id;
+  }
+}
+
+TEST(CommandSiteCatalogTest, SiteQueriesAreEncodedAndKeepTheirHttpsOrigin) {
+  const auto catalog = CommandSiteCatalog::Builtin();
+  const std::u16string query = u"  café & + ? / 東京  ";
+  const std::string encoded =
+      "caf%C3%A9%20%26%20%2B%20%3F%20%2F%20%E6%9D%B1%E4%BA%AC";
+  const auto youtube = catalog->BuildSearchUrl(kYouTubeScope, query);
+  const auto x = catalog->BuildSearchUrl(kXScope, query);
+  const auto chatgpt = catalog->BuildSearchUrl(kChatGPTScope, query);
+  ASSERT_TRUE(youtube);
+  ASSERT_TRUE(x);
+  ASSERT_TRUE(chatgpt);
+  EXPECT_EQ("https://www.youtube.com/results?search_query=" + encoded,
+            youtube->spec());
+  EXPECT_EQ("https://x.com/search?q=" + encoded + "&src=typed_query",
+            x->spec());
+  EXPECT_EQ("https://chatgpt.com/?q=" + encoded, chatgpt->spec());
+}
+
+TEST(CommandSiteCatalogTest, EncodedQueriesMayExceedTheStoredUrlLimit) {
+  // 230 characters fit the session limit; encoding expands each to 9 bytes.
+  const std::u16string query(230, u'東');
+  ASSERT_LE(query.size(), CommandSession::kMaxQueryLength);
+  const auto url = CommandSiteCatalog::Builtin()->BuildSearchUrl(kYouTubeScope, query);
+  ASSERT_TRUE(url);
+  EXPECT_GT(url->spec().size(), CommandSiteCatalog::kMaxUrlLength);
+  EXPECT_EQ("www.youtube.com", url->host());
+}
+
+TEST(CommandSiteCatalogTest, RejectsEmptyUnknownAndOversizeQueries) {
+  const auto catalog = CommandSiteCatalog::Builtin();
+  EXPECT_FALSE(catalog->BuildSearchUrl(kYouTubeScope, u" \t\n"));
+  EXPECT_FALSE(catalog->BuildSearchUrl("unknown-provider", u"query"));
+  EXPECT_FALSE(catalog->BuildSearchUrl(kWebScope, u"query"));
+  EXPECT_FALSE(catalog->BuildSearchUrl(
+      kYouTubeScope,
+      std::u16string(CommandSession::kMaxQueryLength + 1, u'x')));
+}
+
+TEST(CommandSiteCatalogTest, OrderHiddenAndOverridesApply) {
+  const auto catalog = CommandSiteCatalog::FromPref(Json(R"({
+    "order": ["chatgpt", "docs"],
+    "hidden": ["x"],
+    "sites": {
+      "youtube": {"label": "Videos", "tint": "#102030",
+                  "shortcuts": [{"title": "Later",
+                                 "url": "https://www.youtube.com/playlist?list=WL"}]},
+      "docs": {"label": "Docs", "domains": ["docs.rs"],
+               "search": "https://docs.rs/releases/search?query=%s"}
+    }
+  })"));
+  // Unlisted built-ins follow the explicit order; hidden sites disappear.
+  EXPECT_EQ((std::vector<std::string>{kChatGPTScope, "docs", kYouTubeScope}),
+            Ids(*catalog));
+  const auto* youtube = catalog->Find(kYouTubeScope);
+  ASSERT_TRUE(youtube);
+  EXPECT_EQ(u"Videos", youtube->label);
+  EXPECT_EQ(u"Search Videos", youtube->accessibility_description);
+  EXPECT_EQ(SkColorSetRGB(0x10, 0x20, 0x30), youtube->tint);
+  ASSERT_EQ(1u, youtube->shortcuts.size());
+  EXPECT_EQ(u"Later", youtube->shortcuts[0].title);
+  // Built-in search stays code-owned.
+  EXPECT_EQ("https://www.youtube.com/results?search_query=a",
+            catalog->BuildSearchUrl(kYouTubeScope, u"a")->spec());
+  EXPECT_EQ("https://docs.rs/releases/search?query=serde%20json",
+            catalog->BuildSearchUrl("docs", u"serde json")->spec());
+  EXPECT_FALSE(catalog->Find(kXScope));
+}
+
+TEST(CommandSiteCatalogTest, BuiltinOverridesCannotRedirectSearchOrDomains) {
+  const auto pref = Json(R"({"sites": {"youtube": {
+    "search": "https://evil.test/?q=%s", "domains": ["evil.test"]}}})");
+  EXPECT_FALSE(CommandSiteCatalog::IsValidPref(pref));
+  const auto catalog = CommandSiteCatalog::FromPref(pref);
+  EXPECT_EQ("https://www.youtube.com/results?search_query=a",
+            catalog->BuildSearchUrl(kYouTubeScope, u"a")->spec());
+  EXPECT_TRUE(catalog->ScopesForUrl(GURL("https://evil.test/")).empty());
+}
+
+TEST(CommandSiteCatalogTest, TemplatesNeedOneQueryValuePlaceholder) {
+  for (const char* search :
+       {"https://%s.example.test/", "https://example.test/%s",
+        "https://example.test/?q=x#%s", "https://user:pw@example.test/?q=%s",
+        "javascript:alert(%s)", "data:text/html,%s", "file:///tmp/?q=%s",
+        "https://example.test/?a=%s&b=%s", "https://example.test/?q=",
+        "https://example.test/?%s", "https://127.0.0.1/?q=%s",
+        "https://example.test/?q=arciumcommandsitequery&r=%s"}) {
+    SCOPED_TRACE(search);
+    const auto pref = Custom(
+        "custom",
+        std::string(R"({"label": "Custom", "search": ")") + search + "\"}");
+    EXPECT_FALSE(CommandSiteCatalog::IsValidPref(pref));
+    EXPECT_FALSE(CommandSiteCatalog::FromPref(pref)->Find("custom"));
+  }
+  const auto pref = Custom(
+      "custom",
+      R"({"label": "Custom", "search": "http://example.test/s?x=1&q=%s#top"})");
+  EXPECT_TRUE(CommandSiteCatalog::IsValidPref(pref));
+  const auto url =
+      CommandSiteCatalog::FromPref(pref)->BuildSearchUrl("custom", u"a#b&c");
+  ASSERT_TRUE(url);
+  EXPECT_EQ("http://example.test/s?x=1&q=a%23b%26c#top", url->spec());
+}
+
+TEST(CommandSiteCatalogTest, ShortcutsMustBeWebDestinations) {
+  for (const char* url :
+       {"javascript:alert(1)", "file:///etc/hosts", "chrome://settings",
+        "https://user@example.test/", "not a url"}) {
+    SCOPED_TRACE(url);
+    const auto pref = Json(std::string(R"({"sites": {"x": {"shortcuts": [
+        {"title": "Bad", "url": ")") + url + R"("},
+        {"title": "Good", "url": "https://x.com/home"}]}}})");
+    EXPECT_FALSE(CommandSiteCatalog::IsValidPref(pref));
+    const auto catalog = CommandSiteCatalog::FromPref(pref);
+    const auto* x = catalog->Find(kXScope);
+    ASSERT_TRUE(x);
+    ASSERT_EQ(1u, x->shortcuts.size());
+    EXPECT_EQ(u"Good", x->shortcuts[0].title);
+  }
+}
+
+TEST(CommandSiteCatalogTest, DuplicateShortcutUrlsAreRejected) {
+  const auto pref = Json(R"({"sites": {"x": {"shortcuts": [
+      {"title": "Home", "url": "https://x.com/home"},
+      {"title": "Again", "url": "https://x.com/home"},
+      {"title": "Fragment", "url": "https://x.com/home#top"}]}}})");
+  EXPECT_FALSE(CommandSiteCatalog::IsValidPref(pref));
+  const auto catalog = CommandSiteCatalog::FromPref(pref);
+  const auto* x = catalog->Find(kXScope);
+  ASSERT_TRUE(x);
+  ASSERT_EQ(2u, x->shortcuts.size());
+  EXPECT_EQ(GURL("https://x.com/home#top"), x->shortcuts[1].url);
+}
+
+TEST(CommandSiteCatalogTest, EmptyShortcutListRemovesBuiltinShortcuts) {
+  const auto pref = Json(R"({"sites": {"chatgpt": {"shortcuts": []}}})");
+  EXPECT_TRUE(CommandSiteCatalog::IsValidPref(pref));
+  const auto catalog = CommandSiteCatalog::FromPref(pref);
+  ASSERT_TRUE(catalog->Find(kChatGPTScope));
+  EXPECT_TRUE(catalog->Find(kChatGPTScope)->shortcuts.empty());
+}
+
+TEST(CommandSiteCatalogTest, InvalidEntriesDropAloneOnRead) {
+  const auto catalog = CommandSiteCatalog::FromPref(Json(R"({
+    "order": "chatgpt",
+    "hidden": [3, "youtube", "youtube"],
+    "sites": {
+      "omni": {"label": "Taken", "domains": ["omni.test"]},
+      "Bad ID": {"label": "Bad", "domains": ["bad.test"]},
+      "nolabel": {"domains": ["nolabel.test"]},
+      "nothing": {"label": "Nothing"},
+      "ok": {"label": "OK", "domains": ["ok.test", "Bad.Test", "ok.test"],
+             "verb": "shout", "tint": "red"},
+      "x": {"label": ""}
+    }
+  })"));
+  EXPECT_EQ((std::vector<std::string>{kXScope, kChatGPTScope, "ok"}),
+            Ids(*catalog));
+  const auto* ok = catalog->Find("ok");
+  ASSERT_TRUE(ok);
+  EXPECT_EQ((std::vector<std::string>{"ok.test"}), ok->domains);
+  EXPECT_EQ(CommandSiteVerb::kSearch, ok->verb);
+  EXPECT_NE(SK_ColorTRANSPARENT, ok->tint);
+  EXPECT_EQ(u"X", catalog->Find(kXScope)->label);
+}
+
+TEST(CommandSiteCatalogTest, StrictValidationRejectsUnknownKeysAndIds) {
+  EXPECT_TRUE(CommandSiteCatalog::IsValidPref(base::DictValue()));
+  EXPECT_TRUE(CommandSiteCatalog::IsValidPref(
+      Json(R"({"order": ["x", "youtube"], "hidden": ["chatgpt"]})")));
+  for (const char* json : {
+           R"({"extra": true})",
+           R"({"order": ["x", "x"]})",
+           R"({"order": ["missing"]})",
+           R"({"hidden": ["missing"]})",
+           R"({"sites": {"x": {"label": "X", "color": "#000000"}}})",
+           R"({"sites": {"custom": {"label": "C", "domains": ["c.test"],
+                                     "extra": 1}}})",
+           R"({"sites": {"web": {"label": "Web", "domains": ["w.test"]}}})",
+       }) {
+    SCOPED_TRACE(json);
+    EXPECT_FALSE(CommandSiteCatalog::IsValidPref(Json(json)));
+  }
+}
+
+TEST(CommandSiteCatalogTest, CapsCustomAndVisibleSites) {
+  base::DictValue sites;
+  for (int i = 0; i < 9; ++i) {
+    const std::string id = "site-" + base::NumberToString(i);
+    sites.Set(id, base::DictValue()
+                      .Set("label", id)
+                      .Set("domains", base::ListValue().Append(id + ".test")));
+  }
+  auto pref = base::DictValue().Set("sites", sites.Clone());
+  EXPECT_FALSE(CommandSiteCatalog::IsValidPref(pref));
+  EXPECT_EQ(CommandSiteCatalog::kMaxSites,
+            CommandSiteCatalog::FromPref(pref)->sites().size());
+  sites.Remove("site-8");
+  pref = base::DictValue().Set("sites", sites.Clone());
+  // Eight custom sites plus three built-ins exceed the visible rail.
+  EXPECT_FALSE(CommandSiteCatalog::IsValidPref(pref));
+  pref.Set("hidden",
+           base::ListValue().Append("youtube").Append("x").Append("chatgpt"));
+  EXPECT_TRUE(CommandSiteCatalog::IsValidPref(pref));
+}
+
+TEST(CommandSiteCatalogTest, OverlappingDomainsJoinEveryMatchingScope) {
+  const auto pref = Json(R"({
+    "order": ["music", "youtube"],
+    "sites": {"music": {"label": "Music", "domains": ["music.youtube.com"],
+                        "tint": "#010203"}}
+  })");
+  const auto catalog = CommandSiteCatalog::FromPref(pref);
+  const GURL music("https://music.youtube.com/watch?v=1");
+  EXPECT_EQ((std::vector<std::string>{"music", kYouTubeScope}),
+            catalog->ScopesForUrl(music));
+  EXPECT_EQ((std::vector<std::string>{kYouTubeScope}),
+            catalog->ScopesForUrl(GURL("https://www.youtube.com/")));
+  // The most specific domain colors the row regardless of rail order.
+  EXPECT_EQ(SkColorSetRGB(1, 2, 3), catalog->TintForUrl(music));
+  auto reordered = pref.Clone();
+  reordered.Set("order", base::ListValue().Append("youtube").Append("music"));
+  EXPECT_EQ(SkColorSetRGB(1, 2, 3),
+            CommandSiteCatalog::FromPref(reordered)->TintForUrl(music));
+  EXPECT_FALSE(catalog->TintForUrl(GURL("https://notyoutube.com/")));
+  EXPECT_FALSE(catalog->TintForUrl(GURL("ftp://youtube.com/")));
+}
+
+TEST(CommandSiteCatalogTest, SearchOnlySitesUseTheirSearchOrigin) {
+  const auto catalog = CommandSiteCatalog::FromPref(Custom(
+      "lookup",
+      R"({"label": "Lookup", "search": "https://lookup.test/find?q=%s",
+          "verb": "ask"})"));
+  const auto* site = catalog->Find("lookup");
+  ASSERT_TRUE(site);
+  EXPECT_EQ(GURL("https://lookup.test/"), site->HomeUrl());
+  EXPECT_EQ(u"Ask Lookup", site->accessibility_description);
+  EXPECT_TRUE(catalog->ScopesForUrl(GURL("https://lookup.test/")).empty());
+}
+
