+TEST_F(ArciumCommandActionRouterTest, ProductionEmptySiteScopesOfferShortcuts) {
+  auto session = CreateCommandSession(browser());
+  session->SetInvocation(CommandInvocationMode::kNewTab);
+  const auto catalog = CommandSiteCatalog::Builtin();
+  for (const char* scope : {kYouTubeScope, kXScope, kChatGPTScope}) {
+    SCOPED_TRACE(scope);
+    const auto* site = catalog->Find(scope);
+    ASSERT_TRUE(site);
+    for (const char16_t* query : {u"", u"  "}) {
+      const auto publication = SearchAndSettle(*session, scope, query);
+      ASSERT_TRUE(publication);
+      ASSERT_EQ(site->shortcuts.size(), publication->rows.size());
+      for (size_t i = 0; i < publication->rows.size(); ++i) {
+        const auto& row = publication->rows[i];
+        const auto& shortcut = site->shortcuts[i];
+        EXPECT_EQ(shortcut.title, row.title);
+        EXPECT_EQ(site->label, row.detail);
+        EXPECT_EQ(CommandTarget(CommandUrlTarget{.url = shortcut.url}),
+                  row.target);
+        EXPECT_EQ(kBuiltinCommandProvider, row.provider_id);
+        EXPECT_EQ("shortcut:" + std::string(scope) + ":" + shortcut.url.spec(),
+                  row.selection_key);
+        EXPECT_TRUE(row.has_actions);
+        EXPECT_FALSE(row.icon.isNull());
+        EXPECT_EQ(i == 0, row.is_default);
+      }
+    }
+  }
+  const auto saved = SearchAndSettle(*session, kSavedScope, u"");
+  ASSERT_TRUE(saved);
+  EXPECT_TRUE(ShortcutUrls(*saved).empty());
+  // A query searches the site; shortcuts do not compete with it.
+  const auto typed = SearchAndSettle(*session, kYouTubeScope, u"subscriptions");
+  ASSERT_TRUE(typed);
+  EXPECT_TRUE(ShortcutUrls(*typed).empty());
+  ASSERT_FALSE(typed->rows.empty());
+  EXPECT_EQ(CommandRowKind::kTypedSearch, typed->rows.back().kind);
+  EXPECT_TRUE(typed->rows.back().is_default);
+  session->Cancel();
+  session.reset();
+  base::RunLoop().RunUntilIdle();
+}
