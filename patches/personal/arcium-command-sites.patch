+TEST_F(ArciumCommandSitesSettingsTest, AddMintsIdsAndAppendsToOrder) {
+  ArciumSettingsModel model(profile(), base::DoNothing(), base::DoNothing());
+  auto* prefs = profile()->GetPrefs();
+  ASSERT_TRUE(model.SetCommandSites(Json(R"({"order": ["chatgpt"]})")));
+  const auto site = Json(R"({"label": "Docs", "domains": ["docs.rs"]})");
+  const std::string first = model.AddCommandSite(site);
+  const std::string second = model.AddCommandSite(site);
+  ASSERT_FALSE(first.empty());
+  ASSERT_FALSE(second.empty());
+  EXPECT_NE(first, second);
