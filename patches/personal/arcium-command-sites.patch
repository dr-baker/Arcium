+TEST_F(ArciumCommandSitesSettingsTest, EditorSeesSparseValueAndBuiltins) {
+  ArciumSettingsModel model(profile(), base::DoNothing(), base::DoNothing());
+  const auto state = model.GetCommandSites();
+  ASSERT_TRUE(state.FindDict("sites"));
+  EXPECT_TRUE(state.FindDict("sites")->empty());
+  const auto* builtins = state.FindList("builtins");
+  ASSERT_TRUE(builtins);
+  ASSERT_EQ(3u, builtins->size());
+  const auto& youtube = (*builtins)[0].GetDict();
+  EXPECT_EQ("youtube", *youtube.FindString("id"));
+  EXPECT_EQ("YouTube", *youtube.FindString("label"));
+  EXPECT_EQ("#e34b49", *youtube.FindString("tint"));
+  EXPECT_EQ("https://www.youtube.com/results?search_query=%s",
+            *youtube.FindString("search"));
+  EXPECT_EQ(3u, youtube.FindList("shortcuts")->size());
+
+  ASSERT_TRUE(model.SetCommandSites(Json(R"({"hidden": ["x"]})")));
+  // Hidden built-ins stay editable, and the saved value is returned as written.
+  EXPECT_EQ(3u, model.GetCommandSites().FindList("builtins")->size());
+  EXPECT_EQ(Json(R"({"hidden": ["x"]})"),
+            *model.GetCommandSites().FindDict("sites"));
