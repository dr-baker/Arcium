+base::DictValue ArciumSettingsModel::GetCommandSites() const {
+  base::ListValue builtins;
+  for (const auto& site : arcium::CommandSiteCatalog::BuiltinSites()) {
+    builtins.Append(site.ToValue().Set("id", site.id));
+  }
+  return base::DictValue()
+      .Set("sites", prefs_ && HasPreference(arcium::kCommandSitesPref)
+                        ? prefs_->GetDict(arcium::kCommandSitesPref).Clone()
+                        : base::DictValue())
+      .Set("builtins", std::move(builtins));
+}
+
+bool ArciumSettingsModel::SetCommandSites(const base::DictValue& sites) {
+  if (shutting_down_ || !prefs_ || !HasPreference(arcium::kCommandSitesPref) ||
+      !prefs_->IsUserModifiablePreference(arcium::kCommandSitesPref) ||
+      !arcium::CommandSiteCatalog::IsValidPref(sites)) {
+    return false;
+  }
+  if (sites.empty()) {
+    prefs_->ClearPref(arcium::kCommandSitesPref);
+  } else {
+    prefs_->SetDict(arcium::kCommandSitesPref, sites.Clone());
+  }
+  return true;
+}
+
+std::string ArciumSettingsModel::AddCommandSite(const base::DictValue& site) {
+  if (shutting_down_ || !prefs_ || !HasPreference(arcium::kCommandSitesPref) ||
+      !prefs_->IsUserModifiablePreference(arcium::kCommandSitesPref)) {
+    return std::string();
+  }
+  auto sites = prefs_->GetDict(arcium::kCommandSitesPref).Clone();
+  auto* entries = sites.EnsureDict("sites");
+  std::string id;
+  for (int attempt = 0; attempt < 8 && (id.empty() || entries->contains(id));
+       ++attempt) {
+    id = "site-" + base::HexEncodeLower(base::RandBytesAsVector(4));
+  }
+  if (entries->contains(id)) {
+    return std::string();
+  }
+  entries->Set(id, site.Clone());
+  if (auto* order = sites.FindList("order")) {
+    order->Append(id);
+  }
+  return SetCommandSites(sites) ? id : std::string();
+}
