+TEST_F(ArciumNativePanelTest, ResultCountUpdatesWithoutReplacingInput) {
+  Open();
+  Query(u"interface");
+  auto* input = panel()->input_for_testing();
+  input->SetSelectedRange(gfx::Range(1, 4));
+  CommandPanelAppearance appearance;
+  appearance.result_count = 2;
+  panel()->SetAppearance(appearance);
+  EXPECT_EQ(2u, panel()->row_count_for_testing());
+  EXPECT_EQ(input, panel()->input_for_testing());
+  EXPECT_EQ(u"interface", input->GetText());
+  EXPECT_EQ(gfx::Range(1, 4), input->GetSelectedRange());
+  appearance.result_count = 8;
+  panel()->SetAppearance(appearance);
+  EXPECT_GT(panel()->row_count_for_testing(), 2u);
+}
+
+TEST(CommandPanelAppearanceTest, DetachedFlushUsesTabsAndCountIsBounded) {
+  TestingPrefServiceSimple prefs;
+  prefs.registry()->RegisterDictionaryPref(kCommandPanelLayoutPref);
+  prefs.registry()->RegisterDictionaryPref(helium::kArciumChromeAppearancePref);
+  for (int count : {0, 1, 8, 20, 21}) {
+    prefs.SetDict(kCommandPanelLayoutPref, base::DictValue()
+        .Set("connected", false).Set("scope_width", 0).Set("result_count", count));
+    const auto appearance = ReadCommandPanelAppearance(&prefs);
+    EXPECT_EQ(CommandPanelAppearance::Width::kOffset, appearance.scope_width);
+    EXPECT_EQ(count >= 1 && count <= 20 ? count : 8, appearance.result_count);
+  }
+}
+
+TEST_F(ArciumNativePanelTest, ExamplesCoverEveryScopeActivityAndDestinationWithoutAuthority) {
+  CommandExampleSession session(TestScopes());
+  for (const auto& scope : session.GetScopes()) {
+    std::shared_ptr<const CommandPublication> result;
+    session.Search(scope.id, u"", base::BindLambdaForTesting(
+        [&](std::shared_ptr<const CommandPublication> value) { result = std::move(value); }));
+    ASSERT_TRUE(result);
+    ASSERT_EQ(8u, result->rows.size());
+    EXPECT_EQ(scope.id, result->scope_id);
+    for (const auto activity : {CommandActivity::kNone, CommandActivity::kDot,
+                                CommandActivity::kCircle, CommandActivity::kCircleDot}) {
+      EXPECT_TRUE(std::ranges::any_of(result->rows, [&](const auto& row) { return row.activity == activity; }));
+    }
+    for (const auto icon : {CommandPrimaryIcon::kGo, CommandPrimaryIcon::kSwitch, CommandPrimaryIcon::kAction}) {
+      EXPECT_TRUE(std::ranges::any_of(result->rows, [&](const auto& row) { return row.primary_icon == icon; }));
+    }
+    CommandIntent intent;
+    intent.target = result->rows.front().target;
+    EXPECT_FALSE(session.Execute(intent).success);
+    EXPECT_FALSE(session.Execute(intent).dismiss);
+    const auto menu = session.ResolveActions(intent.target, "", u"");
+    ASSERT_FALSE(menu.entries.empty());
+    for (const auto& entry : menu.entries) EXPECT_FALSE(entry.intent.has_value());
+    session.SetResultLimit(20);
+    session.Search(scope.id, u"", base::BindLambdaForTesting(
+        [&](std::shared_ptr<const CommandPublication> value) { result = std::move(value); }));
+    EXPECT_EQ(20u, result->rows.size());
+    session.SetResultLimit(8);
+    session.Search(scope.id, u"no-matching-example", base::BindLambdaForTesting(
+        [&](std::shared_ptr<const CommandPublication> value) { result = std::move(value); }));
+    ASSERT_EQ(1u, result->rows.size());
+    EXPECT_EQ(CommandRowKind::kTypedSearch, result->rows.front().kind);
+  }
+}
