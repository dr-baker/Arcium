--- /dev/null
+++ src/chrome/browser/ui/omnibox/arcium_command_example_session.h
@@ -0,0 +1,113 @@
+// Copyright 2026 The Helium Authors
+// Use of this source code is governed by the GPL-3.0 license.
+#ifndef CHROME_BROWSER_UI_OMNIBOX_ARCIUM_COMMAND_EXAMPLE_SESSION_H_
+#define CHROME_BROWSER_UI_OMNIBOX_ARCIUM_COMMAND_EXAMPLE_SESSION_H_
+
+#include <algorithm>
+#include <utility>
+#include "base/strings/string_util.h"
+#include "base/strings/string_number_conversions.h"
+#include "chrome/browser/ui/omnibox/arcium_command_session.h"
+
+namespace arcium {
+
+// Deterministic Settings examples. No profile targets, network requests or
+// executable intents are retained, even when an example action menu is open.
+class CommandExampleSession final : public CommandSession {
+ public:
+  explicit CommandExampleSession(std::vector<CommandScopeDescriptor> scopes)
+      : scopes_(std::move(scopes)) {}
+  void SetInvocation(CommandInvocationMode) override {}
+  void SetResultLimit(size_t limit) override { limit_ = std::clamp(limit, size_t{1}, kMaxRows); }
+  std::vector<CommandScopeDescriptor> GetScopes() const override { return scopes_; }
+  void Search(CommandScopeId scope, std::u16string query,
+              CommandPublishCallback publish) override {
+    auto result = std::make_shared<CommandPublication>();
+    result->query_epoch = ++epoch_;
+    result->revision = base::UnguessableToken::Create();
+    result->scope_id = scope;
+    result->query = query;
+    result->scopes = scopes_;
+    const auto descriptor = std::ranges::find(scopes_, scope, &CommandScopeDescriptor::id);
+    const auto label = descriptor == scopes_.end() ? u"Search" : descriptor->label;
+    struct Example {
+      const char16_t* title;
+      const char16_t* detail;
+      const char16_t* category;
+      CommandPrimaryIcon icon;
+      CommandActivity activity;
+    };
+    const Example examples[] = {
+        {u"Project notes", u"Open tab · Work", u"Tab", CommandPrimaryIcon::kSwitch, CommandActivity::kDot},
+        {u"Design reference", u"Pinned page · Design", u"Pin", CommandPrimaryIcon::kGo, CommandActivity::kNone},
+        {u"Daily reading", u"Favorite · Personal", u"Favorite", CommandPrimaryIcon::kSwitch, CommandActivity::kCircle},
+        {u"Research collection", u"Folder · Work", u"Folder", CommandPrimaryIcon::kAction, CommandActivity::kCircleDot},
+        {u"Example website", u"example.com", u"History", CommandPrimaryIcon::kGo, CommandActivity::kNone},
+        {u"Team discussion", u"Open tab · Work", u"Tab", CommandPrimaryIcon::kSwitch, CommandActivity::kDot},
+        {u"Search ideas", u"Search this scope", u"Search", CommandPrimaryIcon::kGo, CommandActivity::kNone},
+        {u"Organize this page", u"Preview actions", u"Action", CommandPrimaryIcon::kAction, CommandActivity::kNone}};
+    const auto needle = base::ToLowerASCII(query.substr(0, kMaxQueryLength));
+    for (size_t i = 0; i < kMaxRows && result->rows.size() < limit_; ++i) {
+      const auto& example = examples[i % std::size(examples)];
+      CommandRow row;
+      row.provider_id = "settings-example";
+      row.selection_key = scope + ":example:" + std::to_string(i);
+      row.target = CommandProviderTarget{row.provider_id, row.selection_key};
+      row.title = scope == kOmniScope || scope == kSavedScope
+                      ? std::u16string(example.title)
+                      : label + u": " + example.title;
+      if (i >= std::size(examples)) row.title += u" " + base::NumberToString16(i + 1);
+      row.detail = example.detail;
+      row.category = example.category;
+      row.primary_icon = example.icon;
+      row.primary_verb = example.icon == CommandPrimaryIcon::kSwitch ? u"Switch"
+                         : example.icon == CommandPrimaryIcon::kAction ? u"Open" : u"Go";
+      row.activity = example.activity;
+      row.has_actions = true;
+      if (descriptor != scopes_.end()) { row.icon = descriptor->icon; row.tint = descriptor->tint; }
+      if (needle.empty() || base::ToLowerASCII(row.title + u" " + row.detail + u" " + row.category).find(needle) != std::u16string::npos) {
+        row.is_default = result->rows.empty();
+        result->rows.push_back(std::move(row));
+      }
+    }
+    if (!query.empty()) {
+      if (result->rows.size() >= limit_) result->rows.pop_back();
+      CommandRow search;
+      search.kind = CommandRowKind::kTypedSearch;
+      search.provider_id = "settings-example";
+      search.selection_key = scope + ":search";
+      search.target = CommandProviderTarget{search.provider_id, search.selection_key};
+      search.title = u"Search " + label + u" for “" + query.substr(0, kMaxQueryLength) + u"”";
+      search.detail = u"Example only";
+      search.category = u"Search";
+      search.primary_verb = u"Go";
+      search.is_default = result->rows.empty();
+      if (descriptor != scopes_.end()) { search.icon = descriptor->icon; search.tint = descriptor->tint; }
+      result->rows.push_back(std::move(search));
+    }
+    publish.Run(std::move(result));
+  }
+  void Cancel() override {}
+  CommandMenu ResolveActions(const CommandTarget&, std::string_view,
+                            std::u16string_view) override {
+    CommandMenu menu;
+    menu.title = u"Example actions";
+    for (const auto* label : {u"Open in a new tab", u"Move to another Space", u"Copy link"}) {
+      CommandMenuEntry entry;
+      entry.id = std::to_string(menu.entries.size());
+      entry.label = label;
+      entry.detail = u"Example only";
+      menu.entries.push_back(std::move(entry));
+    }
+    return menu;
+  }
+  CommandExecutionResult Execute(const CommandIntent&) override {
+    return {false, false, u"Example only"};
+  }
+ private:
+  std::vector<CommandScopeDescriptor> scopes_;
+  size_t limit_ = kMaxResults;
+  uint64_t epoch_ = 0;
+};
+}  // namespace arcium
+#endif  // CHROME_BROWSER_UI_OMNIBOX_ARCIUM_COMMAND_EXAMPLE_SESSION_H_
