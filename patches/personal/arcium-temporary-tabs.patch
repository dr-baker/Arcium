+std::vector<content::WebContents*> BrowserLiveTabContext::GetSessionContents()
+    const {
+  std::vector<content::WebContents*> contents;
+  for (const tabs::TabInterface* tab : *tab_strip_model_) {
+    if (!tabs::TemporaryTab::IsTemporary(tab->GetContents())) {
+      contents.push_back(tab->GetContents());
+    }
+  }
+  return contents;
+}
+
+content::WebContents* BrowserLiveTabContext::GetSessionSelectedContents()
+    const {
+  content::WebContents* selected = tab_strip_model_->GetActiveWebContents();
+  const auto* marker =
+      selected ? tabs::TemporaryTab::FromWebContents(selected) : nullptr;
+  if (marker && marker->is_temporary()) {
+    selected = marker->source_contents();
+  }
+  const auto contents = GetSessionContents();
+  for (content::WebContents* tab : contents) {
+    if (tab == selected) {
+      return tab;
+    }
+  }
+  return contents.empty() ? nullptr : contents.front();
+}
+
+int BrowserLiveTabContext::GetModelIndexForSessionIndex(int index) const {
+  const auto contents = GetSessionContents();
+  CHECK_GE(index, 0);
