@@ -0,0 +1,51 @@
+// Copyright 2026 The Chromium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "components/tabs/public/temporary_tab.h"
+
+#include <utility>
+
+#include "base/check.h"
+#include "content/public/browser/web_contents.h"
+
+namespace tabs {
+
+TemporaryTab::TemporaryTab(content::WebContents* contents,
+                           content::WebContents* source_contents)
+    : content::WebContentsUserData<TemporaryTab>(*contents),
+      source_contents_(source_contents
+                           ? source_contents->GetWeakPtr()
+                           : base::WeakPtr<content::WebContents>()) {
+  CHECK_NE(contents, source_contents);
+}
+
+TemporaryTab::~TemporaryTab() = default;
+
+// static
+bool TemporaryTab::IsTemporary(const content::WebContents* contents) {
+  const TemporaryTab* marker = contents ? FromWebContents(contents) : nullptr;
+  return marker && marker->is_temporary();
+}
+
+content::WebContents* TemporaryTab::source_contents() const {
+  return source_contents_.get();
+}
+
+void TemporaryTab::Promote() {
+  if (!is_temporary_) {
+    return;
+  }
+  is_temporary_ = false;
+  promoted_callbacks_.Notify();
+  source_contents_.reset();
+}
+
+base::CallbackListSubscription TemporaryTab::RegisterOnPromoted(
+    base::RepeatingClosure callback) {
+  return promoted_callbacks_.Add(std::move(callback));
+}
+
+WEB_CONTENTS_USER_DATA_KEY_IMPL(TemporaryTab);
+
+}  // namespace tabs
