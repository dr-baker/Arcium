+// Copyright 2026 The Arcium Authors
+// Use of this source code is governed by the GPL-3.0 license.
+#include "chrome/browser/ui/views/omnibox/arcium_command_panel_presentation.h"
+
+#include <algorithm>
+#include <utility>
+
+#include "base/check.h"
+#include "base/functional/bind.h"
+#include "base/numerics/safe_conversions.h"
+#include "base/task/single_thread_task_runner.h"
+#include "chrome/browser/ui/views/omnibox/arcium_command_bar_material.h"
+#include "chrome/browser/ui/views/omnibox/arcium_command_panel.h"
+#include "ui/base/class_property.h"
+#include "ui/views/view.h"
+#include "ui/views/widget/widget.h"
+#include "ui/views/widget/widget_delegate.h"
+
+DEFINE_UI_CLASS_PROPERTY_TYPE(arcium::CommandPanelPresentation*)
+DEFINE_UI_CLASS_PROPERTY_TYPE(arcium::CommandPanelPresentation::SessionFactory*)
+namespace arcium {
+namespace {
+DEFINE_OWNED_UI_CLASS_PROPERTY_KEY(CommandPanelPresentation, kCommandPresentation)
+DEFINE_OWNED_UI_CLASS_PROPERTY_KEY(CommandPanelPresentation::SessionFactory, kTestSessionFactory)
+}
+
+CommandPanelPresentation* CommandPanelPresentation::Get(const views::View* owner) {
+  return owner ? owner->GetProperty(kCommandPresentation) : nullptr;
+}
+CommandPanelPresentation* CommandPanelPresentation::Install(views::View* owner,
+                                                           Options options) {
+  CHECK(owner);
+  CHECK(!Get(owner));
+  auto presentation = std::make_unique<CommandPanelPresentation>(std::move(options));
+  presentation->owner_ = owner;
+  return owner->SetProperty(kCommandPresentation, std::move(presentation));
+}
+void CommandPanelPresentation::SetSessionFactoryForTesting(views::View* owner,
+                                                            SessionFactory factory) {
+  CHECK(owner);
+  if (auto* presentation = Get(owner)) presentation->Destroy(true);
+  if (factory) owner->SetProperty(kTestSessionFactory, std::make_unique<SessionFactory>(std::move(factory)));
+  else owner->ClearProperty(kTestSessionFactory);
+}
+CommandPanelPresentation::CommandPanelPresentation(Options options)
+    : options_(std::move(options)), parent_(options_.parent) {
+  CHECK(parent_);
+  CHECK(options_.prefs);
+  CHECK(options_.create_session);
+  CHECK(options_.scale);
+  options_.parent = nullptr;
+  parent_->AddObserver(this);
+}
+CommandPanelPresentation::~CommandPanelPresentation() {
+  weak_factory_.InvalidateWeakPtrs();
+  if (parent_) parent_->RemoveObserver(this);
+  parent_ = nullptr;
+  owner_ = nullptr;
+  DestroyPopup(false, false);
+}
+gfx::Rect CommandPanelPresentation::AnchorBounds() const {
+  if (!parent_) return {};
+  return options_.anchor_bounds ? options_.anchor_bounds.Run()
+                                : parent_->GetWindowBoundsInScreen();
+}
+gfx::Rect CommandPanelPresentation::PopupBounds(const gfx::Rect& anchor,
+                                               float scale, int height) {
+  const int width = std::max(280, std::min(base::ClampRound(824 * scale), anchor.width() - 32));
+  return gfx::Rect(anchor.CenterPoint().x() - width / 2,
+      anchor.y() + std::max(16, base::ClampRound(anchor.height() * .11 - 48 * scale)),
+      width, height);
+}
+bool CommandPanelPresentation::is_open() const {
+  return widget_ && !closing_ && !widget_->IsClosed();
+}
+bool CommandPanelPresentation::Show(bool new_tab) {
+  if (!parent_ || parent_->IsClosed()) return false;
+  if (closing_ || destroying_) {
+    pending_invocation_ = new_tab;
+    return true;
+  }
+  const auto life = weak_factory_.GetWeakPtr();
+  new_tab_ = new_tab;
+  auto invocation_changed = options_.invocation_changed;
+  if (invocation_changed) invocation_changed.Run(new_tab);
+  if (!life) return false;
+  if (widget_) {
+    panel_->SetInvocation(new_tab);
+    if (!life || !widget_) return true;
+    widget_->Activate();
+    return true;
+  }
+  const auto started = base::TimeTicks::Now();
+  auto create_session = options_.create_session;
+  if (owner_) {
+    if (const auto* override = owner_->GetProperty(kTestSessionFactory)) create_session = *override;
+  }
+  auto session = create_session.Run();
+  if (!life || !session || !parent_) return false;
+  auto view = std::make_unique<CommandPanelView>(std::move(session),
+      base::BindRepeating(&CommandPanelPresentation::Close, weak_factory_.GetWeakPtr(), false),
+      base::BindRepeating([](base::WeakPtr<CommandPanelPresentation> owner, bool invocation) {
+        if (owner) owner->Show(invocation);
+      }, weak_factory_.GetWeakPtr()), new_tab);
+  panel_ = view.get();
+  panel_->BindPreferences(options_.prefs, options_.scale,
+      base::BindRepeating([](base::WeakPtr<CommandPanelPresentation> owner) {
+        return owner ? std::max(280, owner->AnchorBounds().width() - 32) : 280;
+      }, weak_factory_.GetWeakPtr()));
+  delegate_ = std::make_unique<views::WidgetDelegate>();
+  delegate_->SetCanActivate(true);
+  delegate_->SetContentsView(std::move(view));
+  delegate_->RegisterWindowClosingCallback(base::BindOnce(
+      &CommandPanelPresentation::WindowClosing, weak_factory_.GetWeakPtr()));
+  widget_ = std::make_unique<views::Widget>();
+  views::Widget::InitParams params(views::Widget::InitParams::CLIENT_OWNS_WIDGET,
+      views::Widget::InitParams::TYPE_WINDOW_FRAMELESS);
+  params.opacity = views::Widget::InitParams::WindowOpacity::kTranslucent;
+  params.parent = parent_->GetNativeView();
+  params.bounds = PopupBounds(AnchorBounds(), options_.scale.Run(), panel_->GetPreferredSize().height());
+  params.delegate = delegate_.get();
+  widget_->Init(std::move(params));
+  widget_->SetColorModeOverride(options_.color_mode);
+  widget_->AddObserver(this);
+  accepted_ = false;
+  widget_->GetRootView()->DeprecatedLayoutImmediately();
+  material_ = std::make_unique<CommandBarMaterial>(widget_.get(), options_.prefs,
+      base::BindRepeating([](base::WeakPtr<CommandPanelPresentation> owner) {
+        CommandBarMaterial::Clip clip;
+        if (owner && owner->panel_) clip.contour = owner->panel_->GetContourPath();
+        return clip;
+      }, weak_factory_.GetWeakPtr()),
+      base::BindRepeating([](base::WeakPtr<CommandPanelPresentation> owner, bool enabled) {
+        if (owner && owner->panel_) owner->panel_->SetNativeMaterial(enabled);
+      }, weak_factory_.GetWeakPtr()));
+  panel_->SetGeometryChangedCallback(base::BindRepeating(
+      &CommandPanelPresentation::RefreshMaterial, weak_factory_.GetWeakPtr()));
+  material_->Refresh();
+  auto panel_changed = options_.panel_changed;
+  if (panel_changed) panel_changed.Run(panel_);
+  if (!life || !widget_ || !panel_ || closing_) return true;
+  widget_->Show();
+  if (!life || !widget_ || !panel_ || closing_) return true;
+  panel_->SetHeightResizeCallback(base::BindRepeating(
+      [](base::WeakPtr<CommandPanelPresentation> owner, std::optional<int> height,
+         base::TimeDelta duration) {
+        return owner && owner->material_ ? owner->material_->ResizeHeight(height, duration) : 0;
+      }, weak_factory_.GetWeakPtr()));
+  panel_->FocusInput();
+  auto opened = options_.opened;
+  if (opened) opened.Run(widget_.get(), started);
+  return true;
+}
+void CommandPanelPresentation::RefreshMaterial() {
+  if (material_) material_->Refresh();
+}
+void CommandPanelPresentation::RefreshContext() {
+  if (!widget_ || !panel_ || closing_) return;
+  panel_->SetUIScale(options_.scale.Run());
+  widget_->SetBounds(PopupBounds(AnchorBounds(), options_.scale.Run(),
+                                widget_->GetWindowBoundsInScreen().height()));
+  widget_->ThemeChanged();
+  RefreshMaterial();
+}
+void CommandPanelPresentation::Close(bool accepted) {
+  pending_invocation_.reset();
+  accepted_ |= accepted;
+  if (!widget_ || closing_) return;
+  closing_ = true;
+  // Executing a row can navigate or activate another window. Finish its
+  // controller callback before closing the native widget.
+  base::SingleThreadTaskRunner::GetCurrentDefault()->PostTask(FROM_HERE,
+      base::BindOnce([](base::WeakPtr<CommandPanelPresentation> owner) {
+        if (owner && owner->widget_ && !owner->widget_->IsClosed()) owner->widget_->Close();
+      }, weak_factory_.GetWeakPtr()));
+}
+void CommandPanelPresentation::WindowClosing() {
+  if (destroying_) return;
+  closing_ = true;
+  ScheduleDestruction();
+}
+void CommandPanelPresentation::ScheduleDestruction() {
+  if (destruction_pending_ || destroying_) return;
+  destruction_pending_ = true;
+  base::SingleThreadTaskRunner::GetCurrentDefault()->PostTask(FROM_HERE,
+      base::BindOnce(&CommandPanelPresentation::DestroyPopup,
+                    weak_factory_.GetWeakPtr(), true, true));
+}
+void CommandPanelPresentation::Destroy(bool accepted) {
+  accepted_ |= accepted;
+  pending_invocation_.reset();
+  DestroyPopup(false, true);
+}
+void CommandPanelPresentation::DestroyPopup(bool reopen_pending, bool notify) {
+  if (destroying_) return;
+  const auto pending = reopen_pending && parent_ ? pending_invocation_ : std::nullopt;
+  pending_invocation_.reset();
+  destruction_pending_ = false;
+  if (!widget_) return;
+  destroying_ = true;
+  closing_ = true;
+  // Old Close/Destroy tasks must never operate on a later popup generation.
+  weak_factory_.InvalidateWeakPtrs();
+  const auto closing_life = weak_factory_.GetWeakPtr();
+  auto will_close = options_.will_close;
+  if (notify && panel_ && will_close) will_close.Run(panel_);
+  if (!closing_life) return;
+  if (panel_) {
+    panel_->SetGeometryChangedCallback({});
+    panel_->SetHeightResizeCallback({});
+  }
+  material_.reset();
+  widget_->RemoveObserver(this);
+  auto widget = std::move(widget_);
+  panel_ = nullptr;
+  if (!widget->IsClosed()) widget->CloseNow();
+  widget.reset();
+  delegate_.reset();
+  const bool accepted = accepted_;
+  accepted_ = false;
+  closing_ = false;
+  destroying_ = false;
+  const auto weak = weak_factory_.GetWeakPtr();
+  auto panel_changed = options_.panel_changed;
+  if (notify && panel_changed) panel_changed.Run(nullptr);
+  if (notify && !weak) return;
+  auto closed = options_.closed;
+  if (notify && closed) closed.Run(accepted, pending.has_value());
+  if (notify && !weak) return;
+  if (pending) Show(*pending);
+}
+void CommandPanelPresentation::OnWidgetActivationChanged(views::Widget* widget, bool active) {
+  if (widget == widget_.get() && !active && !closing_ && !destroying_) Close(false);
+}
+void CommandPanelPresentation::OnWidgetDestroying(views::Widget* widget) {
+  if (widget == parent_) {
+    parent_->RemoveObserver(this);
+    parent_ = nullptr;
+    Destroy(true);
+  } else if (widget == widget_.get() && !destroying_) {
+    closing_ = true;
+    ScheduleDestruction();
+  }
+}
+void CommandPanelPresentation::OnWidgetBoundsChanged(views::Widget* widget, const gfx::Rect&) {
+  if (widget == parent_) Close(false);
+}
+void CommandPanelPresentation::OnWidgetThemeChanged(views::Widget* widget) {
+  if (widget == parent_ && widget_ && !closing_) widget_->ThemeChanged();
+}
