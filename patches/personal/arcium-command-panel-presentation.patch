+  }
+  for (const char* surface : {"refractive", "quiet", "solid", "custom"}) {
+    auto document = result.front().Clone(); document.Set("name", std::string("surface-") + surface);
+    document.EnsureDict("context")->Set("surface_set", surface);
+    document.EnsureDict("context")->Set("command_material", 2); result.push_back(std::move(document));
