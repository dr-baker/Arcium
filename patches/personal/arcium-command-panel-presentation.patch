+SkColor ContextColor(const base::DictValue* palette, const char* name, SkColor fallback) {
+  if (!palette) return fallback;
+  const auto* text = palette->FindString(name);
+  uint32_t color = 0;
+  if (!text || text->size() != 7 || (*text)[0] != '#' ||
+      !base::HexStringToUInt(std::string_view(*text).substr(1), &color)) return fallback;
+  return SkColorSetRGB((color >> 16) & 255, (color >> 8) & 255, color & 255);
+}
+struct Step {
+  int delay_ms;
+  int rows;
+  bool done;
+  bool reorder = false;
+};
+
+class ScriptedSession : public CommandSession {
+ public:
+  explicit ScriptedSession(const base::DictValue& document)
+      : examples_(ScenarioScopes()) {
+    fixture_ = *document.FindString("fixture");
+    if (const auto* steps = document.FindList("publications")) {
+      for (const auto& value : *steps) {
+        const auto& step = value.GetDict();
+        steps_.push_back({*step.FindInt("delay_ms"), *step.FindInt("rows"),
+                          *step.FindBool("done"), step.FindBool("reorder").value_or(false)});
+      }
+    } else if (fixture_ == "streaming") {
+      steps_ = {{0, 4, false}, {45, 8, false}, {120, 2, false},
+                {180, 8, false, true}, {260, 6, true}};
+    } else {
+      steps_ = {{0, fixture_ == "empty" ? 0 : 20, true}};
+    }
+  }
+  ~ScriptedSession() override { Cancel(); }
+  void SetInvocation(CommandInvocationMode mode) override { examples_.SetInvocation(mode); }
+  void SetResultLimit(size_t limit) override { limit_ = std::clamp(limit, size_t{1}, size_t{20}); }
+  std::vector<CommandScopeDescriptor> GetScopes() const override { return ScenarioScopes(); }
+  void Search(CommandScopeId scope, std::u16string query, CommandPublishCallback publish) override {
+    Cancel();
+    const uint64_t epoch = ++epoch_;
+    examples_.SetResultLimit(20);
+    CommandPublicationPtr full;
+    examples_.Search(scope, fixture_ == "streaming" ? std::u16string() : query, base::BindRepeating(
+        [](CommandPublicationPtr* result, CommandPublicationPtr publication) { *result = std::move(publication); },
+        &full));
+    if (fixture_ == "streaming") {
+      auto unfiltered = std::make_shared<CommandPublication>(*full);
+      unfiltered->query = query; full = std::move(unfiltered);
+    }
+    for (const auto& step : steps_) {
+      if (steps_.size() == 1 && step.delay_ms == 0 && fixture_ != "streaming") {
+        Publish(full, step, epoch, publish);
+        continue;
+      }
+      base::SingleThreadTaskRunner::GetCurrentDefault()->PostDelayedTask(FROM_HERE,
+          base::BindOnce(&ScriptedSession::Publish, weak_factory_.GetWeakPtr(), full,
+                        step, epoch, publish), base::Milliseconds(step.delay_ms));
+    }
+  }
+  void Cancel() override { weak_factory_.InvalidateWeakPtrs(); }
+  CommandMenu ResolveActions(const CommandTarget& target, std::string_view id,
+                             std::u16string_view query) override {
+    return examples_.ResolveActions(target, id, query);
+  }
+  CommandExecutionResult Execute(const CommandIntent&) override {
+    return {false, false, u"Example only"};
+  }
+ private:
+  void Publish(CommandPublicationPtr full, Step step, uint64_t epoch,
+               CommandPublishCallback publish) {
+    auto result = std::make_shared<CommandPublication>(*full);
+    result->query_epoch = epoch;
+    result->revision = base::UnguessableToken::Create();
+    result->done = step.done;
+    result->rows.resize(std::min({result->rows.size(), limit_, static_cast<size_t>(step.rows)}));
+    if (step.reorder && result->rows.size() > 1)
+      std::rotate(result->rows.begin(), result->rows.begin() + 1, result->rows.end());
+    if (fixture_ == "long") {
+      for (auto& row : result->rows) {
+        row.title += u" · A long title to check truncation, spacing, icons and selection across window sizes";
+        row.detail += u" · A second long line with more context for this example";
+      }
+    }
+    publish.Run(std::move(result));
+  }
+  CommandExampleSession examples_;
+  std::string fixture_;
+  std::vector<Step> steps_;
+  size_t limit_ = 8;
+  uint64_t epoch_ = 0;
+  base::WeakPtrFactory<ScriptedSession> weak_factory_{this};
+};
+}  // namespace
+
+base::DictValue DefaultScenario(std::string_view fixture) {
+  base::DictValue result;
+  result.Set("schema", "arcium-ui-workshop");
+  result.Set("version", 1);
+  result.Set("component", "command-bar");
+  result.Set("fixture", std::string(fixture));
+  result.Set("query", "");
+  result.Set("scope", "omni");
+  return result;
+}
+bool ValidateScenario(const base::DictValue& document, std::string* error) {
+  auto fail = [&](std::string message) { if (error) *error = std::move(message); return false; };
+  const auto* schema = document.FindString("schema");
+  const auto* component = document.FindString("component");
+  const auto* fixture = document.FindString("fixture");
+  if (!schema || *schema != "arcium-ui-workshop" || document.FindInt("version") != 1 ||
+      !component || *component != "command-bar") return fail("Unsupported workshop document");
+  if (!fixture || (*fixture != "mixed" && *fixture != "empty" && *fixture != "long" && *fixture != "streaming"))
+    return fail("Unknown fixture");
+  if (const auto* query = document.Find("query"); query && (!query->is_string() || query->GetString().size() > CommandSession::kMaxQueryLength))
+    return fail("Invalid example query");
+  if (const auto* scope = document.FindString("scope")) {
+    const auto scopes = ScenarioScopes();
+    if (std::ranges::find(scopes, *scope, &CommandScopeDescriptor::id) == scopes.end())
+      return fail("Unknown scope");
+  } else if (document.Find("scope")) return fail("Invalid scope");
+  if (const auto* key = document.Find("selected_key"); key && (!key->is_string() || key->GetString().size() > 1024))
+    return fail("Invalid selected row key");
+  if (const auto* context = document.FindDict("context")) {
+    if (const auto* scale = context->Find("scale")) {
+      if (!scale->is_double() && !scale->is_int()) return fail("Invalid UI scale");
+      if (!std::isfinite(scale->GetDouble()) || scale->GetDouble() < .8 || scale->GetDouble() > 1.25)
+        return fail("UI scale must be between 0.8 and 1.25");
+    }
+    if (const auto* value = context->Find("mode"); value &&
+        (!value->is_string() || (value->GetString() != "light" && value->GetString() != "dark")))
+      return fail("Unknown appearance mode");
+    for (const char* key : {"reduce_motion", "reduce_transparency"})
+      if (context->Find(key) && !context->FindBool(key)) return fail("Invalid accessibility input");
+    if (const auto* material = context->Find("command_material"); material &&
+        (!material->is_int() || material->GetInt() < 0 || material->GetInt() > 2))
+      return fail("Invalid command material");
+    if (const auto* surface = context->Find("surface_set"); surface &&
+        (!surface->is_string() || (surface->GetString() != "glass" && surface->GetString() != "solid" &&
+          surface->GetString() != "refractive" && surface->GetString() != "quiet" && surface->GetString() != "custom")))
+      return fail("Invalid surface set");
+    if (context->Find("surface_tuning") && !context->FindDict("surface_tuning")) return fail("Invalid surface tuning");
+    if (context->Find("chrome_appearance") && !context->FindDict("chrome_appearance"))
+      return fail("Invalid chrome appearance");
+    if (const auto* palette = context->FindDict("palette")) {
+      for (const char* key : {"seed", "companion"}) if (const auto* value = palette->Find(key)) {
+        uint32_t color;
+        if (!value->is_string() || value->GetString().size() != 7 || value->GetString()[0] != '#' ||
+            !base::HexStringToUInt(std::string_view(value->GetString()).substr(1), &color))
+          return fail("Palette colors must use #RRGGBB");
+      }
+      for (const char* key : {"controls_chroma", "panels_chroma"}) if (const auto* value = palette->Find(key)) {
+        if (!value->is_int() || value->GetInt() < 0 || value->GetInt() > 200)
+          return fail("Invalid palette chroma");
+      }
+    } else if (context->Find("palette")) return fail("Invalid palette");
+  } else if (document.Find("context")) return fail("Invalid context");
+  if (const auto* steps = document.FindList("publications")) {
+    if (steps->empty() || steps->size() > 24) return fail("A scenario needs 1 to 24 publications");
+    int previous = -1;
+    for (const auto& value : *steps) {
+      if (!value.is_dict()) return fail("Invalid publication");
+      const auto& step = value.GetDict();
+      auto delay = step.FindInt("delay_ms"); auto rows = step.FindInt("rows");
+      if (!delay || *delay < 0 || *delay > 5000 || *delay < previous ||
+          !rows || *rows < 0 || *rows > 20 || !step.FindBool("done"))
+        return fail("Invalid publication timing, row count or completion flag");
+      if (step.Find("reorder") && !step.FindBool("reorder")) return fail("Invalid reorder flag");
+      previous = *delay;
+    }
+  } else if (document.Find("publications")) return fail("Invalid publications");
+  return true;
+}
+std::optional<base::DictValue> LoadScenario(const base::FilePath& path, std::string* error) {
+  std::string data;
+  if (!base::ReadFileToStringWithMaxSize(path, &data, 1024 * 1024)) {
+    if (error) *error = "Could not read a scenario smaller than 1 MiB";
+    return std::nullopt;
+  }
+  return ParseScenario(data, error);
+}
+std::optional<base::DictValue> ParseScenario(std::string_view data, std::string* error) {
+  if (data.size() > 1024 * 1024) { if (error) *error = "Scenario exceeds 1 MiB"; return std::nullopt; }
+  auto result = base::JSONReader::ReadDict(data, base::JSON_PARSE_RFC);
+  if (!result || !ValidateScenario(*result, error)) return std::nullopt;
+  return result;
+}
+helium::GlassSurfaceConfiguration ContextAppearance(const base::DictValue& document) {
+  if (const auto* context = document.FindDict("context")) {
+    if (const auto* appearance = context->FindDict("chrome_appearance"))
+      return helium::ParseGlassSurfaceConfiguration(*appearance);
+  }
+  return helium::DefaultGlassSurfaceConfiguration();
+}
+helium::SpaceTheme ContextTheme(const base::DictValue& document) {
+  helium::SpaceTheme result;
+  const auto* context = document.FindDict("context");
+  const auto* palette = context ? context->FindDict("palette") : nullptr;
+  const SkColor seed = ContextColor(palette, "seed", ui::ArciumPalette().seed);
+  const SkColor companion = ContextColor(palette, "companion", seed);
+  result.background.emplace();
+  result.background->glows.push_back({.color = seed, .id = "workshop-primary"});
+  result.background->glows.push_back({.color = companion, .id = "workshop-companion"});
+  result.accent_glow_id = "workshop-primary";
+  result.color = seed;
+  result.controls_chroma = palette ? palette->FindInt("controls_chroma").value_or(100) : 100;
+  result.panels_chroma = palette ? palette->FindInt("panels_chroma").value_or(35) : 35;
+  const auto* mode = context ? context->FindString("mode") : nullptr;
+  result.mode = mode && *mode == "light" ? helium::SpaceTheme::Mode::kLight : helium::SpaceTheme::Mode::kDark;
+  return result;
+}
+ui::ArciumPalette ContextPalette(const base::DictValue& document) {
+  const auto theme = ContextTheme(document);
+  return helium::SpacePaletteKey(&theme, ContextAppearance(document));
+}
+std::vector<CommandScopeDescriptor> ScenarioScopes() {
+  struct Scope { const char* id; const char16_t* label; SkColor tint; };
+  const Scope fixtures[] = {
+      {"omni", u"Omni", SkColorSetRGB(174, 112, 245)},
+      {"web", u"Web", SkColorSetRGB(100, 159, 255)},
+      {"saved", u"Saved", SkColorSetRGB(205, 182, 112)},
+      {"youtube", u"YouTube", SkColorSetRGB(240, 75, 70)},
+      {"x", u"X", SkColorSetRGB(210, 215, 220)},
+      {"chatgpt", u"ChatGPT", SkColorSetRGB(89, 206, 157)}};
+  std::vector<CommandScopeDescriptor> result;
+  int index = 0;
+  for (const auto& fixture : fixtures) {
+    CommandScopeDescriptor scope;
+    scope.id = fixture.id; scope.label = fixture.label; scope.tint = fixture.tint;
+    scope.provider_id = "workshop";
+    scope.placeholder = u"Search " + scope.label;
+    scope.search_verb = u"Search " + scope.label;
+    if (scope.id == kOmniScope) scope.placeholder = u"Search tabs, Pins, Favorites and the web";
+    scope.accessibility_description = scope.placeholder;
+    SkBitmap bitmap; bitmap.allocN32Pixels(16, 16); bitmap.eraseColor(SK_ColorTRANSPARENT);
+    // Identical fixture pixels in both hosts, independent of SF Symbol versions.
+    for (int y = 2; y < 14; ++y) for (int x = 2; x < 14; ++x) {
+      if (x == 2 || x == 13 || y == 2 || y == 13 || (x + y + index) % 5 == 0)
+        *bitmap.getAddr32(x, y) = fixture.tint;
+    }
+    bitmap.setImmutable();
+    scope.icon = gfx::ImageSkia::CreateFrom1xBitmap(bitmap);
+    result.push_back(std::move(scope));
+    ++index;
+  }
+  return result;
+}
+base::DictValue ContextPreferences(const base::DictValue& document) {
+  const auto* context = document.FindDict("context");
+  const auto* tuning = context ? context->FindDict("surface_tuning") : nullptr;
+  const auto* set = context ? context->FindString("surface_set") : nullptr;
+  return base::DictValue().Set(kCommandBarAppearancePref, context ? context->FindInt("command_material").value_or(2) : 2)
+      .Set(helium::kArciumSurfaceSetPref, set ? *set : helium::kSurfaceSetGlass)
+      .Set(helium::kArciumSurfaceTuningPref, tuning ? tuning->Clone() : base::DictValue())
+      .Set(helium::kArciumChromeAppearancePref, helium::SerializeGlassSurfaceConfiguration(ContextAppearance(document)));
+}
+float ContextScale(const base::DictValue& document) {
+  const auto* context = document.FindDict("context");
+  return context ? context->FindDouble("scale").value_or(1.) : 1.;
+}
+void ApplyState(CommandPanelView* panel, const base::DictValue& document) {
+  if (!panel) return;
+  panel->FocusInput();
+  if (const auto* scope = document.FindString("scope")) {
+    for (size_t i = 0; i < panel->scope_count_for_testing() && panel->scope_for_testing() != *scope; ++i)
+      panel->HandleKeyEvent(nullptr, ui::KeyEvent(ui::EventType::kKeyPressed, ui::VKEY_RIGHT, 0));
+    // Leaving the row uses the real keyboard path and restores input focus.
+    if (panel->scopes_focused_for_testing())
+      panel->HandleKeyEvent(nullptr, ui::KeyEvent(ui::EventType::kKeyPressed, ui::VKEY_DOWN, 0));
+  }
+  const auto* text = document.FindString("query");
+  const auto query = text ? base::UTF8ToUTF16(*text) : std::u16string();
+  panel->input_for_testing()->SetText(query);
+  panel->ContentsChanged(panel->input_for_testing(), query);
+  if (const auto* selected = document.FindString("selected_key")) panel->RestoreSelectionKey(*selected);
+}
+void SaveState(CommandPanelView* panel, base::DictValue& document) {
