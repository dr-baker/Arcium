   return true;
 }
 
+bool ArciumSettingsModel::IsWebAppearanceAvailable() const {
+  return !shutting_down_ && prefs_ && GetAppearanceSpace() &&
+         prefs_->FindPreference(helium::kHeliumSpacesPref);
+}
+
+int ArciumSettingsModel::GetWebAppearanceMode() const {
+  const auto* space = GetAppearanceSpace();
+  if (!space ||
+      space->theme().web_mode == helium::SpaceTheme::Mode::kAuto) {
+    return static_cast<int>(ThemeService::BrowserColorScheme::kSystem);
+  }
+  return static_cast<int>(space->theme().web_mode ==
+                                  helium::SpaceTheme::Mode::kDark
+                              ? ThemeService::BrowserColorScheme::kDark
+                              : ThemeService::BrowserColorScheme::kLight);
+}
+
+bool ArciumSettingsModel::IsWebAppearanceManaged() const {
+  return !IsWebAppearanceAvailable() ||
+         !prefs_->IsUserModifiablePreference(helium::kHeliumSpacesPref);
+}
+
+bool ArciumSettingsModel::SetWebAppearanceMode(int mode) {
+  if (IsWebAppearanceManaged()) {
+    return false;
+  }
+  const int system =
+      static_cast<int>(ThemeService::BrowserColorScheme::kSystem);
+  const int dark = static_cast<int>(ThemeService::BrowserColorScheme::kDark);
+  if (mode < system || mode > dark) {
+    return false;
+  }
+  auto* space = GetAppearanceSpace();
+  auto theme = space->theme();
+  theme.web_mode = mode == system ? helium::SpaceTheme::Mode::kAuto
+                       : mode == dark ? helium::SpaceTheme::Mode::kDark
+                                      : helium::SpaceTheme::Mode::kLight;
+  space_service_->SetSpaceTheme(space->id(), std::move(theme));
+  return true;
+}
