+namespace helium {
+namespace {
+std::optional<ui::ColorProviderKey> ContentColorProviderKey(
+    content::WebContents* contents) {
+#if !BUILDFLAG(IS_ANDROID)
+  if (!contents || Profile::FromBrowserContext(contents->GetBrowserContext())
+                       ->IsOffTheRecord()) {
+    return std::nullopt;
+  }
+  const auto& url = contents->GetVisibleURL();
+  if (!url.SchemeIs(content::kChromeUIScheme) ||
+      !(url.host() == chrome::kChromeUINewTabHost ||
+        url.host() == chrome::kChromeUINewTabPageHost ||
+        url.host() == chrome::kChromeUINewTabPageThirdPartyHost)) {
+    return std::nullopt;
+  }
+  if (ui::NativeTheme::GetInstanceForWeb()->forced_colors() !=
+      ui::ColorProviderKey::ForcedColors::kNone) {
+    return std::nullopt;
+  }
+  auto* tab = tabs::TabInterface::MaybeGetFromContents(contents);
+  auto* window = tab ? tab->GetBrowserWindowInterface() : nullptr;
+  auto* browser = window ? window->GetBrowserForMigrationOnly() : nullptr;
+  auto* spaces =
+      browser
+          ? HeliumSpaceServiceFactory::GetForProfileIfExists(browser->profile())
+          : nullptr;
+  const auto* theme = spaces ? spaces->GetThemeForBrowser(browser) : nullptr;
+  auto* view =
+      browser ? BrowserView::GetBrowserViewForBrowser(browser) : nullptr;
+  auto* widget = view ? view->browser_widget() : nullptr;
+  if (!theme || !widget) {
+    return std::nullopt;
+  }
+  auto key = widget->GetSpaceContentColorProviderKey();
+  if (key.forced_colors != ui::ColorProviderKey::ForcedColors::kNone ||
+      key.contrast_mode == ui::ColorProviderKey::ContrastMode::kHigh) {
+    return std::nullopt;
+  }
+  if (theme->web_mode != SpaceTheme::Mode::kAuto) {
+    key.color_mode = theme->web_mode == SpaceTheme::Mode::kDark
+                         ? ui::ColorProviderKey::ColorMode::kDark
+                         : ui::ColorProviderKey::ColorMode::kLight;
+  }
+  return key;
+#else
+  return std::nullopt;
+#endif
+}
+}  // namespace
+
+const ui::ColorProvider& GetSpaceContentColorProvider(
+    content::WebContents* contents) {
+  if (auto key = ContentColorProviderKey(contents)) {
+    return *ui::ColorProviderManager::Get().GetColorProviderFor(*key);
+  }
+  return contents->GetColorProvider();
+}
+
+ui::ColorProviderKey::ColorMode GetSpaceContentColorMode(
+    content::WebContents* contents) {
+  if (auto key = ContentColorProviderKey(contents)) {
+    return key->color_mode;
+  }
+  return contents->GetColorMode();
+}
+}  // namespace helium
