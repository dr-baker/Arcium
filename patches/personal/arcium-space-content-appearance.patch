+TEST_F(HeliumSpaceServiceTest,
+       WebModeKeepsTargetRecipeAndIndependentPolicy) {
+  const int follow =
+      static_cast<int>(ThemeService::BrowserColorScheme::kSystem);
+  const int light = static_cast<int>(ThemeService::BrowserColorScheme::kLight);
+  const int dark = static_cast<int>(ThemeService::BrowserColorScheme::kDark);
+  auto theme = WithSpacePaletteAppearance(SpaceTheme(),
+                                          DefaultGlassSurfaceConfiguration());
+  theme.mode = SpaceTheme::Mode::kDark;
+  theme.web_mode = SpaceTheme::Mode::kAuto;
+  const auto target_id = space_->id();
+  const auto other_id =
+      service_->GetOrCreateSpace("web-other", u"Other")->id();
+  service_->SetSpaceTheme(target_id, theme);
+  const auto original = service_->GetSpaceById(target_id)->theme();
+  const auto other_original = service_->GetSpaceById(other_id)->theme();
+  arcium_settings::ArciumSettingsModel model(profile(), base::DoNothing(),
+                                             base::DoNothing());
+  ASSERT_TRUE(model.SetAppearanceSpace(target_id));
+  service_->SetActiveSpace(other_id);
+  ASSERT_TRUE(model.IsWebAppearanceAvailable());
+  EXPECT_FALSE(model.IsWebAppearanceManaged());
+  EXPECT_EQ(model.GetWebAppearanceMode(), follow);
+  auto expected = original;
+  for (int mode : {light, dark, follow}) {
+    ASSERT_TRUE(model.SetWebAppearanceMode(mode));
+    expected.web_mode = mode == follow ? SpaceTheme::Mode::kAuto
+                            : mode == dark ? SpaceTheme::Mode::kDark
+                                           : SpaceTheme::Mode::kLight;
+    EXPECT_EQ(service_->GetSpaceById(target_id)->theme(), expected);
+    EXPECT_EQ(service_->GetSpaceById(other_id)->theme(), other_original);
+    EXPECT_EQ(model.GetWebAppearanceMode(), mode);
+    EXPECT_EQ(model.GetAppearanceMode(), dark);
+  }
+  EXPECT_FALSE(model.SetWebAppearanceMode(-1));
+  EXPECT_FALSE(model.SetWebAppearanceMode(dark + 1));
+  EXPECT_EQ(service_->GetSpaceById(target_id)->theme(), expected);
+  auto* test_prefs = profile()->GetTestingPrefService();
+  test_prefs->SetManagedPref(prefs::kBrowserColorScheme, base::Value(follow));
+  EXPECT_FALSE(model.IsWebAppearanceManaged());
+  ASSERT_TRUE(model.SetWebAppearanceMode(light));
+  expected.web_mode = SpaceTheme::Mode::kLight;
+  EXPECT_EQ(service_->GetSpaceById(target_id)->theme(), expected);
+  test_prefs->RemoveManagedPref(prefs::kBrowserColorScheme);
+  test_prefs->SetManagedPref(
+      kHeliumSpacesPref,
+      base::Value(test_prefs->GetList(kHeliumSpacesPref).Clone()));
+  EXPECT_TRUE(model.IsWebAppearanceManaged());
+  EXPECT_FALSE(model.SetWebAppearanceMode(dark));
+  test_prefs->RemoveManagedPref(kHeliumSpacesPref);
+  EXPECT_EQ(service_->GetSpaceById(target_id)->theme(), expected);
+  ASSERT_TRUE(model.SetAppearanceSpace(other_id));
+  ASSERT_TRUE(service_->DeleteSpace(other_id));
+  EXPECT_FALSE(model.IsWebAppearanceAvailable());
+  EXPECT_FALSE(model.SetWebAppearanceMode(dark));
+  EXPECT_EQ(service_->GetSpaceById(target_id)->theme(), expected);
+}
+
+TEST_F(HeliumSpaceServiceTest, WebModeDefaultsAndRoundTripsIndependently) {
+  base::DictValue legacy;
+  legacy.Set("mode", "dark");
+  auto theme = SpaceTheme::FromDict(&legacy);
+  EXPECT_EQ(theme.web_mode, SpaceTheme::Mode::kAuto);
+  EXPECT_EQ(theme.mode, SpaceTheme::Mode::kDark);
+  theme.web_mode = SpaceTheme::Mode::kLight;
+  const auto saved = theme.ToDict();
+  EXPECT_EQ(SpaceTheme::FromDict(&saved), theme);
+  auto invalid = saved.Clone();
+  invalid.Set("web_mode", "unknown");
+  const auto restored = SpaceTheme::FromDict(&invalid);
+  EXPECT_EQ(restored.web_mode, SpaceTheme::Mode::kAuto);
+  EXPECT_EQ(restored.mode, theme.mode);
+  SpaceTheme only_web;
+  EXPECT_TRUE(only_web.IsDefault());
+  only_web.web_mode = SpaceTheme::Mode::kDark;
+  EXPECT_FALSE(only_web.IsDefault());
+}
 
 }  // namespace helium
