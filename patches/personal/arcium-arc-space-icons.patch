+            <rect x="3" y="5" width="18" height="16" rx="2" />
+            <path d="M7 3v4m10-4v4M3 11h18" />
+        </svg>
+    {:else if emoji}
+        {emoji}
+    {:else}
+        <IconStack2 />
+    {/if}
+</span>
+
+<style>
