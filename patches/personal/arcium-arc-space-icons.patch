+std::string ParseSpaceIcon(const base::DictValue& space) {
+  const auto* type = space.FindDictByDottedPath("customInfo.iconType");
+  if (!type) {
+    return {};
+  }
+  // Arc's newer field preserves variation selectors and joined emoji. The
+  // legacy scalar can disagree with it, so use it only as a fallback.
+  if (const auto* emoji = type->FindString("emoji_v2");
+      emoji && !emoji->empty() && emoji->size() <= 128 &&
+      base::IsStringUTF8(*emoji) && !base::StartsWith(*emoji, "ph:")) {
+    return *emoji;
+  }
+  if (const auto emoji = type->FindInt("emoji");
+      emoji && *emoji > 0 && *emoji <= 0x10ffff &&
+      !(*emoji >= 0xd800 && *emoji <= 0xdfff)) {
+    std::string result;
+    base::WriteUnicodeCharacter(*emoji, &result);
+    return result;
+  }
+  // Known Arc symbol names map to bundled artwork. Unknown representations
+  // use the neutral Space icon; they are not paths or remote image requests.
+  if (const auto* symbol = type->FindString("icon");
+      symbol && *symbol == "calendar") {
+    return "ph:calendar";
+  }
+  return {};
+}
