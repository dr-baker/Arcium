+<script lang="ts">
+    import IconStar from "../icons/tabler/IconStar.svelte";
+    import IconStack2 from "../icons/tabler/IconStack2.svelte";
+
+    const { icon = "", favorites = false }: { icon?: string; favorites?: boolean } = $props();
+    // Match the native Space icon: one whole grapheme, never a cropped ZWJ
+    // sequence. Symbol artwork is local; imported values are never markup.
+    const emoji = $derived(!icon.startsWith("ph:") && icon.length <= 128
+        ? new Intl.Segmenter(undefined, { granularity: "grapheme" })
+            .segment(icon.trim())[Symbol.iterator]().next().value?.segment ?? ""
+        : "");
+</script>
+
+<span class="space-icon" class:favorites aria-hidden="true">
+    {#if favorites}
