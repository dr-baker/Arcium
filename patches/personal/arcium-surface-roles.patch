+std::string ArciumSettingsModel::GetSurfaceSet() const {
+  return helium::SurfaceSetString(helium::ReadSurfaceSet(prefs_));
+}
+
+bool ArciumSettingsModel::SetSurfaceSet(std::string_view value) {
+  if (shutting_down_ || !prefs_ || !HasPreference(helium::kArciumSurfaceSetPref) ||
+      !prefs_->IsUserModifiablePreference(helium::kArciumSurfaceSetPref) ||
+      !helium::ParseSurfaceSet(value)) {
+    return false;
+  }
+  prefs_->SetString(helium::kArciumSurfaceSetPref, value);
+  return true;
+}
+
+base::DictValue ArciumSettingsModel::GetSurfaceTuning() const {
+  return helium::SerializeSurfaceTuning(
+      helium::ReadSurfaceInputs(prefs_).tuning);
+}
+
+bool ArciumSettingsModel::SetSurfaceTuning(const base::DictValue& tuning) {
+  const std::optional<helium::SurfaceTuning> parsed =
+      helium::ParseSurfaceTuningStrict(tuning);
+  if (!parsed || shutting_down_ || !prefs_) {
+    return false;
+  }
+  for (const char* name :
+       {helium::kArciumSurfaceTuningPref, helium::kArciumSurfaceSetPref}) {
+    if (!HasPreference(name) || !prefs_->IsUserModifiablePreference(name)) {
+      return false;
+    }
+  }
+  prefs_->SetDict(helium::kArciumSurfaceTuningPref,
+                  helium::SerializeSurfaceTuning(*parsed));
+  prefs_->SetString(helium::kArciumSurfaceSetPref, helium::kSurfaceSetCustom);
+  return true;
+}
+
+void ArciumSettingsModel::SetSurfacePreview(bool visible) {
+  if (surface_preview_ == visible) {
+    return;
+  }
+  surface_preview_ = visible;
+  RefreshSurfacePreview();
+}
+
+void ArciumSettingsModel::RefreshSurfacePreview() {
+  if (!surface_preview_ || shutting_down_) {
+    HideMRUTabSwitcherPreviews(profile_);
+    return;
+  }
+  // Showing again keeps a preview that already matches the current style.
+  BrowserWindowInterface* browser = FindMatchingNormalBrowser(profile_);
+  BrowserView* browser_view =
+      browser ? BrowserView::GetBrowserViewForBrowser(browser) : nullptr;
+  // Follow the most recently active window; leave no preview behind.
+  HideMRUTabSwitcherPreviews(profile_, browser_view);
+  if (browser_view) {
+    ShowMRUTabSwitcherPreview(browser_view);
+  }
+}
