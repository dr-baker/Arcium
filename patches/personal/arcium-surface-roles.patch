--- /dev/null
+++ src/chrome/browser/ui/views/helium/surface_style.h
@@ -0,0 +1,125 @@
+// Copyright 2026 The Helium Authors
+// You can use, redistribute, and/or modify this source code under
+// the terms of the GPL-3.0 license found in the LICENSE file.
+
+#ifndef CHROME_BROWSER_UI_VIEWS_HELIUM_SURFACE_STYLE_H_
+#define CHROME_BROWSER_UI_VIEWS_HELIUM_SURFACE_STYLE_H_
+
+#include <optional>
+#include <string_view>
+
+#include "chrome/browser/ui/views/helium/glass_surface.h"
+#include "chrome/browser/ui/views/helium/glass_surface_configuration.h"
+#include "third_party/skia/include/core/SkColor.h"
+#include "ui/gfx/geometry/rounded_corners_f.h"
+
+class PrefService;
+
+namespace helium {
+
+// Floating surfaces are styled by role rather than by feature. The window
+// backdrop keeps its own editor in kArciumChromeAppearancePref; a surface set
+// chooses the finish of every other role at once. Geometry, including corner
+// radius, belongs to each surface.
+inline constexpr char kArciumSurfaceSetPref[] = "arcium.appearance.surface_set";
+
+inline constexpr char kSurfaceSetGlass[] = "glass";
+inline constexpr char kSurfaceSetRefractive[] = "refractive";
+inline constexpr char kSurfaceSetQuiet[] = "quiet";
+inline constexpr char kSurfaceSetSolid[] = "solid";
+
+enum class SurfaceSet {
+  // Native glass panels, glass controls, and blurred scrims.
+  kGlass,
+  // As kGlass, with the refraction shader wherever Chromium draws the glass.
+  kRefractive,
+  // Solid panels, glass controls, and lightly blurred scrims.
+  kQuiet,
+  // Solid panels and controls, and dimming scrims.
+  kSolid,
+};
+
+// The panel role's explicit choice, stored in the command bar preference.
+// Automatic follows the surface set.
+enum class PanelChoice {
+  kSolid,
+  kGlass,
+  kAutomatic,
+};
+
+// How Chromium paints a panel or control that lives inside the browser
+// window. Native glass is only possible for surfaces in their own window.
+enum class SurfaceFinish {
+  kSolid,
+  kGlass,
+  kRefractive,
+};
+
+struct ScrimStyle {
+  float blur_sigma = 0.0f;
+  SkAlpha dim_alpha = 184;
+
+  bool operator==(const ScrimStyle&) const = default;
+};
+
+struct SurfaceInputs {
+  SurfaceSet set = SurfaceSet::kGlass;
+  PanelChoice panel = PanelChoice::kAutomatic;
+  // False when Reduce Transparency or a renderer override leaves Chromium
+  // without its live-backdrop renderer.
+  bool embedded_glass_available = true;
+};
+
+struct SurfaceStyle {
+  // Panels request glass. A panel in its own window uses native glass when
+  // the platform resolves one; an embedded panel uses `embedded_panel`.
+  bool panel_glass = false;
+  SurfaceFinish embedded_panel = SurfaceFinish::kSolid;
+  SurfaceFinish control = SurfaceFinish::kSolid;
+  ScrimStyle scrim;
+
+  bool operator==(const SurfaceStyle&) const = default;
+};
+
+// Shared panel tokens, matching the command panel's palette.
+inline constexpr SkColor kPanelSolidColor = SkColorSetRGB(29, 30, 28);
+inline constexpr SkColor kPanelEdgeColor = SkColorSetARGB(54, 255, 255, 255);
+inline constexpr float kPanelGlassTintStrength = 0.55f;
+inline constexpr int kPanelShadowElevation = 2;
+
+// Shared control tokens for floating buttons over page content.
+inline constexpr SkColor kControlEdgeColor = SkColorSetARGB(96, 255, 255, 255);
+inline constexpr float kControlGlassTintStrength = 0.6f;
+inline constexpr int kControlShadowElevation = 2;
+
+std::optional<SurfaceSet> ParseSurfaceSet(std::string_view value);
+const char* SurfaceSetString(SurfaceSet set);
+PanelChoice PanelChoiceFromPref(int value);
+
+// Missing or malformed values select the defaults.
+SurfaceSet ReadSurfaceSet(const PrefService* prefs);
+PanelChoice ReadPanelChoice(const PrefService* prefs);
+
+SurfaceStyle ResolveSurfaceStyle(const SurfaceInputs& inputs);
+
+// The window's glass style for a panel: its material family, style, opacity,
+// and tint, without color points or grain. A solid window gives panels the
+// platform's automatic glass. `enabled` reports whether the panel requested
+// glass.
+GlassSurfaceConfiguration PanelGlassConfiguration(
+    const GlassSurfaceConfiguration& window,
+    bool panel_glass);
+GlassSurfaceConfiguration ReadPanelGlassConfiguration(const PrefService* prefs,
+                                                      bool panel_glass);
+
+// Embedded Chromium glass for a finish other than kSolid. The tint replaces
+// the preset's own color so surfaces follow the browser theme.
+GlassSurfaceParams EmbeddedGlassParams(SurfaceFinish finish,
+                                       SkColor tint,
+                                       float tint_strength,
+                                       SkColor opaque_color,
+                                       const gfx::RoundedCornersF& radii);
+
+}  // namespace helium
+
+#endif  // CHROME_BROWSER_UI_VIEWS_HELIUM_SURFACE_STYLE_H_
