+void HideMRUTabSwitcherPreviews(Profile* profile, BrowserView* except) {
+  base::EraseIf(GetMRUTabSwitcherVisualizers(),
+                [profile, except](const auto& entry) {
+                  return entry.first != except && entry.second->preview() &&
+                         entry.first->GetProfile()->GetOriginalProfile() ==
+                             profile;
+                });
+}
+
+void MRUTabSwitcherOverlay::ReturnToPreview() {
+  std::vector<content::WebContents*> tabs;
+  if (!PreviewTabs(browser_view_, &tabs)) {
+    // No tab is left to show. Destroys this overlay; nothing may follow.
+    GetMRUTabSwitcherVisualizers().erase(browser_view_);
+    return;
+  }
+  Update(tabs, tabs.front());
+}
