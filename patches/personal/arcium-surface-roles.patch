+TEST(SurfaceStyleTest, TuningParsersClampAndValidate) {
+  const SurfaceTuning glass = PresetSurfaceTuning(SurfaceSet::kGlass);
+  EXPECT_EQ(ParseSurfaceTuning(base::DictValue()), glass);
+  EXPECT_EQ(ParseSurfaceTuningStrict(SerializeSurfaceTuning(glass)), glass);
+
+  base::DictValue wild = SerializeSurfaceTuning(glass);
+  wild.Set(kSurfaceTuningScrimBlurKey, 99.0);
+  wild.Set(kSurfaceTuningPanelTintKey, -1.0);
+  wild.Set(kSurfaceTuningControlFinishKey, "metal");
+  const SurfaceTuning clamped = ParseSurfaceTuning(wild);
+  EXPECT_DOUBLE_EQ(clamped.scrim_blur, kMaxScrimBlur);
+  EXPECT_DOUBLE_EQ(clamped.panel_tint, 0.0);
+  EXPECT_EQ(clamped.control, glass.control);
+  EXPECT_FALSE(ParseSurfaceTuningStrict(wild));
+
+  base::DictValue missing = SerializeSurfaceTuning(glass);
+  missing.Remove(kSurfaceTuningScrimDimKey);
+  EXPECT_FALSE(ParseSurfaceTuningStrict(missing));
+
+  base::DictValue extra = SerializeSurfaceTuning(glass);
+  extra.Set("extra", true);
+  EXPECT_FALSE(ParseSurfaceTuningStrict(extra));
+
+  base::DictValue wrong_type = SerializeSurfaceTuning(glass);
+  wrong_type.Set(kSurfaceTuningPanelShadowKey, 1);
+  EXPECT_FALSE(ParseSurfaceTuningStrict(wrong_type));
+
+  SurfaceTuning colored = glass;
+  colored.panel_tint_color = SkColorSetRGB(0x12, 0xAB, 0xEF);
+  base::DictValue colored_dict = SerializeSurfaceTuning(colored);
+  EXPECT_EQ(*colored_dict.FindString(kSurfaceTuningPanelTintColorKey),
+            "#12ABEF");
+  EXPECT_EQ(ParseSurfaceTuningStrict(colored_dict), colored);
+  for (const char* bad : {"12ABEF", "#12ABE", "#GGGGGG", "#12ABEF00"}) {
+    colored_dict.Set(kSurfaceTuningPanelTintColorKey, bad);
+    EXPECT_FALSE(ParseSurfaceTuningStrict(colored_dict)) << bad;
+    EXPECT_EQ(ParseSurfaceTuning(colored_dict).panel_tint_color,
+              glass.panel_tint_color);
+  }
+
+  base::DictValue ints = SerializeSurfaceTuning(glass);
+  ints.Set(kSurfaceTuningScrimBlurKey, 12);
+  ASSERT_TRUE(ParseSurfaceTuningStrict(ints));
+  EXPECT_DOUBLE_EQ(ParseSurfaceTuningStrict(ints)->scrim_blur, 12.0);
+}
+
+TEST(SurfaceStyleTest, EarlierBooleanPanelValuesStillParse) {
+  base::DictValue solid;
+  solid.Set("panelGlass", false);
+  EXPECT_EQ(ParseSurfaceTuning(solid).panel_material, PanelMaterial::kSolid);
+  base::DictValue refractive;
+  refractive.Set("panelGlass", true);
+  refractive.Set("panelRefractive", true);
+  EXPECT_EQ(ParseSurfaceTuning(refractive).panel_material,
+            PanelMaterial::kGlassmorphic);
+}
+
+TEST(SurfaceStyleTest, CustomReadsSavedValuesAndPresetsIgnoreThem) {
+  TestingPrefServiceSimple prefs;
+  prefs.registry()->RegisterStringPref(kArciumSurfaceSetPref,
+                                       kSurfaceSetGlass);
+  prefs.registry()->RegisterDictionaryPref(kArciumSurfaceTuningPref);
+  SurfaceTuning saved;
+  saved.scrim_blur = 20;
+  prefs.SetDict(kArciumSurfaceTuningPref, SerializeSurfaceTuning(saved));
+  EXPECT_EQ(ReadSurfaceInputs(&prefs).tuning,
+            PresetSurfaceTuning(SurfaceSet::kGlass));
+  prefs.SetString(kArciumSurfaceSetPref, kSurfaceSetCustom);
+  EXPECT_DOUBLE_EQ(ReadSurfaceInputs(&prefs).tuning.scrim_blur, 20.0);
+}
+
+TEST(SurfaceStyleTest, PanelGlassConfigurationResolvesTheRightRenderer) {
+  GlassSurfaceConfiguration window = DefaultGlassSurfaceConfiguration();
+  window.enabled = false;
+  window.material = GlassSurfaceMaterial::kSolid;
+  window.material_opacity = 0.8;
+  window.grain = 0.04;
+  window.point_count = 1;
+  window.points[0].id = "yellow";
+
+  SurfaceStyle style;
+  style.panel_glass = true;
+  style.panel_material = PanelMaterial::kLiquid;
+  style.panel_tint = 0.25f;
+  const GlassSurfaceConfiguration panel =
+      PanelGlassConfiguration(window, style);
+  EXPECT_TRUE(panel.enabled);
+  EXPECT_EQ(panel.material, GlassSurfaceMaterial::kLiquidGlass);
+  EXPECT_EQ(panel.glass_style, GlassSurfaceGlassStyle::kClear);
+  EXPECT_FLOAT_EQ(panel.glass_tint_opacity, 0.25f);
+  EXPECT_DOUBLE_EQ(panel.grain, 0.0);
+  EXPECT_EQ(panel.point_count, 0u);
+  EXPECT_TRUE(panel.points[0].id.empty());
+
+  style.panel_material = PanelMaterial::kFast;
+  EXPECT_EQ(PanelGlassConfiguration(window, style).material,
+            GlassSurfaceMaterial::kFrosted);
+  style.panel_glass = false;
+  EXPECT_FALSE(PanelGlassConfiguration(window, style).enabled);
+}
+
+TEST(SurfaceStyleTest, EmbeddedParamsFollowTheFinishAndTheme) {
+  const GlassSurfaceParams glass =
+      EmbeddedGlassParams(SurfaceFinish::kGlass, SK_ColorRED, 0.3f,
+                          SK_ColorBLACK, gfx::RoundedCornersF(20));
+  EXPECT_EQ(glass.preset, GlassSurfacePreset::kBasic);
+  EXPECT_TRUE(glass.tint_replaces_preset);
+  EXPECT_EQ(glass.tint_color, SK_ColorRED);
+  EXPECT_FLOAT_EQ(glass.tint_strength, 0.3f);
+  EXPECT_EQ(glass.corner_radii, gfx::RoundedCornersF(20));
+  EXPECT_EQ(EmbeddedGlassParams(SurfaceFinish::kRefractive, SK_ColorRED, 0.3f,
+                                SK_ColorBLACK, gfx::RoundedCornersF())
+                .preset,
+            GlassSurfacePreset::kGlassmorphic);
+}
