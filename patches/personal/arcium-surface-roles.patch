+TEST_F(CommandBarMaterialTest, AutomaticChoiceFollowsTheSurfaceSet) {
+  prefs_.registry()->RegisterStringPref(helium::kArciumSurfaceSetPref,
+                                        helium::kSurfaceSetGlass);
+  auto widget = CreateWidget();
+  bool destroyed = false;
+  auto background = std::make_unique<TestNativeBackground>(&destroyed);
+  auto* native = background.get();
+  CommandBarMaterial material(
+      widget.get(), &prefs_,
+      base::BindRepeating([] { return CommandBarMaterial::Clip{}; }),
+      base::BindRepeating([](bool) {}), std::move(background));
+  prefs_.SetInteger(kCommandBarAppearancePref, kCommandBarAppearanceAutomatic);
+  EXPECT_TRUE(native->last_requested);
