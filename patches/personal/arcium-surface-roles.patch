+++ src/chrome/browser/ui/views/helium/surface_style.cc
@@ -0,0 +1,452 @@
+// Copyright 2026 The Helium Authors
+// You can use, redistribute, and/or modify this source code under
+// the terms of the GPL-3.0 license found in the LICENSE file.
+
+#include "chrome/browser/ui/views/helium/surface_style.h"
+
+#include <algorithm>
+#include <cmath>
+#include <string>
+
+#include "base/notreached.h"
+#include "base/strings/string_number_conversions.h"
+#include "base/strings/stringprintf.h"
+#include "chrome/browser/ui/helium/arcium_appearance_prefs.h"
+#include "components/prefs/pref_service.h"
+#include "ui/gfx/color_utils.h"
+
+namespace helium {
+
+namespace {
+
+constexpr ScrimStyle kDimScrim = {.blur_sigma = 0.0f, .dim_alpha = 184};
+
+std::optional<SurfaceFinish> ParseFinish(std::string_view value) {
+  if (value == kSurfaceFinishGlass) {
+    return SurfaceFinish::kGlass;
+  }
+  if (value == kSurfaceFinishRefractive) {
+    return SurfaceFinish::kRefractive;
+  }
+  if (value == kSurfaceFinishSolid) {
+    return SurfaceFinish::kSolid;
+  }
+  return std::nullopt;
+}
+
+const char* FinishString(SurfaceFinish finish) {
+  switch (finish) {
+    case SurfaceFinish::kGlass:
+      return kSurfaceFinishGlass;
+    case SurfaceFinish::kRefractive:
+      return kSurfaceFinishRefractive;
+    case SurfaceFinish::kSolid:
+      return kSurfaceFinishSolid;
+  }
+  NOTREACHED();
+}
+
+// Tint colors are stored as "#RRGGBB"; empty follows the window glass color.
+std::optional<std::optional<SkColor>> ParseTintColor(std::string_view value) {
+  if (value.empty()) {
+    return std::optional<SkColor>();
+  }
+  uint32_t rgb = 0;
+  if (value.size() != 7 || value[0] != '#' ||
+      !base::HexStringToUInt(value.substr(1), &rgb)) {
+    return std::nullopt;
+  }
+  return std::optional<SkColor>(SkColorSetA(rgb, SK_AlphaOPAQUE));
+}
+
+std::string TintColorString(std::optional<SkColor> color) {
+  return color ? base::StringPrintf("#%02X%02X%02X", SkColorGetR(*color),
+                                    SkColorGetG(*color), SkColorGetB(*color))
+               : std::string();
+}
+
+double Clamped(std::optional<double> value, double fallback, double max) {
+  return value && std::isfinite(*value) ? std::clamp(*value, 0.0, max)
+                                        : fallback;
+}
+
+std::optional<double> StrictNumber(const base::DictValue& dict,
+                                   const char* key,
+                                   double max) {
+  const base::Value* value = dict.Find(key);
+  if (!value || !(value->is_double() || value->is_int())) {
+    return std::nullopt;
+  }
+  const double number = value->GetDouble();
+  if (!std::isfinite(number) || number < 0.0 || number > max) {
+    return std::nullopt;
+  }
+  return number;
+}
+
+}  // namespace
+
+std::optional<SurfaceSet> ParseSurfaceSet(std::string_view value) {
+  if (value == kSurfaceSetGlass) {
+    return SurfaceSet::kGlass;
+  }
+  if (value == kSurfaceSetRefractive) {
+    return SurfaceSet::kRefractive;
+  }
+  if (value == kSurfaceSetQuiet) {
+    return SurfaceSet::kQuiet;
+  }
+  if (value == kSurfaceSetSolid) {
+    return SurfaceSet::kSolid;
+  }
+  if (value == kSurfaceSetCustom) {
+    return SurfaceSet::kCustom;
+  }
+  return std::nullopt;
+}
+
+const char* SurfaceSetString(SurfaceSet set) {
+  switch (set) {
+    case SurfaceSet::kGlass:
+      return kSurfaceSetGlass;
+    case SurfaceSet::kRefractive:
+      return kSurfaceSetRefractive;
+    case SurfaceSet::kQuiet:
+      return kSurfaceSetQuiet;
+    case SurfaceSet::kSolid:
+      return kSurfaceSetSolid;
+    case SurfaceSet::kCustom:
+      return kSurfaceSetCustom;
+  }
+  NOTREACHED();
+}
+
+std::optional<PanelMaterial> ParsePanelMaterial(std::string_view value) {
+  if (value == kPanelMaterialSolid) {
+    return PanelMaterial::kSolid;
+  }
+  if (value == kPanelMaterialFast) {
+    return PanelMaterial::kFast;
+  }
+  if (value == kPanelMaterialLiquid) {
+    return PanelMaterial::kLiquid;
+  }
+  if (value == kPanelMaterialSystemLiquid) {
+    return PanelMaterial::kSystemLiquid;
+  }
+  if (value == kPanelMaterialFrosted) {
+    return PanelMaterial::kFrosted;
+  }
+  if (value == kPanelMaterialGlassmorphic) {
+    return PanelMaterial::kGlassmorphic;
+  }
+  return std::nullopt;
+}
+
+const char* PanelMaterialString(PanelMaterial material) {
+  switch (material) {
+    case PanelMaterial::kSolid:
+      return kPanelMaterialSolid;
+    case PanelMaterial::kFast:
+      return kPanelMaterialFast;
+    case PanelMaterial::kLiquid:
+      return kPanelMaterialLiquid;
+    case PanelMaterial::kSystemLiquid:
+      return kPanelMaterialSystemLiquid;
+    case PanelMaterial::kFrosted:
+      return kPanelMaterialFrosted;
+    case PanelMaterial::kGlassmorphic:
+      return kPanelMaterialGlassmorphic;
+  }
+  NOTREACHED();
+}
+
+PanelChoice PanelChoiceFromPref(int value) {
+  switch (value) {
+    case arcium::kCommandBarAppearanceSolid:
+      return PanelChoice::kSolid;
+    case arcium::kCommandBarAppearanceGlass:
+      return PanelChoice::kGlass;
+    case arcium::kCommandBarAppearanceAutomatic:
+      return PanelChoice::kAutomatic;
+  }
+  // Unknown values must not silently become glass.
+  return PanelChoice::kSolid;
+}
+
+SurfaceSet ReadSurfaceSet(const PrefService* prefs) {
+  if (!prefs || !prefs->FindPreference(kArciumSurfaceSetPref)) {
+    return SurfaceSet::kGlass;
+  }
+  return ParseSurfaceSet(prefs->GetString(kArciumSurfaceSetPref))
+      .value_or(SurfaceSet::kGlass);
+}
+
+PanelChoice ReadPanelChoice(const PrefService* prefs) {
+  if (!prefs || !prefs->FindPreference(arcium::kCommandBarAppearancePref)) {
+    return PanelChoice::kAutomatic;
+  }
+  return PanelChoiceFromPref(
+      prefs->GetInteger(arcium::kCommandBarAppearancePref));
+}
+
+SurfaceTuning PresetSurfaceTuning(SurfaceSet set) {
+  SurfaceTuning tuning;
+  switch (set) {
+    case SurfaceSet::kGlass:
+    case SurfaceSet::kCustom:
+      break;
+    case SurfaceSet::kRefractive:
+      tuning.panel_material = PanelMaterial::kGlassmorphic;
+      tuning.control = SurfaceFinish::kRefractive;
+      tuning.control_tint = 0.4;
+      break;
+    case SurfaceSet::kQuiet:
+      tuning.panel_material = PanelMaterial::kSolid;
+      tuning.control_tint = 0.6;
+      tuning.control_edge = 0.3;
+      tuning.scrim_blur = 4.0;
+      tuning.scrim_dim = 0.5;
+      break;
+    case SurfaceSet::kSolid:
+      tuning.panel_material = PanelMaterial::kSolid;
+      tuning.control = SurfaceFinish::kSolid;
+      tuning.scrim_blur = 0.0;
+      tuning.scrim_dim = 0.72;
+      break;
+  }
+  return tuning;
+}
+
+SurfaceTuning ParseSurfaceTuning(const base::DictValue& dict) {
+  SurfaceTuning tuning = PresetSurfaceTuning(SurfaceSet::kGlass);
+  if (const std::string* material =
+          dict.FindString(kSurfaceTuningPanelMaterialKey)) {
+    tuning.panel_material =
+        ParsePanelMaterial(*material).value_or(tuning.panel_material);
+  } else if (dict.FindBool("panelGlass") == false) {
+    // Earlier Custom values stored panel glass as booleans.
+    tuning.panel_material = PanelMaterial::kSolid;
+  } else if (dict.FindBool("panelRefractive") == true) {
+    tuning.panel_material = PanelMaterial::kGlassmorphic;
+  }
+  tuning.panel_blur = Clamped(dict.FindDouble(kSurfaceTuningPanelBlurKey),
+                              tuning.panel_blur, kMaxScrimBlur);
+  tuning.panel_tint = Clamped(dict.FindDouble(kSurfaceTuningPanelTintKey),
+                              tuning.panel_tint, 1.0);
+  if (const std::string* color =
+          dict.FindString(kSurfaceTuningPanelTintColorKey)) {
+    tuning.panel_tint_color =
+        ParseTintColor(*color).value_or(tuning.panel_tint_color);
+  }
+  tuning.panel_shadow =
+      dict.FindBool(kSurfaceTuningPanelShadowKey).value_or(tuning.panel_shadow);
+  if (const std::string* finish =
+          dict.FindString(kSurfaceTuningControlFinishKey)) {
+    tuning.control = ParseFinish(*finish).value_or(tuning.control);
+  }
+  tuning.control_tint = Clamped(dict.FindDouble(kSurfaceTuningControlTintKey),
+                                tuning.control_tint, 1.0);
+  tuning.control_edge = Clamped(dict.FindDouble(kSurfaceTuningControlEdgeKey),
+                                tuning.control_edge, 1.0);
+  tuning.scrim_blur = Clamped(dict.FindDouble(kSurfaceTuningScrimBlurKey),
+                              tuning.scrim_blur, kMaxScrimBlur);
+  tuning.scrim_dim = Clamped(dict.FindDouble(kSurfaceTuningScrimDimKey),
+                             tuning.scrim_dim, 1.0);
+  return tuning;
+}
+
+std::optional<SurfaceTuning> ParseSurfaceTuningStrict(
+    const base::DictValue& dict) {
+  if ((dict.size() != 9 && dict.size() != 10) ||
+      (dict.size() == 10 && !dict.Find(kSurfaceTuningPanelBlurKey))) {
+    return std::nullopt;
+  }
+  const std::string* material_name =
+      dict.FindString(kSurfaceTuningPanelMaterialKey);
+  const std::optional<PanelMaterial> material =
+      material_name ? ParsePanelMaterial(*material_name) : std::nullopt;
+  const std::string* color_name =
+      dict.FindString(kSurfaceTuningPanelTintColorKey);
+  const std::optional<std::optional<SkColor>> tint_color =
+      color_name ? ParseTintColor(*color_name) : std::nullopt;
+  const std::optional<bool> panel_shadow =
+      dict.FindBool(kSurfaceTuningPanelShadowKey);
+  const std::string* finish = dict.FindString(kSurfaceTuningControlFinishKey);
+  const std::optional<SurfaceFinish> control =
+      finish ? ParseFinish(*finish) : std::nullopt;
+  const auto panel_blur = dict.Find(kSurfaceTuningPanelBlurKey)
+                              ? StrictNumber(dict, kSurfaceTuningPanelBlurKey,
+                                             kMaxScrimBlur)
+                              : std::optional<double>(9.0);
+  const auto panel_tint = StrictNumber(dict, kSurfaceTuningPanelTintKey, 1.0);
+  const auto control_tint =
+      StrictNumber(dict, kSurfaceTuningControlTintKey, 1.0);
+  const auto control_edge =
+      StrictNumber(dict, kSurfaceTuningControlEdgeKey, 1.0);
+  const auto scrim_blur =
+      StrictNumber(dict, kSurfaceTuningScrimBlurKey, kMaxScrimBlur);
+  const auto scrim_dim = StrictNumber(dict, kSurfaceTuningScrimDimKey, 1.0);
+  if (!material || !tint_color || !panel_shadow || !control || !panel_tint ||
+      !panel_blur || !control_tint || !control_edge || !scrim_blur || !scrim_dim) {
+    return std::nullopt;
+  }
+  return SurfaceTuning{
+      .panel_material = *material,
+      .panel_tint = *panel_tint,
+      .panel_blur = *panel_blur,
+      .panel_tint_color = *tint_color,
+      .panel_shadow = *panel_shadow,
+      .control = *control,
+      .control_tint = *control_tint,
+      .control_edge = *control_edge,
+      .scrim_blur = *scrim_blur,
+      .scrim_dim = *scrim_dim,
+  };
+}
+
+base::DictValue SerializeSurfaceTuning(const SurfaceTuning& tuning) {
+  return base::DictValue()
+      .Set(kSurfaceTuningPanelMaterialKey,
+           PanelMaterialString(tuning.panel_material))
+      .Set(kSurfaceTuningPanelTintKey, tuning.panel_tint)
+      .Set(kSurfaceTuningPanelBlurKey, tuning.panel_blur)
+      .Set(kSurfaceTuningPanelTintColorKey,
+           TintColorString(tuning.panel_tint_color))
+      .Set(kSurfaceTuningPanelShadowKey, tuning.panel_shadow)
+      .Set(kSurfaceTuningControlFinishKey, FinishString(tuning.control))
+      .Set(kSurfaceTuningControlTintKey, tuning.control_tint)
+      .Set(kSurfaceTuningControlEdgeKey, tuning.control_edge)
+      .Set(kSurfaceTuningScrimBlurKey, tuning.scrim_blur)
+      .Set(kSurfaceTuningScrimDimKey, tuning.scrim_dim);
+}
+
+SurfaceTuning ReadSurfaceTuning(const PrefService* prefs, SurfaceSet set) {
+  if (set != SurfaceSet::kCustom || !prefs ||
+      !prefs->FindPreference(kArciumSurfaceTuningPref)) {
+    return PresetSurfaceTuning(set);
+  }
+  return ParseSurfaceTuning(prefs->GetDict(kArciumSurfaceTuningPref));
+}
+
+SurfaceInputs ReadSurfaceInputs(const PrefService* prefs) {
+  const SurfaceSet set = ReadSurfaceSet(prefs);
+  const SurfaceTuning tuning = ReadSurfaceTuning(prefs, set);
+  std::optional<SkColor> window_tint_color;
+  if (!tuning.panel_tint_color && prefs &&
+      prefs->FindPreference(kArciumChromeAppearancePref)) {
+    // Follow an actual window glass color without copying it into the saved
+    // panel tuning, so editing or removing that color updates every panel.
+    const auto window = ReadGlassSurfaceConfiguration(prefs);
+    if (window.point_count > 0) {
+      window_tint_color = window.points[0].color.toSkColor();
+    }
+  }
+  return {
+      .set = set,
+      .panel = ReadPanelChoice(prefs),
+      .tuning = tuning,
+      .window_tint_color = window_tint_color,
+  };
+}
+
+SurfaceStyle ResolveSurfaceStyle(const SurfaceInputs& inputs) {
+  const SurfaceTuning& tuning = inputs.tuning;
+  SurfaceStyle style;
+  switch (inputs.panel) {
+    case PanelChoice::kSolid:
+      style.panel_material = PanelMaterial::kSolid;
+      break;
+    case PanelChoice::kGlass:
+      // An explicit glass choice keeps the preset's glass, or Clear.
+      style.panel_material = tuning.panel_material == PanelMaterial::kSolid
+                                 ? PanelMaterial::kLiquid
+                                 : tuning.panel_material;
+      break;
+    case PanelChoice::kAutomatic:
+      style.panel_material = tuning.panel_material;
+      break;
+  }
+  style.panel_glass = style.panel_material != PanelMaterial::kSolid;
+  // Frosted is an untinted material. Retain the shared saved tint for when
+  // another panel material is selected.
+  style.panel_tint = style.panel_material == PanelMaterial::kFrosted
+                         ? 0.f : static_cast<float>(tuning.panel_tint);
+  style.panel_blur = static_cast<float>(tuning.panel_blur);
+  style.panel_tint_color = tuning.panel_tint_color ? tuning.panel_tint_color
+                                                : inputs.window_tint_color;
+  style.panel_shadow = tuning.panel_shadow;
+  style.control_tint = static_cast<float>(tuning.control_tint);
+  style.control_edge_alpha =
+      static_cast<SkAlpha>(std::lround(tuning.control_edge * 255));
+
+  if (!inputs.embedded_glass_available) {
+    style.scrim = kDimScrim;
+    return style;
+  }
+  if (style.panel_glass) {
+    style.embedded_panel = style.panel_material == PanelMaterial::kGlassmorphic
+                               ? SurfaceFinish::kRefractive
+                               : SurfaceFinish::kGlass;
+  }
+  style.control = tuning.control;
+  style.scrim = {
+      .blur_sigma = static_cast<float>(tuning.scrim_blur),
+      .dim_alpha = static_cast<SkAlpha>(std::lround(tuning.scrim_dim * 255)),
+  };
+  return style;
+}
+
+SkColor PanelSolidColor(const SurfaceStyle& style) {
+  return color_utils::AlphaBlend(
+      style.panel_tint_color.value_or(kPanelSolidColor), kPanelSolidColor,
+      style.panel_tint);
+}
+
+GlassSurfaceConfiguration PanelGlassConfiguration(
+    const GlassSurfaceConfiguration& window,
+    const SurfaceStyle& style) {
+  GlassSurfaceConfiguration panel = window;
+  panel.enabled = style.panel_glass;
+  panel.material = style.panel_material == PanelMaterial::kFast
+                       ? GlassSurfaceMaterial::kFrosted
+                       : GlassSurfaceMaterial::kLiquidGlass;
+  panel.glass_tint_opacity = style.panel_tint;
+  panel.glass_style = GlassSurfaceGlassStyle::kClear;
+  panel.grain = 0.0;
+  panel.point_count = 0;
+  panel.points = {};
+  panel.match_color_adjustments = false;
+  return panel;
+}
+
+GlassSurfaceConfiguration ReadPanelGlassConfiguration(
+    const PrefService* prefs,
+    const SurfaceStyle& style) {
+  GlassSurfaceConfiguration window = DefaultGlassSurfaceConfiguration();
+  if (prefs && prefs->FindPreference(kArciumChromeAppearancePref)) {
+    window = ReadGlassSurfaceConfiguration(prefs);
+  }
+  return PanelGlassConfiguration(window, style);
+}
+
+GlassSurfaceParams EmbeddedGlassParams(SurfaceFinish finish,
+                                       SkColor tint,
+                                       float tint_strength,
+                                       SkColor opaque_color,
+                                       const gfx::RoundedCornersF& radii,
+                                       float backdrop_blur_sigma) {
+  GlassSurfaceParams params;
+  params.backdrop_blur_sigma = backdrop_blur_sigma;
+  params.preset = finish == SurfaceFinish::kRefractive
+                      ? GlassSurfacePreset::kGlassmorphic
+                      : GlassSurfacePreset::kBasic;
+  params.tint_color = tint;
+  params.tint_strength = tint_strength;
+  params.tint_replaces_preset = true;
+  params.opaque_color = opaque_color;
+  params.corner_radii = radii;
+  return params;
+}
+
+}  // namespace helium
