+// Copyright 2026 The Helium Authors
+// You can use, redistribute, and/or modify this source code under
+// the terms of the GPL-3.0 license found in the LICENSE file.
+
+#include "chrome/browser/ui/views/helium/surface_style.h"
+
+#include "chrome/browser/ui/helium/arcium_appearance_prefs.h"
+#include "components/prefs/pref_registry_simple.h"
+#include "components/prefs/testing_pref_service.h"
+#include "testing/gtest/include/gtest/gtest.h"
+
+namespace helium {
+namespace {
+
+SurfaceStyle Resolve(SurfaceSet set,
+                     PanelChoice panel = PanelChoice::kAutomatic,
+                     bool embedded_glass_available = true) {
+  return ResolveSurfaceStyle({.set = set,
+                              .panel = panel,
+                              .embedded_glass_available =
+                                  embedded_glass_available,
+                              .tuning = PresetSurfaceTuning(set)});
+}
+
+TEST(SurfaceStyleTest, SetNamesRoundTripAndRejectUnknownValues) {
+  for (SurfaceSet set : {SurfaceSet::kGlass, SurfaceSet::kRefractive,
+                         SurfaceSet::kQuiet, SurfaceSet::kSolid,
+                         SurfaceSet::kCustom}) {
+    EXPECT_EQ(ParseSurfaceSet(SurfaceSetString(set)), set);
+  }
+  EXPECT_FALSE(ParseSurfaceSet("liquid"));
+  EXPECT_FALSE(ParseSurfaceSet(""));
+}
+
+TEST(SurfaceStyleTest, MissingAndMalformedPrefsUseDefaults) {
+  EXPECT_EQ(ReadSurfaceSet(nullptr), SurfaceSet::kGlass);
+  EXPECT_EQ(ReadPanelChoice(nullptr), PanelChoice::kAutomatic);
+
+  TestingPrefServiceSimple prefs;
+  EXPECT_EQ(ReadSurfaceSet(&prefs), SurfaceSet::kGlass);
+  EXPECT_EQ(ReadPanelChoice(&prefs), PanelChoice::kAutomatic);
+
+  prefs.registry()->RegisterStringPref(kArciumSurfaceSetPref,
+                                       kSurfaceSetGlass);
+  prefs.registry()->RegisterDictionaryPref(kArciumSurfaceTuningPref);
+  prefs.registry()->RegisterIntegerPref(
+      arcium::kCommandBarAppearancePref,
+      arcium::kCommandBarAppearanceAutomatic);
+  prefs.SetString(kArciumSurfaceSetPref, "unknown");
+  EXPECT_EQ(ReadSurfaceSet(&prefs), SurfaceSet::kGlass);
+  prefs.SetString(kArciumSurfaceSetPref, kSurfaceSetQuiet);
+  EXPECT_EQ(ReadSurfaceSet(&prefs), SurfaceSet::kQuiet);
+
+  for (int invalid : {-1, 3, 99}) {
+    prefs.SetInteger(arcium::kCommandBarAppearancePref, invalid);
+    EXPECT_EQ(ReadPanelChoice(&prefs), PanelChoice::kSolid);
+  }
+  prefs.SetInteger(arcium::kCommandBarAppearancePref,
+                   arcium::kCommandBarAppearanceGlass);
+  EXPECT_EQ(ReadPanelChoice(&prefs), PanelChoice::kGlass);
+}
+
+TEST(SurfaceStyleTest, PresetsChooseEveryRole) {
+  const SurfaceStyle glass = Resolve(SurfaceSet::kGlass);
+  EXPECT_TRUE(glass.panel_glass);
+  EXPECT_EQ(glass.embedded_panel, SurfaceFinish::kGlass);
+  EXPECT_EQ(glass.control, SurfaceFinish::kGlass);
+  EXPECT_GT(glass.scrim.blur_sigma, 0.0f);
+
+  const SurfaceStyle refractive = Resolve(SurfaceSet::kRefractive);
+  EXPECT_TRUE(refractive.panel_glass);
+  EXPECT_EQ(refractive.embedded_panel, SurfaceFinish::kRefractive);
+  EXPECT_EQ(refractive.control, SurfaceFinish::kRefractive);
+
+  const SurfaceStyle quiet = Resolve(SurfaceSet::kQuiet);
+  EXPECT_FALSE(quiet.panel_glass);
+  EXPECT_EQ(quiet.embedded_panel, SurfaceFinish::kSolid);
+  EXPECT_EQ(quiet.control, SurfaceFinish::kGlass);
+  EXPECT_GT(quiet.scrim.blur_sigma, 0.0f);
+  EXPECT_LT(quiet.scrim.blur_sigma, glass.scrim.blur_sigma);
+
+  const SurfaceStyle solid = Resolve(SurfaceSet::kSolid);
+  EXPECT_FALSE(solid.panel_glass);
+  EXPECT_EQ(solid.control, SurfaceFinish::kSolid);
+  EXPECT_EQ(solid.scrim.blur_sigma, 0.0f);
+}
+
+TEST(SurfaceStyleTest, ExplicitPanelChoiceOverridesThePreset) {
+  EXPECT_FALSE(Resolve(SurfaceSet::kGlass, PanelChoice::kSolid).panel_glass);
+  const SurfaceStyle glass_in_solid =
+      Resolve(SurfaceSet::kSolid, PanelChoice::kGlass);
+  EXPECT_TRUE(glass_in_solid.panel_glass);
+  EXPECT_EQ(glass_in_solid.embedded_panel, SurfaceFinish::kGlass);
+  EXPECT_EQ(glass_in_solid.control, SurfaceFinish::kSolid);
+}
+
+TEST(SurfaceStyleTest, UnavailableEmbeddedGlassKeepsPanelChoiceButPaintsSolid) {
+  const SurfaceStyle style =
+      Resolve(SurfaceSet::kGlass, PanelChoice::kAutomatic, false);
+  // Native panels resolve their own availability and fallback.
+  EXPECT_TRUE(style.panel_glass);
+  EXPECT_EQ(style.embedded_panel, SurfaceFinish::kSolid);
+  EXPECT_EQ(style.control, SurfaceFinish::kSolid);
+  EXPECT_EQ(style.scrim.blur_sigma, 0.0f);
+}
+
+TEST(SurfaceStyleTest, CustomValuesDriveEveryRole) {
+  SurfaceTuning tuning;
+  tuning.panel_glass = false;
+  tuning.panel_tint = 0.1;
+  tuning.panel_clear = true;
+  tuning.panel_refractive = true;
+  tuning.control = SurfaceFinish::kRefractive;
+  tuning.control_tint = 0.2;
+  tuning.control_edge = 1.0;
+  tuning.scrim_blur = 12;
+  tuning.scrim_dim = 0.5;
+  const SurfaceStyle style =
+      ResolveSurfaceStyle({.set = SurfaceSet::kCustom, .tuning = tuning});
+  EXPECT_FALSE(style.panel_glass);
+  EXPECT_FLOAT_EQ(style.panel_tint, 0.1f);
+  EXPECT_TRUE(style.panel_clear);
+  EXPECT_EQ(style.embedded_panel, SurfaceFinish::kSolid);
+  EXPECT_EQ(style.control, SurfaceFinish::kRefractive);
+  EXPECT_FLOAT_EQ(style.control_tint, 0.2f);
+  EXPECT_EQ(style.control_edge_alpha, 255);
+  EXPECT_FLOAT_EQ(style.scrim.blur_sigma, 12.0f);
+  EXPECT_EQ(style.scrim.dim_alpha, 128);
+}
+
+TEST(SurfaceStyleTest, CustomKeepsTheRefractivePanelFinish) {
+  SurfaceTuning tuning = PresetSurfaceTuning(SurfaceSet::kRefractive);
+  tuning.scrim_dim = 0.6;
