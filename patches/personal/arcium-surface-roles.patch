+
+bool PreviewTabs(BrowserView* browser_view,
+                 std::vector<content::WebContents*>* tabs) {
+  TabStripModel* model = browser_view->browser()->tab_strip_model();
+  content::WebContents* active = model->GetActiveWebContents();
+  if (!active || !browser_view->GetWidget() ||
+      browser_view->GetWidget()->IsClosed()) {
+    return false;
+  }
+  tabs->assign({active});
+  for (int i = 0; i < model->count() && tabs->size() < 5; ++i) {
+    if (content::WebContents* contents = model->GetWebContentsAt(i);
+        contents != active) {
+      tabs->push_back(contents);
+    }
+  }
+  return true;
+}
+
+void ShowMRUTabSwitcherPreview(BrowserView* browser_view) {
+  auto& visualizers = GetMRUTabSwitcherVisualizers();
+  if (auto it = visualizers.find(browser_view); it != visualizers.end() &&
+      (!it->second->preview() || it->second->MatchesProfileStyle())) {
+    // Cycling owns this overlay, or it already shows the current style.
+    return;
+  }
+  std::vector<content::WebContents*> tabs;
+  if (!PreviewTabs(browser_view, &tabs)) {
+    return;
+  }
+  visualizers.erase(browser_view);
+  auto& visualizer = visualizers[browser_view];
+  visualizer = std::make_unique<MRUTabSwitcherOverlay>(browser_view,
+                                                       /*preview=*/true);
+  visualizer->Update(tabs, tabs.front());
+}
+
+void HideMRUTabSwitcherPreviews(Profile* profile, BrowserView* except) {
+  base::EraseIf(GetMRUTabSwitcherVisualizers(),
+                [profile, except](const auto& entry) {
+                  return entry.first != except && entry.second->preview() &&
+                         entry.first->GetProfile()->GetOriginalProfile() ==
+                             profile;
+                });
+}
+
+void MRUTabSwitcherOverlay::ReturnToPreview() {
+  std::vector<content::WebContents*> tabs;
+  if (!PreviewTabs(browser_view_, &tabs)) {
+    // No tab is left to show. Destroys this overlay; nothing may follow.
+    GetMRUTabSwitcherVisualizers().erase(browser_view_);
+    return;
+  }
+  Update(tabs, tabs.front());
+}
+
+void MRUTabSwitcherOverlay::OnWidgetClosing(views::Widget* widget) {
+  // Destroys this overlay; nothing may follow.
+  GetMRUTabSwitcherVisualizers().erase(browser_view_);
 }
 
