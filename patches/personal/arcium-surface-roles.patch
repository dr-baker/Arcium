+  }
+  if (value == kSurfaceFinishRefractive) {
+    return SurfaceFinish::kRefractive;
+  }
+  if (value == kSurfaceFinishSolid) {
+    return SurfaceFinish::kSolid;
+  }
+  return std::nullopt;
+}
+
+const char* FinishString(SurfaceFinish finish) {
+  switch (finish) {
+    case SurfaceFinish::kGlass:
+      return kSurfaceFinishGlass;
+    case SurfaceFinish::kRefractive:
+      return kSurfaceFinishRefractive;
+    case SurfaceFinish::kSolid:
+      return kSurfaceFinishSolid;
+  }
+  NOTREACHED();
+}
+
+double Clamped(std::optional<double> value, double fallback, double max) {
+  return value && std::isfinite(*value) ? std::clamp(*value, 0.0, max)
+                                        : fallback;
+}
+
+std::optional<double> StrictNumber(const base::DictValue& dict,
+                                   const char* key,
+                                   double max) {
+  const base::Value* value = dict.Find(key);
+  if (!value || !(value->is_double() || value->is_int())) {
+    return std::nullopt;
+  }
+  const double number = value->GetDouble();
+  if (!std::isfinite(number) || number < 0.0 || number > max) {
+    return std::nullopt;
+  }
+  return number;
+}
+
+}  // namespace
+
+std::optional<SurfaceSet> ParseSurfaceSet(std::string_view value) {
+  if (value == kSurfaceSetGlass) {
+    return SurfaceSet::kGlass;
+  }
+  if (value == kSurfaceSetRefractive) {
+    return SurfaceSet::kRefractive;
+  }
+  if (value == kSurfaceSetQuiet) {
+    return SurfaceSet::kQuiet;
+  }
+  if (value == kSurfaceSetSolid) {
+    return SurfaceSet::kSolid;
+  }
+  if (value == kSurfaceSetCustom) {
+    return SurfaceSet::kCustom;
+  }
+  return std::nullopt;
+}
+
+const char* SurfaceSetString(SurfaceSet set) {
+  switch (set) {
+    case SurfaceSet::kGlass:
+      return kSurfaceSetGlass;
+    case SurfaceSet::kRefractive:
+      return kSurfaceSetRefractive;
+    case SurfaceSet::kQuiet:
+      return kSurfaceSetQuiet;
+    case SurfaceSet::kSolid:
+      return kSurfaceSetSolid;
+    case SurfaceSet::kCustom:
+      return kSurfaceSetCustom;
+  }
+  NOTREACHED();
+}
+
+PanelChoice PanelChoiceFromPref(int value) {
+  switch (value) {
+    case arcium::kCommandBarAppearanceSolid:
+      return PanelChoice::kSolid;
+    case arcium::kCommandBarAppearanceGlass:
+      return PanelChoice::kGlass;
+    case arcium::kCommandBarAppearanceAutomatic:
+      return PanelChoice::kAutomatic;
+  }
+  // Unknown values must not silently become glass.
+  return PanelChoice::kSolid;
+}
+
+SurfaceSet ReadSurfaceSet(const PrefService* prefs) {
+  if (!prefs || !prefs->FindPreference(kArciumSurfaceSetPref)) {
+    return SurfaceSet::kGlass;
+  }
+  return ParseSurfaceSet(prefs->GetString(kArciumSurfaceSetPref))
+      .value_or(SurfaceSet::kGlass);
+}
+
+PanelChoice ReadPanelChoice(const PrefService* prefs) {
+  if (!prefs || !prefs->FindPreference(arcium::kCommandBarAppearancePref)) {
+    return PanelChoice::kAutomatic;
+  }
+  return PanelChoiceFromPref(
+      prefs->GetInteger(arcium::kCommandBarAppearancePref));
+}
+
+SurfaceTuning PresetSurfaceTuning(SurfaceSet set) {
+  SurfaceTuning tuning;
+  switch (set) {
+    case SurfaceSet::kGlass:
+    case SurfaceSet::kCustom:
+      break;
+    case SurfaceSet::kRefractive:
+      tuning.panel_tint = 0.2;
+      tuning.panel_clear = true;
+      tuning.panel_refractive = true;
+      tuning.control = SurfaceFinish::kRefractive;
+      tuning.control_tint = 0.4;
+      break;
+    case SurfaceSet::kQuiet:
+      tuning.panel_glass = false;
+      tuning.control_tint = 0.6;
+      tuning.control_edge = 0.3;
+      tuning.scrim_blur = 4.0;
+      tuning.scrim_dim = 0.5;
+      break;
+    case SurfaceSet::kSolid:
+      tuning.panel_glass = false;
+      tuning.control = SurfaceFinish::kSolid;
+      tuning.scrim_blur = 0.0;
+      tuning.scrim_dim = 0.72;
+      break;
+  }
+  return tuning;
+}
+
+SurfaceTuning ParseSurfaceTuning(const base::DictValue& dict) {
+  SurfaceTuning tuning = PresetSurfaceTuning(SurfaceSet::kGlass);
+  tuning.panel_glass =
+      dict.FindBool(kSurfaceTuningPanelGlassKey).value_or(tuning.panel_glass);
+  tuning.panel_tint = Clamped(dict.FindDouble(kSurfaceTuningPanelTintKey),
+                              tuning.panel_tint, 1.0);
+  tuning.panel_clear =
+      dict.FindBool(kSurfaceTuningPanelClearKey).value_or(tuning.panel_clear);
+  tuning.panel_refractive = dict.FindBool(kSurfaceTuningPanelRefractiveKey)
+                                .value_or(tuning.panel_refractive);
+  if (const std::string* finish =
+          dict.FindString(kSurfaceTuningControlFinishKey)) {
+    tuning.control = ParseFinish(*finish).value_or(tuning.control);
+  }
+  tuning.control_tint = Clamped(dict.FindDouble(kSurfaceTuningControlTintKey),
+                                tuning.control_tint, 1.0);
+  tuning.control_edge = Clamped(dict.FindDouble(kSurfaceTuningControlEdgeKey),
+                                tuning.control_edge, 1.0);
+  tuning.scrim_blur = Clamped(dict.FindDouble(kSurfaceTuningScrimBlurKey),
+                              tuning.scrim_blur, kMaxScrimBlur);
+  tuning.scrim_dim = Clamped(dict.FindDouble(kSurfaceTuningScrimDimKey),
+                             tuning.scrim_dim, 1.0);
+  return tuning;
+}
+
+std::optional<SurfaceTuning> ParseSurfaceTuningStrict(
+    const base::DictValue& dict) {
+  if (dict.size() != 9) {
+    return std::nullopt;
+  }
+  const std::optional<bool> panel_glass =
+      dict.FindBool(kSurfaceTuningPanelGlassKey);
+  const std::optional<bool> panel_clear =
+      dict.FindBool(kSurfaceTuningPanelClearKey);
+  const std::optional<bool> panel_refractive =
+      dict.FindBool(kSurfaceTuningPanelRefractiveKey);
+  const std::string* finish = dict.FindString(kSurfaceTuningControlFinishKey);
+  const std::optional<SurfaceFinish> control =
+      finish ? ParseFinish(*finish) : std::nullopt;
+  const auto panel_tint = StrictNumber(dict, kSurfaceTuningPanelTintKey, 1.0);
+  const auto control_tint =
+      StrictNumber(dict, kSurfaceTuningControlTintKey, 1.0);
+  const auto control_edge =
+      StrictNumber(dict, kSurfaceTuningControlEdgeKey, 1.0);
+  const auto scrim_blur =
+      StrictNumber(dict, kSurfaceTuningScrimBlurKey, kMaxScrimBlur);
+  const auto scrim_dim = StrictNumber(dict, kSurfaceTuningScrimDimKey, 1.0);
+  if (!panel_glass || !panel_clear || !panel_refractive || !control || !panel_tint ||
+      !control_tint || !control_edge || !scrim_blur || !scrim_dim) {
+    return std::nullopt;
+  }
+  return SurfaceTuning{
+      .panel_glass = *panel_glass,
+      .panel_tint = *panel_tint,
+      .panel_clear = *panel_clear,
+      .panel_refractive = *panel_refractive,
+      .control = *control,
+      .control_tint = *control_tint,
+      .control_edge = *control_edge,
+      .scrim_blur = *scrim_blur,
+      .scrim_dim = *scrim_dim,
+  };
+}
+
+base::DictValue SerializeSurfaceTuning(const SurfaceTuning& tuning) {
+  return base::DictValue()
+      .Set(kSurfaceTuningPanelGlassKey, tuning.panel_glass)
+      .Set(kSurfaceTuningPanelTintKey, tuning.panel_tint)
+      .Set(kSurfaceTuningPanelClearKey, tuning.panel_clear)
+      .Set(kSurfaceTuningPanelRefractiveKey, tuning.panel_refractive)
+      .Set(kSurfaceTuningControlFinishKey, FinishString(tuning.control))
+      .Set(kSurfaceTuningControlTintKey, tuning.control_tint)
+      .Set(kSurfaceTuningControlEdgeKey, tuning.control_edge)
+      .Set(kSurfaceTuningScrimBlurKey, tuning.scrim_blur)
+      .Set(kSurfaceTuningScrimDimKey, tuning.scrim_dim);
+}
+
+SurfaceTuning ReadSurfaceTuning(const PrefService* prefs, SurfaceSet set) {
+  if (set != SurfaceSet::kCustom || !prefs ||
+      !prefs->FindPreference(kArciumSurfaceTuningPref)) {
+    return PresetSurfaceTuning(set);
+  }
+  return ParseSurfaceTuning(prefs->GetDict(kArciumSurfaceTuningPref));
+}
+
+SurfaceInputs ReadSurfaceInputs(const PrefService* prefs) {
+  const SurfaceSet set = ReadSurfaceSet(prefs);
+  return {
+      .set = set,
+      .panel = ReadPanelChoice(prefs),
+      .tuning = ReadSurfaceTuning(prefs, set),
+  };
+}
+
+SurfaceStyle ResolveSurfaceStyle(const SurfaceInputs& inputs) {
+  const SurfaceTuning& tuning = inputs.tuning;
+  SurfaceStyle style;
+  switch (inputs.panel) {
+    case PanelChoice::kSolid:
+      style.panel_glass = false;
+      break;
+    case PanelChoice::kGlass:
+      style.panel_glass = true;
+      break;
+    case PanelChoice::kAutomatic:
+      style.panel_glass = tuning.panel_glass;
+      break;
+  }
+  style.panel_tint = static_cast<float>(tuning.panel_tint);
+  style.panel_clear = tuning.panel_clear;
+  style.control_tint = static_cast<float>(tuning.control_tint);
+  style.control_edge_alpha =
+      static_cast<SkAlpha>(std::lround(tuning.control_edge * 255));
+
+  if (!inputs.embedded_glass_available) {
+    style.scrim = kDimScrim;
+    return style;
+  }
+  if (style.panel_glass) {
+    style.embedded_panel = tuning.panel_refractive ? SurfaceFinish::kRefractive
+                                                   : SurfaceFinish::kGlass;
+  }
+  style.control = tuning.control;
+  style.scrim = {
+      .blur_sigma = static_cast<float>(tuning.scrim_blur),
+      .dim_alpha = static_cast<SkAlpha>(std::lround(tuning.scrim_dim * 255)),
+  };
+  return style;
+}
+
+GlassSurfaceConfiguration PanelGlassConfiguration(
+    const GlassSurfaceConfiguration& window,
+    const SurfaceStyle& style) {
+  GlassSurfaceConfiguration panel = window;
+  panel.enabled = style.panel_glass;
+  if (panel.material == GlassSurfaceMaterial::kSolid) {
+    panel.material = GlassSurfaceMaterial::kAuto;
+  }
+  panel.glass_tint_opacity = style.panel_tint;
+  panel.glass_style = style.panel_clear ? GlassSurfaceGlassStyle::kClear
+                                        : GlassSurfaceGlassStyle::kRegular;
+  panel.grain = 0.0;
+  panel.point_count = 0;
+  panel.points = {};
+  panel.match_color_adjustments = false;
+  return panel;
+}
+
+GlassSurfaceConfiguration ReadPanelGlassConfiguration(
+    const PrefService* prefs,
+    const SurfaceStyle& style) {
+  GlassSurfaceConfiguration window = DefaultGlassSurfaceConfiguration();
+  if (prefs && prefs->FindPreference(kArciumChromeAppearancePref)) {
+    window = ReadGlassSurfaceConfiguration(prefs);
+  }
+  return PanelGlassConfiguration(window, style);
+}
+
+GlassSurfaceParams EmbeddedGlassParams(SurfaceFinish finish,
+                                       SkColor tint,
+                                       float tint_strength,
+                                       SkColor opaque_color,
+                                       const gfx::RoundedCornersF& radii) {
+  GlassSurfaceParams params;
+  params.preset = finish == SurfaceFinish::kRefractive
+                      ? GlassSurfacePreset::kGlassmorphic
+                      : GlassSurfacePreset::kBasic;
+  params.tint_color = tint;
+  params.tint_strength = tint_strength;
+  params.tint_replaces_preset = true;
+  params.opaque_color = opaque_color;
+  params.corner_radii = radii;
+  return params;
+}
+
+}  // namespace helium
