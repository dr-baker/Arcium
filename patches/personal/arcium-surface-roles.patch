+TEST(SurfaceStyleTest, PanelBlurSupportsOlderSettingsAndRejectsBadValues) {
+  auto dict = SerializeSurfaceTuning(SurfaceTuning());
+  dict.Remove(kSurfaceTuningPanelBlurKey);
+  ASSERT_TRUE(ParseSurfaceTuningStrict(dict));
+  EXPECT_DOUBLE_EQ(ParseSurfaceTuningStrict(dict)->panel_blur, 9.0);
+  dict.Set("unknown", 5);
+  EXPECT_FALSE(ParseSurfaceTuningStrict(dict));
+  dict.Remove("unknown");
+  for (double blur : {-1.0, 31.0}) {
+    dict.Set(kSurfaceTuningPanelBlurKey, blur);
+    EXPECT_FALSE(ParseSurfaceTuningStrict(dict));
+  }
+  dict.Set(kSurfaceTuningPanelBlurKey, "blur");
+  EXPECT_FALSE(ParseSurfaceTuningStrict(dict));
+  dict.Set(kSurfaceTuningPanelBlurKey, 20);
+  ASSERT_TRUE(ParseSurfaceTuningStrict(dict));
+  EXPECT_DOUBLE_EQ(ParseSurfaceTuningStrict(dict)->panel_blur, 20);
+}
