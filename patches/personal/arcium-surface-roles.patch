+bool PreviewTabs(BrowserView* browser_view,
+                 std::vector<content::WebContents*>* tabs) {
+  TabStripModel* model = browser_view->browser()->tab_strip_model();
+  content::WebContents* active = model->GetActiveWebContents();
+  if (!active || !browser_view->GetWidget() ||
+      browser_view->GetWidget()->IsClosed()) {
+    return false;
+  }
+  tabs->assign({active});
+  for (int i = 0; i < model->count() && tabs->size() < 5; ++i) {
+    if (content::WebContents* contents = model->GetWebContentsAt(i);
+        contents != active) {
+      tabs->push_back(contents);
+    }
+  }
+  return true;
+}
