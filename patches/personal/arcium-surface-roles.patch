+
+  for (const char* set :
+       {helium::kSurfaceSetQuiet, helium::kSurfaceSetSolid}) {
+    prefs_.SetString(helium::kArciumSurfaceSetPref, set);
+    EXPECT_FALSE(native->last_requested);
+    EXPECT_FALSE(material.uses_native_material());
+  }
+  prefs_.SetString(helium::kArciumSurfaceSetPref,
+                   helium::kSurfaceSetRefractive);
+  EXPECT_TRUE(material.uses_native_material());
+
+  // An explicit choice wins over the set.
+  prefs_.SetString(helium::kArciumSurfaceSetPref, helium::kSurfaceSetSolid);
+  prefs_.SetInteger(kCommandBarAppearancePref, kCommandBarAppearanceGlass);
+  EXPECT_TRUE(material.uses_native_material());
