+      style.embedded_panel, *style.panel_tint_color, style.panel_tint,
+      PanelSolidColor(style), gfx::RoundedCornersF(12), style.panel_blur);
+  EXPECT_FLOAT_EQ(params.tint_strength, .1f);
+  EXPECT_EQ(params.tint_color, SK_ColorWHITE);
+  EXPECT_FLOAT_EQ(params.backdrop_blur_sigma, 24.f);
+}
