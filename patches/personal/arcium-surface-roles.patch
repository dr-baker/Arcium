+TEST_F(ArciumNativePanelTest, ThemeAccentUpdatesSelectionWithoutReplacingInput) {
+  auto motion = gfx::AnimationTestApi::SetRichAnimationRenderMode(
+      gfx::Animation::RichAnimationRenderMode::FORCE_DISABLED);
+  Open();
+  Query(u"arcium");
+  Key(ui::VKEY_DOWN);
+  ASSERT_GE(panel()->selected_for_testing(), 0);
+  auto* input = panel()->input_for_testing();
+  input->SetSelectedRange(gfx::Range(1, 4));
+  const auto selected_key =
+      panel()->row_for_testing(panel()->selected_for_testing()).selection_key;
+  auto* row = panel()->scroll_for_testing()->contents()->children()[
+      panel()->selected_for_testing()].get();
+  gfx::Point sample(row->width() - 4, row->height() / 2);
+  views::View::ConvertPointToTarget(row, widget_->GetRootView(), &sample);
+  widget_->SetColorModeOverride(ui::ColorProviderKey::ColorMode::kDark);
+  widget_->SetUserColorOverride(SkColorSetRGB(220, 50, 70));
+  const SkColor red = PaintPanel().getColor(sample.x(), sample.y());
+  EXPECT_GT(SkColorGetR(red), SkColorGetB(red));
+  widget_->SetUserColorOverride(SkColorSetRGB(50, 80, 220));
+  const SkColor blue = PaintPanel().getColor(sample.x(), sample.y());
+  EXPECT_GT(SkColorGetB(blue), SkColorGetR(blue));
+  EXPECT_NE(red, blue);
+  EXPECT_GT(color_utils::GetContrastRatio(input->GetSelectionTextColor(),
+                                          input->GetSelectionBackgroundColor()),
+            4.5f);
+  EXPECT_EQ(input, panel()->input_for_testing());
+  EXPECT_EQ(u"arcium", input->GetText());
+  EXPECT_EQ(gfx::Range(1, 4), input->GetSelectedRange());
+  EXPECT_EQ(selected_key,
+            panel()->row_for_testing(panel()->selected_for_testing()).selection_key);
+  EXPECT_EQ(row, panel()->scroll_for_testing()->contents()->children()[
+                     panel()->selected_for_testing()].get());
+}
+
+TEST_F(ArciumNativePanelTest, SolidTintUpdatesLiveWithoutReplacingInput) {
+  TestingPrefServiceSimple prefs;
+  prefs.registry()->RegisterDictionaryPref(kCommandPanelLayoutPref);
+  prefs.registry()->RegisterIntegerPref(kChromeUIScalePref, kChromeUIScaleDefault);
+  prefs.registry()->RegisterStringPref(helium::kArciumSurfaceSetPref,
+                                       helium::kSurfaceSetCustom);
+  prefs.registry()->RegisterDictionaryPref(helium::kArciumSurfaceTuningPref);
+  prefs.registry()->RegisterDictionaryPref(helium::kArciumChromeAppearancePref);
+  Open();
+  panel()->BindPreferences(&prefs, base::BindRepeating([] { return 1.f; }),
+                           base::BindRepeating([] { return 900; }));
+  auto* input = panel()->input_for_testing();
+  input->SetText(u"retained query");
+  input->SetSelectedRange(gfx::Range(2, 5));
+  helium::SurfaceTuning tuning;
+  tuning.panel_material = helium::PanelMaterial::kSolid;
+  tuning.panel_tint_color = SK_ColorWHITE;
+  tuning.panel_tint = 1;
+  prefs.SetDict(helium::kArciumSurfaceTuningPref,
+                helium::SerializeSurfaceTuning(tuning));
+  EXPECT_EQ(SK_ColorWHITE, PaintPanel().getColor(50, 100));
+  EXPECT_GT(color_utils::GetContrastRatio(input->GetTextColor(), SK_ColorWHITE),
+            4.5f);
+  EXPECT_EQ(input, panel()->input_for_testing());
+  EXPECT_EQ(u"retained query", input->GetText());
+  EXPECT_EQ(gfx::Range(2, 5), input->GetSelectedRange());
+
+  tuning.panel_tint_color.reset();
+  prefs.SetDict(helium::kArciumSurfaceTuningPref,
+                helium::SerializeSurfaceTuning(tuning));
+  auto window = helium::DefaultGlassSurfaceConfiguration();
+  window.points[0].color = SkColor4f::FromColor(SK_ColorBLUE);
+  prefs.SetDict(helium::kArciumChromeAppearancePref,
+                helium::SerializeGlassSurfaceConfiguration(window));
+  EXPECT_EQ(SK_ColorBLUE, PaintPanel().getColor(50, 100));
+  EXPECT_EQ(u"retained query", input->GetText());
+  widget_.reset();
+}
