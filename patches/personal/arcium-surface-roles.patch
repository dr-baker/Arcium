+#ifndef CHROME_BROWSER_UI_VIEWS_HELIUM_SURFACE_STYLE_H_
+#define CHROME_BROWSER_UI_VIEWS_HELIUM_SURFACE_STYLE_H_
+
+#include <optional>
+#include <string_view>
+
+#include "base/values.h"
+#include "chrome/browser/ui/views/helium/glass_surface.h"
+#include "chrome/browser/ui/views/helium/glass_surface_configuration.h"
+#include "third_party/skia/include/core/SkColor.h"
+#include "ui/gfx/geometry/rounded_corners_f.h"
+
+class PrefService;
+
+namespace helium {
+
+// Floating surfaces are styled by role rather than by feature. The window
+// backdrop keeps its own editor in kArciumChromeAppearancePref; a surface
+// preset fills in every other role at once, and Custom uses the saved values
+// in kArciumSurfaceTuningPref. Geometry, including corner radius, belongs to
+// each surface.
+inline constexpr char kArciumSurfaceSetPref[] = "arcium.appearance.surface_set";
+inline constexpr char kArciumSurfaceTuningPref[] =
+    "arcium.appearance.surface_tuning";
+
+inline constexpr char kSurfaceSetGlass[] = "glass";
+inline constexpr char kSurfaceSetRefractive[] = "refractive";
+inline constexpr char kSurfaceSetQuiet[] = "quiet";
+inline constexpr char kSurfaceSetSolid[] = "solid";
+inline constexpr char kSurfaceSetCustom[] = "custom";
+
+inline constexpr char kSurfaceTuningPanelMaterialKey[] = "panelMaterial";
+inline constexpr char kSurfaceTuningPanelTintKey[] = "panelTint";
+inline constexpr char kSurfaceTuningPanelBlurKey[] = "panelBlur";
+inline constexpr char kSurfaceTuningPanelTintColorKey[] = "panelTintColor";
+inline constexpr char kSurfaceTuningPanelShadowKey[] = "panelShadow";
+inline constexpr char kSurfaceTuningControlFinishKey[] = "controlFinish";
+inline constexpr char kSurfaceTuningControlTintKey[] = "controlTint";
+inline constexpr char kSurfaceTuningControlEdgeKey[] = "controlEdge";
+inline constexpr char kSurfaceTuningScrimBlurKey[] = "scrimBlur";
+inline constexpr char kSurfaceTuningScrimDimKey[] = "scrimDim";
+
+inline constexpr char kPanelMaterialSolid[] = "solid";
+inline constexpr char kPanelMaterialFast[] = "fast";
+// Legacy saved ID: the existing AppKit material is displayed as Clear.
+inline constexpr char kPanelMaterialLiquid[] = "liquid";
+inline constexpr char kPanelMaterialSystemLiquid[] = "systemLiquid";
+inline constexpr char kPanelMaterialFrosted[] = "frosted";
+inline constexpr char kPanelMaterialGlassmorphic[] = "glassmorphic";
+
+inline constexpr char kSurfaceFinishGlass[] = "glass";
+inline constexpr char kSurfaceFinishRefractive[] = "refractive";
+inline constexpr char kSurfaceFinishSolid[] = "solid";
+
+inline constexpr double kMaxScrimBlur = 30.0;
+
+enum class SurfaceSet {
+  // Native glass panels, glass controls, and blurred scrims.
+  kGlass,
+  // As kGlass, with the refraction shader wherever Chromium draws the glass.
+  kRefractive,
+  // Solid panels, glass controls, and lightly blurred scrims.
+  kQuiet,
+  // Solid panels and controls, and dimming scrims.
+  kSolid,
+  // The saved values in kArciumSurfaceTuningPref.
+  kCustom,
+};
+
+// The panel role's explicit choice, stored in the command bar preference.
+// Automatic follows the surface preset.
+enum class PanelChoice {
+  kSolid,
+  kGlass,
+  kAutomatic,
+};
+
+// How a panel (the command bar and the Ctrl+Tab switcher) is drawn.
+enum class PanelMaterial {
+  kSolid,
+  // A system blur material: cheap and stable, with no live refraction.
+  kFast,
+  // Clear: the existing active AppKit material, with saved ID "liquid".
+  kLiquid,
+  // Liquid: public SwiftUI Glass.regular and glassEffect, with native tint.
+  kSystemLiquid,
+  // Clear native Liquid Glass, always drawn in its inactive, frostier state.
+  kFrosted,
+  // Chromium's refraction shader. Only the switcher, which can live inside the
+  // browser window, can use it; the command bar draws Liquid instead.
+  kGlassmorphic,
+};
+
+// How Chromium paints a panel or control that lives inside the browser
+// window. Native glass is only possible for surfaces in their own window.
+enum class SurfaceFinish {
+  kSolid,
+  kGlass,
+  kRefractive,
+};
+
+// The values a preset fills in, and that Custom stores.
+struct SurfaceTuning {
+  // Panels: the command bar, its results, and the Ctrl+Tab switcher.
+  PanelMaterial panel_material = PanelMaterial::kLiquid;
+  // Opacity of the tint over panel glass; 1 is opaque.
+  double panel_tint = 0.3;
+  // Extra Chromium backdrop blur, independent of the tint.
+  double panel_blur = 9.0;
+  // The tint color; nullopt follows the first window glass color, or the
+  // browser theme when the window has no color points.
+  std::optional<SkColor> panel_tint_color;
+  // A soft drop shadow around the panel.
+  bool panel_shadow = true;
+  // Controls: floating buttons over page content, such as Peek's actions.
+  SurfaceFinish control = SurfaceFinish::kGlass;
+  double control_tint = 0.55;
+  double control_edge = 0.38;
+  // Scrims: the page behind a modal surface, such as Peek's source.
+  double scrim_blur = 9.0;
+  double scrim_dim = 0.28;
+
+  bool operator==(const SurfaceTuning&) const = default;
+};
+
+struct ScrimStyle {
+  float blur_sigma = 0.0f;
+  SkAlpha dim_alpha = 184;
+
+  bool operator==(const ScrimStyle&) const = default;
+};
+
+struct SurfaceInputs {
+  SurfaceSet set = SurfaceSet::kGlass;
+  PanelChoice panel = PanelChoice::kAutomatic;
+  // False when Reduce Transparency or a renderer override leaves Chromium
+  // without its live-backdrop renderer.
+  bool embedded_glass_available = true;
+  // The values for `set`; Custom's are read from the profile.
+  SurfaceTuning tuning;
+  // A rendering fallback, kept separate so Settings still sees an empty
+  // panel_tint_color as Window tint rather than as an explicit custom color.
+  std::optional<SkColor> window_tint_color;
+};
+
+struct SurfaceStyle {
+  // Panels request glass. A panel in its own window uses native glass when
+  // the platform resolves one; an embedded panel uses `embedded_panel`.
+  bool panel_glass = false;
+  PanelMaterial panel_material = PanelMaterial::kSolid;
+  SurfaceFinish embedded_panel = SurfaceFinish::kSolid;
+  float panel_tint = 0.3f;
+  float panel_blur = 9.0f;
+  std::optional<SkColor> panel_tint_color;
+  bool panel_shadow = true;
+  SurfaceFinish control = SurfaceFinish::kSolid;
+  float control_tint = 0.55f;
+  SkAlpha control_edge_alpha = 96;
+  ScrimStyle scrim;
+
+  bool operator==(const SurfaceStyle&) const = default;
+};
+
+// Shared panel tokens, matching the command panel's palette.
+inline constexpr SkColor kPanelSolidColor = SkColorSetRGB(29, 30, 28);
+inline constexpr int kPanelShadowElevation = 2;
+inline constexpr int kControlShadowElevation = 2;
+
+std::optional<SurfaceSet> ParseSurfaceSet(std::string_view value);
+const char* SurfaceSetString(SurfaceSet set);
+std::optional<PanelMaterial> ParsePanelMaterial(std::string_view value);
+const char* PanelMaterialString(PanelMaterial material);
+PanelChoice PanelChoiceFromPref(int value);
+
+// Missing or malformed values select the defaults.
+SurfaceSet ReadSurfaceSet(const PrefService* prefs);
+PanelChoice ReadPanelChoice(const PrefService* prefs);
+
+// A preset's values; Custom starts from the Glass preset.
+SurfaceTuning PresetSurfaceTuning(SurfaceSet set);
+// Parses untrusted profile data, clamping values and using the Glass preset
+// for missing or malformed fields.
+SurfaceTuning ParseSurfaceTuning(const base::DictValue& dict);
+// Parses the Settings bridge dictionary: the original fields are required;
+// panelBlur is optional for older clients. Unknown/invalid fields are rejected.
+std::optional<SurfaceTuning> ParseSurfaceTuningStrict(
+    const base::DictValue& dict);
+base::DictValue SerializeSurfaceTuning(const SurfaceTuning& tuning);
+// The preset's values, or the saved values for Custom.
+SurfaceTuning ReadSurfaceTuning(const PrefService* prefs, SurfaceSet set);
+
+// The profile's preset, panel choice, and values. Renderer availability is
+// left to the caller.
+SurfaceInputs ReadSurfaceInputs(const PrefService* prefs);
+
+SurfaceStyle ResolveSurfaceStyle(const SurfaceInputs& inputs);
+
+// Opaque panel/fallback fill with the same tint color and strength as glass.
+SkColor PanelSolidColor(const SurfaceStyle& style);
+
+// The window's glass configuration for a panel, used to resolve renderer
+// availability and fallbacks: native Liquid Glass for Liquid, Frosted, and
+// Glassmorphic, and the system blur material for Fast, with the panel's tint
+// and without color points or grain. `enabled` reports whether the panel
+// requested glass.
+GlassSurfaceConfiguration PanelGlassConfiguration(
+    const GlassSurfaceConfiguration& window,
+    const SurfaceStyle& style);
+GlassSurfaceConfiguration ReadPanelGlassConfiguration(
+    const PrefService* prefs,
+    const SurfaceStyle& style);
+
+// Embedded Chromium glass for a finish other than kSolid. The tint replaces
+// the preset's own color so surfaces follow the browser theme.
+GlassSurfaceParams EmbeddedGlassParams(SurfaceFinish finish,
+                                       SkColor tint,
+                                       float tint_strength,
+                                       SkColor opaque_color,
+                                       const gfx::RoundedCornersF& radii,
+                                       float backdrop_blur_sigma = 0.0f);
+
+}  // namespace helium
+
+#endif  // CHROME_BROWSER_UI_VIEWS_HELIUM_SURFACE_STYLE_H_
