+TEST_F(BrowserViewTest, MRUNativePanelGlassUsesItsOwnInactiveWindow) {
+  PrefService* prefs = browser()->profile()->GetPrefs();
+  prefs->SetInteger(arcium::kCommandBarAppearancePref,
+                    arcium::kCommandBarAppearanceGlass);
+  if (!helium::CanUseNativePanelGlass(prefs)) {
+    GTEST_SKIP() << "Native panel glass is unavailable on this platform.";
+  }
+  AddTab(browser(), GURL("https://mru.test/"));
+  browser_view()->GetWidget()->Show();
+  auto* active = browser()->tab_strip_model()->GetActiveWebContents();
+  browser_view()->SetSize(gfx::Size(1000, 800));
+  const size_t original_child_count = browser_view()->children().size();
+
+  auto find_switcher = [&]() -> views::Widget* {
+    views::Widget::Widgets children = views::Widget::GetAllChildWidgets(
+        browser_view()->GetWidget()->GetNativeView());
+    for (const auto& child : children) {
+      if (child->GetName() == "ArciumMRUTabSwitcher") {
+        return child.get();
+      }
+    }
+    return nullptr;
+  };
+
+  UpdateMRUTabSwitcherVisualizer(browser_view(), {active}, active);
+  EXPECT_EQ(browser_view()->children().size(), original_child_count);
+  views::Widget* switcher = find_switcher();
+  ASSERT_TRUE(switcher);
+  EXPECT_TRUE(switcher->IsVisible());
+  EXPECT_FALSE(switcher->IsActive());
+  EXPECT_FALSE(switcher->CanActivate());
+  EXPECT_EQ(switcher->GetWindowBoundsInScreen().CenterPoint(),
+            browser_view()->GetBoundsInScreen().CenterPoint());
+
   StopMRUTabSwitcherVisualizer(browser_view());
+  EXPECT_FALSE(find_switcher());
 }
 
