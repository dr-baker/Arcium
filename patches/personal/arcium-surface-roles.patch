+TEST(SurfaceStyleTest, SetNamesRoundTripAndRejectUnknownValues) {
+  for (SurfaceSet set : {SurfaceSet::kGlass, SurfaceSet::kRefractive,
+                         SurfaceSet::kQuiet, SurfaceSet::kSolid,
+                         SurfaceSet::kCustom}) {
+    EXPECT_EQ(ParseSurfaceSet(SurfaceSetString(set)), set);
+  }
+  EXPECT_FALSE(ParseSurfaceSet("liquid"));
+  EXPECT_FALSE(ParseSurfaceSet(""));
+}
+
+TEST(SurfaceStyleTest, MissingAndMalformedPrefsUseDefaults) {
+  EXPECT_EQ(ReadSurfaceSet(nullptr), SurfaceSet::kGlass);
+  EXPECT_EQ(ReadPanelChoice(nullptr), PanelChoice::kAutomatic);
+
+  TestingPrefServiceSimple prefs;
+  EXPECT_EQ(ReadSurfaceSet(&prefs), SurfaceSet::kGlass);
+  EXPECT_EQ(ReadPanelChoice(&prefs), PanelChoice::kAutomatic);
+
+  prefs.registry()->RegisterStringPref(kArciumSurfaceSetPref,
+                                       kSurfaceSetGlass);
+  prefs.registry()->RegisterDictionaryPref(kArciumSurfaceTuningPref);
+  prefs.registry()->RegisterIntegerPref(
+      arcium::kCommandBarAppearancePref,
+      arcium::kCommandBarAppearanceAutomatic);
+  prefs.SetString(kArciumSurfaceSetPref, "unknown");
+  EXPECT_EQ(ReadSurfaceSet(&prefs), SurfaceSet::kGlass);
+  prefs.SetString(kArciumSurfaceSetPref, kSurfaceSetQuiet);
+  EXPECT_EQ(ReadSurfaceSet(&prefs), SurfaceSet::kQuiet);
+
+  for (int invalid : {-1, 3, 99}) {
+    prefs.SetInteger(arcium::kCommandBarAppearancePref, invalid);
+    EXPECT_EQ(ReadPanelChoice(&prefs), PanelChoice::kSolid);
+  }
+  prefs.SetInteger(arcium::kCommandBarAppearancePref,
+                   arcium::kCommandBarAppearanceGlass);
+  EXPECT_EQ(ReadPanelChoice(&prefs), PanelChoice::kGlass);
+}
+
+TEST(SurfaceStyleTest, PanelTintFollowsEditableWindowColorAndKeepsCustomOverride) {
+  TestingPrefServiceSimple prefs;
+  prefs.registry()->RegisterStringPref(kArciumSurfaceSetPref, kSurfaceSetGlass);
+  prefs.registry()->RegisterDictionaryPref(kArciumSurfaceTuningPref);
+  prefs.registry()->RegisterDictionaryPref(kArciumChromeAppearancePref);
+
+  auto window = DefaultGlassSurfaceConfiguration();
+  window.point_count = 2;
+  window.points[0].color = SkColor4f::FromColor(SK_ColorRED);
+  window.points[1].color = SkColor4f::FromColor(SK_ColorGREEN);
+  prefs.SetDict(kArciumChromeAppearancePref,
+                SerializeGlassSurfaceConfiguration(window));
+  EXPECT_EQ(ResolveSurfaceStyle(ReadSurfaceInputs(&prefs)).panel_tint_color,
+            SK_ColorRED);
+  EXPECT_FALSE(ReadSurfaceTuning(&prefs, SurfaceSet::kGlass).panel_tint_color);
+  // Settings serializes the input tuning; a resolved window color must not
+  // turn the Window tint choice into a custom color in its snapshot.
+  EXPECT_FALSE(ReadSurfaceInputs(&prefs).tuning.panel_tint_color);
+
+  // Editing the window color changes the tint without saving a panel color.
+  window.points[0].color = SkColor4f::FromColor(SK_ColorBLUE);
+  prefs.SetDict(kArciumChromeAppearancePref,
+                SerializeGlassSurfaceConfiguration(window));
+  EXPECT_EQ(ResolveSurfaceStyle(ReadSurfaceInputs(&prefs)).panel_tint_color,
+            SK_ColorBLUE);
+
+  prefs.SetString(kArciumSurfaceSetPref, kSurfaceSetCustom);
+  SurfaceTuning tuning;
+  tuning.panel_tint_color = SK_ColorYELLOW;
+  prefs.SetDict(kArciumSurfaceTuningPref, SerializeSurfaceTuning(tuning));
+  EXPECT_EQ(ResolveSurfaceStyle(ReadSurfaceInputs(&prefs)).panel_tint_color,
+            SK_ColorYELLOW);
+
+  // Re-enabling Window tint follows the palette again; removing all colors
+  // leaves the color unset for the renderer's browser-theme fallback.
+  tuning.panel_tint_color.reset();
+  prefs.SetDict(kArciumSurfaceTuningPref, SerializeSurfaceTuning(tuning));
+  EXPECT_EQ(ResolveSurfaceStyle(ReadSurfaceInputs(&prefs)).panel_tint_color,
+            SK_ColorBLUE);
+  window.point_count = 0;
+  prefs.SetDict(kArciumChromeAppearancePref,
+                SerializeGlassSurfaceConfiguration(window));
+  EXPECT_FALSE(ResolveSurfaceStyle(ReadSurfaceInputs(&prefs)).panel_tint_color);
+}
