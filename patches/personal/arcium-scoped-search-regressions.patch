+TEST_F(ArciumCommandActionRouterTest,
+       ChatGPTCurrentTabQueryNavigatesToRootInsteadOfExistingConversation) {
+  auto* source = AddOrdinaryTab("https://chatgpt.com/c/existing-conversation");
+  Capture(source);
+  const auto url = BuildCommandSearchUrl(kChatGPTScope, u"  a fresh question  ");
+  ASSERT_TRUE(url);
+  ASSERT_TRUE(router_->Execute(Intent(CommandUrlTarget{.url = *url})).success);
+
+  ASSERT_EQ(1, browser()->tab_strip_model()->count());
+  EXPECT_EQ(source->GetContents(),
+            browser()->tab_strip_model()->GetActiveWebContents());
+  const auto* pending = source->GetContents()->GetController().GetPendingEntry();
+  ASSERT_TRUE(pending);
+  EXPECT_EQ(GURL("https://chatgpt.com/?q=a%20fresh%20question"),
+            pending->GetURL());
+  EXPECT_TRUE(ui::PageTransitionCoreTypeIs(pending->GetTransitionType(),
+                                          ui::PAGE_TRANSITION_GENERATED));
+}
+
+TEST_F(ArciumCommandActionRouterTest,
+       ChatGPTNewTabQueryPreservesExistingConversationAndNavigatesToRoot) {
+  auto* source = AddOrdinaryTab("https://chatgpt.com/c/existing-conversation");
+  content::WebContents* original = source->GetContents();
+  Capture(source, CommandInvocationMode::kNewTab);
+  const auto url = BuildCommandSearchUrl(kChatGPTScope, u"a fresh question");
+  ASSERT_TRUE(url);
+  ASSERT_TRUE(router_->Execute(Intent(CommandUrlTarget{.url = *url})).success);
+
+  ASSERT_EQ(2, browser()->tab_strip_model()->count());
+  auto* destination = browser()->tab_strip_model()->GetActiveWebContents();
+  ASSERT_NE(original, destination);
+  EXPECT_EQ(GURL("https://chatgpt.com/c/existing-conversation"),
+            original->GetLastCommittedURL());
+  EXPECT_EQ(nullptr, original->GetController().GetPendingEntry());
+  const auto* pending = destination->GetController().GetPendingEntry();
+  ASSERT_TRUE(pending);
+  EXPECT_EQ(GURL("https://chatgpt.com/?q=a%20fresh%20question"),
+            pending->GetURL());
+  EXPECT_TRUE(ui::PageTransitionCoreTypeIs(pending->GetTransitionType(),
+                                          ui::PAGE_TRANSITION_GENERATED));
+}
