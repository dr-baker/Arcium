+TEST_F(ArciumCommandActionRouterTest,
+       ProductionRemoteScopeSearchIsDefaultDespiteLiveAndSavedMatches) {
+  struct SearchCase {
+    const char* scope;
+    const char* live_url;
+    const char* saved_url;
+  };
+  for (const SearchCase& item : {
+           SearchCase{kYouTubeScope,
+                      "https://www.youtube.com/watch?v=scope-default-live",
+                      "https://www.youtube.com/watch?v=scope-default-saved"},
+           SearchCase{kChatGPTScope,
+                      "https://chatgpt.com/c/scope-default-live",
+                      "https://chatgpt.com/c/scope-default-saved"}}) {
+    SCOPED_TRACE(item.scope);
+    auto* live = AddOrdinaryTab(item.live_url);
+    const CommandTarget live_target = Live(live);
+    SetPins({Link("scope-default-pin", item.saved_url)});
+    const CommandTarget saved_target = Pin("scope-default-pin");
+    auto session = CreateCommandSession(browser());
+    session->SetInvocation(CommandInvocationMode::kNewTab);
+    std::shared_ptr<const CommandPublication> publication;
+    session->Search(
+        item.scope, u"scope-default",
+        base::BindLambdaForTesting(
+            [&publication](std::shared_ptr<const CommandPublication> update) {
+              publication = std::move(update);
+            }));
+    base::RunLoop().RunUntilIdle();
+
+    ASSERT_TRUE(publication);
+    const auto& rows = publication->rows;
+    const auto typed = std::ranges::find_if(rows, [](const CommandRow& row) {
+      return row.kind == CommandRowKind::kTypedSearch;
+    });
+    ASSERT_NE(rows.end(), typed);
+    EXPECT_TRUE(typed->is_default);
+    EXPECT_EQ(1, std::ranges::count_if(rows, [](const CommandRow& row) {
+      return row.is_default;
+    }));
+    const auto expected_url = BuildCommandSearchUrl(item.scope, u"scope-default");
+    ASSERT_TRUE(expected_url);
+    EXPECT_EQ(CommandTarget(CommandUrlTarget{.url = *expected_url}),
+              typed->target);
+    const auto live_match = std::ranges::find_if(
+        rows, [&live_target](const CommandRow& row) {
+          return row.target == live_target;
+        });
+    ASSERT_NE(rows.end(), live_match);
+    EXPECT_FALSE(live_match->is_default);
+    const auto saved_match = std::ranges::find_if(
+        rows, [&saved_target](const CommandRow& row) {
+          return row.target == saved_target;
+        });
+    ASSERT_NE(rows.end(), saved_match);
+    EXPECT_FALSE(saved_match->is_default);
+    session->Cancel();
+    session.reset();
+    base::RunLoop().RunUntilIdle();
+  }
+}
