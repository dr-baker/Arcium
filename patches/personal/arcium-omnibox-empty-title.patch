+TEST_F(BookmarkProviderTest, ArciumItemsFallbackToURLForBlankTitles) {
+  const std::vector<ArciumOmniboxItem> items = [] {
+    ArciumOmniboxItem empty_title;
+    empty_title.kind = ArciumOmniboxItem::Kind::kFavorite;
+    empty_title.id = "empty-title";
+    empty_title.url = GURL("https://empty-title.example/page");
+
+    ArciumOmniboxItem whitespace_title;
+    whitespace_title.kind = ArciumOmniboxItem::Kind::kPin;
+    whitespace_title.id = "whitespace-title";
+    whitespace_title.title = u" \t";
+    whitespace_title.url = GURL("https://whitespace-title.example/page");
+
+    return std::vector<ArciumOmniboxItem>{empty_title, whitespace_title};
+  }();
+  ON_CALL(*provider_client_, GetArciumOmniboxItems())
+      .WillByDefault(testing::Return(items));
+
+  ASSERT_EQ(1u, GetNumMatches("empty-title"));
+  const AutocompleteMatch& empty_match = provider_->matches().front();
+  EXPECT_EQ(base::UTF8ToUTF16(items[0].url.spec()), empty_match.description);
+  ASSERT_EQ(1u, empty_match.description_class.size());
+  EXPECT_EQ(0u, empty_match.description_class.front().offset);
+  EXPECT_EQ(AutocompleteMatch::ACMatchClassification::MATCH,
+            empty_match.description_class.front().style);
+#if DCHECK_IS_ON()
+  empty_match.Validate();
+#endif
+
+  ResetProvider();
+  ASSERT_EQ(1u, GetNumMatches("whitespace-title"));
+  const AutocompleteMatch& whitespace_match = provider_->matches().front();
+  EXPECT_EQ(base::UTF8ToUTF16(items[1].url.spec()),
+            whitespace_match.description);
+  ASSERT_EQ(1u, whitespace_match.description_class.size());
+  EXPECT_EQ(0u, whitespace_match.description_class.front().offset);
+  EXPECT_EQ(AutocompleteMatch::ACMatchClassification::MATCH,
+            whitespace_match.description_class.front().style);
+#if DCHECK_IS_ON()
+  whitespace_match.Validate();
+#endif
+}
