--- /dev/null
+++ src/components/helium_onboarding/tests/import-navigation.test.mjs
@@ -0,0 +1,199 @@
+import assert from 'node:assert/strict';
+import {readFileSync} from 'node:fs';
+import {createRequire} from 'node:module';
+import test from 'node:test';
+import vm from 'node:vm';
+import * as stores from 'svelte/store';
+import {compile} from 'svelte/compiler';
+const require = createRequire(import.meta.url);
+const ts = require('typescript');
+const tick = () => new Promise(resolve => setImmediate(resolve));
+const profile = (index, extra = {}) => ({id: index + 100, index, name: 'Browser', profileName: 'Test', history: true, favorites: true, passwords: true, search: true, autofillFormData: true, extensions: true, ...extra});
+const transpile = (source, stripImports = false) => {
+    if (stripImports) {
+        const parsed = ts.createSourceFile('navigation.ts', source, ts.ScriptTarget.Latest, true, ts.ScriptKind.TS);
+        source = ts.createPrinter().printFile(ts.factory.updateSourceFile(parsed,
+            parsed.statements.filter(statement => !ts.isImportDeclaration(statement))));
+    }
+    return ts.transpileModule(source, {
+        compilerOptions: {target: ts.ScriptTarget.ES2022, module: ts.ModuleKind.CommonJS},
+    }).outputText;
+};
+
+async function importer(profiles, options = {}) {
+    const listeners = new Map();
+    const calls = [];
+    let sequence = 0;
+    let refresh = 0;
+    let registrations = 0;
+    const proxy = {
+        initializeImportDialog: () => {
+            refresh++;
+            if (options.refreshFails && refresh > 1) return Promise.reject(new Error('refresh failed'));
+            return Promise.resolve(profiles);
+        },
+        importData: (index, types, pins) => {
+            calls.push({index, types, pins});
+            if (options.throwFor?.has(index)) throw new Error('bridge failed');
+        },
+    };
+    const bridge = {
+        ImportDataBrowserProxyImpl: {getInstance: () => proxy},
+        ImportType: {},
+        ImportDataStatus: {INITIAL: 'initial', IN_PROGRESS: 'inProgress', SUCCEEDED: 'succeeded', FAILED: 'failed'},
+        addWebUiListener: (event, callback) => {
+            if (options.registrationFails && registrations++ === 0) throw new Error('listener failed');
+            const handle = {id: ++sequence};
+            listeners.set(handle, callback);
+            return handle;
+        },
+        removeWebUiListener: handle => {
+            listeners.delete(handle);
+            if (options.cleanupThrows) throw new Error('cleanup failed');
+        },
+    };
+    const exports = {};
+    const context = vm.createContext({exports, require: name => name === 'svelte/store' ? stores : name === '../cr' ? bridge : assert.fail(name), queueMicrotask});
+    vm.runInContext(transpile(readFileSync('src/lib/browser/importer.ts', 'utf8')), context);
+    await exports.loadImportableProfiles();
+    await tick();
+    return {api: exports, calls, listeners, status: status => [...listeners.values()].forEach(callback => callback(status))};
+}
+
+function navigation(importerHarness, extra = {}) {
+    const component = readFileSync('src/components/PageNavigation.svelte', 'utf8');
+    const source = component.match(/<script lang="ts">([\s\S]*?)<\/script>/)[1];
+    let advances = 0;
+    const context = vm.createContext({
+        exports: {}, $derived: value => value, $state: value => value, SvelteSet: Set,
+        $currentPage: 'DataImport', $userChoseHeliumAsDefault: false,
+        $importableProfiles: [profile(1), profile(2)], $selectedProfiles: new Set([101, 102]),
+        $importDiscovery: {refreshing: false},
+        $previouslyImportedProfiles: new Set(), $failedProfiles: new Set(),
+        importProfile: importerHarness?.api.importProfile,
+        nextPage: () => advances++, previousPage: () => {},
+        setPref: async () => {}, acceptLatestSchema: () => {}, askToBeDefault: () => {},
+        ...extra,
+    });
+    vm.runInContext(transpile(source, true), context);
+    return {context, next: () => vm.runInContext('next()', context), state: () => vm.runInContext('({working, stepFailed})', context), advances: () => advances};
+}
+
+test('imports FIFO with exactly one active listener and ignores intermediate/stale events', async () => {
+    const h = await importer([profile(1), profile(2)]);
+    const first = h.api.importProfile(1, {bookmarks: true});
+    const second = h.api.importProfile(2, {history: true});
+    assert.deepEqual(h.calls.map(c => c.index), [1]);
+    assert.equal(h.listeners.size, 1);
+    const stale = [...h.listeners.values()][0];
+    h.status('initial'); h.status('inProgress');
+    assert.deepEqual(h.calls.map(c => c.index), [1]);
+    h.status('succeeded'); await tick();
+    assert.equal((await first).status, 'succeeded');
+    assert.deepEqual(h.calls.map(c => c.index), [1, 2]);
+    assert.equal(h.listeners.size, 1);
+    stale('failed');
+    assert.equal(h.listeners.size, 1);
+    h.status('failed');
+    assert.equal((await second).status, 'failed');
+    await tick(); assert.equal(h.listeners.size, 0);
+});
+
+test('synchronous importData failure cleans listener and queue, then supports retry', async () => {
+    const failures = new Set([1]);
+    const h = await importer([profile(1), profile(2)], {throwFor: failures});
+    const first = h.api.importProfile(1, {bookmarks: true});
+    const second = h.api.importProfile(2, {bookmarks: true});
+    assert.equal((await first).status, 'failed');
+    await tick(); assert.deepEqual(h.calls.map(c => c.index), [1, 2]);
+    h.status('succeeded'); assert.equal((await second).status, 'succeeded'); await tick();
+    assert.equal(h.listeners.size, 0);
+    failures.clear(); const retry = h.api.importProfile(1, {bookmarks: true});
+    h.status('succeeded'); assert.equal((await retry).status, 'succeeded'); await tick();
+});
+
+test('listener registration and cleanup errors cannot strand later jobs', async () => {
+    const h = await importer([profile(1), profile(2)], {registrationFails: true, cleanupThrows: true});
+    const first = h.api.importProfile(1, {bookmarks: true});
+    const second = h.api.importProfile(2, {bookmarks: true});
+    assert.equal((await first).status, 'failed');
+    await tick(); assert.deepEqual(h.calls.map(c => c.index), [2]);
