+#if !BUILDFLAG(SAFE_BROWSING_AVAILABLE) && !BUILDFLAG(IS_ANDROID)
+TEST_F(ChromePermissionsClientTest,
+       PermissionRequestUsesDefaultPromptWithoutPredictionSelector) {
+  NavigateAndCommit(GURL(permissions::MockPermissionRequest::kDefaultOrigin));
+  web_contents()->UpdateWebContentsVisibility(content::Visibility::VISIBLE);
+  base::test::ScopedRunLoopTimeout timeout(FROM_HERE, base::Seconds(10));
+
+  auto* manager =
+      permissions::PermissionRequestManager::FromWebContents(web_contents());
+  ASSERT_TRUE(manager);
+  ASSERT_EQ(manager->get_permission_ui_selectors_for_testing().size(), 1u);
+
+  MockPermissionPredictionService prediction_service;
+  EXPECT_CALL(prediction_service, StartLookup).Times(0);
+  auto* prediction_service_factory = PredictionServiceFactory::GetInstance();
+  prediction_service_factory->set_prediction_service_for_testing(
+      &prediction_service);
+  base::ScopedClosureRunner reset_prediction_service(base::BindOnce(
+      [](PredictionServiceFactory* factory) {
+        factory->set_prediction_service_for_testing(nullptr);
+      },
+      prediction_service_factory));
+
+  permissions::MockPermissionPromptFactory prompt_factory(manager);
+  manager->AddRequest(
+      main_rfh(), std::make_unique<permissions::MockPermissionRequest>(
+                      permissions::RequestType::kNotifications,
+                      permissions::PermissionRequestGestureType::GESTURE));
+  prompt_factory.WaitForPermissionBubble();
+
+  EXPECT_TRUE(prompt_factory.is_visible());
+  EXPECT_EQ(prompt_factory.show_count(), 1);
+  EXPECT_EQ(prompt_factory.request_count(), 1);
+  EXPECT_TRUE(prompt_factory.RequestTypeSeen(
+      permissions::RequestType::kNotifications));
+  EXPECT_FALSE(manager->ShouldCurrentRequestUseQuietUI());
+}
+#endif  // !BUILDFLAG(SAFE_BROWSING_AVAILABLE) && !BUILDFLAG(IS_ANDROID)
