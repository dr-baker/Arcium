+// Copyright 2026 The Helium Authors
+// You can use, redistribute, and/or modify this source code under
+// the terms of the GPL-3.0 license found in the LICENSE file.
+
+#ifndef CHROME_BROWSER_UI_VIEWS_HELIUM_GLASS_SURFACE_H_
+#define CHROME_BROWSER_UI_VIEWS_HELIUM_GLASS_SURFACE_H_
+
+#include "build/build_config.h"
+#include "third_party/skia/include/core/SkColor.h"
+#include "ui/gfx/geometry/rounded_corners_f.h"
+#include "ui/views/view.h"
+
+namespace helium {
+
+inline constexpr char kArciumGlassBackendSwitch[] = "arcium-glass-backend";
+
+// The implementation used to draw a glass surface. Native backends are hosted
+// by AppKit and Chromium is drawn inside the browser compositor.
+enum class GlassBackend {
+  kAuto,
+  kNativeLiquidGlass,
+  kNativeMaterial,
+  kChromium,
+  kOpaque,
+};
+
+struct GlassBackendAvailability {
+  bool native_liquid_glass = false;
+  bool native_material = false;
+  bool chromium = false;
+  bool reduce_transparency = false;
+};
+
+enum class GlassHost { kEmbedded, kNativeFrame };
+
+struct GlassResolution {
+  GlassBackend requested;
+  GlassBackend resolved;
+  GlassHost host;
+  const char* fallback_reason;
+};
+
+GlassResolution ResolveGlassSurface(GlassHost host);
+
+GlassBackend GetRequestedGlassBackend();
+GlassBackend ResolveGlassBackend(
+    GlassBackend requested,
+    const GlassBackendAvailability& availability);
+const char* GlassBackendName(GlassBackend backend);
+
+GlassBackendAvailability GetNativeFrameGlassAvailability();
+bool GlassReduceTransparency();
+
+// Fixed, reviewed materials for browser chrome. The shader lab exposes more
+// knobs, but product code intentionally selects a material rather than
+// tuning its implementation details per component.
+enum class GlassSurfacePreset {
+  kBasic,
+  kGlassmorphic,
+};
+
+struct GlassSurfaceParams {
+  GlassSurfacePreset preset = GlassSurfacePreset::kBasic;
+  SkColor tint_color = SK_ColorWHITE;
+  float tint_strength = 0.0f;
+  float opacity = 1.0f;
+  SkColor opaque_color = SkColorSetRGB(28, 28, 30);
+  gfx::RoundedCornersF corner_radii = gfx::RoundedCornersF();
+};
+
+// A reusable embedded Views surface. Native AppKit surfaces use the same
+// backend policy through glass_surface_mac.h, while this class resolves to the
+// Chromium live-backdrop renderer or the opaque fallback.
+class GlassSurfaceView : public views::View {
+  METADATA_HEADER(GlassSurfaceView, views::View)
+
+ public:
+  explicit GlassSurfaceView(const GlassSurfaceParams& params);
+  GlassSurfaceView(const GlassSurfaceView&) = delete;
+  GlassSurfaceView& operator=(const GlassSurfaceView&) = delete;
+  ~GlassSurfaceView() override;
+
+  void SetPreset(GlassSurfacePreset preset);
+  void SetTintColor(SkColor tint_color);
+  void SetTintStrength(float tint_strength);
+  void SetOpacity(float opacity);
+  void SetCornerRadii(const gfx::RoundedCornersF& corner_radii);
+
+  bool uses_backdrop() const { return backend_ != GlassBackend::kOpaque; }
+  GlassSurfacePreset preset() const { return preset_; }
+  SkColor tint_color() const { return tint_color_; }
+  float tint_strength() const { return tint_strength_; }
+  float opacity() const { return opacity_; }
+  const gfx::RoundedCornersF& corner_radii() const { return corner_radii_; }
+
+ private:
+  void UpdateLayer();
+  void OnBoundsChanged(const gfx::Rect& previous_bounds) override;
+
+  GlassBackend backend_;
+  GlassSurfacePreset preset_;
+  SkColor tint_color_;
+  float tint_strength_;
+  float opacity_;
+  SkColor opaque_color_;
+  gfx::RoundedCornersF corner_radii_;
+};
+
+}  // namespace helium
+
+#endif  // CHROME_BROWSER_UI_VIEWS_HELIUM_GLASS_SURFACE_H_
