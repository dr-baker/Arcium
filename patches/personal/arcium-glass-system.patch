+constexpr char kGlassmorphicSkSL[] = R"SKSL(
+uniform shader backdrop;
+uniform shader softenedBackdrop;
+uniform float4 uLocalTransform;
+uniform float2 uResolution; uniform float2 uPanelOrigin; uniform float2 uPanelSize;
+uniform float uCornerRadius; uniform float uShapePower;
+uniform float uOpacity; uniform float uEdgeWidth; uniform float uRefraction;
+uniform float uBulge; uniform float uDispersion; uniform float uTintStrength;
+uniform float uSaturation; uniform float uSpecular; uniform float uGrain;
+uniform float4 uTint; uniform float2 uLightXY; uniform float uLightElevation;
+uniform float uLightIntensity;
+float roundedBoxDistance(float2 p,float2 h,float r){float2 q=abs(p)-h+r;return length(max(q,0.0))+min(max(q.x,q.y),0.0)-r;}
+float superellipseDistance(float2 p,float2 h,float power){float2 n=abs(p)/h;float x=pow(n.x,power)+pow(n.y,power)-1.0;float2 g=float2(power*pow(max(n.x,0.0001),power-1.0)/h.x,power*pow(max(n.y,0.0001),power-1.0)/h.y);return x/max(length(g),0.0001);}
+float panelDistance(float2 p,float2 h,float r){return uShapePower>1.0?superellipseDistance(p,h,uShapePower):roundedBoxDistance(p,h,r);}
+float2 panelNormal(float2 p,float2 h,float r){float2 x=float2(1,0),y=float2(0,1);float2 g=float2(panelDistance(p+x,h,r)-panelDistance(p-x,h,r),panelDistance(p+y,h,r)-panelDistance(p-y,h,r));return g/max(length(g),0.0001);}
+half4 childSample(float2 p){return backdrop.eval(p*uLocalTransform.xy+uLocalTransform.zw);}
+float3 blurBackdrop(float2 p, float2 offset) {
+  return softenedBackdrop.eval(
+      (p + offset) * uLocalTransform.xy + uLocalTransform.zw).rgb;
+}
+float grainAt(float2 p){float2 c=floor(p);return fract(sin(dot(c,float2(12.9898,78.233)))*43758.5453);}
+half4 main(float2 layerPosition){float2 position=(layerPosition-uLocalTransform.zw)/uLocalTransform.xy;float2 center=uPanelOrigin+uPanelSize*.5;float2 local=position-center;float2 halfSize=uPanelSize*.5;float d=panelDistance(local,halfSize,uCornerRadius);half4 source=childSample(position);float coverage=1-smoothstep(-1,1,d);if(coverage<=0)return source;float edge=smoothstep(-uEdgeWidth,0,d);float2 normal=panelNormal(local,halfSize,uCornerRadius);float radial=clamp(length(local/halfSize),0,1);float2 bulged=center+local*(1-pow(radial,2.2)*uBulge);float2 bend=normal*uRefraction*edge;float3 softened=blurBackdrop(bulged,bend);float2 spectralBend=bend*uDispersion;half4 rs=childSample(bulged+bend+spectralBend),gs=childSample(bulged+bend),bs=childSample(bulged+bend-spectralBend);float3 spectral=float3(rs.r,gs.g,bs.b);float3 color=mix(softened,spectral,.42+edge*.38);float luminance=dot(color,float3(.2126,.7152,.0722));color=mix(float3(luminance),color,uSaturation);color=mix(color,color*uTint.rgb+uTint.rgb*.22,uTintStrength);float3 light=normalize(float3(uLightXY,max(uLightElevation,.01)));float spec=pow(max(dot(normal,light.xy),0),4);color+=float3(.82,.92,1)*spec*uSpecular*edge*1.55*uLightIntensity;color+=uTint.rgb*edge*uSpecular*.045;color+=(grainAt(position)-.5)*uGrain;half4 complete=half4(clamp(color,0,1),source.a);return half4(mix(source.rgb,complete.rgb,clamp(uOpacity,0,1)*coverage),source.a);}
+)SKSL";
+
