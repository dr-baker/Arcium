--- /dev/null
+++ src/chrome/browser/ui/views/helium/glass_surface_unittest.cc
@@ -0,0 +1,72 @@
+// Copyright 2026 The Helium Authors
+// You can use, redistribute, and/or modify this source code under
+// the terms of the GPL-3.0 license found in the LICENSE file.
+
+#include "chrome/browser/ui/views/helium/glass_surface.h"
+
+#include "base/test/scoped_command_line.h"
+#include "testing/gtest/include/gtest/gtest.h"
+
+namespace helium {
+
+TEST(GlassSurfaceTest, AutoUsesBestAvailableBackend) {
+  EXPECT_EQ(GlassBackend::kNativeLiquidGlass,
+            ResolveGlassBackend(
+                GlassBackend::kAuto,
+                {.native_liquid_glass = true,
+                 .native_material = true,
+                 .chromium = true}));
+  EXPECT_EQ(GlassBackend::kNativeMaterial,
+            ResolveGlassBackend(GlassBackend::kAuto,
+                                {.native_material = true,
+                                 .chromium = true}));
+  EXPECT_EQ(GlassBackend::kChromium,
+            ResolveGlassBackend(GlassBackend::kAuto, {.chromium = true}));
+  EXPECT_EQ(GlassBackend::kOpaque,
+            ResolveGlassBackend(GlassBackend::kAuto, {}));
+}
+
+TEST(GlassSurfaceTest, PreferencesFallBackToSupportedGlass) {
+  EXPECT_EQ(GlassBackend::kChromium,
+            ResolveGlassBackend(GlassBackend::kNativeLiquidGlass,
+                                {.chromium = true}));
+  EXPECT_EQ(GlassBackend::kNativeMaterial,
+            ResolveGlassBackend(GlassBackend::kChromium,
+                                {.native_material = true}));
+}
+
+TEST(GlassSurfaceTest, OpaqueAndAccessibilityOverrideEveryPreference) {
+  const GlassBackendAvailability all = {.native_liquid_glass = true,
+                                       .native_material = true,
+                                       .chromium = true};
+  EXPECT_EQ(GlassBackend::kOpaque,
+            ResolveGlassBackend(GlassBackend::kOpaque, all));
+  for (const auto preference : {GlassBackend::kAuto,
+                               GlassBackend::kNativeLiquidGlass,
+                               GlassBackend::kNativeMaterial,
+                               GlassBackend::kChromium}) {
+    auto reduced = all;
+    reduced.reduce_transparency = true;
+    EXPECT_EQ(GlassBackend::kOpaque,
+              ResolveGlassBackend(preference, reduced));
+    EXPECT_EQ(GlassBackend::kOpaque, ResolveGlassBackend(preference, {}));
+  }
+}
+
+TEST(GlassSurfaceTest, NativePreferenceFallsBackToOlderMacMaterial) {
+  EXPECT_EQ(GlassBackend::kNativeMaterial,
+            ResolveGlassBackend(GlassBackend::kNativeLiquidGlass,
+                                {.native_material = true}));
+  EXPECT_EQ(GlassBackend::kChromium,
+            ResolveGlassBackend(GlassBackend::kNativeMaterial,
+                                {.chromium = true}));
+}
+
+TEST(GlassSurfaceTest, CommandLineSelectsBackendWithoutRebuild) {
+  base::test::ScopedCommandLine command_line;
+  command_line.GetProcessCommandLine()->AppendSwitchASCII(
+      kArciumGlassBackendSwitch, "chromium");
+  EXPECT_EQ(GlassBackend::kChromium, GetRequestedGlassBackend());
+}
+
+}  // namespace helium
